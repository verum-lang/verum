+#[test]
+fn archive_import_preserves_declaration_scope_across_distinct_string_pools() {
+    use verum_vbc::codegen::CodegenConfig;
+    let [_, wire] = source_and_wire("visible", AstVisibility::Public);
+    let mut consumer = VbcCodegen::with_config(CodegenConfig::new("consumer.unrelated"));
+    for index in 0..128 {
+        consumer
+            .ctx_mut()
+            .intern_string_raw(&format!("unrelated_{index}"));
+    }
+    consumer.import_archive_module_types(&wire);
+    let final_module = consumer
+        .finalize_module_from_state()
+        .expect("imported descriptors");
+    assert_scoped_record(&final_module);
+    let roundtrip = verum_vbc::deserialize::deserialize_module(
+        &verum_vbc::serialize::serialize_module(&final_module).unwrap(),
+    )
+    .unwrap();
+    assert_scoped_record(&roundtrip);
+}
+
+#[test]
+fn linker_preserves_scope_and_declaration_owner_across_distinct_pools() {
+    let [_, wire] = source_and_wire("visible", AstVisibility::Public);
+    let mut linker = verum_vbc::linker::VbcLinker::new("aarch64-apple-darwin");
+    let mut unrelated = VbcModule::new("consumer.unrelated".into());
+    for index in 0..128 {
+        unrelated.intern_string(&format!("other_{index}"));
+    }
+    linker.add_user_module(unrelated).unwrap();
+    linker.add_user_module(wire).unwrap();
+    let linked = linker.finalize();
+    assert_scoped_record(&linked);
+    let roundtrip = verum_vbc::deserialize::deserialize_module(
+        &verum_vbc::serialize::serialize_module(&linked).unwrap(),
+    )
+    .unwrap();
+    assert_scoped_record(&roundtrip);
+}
