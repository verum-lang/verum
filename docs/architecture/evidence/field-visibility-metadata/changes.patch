+fn assert_scoped_record(module: &VbcModule) {
+    use verum_ast::{Ident, Path, PathSegment, Span};
+    let record = module
+        .types
+        .iter()
+        .find(|ty| {
+            ty.origin_module.and_then(|id| module.get_string(id)) == Some(fixture::OWNER)
+                && module
+                    .get_string(ty.name)
+                    .is_some_and(|name| name.rsplit('.').next() == Some("Vault"))
+        })
+        .expect("declaring owner retained across pool boundary");
+    let field = record
+        .fields
+        .iter()
+        .find(|field| module.get_string(field.name) == Some("self_scoped"))
+        .expect("field identity retained");
+    let expected = AstVisibility::PublicIn(Path::new(
+        ["fixture", "visibility", "owner", "scope"]
+            .into_iter()
+            .map(|name| PathSegment::Name(Ident::new(name, Span::dummy())))
+            .collect(),
+        Span::dummy(),
+    ));
+    assert_eq!(policy(module, field), expected);
+    let variant = module
+        .types
+        .iter()
+        .find(|ty| {
+            ty.origin_module.and_then(|id| module.get_string(id)) == Some(fixture::OWNER)
+                && module
+                    .get_string(ty.name)
+                    .is_some_and(|name| name.rsplit('.').next() == Some("Message"))
+        })
+        .unwrap()
+        .variants
+        .iter()
+        .find(|variant| module.get_string(variant.name) == Some("Payload"))
+        .unwrap();
+    let scoped = variant
+        .fields
+        .iter()
+        .find(|field| module.get_string(field.name) == Some("scoped"))
+        .unwrap();
+    let expected = AstVisibility::PublicIn(Path::new(
+        ["fixture", "visibility"]
+            .into_iter()
+            .map(|name| PathSegment::Name(Ident::new(name, Span::dummy())))
+            .collect(),
+        Span::dummy(),
+    ));
+    assert_eq!(policy(module, scoped), expected);
+}
