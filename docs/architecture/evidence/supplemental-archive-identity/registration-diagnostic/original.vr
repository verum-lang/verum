// Shared requirement APIs, composition and option boundaries.
mount core.base.semver.SemVer;
mount core.base.semver_constraint.{
    SemVerConstraint, parse, parse_cargo, parse_extended, format_constraint,
    matches_default, matches_allow_prerelease, matches,
    match_options_default, match_options_allow_prerelease,
    exact, caret, tilde, tilde_minor, tilde_major, x_range_major, x_range_minor, and, or,
};

fn version(text: &Text) -> SemVer { SemVer.parse(text).unwrap() }
fn cargo(text: &Text) -> SemVerConstraint { parse_cargo(text).unwrap() }

@test
fn strict_and_extended_entries_keep_distinct_syntax() {
    assert(parse_cargo(&"^1 || ^2").is_err());
    assert(parse_cargo(&">=1 <2").is_err());
    let extended = parse_extended(&"^1 || ^2").unwrap();
    let compatible = parse(&"^1 || ^2").unwrap();
    let candidate = version(&"2.5.0");
    assert(matches_default(&extended, &candidate));
    assert(matches_default(&compatible, &candidate));
    assert(matches_default(&parse_extended(&">=1 <2").unwrap(), &version(&"1.5.0")));
}

@test
fn operator_spaces_do_not_split_comparators() {
    let constraint = cargo(&" >= 1.2, < 2 ");
    assert(matches_default(&constraint, &version(&"1.2.8")));
    assert(!matches_default(&constraint, &version(&"2.0.0")));
}

@test
fn strict_spaces_and_extended_tabs_are_explicit() {
    assert(parse_cargo(&">=\t1.2").is_err());
    assert(matches_default(&parse_extended(&">=\t1.2\t<2").unwrap(), &version(&"1.5.0")));
}

@test
fn prerelease_admission_is_shared_within_a_conjunction() {
    let constraint = cargo(&">=1.0.0-alpha, <2.0.0");
    assert(matches_default(&constraint, &version(&"1.0.0-beta")));
    assert(!matches_default(&constraint, &version(&"1.1.0-alpha")));
}

@test
fn failing_alternative_cannot_lend_prerelease_admission() {
    let constraint = parse_extended(&">=1.0.0, <2.0.0 || >1.5.0-beta, <1.5.0-alpha").unwrap();
    assert(!matches_default(&constraint, &version(&"1.5.0-beta")));
}

@test
fn wildcard_alternative_preserves_an_explicit_prerelease_branch() {
    let target = version(&"1.0.0-alpha");
    let constraint = or(SemVerConstraint.Any, exact(target.clone()));
    assert(matches_default(&constraint, &target));
    assert(!matches_default(&constraint, &version(&"1.0.0-beta")));
    assert(matches_default(&constraint, &version(&"99.0.0")));
}

@test
fn caret_zero_patch_prerelease_admits_its_release() {
    let constraint = caret(version(&"0.0.3-alpha"));
    assert(matches_default(&constraint, &version(&"0.0.3")));
    assert(!matches_default(&constraint, &version(&"0.0.4")));
}

@test
fn constructor_bounds_do_not_overflow_uint64() {
    let major = caret(version(&"18446744073709551615.1.0"));
    assert(matches_default(&major, &version(&"18446744073709551615.2.0")));
    let minor = tilde(version(&"1.18446744073709551615.1"));
    assert(matches_default(&minor, &version(&"1.18446744073709551615.2")));
    assert(!matches_default(&minor, &version(&"2.0.0")));
}

@test
fn omitted_constructor_components_retain_their_scope() {
    let candidate = version(&"1.2.9");
    assert(matches_default(&tilde_major(1_u64), &candidate));
    assert(matches_default(&tilde_minor(1_u64, 2_u64), &candidate));
    assert(matches_default(&x_range_major(1_u64), &candidate));
    assert(matches_default(&x_range_minor(1_u64, 2_u64), &candidate));
    assert(!matches_default(&x_range_minor(1_u64, 1_u64), &candidate));
}

@test
fn options_lift_admission_without_changing_comparison_order() {
    let constraint = SemVerConstraint.Gt(version(&"1.0.0"));
    let candidate = version(&"1.2.0-beta");
    assert(!matches(&constraint, &candidate, &match_options_default()));
    assert(matches(&constraint, &candidate, &match_options_allow_prerelease()));
    assert(matches_allow_prerelease(&constraint, &candidate));
    assert(!matches_allow_prerelease(&exact(version(&"1.0.0")), &version(&"1.0.0-alpha")));
}

@test
fn exact_constructor_keeps_its_atom_and_ignores_build_precedence() {
    let constraint = exact(version(&"1.0.0+first"));
    match &constraint {
        SemVerConstraint.Eq(_) => {},
        _ => panic("exact constructor lost its Eq atom"),
    }
    assert(matches_default(&constraint, &version(&"1.0.0+second")));
}

@test
fn release_composition_keeps_identity_and_absorption() {
    let candidate = version(&"1.5.0");
    let constraint = caret(version(&"1.0.0"));
    assert(matches_default(&and(SemVerConstraint.Any, constraint.clone()), &candidate));
    assert(!matches_default(&and(SemVerConstraint.Empty, constraint.clone()), &candidate));
    assert(matches_default(&or(SemVerConstraint.Empty, constraint.clone()), &candidate));
    assert(matches_default(&or(SemVerConstraint.Any, constraint), &version(&"99.0.0")));
}

@test
fn formatted_partial_comparators_preserve_matching() {
    let original = cargo(&">=1.2, <2");
    let rendered = format_constraint(&original);
    let reparsed = parse_cargo(&rendered).unwrap();
    assert(matches_default(&reparsed, &version(&"1.2.9")));
    assert(!matches_default(&reparsed, &version(&"1.1.9")));
    assert(!matches_default(&reparsed, &version(&"2.0.0")));
}

@test
fn extensions_share_identifier_and_empty_clause_validation() {
    assert(parse_extended(&"01.2.3 || ^2").is_err());
    assert(parse_extended(&"^1 ||").is_err());
    assert(parse_extended(&"^1,, <2").is_err());
    assert(parse_extended(&"^1.2.3-01").is_err());
}

fn main() {
    strict_and_extended_entries_keep_distinct_syntax();
    operator_spaces_do_not_split_comparators();
    strict_spaces_and_extended_tabs_are_explicit();
    prerelease_admission_is_shared_within_a_conjunction();
    failing_alternative_cannot_lend_prerelease_admission();
    wildcard_alternative_preserves_an_explicit_prerelease_branch();
    caret_zero_patch_prerelease_admits_its_release();
    constructor_bounds_do_not_overflow_uint64();
    omitted_constructor_components_retain_their_scope();
    options_lift_admission_without_changing_comparison_order();
    exact_constructor_keeps_its_atom_and_ignores_build_precedence();
    release_composition_keeps_identity_and_absorption();
    formatted_partial_comparators_preserve_matching();
    extensions_share_identifier_and_empty_clause_validation();
    print("semver-options: 14 passed");
}
