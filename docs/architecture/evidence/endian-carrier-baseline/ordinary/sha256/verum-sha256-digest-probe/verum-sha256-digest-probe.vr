mount core.hash.crypto.sha256.Sha256;

fn main() {
    let input = "vrp1_000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
    print("sha256:begin");
    let actual = Sha256.digest(input.as_bytes());
    let expected: List<Byte> = [10_u8, 71_u8, 156_u8, 34_u8, 84_u8, 109_u8, 59_u8, 47_u8, 115_u8, 81_u8, 244_u8, 171_u8, 138_u8, 230_u8, 172_u8, 11_u8, 51_u8, 212_u8, 210_u8, 153_u8, 117_u8, 201_u8, 168_u8, 246_u8, 54_u8, 42_u8, 253_u8, 196_u8, 21_u8, 44_u8, 130_u8, 238_u8];
    let mut index = 0;
    while index < 32 {
        assert_eq(actual[index], expected[index]);
        index = index + 1;
    }
    print("sha256:passed");
}
