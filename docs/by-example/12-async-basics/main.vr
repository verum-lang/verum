// docs/by-example/12-async-basics/main.vr
// Async / await: yield points, structured concurrency, spawn/join.

mount core.async.{spawn, sleep};
mount core.time.duration.Duration;
mount core.io.println;

// An `async fn` is a function that MAY yield at its await points.
// CALLING it runs the body and returns the value — on both tiers.
// (`Future<T>` is the type of EXPLICIT futures only: spawn handles,
// timers, and the Future protocol's own implementors.)
async fn fetch_user(id: Int) -> Text {
    // `sleep(...)` returns a timer future; `.await` is the yield
    // point where the runtime may run other ready tasks before
    // resuming here.
    sleep(Duration.from_millis(50)).await;
    f"user-{id}"
}

// Awaits compose linearly: one task, two yield points.
async fn fetch_user_with_friend(id: Int) -> (Text, Text) {
    let user = fetch_user(id).await;
    let friend = fetch_user(id + 1).await;
    (user, friend)
}

fn main() {
    // Called like any function: the body runs, the value returns.
    let direct = fetch_user(1);
    println(f"direct call: {direct}");

    // CONCURRENCY is explicit: `spawn` launches an async task on the
    // runtime and returns a handle; awaiting the handle waits. A parent
    // does not finish before its spawned children — structured
    // concurrency, as in Trio / Kotlin / Swift.
    let handle = spawn(async {
        let (u, f) = fetch_user_with_friend(42).await;
        println(f"spawned:     user={u}, friend={f}");
    });
    // Awaiting the handle drives the task to completion — the
    // structured-concurrency join point.
    handle.await;
}
