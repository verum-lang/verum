// docs/by-example/13-channels/main.vr
// Channels: bounded capacity, backpressure, multi-producer.

mount core.async.channel.{bounded, Sender, Receiver};
mount core.io.println;

// `send` reports failure rather than panicking: it returns
// `Result<(), SendError<T>>`, and the Err case means the receiving
// end is gone. Discarding that answer is how a lost message becomes
// invisible, so this producer reports it.
fn produce(tx: &Sender<Int>, start: Int, count: Int) -> Int {
    let mut i = 0;
    let mut sent = 0;
    while i < count {
        match tx.send(start + i) {
            Ok(()) => { sent = sent + 1; }
            Err(_) => { break; }
        }
        i = i + 1;
    }
    sent
}

// `recv` answers `Maybe<T>`: `None` once the channel is empty and
// every Sender is gone. No sentinel value, no separate Done flag.
fn drain(rx: &mut Receiver<Int>) -> Int {
    let mut total = 0;
    while let Some(v) = rx.recv() {
        println(f"got {v}");
        total = total + v;
    }
    total
}

fn main() {
    // Bounded channel with capacity 16 — `send` refuses when the
    // buffer is full, which is what makes backpressure observable
    // instead of unbounded memory growth.
    let (tx, rx) = bounded<Int>(16);

    // Two producers feed the same channel; each holds its own handle.
    let tx2 = tx.clone();
    let a = produce(&tx, 0, 5);
    let b = produce(&tx2, 100, 5);
    println(f"sent {a + b} values");

    // Dropping every Sender is what lets the drain below terminate.
    drop(tx);
    drop(tx2);

    let mut receiver = rx;
    let total = drain(&mut receiver);
    println(f"total = {total}");
}
