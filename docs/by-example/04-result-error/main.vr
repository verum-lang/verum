// docs/by-example/04-result-error/main.vr
// Result<T, E>, Maybe<T>, and `?` propagation.

type NumberError is
    | EmptyInput
    | NotANumber(Text)
    | OutOfRange(Int);

fn parse_positive(s: &Text) -> Result<Int, NumberError> {
    if s.is_empty() {
        return Err(NumberError.EmptyInput);
    }
    // `parse_int` is the FALLIBLE reading: it reports what went wrong.
    // (`to_int` is the infallible one — it answers 0 for text that is
    // not a number, which is the wrong tool when you need to tell the
    // two cases apart.)
    let n = match s.parse_int() {
        Ok(v)  => v,
        Err(_) => return Err(NumberError.NotANumber(s.clone())),
    };
    if n <= 0 {
        return Err(NumberError.OutOfRange(n));
    }
    Ok(n)
}

fn double_positive(s: &Text) -> Result<Int, NumberError> {
    let n = parse_positive(s)?;          // ? propagates Err early
    Ok(n * 2)
}

fn report(s: &Text) {
    match double_positive(s) {
        Ok(n)                          => print(f"  {s} -> {n}"),
        Err(NumberError.EmptyInput)    => print(f"  {s} -> empty input rejected"),
        Err(NumberError.NotANumber(t)) => print(f"  {s} -> not a number: {t}"),
        Err(NumberError.OutOfRange(n)) => print(f"  {s} -> out of range: {n}"),
    }
}

fn main() {
    print("double_positive results:");
    report(&"7");
    report(&"42");
    report(&"");
    report(&"hello");
    report(&"-5");
}
