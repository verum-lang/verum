// @test: run-interpreter
// @level: L2
// @tags: database, postgres, migrations, concurrency
module postgres_migration_journal_reads.main;

mount core.base.env.var;
mount core.database.common.migrations.migration.MsApplied;
mount core.database.common.migrations.store.{MigrationStore, store_config_default};
mount core.database.postgres.config.{PgConfig, PgTlsMode};
mount core.database.postgres.connection.{PgConnection, connect};
mount core.database.postgres.migrations.store.store_new;

fn connection() -> PgConnection {
    let config = PgConfig.new(
        var(&"VERUM_PG_TEST_HOST").unwrap_or("127.0.0.1"),
        var(&"VERUM_PG_TEST_PORT").unwrap_or("55432").parse_int().unwrap(),
        var(&"VERUM_PG_TEST_USER").unwrap_or("spindle_admin"),
        var(&"VERUM_PG_TEST_PASSWORD").unwrap_or("spindle_admin_pw"),
        var(&"VERUM_PG_TEST_DATABASE").unwrap_or("spindle_test"),
    ).with_tls(PgTlsMode.PtmDisable);
    let mut conn = connect(&config).unwrap();
    conn.set_recv_timeout_ms(Maybe.Some(15000)).unwrap();
    conn.execute(&"SET statement_timeout='10s'").unwrap();
    conn
}

async fn main() {
    let reader = connection();
    let (pid, _) = reader.backend_key().unwrap();
    let mut store = store_new(reader, store_config_default().with_table_name("t42_journal"));
    assert_eq(store.load_journal().await.unwrap().entry_count(), 0);
    let mut rival = connection();
    rival.execute(&"DO $$ BEGIN IF to_regclass('t42_journal') IS NOT NULL THEN RAISE EXCEPTION 'reading created the journal'; END IF; END $$").unwrap();
    rival.execute(&"CREATE TABLE t42_journal (version bigint PRIMARY KEY, name text, status text, applied_at bigint, error text, checksum bigint); INSERT INTO t42_journal VALUES (5,'original','applied',170,NULL,-71)").unwrap();
    let first = store.load_journal().await.unwrap();
    let original = first.lookup(5).unwrap();
    assert_eq(original.name, "original");
    assert_eq(original.checksum, -71_i64);
    match original.status {
        MsApplied(when_) => assert_eq(when_, 170_i64),
        _ => panic("unexpected original journal status"),
    }

    rival.execute(&"BEGIN; ALTER TABLE t42_journal RENAME TO t42_original; CREATE TABLE t42_journal (LIKE t42_original INCLUDING ALL); INSERT INTO t42_journal VALUES (9,'replacement','applied',200,NULL,24)").unwrap();
    // The first COPY row flushes before the DO waits for the reader's table lock.
    rival.start_copy_out_session(&f"COPY (SELECT repeat('x',32768)) TO STDOUT; DO $$ BEGIN WHILE NOT pg_backend_pid()=ANY(pg_blocking_pids({pid})) LOOP PERFORM pg_sleep(0.01); END LOOP; END $$; COMMIT").unwrap();
    let stale = store.load_journal().await;
    assert(rival.read_copy_out_chunk().unwrap() is Maybe.Some(_));
    assert(rival.read_copy_out_chunk().unwrap() is Maybe.None);
    rival.finish_copy_out_session().unwrap();
    match stale {
        Result.Err(error) => assert(error.message().contains(&"replaced")),
        Result.Ok(_) => panic("stale read returned rows from the replacement"),
    }

    let fresh = store.load_journal().await.unwrap();
    assert_eq(fresh.entry_count(), 1);
    assert(fresh.lookup(5) is Maybe.None);
    assert_eq(fresh.lookup(9).unwrap().name, "replacement");
    rival.execute(&"DROP TABLE t42_journal,t42_original").unwrap();
    rival.close().unwrap();
    print("PASS t42_migration_journal_reads");
}
