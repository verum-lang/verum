// @test: run-interpreter
// @level: L2
// @tags: database, postgres, prepared, connection
module postgres_typed_query_recovery.main;

mount core.base.env.var;
mount core.database.common.error.DbError;
mount core.database.postgres.config.{PgConfig, PgTlsMode};
mount core.database.postgres.connection.{PgConnection, PcsReady, PcsBusy, PcsFailed, connect};
mount core.database.postgres.wire.backend.{TxIdle, TxInTransaction};
mount core.database.postgres.wire.typed.TypedValue;

fn main() {
    let config = PgConfig.new(
        var(&"VERUM_PG_TEST_HOST").unwrap_or("127.0.0.1"),
        var(&"VERUM_PG_TEST_PORT").unwrap_or("55432").parse_int().unwrap(),
        var(&"VERUM_PG_TEST_USER").unwrap_or("spindle_admin"),
        var(&"VERUM_PG_TEST_PASSWORD").unwrap_or("spindle_admin_pw"),
        var(&"VERUM_PG_TEST_DATABASE").unwrap_or("spindle_test"),
    ).with_tls(PgTlsMode.PtmDisable);
    let mut conn: PgConnection = connect(&config).unwrap();
    conn.set_recv_timeout_ms(Maybe.Some(5000)).unwrap();
    conn.execute(&"BEGIN").unwrap();
    conn.execute(&"CREATE TYPE pg_temp.t40_value AS ENUM ('bad')").unwrap();
    // A decodable first row precedes an unsupported field and another row.
    let mixed = conn.prepare(&"SELECT i::bigint, (CASE WHEN i>1 THEN 'bad' END)::pg_temp.t40_value FROM pg_catalog.generate_series(1,3) i ORDER BY i").unwrap();
    let empty: List<Maybe<TypedValue>> = [];
    match conn.execute_prepared_typed(&mixed, &empty) {
        Result.Err(DbError.DecodeFailed { fault: _ }) => {},
        _ => panic("unsupported typed result did not return its decode error"),
    }
    match conn.state() {
        PcsReady => {},
        PcsBusy => panic("typed row decode returned with the session still busy"),
        _ => panic("recoverable typed row decode did not return a ready session"),
    }
    assert(conn.tx_status() is TxInTransaction);
    conn.close_prepared(&mixed).unwrap();
    let good = conn.prepare(&"SELECT 71::bigint").unwrap();
    let good_rows = conn.execute_prepared_typed(&good, &empty).unwrap().rows;
    assert_eq(good_rows.len(), 1);
    match &good_rows[0][0] {
        TypedValue.TvInt8(value) => assert_eq(*value, 71),
        _ => panic("typed query lost its protocol boundary"),
    }
    conn.execute(&"ROLLBACK").unwrap();
    assert(conn.tx_status() is TxIdle);

    // Terminate only the backend just opened by this test. A missing
    // ReadyForQuery must poison it, whether the write or the read detects EOF.
    let (pid, _) = conn.backend_key().unwrap();
    let mut observer = connect(&config).unwrap();
    observer.execute(&f"SELECT pg_catalog.pg_terminate_backend({pid},5000)").unwrap();
    assert(conn.execute_prepared_typed(&good, &empty) is Result.Err(_));
    assert(conn.state() is PcsFailed);
    assert(conn.execute(&"SELECT 1") is Result.Err(_));
    conn.close().unwrap();
    observer.close().unwrap();
    print("PASS t40_typed_query_recovery");
}
