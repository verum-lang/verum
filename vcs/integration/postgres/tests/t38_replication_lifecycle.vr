// @test: run-interpreter
// @level: L2
// @tags: database, postgres, replication, cancellation
module postgres_replication_lifecycle.main;

mount core.base.env.var;
mount core.async.cancellation.CancellationToken;
mount core.database.postgres.config.{PgConfig, PgTlsMode};
mount core.database.postgres.replication.{PgReplicationConfig, Lsn};
mount core.database.postgres.async_replication.{
    AsyncPgReplicationConnection, ReplActorEvent, ReaClosed, connect_replication_async,
};

async fn open() -> AsyncPgReplicationConnection {
    let host = var(&"VERUM_PG_TEST_HOST").unwrap_or("127.0.0.1");
    let port = var(&"VERUM_PG_TEST_PORT").unwrap_or("55432").parse_int().unwrap();
    let user = var(&"VERUM_PG_TEST_USER").unwrap_or("spindle_admin");
    let password = var(&"VERUM_PG_TEST_PASSWORD").unwrap_or("spindle_admin_pw");
    let database = var(&"VERUM_PG_TEST_DATABASE").unwrap_or("spindle_test");
    let config = PgConfig.new(host, port, user, password, database).with_tls(PgTlsMode.PtmDisable);
    connect_replication_async(PgReplicationConfig.physical(config)).await.unwrap()
}

async fn expect_closed(repl: &AsyncPgReplicationConnection) {
    assert(repl.identify_system().await.is_err());
    repl.close().await.unwrap();
    match repl.next_event().await {
        Maybe.Some(ReaClosed) => {}
        _ => { panic("expected one clean terminal event"); }
    }
    assert(repl.next_event().await.is_none());
}

async fn main() {
    let repl = open().await;
    let other = repl.clone();
    let _ = other.identify_system().await.unwrap();
    assert(other.send_standby_status(Lsn.zero(), Lsn.zero(), Lsn.zero(), 0, false).await.is_err());
    repl.close().await.unwrap();
    expect_closed(&other).await;

    let cancel = CancellationToken.new();
    let cancellable = open().await;
    cancellable.attach_cancellation_token(cancel.clone());
    cancel.cancel();
    expect_closed(&cancellable).await;

    let already_cancelled = open().await;
    already_cancelled.attach_cancellation_token(cancel);
    expect_closed(&already_cancelled).await;
    println("PASS t38_replication_lifecycle");
}
