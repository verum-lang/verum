// @test: run-interpreter
// @level: L2
// @tags: database, postgres, integration
// @description: A failed shutdown can be retried after START_REPLICATION, and clones write its final checkpoint once.
module postgres_replication_tracker.main;
mount core.base.env.var;
mount core.async.cancellation.CancellationToken;
mount core.async.timer.sleep_ms;
mount core.database.postgres.config.{PgConfig, PgTlsMode};
mount core.database.postgres.replication.{PgReplicationConfig, Lsn};
mount core.database.postgres.async_replication.connect_replication_async;
mount core.database.postgres.replication_tracker.{
    attach_tracker, load_start_lsn, PositionStore, MemoryPositionStore, LsnTrackerConfig, SoStored,
};

async fn main() {
    let host = var(&"VERUM_PG_TEST_HOST").unwrap_or("127.0.0.1");
    let port = var(&"VERUM_PG_TEST_PORT").unwrap_or("55432").parse_int().unwrap();
    let user = var(&"VERUM_PG_TEST_USER").unwrap_or("spindle_admin");
    let password = var(&"VERUM_PG_TEST_PASSWORD").unwrap_or("spindle_admin_pw");
    let database = var(&"VERUM_PG_TEST_DATABASE").unwrap_or("spindle_test");
    let config = PgConfig.new(host, port, user, password, database).with_tls(PgTlsMode.PtmDisable);
    let repl = connect_replication_async(PgReplicationConfig.physical(config)).await.unwrap();
    let mark = repl.identify_system().await.unwrap().xlogpos.raw();
    let store: Shared<dyn PositionStore> = Shared.new(MemoryPositionStore.new());
    let tracker = attach_tracker(repl.clone(), store.clone(), LsnTrackerConfig.default());
    assert(tracker.shutdown().await.is_err());
    assert_eq(tracker.metrics().status_writes, 0);

    repl.start_physical(&"", Lsn.from_int(mark), Maybe.None).await.unwrap();
    tracker.update_received(Lsn.from_int(mark));
    assert(tracker.confirm_flush(Lsn.from_int(mark - 2)).await is SoStored);
    assert_eq(tracker.snapshot().apply.raw(), 0);
    tracker.confirm_apply(Lsn.from_int(mark - 1));
    assert_eq(tracker.snapshot().apply.raw(), mark - 2);
    assert(tracker.confirm_flush(Lsn.from_int(mark)).await is SoStored);
    assert_eq(tracker.snapshot().apply.raw(), mark - 1);
    assert_eq(load_start_lsn(&store).raw(), mark);

    tracker.shutdown().await.unwrap();
    let other = tracker.clone();
    other.shutdown().await.unwrap();
    assert_eq(other.metrics().status_writes, 1);
    assert(other.metrics().last_status_us > 0);
    let periodic = attach_tracker(repl.clone(), store.clone(), LsnTrackerConfig {
        interval_ms: 10, persist_on_flush: false,
    });
    let token = CancellationToken.new();
    periodic.attach_cancellation_token(token.clone());
    sleep_ms(75).await;
    let before = periodic.metrics().status_writes;
    assert(before > 0);
    token.cancel();
    sleep_ms(75).await;
    let stopped = periodic.metrics().status_writes;
    assert(stopped > before);
    sleep_ms(50).await;
    assert_eq(periodic.metrics().status_writes, stopped);
    periodic.shutdown().await.unwrap();
    assert_eq(periodic.metrics().status_writes, stopped);
    repl.close().await.unwrap();
}
