// @test: verify-fail
// @tier: 0
// @level: L0
// @tags: verification, contracts, precondition, call-site, soundness
// @timeout: 30000
// @expected-error: "proof-failed"
// @expected-error: "did not discharge"
// Measured 2026-09-11 THROUGH THE RUNNER: the verify-fail executor prints
// `error<proof-failed>: `<name>` did not discharge`. `verum check` prints
// `error<E0319>` for the same file — a different pipeline, a different code.

module test_call_site_precondition_violation;

@verify(proof)
public fn divide(a: Int, b: Int) -> Int requires b != 0 {
    a / b
}

// FAIL: b = 0 unconditionally violates `requires b != 0`.
@verify(proof)
public fn caller_with_literal_zero() -> Int {
    divide(10, 0)
}

public fn main() -> Int {
    caller_with_literal_zero()
}
