// @test: run
// @level: L0
// @tier: 0
// @tags: modules, name-resolution, module-path, control
// @timeout: 60000
// @description: The POSITIVE pole for the module-path call gates.
//
//   `module_root_is_unknown` (T0806) rejects a call whose root names
//   nothing, and `module_member_is_missing` rejects a member a real
//   module does not have. Both answer only on evidence, and both would
//   look "fixed" if they simply rejected more — so the shapes that MUST
//   keep working are pinned here, in a file that runs.
//
//   Three of these were false positives during the T0806 work, each
//   caught by a sweep over core/ rather than by review:
//
//     * a call into a module named WITHOUT the root the archive keys it
//       under. `core/async/intrinsics.vr` writes `sys.linux.tls.ctx_get(0)`
//       with no mount, and every probe in the resolver front-strips the
//       QUERY — which can never reach a key that has one segment MORE.
//       Both the module oracle and the candidate list needed the mirror.
//     * a call through a real inline module path.
//     * a chained call, where a later step reuses the outermost receiver
//       and so still reads as a module path.
// @expected-stdout-begin
// inline=true
// nested=7
// chained=3
// @expected-stdout-end

module geo {
    public module point {
        public fn origin_is_zero() -> Bool { true }
        public fn seven() -> Int { 7 }
    }
}

fn main() {
    // A real inline module path, two segments deep.
    print(f"inline={geo.point.origin_is_zero()}");
    print(f"nested={geo.point.seven()}");

    // A CHAIN whose first step is a module path: the later step reuses
    // the outermost receiver, so it still reads as `geo.point.…` to the
    // resolver. `skip_static_lookup` is what tells the gates to decline.
    let xs: List<Int> = [1, 2, 3];
    print(f"chained={xs.len()}");
}
