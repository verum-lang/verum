// @test: compile-fail
// E204 is raised AFTER the type-check phase, so `typecheck-fail` could not
// observe it: the file type-checks clean and the runner reported "typecheck
// unexpectedly succeeded" — indistinguishable from a missing compiler check.
// @tier: 0
// @level: L0
// @tags: modules, circular, constants, error
// @expected-error: E204
// The code moved on 2026-09-10 (d34547fcc): this diagnostic carries E204,
// and its text no longer opens with a second, foreign `E600:` — which is the
// context system's "context not provided".
//
// A `verum` older than that still prints the old pair, and `compile-fail` is
// the one test type that always spawns an EXTERNAL verum rather than the
// in-process compiler. Until T1429 the runner picked that binary off `PATH`,
// so this spec was measuring whatever was installed — locally a build 17 days
// older than the tree. It now uses the `verum` built beside the runner.


/// Circular VALUE dependencies are FORBIDDEN.
/// Constants cannot depend on each other circularly.
/// This test verifies the compiler detects and reports this error.

// Without this line the circular-constant check does not run at all and the
// file type-checks clean — the spec then reports "typecheck unexpectedly
// succeeded" and looks like a missing compiler check rather than a missing
// mount. Every other L0 spec carries it; this one was left out.
mount core.prelude.*;

module const_a {
    mount cog.const_b.VALUE_B;

    // ERROR: VALUE_A depends on VALUE_B which depends on VALUE_A
    pub const VALUE_A: Int = VALUE_B + 1;
}

module const_b {
    mount cog.const_a.VALUE_A;

    // ERROR: VALUE_B depends on VALUE_A which depends on VALUE_B
    pub const VALUE_B: Int = VALUE_A + 1;
}

fn main() -> Int {
    0
}
