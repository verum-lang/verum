fn main() {
    let first = unsafe { spec_getpid_0() };
    let last  = unsafe { spec_getpid_129() };

    // PRINT BEFORE ASSERTING: "both zero" and "they disagree" are
    // different failures and must not look alike in the log.
    println(f"first={first} last={last} equal={first == last}");

    // A pid is never 0 for a running process, so this catches the case
    // where BOTH reads land in an untouched register.
    assert(first > 0);
    assert(last > 0);
    assert_eq(first, last);
}
