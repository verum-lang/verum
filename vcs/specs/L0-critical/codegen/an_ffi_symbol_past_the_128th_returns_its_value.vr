// @test: run
// @tier: 0,1
// @level: L0
// @tags: ffi, codegen, aot, operand-encoding, regression
// @timeout: 120000
// @expected-exit: 0
//
// AN FFI SYMBOL PAST THE 128th STILL RETURNS ITS VALUE (T1412).
//
// The VBC `CallFfi*` instruction encodes
//
//     symbol_idx:u32   FOUR RAW little-endian bytes
//     arg_count:u8     ONE RAW byte
//     ret_reg          VARINT  (<128 one byte, else 0x80|(reg>>8) + low)
//     [arg_regs...]    VARINTs
//
// and Tier 1 decoded the return register with a helper that walks
// VARINTS FROM BYTE ZERO — so it parsed the four raw index bytes as
// varints. At symbol index 128 the first raw byte is 0x80, its high bit
// makes the reader consume two bytes, every later index shifts by one,
// and the call's result was written to the wrong register.
//
// MEASURED before the fix, this exact program:
//
//     tier 0    first=66532 last=66532 equal=true
//     tier 1    first=66420 last=0     equal=false
//
// WHY 130 DECLARATIONS AND WHY THEY ARE ALL THE SAME FUNCTION. Every one
// binds the C symbol `getpid` through `@ffi_name`, so the callee is
// identical across all of them and the ONLY thing that varies is the
// symbol INDEX. A spec that used 130 different C functions would fail
// for 130 possible reasons; this one can only fail for the index.
//
// `getpid()` returns the process id — the same value on every call
// within one run, which is the invariant. No external oracle is needed
// and the spec cannot rot: it does not pin a number, it pins that two
// calls to one function agree.

mount core.io.println;

@ffi("libSystem.B.dylib")
extern {
    @ffi_name("getpid")
    public fn spec_getpid_0() -> Int32;
    @ffi_name("getpid")
    public fn spec_getpid_1() -> Int32;
    @ffi_name("getpid")
    public fn spec_getpid_2() -> Int32;
    @ffi_name("getpid")
    public fn spec_getpid_3() -> Int32;
