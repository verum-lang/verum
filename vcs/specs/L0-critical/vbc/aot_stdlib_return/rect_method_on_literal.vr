// @test: run
// @tier: 1
// @level: L0
// @tags: aot, stdlib, record, layout, regression
// @expected-exit: 0
// @description: Read caller-constructed record fields through compiled stdlib methods.

mount core.term.layout.{Margin, Rect};

fn main() {
    let margin = Margin { top: 5, right: 10, bottom: 24, left: 80 };
    assert_eq(margin.total_horizontal(), 90);
    assert_eq(margin.total_vertical(), 29);

    let r = Rect.new(5, 10, 80, 24);
    assert_eq(r.area(), 1920);
    assert_eq(r.left(), 5);
    assert_eq(r.top(), 10);
    assert_eq(r.right(), 85);
    assert_eq(r.bottom(), 34);
}
