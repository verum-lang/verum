// @test: run-interpreter
// @level: L0
// @tier: 0
// @tags: vbc, closures, registers, retain
// @timeout: 120000
// @expected-stdout-begin
// before 3
// after 2
// param [1, 3]
// truncate [1, 2]
// @expected-stdout-end

// `do_return` writes the callee's return value into the caller frame's
// `return_reg`. The synchronous CLOSURE helper has no real destination,
// and its `Reg(0)` placeholder therefore overwrote the caller's r0 —
// `self` in any method frame.
//
// `List.retain`'s intercept calls that helper once per element, so
//
//     fn drop_evens(&mut self) { self.items.retain(|x| *x % 2 == 1); }
//
// returned with `self` replaced by the closure's last Bool, and the
// caller's own write-back — the `SetF { obj: Reg(0), field_idx: 0 }`
// codegen emits to commit a mutated field back into its record —
// refused it as a null pointer:
//
//     op=opcode 0x63 at Bag.drop_evens (pc=30)
//
// THE FRAME NAME WAS RIGHT AND WAS READ AS WRONG for eight days: the
// row that opened this took it for "the SetF inside List.retain,
// attributed to its caller" and put the blame on `self.len = write`.
// `VERUM_TRACE_CALLS=1` says `List.retain` is never ENTERED, and the
// body really is 35 bytes, so pc=30 is inside it.
//
// The twin helper `call_function_sync` has carried the save/restore
// since its own casualty (a `Drain.next` call overwriting `self` in
// `ThreadHazardRecord.reclaim`); the closure helper beside it did not.
//
// `truncate` is in this file as the discriminator: it emits the
// IDENTICAL write-back through the same field and has always worked,
// because it takes no closure and never reaches the helper. A fix that
// moved the write-back instead of the clobber would break it.
//
// The `&mut Bag` parameter is here because the axis is a `&mut Record`
// receiver, not a `self` one — a free function fails identically.

type Bag is { items: List<Int> };

implement Bag {
    public fn new() -> Bag { Bag { items: List.new() } }
    public fn add(&mut self, v: Int) { self.items.push(v); }
    public fn drop_evens(&mut self) { self.items.retain(|x| *x % 2 == 1); }
    public fn trunc(&mut self) { self.items.truncate(2); }
}

fn via_param(b: &mut Bag) { b.items.retain(|x| *x % 2 == 1); }

fn main() {
    let mut b = Bag.new();
    b.add(1); b.add(2); b.add(3);
    print(f"before {b.items.len()}");
    b.drop_evens();
    print(f"after {b.items.len()}");

    let mut p = Bag { items: [1, 2, 3] };
    via_param(&mut p);
    print(f"param {p.items:?}");

    let mut t = Bag { items: [1, 2, 3] };
    t.trunc();
    print(f"truncate {t.items:?}");
}
