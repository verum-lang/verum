// @test: check
// @level: L0
// @tier: 0
// @tags: protocols, associated-types, bounds
// @timeout: 20000
// @expected-exit: 101
// @expected-stderr: does not satisfy the bound
// @description: An associated type that does NOT satisfy its protocol's
//   bound is refused.

// The negative half of T1074. Before the fix this compiled clean, exit 0:
// `Plain` implements nothing, and `type Item: Shower` was never checked
// against it. See `associated_type_bound_is_enforced.vr` for the
// positive half — a check that refuses everything passes this file and
// fails that one.

type Shower is protocol {
    fn show(&self) -> Text;
};

type Holder is protocol {
    type Item: Shower;
    fn item(&self) -> Self.Item;
};

type Plain is { v: Int };

type Box is { p: Plain };

implement Holder for Box {
    type Item = Plain;

    public fn item(&self) -> Plain {
        self.p
    }
}

public fn main() -> Int {
    let b = Box { p: Plain { v: 1 } };
    let _ = b.item();
    0
}
