// @test: typecheck-fail
// @level: L0
// @tier: 0
// @tags: affine, linearity, control-flow, branches
// @description: The negative pole — a value consumed in ONE arm may not
//   be used after the match.
//
// The companion to `affine_consumed_once_per_exclusive_arm`. That file
// checks the arms are treated as alternatives; this one checks they are
// still MERGED afterwards.
//
// Per-branch restoration on its own would be a hole: if each arm starts
// from the state at the match and nothing folds the arms back together,
// then a value consumed in any arm looks untouched after the match and
// can be consumed a second time. That is the double-free an affine type
// exists to prevent, and it would have been introduced by the fix for
// the false positive — which is why the two files ship together.
//
// Here `t` is consumed on the `true` arm and used again below. One
// execution reaches both consumptions, so this must be refused.

type affine Tx is { id: Int };

fn commit(t: Tx) -> Int {
    t.id
}

fn twice(t: Tx, ok: Bool) -> Int {
    let first = match ok {
        true  => commit(t),
        false => 0,
    };
    // ERROR: on the `true` path `t` is already gone.
    first + commit(t)
}

fn main() {
    print(f"{twice(Tx { id: 7 }, true)}");
}
