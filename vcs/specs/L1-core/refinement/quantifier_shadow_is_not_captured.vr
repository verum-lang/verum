// @test: verify-pass
// @tier: 0
// @level: L1
// @tags: refinement, quantifiers, forall, exists, substitution, capture, soundness
// @timeout: 30000

/// A quantified refinement is substituted, decided and ENFORCED.
///
/// Substituting a value into a refinement predicate walks the predicate
/// replacing the refinement variable. That walk had explicit rules for
/// `block`, `if`, `match`, `closure` and `for`, and none for `forall`
/// or `exists` — so a quantifier fell through to the structural walk,
/// which rebuilds a node with every child substituted and knows nothing
/// about what the node binds. The QUANTIFIED variable was rewritten.
///
/// What stood there was `debug_assert!(!introduces_bindings(..))`,
/// which is not a guard: release builds delete it, so that is where the
/// capture happened, in silence. In a debug build it aborted the
/// verifier outright, and three L1 specs did exactly that the moment
/// the suite started running a verifier at all (T0957):
/// `quantified_refinements`, `quantified_predicates`, `smt_integration`.
///
/// WHAT THIS FILE PINS. A quantifier that binds something ELSE must
/// still let the refinement variable be substituted — in the guard and
/// in the body. Refusing to descend into every binder would be sound
/// and useless: an unsubstituted refinement variable leaves the
/// predicate speaking about a name nothing binds, the solver answers
/// `unknown`, and nothing is proved.
///
/// Its negative pole is `quantifier_shadow_is_uninhabited.vr`, where
/// the quantifier binds the refinement's OWN name and the resulting
/// type is uninhabited. That file could not exist until three things
/// were true together: substitution had to stop capturing the bound
/// variable (T0958), the refinement path had to translate quantifiers,
/// and the consumer of the verdict had to trust an SMT `Invalid` over
/// a literal (T0967). Before that the predicate came back `unknown`
/// and was not enforced, so a claim about it was green whether true or
/// false.
///
/// Task: T0958.

/// The quantifier binds something ELSE, so the refinement variable is
/// the one that must be replaced — in the guard and in the body.
type BeatsAll is m: Int where forall k: Int. k >= 0 && k < 3 => m >= k;

/// The same claim with a RANGE domain, the spelling the rest of the
/// corpus uses.
type BeatsAllRange is m: Int where forall k in 0..3 => m >= k;

/// An existential that holds.
type SomeBelow is m: Int where exists k: Int. k >= 0 && k < 3 && k < m;

@verify(formal)
public fn a_non_shadowing_forall_is_enforced(n: Int) -> Int
    requires n == 0
    ensures result == 9
{
    let v: BeatsAll = 9;
    v
}

@verify(formal)
public fn a_range_domain_is_enforced(n: Int) -> Int
    requires n == 0
    ensures result == 9
{
    let v: BeatsAllRange = 9;
    v
}

@verify(formal)
public fn an_existential_is_enforced(n: Int) -> Int
    requires n == 0
    ensures result == 9
{
    let v: SomeBelow = 9;
    v
}

/// The control that keeps this file from passing on an empty verifier:
/// an ordinary contract in the same file must still discharge, and a
/// quantifier in an `ensures` — which IS decided — must still hold.
@verify(formal)
public fn ordinary_contracts_still_discharge(m: Int) -> Int
    requires m == 9
    ensures result >= 0
    ensures forall k: Int. k >= 0 && k < 3 => result >= k
{
    m
}

mount core.prelude.*;

fn main() {
    print("a quantified refinement does not kill the verifier");
}
