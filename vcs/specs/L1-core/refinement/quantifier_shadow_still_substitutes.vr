// @test: verify-pass
// @tier: 0
// @level: L1
// @tags: refinement, quantifiers, forall, exists, substitution
// @timeout: 30000

/// The other half of `quantifier_shadow_is_not_captured.vr`.
///
/// That file pins that substitution must not reach INSIDE a quantifier
/// that rebinds the name. Refusing to substitute at all would satisfy it
/// and would be useless: an unsubstituted refinement variable leaves the
/// predicate speaking about a name nothing binds, the solver answers
/// `unknown`, and nothing is proved.
///
/// So this file states quantified refinements that DO hold, where the
/// quantifier binds a DIFFERENT name and the refinement variable must
/// still be replaced — in the quantifier's domain, in its guard, and in
/// its body.
///
/// Task: T0958.

/// The refinement variable appears in the quantifier's DOMAIN. The domain
/// is not inside the binding's own scope, so `n` here is the outer `n`.
type UpToN is n: Int where forall k in 0..n => k <= n;

/// The refinement variable appears in the quantifier's BODY, under a
/// binder that names something else.
type BeatsAll is m: Int where forall k in 0..3 => m >= k;

/// The same for the existential.
type SomeBelow is m: Int where exists k in 0..3 => k < m;

@verify(formal)
public fn domain_mentions_the_refined_name() -> UpToN {
    5
}

@verify(formal)
public fn body_mentions_the_refined_name() -> BeatsAll {
    9
}

@verify(formal)
public fn existential_mentions_the_refined_name() -> SomeBelow {
    9
}

mount core.prelude.*;

fn main() {
    print("substitution still reaches past a quantifier that binds elsewhere");
}
