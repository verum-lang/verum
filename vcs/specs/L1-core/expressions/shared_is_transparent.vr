// @test: run
// @tier: 0
// @level: L1
// @tags: shared, deref, transparency, T0872
// @timeout: 30000
// @description: T0872 — a `Shared<T>` answers for the value it holds.
//   `len` and `is_empty` do not become method calls: they lower to
//   direct opcodes, so the auto-deref the method dispatcher performs
//   for a `Shared` carrier never ran for them. A carrier cell is
//   `[header][rc][inner]` — two slots — so `Shared.new(list).len()`
//   answered a constant 2 for EVERY list it wrapped. Not a crash: a
//   plausible number, reported by nothing, in the ordinary way to
//   share a value.
//
//   Both poles are pinned here. The transparent reads must agree with
//   the same reads on the unwrapped value, AND `strong_count` — one of
//   Shared's OWN methods — must still answer about the carrier rather
//   than being forwarded to the value. A fix that peels unconditionally
//   passes the first half and breaks the second.
//
//   ROUND TWO (2026-08-28): the first fix peeled POINTERS, so it cured
//   `Shared<List<Int>>` — a list is a heap pointer — and left every
//   carrier holding a NaN-boxed inner untouched. `Shared.new("hello")`
//   and `Shared.new("hi")` both still answered 2, and so did
//   `Shared<Shared<List>>` one level up; `Shared.new(list)[1]` returned
//   the whole list. The three cases below are why the peel now happens
//   on the VALUE, before any branch asks what shape it has.
// @expected-stdout-begin
// direct_len=3
// direct_empty=false
// shared_len=3
// shared_empty=false
// wide_len=7
// empty_len=0
// empty_is_empty=true
// text_len=5
// text_short_len=2
// nested_len=4
// index_1=20
// strong=1
// @expected-stdout-end

fn main() {
    let xs: List<Int> = [1, 2, 3];
    print(f"direct_len={xs.len()}");
    print(f"direct_empty={xs.is_empty()}");

    let s = Shared.new(xs);
    print(f"shared_len={s.len()}");
    print(f"shared_empty={s.is_empty()}");

    // A different length, so a constant answer cannot pass by luck.
    let wide: List<Int> = [1, 2, 3, 4, 5, 6, 7];
    let sw = Shared.new(wide);
    print(f"wide_len={sw.len()}");

    // The empty pole: the carrier has slots even when the value has none.
    let none: List<Int> = [];
    let se = Shared.new(none);
    print(f"empty_len={se.len()}");
    print(f"empty_is_empty={se.is_empty()}");

    // A NaN-BOXED inner. `"hello"` is a small string carried inside the
    // value itself, not a heap pointer, so a peel that only follows
    // pointers does not fire — and the carrier's own two slots answer.
    // Two different texts, because a constant 2 passes one of them.
    print(f"text_len={Shared.new(\"hello\").len()}");
    print(f"text_short_len={Shared.new(\"hi\").len()}");

    // NESTED carriers: peeling once leaves another carrier, whose two
    // slots answer 2 exactly as before.
    let inner: List<Int> = [1, 2, 3, 4];
    print(f"nested_len={Shared.new(Shared.new(inner)).len()}");

    // INDEXING is the second direct opcode with the same blind spot:
    // `GetE` had no peel at all, so this read the carrier and returned
    // the whole list.
    let idx: List<Int> = [10, 20, 30];
    print(f"index_1={Shared.new(idx)[1]}");

    // Shared's own method still answers about the CARRIER.
    print(f"strong={se.strong_count()}");
}
