// @test: typecheck-pass
// @level: L1
// @tier: 0
// @tags: patterns, let, irrefutable, let-else
// @timeout: 20000
// @description: The control for the `let` refutability check — every form
//   that ALWAYS matches, plus `let … else`, stays accepted.

// A check that refuses is only worth as much as its true pole. This file
// is that pole: if the refutability predicate ever widens past syntax it
// can prove, one of these goes red.

type Pair is (Int, Int);
type Point is { x: Int, y: Int };

fn main() {
    // A name always matches.
    let n = 5;

    // So does a wildcard, a tuple of names, and a record of names.
    let _ = n;
    let (a, b) = (1, 2);
    let Point { x, y } = Point { x: 3, y: 4 };

    // A single-variant newtype destructured by name is irrefutable.
    let Pair(p, q) = Pair(5, 6);

    // And the refutable case has its own form, which this check must not
    // reach — `let … else` is a different statement in the grammar.
    let v: Maybe<Int> = Maybe.Some(7);
    let Maybe.Some(got) = v else { return; };

    // A comprehension binds once per row under the same rule. A name always
    // matches, and the documented shape — filter with `if`, then bind — must
    // stay legal.
    let xs = [1, 2, 3];
    let plus = set{ y for v in xs let y = v + 1 };

    print(n + a + b + x + y + p + q + got + plus.len());
}
