/// of Maybe cannot be inferred without an annotation.  Pre-fix this
/// file CHECKED CLEAN because `None` bound to a fully-concrete unit
/// variant of the wrong parent — a silent wrong type, strictly worse
/// than the error.

fn main() {
    let none_val = None;
    print("unreachable-under-correct-inference");
}
