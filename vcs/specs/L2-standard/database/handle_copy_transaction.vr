// @test: typecheck-fail
// @tier: 0
// @level: L2
// @tags: database, capability, transaction
// @expected-error: E400 "no method named `into_readwrite`"
// @expected-error-count: 1

mount core.database.common.capability.{DbCopy, DbReadWriteTx};
mount core.database.common.db_handle.{Database};
mount core.database.postgres.pool.{PgPool};

fn widen(handle: Database<PgPool, DbCopy>) -> Database<PgPool, DbReadWriteTx> {
    handle.into_readwrite()
}
