// @test: run-interpreter
// @tier: 0
// @level: L2
// @tags: sqlite, vdbe, ssa, dominance
// @timeout: 15000
// @expected-exit: 0

mount core.database.sqlite.native.l4_vdbe.ssa.value.{SValueKind, ssa_value, value_id};
mount core.database.sqlite.native.l4_vdbe.ssa.block.{block_id, block_id_raw};
mount core.database.sqlite.native.l4_vdbe.ssa.inst.SsaInst;
mount core.database.sqlite.native.l4_vdbe.ssa.cfg.{Cfg, cfg_new};
mount core.database.sqlite.native.l4_vdbe.ssa.dominator.{DomTree, build_dom_tree};

fn jump(cfg: &mut Cfg, source: Int, target: Int) {
    cfg.get_mut(&block_id(source)).set_terminator(SsaInst.IJump(block_id(target)));
}

fn branch(cfg: &mut Cfg, source: Int, left: Int, right: Int) {
    let condition = ssa_value(value_id(1), SValueKind.SkBool);
    cfg.get_mut(&block_id(source)).set_terminator(SsaInst.IBranch(condition, block_id(left), block_id(right)));
}

fn parent_of(dom: &DomTree, raw: Int) -> Int {
    match dom.immediate_dominator(&block_id(raw)) {
        Maybe.Some(parent) => block_id_raw(&parent),
        Maybe.None => -1,
    }
}

fn expect_one_frontier(dom: &DomTree, raw: Int, target: Int) {
    let frontier = dom.frontier_of(&block_id(raw));
    assert_eq(frontier.len(), 1);
    assert_eq(block_id_raw(&frontier[0]), target);
}

fn diamond_loop_and_unreachable_predecessor() {
    let mut cfg = cfg_new();
    while cfg.block_count() < 7 { let _ = cfg.new_block(); }
    branch(&mut cfg, 0, 1, 2);
    jump(&mut cfg, 1, 3);
    jump(&mut cfg, 2, 3);
    branch(&mut cfg, 3, 1, 4);
    jump(&mut cfg, 5, 4);
    jump(&mut cfg, 6, 5);
    let dom = build_dom_tree(&cfg);
    assert_eq(parent_of(&dom, 0), -1);
    assert_eq(parent_of(&dom, 1), 0);
    assert_eq(parent_of(&dom, 2), 0);
    assert_eq(parent_of(&dom, 3), 0);
    assert_eq(parent_of(&dom, 4), 3);
    assert(dom.dominates(&block_id(0), &block_id(4)));
    assert(dom.dominates(&block_id(3), &block_id(3)));
    assert(!dom.dominates(&block_id(1), &block_id(3)));
    assert_eq(dom.frontier_of(&block_id(0)).len(), 0);
    expect_one_frontier(&dom, 1, 3);
    expect_one_frontier(&dom, 2, 3);
    expect_one_frontier(&dom, 3, 1);
    for raw in [-1, 5, 6, 7] {
        assert_eq(parent_of(&dom, raw), -1);
        assert(!dom.dominates(&block_id(raw), &block_id(raw)));
        assert(!dom.dominates(&block_id(0), &block_id(raw)));
        assert(!dom.dominates(&block_id(raw), &block_id(4)));
        assert_eq(dom.frontier_of(&block_id(raw)).len(), 0);
    }
    cfg.compute_preds();
    cfg.get_mut(&block_id(2)).set_terminator(SsaInst.IHalt(0, ""));
    let updated = build_dom_tree(&cfg);
    assert_eq(parent_of(&updated, 3), 1);
    assert(updated.dominates(&block_id(1), &block_id(4)));
    expect_one_frontier(&updated, 1, 1);
    assert_eq(updated.frontier_of(&block_id(2)).len(), 0);
}

fn entry_backedges() {
    let mut cfg = cfg_new();
    jump(&mut cfg, 0, 0);
    let self_loop = build_dom_tree(&cfg);
    assert_eq(parent_of(&self_loop, 0), -1);
    expect_one_frontier(&self_loop, 0, 0);
    let _ = cfg.new_block();
    jump(&mut cfg, 0, 1);
    jump(&mut cfg, 1, 0);
    let cycle = build_dom_tree(&cfg);
    assert_eq(parent_of(&cycle, 1), 0);
    expect_one_frontier(&cycle, 0, 0);
    expect_one_frontier(&cycle, 1, 0);
}

fn deep_chain() {
    let mut cfg = cfg_new();
    while cfg.block_count() < 512 {
        let next = cfg.new_block();
        let raw = block_id_raw(&next);
        jump(&mut cfg, raw - 1, raw);
    }
    let dom = build_dom_tree(&cfg);
    assert_eq(parent_of(&dom, 511), 510);
    assert(dom.dominates(&block_id(0), &block_id(511)));
    assert(!dom.dominates(&block_id(511), &block_id(0)));
    assert_eq(dom.frontier_of(&block_id(511)).len(), 0);
}

fn main() {
    diamond_loop_and_unreachable_predecessor();
    entry_backedges();
    deep_chain();
}
