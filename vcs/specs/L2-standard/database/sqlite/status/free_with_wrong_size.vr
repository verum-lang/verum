// @test: run-interpreter-panic
// @tier: 0
// @level: L2
// @tags: sqlite, status, allocator
// @timeout: 5000
// @expected-panic: free size disagrees with outstanding SQLite allocations

mount core.database.sqlite.native.status.process.process_status_new;

fn main() {
    let mut p = process_status_new();
    p.note_allocation(1_i64, 16_i64);
    p.note_free(8_i64);
}
