// @test: typecheck-pass
// @level: L2
// @tier: 0
// @tags: sqlite, native, pager, cache, lru, generation
// @timeout: 10000
// @description: PageCache — get/put, LRU eviction, pin/unpin, generation bump
//
// Spec: sqlite-native spec §4.3 + §8.2

module core.database.sqlite.native.l1_pager.tests.cache_lru;

mount core.base.maybe.Maybe;
mount core.collections.List;
mount core.database.sqlite.native.l1_pager.pager.PageFrame;
mount core.database.sqlite.native.l1_pager.page_cache.{PageCache, page_cache_new};

fn put_empty(cache: &mut PageCache, number: Int, size: Int) {
    let bytes: List<Byte> = List.from_elem(0 as Byte, size);
    let page = PageFrame.new(number, bytes);
    cache.store_page(&page, false);
}

fn basic_put_get() {
    let mut cache = page_cache_new(4);
    put_empty(&mut cache, 1, 16);
    put_empty(&mut cache, 2, 16);
    assert_eq(cache.len(), 2);
    let hit = cache.get(1);
    match hit {
        Maybe.Some(_) => {},
        Maybe.None    => panic("expected hit on page 1"),
    }
    assert_eq(cache.hit_count(), 1);
    assert_eq(cache.miss_count(), 0);
}

fn miss_then_put() {
    let mut cache = page_cache_new(4);
    let miss = cache.get(99);
    match miss {
        Maybe.Some(_) => panic("expected miss on empty cache"),
        Maybe.None    => {},
    }
    assert_eq(cache.miss_count(), 1);
    put_empty(&mut cache, 99, 8);
    let hit = cache.get(99);
    match hit {
        Maybe.Some(_) => {},
        Maybe.None    => panic("expected hit after put"),
    }
}

fn generation_invalidation() {
    let mut cache = page_cache_new(4);
    put_empty(&mut cache, 1, 16);
    let gen0 = cache.current_generation();
    let gen1 = cache.bump_generation();
    assert(gen1 > gen0);
    // After bump, page 1 reads as miss.
    let after = cache.get(1);
    match after {
        Maybe.Some(_) => panic("expected miss after generation bump"),
        Maybe.None    => {},
    }
}

fn pin_blocks_eviction_surface() {
    let mut cache = page_cache_new(2);
    put_empty(&mut cache, 1, 16);
    put_empty(&mut cache, 2, 16);
    let _ = cache.pin(1);
    // Inserting a third — evict_one skips pinned page 1 and removes page 2.
    put_empty(&mut cache, 3, 16);
    assert_eq(cache.len(), 2);
    let _ = cache.unpin(1);
}

fn mark_dirty_and_clear() {
    let mut cache = page_cache_new(4);
    put_empty(&mut cache, 1, 16);
    let _ = cache.mark_dirty(1);
    cache.clear();
    assert_eq(cache.len(), 0);
}

fn reconfigure_shrink() {
    let mut cache = page_cache_new(4);
    put_empty(&mut cache, 1, 16);
    put_empty(&mut cache, 2, 16);
    put_empty(&mut cache, 3, 16);
    cache.configure(1);
    assert(cache.len() <= 1);
}

fn main() {
    basic_put_get();
    miss_then_put();
    generation_invalidation();
    pin_blocks_eviction_surface();
    mark_dirty_and_clear();
    reconfigure_shrink();
    print("page_cache_lru typecheck ok");
}
