// @test: typecheck-pass
// @level: L2
// @tier: 0
// @tags: sqlite, native, sql, resolver
// @expected-exit: 0
// @description: SQL names resolve through the catalog, including aliases and nested expressions.

module core.database.sqlite.native.tests.resolver_and_scan;

mount core.database.sqlite.native.l5_sql.ast.{BinOp, ColumnDef, CreateTableStmt, Expr, SqlLiteral, TableRef};
mount core.database.sqlite.native.l5_sql.resolver.{ColumnScope, ResolveError, build_single_table_scope, resolve_expr, scope_from_table_meta};
mount core.database.sqlite.native.l6_session.schema_cache.{schema_cache_new, table_meta_from_create};

fn table(name: Text, alias: Text) -> TableRef {
    TableRef { schema: "", name, alias }
}

fn column(qualifier: Text, name: Text) -> Expr {
    Expr.EColumn(table(qualifier, ""), name)
}

fn main() {
    let create = CreateTableStmt {
        table: table("users", ""), if_not_exists: false, temporary: false,
        columns: [
            ColumnDef { name: "ID", declared_type: "INTEGER", constraints: [] },
            ColumnDef { name: "Ä", declared_type: "TEXT", constraints: [] },
        ],
        constraints: [], strict: false, without_rowid: false,
    };
    let meta = table_meta_from_create(&create, 2, "");
    let mut scopes: List<ColumnScope> = [scope_from_table_meta(3, "u", &meta)];

    match resolve_expr(&column("", "id"), &scopes) {
        Result.Ok(Expr.EColumnRef(3, 0)) => {},
        _ => panic("unqualified column"),
    }
    match resolve_expr(&column("U", "Ä"), &scopes) {
        Result.Ok(Expr.EColumnRef(3, 1)) => {},
        _ => panic("qualified column"),
    }
    assert(resolve_expr(&column("u", "ä"), &scopes) is Result.Err(ResolveError.UnknownColumn(_)));
    assert(resolve_expr(&column("users", "id"), &scopes) is Result.Err(ResolveError.UnknownTable(_)));

    let nested = Expr.EBinary(BinOp.BEq, Heap.new(column("u", "ID")), Heap.new(Expr.ELit(SqlLiteral.LInt(1_i64))));
    match resolve_expr(&nested, &scopes) {
        Result.Ok(Expr.EBinary(_, ref left, _)) => assert(left.as_ref() is Expr.EColumnRef(3, 0)),
        _ => panic("nested column"),
    }
    let absent = Expr.ECoalesce([column("", "id"), column("", "missing")]);
    assert(resolve_expr(&absent, &scopes) is Result.Err(ResolveError.UnknownColumn(_)));

    scopes.push(scope_from_table_meta(4, "other", &meta));
    assert(resolve_expr(&column("", "id"), &scopes) is Result.Err(ResolveError.AmbiguousColumn(_)));

    let mut cache = schema_cache_new();
    cache.register_table(meta).unwrap();
    assert(build_single_table_scope(&cache, &table("users", ""), 5).unwrap().len() == 1);
    assert(build_single_table_scope(&cache, &table("absent", ""), 5) is Result.Err(ResolveError.UnknownTable(_)));
}
