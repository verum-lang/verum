mount core.async.channel.OneshotSender;
mount core.database.common.error.DbError;
mount core.database.postgres.async_connection.{PgRequest, ReqCommitTx};

fn build_raw_request(reply: OneshotSender<Result<(), DbError>>) -> PgRequest {
    ReqCommitTx { reply: reply }
}
