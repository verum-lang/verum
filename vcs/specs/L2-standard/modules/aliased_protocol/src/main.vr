// The program for `a_protocol_mounted_under_an_alias_still_checks.vr`.
// The directives live THERE, beside this project, never inside it: a
// file under an `@project:` directory that carries a `// @test:` header
// is discovered as a spec in its own right, and if the header does not
// parse the whole directory refuses to run (T1113).
//
// The impl below is WRONG ON PURPOSE — `Shower` declares `show(&self)
// -> Int` and this returns `Bool`. Mounting the protocol under an alias
// must not stop the compiler from saying so.

mount probe.lib.{Shower as S};

type Box is { v: Int };

implement S for Box {
    public fn show(&self) -> Bool {
        true
    }
}

fn main() {
    print("built");
}
