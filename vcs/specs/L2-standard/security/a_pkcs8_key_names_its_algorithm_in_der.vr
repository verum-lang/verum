// @test: run
// @level: L2
// @tier: 0
// @tags: security, x509, der, pkcs8, encoding
// @timeout: 20000
// @expected-stdout-begin
// p256_pkcs8 Ec
// ed25519_pkcs8 Ed25519
// rsa_pkcs8 Rsa
// ec_sec1 Ec
// rsa_pkcs1 Rsa
// garbage unrecognized
// @expected-stdout-end
// @description: A PKCS#8 key's algorithm is read from its DER, not its PEM banner.
//
//   All three keys below open with the same line:
//
//       -----BEGIN PRIVATE KEY-----
//
//   PKCS#8 (RFC 5208 SS5) does not name the algorithm in the banner. It
//   names it in the DER, in the `privateKeyAlgorithm` field, which is
//   the only place it can be read from:
//
//       PrivateKeyInfo is a SEQUENCE of
//           version              INTEGER,
//           privateKeyAlgorithm  AlgorithmIdentifier,
//           privateKey           OCTET STRING, and optional attributes.
//
//   This pins the mechanism `PrivateKey.from_pem` depends on. Before
//   2026-09-04 that function read the banner and defaulted every plain
//   `PRIVATE KEY` to `Rsa` -- so a P-256 or Ed25519 key, which is what
//   `openssl genpkey` and every ACME client emit, was labelled RSA and
//   would have been signed with the wrong scheme mid-handshake.
//
//   `AlgorithmIdentifier` is the same structure SPKI carries, so
//   `parse_public_key_alg` is the authority for both rather than two
//   OID tables that can drift apart.

mount core.encoding.der.{DerReader};
mount core.security.x509.algorithm.{parse_public_key_alg, PublicKeyAlg};
mount core.encoding.base64 as b64;

// The WHOLE rewritten from_pem, run as user code: the branch dispatch
// as well as the DER lookup.
fn key_type_of(pem: &Text) -> Text {
    let is_pkcs1_rsa = pem.contains("RSA PRIVATE KEY");
    let is_sec1_ec   = pem.contains("EC PRIVATE KEY");
    if !is_pkcs1_rsa && !is_sec1_ec && !pem.contains("PRIVATE KEY") {
        return "unrecognized";
    }
    let lines: List<Text> = pem.lines().filter(|l| !l.starts_with("-----")).collect();
    let der = match b64.decode(&lines.join("")) {
        Result.Ok(b) => b,
        Result.Err(_) => return "bad-base64",
    };
    if is_pkcs1_rsa { return "Rsa"; }
    if is_sec1_ec   { return "Ec"; }
    pkcs8_key_type(&der[..])
}

fn pkcs8_key_type(der: &[Byte]) -> Text {
    let mut reader = DerReader.new(der);
    match reader.read_sequence() {
        Result.Err(_) => "pkcs8-not-a-sequence",
        Result.Ok(mut seq) => match seq.read_int64() {
            Result.Err(_) => "pkcs8-no-version",
            Result.Ok(_v) => match parse_public_key_alg(&mut seq) {
                Result.Err(_) => "pkcs8-bad-algorithm",
                Result.Ok(alg) => match alg {
                    PublicKeyAlg.RsaEncryption  => "Rsa",
                    PublicKeyAlg.EcPublicKey(_) => "Ec",
                    PublicKeyAlg.Ed25519Key     => "Ed25519",
                    _ => "unsupported",
                },
            },
        },
    }
}

fn pem_p256_pkcs8() -> Text { "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgQuHk5MNlT2oQPypr\nAscMKnNamXdObaJlWsKCgHmimzKhRANCAATdO70ig27Wb/G9XoGvtWBZXMMeFiaT\nYeg0k2J6C1ML7JoE7xsztO+ADNNfKMCeu16YyxwCtJYnv59oB7F5FosO\n-----END PRIVATE KEY-----" }
