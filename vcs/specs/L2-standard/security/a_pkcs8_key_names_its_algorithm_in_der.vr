fn main() {
    print(f"p256_pkcs8 {key_type_of(&pem_p256_pkcs8())}");
    print(f"ed25519_pkcs8 {key_type_of(&pem_ed25519_pkcs8())}");
    print(f"rsa_pkcs8 {key_type_of(&pem_rsa_pkcs8())}");
    print(f"ec_sec1 {key_type_of(&pem_ec_sec1())}");
    print(f"rsa_pkcs1 {key_type_of(&pem_rsa_pkcs1())}");
    print(f"garbage {key_type_of(&\"no markers here\")}");
}
