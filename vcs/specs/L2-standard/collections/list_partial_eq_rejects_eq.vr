// @test: typecheck-fail
// @tier: 0
// @level: L2
// @tags: collections, protocols, equality
// @expected-error: E405
// @description: Lists of elements with partial equality cannot satisfy an Eq bound.
mount core.collections.list.List;

type Reading is { value: Float };
implement PartialEq for Reading {
    fn eq(&self, other: &Reading) -> Bool { self.value == other.value }
}

fn require_eq<T: Eq>(_items: &T) {}

fn main() {
    let readings: List<Reading> = [];
    require_eq(&readings);
}
