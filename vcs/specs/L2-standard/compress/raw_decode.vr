fn raw_output_limit() {
    let input: [Byte; 5] = [75_u8, 76_u8, 74_u8, 6_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Deflate.decode(&input, 2, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == 2);
        },
        _ => panic("raw_output_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn raw_zero_limit() {
    let input: [Byte; 2] = [3_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Deflate.decode(&input, 0, &mut output);
