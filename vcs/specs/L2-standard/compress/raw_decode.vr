fn raw_stored_binary() {
    let input: [Byte; 9] = [1_u8, 4_u8, 0_u8, 251_u8, 255_u8, 0_u8, 255_u8, 128_u8, 1_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Deflate.decode(&input, 4, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 4),
        Result.Err(_) => panic("raw_stored_binary: refused valid stream"),
    };
    assert(output.len() == 6);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
    let expected: [Byte; 4] = [0_u8, 255_u8, 128_u8, 1_u8];
    let mut i = 0;
    while i < 4 {
        assert(output[i + 2] == expected[i % expected.len()]);
        i = i + 1;
    }
}

