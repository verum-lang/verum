    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn raw_negative_limit() {
    let input: [Byte; 2] = [3_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Deflate.decode(&input, -1, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == -1);
        },
        _ => panic("raw_negative_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn raw_large_configured_limit() {
    let input: [Byte; 3] = [75_u8, 4_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Deflate.decode(&input, 9223372036854775807, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 1),
        Result.Err(_) => panic("raw_large_configured_limit: refused valid stream"),
    };
    assert(output.len() == 3);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
    let expected: [Byte; 1] = [97_u8];
    let mut i = 0;
    while i < 1 {
        assert(output[i + 2] == expected[i % expected.len()]);
        i = i + 1;
    }
}

fn main() {
    raw_stored_binary();
    raw_fixed();
    raw_dynamic();
    raw_empty();
    raw_overlap();
    raw_cross_block();
    raw_maximum_history();
    raw_degenerate_empty_distance();
    raw_degenerate_single_distance();
    raw_bad_distance();
    raw_reserved_literal();
    raw_reserved_distance();
    raw_reserved_block();
    raw_bad_stored_length();
    raw_truncated_stored();
    raw_missing_final_block();
    raw_oversubscribed_tree();
    raw_incomplete_code_tree();
    raw_missing_eob();
    raw_incomplete_literal_tree();
    raw_incomplete_distance_tree();
    raw_oversubscribed_distance_tree();
    raw_repeat_without_previous();
    raw_repeat_overflow();
    raw_reserved_alphabet_size();
    raw_invalid_degenerate_symbol();
    raw_trailing();
    raw_output_limit();
    raw_zero_limit();
    raw_negative_limit();
    raw_large_configured_limit();
    print("raw decode: ok");
}
