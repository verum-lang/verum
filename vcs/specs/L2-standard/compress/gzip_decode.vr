    assert(output[1] == 165_u8);
}

fn main() {
    gzip_binary();
    gzip_stored();
    gzip_dynamic();
    gzip_empty();
    gzip_optional_fhcrc();
    gzip_text_hint();
    gzip_empty_extra();
    gzip_concatenated();
    gzip_cumulative_limit();
    gzip_bad_crc();
    gzip_bad_size();
    gzip_truncated_trailer();
    gzip_late_corruption();
    gzip_bad_fhcrc();
    gzip_reserved_flags();
    gzip_bad_magic();
    gzip_bad_method();
    gzip_missing_member();
    gzip_unterminated_name();
    gzip_truncated_extra();
    gzip_truncated_extra_length();
    gzip_unterminated_comment();
    gzip_truncated_fhcrc();
    gzip_trailing();
    gzip_zero_trailing();
    gzip_zero_limit();
    gzip_negative_limit();
    gzip_reset_history();
    print("gzip decode: ok");
}
