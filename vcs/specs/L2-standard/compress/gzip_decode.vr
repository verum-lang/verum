    let input: [Byte; 42] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 115_u8, 4_u8, 0_u8, 139_u8, 158_u8, 217_u8, 211_u8, 1_u8, 0_u8, 0_u8, 0_u8, 31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 2_u8, 0_u8, 167_u8, 49_u8, 160_u8, 102_u8, 3_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode(&input, 4096, &mut output);
    match decoded {
        Result.Err(CompressError.CorruptInput(_)) => {
        },
        _ => panic("gzip_reset_history: expected corrupt refusal"),
