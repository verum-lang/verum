fn gzip_zero_limit() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode(&input, 0, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == 0);
        },
        _ => panic("gzip_zero_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn gzip_negative_limit() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode(&input, -1, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == -1);
        },
        _ => panic("gzip_negative_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

