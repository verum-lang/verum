fn gzip_truncated_extra() {
    let input: [Byte; 14] = [31_u8, 139_u8, 8_u8, 4_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 5_u8, 0_u8, 97_u8, 98_u8];
