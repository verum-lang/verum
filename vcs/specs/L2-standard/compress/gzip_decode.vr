    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode(&input, 4096, &mut output);
    match decoded {
        Result.Err(CompressError.CorruptInput(_)) => {
        },
        _ => panic("gzip_truncated_extra: expected corrupt refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

