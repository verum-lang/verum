// @test: run
// @tier: all
// @level: L2
// @timeout: 600000
// @expected-stdout: single decode: ok
// @expected-exit: 0
// Generated by fixtures/generate_decode_vectors.py; Python is input authority only.
mount core.compress.{Algorithm, CompressError, decode};
mount core.compress.mod_gzip.{Gzip, Deflate};

fn single_binary() {
    let input: [Byte; 34] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 75_u8, 175_u8, 202_u8, 44_u8, 96_u8, 248_u8, 175_u8, 80_u8, 144_u8, 88_u8, 153_u8, 147_u8, 159_u8, 152_u8, 2_u8, 0_u8, 144_u8, 153_u8, 160_u8, 156_u8, 14_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, 4096, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 14),
        Result.Err(_) => panic("single_binary: refused valid stream"),
    };
    assert(output.len() == 16);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
    let expected: [Byte; 14] = [103_u8, 122_u8, 105_u8, 112_u8, 0_u8, 255_u8, 32_u8, 112_u8, 97_u8, 121_u8, 108_u8, 111_u8, 97_u8, 100_u8];
    let mut i = 0;
    while i < 14 {
        assert(output[i + 2] == expected[i % expected.len()]);
        i = i + 1;
    }
}

fn single_empty() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, 1, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 0),
        Result.Err(_) => panic("single_empty: refused valid stream"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn single_second_member() {
    let input: [Byte; 54] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 75_u8, 175_u8, 202_u8, 44_u8, 96_u8, 248_u8, 175_u8, 80_u8, 144_u8, 88_u8, 153_u8, 147_u8, 159_u8, 152_u8, 2_u8, 0_u8, 144_u8, 153_u8, 160_u8, 156_u8, 14_u8, 0_u8, 0_u8, 0_u8, 31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, 4096, &mut output);
    match decoded {
        Result.Err(CompressError.CorruptInput(_)) => {
        },
        _ => panic("single_second_member: expected corrupt refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn single_zero_trailing() {
    let input: [Byte; 35] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 75_u8, 175_u8, 202_u8, 44_u8, 96_u8, 248_u8, 175_u8, 80_u8, 144_u8, 88_u8, 153_u8, 147_u8, 159_u8, 152_u8, 2_u8, 0_u8, 144_u8, 153_u8, 160_u8, 156_u8, 14_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, 4096, &mut output);
    match decoded {
        Result.Err(CompressError.CorruptInput(_)) => {
        },
        _ => panic("single_zero_trailing: expected corrupt refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn single_zero_limit() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, 0, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == 0);
        },
        _ => panic("single_zero_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn single_negative_limit() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = Gzip.decode_single(&input, -1, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == -1);
        },
        _ => panic("single_negative_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn main() {
    single_binary();
    single_empty();
    single_second_member();
    single_zero_trailing();
    single_zero_limit();
    single_negative_limit();
    print("single decode: ok");
}
