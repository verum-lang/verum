// @test: run
// @tier: all
// @level: L2
// @timeout: 600000
// @expected-stdout: dispatch decode: ok
// @expected-exit: 0
// Generated by fixtures/generate_decode_vectors.py; Python is input authority only.
mount core.compress.{Algorithm, CompressError, decode};
mount core.compress.mod_gzip.{Gzip, Deflate};

fn raw_stored_binary() {
    let input: [Byte; 9] = [1_u8, 4_u8, 0_u8, 251_u8, 255_u8, 0_u8, 255_u8, 128_u8, 1_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = decode(Algorithm.Deflate, &input, 4, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 4),
        Result.Err(_) => panic("raw_stored_binary: refused valid stream"),
    };
    assert(output.len() == 6);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
    let expected: [Byte; 4] = [0_u8, 255_u8, 128_u8, 1_u8];
    let mut i = 0;
    while i < 4 {
        assert(output[i + 2] == expected[i % expected.len()]);
        i = i + 1;
    }
}

fn raw_zero_limit() {
    let input: [Byte; 2] = [3_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = decode(Algorithm.Deflate, &input, 0, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == 0);
        },
        _ => panic("raw_zero_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn gzip_binary() {
    let input: [Byte; 34] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 75_u8, 175_u8, 202_u8, 44_u8, 96_u8, 248_u8, 175_u8, 80_u8, 144_u8, 88_u8, 153_u8, 147_u8, 159_u8, 152_u8, 2_u8, 0_u8, 144_u8, 153_u8, 160_u8, 156_u8, 14_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = decode(Algorithm.Gzip, &input, 14, &mut output);
    match decoded {
        Result.Ok(count) => assert(count == 14),
        Result.Err(_) => panic("gzip_binary: refused valid stream"),
    };
    assert(output.len() == 16);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
    let expected: [Byte; 14] = [103_u8, 122_u8, 105_u8, 112_u8, 0_u8, 255_u8, 32_u8, 112_u8, 97_u8, 121_u8, 108_u8, 111_u8, 97_u8, 100_u8];
    let mut i = 0;
    while i < 14 {
        assert(output[i + 2] == expected[i % expected.len()]);
        i = i + 1;
    }
}

fn gzip_negative_limit() {
    let input: [Byte; 20] = [31_u8, 139_u8, 8_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 255_u8, 3_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];
    let mut output: List<Byte> = List.new();
    output.push(90_u8);
    output.push(165_u8);
    let decoded = decode(Algorithm.Gzip, &input, -1, &mut output);
    match decoded {
        Result.Err(CompressError.OutputTooLarge { limit }) => {
            assert(limit == -1);
        },
        _ => panic("gzip_negative_limit: expected limit refusal"),
    };
    assert(output.len() == 2);
    assert(output[0] == 90_u8);
    assert(output[1] == 165_u8);
}

fn main() {
    raw_stored_binary();
    raw_zero_limit();
    gzip_binary();
    gzip_negative_limit();
    print("dispatch decode: ok");
}
