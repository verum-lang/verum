// @test: typecheck-pass
// @tier: 0
// @level: L2
// @tags: testing, stateful, singleton, signal-handler
// @timeout: 10000
// @description: Type shapes for the patterns that WOULD need per-test isolation.
//
// THIS SPEC NO LONGER CARRIES `@isolation: process`, and the prose it used to
// carry was false. Measured 2026-09-12: `IsolationLevel` is declared with four
// variants and a default of `Process` whose docstring promises a process per
// test, and it has no consumer anywhere outside its own file. The runner
// executes every spec IN-PROCESS through direct library integration. The
// sentence this file used to state — "the vtest runner forks a fresh process
// for each top-level function call in `main()`" — described nothing that
// happens.
//
// The directive now refuses any level but `none`, so a spec cannot silently
// ask for isolation it will not get; the refusal itself is pinned by a unit
// test in the runner, where it belongs, because a spec cannot assert about
// the parsing of its own header.
//
// What remains here is what the file actually checks: the type-shapes of the
// patterns that would REQUIRE isolation if it existed. They are worth keeping
// — they are the reason the capability is wanted — but they prove nothing
// about isolation, and this header no longer pretends otherwise:
//   1. Global mutable state (static / module-level variables) reset per-test.
//   2. Filesystem writes that must not bleed across test functions.
//   3. Process-exit behavior (verum's `process.exit()` in a subprocess context).
//   4. Signal handlers that are per-process.
//   5. Singleton initialization that can only run once per process.

mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};
mount core.collections.list.{List};

// ── 1. Stateful singleton shape ───────────────────────────────────────────────
//
// `OnceCell<T>` is initialized at most once per process. WERE there a
// per-test process, each test fn would get a fresh one; today they would
// share it, which is why the shape is worth pinning and the isolation is
// worth wanting.

type OnceCell<T> is { value: Maybe<T> };

implement<T> OnceCell<T> {
    fn new() -> OnceCell<T> { OnceCell { value: None } }

    fn get_or_init(&mut self, init: fn() -> T) -> &T {
        if self.value.is_none() {
            self.value = Some(init());
        }
        self.value.as_ref().unwrap()
    }

    fn is_initialized(&self) -> Bool {
        self.value.is_some()
    }
}

fn test_once_cell_initializes_exactly_once() {
    let mut cell: OnceCell<Int> = OnceCell.new();
    assert(!cell.is_initialized());
    let v = cell.get_or_init(|| 42);
    assert_eq(*v, 42);
    assert(cell.is_initialized());
}

// ── 2. Filesystem write pattern ───────────────────────────────────────────────
//
// A per-test temp directory is what `directory` isolation would give.
// Shape-only: nothing injects a tmpdir today.

fn test_temp_path_shape_typechecks() {
    // In a real isolated test the runner injects the temp path.
    // Here we verify the Result<(), Text> write pattern typechecks.
    let path: Text = Text.from("/tmp/test_output.txt");
    let content: Text = Text.from("test data");
    let _result: Result<(), Text> = write_to_path(&path, &content);
}

fn write_to_path(path: &Text, content: &Text) -> Result<(), Text> {
    Ok(())
}

// ── 3. Process-exit in subprocess context ────────────────────────────────────
//
// Calling process.exit() would not crash the parent runner IF the test ran
// in a subprocess. It does not. Shape: the exit function has type
// fn(Int) -> !

fn exit_shape_typechecks(code: Int) -> ! {
    // `core.sys.process.exit` does not exist and never did — this line was
    // `unbound variable` at HEAD, so the file failed its own
    // `@test: typecheck-pass` before any of today's edits. The portable exit
    // is `core.shell.script.exit`.
    core.shell.script.exit(code)
}

// ── 4. Signal handler registration shape ─────────────────────────────────────
//
// Signal handlers are per-process, so without per-test processes every
// spec in one run shares them. Shape-only.

type SignalHandler is fn(Int) -> ();

fn register_signal_handler(_sig: Int, _handler: SignalHandler) -> Result<(), Text> {
    Ok(())
}

fn test_signal_handler_shape() {
    let handler: SignalHandler = |_sig| {};
    let r: Result<(), Text> = register_signal_handler(2, handler);
    assert(r.is_ok());
}

fn main() {
    test_once_cell_initializes_exactly_once();
    test_temp_path_shape_typechecks();
    test_signal_handler_shape();
    print("stateful-pattern type shapes typecheck ok");
}
