// @test: run-interpreter
// @tier: 0
// @level: L2
// @tags: quic, stats, observability, merge
// @timeout: 15000
// @expected-exit: 0

// QuicStats surface: zero-on-new counters + additive merge semantics
// used by the endpoint aggregator to fold per-connection snapshots.

mount core.*;
mount core.net.quic.stats.{QuicStats, QuicCounter, QuicGauge, EndpointStats, EndpointCounter};

fn new_stats_are_all_zero() {
    let s = QuicStats.new();
    assert(s.counter(QuicCounter.DatagramsSent) == 0_u64);
    assert(s.counter(QuicCounter.DatagramsReceived) == 0_u64);
    assert(s.counter(QuicCounter.BytesSent) == 0_u64);
    assert(s.counter(QuicCounter.BytesReceived) == 0_u64);
    assert(s.counter(QuicCounter.PacketsLost) == 0_u64);
    assert(s.counter(QuicCounter.StreamsOpenedBidi) == 0_u64);
    assert(s.counter(QuicCounter.ZeroRttOffered) == 0_u64);
    assert(s.counter(QuicCounter.PathsValidated) == 0_u64);
    assert(s.counter(QuicCounter.CidsIssued) == 0_u64);
}

fn merge_is_additive_per_field() {
    let mut a = QuicStats.new();
    a.set_counter(QuicCounter.DatagramsSent, 10_u64);
    a.set_counter(QuicCounter.BytesSent, 1500_u64);
    a.set_counter(QuicCounter.PacketsLost, 2_u64);
    a.set_counter(QuicCounter.PathsValidated, 1_u64);

    let mut b = QuicStats.new();
    b.set_counter(QuicCounter.DatagramsSent, 5_u64);
    b.set_counter(QuicCounter.BytesSent, 800_u64);
    b.set_counter(QuicCounter.PacketsLost, 3_u64);
    b.set_counter(QuicCounter.PathsValidated, 2_u64);

    a.merge(&b);
    assert(a.counter(QuicCounter.DatagramsSent) == 15_u64);
    assert(a.counter(QuicCounter.BytesSent) == 2300_u64);
    assert(a.counter(QuicCounter.PacketsLost) == 5_u64);
    assert(a.counter(QuicCounter.PathsValidated) == 3_u64);
    // b unchanged.
    assert(b.counter(QuicCounter.DatagramsSent) == 5_u64);
}

fn merge_zero_does_not_perturb() {
    let mut a = QuicStats.new();
    a.set_counter(QuicCounter.DatagramsSent, 42_u64);
    a.set_gauge(QuicGauge.RttSmoothedUs, 20_000_u64);
    let z = QuicStats.new();
    a.merge(&z);
    assert(a.counter(QuicCounter.DatagramsSent) == 42_u64);
    assert(a.gauge(QuicGauge.RttSmoothedUs) == 20_000_u64);
}

fn endpoint_merges_counters_and_keeps_latest_nonzero_gauges() {
    let mut ep = EndpointStats.new();
    assert_eq(ep.active_connections(), 0_u64);
    ep.set_active_connections(2_u64);
    ep.set_counter(EndpointCounter.ConnectionsOpened, 3_u64);

    let mut first = QuicStats.new();
    first.set_counter(QuicCounter.DatagramsSent, 4_u64);
    first.set_gauge(QuicGauge.RttSmoothedUs, 200_u64);
    first.set_gauge(QuicGauge.BytesInFlight, 128_u64);
    let mut second = QuicStats.new();
    second.set_counter(QuicCounter.DatagramsSent, 7_u64);
    second.set_gauge(QuicGauge.RttSmoothedUs, 140_u64);

    ep.merge_connection(&first);
    ep.merge_connection(&second);
    assert_eq(ep.active_connections(), 2_u64);
    assert_eq(ep.counter(EndpointCounter.ConnectionsOpened), 3_u64);
    assert_eq(ep.aggregate().counter(QuicCounter.DatagramsSent), 11_u64);
    assert_eq(ep.aggregate().gauge(QuicGauge.RttSmoothedUs), 140_u64);
    assert_eq(ep.aggregate().gauge(QuicGauge.BytesInFlight), 128_u64);
    assert_eq(first.counter(QuicCounter.DatagramsSent), 4_u64);
}

@main
public fn main() -> Int {
    new_stats_are_all_zero();
    merge_is_additive_per_field();
    merge_zero_does_not_perturb();
    endpoint_merges_counters_and_keeps_latest_nonzero_gauges();
    print("QuicStats zero + merge + EndpointStats surface verified");
    0
}
