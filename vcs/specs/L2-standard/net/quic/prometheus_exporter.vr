// @test: run-interpreter
// @tier: 0
// @level: L2
// @tags: quic, stats, prometheus, observability
// @timeout: 15000
// @expected-exit: 0

mount core.net.quic.stats.{QuicStats, QuicCounter, QuicGauge, EndpointStats, EndpointCounter};
mount core.net.quic.stats_prometheus.{render_connection, render_endpoint};

fn main() {
    let mut stats = QuicStats.new();
    stats.set_counter(QuicCounter.DatagramsSent, 10_u64);
    stats.set_counter(QuicCounter.BytesSent, 1500_u64);
    stats.set_gauge(QuicGauge.BytesInFlight, 9_u64);
    let rendered = render_connection(&stats, &Text.from("conn"));
    assert(rendered.contains("# HELP verum_quic_datagrams_sent_total Datagrams sent\n"));
    assert(rendered.contains("# TYPE verum_quic_datagrams_sent_total counter\n"));
    assert(rendered.contains("verum_quic_datagrams_sent_total{conn=\"conn\"} 10\n"));
    assert(rendered.contains("verum_quic_bytes_sent_total{conn=\"conn\"} 1500\n"));
    assert(rendered.contains("# TYPE verum_quic_bytes_in_flight gauge\n"));

    let escaped = render_connection(&stats, &Text.from("a\"b\\c\n雪"));
    assert(escaped.contains("verum_quic_bytes_in_flight{conn=\"a\\\"b\\\\c\\n雪\"} 9\n"));

    let mut ep = EndpointStats.new();
    ep.set_counter(EndpointCounter.ConnectionsOpened, 3_u64);
    ep.set_active_connections(2_u64);
    ep.merge_connection(&stats);
    let endpoint = render_endpoint(&ep);
    assert(endpoint.contains("verum_quic_endpoint_connections_opened_total 3\n"));
    assert(endpoint.contains("verum_quic_endpoint_connections_active 2\n"));
    assert(endpoint.contains("verum_quic_datagrams_sent_total{conn=\"aggregate\"} 10\n"));
}
