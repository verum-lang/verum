// @test: run-interpreter
// @tier: 0
// @level: L2
// @tags: quic, rfc9000, transport-params, encode, decode, roundtrip
// @timeout: 15000
// @expected-exit: 0
// @expected-stdout: QUIC endpoint advertisements verified

module core.net.quic.api.tests.endpoint_advertisements;

mount core.collections.list.{List};
mount core.net.quic.api.{QuicClientOptions};
mount core.net.quic.transport_params.{TransportParams, TpError, encode, decode};

fn check_bytes(params: &TransportParams, expected: &[Byte]) {
    assert(params.bounds_ok());
    let mut encoded: List<Byte> = [];
    encode(params, &mut encoded);
    assert(encoded.len() == expected.len());
    let mut i = 0;
    while i < expected.len() {
        assert(encoded[i] == expected[i]);
        i = i + 1;
    }
}

fn main() {
    // Each row is a complete RFC 9000 parameter (ID, length and varint value).
    let defaults_wire: List<Byte> = [
        0x01, 0x01, 0x00,
        0x03, 0x04, 0x80, 0x00, 0xff, 0xf7,
        0x04, 0x01, 0x00,
        0x05, 0x01, 0x00,
        0x06, 0x01, 0x00,
        0x07, 0x01, 0x00,
        0x08, 0x01, 0x00,
        0x09, 0x01, 0x00,
        0x0a, 0x01, 0x03,
        0x0b, 0x01, 0x19,
        0x0e, 0x01, 0x02,
    ];
    check_bytes(&TransportParams.defaults(), defaults_wire.as_slice());
    check_bytes(&decode(defaults_wire.as_slice()).unwrap(), defaults_wire.as_slice());

    let client_wire: List<Byte> = [
        0x01, 0x04, 0x80, 0x00, 0x75, 0x30,
        0x03, 0x04, 0x80, 0x00, 0xff, 0xf7,
        0x04, 0x04, 0x80, 0x10, 0x00, 0x00,
        0x05, 0x04, 0x80, 0x04, 0x00, 0x00,
        0x06, 0x04, 0x80, 0x04, 0x00, 0x00,
        0x07, 0x04, 0x80, 0x04, 0x00, 0x00,
        0x08, 0x02, 0x40, 0x64,
        0x09, 0x02, 0x40, 0x64,
        0x0a, 0x01, 0x03,
        0x0b, 0x01, 0x19,
        0x0e, 0x01, 0x02,
    ];
    let client = QuicClientOptions.default();
    check_bytes(client.transport_params(), client_wire.as_slice());
    check_bytes(&decode(client_wire.as_slice()).unwrap(), client_wire.as_slice());

    let server_wire: List<Byte> = [
        0x01, 0x04, 0x80, 0x00, 0x75, 0x30,
        0x03, 0x04, 0x80, 0x00, 0xff, 0xf7,
        0x04, 0x04, 0x80, 0xa0, 0x00, 0x00,
        0x05, 0x04, 0x80, 0x10, 0x00, 0x00,
        0x06, 0x04, 0x80, 0x10, 0x00, 0x00,
        0x07, 0x04, 0x80, 0x10, 0x00, 0x00,
        0x08, 0x02, 0x40, 0x80,
        0x09, 0x02, 0x40, 0x80,
        0x0a, 0x01, 0x03,
        0x0b, 0x01, 0x19,
        0x0e, 0x01, 0x04,
    ];
    check_bytes(&TransportParams.server_defaults(), server_wire.as_slice());
    check_bytes(&decode(server_wire.as_slice()).unwrap(), server_wire.as_slice());

    // A zero-length extension flag survives the same decode and encode path.
    let mut flagged = client_wire.clone();
    flagged.extend_from_slice(&[0x6a_u8, 0xb2_u8, 0x00_u8]);
    check_bytes(&decode(flagged.as_slice()).unwrap(), flagged.as_slice());
    // A missing parameter body and an incomplete parameter ID retain distinct errors.
    match decode(&[0x01_u8, 0x01_u8]) {
        Result.Err(TpError.Truncated) => {},
        _ => panic("missing transport parameter body"),
    }
    match decode(&[0x40_u8]) {
        Result.Err(TpError.VarintFailure) => {},
        _ => panic("incomplete transport parameter ID"),
    }
    print("QUIC endpoint advertisements verified");
}
