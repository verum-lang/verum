// @test: typecheck-pass
// @tier: 0
// @level: L2
// @tags: quic, observability, stats, typecheck
// @timeout: 10000

mount core.net.quic.{QuicStats, QuicCounter, QuicGauge, EndpointStats};

fn exercise_stats() {
    let mut conn_a = QuicStats.new();
    let mut conn_b = QuicStats.new();

    // Simulate some tx / rx activity on connection A.
    conn_a.set_counter(QuicCounter.DatagramsSent, 42_u64);
    conn_a.set_counter(QuicCounter.DatagramsReceived, 37_u64);
    conn_a.set_counter(QuicCounter.BytesSent, 1_200_u64 * 42_u64);
    conn_a.set_counter(QuicCounter.StreamsOpenedBidi, 4_u64);
    conn_a.set_gauge(QuicGauge.RttSmoothedUs, 1_250_u64);

    // And on connection B.
    conn_b.set_counter(QuicCounter.DatagramsSent, 7_u64);
    conn_b.set_counter(QuicCounter.BytesSent, 1_200_u64 * 7_u64);
    conn_b.set_counter(QuicCounter.ZeroRttAccepted, 1_u64);

    // Endpoint aggregate.
    let mut ep = EndpointStats.new();
    ep.set_active_connections(2_u64);
    ep.merge_connection(&conn_a);
    ep.merge_connection(&conn_b);

    // We expect 49 total datagrams_sent.
    assert(ep.aggregate().counter(QuicCounter.DatagramsSent) == 49_u64);
    assert(ep.aggregate().counter(QuicCounter.StreamsOpenedBidi) == 4_u64);
    // rtt_smoothed_us is a gauge → takes on last non-zero value;
    // here only conn_a set it.
    assert(ep.aggregate().gauge(QuicGauge.RttSmoothedUs) == 1_250_u64);
}

fn main() {
    exercise_stats();
}
