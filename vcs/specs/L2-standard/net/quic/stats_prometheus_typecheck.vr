// @test: typecheck-pass
// @tier: 0
// @level: L2
// @tags: quic, observability, prometheus, typecheck
// @timeout: 10000

mount core.net.quic.{QuicStats, QuicCounter, QuicGauge, EndpointStats, EndpointCounter};
mount core.net.quic.stats_prometheus.{render_connection, render_endpoint};

fn exercise_prometheus() {
    let mut conn = QuicStats.new();
    conn.set_counter(QuicCounter.DatagramsSent, 42_u64);
    conn.set_gauge(QuicGauge.RttSmoothedUs, 1_250_u64);

    let text_conn: Text = render_connection(&conn, &Text.from("abc-connection"));
    let _ = text_conn;

    let mut ep = EndpointStats.new();
    ep.set_active_connections(2_u64);
    ep.set_counter(EndpointCounter.StatelessResetsEmitted, 0_u64);
    ep.merge_connection(&conn);

    let text_ep: Text = render_endpoint(&ep);
    let _ = text_ep;
}

fn main() { exercise_prometheus(); }
