// @test: run-interpreter
// @tier: 0
// @level: L2
// @tags: mem, arena, alignment
// @expected-exit: 0

mount core.mem.arena.{ArenaConfig, GenerationalArena};

fn test_rounding() {
    let mut fixed = GenerationalArena.new(33);
    assert_eq(fixed.capacity(), 40);
    let start = fixed.alloc(1);
    assert(start != 0);
    assert_eq(fixed.alloc(2) - start, 8);
    assert_eq(fixed.alloc_aligned(1, 16) - start, 16);
    assert_eq(fixed.used(), 17);
    assert_eq(fixed.alloc(Int.MAX), 0);
    assert_eq(fixed.alloc_aligned(1, 3), 0);
    assert_eq(fixed.used(), 17);
    fixed.destroy();

    let mut configured = GenerationalArena.with_config(ArenaConfig.fixed(17));
    assert_eq(configured.capacity(), 24);
    let first = configured.alloc(9);
    assert(first != 0);
    assert_eq(configured.alloc(8) - first, 16);
    assert_eq(configured.used(), 24);
    assert_eq(configured.alloc(1), 0);
    configured.destroy();
}

fn main() {
    test_rounding();
}
