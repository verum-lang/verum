// @test: unit
// @tier: 0
// @level: L1
// @tags: set, higher_order, iterator, closure
// @timeout: 30000
// @expect: pass
//
// The budget is 30s for a 58-line program over a four-element set, and
// that is not a typo (T1012).  Measured 2026-08-31: this file takes 11.6s
// to typecheck, against a declared 5s — so whether it passed was decided
// by how busy the machine was, and a corpus run could report it as a
// regression of whatever change happened to land nearby.  It cost exactly
// that once: a one-test L1 difference chased through 214 specs before the
// name turned up.
//
// The 11.6s is NOT this file's fault and raising the budget does not fix
// it.  A three-line program is enough to show it: `Set.new()` costs 0.6s,
// adding one `s.insert(1)` takes it to 4.5s, and the same shape on `List`
// stays at 0.6s.  `sample` puts `ensure_stdlib_type_loaded` at the top.
// That is tracked as T1013; when it lands, this budget should come back
// down, and the number here is the measurement to beat.
//
// Regression: Set's higher-order methods (filter/map/fold/count_where/
// for_each) previously dispatched through the generic array path and
// treated the Set's `[count, capacity, entries_ptr]` header as if it
// were a Value-array — producing nonsense results (e.g. `filter` of
// `{1,2,3,4}` yielding 3 elements: the count, capacity, and
// entries-pointer fields).
//
// Fixed by adding Set-specific builtin handlers and making Set iteration
// yield keys only (not `(key, value)` tuples like Map).

mount core.collections.set.Set;

fn main() {
    let mut s: Set<Int> = Set.new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.insert(4);

    // filter
    let evens = s.filter(|x| *x % 2 == 0);
    assert(evens.len() == 2);
    assert(evens.contains(2));
    assert(evens.contains(4));

    // map
    let doubled = s.map(|x| *x * 10);
    assert(doubled.len() == 4);
    assert(doubled.contains(10));
    assert(doubled.contains(40));

    // fold
    let sum = s.fold(0, |acc, x| acc + *x);
    assert(sum == 10);

    // count_where
    let odd_count = s.count_where(|x| *x % 2 == 1);
    assert(odd_count == 2);

    // for_each
    let mut total = 0;
    s.for_each(|x| { total = total + *x; });
    assert(total == 10);

    // iteration yields keys only, not (key, flag) tuples
    let mut iter_sum = 0;
    for v in s.iter() {
        iter_sum = iter_sum + *v;
    }
    assert(iter_sum == 10);
}
