mount core.math.cohesive.{AdjunctionWitness, make_adjunction};

@extern fn unknown_component(x: &Int) -> Int;

fn unknown_operator() -> AdjunctionWitness {
    make_adjunction(|x| unknown_component(x), |x| *x, |x| *x, |x| *x)
}
