mount core.math.cohesive.{AdjunctionWitness, make_adjunction};

async fn suspending_component(x: &Int) -> Int { *x }

fn async_operator() -> AdjunctionWitness {
    make_adjunction(suspending_component, |x| *x, |x| *x, |x| *x)
}
