// @test: typecheck-pass
// @level: L1
// @tier: 0
// @tags: core, base, from_str_radix, sized, parsing
// @description: Tests from_str_radix for all sized integer types

mount core.*;
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};
mount core.base.protocols.{ParseError};

// =============================================================================
// Section 1: Signed types — from_str_radix
// =============================================================================

@test
fn test_int8_from_str_radix_decimal() {
    assert_eq(Int8.from_str_radix(&"42", 10), Ok(42_i8));
    assert_eq(Int8.from_str_radix(&"-128", 10), Ok(-128_i8));
    assert_eq(Int8.from_str_radix(&"127", 10), Ok(127_i8));
}

@test
fn test_int8_from_str_radix_hex() {
    assert_eq(Int8.from_str_radix(&"7f", 16), Ok(127_i8));
    assert_eq(Int8.from_str_radix(&"0", 16), Ok(0_i8));
}

@test
fn test_int8_from_str_radix_overflow() {
    assert(Int8.from_str_radix(&"128", 10).is_err());
    assert(Int8.from_str_radix(&"-129", 10).is_err());
}

@test
fn test_int16_from_str_radix_decimal() {
    assert_eq(Int16.from_str_radix(&"1000", 10), Ok(1000_i16));
    assert_eq(Int16.from_str_radix(&"-32768", 10), Ok(-32768_i16));
    assert_eq(Int16.from_str_radix(&"32767", 10), Ok(32767_i16));
}

@test
fn test_int16_from_str_radix_hex() {
    assert_eq(Int16.from_str_radix(&"ff", 16), Ok(255_i16));
}

@test
fn test_int16_from_str_radix_overflow() {
    assert(Int16.from_str_radix(&"32768", 10).is_err());
}

@test
fn test_int32_from_str_radix_decimal() {
    assert_eq(Int32.from_str_radix(&"100000", 10), Ok(100000_i32));
    assert_eq(Int32.from_str_radix(&"-2147483648", 10), Ok(-2147483648_i32));
}

@test
fn test_int32_from_str_radix_overflow() {
    assert(Int32.from_str_radix(&"2147483648", 10).is_err());
}

@test
fn test_int64_from_str_radix_decimal() {
    assert_eq(Int64.from_str_radix(&"123456789", 10), Ok(123456789_i64));
    assert_eq(Int64.from_str_radix(&"-1", 10), Ok(-1_i64));
}

@test
fn test_int64_from_str_radix_binary() {
    assert_eq(Int64.from_str_radix(&"1010", 2), Ok(10_i64));
}

@test
fn test_int128_from_str_radix_decimal() {
    assert_eq(Int128.from_str_radix(&"999999999", 10), Ok(999999999 as Int128));
}

@test
fn test_int128_from_str_radix_hex() {
    assert_eq(Int128.from_str_radix(&"ff", 16), Ok(255 as Int128));
}

@test
fn test_isize_from_str_radix_decimal() {
    assert_eq(ISize.from_str_radix(&"42", 10), Ok(42 as ISize));
    assert_eq(ISize.from_str_radix(&"-100", 10), Ok(-100 as ISize));
}

@test
fn test_isize_from_str_radix_octal() {
    assert_eq(ISize.from_str_radix(&"77", 8), Ok(63 as ISize));
}

// =============================================================================
// Section 2: Unsigned types — from_str_radix
// =============================================================================

@test
fn test_uint8_from_str_radix_decimal() {
    assert_eq(UInt8.from_str_radix(&"255", 10), Ok(255_u8));
    assert_eq(UInt8.from_str_radix(&"0", 10), Ok(0_u8));
}

@test
fn test_uint8_from_str_radix_hex() {
    assert_eq(UInt8.from_str_radix(&"ff", 16), Ok(255_u8));
    assert_eq(UInt8.from_str_radix(&"a", 16), Ok(10_u8));
}

@test
fn test_uint8_from_str_radix_overflow() {
    assert(UInt8.from_str_radix(&"256", 10).is_err());
    assert(UInt8.from_str_radix(&"-1", 10).is_err());
}

@test
fn test_uint16_from_str_radix_decimal() {
    assert_eq(UInt16.from_str_radix(&"65535", 10), Ok(65535_u16));
    assert_eq(UInt16.from_str_radix(&"1000", 10), Ok(1000_u16));
}

@test
fn test_uint16_from_str_radix_overflow() {
    assert(UInt16.from_str_radix(&"65536", 10).is_err());
    assert(UInt16.from_str_radix(&"-1", 10).is_err());
}

@test
fn test_uint32_from_str_radix_decimal() {
    assert_eq(UInt32.from_str_radix(&"100000", 10), Ok(100000_u32));
}

@test
fn test_uint32_from_str_radix_hex() {
    assert_eq(UInt32.from_str_radix(&"deadbeef", 16), Ok(3735928559_u32));
}

@test
fn test_uint32_from_str_radix_overflow() {
    assert(UInt32.from_str_radix(&"4294967296", 10).is_err());
}

@test
fn test_uint64_from_str_radix_decimal() {
    assert_eq(UInt64.from_str_radix(&"1000000", 10), Ok(1000000_u64));
}

@test
fn test_uint64_from_str_radix_negative() {
    assert(UInt64.from_str_radix(&"-1", 10).is_err());
}

@test
fn test_uint128_from_str_radix_decimal() {
    assert_eq(UInt128.from_str_radix(&"42", 10), Ok(42 as UInt128));
}

@test
fn test_uint128_from_str_radix_negative() {
    assert(UInt128.from_str_radix(&"-1", 10).is_err());
}

@test
fn test_usize_from_str_radix_decimal() {
    assert_eq(USize.from_str_radix(&"42", 10), Ok(42 as USize));
}

@test
fn test_usize_from_str_radix_negative() {
    assert(USize.from_str_radix(&"-1", 10).is_err());
}

// =============================================================================
// Section 3: Invalid input
// =============================================================================

@test
fn test_from_str_radix_empty() {
    assert(Int8.from_str_radix(&"", 10).is_err());
    assert(UInt8.from_str_radix(&"", 10).is_err());
}

@test
fn test_from_str_radix_invalid_char() {
    assert(Int8.from_str_radix(&"abc", 10).is_err());
    assert(UInt32.from_str_radix(&"xyz", 10).is_err());
}

@test
fn test_from_str_radix_invalid_radix() {
    assert(Int16.from_str_radix(&"5", 1).is_err());
    assert(UInt16.from_str_radix(&"5", 37).is_err());
}

// =============================================================================
// Section 4: Different bases
// =============================================================================

@test
fn test_from_str_radix_binary() {
    assert_eq(Int8.from_str_radix(&"1111111", 2), Ok(127_i8));
    assert_eq(UInt8.from_str_radix(&"11111111", 2), Ok(255_u8));
}

@test
fn test_from_str_radix_octal() {
    assert_eq(Int16.from_str_radix(&"777", 8), Ok(511_i16));
    assert_eq(UInt16.from_str_radix(&"1000", 8), Ok(512_u16));
}

@test
fn test_from_str_radix_base36() {
    assert_eq(Int32.from_str_radix(&"zz", 36), Ok(1295_i32));
}

// =============================================================================
// Section 5: Cross-type consistency with Int
// =============================================================================

@test
fn test_from_str_radix_consistency_with_int() {
    let int_result = Int.from_str_radix(&"ff", 16);
    let int32_result = Int32.from_str_radix(&"ff", 16);
    assert(int_result.is_some());
    assert(int32_result.is_some());
    assert_eq(int_result.unwrap(), int32_result.unwrap().to_int());
}

@test
fn test_from_str_radix_sign_prefix() {
    assert_eq(Int16.from_str_radix(&"+42", 10), Ok(42_i16));
    assert_eq(Int32.from_str_radix(&"-42", 10), Ok(-42_i32));
}
