// =============================================================================
// vcs/specs/core/intrinsics/type_info_test.vr
// =============================================================================
// @test: typecheck-pass
// @tier: 0
// @level: L0
// @tags: stdlib, intrinsics, type_info, size, alignment, reflection, properties
// @description: Comprehensive tests for type information intrinsics.
//
// Coverage:
// - Type properties: needs_drop, min_align
// - Type property syntax: T.size, T.alignment, T.bits, T.name
// - Size relationships between types
// - Alignment invariants
//
// Test Strategy:
// - Test with all primitive types
// - Test size ordering relationships
// - Test alignment divides size
// - Test type properties (T.size syntax)
// =============================================================================

module test.stdlib.intrinsics.type_info_test;

mount core.intrinsics.type_info.{needs_drop, min_align};

// =============================================================================
// Test Entry Point
// =============================================================================

fn main() {
    // Tests run via @test annotations
}

// =============================================================================
// Size of Signed Integers
// =============================================================================

@test
fn test_size_of_signed_ints() {
    assert((Int8.size as USize) == (1 as USize));
    assert((Int16.size as USize) == (2 as USize));
    assert((Int32.size as USize) == (4 as USize));
    assert((Int64.size as USize) == (8 as USize));
    assert((Int.size as USize) == (8 as USize));
}

// =============================================================================
// Size of Unsigned Integers
// =============================================================================

@test
fn test_size_of_unsigned_ints() {
    assert((UInt8.size as USize) == (1 as USize));
    assert((UInt16.size as USize) == (2 as USize));
    assert((UInt32.size as USize) == (4 as USize));
    assert((UInt64.size as USize) == (8 as USize));
}

// =============================================================================
// Size of Floats and Other Primitives
// =============================================================================

@test
fn test_size_of_floats() {
    assert((Float32.size as USize) == (4 as USize));
    assert((Float64.size as USize) == (8 as USize));
}

@test
fn test_size_of_bool_byte() {
    assert((Bool.size as USize) == (1 as USize));
    assert((Byte.size as USize) == (1 as USize));
}

// =============================================================================
// Alignment of Integers
// =============================================================================

@test
fn test_align_of_signed_ints() {
    assert((Int8.alignment as USize) == (1 as USize));
    assert((Int16.alignment as USize) == (2 as USize));
    assert((Int32.alignment as USize) == (4 as USize));
    assert((Int64.alignment as USize) == (8 as USize));
}

@test
fn test_align_of_unsigned_ints() {
    assert((UInt8.alignment as USize) == (1 as USize));
    assert((UInt16.alignment as USize) == (2 as USize));
    assert((UInt32.alignment as USize) == (4 as USize));
    assert((UInt64.alignment as USize) == (8 as USize));
}

@test
fn test_align_of_floats() {
    assert((Float32.alignment as USize) == (4 as USize));
    assert((Float64.alignment as USize) == (8 as USize));
}

@test
fn test_align_of_bool_byte() {
    assert((Bool.alignment as USize) == (1 as USize));
    assert((Byte.alignment as USize) == (1 as USize));
}

// =============================================================================
// Bits of Types
// =============================================================================

@test
fn test_bits_of_ints() {
    assert((Int8.bits as USize) == (8 as USize));
    assert((Int16.bits as USize) == (16 as USize));
    assert((Int32.bits as USize) == (32 as USize));
    assert((Int64.bits as USize) == (64 as USize));
    assert((Int.bits as USize) == (64 as USize));
}

@test
fn test_bits_of_unsigned() {
    assert((UInt8.bits as USize) == (8 as USize));
    assert((UInt16.bits as USize) == (16 as USize));
    assert((UInt32.bits as USize) == (32 as USize));
    assert((UInt64.bits as USize) == (64 as USize));
}

@test
fn test_bits_of_floats() {
    assert((Float32.bits as USize) == (32 as USize));
    assert((Float64.bits as USize) == (64 as USize));
}

// =============================================================================
// Size Ordering Relationships
// =============================================================================

@test
fn test_size_ordering_signed() {
    assert((Int8.size as USize) < (Int16.size as USize));
    assert((Int16.size as USize) < (Int32.size as USize));
    assert((Int32.size as USize) < (Int64.size as USize));
}

@test
fn test_size_ordering_unsigned() {
    assert((UInt8.size as USize) < (UInt16.size as USize));
    assert((UInt16.size as USize) < (UInt32.size as USize));
    assert((UInt32.size as USize) < (UInt64.size as USize));
}

@test
fn test_size_ordering_floats() {
    assert((Float32.size as USize) < (Float64.size as USize));
}

// =============================================================================
// Size-Alignment Invariants
// =============================================================================

@test
fn test_alignment_divides_size() {
    assert((Int32.size as USize) % (Int32.alignment as USize) == (0 as USize));
    assert((Int64.size as USize) % (Int64.alignment as USize) == (0 as USize));
    assert((Float32.size as USize) % (Float32.alignment as USize) == (0 as USize));
    assert((Float64.size as USize) % (Float64.alignment as USize) == (0 as USize));
    assert((UInt32.size as USize) % (UInt32.alignment as USize) == (0 as USize));
    assert((UInt64.size as USize) % (UInt64.alignment as USize) == (0 as USize));
}

@test
fn test_all_sizes_positive() {
    assert((Int.size as USize) > (0 as USize));
    assert((Float64.size as USize) > (0 as USize));
    assert((Bool.size as USize) > (0 as USize));
    assert((Byte.size as USize) > (0 as USize));
    assert((UInt8.size as USize) > (0 as USize));
}

// =============================================================================
// Stride
// =============================================================================

@test
fn test_stride_of_types() {
    // Stride should be >= size
    assert((Int32.stride as USize) >= (Int32.size as USize));
    assert((Int64.stride as USize) >= (Int64.size as USize));
    assert((Float64.stride as USize) >= (Float64.size as USize));
}

// =============================================================================
// Min Alignment
// =============================================================================

@test
fn test_min_align() {
    assert(min_align() >= (1 as USize));
}

// =============================================================================
// Type Name
// =============================================================================

@test
fn test_type_name_int() {
    let name = Int.name;
    let _: Text = name;
}

@test
fn test_type_name_float() {
    let name = Float64.name;
    let _: Text = name;
}

@test
fn test_type_name_bool() {
    let name = Bool.name;
    let _: Text = name;
}

// =============================================================================
// Type ID
// =============================================================================

@test
fn test_type_id_distinct() {
    let id_int = Int.id;
    let id_float = Float64.id;
    let id_bool = Bool.id;

    let _: UInt64 = id_int;
    let _: UInt64 = id_float;
    let _: UInt64 = id_bool;

    // Different types should have different IDs
    assert(id_int != id_float);
    assert(id_int != id_bool);
    assert(id_float != id_bool);
}

@test
fn test_type_id_same() {
    // Same type should have same ID
    let id1 = Int.id;
    let id2 = Int.id;
    assert(id1 == id2);
}

// =============================================================================
// Needs Drop
// =============================================================================

@test
fn test_needs_drop_primitives() {
    // Primitive types don't need drop
    assert(!needs_drop<Int>());
    assert(!needs_drop<Float64>());
    assert(!needs_drop<Bool>());
    assert(!needs_drop<UInt32>());
}

// =============================================================================
// Bits = Size * 8
// =============================================================================

@test
fn test_bits_equals_size_times_8() {
    assert((Int8.bits as USize) == (Int8.size as USize) * (8 as USize));
    assert((Int16.bits as USize) == (Int16.size as USize) * (8 as USize));
    assert((Int32.bits as USize) == (Int32.size as USize) * (8 as USize));
    assert((Int64.bits as USize) == (Int64.size as USize) * (8 as USize));
    assert((Float32.bits as USize) == (Float32.size as USize) * (8 as USize));
    assert((Float64.bits as USize) == (Float64.size as USize) * (8 as USize));
}

// =============================================================================
// Signed/Unsigned Same Size
// =============================================================================

@test
fn test_signed_unsigned_same_size() {
    assert((Int8.size as USize) == (UInt8.size as USize));
    assert((Int16.size as USize) == (UInt16.size as USize));
    assert((Int32.size as USize) == (UInt32.size as USize));
    assert((Int64.size as USize) == (UInt64.size as USize));
}

// =============================================================================
// Additional Type Info Tests
// =============================================================================

@test
fn test_signed_unsigned_same_alignment() {
    assert((Int8.alignment as USize) == (UInt8.alignment as USize));
    assert((Int16.alignment as USize) == (UInt16.alignment as USize));
    assert((Int32.alignment as USize) == (UInt32.alignment as USize));
    assert((Int64.alignment as USize) == (UInt64.alignment as USize));
}

@test
fn test_signed_unsigned_same_bits() {
    assert((Int8.bits as USize) == (UInt8.bits as USize));
    assert((Int16.bits as USize) == (UInt16.bits as USize));
    assert((Int32.bits as USize) == (UInt32.bits as USize));
    assert((Int64.bits as USize) == (UInt64.bits as USize));
}

@test
fn test_type_id_int_sizes_distinct() {
    let id8 = Int8.id;
    let id16 = Int16.id;
    let id32 = Int32.id;
    let id64 = Int64.id;

    assert(id8 != id16);
    assert(id16 != id32);
    assert(id32 != id64);
    assert(id8 != id64);
}

@test
fn test_type_id_unsigned_distinct() {
    let id8 = UInt8.id;
    let id16 = UInt16.id;
    let id32 = UInt32.id;
    let id64 = UInt64.id;

    assert(id8 != id16);
    assert(id16 != id32);
    assert(id32 != id64);
}

@test
fn test_type_id_signed_vs_unsigned_distinct() {
    assert(Int8.id != UInt8.id);
    assert(Int16.id != UInt16.id);
    assert(Int32.id != UInt32.id);
    assert(Int64.id != UInt64.id);
}

@test
fn test_type_name_various() {
    let n1 = Int8.name;
    let n2 = UInt32.name;
    let n3 = Float32.name;
    let n4 = Byte.name;
    let _: Text = n1;
    let _: Text = n2;
    let _: Text = n3;
    let _: Text = n4;
}

@test
fn test_needs_drop_various() {
    assert(!needs_drop<Int8>());
    assert(!needs_drop<Int16>());
    assert(!needs_drop<UInt8>());
    assert(!needs_drop<UInt16>());
    assert(!needs_drop<Float32>());
    assert(!needs_drop<Byte>());
}

@test
fn test_stride_ge_size_all_types() {
    assert((Int8.stride as USize) >= (Int8.size as USize));
    assert((Int16.stride as USize) >= (Int16.size as USize));
    assert((UInt8.stride as USize) >= (UInt8.size as USize));
    assert((UInt16.stride as USize) >= (UInt16.size as USize));
    assert((Float32.stride as USize) >= (Float32.size as USize));
    assert((Bool.stride as USize) >= (Bool.size as USize));
    assert((Byte.stride as USize) >= (Byte.size as USize));
}

@test
fn test_float_int_same_size() {
    // Float32 has same size as Int32
    assert((Float32.size as USize) == (Int32.size as USize));
    // Float64 has same size as Int64
    assert((Float64.size as USize) == (Int64.size as USize));
}

@test
fn test_alignment_is_power_of_two() {
    // All alignments should be powers of 2
    let a1 = (Int8.alignment as USize);
    let a2 = (Int16.alignment as USize);
    let a4 = (Int32.alignment as USize);
    let a8 = (Int64.alignment as USize);
    assert(a1 == (1 as USize));
    assert(a2 == (2 as USize));
    assert(a4 == (4 as USize));
    assert(a8 == (8 as USize));
}

// =============================================================================
// Additional Type Info Tests
// =============================================================================

@test
fn test_bits_bool_byte() {
    assert((Bool.bits as USize) == (8 as USize));
    assert((Byte.bits as USize) == (8 as USize));
}

@test
fn test_all_alignments_positive() {
    assert((Int8.alignment as USize) > (0 as USize));
    assert((Int16.alignment as USize) > (0 as USize));
    assert((Int32.alignment as USize) > (0 as USize));
    assert((Int64.alignment as USize) > (0 as USize));
    assert((Float32.alignment as USize) > (0 as USize));
    assert((Float64.alignment as USize) > (0 as USize));
    assert((Bool.alignment as USize) > (0 as USize));
    assert((Byte.alignment as USize) > (0 as USize));
}

@test
fn test_alignment_le_size() {
    // Alignment should never exceed size for primitive types
    assert((Int8.alignment as USize) <= (Int8.size as USize));
    assert((Int16.alignment as USize) <= (Int16.size as USize));
    assert((Int32.alignment as USize) <= (Int32.size as USize));
    assert((Int64.alignment as USize) <= (Int64.size as USize));
    assert((Float32.alignment as USize) <= (Float32.size as USize));
    assert((Float64.alignment as USize) <= (Float64.size as USize));
}

@test
fn test_type_id_float_types_distinct() {
    let id32 = Float32.id;
    let id64 = Float64.id;
    assert(id32 != id64);
}

@test
fn test_type_name_non_empty() {
    assert(Int.name.len() > 0);
    assert(Float64.name.len() > 0);
    assert(Bool.name.len() > 0);
    assert(Byte.name.len() > 0);
}

@test
fn test_size_doubling_pattern() {
    // Each step doubles: Int8=1, Int16=2, Int32=4, Int64=8
    assert((Int16.size as USize) == (Int8.size as USize) * (2 as USize));
    assert((Int32.size as USize) == (Int16.size as USize) * (2 as USize));
    assert((Int64.size as USize) == (Int32.size as USize) * (2 as USize));
}

@test
fn test_stride_alignment_multiple() {
    // Stride should be a multiple of alignment
    assert((Int32.stride as USize) % (Int32.alignment as USize) == (0 as USize));
    assert((Int64.stride as USize) % (Int64.alignment as USize) == (0 as USize));
    assert((Float64.stride as USize) % (Float64.alignment as USize) == (0 as USize));
}

@test
fn test_type_id_bool_byte_distinct() {
    let id_bool = Bool.id;
    let id_byte = Byte.id;
    assert(id_bool != id_byte);
}

@test
fn test_min_align_positive() {
    // min_align should be at least 1
    assert(min_align() >= (1 as USize));
    // And typically a power of 2 (at most 16)
    assert(min_align() <= (16 as USize));
}

// =============================================================================
// Additional Type Info Tests
// =============================================================================

@test
fn test_size_of_char() {
    // Char should be 4 bytes (Unicode scalar value)
    assert((Char.size as USize) == (4 as USize));
}

@test
fn test_bits_of_integers_match_size() {
    // bits should be 8 * size for integer types
    assert((Int8.bits as USize) == (Int8.size as USize) * (8 as USize));
    assert((Int16.bits as USize) == (Int16.size as USize) * (8 as USize));
    assert((Int32.bits as USize) == (Int32.size as USize) * (8 as USize));
    assert((Int64.bits as USize) == (Int64.size as USize) * (8 as USize));
}

@test
fn test_stride_ge_size() {
    // stride should be >= size for all types
    assert((Int8.stride as USize) >= (Int8.size as USize));
    assert((Int16.stride as USize) >= (Int16.size as USize));
    assert((Int32.stride as USize) >= (Int32.size as USize));
    assert((Int64.stride as USize) >= (Int64.size as USize));
    assert((Float32.stride as USize) >= (Float32.size as USize));
    assert((Float64.stride as USize) >= (Float64.size as USize));
}

@test
fn test_type_id_signed_unsigned_distinct() {
    let id_i32 = Int32.id;
    let id_u32 = UInt32.id;
    assert(id_i32 != id_u32);
}

@test
fn test_type_id_int_float_distinct() {
    let id_int = Int.id;
    let id_float = Float.id;
    assert(id_int != id_float);
}

@test
fn test_size_of_float_matches_int() {
    // Float32 same size as Int32, Float64 same size as Int64
    assert((Float32.size as USize) == (Int32.size as USize));
    assert((Float64.size as USize) == (Int64.size as USize));
}

@test
fn test_align_of_power_of_two() {
    // Alignment should be a power of 2 for all primitive types
    fn is_pow2(x: USize) -> Bool { x > (0 as USize) && (x & (x - (1 as USize))) == (0 as USize) }
    assert(is_pow2((Int8.alignment as USize)));
    assert(is_pow2((Int16.alignment as USize)));
    assert(is_pow2((Int32.alignment as USize)));
    assert(is_pow2((Int64.alignment as USize)));
    assert(is_pow2((Float32.alignment as USize)));
    assert(is_pow2((Float64.alignment as USize)));
}

@test
fn test_type_id_reflexive() {
    // Same type should have same id
    let id1 = Int.id;
    let id2 = Int.id;
    assert(id1 == id2);
}

// =============================================================================
// Additional Type Info Tests (Expanded Coverage)
// =============================================================================

@test
fn test_type_id_char_distinct() {
    // Char should have a unique type ID distinct from integers
    let id_char = Char.id;
    let id_i32 = Int32.id;
    let id_u32 = UInt32.id;
    assert(id_char != id_i32);
    assert(id_char != id_u32);
}

@test
fn test_align_of_char() {
    // Char should have 4-byte alignment (32-bit Unicode scalar)
    assert((Char.alignment as USize) == (4 as USize));
}

@test
fn test_bits_of_char() {
    // Char is 4 bytes = 32 bits
    assert((Char.bits as USize) == (32 as USize));
    assert((Char.bits as USize) == (Char.size as USize) * (8 as USize));
}

@test
fn test_stride_of_char() {
    // Stride of Char should be at least 4 bytes
    assert((Char.stride as USize) >= (4 as USize));
    assert((Char.stride as USize) >= (Char.size as USize));
}

@test
fn test_type_name_consistency() {
    // Different calls to type_name on the same type should return equal values
    let name1 = Int64.name;
    let name2 = Int64.name;
    assert(name1 == name2);
}

@test
fn test_needs_drop_all_primitives() {
    // All primitive types should consistently have needs_drop value
    let drop_int = needs_drop<Int>();
    let drop_float = needs_drop<Float64>();
    let drop_bool = needs_drop<Bool>();
    let drop_char = needs_drop<Char>();
    let drop_byte = needs_drop<Byte>();

    // These scalars have no owned destruction work.
    assert(!drop_int);
    assert(!drop_float);
    assert(!drop_bool);
    assert(!drop_char);
    assert(!drop_byte);
}

@test
fn test_unsigned_doubling_pattern() {
    // Unsigned types also follow doubling pattern
    assert((UInt16.size as USize) == (UInt8.size as USize) * (2 as USize));
    assert((UInt32.size as USize) == (UInt16.size as USize) * (2 as USize));
    assert((UInt64.size as USize) == (UInt32.size as USize) * (2 as USize));
}

@test
fn test_min_align_le_all_alignments() {
    // min_align should be <= all type alignments
    let min_a = min_align();
    assert(min_a <= (Int8.alignment as USize));
    assert(min_a <= (Int16.alignment as USize));
    assert(min_a <= (Int32.alignment as USize));
    assert(min_a <= (Int64.alignment as USize));
    assert(min_a <= (Float32.alignment as USize));
    assert(min_a <= (Float64.alignment as USize));
    assert(min_a <= (Bool.alignment as USize));
    assert(min_a <= (Byte.alignment as USize));
    assert(min_a <= (Char.alignment as USize));
}
