// @test: typecheck-pass
// @tier: 3
// @level: L3
// @tags: meta, compile-time, type-introspection

/// Type introspection - интроспекция типов во время компиляции
///
/// Verum предоставляет базовые возможности для получения информации
/// о типах во время компиляции через встроенные intrinsics.
/// Тесты используют только базовые возможности языка без stdlib.

// ============================================================
// БАЗОВАЯ ИНТРОСПЕКЦИЯ ТИПОВ
// ============================================================

// Примитивные типы и их размеры
const INT_SIZE: Int = Int.size;
const INT_ALIGN: Int = Int.alignment;

const BOOL_SIZE: Int = Bool.size;
const BOOL_ALIGN: Int = Bool.alignment;

const FLOAT64_SIZE: Int = Float64.size;
const FLOAT64_ALIGN: Int = Float64.alignment;

// Type alias for pointer (needed for @size_of)
type IntPtr is *const Int;
const PTR_SIZE: Int = IntPtr.size;
const PTR_ALIGN: Int = IntPtr.alignment;

// ============================================================
// ПОЛЬЗОВАТЕЛЬСКИЕ ТИПЫ
// ============================================================

// Простая структура
type Point is {
    x: Int,
    y: Int,
};

const POINT_SIZE: Int = Point.size;
const POINT_ALIGN: Int = Point.alignment;

// Структура с различными полями
type MixedRecord is {
    flag: Bool,
    count: Int,
    value: Float64,
};

const MIXED_SIZE: Int = MixedRecord.size;
const MIXED_ALIGN: Int = MixedRecord.alignment;

// ============================================================
// SUM TYPES (ENUMS)
// ============================================================

type SimpleEnum is
    | First
    | Second
    | Third;

const SIMPLE_ENUM_SIZE: Int = SimpleEnum.size;
const SIMPLE_ENUM_ALIGN: Int = SimpleEnum.alignment;

type DataEnum is
    | Empty
    | Single(Int)
    | Pair { x: Int, y: Int };

const DATA_ENUM_SIZE: Int = DataEnum.size;
const DATA_ENUM_ALIGN: Int = DataEnum.alignment;

// ============================================================
// GENERIC TYPES
// ============================================================

type Wrapper<T> is {
    value: T,
};

type WrapperInt is Wrapper<Int>;
type WrapperBool is Wrapper<Bool>;

const WRAPPER_INT_SIZE: Int = WrapperInt.size;
const WRAPPER_BOOL_SIZE: Int = WrapperBool.size;

// Pair type
type Pair<A, B> is {
    first: A,
    second: B,
};

type IntBoolPair is Pair<Int, Bool>;
const PAIR_SIZE: Int = IntBoolPair.size;

// ============================================================
// МАССИВЫ
// ============================================================

const ARRAY_4_SIZE: Int = [Int; 4].size;
const ARRAY_8_SIZE: Int = [Int; 8].size;
const ARRAY_16_SIZE: Int = [Int; 16].size;

// Массив структур
const POINT_ARRAY_SIZE: Int = [Point; 4].size;

// ============================================================
// NEWTYPES
// ============================================================

type UserId is (Int);
type Timestamp is (Int64);

const USERID_SIZE: Int = UserId.size;
const TIMESTAMP_SIZE: Int = Timestamp.size;

// ============================================================
// COMPILE-TIME ASSERTIONS
// ============================================================

// Проверки размеров типов
const _INT_SIZE_CHECK: () = {
    // `@static_assert` IS NOT A COMPILER BUILTIN, and the calls below are
    // commented out for that reason (T1124).
    //
    // They used to pass — and assert nothing.  An unknown `@name(...)` typed as
    // `Unit` and lowered to `nil`, so `@static_assert(false)` was accepted in
    // silence.  The compiler refuses an unknown meta-function by name now, so
    // a file cannot claim a check it never performed.
    //
    // Kept verbatim rather than deleted: these ARE the cases a compile-time
    // assertion has to satisfy, and restoring them is how an implementation
    // proves itself.  The type checker already holds a `ConstEvaluator`, which
    // is the half that exists.
    // @static_assert(Int.size == 8);
    // The block's value, now that its only statement is commented out:
    // an empty `{ }` parses as an empty MAP, not an empty block.
    ()
};

const _BOOL_SIZE_CHECK: () = {
    // @static_assert(Bool.size == 1);
    // The block's value, now that its only statement is commented out:
    // an empty `{ }` parses as an empty MAP, not an empty block.
    ()
};

const _PTR_SIZE_CHECK: () = {
    // @static_assert(IntPtr.size == 8);
    // The block's value, now that its only statement is commented out:
    // an empty `{ }` parses as an empty MAP, not an empty block.
    ()
};

// Проверки выравнивания
const _INT_ALIGN_CHECK: () = {
    // @static_assert(Int.alignment >= 4);
    // The block's value, now that its only statement is commented out:
    // an empty `{ }` parses as an empty MAP, not an empty block.
    ()
};

const _FLOAT_ALIGN_CHECK: () = {
    // @static_assert(Float64.alignment >= 4);
    // The block's value, now that its only statement is commented out:
    // an empty `{ }` parses as an empty MAP, not an empty block.
    ()
};

// ============================================================
// META ФУНКЦИИ ДЛЯ РАБОТЫ С ТИПАМИ
// ============================================================

// Проверка что тип помещается в заданный размер
meta fn fits_in_bytes(type_size: Int, max_size: Int) -> Bool {
    type_size <= max_size
}

// Вычисление padding для выравнивания
meta fn padding_for_alignment(offset: Int, alignment: Int) -> Int {
    let remainder = offset % alignment;
    if remainder == 0 { 0 }
    else { alignment - remainder }
}

// Вычисление aligned size
meta fn aligned_size(size: Int, alignment: Int) -> Int {
    size + padding_for_alignment(size, alignment)
}

// ============================================================
// ИСПОЛЬЗОВАНИЕ META ФУНКЦИЙ
// ============================================================

const INT_FITS_8: Bool = fits_in_bytes(Int.size, 8);
const POINT_FITS_32: Bool = fits_in_bytes(Point.size, 32);

const PADDING_EXAMPLE: Int = padding_for_alignment(5, 8);  // 3
const ALIGNED_EXAMPLE: Int = aligned_size(5, 8);           // 8

// ============================================================
// CONST GENERICS С TYPE INFO
// ============================================================

type FixedBuffer<const N: Int> is {
    data: [UInt8; N],
};

// Размер буфера вычисляется во время компиляции
const SMALL_BUFFER_SIZE: Int = FixedBuffer<16>.size;
const LARGE_BUFFER_SIZE: Int = FixedBuffer<256>.size;

// ============================================================
// СЛОЖНЫЕ ТИПЫ
// ============================================================

type Node<T> is {
    value: T,
    next: *mut Node<T>,
};

type NodeInt is Node<Int>;
const NODE_SIZE: Int = NodeInt.size;

// Optional-like type
type Maybe<T> is
    | None
    | Some(T);

type MaybeInt is Maybe<Int>;
const MAYBE_INT_SIZE: Int = MaybeInt.size;

// Result-like type
type Result<T, E> is
    | Ok(T)
    | Err(E);

type IntResult is Result<Int, Int>;
const RESULT_SIZE: Int = IntResult.size;

mount core.prelude.*;

fn main() {
    // Compile-time computed values available at runtime
    let int_size = INT_SIZE;
    let point_size = POINT_SIZE;
    let array_size = ARRAY_4_SIZE;
}
