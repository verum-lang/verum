// @test: typecheck-fail
// @tier: 3
// @level: L3
// @tags: meta, sandbox, violations
// @expected-error: "filesystem operations are forbidden in meta functions"
// @expected-error: "network operations are forbidden in meta functions"
// @expected-error: "process operations are forbidden in meta functions"
// @expected-error: "time operations are forbidden in meta functions"
// @expected-error: "environment operations are forbidden in meta functions"
// @expected-error: "random operations are forbidden in meta functions"
// @expected-error: "unsafe operations are forbidden in meta functions"
// @expected-error: "ffi operations are forbidden in meta functions"
// @expected-error-count: 8

/// Every category the meta sandbox refuses, one call each.
///
/// The eight categories are the eight arms of `get_forbidden_category`:
/// filesystem, network, process, time, environment, random, unsafe and ffi.
/// A violation is reported only when the meta function is EVALUATED, so each
/// one is forced by a `const` below; a `meta fn` that is never called is never
/// checked.
///
/// Resource limits (iteration count, recursion depth, memory, wall clock) are
/// a different mechanism with a different trigger — they are off by default,
/// the limit being a "never trip" sentinel — and they are not asserted here.

meta fn violates_filesystem() -> Text {
    std.fs.read_to_string("/etc/hosts")
}

meta fn violates_network() -> Text {
    std.net.http_get("https://example.invalid")
}

meta fn violates_process() -> Text {
    std.process.spawn("/bin/sh")
}

meta fn violates_time() -> Int {
    std.time.now()
}

meta fn violates_environment() -> Text {
    std.env.var("HOME")
}

meta fn violates_random() -> Int {
    std.random.next()
}

meta fn violates_unsafe() -> Int {
    std.mem.transmute(1)
}

meta fn violates_ffi() -> Int {
    std.ffi.call_c("strlen")
}

fn main() {
    const FROM_DISK: Text = violates_filesystem();
    const FROM_NETWORK: Text = violates_network();
    const FROM_PROCESS: Text = violates_process();
    const FROM_CLOCK: Int = violates_time();
    const FROM_ENVIRONMENT: Text = violates_environment();
    const FROM_RANDOM: Int = violates_random();
    const FROM_TRANSMUTE: Int = violates_unsafe();
    const FROM_FFI: Int = violates_ffi();

    print(f"{FROM_DISK}{FROM_NETWORK}{FROM_PROCESS}{FROM_CLOCK}");
    print(f"{FROM_ENVIRONMENT}{FROM_RANDOM}{FROM_TRANSMUTE}{FROM_FFI}");
}
