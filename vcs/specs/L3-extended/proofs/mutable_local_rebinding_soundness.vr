// @test: verify-fail
// @tier: 3
// @level: L3
// @tags: proofs, refinement, ensures, reflection, assignment, negative-test, soundness
// @timeout: 30000
// @expected-error: proof-failed

/// SOUNDNESS pole for `mutable_local_is_a_rebinding.vr`.
///
/// Every postcondition below is FALSE, so every one MUST fail to verify.
/// Each is the exact answer produced by one wrong model of assignment, so a
/// flip here names the mistake rather than merely reporting one:
///
///   * `assignment_is_not_ignored_MUST_FAIL` is what the verifier believed
///     BEFORE the fix — the `let` was asserted and the assignment was not,
///     leaving `acc == 0`. If this ever proves, assignments are being
///     dropped again.
///
///   * `right_hand_side_is_resolved_MUST_FAIL` is what a fold that stored
///     right-hand sides UNRESOLVED would conclude: `t` would still name `a`
///     at the end and pick up a's FINAL value, making both variables 2 and
///     their difference 0.
///
///   * `an_assignment_is_not_an_equation_MUST_FAIL` guards the other
///     direction. `acc = acc + 1` is a rebinding, not the equation
///     `acc == acc + 1`, which is unsatisfiable and would let a solver prove
///     anything at all from this body.
///
/// Task: T0954.

@verify(formal)
public fn assignment_is_not_ignored_MUST_FAIL(n: Int) -> Int
    requires n == 0
    ensures result == 0
{
    let mut acc = 0;
    acc = acc + 1;
    acc
}

@verify(formal)
public fn right_hand_side_is_resolved_MUST_FAIL(n: Int) -> Int
    requires n == 0
    ensures result == 0
{
    let mut a = 1;
    let mut b = 2;
    let t = a;
    a = b;
    b = t;
    a - b
}

@verify(formal)
public fn an_assignment_is_not_an_equation_MUST_FAIL(n: Int) -> Int
    requires n == 0
    ensures result == 99
{
    let mut acc = 0;
    acc = acc + 1;
    acc
}

mount core.prelude.*;

fn main() {
    print("false postconditions must stay false");
}
