/-- `Soundness rule` is the propositional shape of the per-rule
lemma `K_<rule>_sound`.  Each branch quotes the rule's typing
judgement; `kernel_soundness` aggregates them. -/
def Soundness : KernelRule → Prop
  | KernelRule.K_Var => ∀ {Γ : Ctx} {x : String} {T : CoreTerm}, lookup Γ x = some T → Typing Γ (CoreTerm.Var x) T
  | KernelRule.K_Univ => ∀ (Γ : Ctx) (i : Nat), i < 2^32 - 1 → Typing Γ (CoreTerm.Universe i) (CoreTerm.Universe (i + 1))
  | KernelRule.K_Pi_Form => ∀ {Γ : Ctx} {x : String} {A B : CoreTerm} {i : Nat}, Typing Γ A (CoreTerm.Universe i) → Typing ((x, A) :: Γ) B (CoreTerm.Universe i) → Typing Γ (CoreTerm.Pi x A B) (CoreTerm.Universe i)
  | KernelRule.K_Lam_Intro => ∀ {Γ : Ctx} {x : String} {A b B : CoreTerm} {i : Nat}, Typing Γ A (CoreTerm.Universe i) → Typing ((x, A) :: Γ) b B → Typing Γ (CoreTerm.Lam x A b) (CoreTerm.Pi x A B)
  | KernelRule.K_App_Elim => ∀ {Γ : Ctx} {f a : CoreTerm} {x : String} {A B : CoreTerm}, Typing Γ f (CoreTerm.Pi x A B) → Typing Γ a A → Typing Γ (CoreTerm.App f a) (subst x a B)
  | KernelRule.K_Sigma_Form => ∀ {Γ : Ctx} {x : String} {A B : CoreTerm} {i : Nat}, Typing Γ A (CoreTerm.Universe i) → Typing ((x, A) :: Γ) B (CoreTerm.Universe i) → Typing Γ (CoreTerm.Sigma x A B) (CoreTerm.Universe i)
  | KernelRule.K_Pair_Intro => ∀ {Γ : Ctx} {x : String} {A B a b : CoreTerm} {i : Nat}, Typing Γ (CoreTerm.Sigma x A B) (CoreTerm.Universe i) → Typing Γ a A → Typing Γ b (subst x a B) → Typing Γ (CoreTerm.Pair a b) (CoreTerm.Sigma x A B)
  | KernelRule.K_Fst_Elim => ∀ {Γ : Ctx} {p : CoreTerm} {x : String} {A B : CoreTerm}, Typing Γ p (CoreTerm.Sigma x A B) → Typing Γ (CoreTerm.Fst p) A
  | KernelRule.K_Snd_Elim => ∀ {Γ : Ctx} {p : CoreTerm} {x : String} {A B : CoreTerm}, Typing Γ p (CoreTerm.Sigma x A B) → Typing Γ (CoreTerm.Snd p) (subst x (CoreTerm.Fst p) B)
  | KernelRule.K_Path_Ty_Form => ∀ {Γ : Ctx} {A a b : CoreTerm} {i : Nat}, Typing Γ A (CoreTerm.Universe i) → Typing Γ a A → Typing Γ b A → Typing Γ (CoreTerm.PathTy A a b) (CoreTerm.Universe i)
  | KernelRule.K_Path_Over_Form => ∀ {Γ : Ctx} {motive p lhs rhs carrier start finish : CoreTerm} {x : String} {i : Nat}, Typing Γ motive (CoreTerm.Pi x carrier (CoreTerm.Universe i)) → Typing Γ p (CoreTerm.PathTy carrier start finish) → Typing Γ lhs (CoreTerm.App motive start) → Typing Γ rhs (CoreTerm.App motive finish) → Typing Γ (CoreTerm.PathOver motive p lhs rhs) (CoreTerm.Universe i)
  | KernelRule.K_Refl_Intro => ∀ {Γ : Ctx} {a A : CoreTerm}, Typing Γ a A → Typing Γ (CoreTerm.Refl a) (CoreTerm.PathTy A a a)
  | KernelRule.K_Transp => ∀ {Γ : Ctx} {path value source target : CoreTerm} {i : Nat},   Typing Γ source (CoreTerm.Universe i) →   Typing Γ target (CoreTerm.Universe i) →   Typing Γ path (CoreTerm.PathTy (CoreTerm.Universe i) source target) →   Typing Γ value source →   Typing Γ (CoreTerm.Transport path value) target
  | KernelRule.K_Refine => ∀ {Γ : Ctx} {base predicate : CoreTerm} {x : String} {i : Nat}, Typing Γ base (CoreTerm.Universe i) → Typing ((x, base) :: Γ) predicate CoreTerm.PropSort →   mDepth predicate ≤ mDepth base → Typing Γ (CoreTerm.Refine base x predicate) (CoreTerm.Universe i)
  | KernelRule.K_Refine_Intro => ∀ {Γ : Ctx} {a base predicate witness : CoreTerm} {x : String} {i : Nat}, Typing Γ (CoreTerm.Refine base x predicate) (CoreTerm.Universe i) → Typing Γ a base → Typing Γ witness (subst x a predicate) → Typing Γ a (CoreTerm.Refine base x predicate)
  | KernelRule.K_Refine_Erase => ∀ {Γ : Ctx} {a base : CoreTerm} {x : String} {predicate : CoreTerm}, Typing Γ a (CoreTerm.Refine base x predicate) → Typing Γ a base
  | KernelRule.K_Quot_Form => ∀ {Γ : Ctx} {base equiv : CoreTerm} {i j : Nat},   QuotientFresh "x" [base] →   Typing Γ base (CoreTerm.Universe i) →   Typing Γ equiv (CoreTerm.Pi "x" base (CoreTerm.Pi "y" base (CoreTerm.Universe j))) →   Typing Γ (CoreTerm.Quotient base equiv) (CoreTerm.Universe (max i j))
  | KernelRule.K_Quot_Intro => ∀ {Γ : Ctx} {value base equiv : CoreTerm} {i : Nat},   Typing Γ (CoreTerm.Quotient base equiv) (CoreTerm.Universe i) →   Typing Γ value base →   Typing Γ (CoreTerm.QuotIntro value base equiv) (CoreTerm.Quotient base equiv)
  | KernelRule.K_Quot_Elim => ∀ {Γ : Ctx} {scrutinee motive case_fn respect base equiv result : CoreTerm} {i j : Nat},   QuotientFresh "q" [result] →   QuotientFresh "x" [base, equiv, result, case_fn] →   QuotientFresh "y" [base, equiv, result, case_fn] →   QuotientFresh "r" [base, equiv, result, case_fn] →   motive = CoreTerm.Lam "q" (CoreTerm.Quotient base equiv) result →   Typing Γ (CoreTerm.Quotient base equiv) (CoreTerm.Universe j) →   Typing Γ result (CoreTerm.Universe i) →   Typing Γ scrutinee (CoreTerm.Quotient base equiv) →   Typing Γ case_fn (CoreTerm.Pi "x" base result) →   Typing Γ respect (CoreTerm.Pi "x" base (CoreTerm.Pi "y" base (CoreTerm.Pi "r"     (CoreTerm.App (CoreTerm.App equiv (CoreTerm.Var "x")) (CoreTerm.Var "y"))     (CoreTerm.PathTy result (CoreTerm.App case_fn (CoreTerm.Var "x")) (CoreTerm.App case_fn (CoreTerm.Var "y")))))) →   Typing Γ (CoreTerm.QuotElim scrutinee motive case_fn respect) (CoreTerm.App motive scrutinee)
  | KernelRule.K_Universe_Ascent => ∀ {Γ : Ctx} {i : Nat}, i < 2^32 - 1 → Typing Γ (CoreTerm.Universe i) (CoreTerm.Universe (i + 1))
  | KernelRule.K_Epsilon_Of => ∀ {Γ : Ctx} {articulation result : CoreTerm}, Typing Γ articulation result → Typing Γ (CoreTerm.EpsilonOf articulation) result
  | KernelRule.K_Alpha_Of => ∀ {Γ : Ctx} {enactment result : CoreTerm}, Typing Γ enactment result → Typing Γ (CoreTerm.AlphaOf enactment) result
  | KernelRule.K_Modal_Box => ∀ {Γ : Ctx} {inner T : CoreTerm}, Typing Γ inner T → Typing Γ (CoreTerm.ModalBox inner) CoreTerm.PropSort
  | KernelRule.K_Modal_Diamond => ∀ {Γ : Ctx} {inner T : CoreTerm}, Typing Γ inner T → Typing Γ (CoreTerm.ModalDiamond inner) CoreTerm.PropSort
  | KernelRule.K_Modal_Big_And => ∀ {Γ : Ctx} {components : List CoreTerm} {typeOf : CoreTerm → CoreTerm}, (∀ component ∈ components, Typing Γ component (typeOf component)) → Typing Γ (CoreTerm.ModalBigAnd components) CoreTerm.PropSort
  | KernelRule.K_Shape => ∀ {Γ : Ctx} {inner : CoreTerm} {level : Option Nat}, Typing Γ inner (sortTerm level) → Typing Γ (CoreTerm.Shape inner) (sortTerm level)
  | KernelRule.K_Flat => ∀ {Γ : Ctx} {inner : CoreTerm} {level : Option Nat}, Typing Γ inner (sortTerm level) → Typing Γ (CoreTerm.Flat inner) (sortTerm level)
  | KernelRule.K_Sharp => ∀ {Γ : Ctx} {inner : CoreTerm} {level : Option Nat}, Typing Γ inner (sortTerm level) → Typing Γ (CoreTerm.Sharp inner) (sortTerm level)

/-- **Kernel soundness** — case-analyses on `KernelRule` and
dispatches each branch to its `K_<rule>_sound` lemma. -/
theorem kernel_soundness : ∀ rule, Soundness rule := by
  intro rule
  cases rule
  case K_Var => exact K_Var_sound
  case K_Univ => exact K_Univ_sound
  case K_Pi_Form => exact K_Pi_Form_sound
  case K_Lam_Intro => exact K_Lam_Intro_sound
  case K_App_Elim => exact K_App_Elim_sound
  case K_Sigma_Form => exact K_Sigma_Form_sound
  case K_Pair_Intro => exact K_Pair_Intro_sound
  case K_Fst_Elim => exact K_Fst_Elim_sound
  case K_Snd_Elim => exact K_Snd_Elim_sound
  case K_Path_Ty_Form => exact K_Path_Ty_Form_sound
  case K_Path_Over_Form => exact K_Path_Over_Form_sound
  case K_Refl_Intro => exact K_Refl_Intro_sound
  case K_Transp => exact K_Transp_sound
  case K_Refine => exact K_Refine_sound
  case K_Refine_Intro => exact K_Refine_Intro_sound
  case K_Refine_Erase => exact K_Refine_Erase_sound
  case K_Quot_Form => exact K_Quot_Form_sound
  case K_Quot_Intro => exact K_Quot_Intro_sound
  case K_Quot_Elim => exact K_Quot_Elim_sound
  case K_Universe_Ascent => exact K_Universe_Ascent_sound
  case K_Epsilon_Of => exact K_Epsilon_Of_sound
  case K_Alpha_Of => exact K_Alpha_Of_sound
  case K_Modal_Box => exact K_Modal_Box_sound
  case K_Modal_Diamond => exact K_Modal_Diamond_sound
  case K_Modal_Big_And => exact K_Modal_Big_And_sound
  case K_Shape => exact K_Shape_sound
  case K_Flat => exact K_Flat_sound
  case K_Sharp => exact K_Sharp_sound


end KernelSoundness
