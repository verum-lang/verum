  ∀ {Γ : Ctx} {i : Nat},
    i < 2^32 - 1 →
      Typing Γ (CoreTerm.Universe i) (CoreTerm.Universe (i + 1)) :=
  @Typing.t_universe_ascent

-- UNSUPPORTED K_Round_Trip: No executable rule authorizes assigning an arbitrary term a recovered type; an encoding round-trip requires checked source correspondence

-- K_Epsilon_Of — Diakrisis schema, 1 premises
theorem K_Epsilon_Of_sound :
  ∀ {Γ : Ctx} {articulation result : CoreTerm},
      Typing Γ articulation result →
      Typing Γ (CoreTerm.EpsilonOf articulation) result :=
  @Typing.t_epsilon_of

