fn make_real_pipe() -> Int {
    let mut fds: [Int32; 2] = [-1 as Int32, -1 as Int32];
    if !make_pipe(&mut fds).is_ok() { return -1; }
    (fds[0] as Int) * 65536 + fds[1] as Int
}
