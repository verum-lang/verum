// =============================================================================
// core-tests/term/layout/constraint/unit_test.vr
// =============================================================================
//
// `core/term/layout/constraint.vr` —
//   * LayoutConstraint 6-variant (Length/Min/Max/Percentage/Ratio/Fill)
//   * Direction 2-variant (Horizontal/Vertical)
//   * Flex 5-variant (Start/Center/End/SpaceBetween/SpaceAround)
// =============================================================================

// `LayoutConstraint` is `LayoutConstraint`'s public alias (see
// `core/term/layout/mod.vr`'s "public term surface" re-export comment
// — the bare `LayoutConstraint` name collided across three domains, so
// `constraint.vr` declares the type as `LayoutConstraint` and the
// alias is only visible through the re-exporting parent module, not
// through a direct file-level mount).
// `LayoutConstraint`, NOT the `LayoutConstraint` alias. `core/term/layout/mod.vr:31`
// re-exports it as `LayoutConstraint as LayoutConstraint`, and a variant reached
// through that RENAMED re-export is not a variant: `LayoutConstraint.Length(40)`
// panics with `method 'Length' not found on receiver of runtime kind 'Int'`.
// The same line against `LayoutConstraint` — through the same umbrella, or
// from the declaring module — works. Measured 2026-09-13 with all three
// spellings side by side. A163.
mount core.term.layout.{LayoutConstraint, Direction, Flex};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: LayoutConstraint 6-variant
// =============================================================================

@test
fn test_constraint_length_variant() {
    let c: LayoutConstraint = LayoutConstraint.Length(40);
    assert(c is LayoutConstraint.Length);
}

@test
fn test_constraint_min_variant() {
    let c: LayoutConstraint = LayoutConstraint.Min(10);
    assert(c is LayoutConstraint.Min);
}

@test
fn test_constraint_max_variant() {
    let c: LayoutConstraint = LayoutConstraint.Max(80);
    assert(c is LayoutConstraint.Max);
}

@test
fn test_constraint_percentage_variant() {
    let c: LayoutConstraint = LayoutConstraint.Percentage(50);
    assert(c is LayoutConstraint.Percentage);
}

@test
fn test_constraint_ratio_variant() {
    let c: LayoutConstraint = LayoutConstraint.Ratio(2, 3);
    assert(c is LayoutConstraint.Ratio);
}

@test
fn test_constraint_fill_variant() {
    let c: LayoutConstraint = LayoutConstraint.Fill(1);
    assert(c is LayoutConstraint.Fill);
}

@test
fn test_constraint_length_disjoint() {
    let c: LayoutConstraint = LayoutConstraint.Length(10);
    assert(!(c is LayoutConstraint.Min));
    assert(!(c is LayoutConstraint.Max));
    assert(!(c is LayoutConstraint.Percentage));
    assert(!(c is LayoutConstraint.Ratio));
    assert(!(c is LayoutConstraint.Fill));
}

@test
fn test_constraint_length_payload_round_trip() {
    let c: LayoutConstraint = LayoutConstraint.Length(40);
    match c {
        LayoutConstraint.Length(n) => assert_eq(n, 40),
        _ => panic("expected Length"),
    }
}

@test
fn test_constraint_percentage_payload_round_trip() {
    let c: LayoutConstraint = LayoutConstraint.Percentage(75);
    match c {
        LayoutConstraint.Percentage(n) => assert_eq(n, 75),
        _ => panic("expected Percentage"),
    }
}

@test
fn test_constraint_ratio_two_payload_round_trip() {
    let c: LayoutConstraint = LayoutConstraint.Ratio(1, 4);
    match c {
        LayoutConstraint.Ratio(num, denom) => {
            assert_eq(num, 1);
            assert_eq(denom, 4);
        }
        _ => panic("expected Ratio"),
    }
}

// =============================================================================
// Section 2: Direction 2-variant
// =============================================================================

@test
fn test_direction_horizontal_variant() {
    let d: Direction = Direction.Horizontal;
    assert(d is Direction.Horizontal);
}

@test
fn test_direction_vertical_variant() {
    let d: Direction = Direction.Vertical;
    assert(d is Direction.Vertical);
}

@test
fn test_direction_horizontal_disjoint() {
    let d: Direction = Direction.Horizontal;
    assert(!(d is Direction.Vertical));
}

// =============================================================================
// Section 3: Flex 5-variant
// =============================================================================

@test
fn test_flex_start_variant() {
    let f: Flex = Flex.Start;
    assert(f is Flex.Start);
}

@test
fn test_flex_center_variant() {
    let f: Flex = Flex.Center;
    assert(f is Flex.Center);
}

@test
fn test_flex_end_variant() {
    let f: Flex = Flex.End;
    assert(f is Flex.End);
}

@test
fn test_flex_space_between_variant() {
    let f: Flex = Flex.SpaceBetween;
    assert(f is Flex.SpaceBetween);
}

@test
fn test_flex_space_around_variant() {
    let f: Flex = Flex.SpaceAround;
    assert(f is Flex.SpaceAround);
}

@test
fn test_flex_start_disjoint() {
    let f: Flex = Flex.Start;
    assert(!(f is Flex.Center));
    assert(!(f is Flex.End));
    assert(!(f is Flex.SpaceBetween));
    assert(!(f is Flex.SpaceAround));
}

@test
fn test_flex_space_between_disjoint_from_space_around() {
    let f: Flex = Flex.SpaceBetween;
    assert(!(f is Flex.SpaceAround));
    assert(!(f is Flex.Start));
    assert(!(f is Flex.End));
}

fn main() {}
