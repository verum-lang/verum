// =============================================================================
// core-tests/sys/darwin/time/regression_test.vr
// =============================================================================
//
// Pinned regressions for `core.sys.darwin.time` constants.
// =============================================================================

mount core.prelude.*;
mount core.sys.darwin.time.{
    CLOCK_MONOTONIC_ID,
    CLOCK_PROCESS_CPUTIME,
    CLOCK_THREAD_CPUTIME,
    DarwinDuration, DarwinInstant,
};

// =============================================================================
// REGRESSION 1: CLOCK_MONOTONIC = 6 on Darwin, NOT Linux's 1.
//
// Pre-fix bug class: copy-paste from Linux `time.h` would set
// CLOCK_MONOTONIC to 1, but Darwin's `<time.h>` uses 6. Every
// `clock_gettime(CLOCK_MONOTONIC, ...)` call would read the wrong
// clock domain on macOS.
// =============================================================================

@test
fn regression_clock_monotonic_darwin_value_not_linux() {
    assert_eq(CLOCK_MONOTONIC_ID, 6);
    assert(CLOCK_MONOTONIC_ID != 1);
}

// =============================================================================
// REGRESSION 2: CLOCK_PROCESS_CPUTIME = 12 + CLOCK_THREAD_CPUTIME = 16
// on Darwin — pin the canonical CPU-time clock IDs.
// =============================================================================

@test
fn regression_clock_cputime_canonical_values() {
    assert_eq(CLOCK_PROCESS_CPUTIME, 12);
    assert_eq(CLOCK_THREAD_CPUTIME, 16);
}

fn main() {}

@cfg(target_os = "macos")
@ffi("libSystem.B.dylib")
extern {
    fn clock_gettime_nsec_np(id: Int32) -> UInt64;
}

// CLOCK_UPTIME_RAW reports the Mach absolute clock in nanoseconds.
@cfg(target_os = "macos")
@test
fn mach_clock_uses_host_timebase() {
    let start = unsafe { clock_gettime_nsec_np(8_i32) };
    let sample = core.sys.darwin.time.monotonic_nanos();
    let mach_sample = core.sys.darwin.mach.monotonic_nanos();
    let stop = unsafe { clock_gettime_nsec_np(8_i32) };
    assert(start <= sample && sample <= mach_sample && mach_sample <= stop);

    let zero = DarwinInstant.from_raw(0_u64);
    let second = DarwinDuration.from_nanos(1_000_000_000_u64);
    let later = zero.add(second);
    let elapsed = later.duration_since(&zero);
    let next_tick = DarwinInstant.from_raw(later.as_raw() + 1_u64);
    assert(elapsed.as_nanos() <= 1_000_000_000_u64);
    assert(next_tick.duration_since(&zero).as_nanos() >= 1_000_000_000_u64);
}
