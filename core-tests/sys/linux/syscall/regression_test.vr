// =============================================================================
// core-tests/sys/linux/syscall/regression_test.vr
// =============================================================================

mount core.prelude.*;
mount core.sys.linux.syscall.{
    TIOCGWINSZ, FD_CLOEXEC, O_NONBLOCK,
    FUTEX_WAIT_PRIVATE, FORK_FLAGS,
};

// REGRESSION: TIOCGWINSZ = 0x5413 — terminal-size ioctl. Pre-fix bug
// class: terminal-size queries rely on this exact value; drift would
// silently set the window size to garbage.
@test
fn regression_tiocgwinsz_canonical() {
    assert_eq(TIOCGWINSZ, 0x5413);
}

// REGRESSION: FD_CLOEXEC = 1 — single-bit flag for F_SETFD.
@test
fn regression_fd_cloexec_one() {
    assert_eq(FD_CLOEXEC, 1);
}

// REGRESSION: O_NONBLOCK octal literal 0o4000 = decimal 2048.
@test
fn regression_o_nonblock_octal_4000() {
    assert_eq(O_NONBLOCK, 0o4000);
    assert_eq(O_NONBLOCK, 2048);
}

// REGRESSION: FUTEX_WAIT_PRIVATE = 128 — process-local futex wait.
// Pre-fix bug class: dropping the PRIVATE bit silently makes the
// futex inter-process, breaking thread-local synchronisation.
@test
fn regression_futex_wait_private_one_twentyeight() {
    assert_eq(FUTEX_WAIT_PRIVATE, 128);
}

// REGRESSION: FORK_FLAGS = 17 (SIGCHLD only) — bare fork(2) emulation.
@test
fn regression_fork_flags_seventeen() {
    assert_eq(FORK_FLAGS, 17);
}

@test
@cfg(target_os = "linux")
fn socket_option_writes_only_its_kernel_length() {
    let fd = core.sys.linux.syscall.socket(
        core.sys.linux.syscall.AF_INET, core.sys.linux.syscall.SOCK_DGRAM, 0,
    ).unwrap();
    let mut bytes: [Byte; 8] = [0x5a; 8];
    let mut length: UInt32 = 8;
    let result = core.sys.linux.syscall.getsockopt(fd, core.sys.linux.syscall.SOL_SOCKET,
        core.sys.linux.syscall.SO_ERROR, &mut bytes[..], &mut length);
    core.sys.linux.syscall.close(fd).unwrap();
    result.unwrap();
    assert_eq(length, 4);
    assert_eq(UInt32.from_ne_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]), 0);
    assert_eq(bytes[4], 0x5a);
    assert_eq(bytes[7], 0x5a);
}

@test
@cfg(target_os = "linux")
fn socket_option_preserves_the_buffer_and_length_on_error() {
    let invalid = core.sys.common.FileDesc.from_raw(-1);
    let mut bytes: [Byte; 4] = [0x5a; 4];
    let mut length: UInt32 = 5;
    match core.sys.linux.syscall.getsockopt(invalid, core.sys.linux.syscall.SOL_SOCKET,
        core.sys.linux.syscall.SO_ERROR, &mut bytes[..], &mut length) {
        Result.Err(error) => assert_eq(error.code, core.sys.linux.errno.EINVAL),
        _ => panic("accepted a length beyond the supplied buffer"),
    }
    assert_eq(length, 5);
    length = 4;
    match core.sys.linux.syscall.getsockopt(invalid, core.sys.linux.syscall.SOL_SOCKET,
        core.sys.linux.syscall.SO_ERROR, &mut bytes[..], &mut length) {
        Result.Err(error) => assert_eq(error.code, core.sys.linux.errno.EBADF),
        _ => panic("accepted a closed descriptor"),
    }
    assert_eq(length, 4);
    assert_eq(bytes[0], 0x5a);
    assert_eq(bytes[3], 0x5a);
}

fn main() {}
