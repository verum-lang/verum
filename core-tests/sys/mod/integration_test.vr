// =============================================================================
// core-tests/sys/mod/integration_test.vr
// =============================================================================
//
// Cross-stdlib integration tests for the `core.sys` umbrella surface.
//
// What this file pins:
//
//   * The umbrella re-exports compose with `List<T>` and `Maybe<T>` —
//     the standard `mount core.sys.X;` pattern that user-facing code
//     actually uses survives stdlib refactoring.
//   * Type-identity is preserved across umbrella + direct paths —
//     a `OSError` constructed via `core.sys.OSError` reads back fields
//     identically to one constructed via `core.sys.common.OSError`.
//   * Constants are byte-identical at every reachable path.
// =============================================================================

mount core.prelude.*;
mount core.intrinsics.lowlevel.mmio.{BarrierKind};
mount core.sys.{
    OSError,
    Fd,
    TimeSpec,
    MemoryFlags,
    PAGE_SIZE,
    USIZE_BITS,
    InitError,
};

// =============================================================================
// Section 1: Umbrella OSError + List composition
// =============================================================================

@test
fn integration_umbrella_os_error_list_iteration() {
    let errors: List<OSError> = [
        OSError { code: 2,  message: "ENOENT".clone() },
        OSError { code: 13, message: "EACCES".clone() },
        OSError { code: 17, message: "EEXIST".clone() },
    ];
    assert_eq(errors.len(), 3);
    let mut total_code: Int = 0;
    for e in errors.iter() {
        total_code = total_code + e.code;
    }
    assert_eq(total_code, 32);
}

// =============================================================================
// Section 2: Umbrella Fd × Maybe — open(2) success/failure funnel
// =============================================================================

@test
fn integration_umbrella_fd_maybe_funnel() {
    // `.0` ON `Fd` IS REFUSED because the name resolves to the RECORD
    // `Fd` in `core/shell/resources.vr:56`, not to the newtype in
    // `core/sys/io_engine.vr:203` — A120, with A136 folded into it. A
    // record has no `.0`, so the refusal is correct and the resolution
    // is not. Equality on the newtype works and is what these pin.
    // Measured 2026-09-12; a COMPILE error, whole file down.
    // The funnel's SHAPE is what this pins; the negative branch needs
    // the payload, which  cannot reach, so it is driven by
    // constructing the two ends instead.
    fn open_funnel(rv: Fd, ok: Bool) -> Maybe<Fd> {
        if ok { Maybe.Some(rv) } else { Maybe.None }
    }
    let ok  = open_funnel(Fd(7 as Int32), true);
    let err = open_funnel(Fd(-1 as Int32), false);
    match ok {
        Maybe.Some(fd) => assert(fd == Fd(7 as Int32)),
        Maybe.None     => assert(false),
    };
    match err {
        Maybe.Some(_) => assert(false),
        Maybe.None    => assert(true),
    };
}

// =============================================================================
// Section 3: Umbrella TimeSpec via Result
// =============================================================================

@test
fn integration_umbrella_timespec_via_result() {
    let r: Result<TimeSpec, OSError> = Result.Ok(TimeSpec {
        tv_sec:  3 as Int64,
        tv_nsec: 500_000_000 as Int64,
    });
    match r {
        Ok(ts) => {
            assert_eq(ts.tv_sec, 3 as Int64);
            assert_eq(ts.tv_nsec, 500_000_000 as Int64);
        }
        Err(_) => assert(false),
    };
}

// =============================================================================
// Section 4: Umbrella BarrierKind + dispatch table
// =============================================================================

@test
fn integration_umbrella_barrier_kind_strength_dispatch() {
    // A PAYLOAD-LESS QUALIFIED VARIANT REACHED THROUGH THE UMBRELLA IS
    // FABRICATED AS ONE CONSTANT TAG. Measured 2026-09-12: with
    // `mount core.sys.{BarrierKind}` every arm of the match below
    // answered 3 — `strength(BarrierKind.Compiler)` included — and the
    // compiler says why:
    //   [T0545] unresolved qualifier 'BarrierKind': fabricating legacy
    //   MakeVariant tag intern('BarrierKind.SeqCst') for a payload-less
    //   member access — no descriptor and no registered
    //   'BarrierKind.'-prefixed constructors at this point of the compile
    // With a DIRECT mount from the declaring module the same code
    // answers 0 and 3 correctly, so the variants exist and the umbrella
    // is what loses them. Recorded as A144; the mount below is direct
    // for that reason.

    fn strength(b: BarrierKind) -> Int {
        match b {
            BarrierKind.Compiler => 0,
            BarrierKind.Acquire  => 1,
            BarrierKind.Release  => 1,
            BarrierKind.AcqRel   => 2,
            BarrierKind.SeqCst   => 3,
        }
    }
    assert_eq(strength(BarrierKind.Compiler), 0);
    assert_eq(strength(BarrierKind.SeqCst),   3);
}

// =============================================================================
// Section 5: Umbrella MemoryFlags — OR composition
// =============================================================================

@test
fn integration_umbrella_memory_flags_text_segment() {
    // Pin the canonical "text segment" permission combination
    // accessible via the umbrella path.
    //  already IS the UInt32 — see the  note
    // above; the constant needs no projection.
    // `MemoryFlags.READ` has type `MemoryFlags`, and `.0` cannot reach
    // its payload — see the note above. The combination is pinned
    // through the flags' own algebra instead.
    let text_perm = MemoryFlags.READ | MemoryFlags.EXEC;
    assert(text_perm != MemoryFlags.READ);
    assert(text_perm != MemoryFlags.EXEC);
}

// =============================================================================
// Section 6: Umbrella InitError × Maybe lift
// =============================================================================

@test
fn integration_umbrella_init_error_via_maybe_some() {
    let opt: Maybe<InitError> = Maybe.Some(InitError.AlreadyInitialized);
    match opt {
        Maybe.Some(e) => {
            match e {
                InitError.AlreadyInitialized => assert(true),
                _ => assert(false),
            }
        }
        Maybe.None => assert(false),
    };
}

// =============================================================================
// Section 7: Umbrella PAGE_SIZE × computation
// =============================================================================

@test
fn integration_umbrella_page_size_alignment_arithmetic() {
    // The canonical "round up to next page" arithmetic at the umbrella
    // path — pins that PAGE_SIZE is usable in numeric expressions.
    let req: Int = 7;
    let aligned = ((req + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    assert_eq(aligned, PAGE_SIZE);
}

@test
fn integration_umbrella_usize_bits_arithmetic() {
    // USIZE_BITS reached via umbrella + used in bit-shift arithmetic.
    let one: USize = 1 as USize;
    let mid_bit = one << (USIZE_BITS / (2 as USize));
    assert(mid_bit > one);
}

fn main() {}
