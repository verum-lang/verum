module test.net.tls.credential_error;

mount core.security.x509.credential.{Certificate, PrivateKey, CredentialError};
mount core.net.tls.LegacyTlsError;

fn certificate_for_transport(pem: &Text) -> Result<Certificate, LegacyTlsError> {
    let value = Certificate.from_pem(pem)?;
    Result.Ok(value)
}

fn private_key_for_transport(pem: &Text) -> Result<PrivateKey, LegacyTlsError> {
    let value = PrivateKey.from_pem(pem)?;
    Result.Ok(value)
}

@test
fn certificate_error_conversion_retains_the_original_message() {
    let converted = LegacyTlsError.from(CredentialError.InvalidCertificate("certificate detail"));
    assert(match converted {
        LegacyTlsError.InvalidCertificate(message) => message == "certificate detail",
        _ => false,
    });
}

@test
fn key_error_conversion_retains_the_original_message() {
    let converted = LegacyTlsError.from(CredentialError.InvalidKey("key detail"));
    assert(match converted {
        LegacyTlsError.InvalidKey(message) => message == "key detail",
        _ => false,
    });
}

@test
fn certificate_question_mark_uses_the_declared_transport_conversion() {
    let pem = "not a PEM certificate";
    assert(match certificate_for_transport(&pem) {
        Result.Err(LegacyTlsError.InvalidCertificate(message)) => message == "missing BEGIN CERTIFICATE marker",
        _ => false,
    });
}

@test
fn key_question_mark_uses_the_declared_transport_conversion() {
    let pem = "not a PEM private key";
    assert(match private_key_for_transport(&pem) {
        Result.Err(LegacyTlsError.InvalidKey(message)) => message == "unrecognized PEM key format",
        _ => false,
    });
}
