mount core.net.http.{Headers, Method, Response, StatusCode};
mount core.net.weft.error.{ExtractRejection, WeftError};
mount core.net.weft.handler.{BodyBytes, BodyText, FromRequest, Handler, WeftRequest};
mount core.net.weft.json_extractor.{JsonExtractorConfig, extract_json};
mount core.net.weft.response_ext.{resp_json, resp_text, resp_with_body_bytes, resp_with_body_text};
mount core.net.weft.service.{ServiceBuilder};
mount core.net.weft.zero_rtt_gate.{ZeroRttGateHandler, ZeroRttGateLayer};

@test
fn request_body_preserves_bytes_when_decoded_lossily() {
    let request = WeftRequest.new(Method.Post, "/", Maybe.None, Headers.new(),
        [0x61_u8, 0xFF_u8, 0xC3_u8, 0xA9_u8]);
    assert_eq(request.body_text(), "a�é");
    let bytes = request.body_bytes();
    assert_eq(bytes.len(), 4);
    assert_eq(bytes[1], 0xFF_u8);
}

@test
async fn request_extractors_preserve_binary_and_reject_invalid_text() {
    let mut request = WeftRequest.new(Method.Post, "/", Maybe.None, Headers.new(), [0xFF_u8]);
    let binary = match BodyBytes.from_request(&mut request).await {
        Result.Ok(value) => value,
        Result.Err(_) => panic("binary extractor rejected a byte"),
    };
    assert_eq(binary.as_slice()[0], 0xFF_u8);
    match BodyText.from_request(&mut request).await {
        Result.Err(ExtractRejection.InvalidBody(_)) => {},
        _ => panic("invalid UTF-8 must be rejected"),
    };
}

@test
fn weft_response_builders_count_utf8_bytes_and_preserve_content_type() {
    let plain = resp_text("é");
    assert_eq(plain.status_code().code(), 200);
    assert_eq(*plain.content_type().unwrap(), "text/plain; charset=utf-8");
    assert_eq(plain.content_length().unwrap(), 2);
    assert_eq(plain.body_text(), "é");

    let json = resp_with_body_text(resp_json("[]"), "null");
    assert_eq(*json.content_type().unwrap(), "application/json");
    assert_eq(json.content_length().unwrap(), 4);
    assert_eq(json.body_text(), "null");
}

@test
fn weft_response_binary_replacement_retains_error_status_and_other_headers() {
    let original = Response.new(StatusCode.not_found())
        .header("X-Trace", "abc")
        .header("Content-Length", "999");
    let response = resp_with_body_bytes(original, [0_u8, 255_u8]);
    assert(!response.is_success());
    assert_eq(response.status_code().code(), 404);
    assert_eq(*response.headers().get(&"x-trace").unwrap(), "abc");
    assert_eq(response.content_length().unwrap(), 2);
    let bytes = response.into_body();
    assert_eq(bytes.len(), 2);
    assert_eq(bytes[0], 0_u8);
    assert_eq(bytes[1], 255_u8);
}

@test
fn weft_response_json_rejection_retains_status_and_detail() {
    let req = WeftRequest.new(Method.Post, "/", Maybe.None, Headers.new(), []);
    let response = match extract_json<Int>(&req, JsonExtractorConfig.default()) {
        Result.Err(error) => error.into_response(),
        Result.Ok(_) => panic("expected a missing Content-Type rejection"),
    };
    assert_eq(response.status_code().code(), 415);
    assert_eq(*response.content_type().unwrap(), "text/plain; charset=utf-8");
    assert_eq(response.body_text(), "missing content-type header");
}

type InnerHandler is {};

implement Handler for InnerHandler {
    type Error = WeftError;
    async fn handle(&self, req: WeftRequest) -> Result<Response, WeftError> {
        Result.Err(WeftError.Overloaded)
    }
}

@test
async fn weft_response_zero_rtt_rejection_closes_the_connection() {
    let mut headers = Headers.new();
    headers.set(&"x-weft-via-0rtt", &"1");
    let req = WeftRequest.new(Method.Post, "/", Maybe.None, headers, []);
    let handler: ZeroRttGateHandler<InnerHandler> = ServiceBuilder.new(InnerHandler {})
        .layer(ZeroRttGateLayer.new()).build();
    let response: Response = match handler.handle(req).await {
        Result.Ok(reply) => reply,
        Result.Err(_) => panic("the rejected request reached the inner handler"),
    };
    assert_eq(response.status_code().code(), 425);
    assert_eq(*response.headers().get(&"connection").unwrap(), "close");
    assert_eq(response.body_bytes().len(), 0);
}
