// Certificate-step and chain-validation controls using an Ed25519 test CA.
// Public DER fixtures were independently checked with OpenSSL verify.
// Validation uses each leaf's not-before time; no dependency on the wall clock.
module test.net.tls13.certificate_state;

mount core.security.x509.{X509Certificate, TrustStore, ChainError, parse_certificate, validate_chain};
mount core.net.tls13.handshake.client_sm.{Tls13ClientConfig, ClientSm};
mount core.net.tls13.handshake.dhe_pool.{DhePool, DheKeyPair};
mount core.net.tls13.handshake.messages.{HandshakeMessage, CertificateMessage, encode_handshake};
mount core.net.tls13.named_group.NamedGroup;
mount core.net.tls13.cipher_suite.CipherSuite;
mount core.net.tls13.sig_scheme.SignatureScheme;
mount core.net.tls13.error.TlsError;

