fn certificate_chain_message(ders: &[List<Byte>]) -> List<Byte> {
    let message = HandshakeMessage.CertificateMsg(CertificateMessage.server_chain(ders));
    let mut wire: List<Byte> = [];
    encode_handshake(&message, &mut wire).unwrap();
    wire
}

fn certificate_message(der: List<Byte>) -> List<Byte> {
    let certificates: List<List<Byte>> = [der];
    certificate_chain_message(certificates.as_slice())
}

type VectorKeyPool is {};

implement DhePool for VectorKeyPool {
    fn take(&mut self, group: NamedGroup) -> Result<DheKeyPair, TlsError> {
        match group {
            NamedGroup.X25519 => {
                // Public RFC 7748 §6.1 test scalar. The production constructor derives its public half.
                let scalar: [Byte; 32] = [
                    0x77_u8, 0x07_u8, 0x6d_u8, 0x0a_u8, 0x73_u8, 0x18_u8, 0xa5_u8, 0x7d_u8,
                    0x3c_u8, 0x16_u8, 0xc1_u8, 0x72_u8, 0x51_u8, 0xb2_u8, 0x66_u8, 0x45_u8,
                    0xdf_u8, 0x4c_u8, 0x2f_u8, 0x87_u8, 0xeb_u8, 0xc0_u8, 0x99_u8, 0x2a_u8,
                    0xb1_u8, 0x77_u8, 0xfb_u8, 0xa5_u8, 0x1d_u8, 0xb9_u8, 0x2c_u8, 0x2a_u8,
                ];
                Result.Ok(DheKeyPair.from_x25519_secret(&scalar))
            },
            _ => Result.Err(TlsError.IllegalParameter),
        }
    }
}

fn awaiting_certificate() -> ClientSm {
    let config = Tls13ClientConfig.new("verum.invalid", TrustStore.empty(), [0x11_u8; 32],
        [NamedGroup.X25519], [CipherSuite.TlsAes128GcmSha256], [SignatureScheme.Ed25519Scheme], []).unwrap();
    let mut pool = VectorKeyPool {};
    let (client, client_hello) = ClientSm.new(config).start_with_key_pool(&mut pool).unwrap();
    assert(client_hello.len() > 4 && client_hello[0] == 1_u8);
    // ServerHello selects TLS 1.3, AES-128-GCM, and the RFC 7748 §6.1 peer public key.
    let server_hello: List<Byte> = [
        0x02_u8, 0x00_u8, 0x00_u8, 0x56_u8, 0x03_u8, 0x03_u8, 0x20_u8, 0x21_u8,
        0x22_u8, 0x23_u8, 0x24_u8, 0x25_u8, 0x26_u8, 0x27_u8, 0x28_u8, 0x29_u8,
        0x2a_u8, 0x2b_u8, 0x2c_u8, 0x2d_u8, 0x2e_u8, 0x2f_u8, 0x30_u8, 0x31_u8,
        0x32_u8, 0x33_u8, 0x34_u8, 0x35_u8, 0x36_u8, 0x37_u8, 0x38_u8, 0x39_u8,
        0x3a_u8, 0x3b_u8, 0x3c_u8, 0x3d_u8, 0x3e_u8, 0x3f_u8, 0x00_u8, 0x13_u8,
        0x01_u8, 0x00_u8, 0x00_u8, 0x2e_u8, 0x00_u8, 0x2b_u8, 0x00_u8, 0x02_u8,
        0x03_u8, 0x04_u8, 0x00_u8, 0x33_u8, 0x00_u8, 0x24_u8, 0x00_u8, 0x1d_u8,
        0x00_u8, 0x20_u8, 0xde_u8, 0x9e_u8, 0xdb_u8, 0x7d_u8, 0x7b_u8, 0x7d_u8,
        0xc1_u8, 0xb4_u8, 0xd3_u8, 0x5b_u8, 0x61_u8, 0xc2_u8, 0xec_u8, 0xe4_u8,
        0x35_u8, 0x37_u8, 0x3f_u8, 0x83_u8, 0x43_u8, 0xc8_u8, 0x5b_u8, 0x78_u8,
        0x67_u8, 0x4d_u8, 0xad_u8, 0xfc_u8, 0x7e_u8, 0x14_u8, 0x6f_u8, 0x88_u8,
        0x2b_u8, 0x4f_u8,
    ];
    let (after_hello, hello_step) = client.on_handshake(server_hello.as_slice()).unwrap();
    assert(!hello_step.is_connected());
    let encrypted_extensions: List<Byte> = [8_u8, 0_u8, 0_u8, 2_u8, 0_u8, 0_u8];
    let (ready, extensions_step) = after_hello.on_handshake(encrypted_extensions.as_slice()).unwrap();
    assert(!extensions_step.is_connected());
    ready
}

@test
fn certificate_step_retains_the_parsed_certificate() {
    let der = leaf_der();
    let wire = certificate_message(der.clone());
    let (next, output) = awaiting_certificate().on_handshake(wire.as_slice()).unwrap();
    assert(!output.is_connected());
    match next {
        ClientSm.WaitCertVerifySm(state) => {
            let certificate: &X509Certificate = state.received_certificate();
            assert(certificate.der_bytes() == der.as_slice());
            assert(certificate.signature_bytes().len() == 64);
            assert(certificate.tbs_der_bytes().len() > 0);
            assert(state.received_chain_der().len() == 1);
            assert(state.received_chain_der()[0].as_slice() == certificate.der_bytes());
        },
        _ => assert(false, "certificate message must advance to CertificateVerify"),
    }
}

@test
fn certificate_step_preserves_peer_wire_order() {
    let presented: List<List<Byte>> = [leaf_der(), root_der()];
    let wire = certificate_chain_message(presented.as_slice());
    let (next, result) = awaiting_certificate().on_handshake(wire.as_slice()).unwrap();
    assert(!result.is_connected());
    match next {
        ClientSm.WaitCertVerifySm(state) => {
            let chain = state.received_chain_der();
            assert_eq(chain.len(), 2);
            assert(chain[0].as_slice() == presented[0].as_slice());
            assert(chain[1].as_slice() == presented[1].as_slice());
            assert(state.received_certificate().der_bytes() == chain[0].as_slice());
        },
        _ => assert(false, "certificate chain must advance to CertificateVerify"),
    }
}

@test
fn certificate_step_rejects_malformed_der() {
    let wire = certificate_message([0x30_u8, 0x00_u8]);
    match awaiting_certificate().on_handshake(wire.as_slice()) {
        Result.Err(TlsError.BadCertificate) => {},
        _ => assert(false, "malformed DER must produce BadCertificate"),
    }
}

@test
fn parsed_certificate_chain_validates_against_its_trust_anchor() {
    let leaf = parse_certificate(leaf_der().as_slice()).unwrap();
    let (not_before, _) = leaf.validity_unix_bounds();
    let now = not_before + 1;
    let roots: List<List<Byte>> = [root_der()];
    let trust = TrustStore.from_der(roots.as_slice()).unwrap();
    let hostname = "verum.invalid".to_text();
    let chain: List<X509Certificate> = [leaf];
    match validate_chain(&chain, &trust, Maybe.Some(&hostname), now) {
        Result.Ok(_) => {},
        Result.Err(_) => assert(false, "the independently verified chain must validate"),
    }
}

@test
fn parsed_certificate_chain_rejects_an_untrusted_root() {
    let leaf = parse_certificate(leaf_der().as_slice()).unwrap();
    let (not_before, _) = leaf.validity_unix_bounds();
    let now = not_before + 1;
    let chain: List<X509Certificate> = [leaf];
    match validate_chain(&chain, &TrustStore.empty(), Maybe.None, now) {
        Result.Err(ChainError.UnknownIssuer) => {},
        _ => assert(false, "untrusted root must produce UnknownIssuer"),
    }
}

@test
fn parsed_certificate_chain_rejects_a_changed_signature() {
    let mut der = leaf_der();
    let last = der.len() - 1;
    der[last] = der[last] ^ 1_u8;
    let leaf = parse_certificate(der.as_slice()).unwrap();
    let (not_before, _) = leaf.validity_unix_bounds();
    let now = not_before + 1;
    let roots: List<List<Byte>> = [root_der()];
    let trust = TrustStore.from_der(roots.as_slice()).unwrap();
    let chain: List<X509Certificate> = [leaf];
    match validate_chain(&chain, &trust, Maybe.None, now) {
        Result.Err(ChainError.BadSignature(0)) => {},
        _ => assert(false, "changed signature must produce BadSignature for the leaf"),
    }
}
