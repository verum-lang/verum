// Public test certificate and deterministic test-only PKCS#8 key material.
// PEM/DER fixtures were independently decoded with OpenSSL; these are not live credentials.
module test.security.x509.credential;

mount core.security.x509.credential.{Certificate, PrivateKey, KeyType, CredentialError};
mount core.security.x509.certificate.parse_certificate;

fn certificate_pem() -> Text { "-----BEGIN CERTIFICATE-----\nMIIBJDCB16ADAgECAgEBMAUGAytlcDAaMRgwFgYDVQQDDA9WZXJ1bSBUZXN0IFJv\nb3QwHhcNMjYxMTAzMjEyNzI4WhcNMjYxMjAzMjEyNzI4WjAaMRgwFgYDVQQDDA9W\nZXJ1bSBUZXN0IFJvb3QwKjAFBgMrZXADIQC9kwkM7NS1fNIHT7+Z3n5V5VyrWl3H\n0UAu251nNEHvHqNCMEAwHQYDVR0OBBYEFArq9FRwwRJb/uwpUFaiYLTOmNjgMA8G\nA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMAUGAytlcANBACprbqytBojE\n+/kZwlR32pCO7QmTcXXIh5fvGB5RJfgcqsZAWJfCyoBv0/cFlKwz2uGHoTScQnZX\n1GXcMxwkEQk=\n-----END CERTIFICATE-----\n" }

fn leaf_certificate_pem() -> Text { "-----BEGIN CERTIFICATE-----\nMIIBLzCB4qADAgECAgECMAUGAytlcDAaMRgwFgYDVQQDDA9WZXJ1bSBUZXN0IFJv\nb3QwHhcNMjYxMTAzMjEyNzI4WhcNMjYxMTA1MjEyNzI4WjAYMRYwFAYDVQQDDA12\nZXJ1bS5pbnZhbGlkMCowBQYDK2VwAyEAg3q+9yNJk1bHxZIdfw5veheTVuBUZp4W\nYXADw7ecBKajTzBNMAwGA1UdEwEB/wQCMAAwDgYDVR0PAQH/BAQDAgeAMBMGA1Ud\nJQQMMAoGCCsGAQUFBwMBMBgGA1UdEQQRMA+CDXZlcnVtLmludmFsaWQwBQYDK2Vw\nA0EA/zcVlie8boXjnNJhD19wmG0jZoxIkxDryNn/UmgDtp88aZefy0nZWZASyNGu\n7oz9u4Y2aiIjVf2x62yBX/yGAA==\n-----END CERTIFICATE-----\n" }

fn ed25519_pem() -> Text { "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f\n-----END PRIVATE KEY-----\n" }

fn unsupported_key_pem() -> Text { "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VuBCIEIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f\n-----END PRIVATE KEY-----\n" }

@test
fn certificate_pem_retains_der_and_parses_as_x509() {
    let pem = certificate_pem();
    let credential = Certificate.from_pem(&pem).unwrap();
    assert_eq(credential.size(), 296);
    let parsed = parse_certificate(credential.der_bytes()).unwrap();
    assert(parsed.is_ca());
    let hostname = "verum.invalid";
    assert(!parsed.matches_hostname(&hostname));
}

@test
fn pem_chain_retains_each_certificate_in_source_order() {
    let leaf_pem = leaf_certificate_pem();
    let root_pem = certificate_pem();
    let bundle = f"{leaf_pem}{root_pem}";
    let certificates = Certificate.from_pem_chain(&bundle).unwrap();
    let leaf = Certificate.from_pem(&leaf_pem).unwrap();
    let root = Certificate.from_pem(&root_pem).unwrap();
    assert(leaf.size() != root.size());
    assert_eq(certificates.len(), 2);
    let first = certificates[0].der_bytes();
    let second = certificates[1].der_bytes();
    let expected_leaf = leaf.der_bytes();
    let expected_root = root.der_bytes();
    assert_eq(first.len(), expected_leaf.len());
    assert_eq(second.len(), expected_root.len());
    for i in 0..first.len() { assert_eq(first[i], expected_leaf[i]); }
    for i in 0..second.len() { assert_eq(second[i], expected_root[i]); }
    let leaf_cert = parse_certificate(certificates[0].der_bytes()).unwrap();
    let hostname = "verum.invalid";
    assert(!leaf_cert.is_ca());
    assert(leaf_cert.matches_hostname(&hostname));
}

@test
fn missing_certificate_marker_has_a_credential_error() {
    let pem = "not a PEM certificate";
    assert(match Certificate.from_pem(&pem) {
        Result.Err(CredentialError.InvalidCertificate(message)) => message == "missing BEGIN CERTIFICATE marker",
        _ => false,
    });
}

@test
fn unterminated_certificate_chain_reports_the_actual_parse_failure() {
    let pem = "-----BEGIN CERTIFICATE-----\nAQI=\n";
    assert(match Certificate.from_pem_chain(&pem) {
        Result.Err(CredentialError.InvalidCertificate(message)) => message.contains("missing -----END marker"),
        _ => false,
    });
}

@test
fn malformed_certificate_base64_is_not_accepted() {
    let pem = "-----BEGIN CERTIFICATE-----\n%%%%\n-----END CERTIFICATE-----\n";
    assert(match Certificate.from_pem(&pem) {
        Result.Err(CredentialError.InvalidCertificate(message)) => message.contains("base64 decode failed"),
        _ => false,
    });
}

@test
fn pkcs8_algorithm_is_read_from_der() {
    let pem = ed25519_pem();
    let key = PrivateKey.from_pem(&pem).unwrap();
    assert_eq(key.key_type(), KeyType.Ed25519);
}

@test
fn only_the_decoded_label_identifies_the_private_key_format() {
    let key_pem = ed25519_pem();
    let bundle = f"RSA PRIVATE KEY in preamble\n{key_pem}";
    assert_eq(PrivateKey.from_pem(&bundle).unwrap().key_type(), KeyType.Ed25519);
    let encrypted = "-----BEGIN ENCRYPTED PRIVATE KEY-----\nAQI=\n-----END ENCRYPTED PRIVATE KEY-----";
    assert(match PrivateKey.from_pem(&encrypted) {
        Result.Err(CredentialError.InvalidKey(message)) => message == "unrecognized PEM key format",
        _ => false,
    });
}

@test
fn single_certificate_and_chain_have_different_read_boundaries() {
    let key = ed25519_pem();
    let root = certificate_pem();
    let input = f"{key}{root}-----BEGIN CERTIFICATE-----\nAQI=\n";
    assert_eq(Certificate.from_pem(&input).unwrap().size(), 296);
    assert(match Certificate.from_pem_chain(&input) {
        Result.Err(CredentialError.InvalidCertificate(message)) => message.contains("missing -----END marker"),
        _ => false,
    });
}

@test
fn invalid_pkcs8_is_not_relabelled_as_rsa() {
    let pem = "-----BEGIN PRIVATE KEY-----\nAQI=\n-----END PRIVATE KEY-----\n";
    assert(match PrivateKey.from_pem(&pem) {
        Result.Err(CredentialError.InvalidKey(message)) => message.contains("PKCS#8: not a SEQUENCE"),
        _ => false,
    });
}

@test
fn unsupported_pkcs8_signing_algorithm_stays_explicit() {
    let pem = unsupported_key_pem();
    assert(match PrivateKey.from_pem(&pem) {
        Result.Err(CredentialError.InvalidKey(message)) => message.contains("PKCS#8: key algorithm"),
        _ => false,
    });
}

@test
fn credential_errors_keep_distinct_categories_and_messages() {
    let certificate = CredentialError.InvalidCertificate("bad material");
    let key = CredentialError.InvalidKey("bad material");
    assert(certificate != key);
    assert_eq(certificate.description(), "invalid certificate: bad material");
    assert_eq(key.description(), "invalid private key: bad material");
}
