// =============================================================================
// core-tests/security/x509/certificate/unit_test.vr
// =============================================================================
//
// `core/security/x509/certificate.vr` — X.509 version tag.
// =============================================================================

mount core.hash.crypto.sha256.Sha256;
mount core.encoding.hex.{encode as hex_encode};
mount core.security.x509.certificate.{X509Version, parse_certificate};
mount core.encoding.base64;
mount core.security.x509.trust_store.{TrustStore};
mount core.security.x509.path_building.{build_paths, build_best_path, candidate_path_to_list};
mount core.security.x509.server_identity.{verify_server_identity, ServerIdentityError};
mount core.security.x509.ocsp_client.{CertIdHash, build_ocsp_request};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: X509Version 3-variant ADT
// =============================================================================

@test
fn test_x509_version_v1_variant() {
    let v: X509Version = X509Version.V1;
    assert(v is X509Version.V1);
}

@test
fn test_x509_version_v2_variant() {
    let v: X509Version = X509Version.V2;
    assert(v is X509Version.V2);
}

@test
fn test_x509_version_v3_variant() {
    let v: X509Version = X509Version.V3;
    assert(v is X509Version.V3);
}

// =============================================================================
// Section 2: Pairwise disjointness
// =============================================================================

@test
fn test_x509_version_v1_disjoint() {
    let v: X509Version = X509Version.V1;
    assert(!(v is X509Version.V2));
    assert(!(v is X509Version.V3));
}

@test
fn test_x509_version_v2_disjoint() {
    let v: X509Version = X509Version.V2;
    assert(!(v is X509Version.V1));
    assert(!(v is X509Version.V3));
}

@test
fn test_x509_version_v3_disjoint() {
    let v: X509Version = X509Version.V3;
    assert(!(v is X509Version.V1));
    assert(!(v is X509Version.V2));
}

fn leaf_der() -> List<Byte> {
    base64.decode(&"").unwrap()
}

fn root_der() -> List<Byte> {
    base64.decode(&"").unwrap()
}

@test
fn test_certificate_validity_is_read_from_its_der() {
    // Ed25519 test certificate for verum.invalid. OpenSSL independently decoded both times.
    let mut der = leaf_der();
    let certificate = parse_certificate(der.as_slice()).unwrap();
    // OpenSSL asn1parse locates TBS at [4,233) and signature bytes at [243,307).
    let full = certificate.der_bytes();
    let signed = certificate.tbs_der_bytes();
    let signature = certificate.signature_bytes();
    assert_eq(full.len(), 307);
    assert_eq(signed.len(), 229);
    assert_eq(signature.len(), 64);
    for i in 0..full.len() { assert_eq(full[i], der[i]); }
    for i in 0..signed.len() { assert_eq(signed[i], der[4 + i]); }
    for i in 0..signature.len() { assert_eq(signature[i], der[243 + i]); }
    assert_eq(hex_encode(&Sha256.digest(full)), "dd456ffacc4333c4a39c0221461b9bd35d9590314cd0085e9d2f8d3701b0b315");
    assert_eq(hex_encode(&Sha256.digest(signed)), "585b4e910dd04898f80aa8ca2ba981310ddbfdba055a3fb18b0d67a2f61f6060");
    assert_eq(hex_encode(&Sha256.digest(signature)), "0b578dc64a816ff806437e7323554df0ec46580b1ed1e19ed2aa892344e35ca0");
    assert(!certificate.is_ca(), "the leaf must have cA false");
    assert(certificate.matches_hostname(&"verum.invalid"), "the DNS SAN must match verum.invalid");
    assert(!certificate.matches_hostname(&"different.invalid"), "the DNS SAN must reject different.invalid");
    assert(certificate.allows_server_auth(), "the leaf EKU must allow serverAuth");
    let (first, last) = certificate.validity_unix_bounds();
    assert_eq(first, 1793741248_i64);
    assert_eq(last, 1793914048_i64);
    // In this certificate the outer signature AlgorithmIdentifier starts
    // immediately before the 64-byte, byte-aligned signature BIT STRING.
    let outer_oid_end = der.len() - 68;
    assert_eq(der[outer_oid_end], 0x70_u8);
    let mut different_algorithm = der.clone();
    different_algorithm[outer_oid_end] = 0x71_u8;
    assert(parse_certificate(different_algorithm.as_slice()).is_err(), "the outer Ed448 OID must disagree with the inner Ed25519 OID");
    der.push(0_u8);
    assert(parse_certificate(der.as_slice()).is_err(), "the certificate reader must reject trailing bytes");
}

@test
fn test_ca_constraints_come_from_the_decoded_certificate() {
    let der = root_der();
    let certificate = parse_certificate(der.as_slice()).unwrap();
    assert(certificate.is_ca());
    assert(certificate.path_len_constraint().is_none());
    assert(!certificate.matches_hostname(&"verum.invalid"));
}

@test
fn test_candidates_identity_and_ocsp_request_use_the_parsed_certificate() {
    let leaf = parse_certificate(leaf_der().as_slice()).unwrap();
    let root_bytes = root_der();
    let root = parse_certificate(root_bytes.as_slice()).unwrap();
    let trust = TrustStore.from_der(&[root_bytes]).unwrap();
    let candidate = build_best_path(&leaf, &[], &trust).unwrap();
    let path = candidate_path_to_list(&candidate);
    assert_eq(path.len(), 2);
    assert_eq(hex_encode(path[0].der_bytes()), hex_encode(leaf.der_bytes()));
    assert_eq(hex_encode(path[1].der_bytes()), hex_encode(root.der_bytes()));
    assert(build_paths(&leaf, &[], &TrustStore.empty()).is_err());
    assert(verify_server_identity(&path[0], &"verum.invalid").is_ok());
    assert(verify_server_identity(&path[0], &"wrong.invalid").is_err());
    assert(verify_server_identity(&path[0], &"192.0.2.1") is Result.Err(ServerIdentityError.IpLiteralRequiresIpSan));

    // Independently encoded with openssl ocsp -issuer root.pem -cert leaf.pem -no_nonce.
    let sha1_request = build_ocsp_request(&leaf, &root, CertIdHash.Sha1Hash);
    assert_eq(hex_encode(sha1_request.as_slice()), "30423040303e303c303a300906052b0e03021a0500041495fdc96671f5085b4651746e3dfa63597d446e7c04140aeaf45470c1125bfeec295056a260b4ce98d8e0020102");
    let sha256_request = build_ocsp_request(&leaf, &root, CertIdHash.Sha256Hash);
    assert_eq(hex_encode(sha256_request.as_slice()), "305e305c305a30583056300d060960864801650304020105000420e4d5750192ef1826aef5fd2112f481af08b3d41417a381fb1e9a459cf33c4f100420c70a8dcf77db9a729d512119347c07cf4bcce4a30cc640a2db661c71bd592fa5020102");
}

fn main() {}
