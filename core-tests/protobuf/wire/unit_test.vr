// =============================================================================
// core-tests/protobuf/wire/unit_test.vr
// =============================================================================
//
// `core/protobuf/wire.vr` — Protocol Buffers wire format (proto3 v3
// canonical encoding).  Tag (field_number, wire_type) coding + varint
// encode/decode + ProtobufCursor for reader state.
//
// Surface tested here (pure-data subset):
//   * WireType 4-variant (Varint / Fixed64 / LengthDelim / Fixed32)
//   * .to_u8 canonical wire-tag values (proto3 spec table)
//   * tag_value (field_number << 3 | wire_type)
//   * MAX_LENGTH_DELIM constant (32 MiB DoS guard)
//
// THE DEFERRAL ABOVE WAS RE-MEASURED 2026-09-12 AND LIFTED.  This header
// used to read "write_varint / read_varint / write_tag tests would require
// either a Result chain or a List<Byte> buffer round-trip — both hit
// cross-module record-return defects. Integration tests deferred."  Both
// work now, at Tier 0, across the module boundary: `write_varint(&mut b,
// 300)` gives [172, 2], `read_varint(&b, 0)` returns `Result.Ok((300, 2))`
// with tuple-field access, and `write_tag(1, Varint)` gives [8].
//
// The deferral had a cost.  While the buffer surface went untested,
// `write_float32` and `write_float64` called an `@intrinsic` key the
// registry never carried, so encoding ANY float or double aborted the
// process — and no test in this file could see it.  Sections 5-7 below
// exist so that cannot recur silently.
// =============================================================================

mount core.protobuf.wire.{WireType, MAX_LENGTH_DELIM, tag_value,
                        write_varint, read_varint, write_tag,
                        write_fixed32, write_fixed64,
                        write_float32, write_float64,
                        write_string, write_fixed64 as wf64,
                        ProtobufCursor};
mount core.protobuf.error.{ProtobufError};

// =============================================================================
// Section 1: WireType 4-variant
// =============================================================================

@test
fn test_wire_type_varint() {
    let t: WireType = WireType.Varint;
    assert(t is WireType.Varint);
}

@test
fn test_wire_type_fixed64() {
    let t: WireType = WireType.Fixed64;
    assert(t is WireType.Fixed64);
}

@test
fn test_wire_type_length_delim() {
    let t: WireType = WireType.LengthDelim;
    assert(t is WireType.LengthDelim);
}

@test
fn test_wire_type_fixed32() {
    let t: WireType = WireType.Fixed32;
    assert(t is WireType.Fixed32);
}

@test
fn test_wire_type_pairwise_disjoint() {
    let v: WireType = WireType.Varint;
    let f64: WireType = WireType.Fixed64;
    let ld: WireType = WireType.LengthDelim;
    let f32: WireType = WireType.Fixed32;
    assert(v is WireType.Varint && !(v is WireType.Fixed64));
    assert(f64 is WireType.Fixed64 && !(f64 is WireType.LengthDelim));
    assert(ld is WireType.LengthDelim && !(ld is WireType.Fixed32));
    assert(f32 is WireType.Fixed32 && !(f32 is WireType.Varint));
}

// =============================================================================
// Section 2: WireType.to_u8 — canonical proto3 wire-tag values
// =============================================================================
//
// Per https://protobuf.dev/programming-guides/encoding/#structure
//   0 = VARINT          (int32, int64, uint32, uint64, sint32, sint64, bool, enum)
//   1 = I64             (fixed64, sfixed64, double)
//   2 = LEN             (string, bytes, embedded messages, packed repeated)
//   3 = SGROUP          (deprecated, removed from proto3)
//   4 = EGROUP          (deprecated, removed from proto3)
//   5 = I32             (fixed32, sfixed32, float)

@test
fn test_wire_type_varint_canonical_value_0() {
    let v: WireType = WireType.Varint;
    assert(v.to_u8() == 0);
}

@test
fn test_wire_type_fixed64_canonical_value_1() {
    let v: WireType = WireType.Fixed64;
    assert(v.to_u8() == 1);
}

@test
fn test_wire_type_length_delim_canonical_value_2() {
    let v: WireType = WireType.LengthDelim;
    assert(v.to_u8() == 2);
}

@test
fn test_wire_type_fixed32_canonical_value_5() {
    let v: WireType = WireType.Fixed32;
    assert(v.to_u8() == 5);
}

@test
fn test_wire_type_to_u8_all_distinct() {
    assert(WireType.Varint.to_u8() != WireType.Fixed64.to_u8());
    assert(WireType.Fixed64.to_u8() != WireType.LengthDelim.to_u8());
    assert(WireType.LengthDelim.to_u8() != WireType.Fixed32.to_u8());
    assert(WireType.Fixed32.to_u8() != WireType.Varint.to_u8());
}

@test
fn test_wire_type_no_group_codes_in_canonical_set() {
    // SGROUP (3) and EGROUP (4) are deprecated and MUST not be in
    // the canonical set per proto3 spec.
    assert(WireType.Varint.to_u8() != 3);
    assert(WireType.Fixed64.to_u8() != 3);
    assert(WireType.LengthDelim.to_u8() != 3);
    assert(WireType.Fixed32.to_u8() != 3);
    assert(WireType.Varint.to_u8() != 4);
    assert(WireType.Fixed64.to_u8() != 4);
    assert(WireType.LengthDelim.to_u8() != 4);
    assert(WireType.Fixed32.to_u8() != 4);
}

// =============================================================================
// Section 3: tag_value — (field_number << 3) | wire_type
// =============================================================================

@test
fn test_tag_value_field_1_varint() {
    // field_number=1, wire_type=Varint(0) → tag = (1 << 3) | 0 = 8
    let t = tag_value(1, WireType.Varint);
    assert(t == 8);
}

@test
fn test_tag_value_field_1_fixed64() {
    // field_number=1, wire_type=Fixed64(1) → tag = (1 << 3) | 1 = 9
    let t = tag_value(1, WireType.Fixed64);
    assert(t == 9);
}

@test
fn test_tag_value_field_1_length_delim() {
    // field_number=1, wire_type=LengthDelim(2) → tag = (1 << 3) | 2 = 10
    let t = tag_value(1, WireType.LengthDelim);
    assert(t == 10);
}

@test
fn test_tag_value_field_1_fixed32() {
    // field_number=1, wire_type=Fixed32(5) → tag = (1 << 3) | 5 = 13
    let t = tag_value(1, WireType.Fixed32);
    assert(t == 13);
}

@test
fn test_tag_value_field_2_varint() {
    // (2 << 3) | 0 = 16
    let t = tag_value(2, WireType.Varint);
    assert(t == 16);
}

@test
fn test_tag_value_field_15_varint_single_byte_boundary() {
    // field_number=15 is the largest single-byte-encoded field tag
    // for Varint wire type. (15 << 3) | 0 = 120 (fits in 1 varint byte).
    let t = tag_value(15, WireType.Varint);
    assert(t == 120);
}

@test
fn test_tag_value_field_16_varint_two_byte_boundary() {
    // field_number=16 is the first 2-byte-encoded field tag.
    // (16 << 3) | 0 = 128 (requires 2 varint bytes).
    let t = tag_value(16, WireType.Varint);
    assert(t == 128);
}

@test
fn test_tag_value_field_2047_max_two_byte_varint() {
    // field_number=2047 is the largest 2-byte-encoded field tag.
    // (2047 << 3) | 0 = 16376 (< 16384 = 2^14, fits in 2 varint bytes).
    let t = tag_value(2047, WireType.Varint);
    assert(t == 16376);
}

@test
fn test_tag_value_high_field_with_wire_type() {
    // (536870911 << 3) | 5 = max field-number * 8 + Fixed32 wire-type
    // 2^29-1 is the max proto3 field number.
    let t = tag_value(536870911, WireType.Fixed32);
    assert(t == ((536870911 * 8) + 5));
}

// =============================================================================
// Section 4: MAX_LENGTH_DELIM — DoS guard
// =============================================================================

@test
fn test_max_length_delim_is_32mib() {
    // 32 * 1024 * 1024 = 33,554,432
    assert(MAX_LENGTH_DELIM == 33554432);
}

@test
fn test_max_length_delim_positive() {
    // DoS-guard MUST be positive (a zero or negative cap would
    // reject all messages OR accept all messages).
    assert(MAX_LENGTH_DELIM > 0);
}

@test
fn test_max_length_delim_under_int_max() {
    // Sanity: 32 MiB is well under Int32 max (2 GiB) — no overflow risk.
    assert(MAX_LENGTH_DELIM < 2147483647);
}

// =============================================================================
// Section 5: varint — the base 128 encoding every proto3 scalar rides on
// =============================================================================

@test
fn test_write_varint_single_byte() {
    // Anything under 128 is one byte, unchanged.
    let mut b: List<Byte> = List.new();
    write_varint(&mut b, 1_u64);
    assert(b.len() == 1);
    assert(b[0] == 1);
}

@test
fn test_write_varint_two_bytes() {
    // 300 = 0b1_0010_1100 -> low 7 bits with the continuation bit set,
    // then the remaining 2 bits: [0xAC, 0x02]. The canonical example
    // from the proto3 encoding document.
    let mut b: List<Byte> = List.new();
    write_varint(&mut b, 300_u64);
    assert(b.len() == 2);
    assert(b[0] == 172);
    assert(b[1] == 2);
}

@test
fn test_varint_round_trip() {
    // A round trip through the module boundary, which the header of this
    // file once said was impossible.
    let mut b: List<Byte> = List.new();
    write_varint(&mut b, 300_u64);
    match read_varint(&b, 0) {
        Result.Ok(pair) => {
            assert(pair.0 == 300_u64);
            assert(pair.1 == 2);
        }
        Result.Err(_) => { assert(false); }
    }
}

@test
fn test_write_tag_field_one_varint() {
    // (1 << 3) | 0 = 8 — field 1, wire type Varint.
    let mut b: List<Byte> = List.new();
    write_tag(&mut b, 1, WireType.Varint);
    assert(b.len() == 1);
    assert(b[0] == 8);
}

// =============================================================================
// Section 6: fixed-width — little-endian, the control for section 7
// =============================================================================

@test
fn test_write_fixed32_is_little_endian() {
    // 0x3F800000 written low byte first.
    let mut b: List<Byte> = List.new();
    write_fixed32(&mut b, 1065353216_u32);
    assert(b.len() == 4);
    assert(b[0] == 0);
    assert(b[1] == 0);
    assert(b[2] == 128);
    assert(b[3] == 63);
}

@test
fn test_write_fixed64_is_eight_bytes() {
    let mut b: List<Byte> = List.new();
    write_fixed64(&mut b, 1_u64);
    assert(b.len() == 8);
    assert(b[0] == 1);
    assert(b[7] == 0);
}

// =============================================================================
// Section 7: float — the regression pin
// =============================================================================
//
// These two aborted the process until 2026-09-12: both called
// `@intrinsic("verum.float.f32_to_bits" / "...f64_to_bits")`, keys the
// registry has never carried, and an unregistered `@intrinsic` lowers to a
// Panic. The registered names are the bare `f32_to_bits` / `f64_to_bits`.
// A byte assertion, not a "does not panic" assertion: a wrong-width or
// wrong-endian reinterpretation would also not panic.

@test
fn test_write_float32_one_point_zero() {
    // IEEE-754 binary32 for 1.0 is 0x3F800000; proto3 fixed32 is
    // little-endian, so the wire bytes are 00 00 80 3F.
    let mut b: List<Byte> = List.new();
    write_float32(&mut b, 1.0);
    assert(b.len() == 4);
    assert(b[0] == 0);
    assert(b[1] == 0);
    assert(b[2] == 128);
    assert(b[3] == 63);
}

@test
fn test_write_float32_zero() {
    // Positive zero is all-bits-zero in binary32 — the control that
    // separates "reinterpreted correctly" from "returned nothing".
    let mut b: List<Byte> = List.new();
    write_float32(&mut b, 0.0);
    assert(b.len() == 4);
    assert(b[0] == 0);
    assert(b[1] == 0);
    assert(b[2] == 0);
    assert(b[3] == 0);
}

@test
fn test_write_float64_one_point_zero() {
    // IEEE-754 binary64 for 1.0 is 0x3FF0000000000000, little-endian on
    // the wire: the top two bytes are F0 3F and the rest are zero.
    let mut b: List<Byte> = List.new();
    write_float64(&mut b, 1.0);
    assert(b.len() == 8);
    assert(b[0] == 0);
    assert(b[6] == 240);
    assert(b[7] == 63);
}

@test
fn test_write_float64_zero() {
    let mut b: List<Byte> = List.new();
    write_float64(&mut b, 0.0);
    assert(b.len() == 8);
    assert(b[0] == 0);
    assert(b[7] == 0);
}

// =============================================================================
// Section 8: WireType.from_u8 — the Result chain (audit §3.1)
// =============================================================================
//
// Deferred in the audit as "30 min after cross-module fix". Re-measured
// 2026-09-12: the Result chain crosses the module boundary intact, so the
// deferral is spent rather than carried.

@test
fn test_from_u8_accepts_the_four_live_codes() {
    // proto3 keeps 0 / 1 / 2 / 5; 3 and 4 were the proto2 groups.
    match WireType.from_u8(0_u8) {
        Result.Ok(w) => { assert(w is WireType.Varint); }
        Result.Err(_) => { assert(false); }
    }
    match WireType.from_u8(1_u8) {
        Result.Ok(w) => { assert(w is WireType.Fixed64); }
        Result.Err(_) => { assert(false); }
    }
    match WireType.from_u8(2_u8) {
        Result.Ok(w) => { assert(w is WireType.LengthDelim); }
        Result.Err(_) => { assert(false); }
    }
    match WireType.from_u8(5_u8) {
        Result.Ok(w) => { assert(w is WireType.Fixed32); }
        Result.Err(_) => { assert(false); }
    }
}

@test
fn test_from_u8_refuses_the_proto2_groups() {
    // Wire types 3 and 4 are SGROUP / EGROUP, removed in proto3. They get
    // their OWN error, not the catch-all — a decoder needs to tell "this is
    // old proto2" from "this is not protobuf at all".
    match WireType.from_u8(3_u8) {
        Result.Ok(_) => { assert(false); }
        Result.Err(e) => { assert(e is ProtobufError.UnsupportedGroup); }
    }
    match WireType.from_u8(4_u8) {
        Result.Ok(_) => { assert(false); }
        Result.Err(e) => { assert(e is ProtobufError.UnsupportedGroup); }
    }
}

@test
fn test_from_u8_refuses_codes_above_the_table() {
    // 6 and 7 fit in the three tag bits and mean nothing; 255 does not.
    match WireType.from_u8(6_u8) {
        Result.Ok(_) => { assert(false); }
        Result.Err(_) => { assert(true); }
    }
    match WireType.from_u8(7_u8) {
        Result.Ok(_) => { assert(false); }
        Result.Err(_) => { assert(true); }
    }
    match WireType.from_u8(255_u8) {
        Result.Ok(_) => { assert(false); }
        Result.Err(_) => { assert(true); }
    }
}

// =============================================================================
// Section 9: varint length boundaries (audit §3.2)
// =============================================================================

@test
fn test_varint_length_at_127_and_128() {
    // 127 is the largest one-byte varint; 128 is the first two-byte one.
    let mut a: List<Byte> = List.new();
    write_varint(&mut a, 127_u64);
    assert(a.len() == 1);
    let mut b: List<Byte> = List.new();
    write_varint(&mut b, 128_u64);
    assert(b.len() == 2);
}

@test
fn test_varint_zero_is_one_byte() {
    // Zero does NOT encode as the empty string — a decoder that reads a
    // zero-length field would desynchronise the whole stream.
    let mut b: List<Byte> = List.new();
    write_varint(&mut b, 0_u64);
    assert(b.len() == 1);
    assert(b[0] == 0);
}

// =============================================================================
// Section 10: ProtobufCursor — the reader state machine (audit §3.3)
// =============================================================================
//
// Deferred in the audit as "2 h, same defect class". The defect class is
// gone; the cursor reads a tag written by this same module below.

@test
fn test_cursor_reads_back_a_written_tag() {
    let mut b: List<Byte> = List.new();
    write_tag(&mut b, 1, WireType.Varint);
    write_varint(&mut b, 300_u64);
    let mut c = ProtobufCursor.new(&b);
    match c.read_tag() {
        Result.Ok(pair) => {
            assert(pair.0 == 1_u32);
            assert(pair.1 is WireType.Varint);
        }
        Result.Err(_) => { assert(false); }
    }
}

@test
fn test_cursor_reads_a_high_field_number() {
    // Field 16 is the first that needs two bytes of tag — the boundary a
    // hand-rolled cursor gets wrong.
    let mut b: List<Byte> = List.new();
    write_tag(&mut b, 16, WireType.Fixed32);
    let mut c = ProtobufCursor.new(&b);
    match c.read_tag() {
        Result.Ok(pair) => {
            assert(pair.0 == 16_u32);
            assert(pair.1 is WireType.Fixed32);
        }
        Result.Err(_) => { assert(false); }
    }
}

@test
fn test_cursor_on_an_empty_buffer_refuses() {
    // A cursor over nothing must report, not read past the end.
    let b: List<Byte> = List.new();
    let mut c = ProtobufCursor.new(&b);
    match c.read_tag() {
        Result.Ok(_) => { assert(false); }
        Result.Err(_) => { assert(true); }
    }
}

// =============================================================================
// Section 11: a whole message through the cursor (audit §3.3, second half)
// =============================================================================
//
// The single-tag reads above prove the cursor starts correctly. This walks
// three fields of three different wire types to the end and asks `at_end`
// at both ends of the walk — the shape `stdlib/protobuf` documents, and
// the four methods `check-doc-methods-exercised` recorded as called by
// nothing that runs: `at_end`, `read_varint`, `read_string`,
// `read_fixed64`.

@test
fn test_cursor_walks_three_fields_to_the_end() {
    let mut b: List<Byte> = List.new();
    write_tag(&mut b, 1, WireType.Varint);
    write_varint(&mut b, 300_u64);
    write_tag(&mut b, 2, WireType.LengthDelim);
    write_string(&mut b, &"hi");
    write_tag(&mut b, 3, WireType.Fixed64);
    wf64(&mut b, 7_u64);

    let mut c = ProtobufCursor.new(&b);
    assert(!c.at_end());

    match c.read_tag() {
        Result.Ok(p) => { assert(p.0 == 1_u32); }
        Result.Err(_) => { assert(false); }
    }
    match c.read_varint() {
        Result.Ok(v) => { assert(v == 300_u64); }
        Result.Err(_) => { assert(false); }
    }
    match c.read_tag() {
        Result.Ok(p) => { assert(p.0 == 2_u32); }
        Result.Err(_) => { assert(false); }
    }
    match c.read_string() {
        Result.Ok(s) => { assert(s == "hi"); }
        Result.Err(_) => { assert(false); }
    }
    match c.read_tag() {
        Result.Ok(p) => { assert(p.0 == 3_u32); }
        Result.Err(_) => { assert(false); }
    }
    match c.read_fixed64() {
        Result.Ok(v) => { assert(v == 7_u64); }
        Result.Err(_) => { assert(false); }
    }

    // THE END CONDITION IS THE POINT. A cursor that reads the right values
    // and never reports the end would loop forever in the `while
    // !cursor.at_end()` form the reference documents.
    assert(c.at_end());
}
