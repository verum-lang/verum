// =============================================================================
// core-tests/io/async_protocols/integration_test.vr
// =============================================================================

mount core.async.io_protocols.{AsyncWrite, WriteFuture, read_async, write_async, flush_async};
mount core.async.poll.Poll;
mount core.async.waker.{Context, noop_waker};
mount core.io.protocols.{IoResult, IoErrorKind};
mount core.io.protocols.{empty_reader, sink};
mount core.collections.list.List;

// =============================================================================
// §1 — Free factories produce Future values
// =============================================================================

@test
fn integration_read_async_returns_read_future() {
    let r = empty_reader();
    let buf: List<Byte> = List.new();
    let _f = read_async(r, buf);
}

@test
fn integration_write_async_returns_write_future() {
    let w = sink();
    let buf: List<Byte> = List.new();
    let _f = write_async(w, buf);
}

@test
fn integration_flush_async_returns_flush_future() {
    let w = sink();
    let _f = flush_async(w);
}

type CountWriter is { count: Int };

implement AsyncWrite for CountWriter {
    fn poll_write(&mut self, _cx: &mut Context, _bytes: &List<Byte>) -> Poll<IoResult<Int>> {
        Poll.Ready(Result.Ok(self.count))
    }
    fn poll_flush(&mut self, _cx: &mut Context) -> Poll<IoResult<()>> { Poll.Ready(Result.Ok(())) }
    fn poll_shutdown(&mut self, _cx: &mut Context) -> Poll<IoResult<()>> { Poll.Ready(Result.Ok(())) }
}

@test
fn write_future_requires_exact_forward_progress() {
    let waker = noop_waker();
    let mut cx = Context.from_waker(&waker);
    let mut bytes: List<Byte> = List.new();
    bytes.push(31);
    bytes.push(32);

    let mut short = WriteFuture.new(CountWriter { count: 1 }, bytes.clone());
    assert(match short.poll(&mut cx) { Poll.Pending => true, _ => false });
    assert(match short.poll(&mut cx) { Poll.Ready(Result.Ok(2)) => true, _ => false });

    let mut zero = WriteFuture.new(CountWriter { count: 0 }, bytes.clone());
    assert(match zero.poll(&mut cx) {
        Poll.Ready(Result.Err(error)) => error.kind == IoErrorKind.WriteZero,
        _ => false,
    });
    for n in [-1, 3] {
        let mut invalid = WriteFuture.new(CountWriter { count: n }, bytes.clone());
        assert(match invalid.poll(&mut cx) {
            Poll.Ready(Result.Err(error)) => error.kind == IoErrorKind.InvalidData,
            _ => false,
        });
    }
}

fn main() {}
