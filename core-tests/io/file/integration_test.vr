// =============================================================================
// core-tests/io/file/integration_test.vr
// =============================================================================
//
// File opening modes and asynchronous ownership across the system boundary.
// =============================================================================

mount core.io.file.{AsyncFile, File, OpenOptions, O_RDONLY, O_WRONLY, O_CREAT};
mount core.collections.list.List;
mount core.io.protocols.StreamError;

// =============================================================================
// §1 — OpenOptions can be configured for read-only access pattern
// =============================================================================

@test
fn integration_open_options_read_only_pattern() {
    let mut opts = OpenOptions.new();
    let _ = opts.read(true);
    // No actual open — would require a real file.
}

@test
fn integration_open_options_write_create_truncate_pattern() {
    let mut opts = OpenOptions.new();
    let _ = opts.write(true);
    let _ = opts.create(true);
    let _ = opts.truncate(true);
}

// =============================================================================
// §2 — O_* constants compose via OR
// =============================================================================

@test
fn integration_open_flag_or_composition() {
    let combined = O_WRONLY | O_CREAT;
    assert(combined != O_WRONLY);
    assert(combined != O_CREAT);
    // Both bits set
    assert_eq(combined & O_WRONLY, O_WRONLY);
    assert_eq(combined & O_CREAT, O_CREAT);
}

@test
fn integration_o_rdonly_or_nothing_is_rdonly() {
    // O_RDONLY is 0, so OR doesn't add anything to it.
    let combined = O_RDONLY | O_CREAT;
    assert_eq(combined, O_CREAT);
}

@cfg(unix)
async fn exercise_async_handles(path: &Text) -> Result<(), StreamError> {
    let mut buf: [Byte; 1] = [0_u8];
    let mut read_file = AsyncFile.open(path).await?;
    assert(read_file.read(&mut buf[..]).await? == 0);

    let mut write_file = AsyncFile.create(path).await?;
    assert(write_file.write(&buf[..]).await? == 1);

    let mut options = OpenOptions.new();
    let _ = options.write(true);
    let mut configured = AsyncFile.open_with_options(path, &options).await?;
    assert(configured.write(&buf[..]).await? == 1);
    Result.Ok(())
}

@cfg(unix)
@test
async fn asynchronous_constructors_return_live_handles() {
    let result: Result<(), StreamError> = exercise_async_handles(&"/dev/null").await;
    assert(result.is_ok());
}

fn main() {}
