// =============================================================================
// core-tests/metrics/value/unit_test.vr
// =============================================================================
//
// `core/metrics/value.vr` — `AtomicF64`, a lock-free float cell built on
// an `AtomicU64` holding the IEEE 754 bit pattern.
//
// THIS FILE WAS ENTIRELY RED AND HAD BEEN FOR SOME TIME, measured
// 2026-09-12: 0 of 6 passed, the suite failing to compile with fourteen
// errors. Every test built the record by hand —
//
//     let a: AtomicF64 = AtomicF64 { bits: 0_u64 };
//     assert_eq(a.bits, 0_u64);
//
// — against a `bits` field that is an `AtomicU64`, not a `UInt64`, and
// that is not public. The library changed shape and the tests were never
// re-run. They also asserted nothing about `AtomicF64`: a record literal
// returning the field it was given is a property of record literals.
//
// The rewrite keeps what the old tests were reaching for — the IEEE 754
// patterns for 0.0, 2.0, -0.0 and NaN — and reaches it through the public
// surface, which is the only surface a caller has: `new`, `load`,
// `store`, `fetch_add`, `fetch_sub`.
//
// `fetch_add` is also where A118 lived: its CAS retry loop called
// `AtomicU64.compare_exchange_weak`, a spelling `core/sync/atomic.vr` did
// not declare, so every float-accumulating metric — `Counter.inc()`,
// `Histogram.observe()` — ended with `method not found` while every READ
// answered correctly. Construction tests cannot see that; these do.
// =============================================================================

mount core.metrics.value.AtomicF64;
mount core.sync.atomic.{MemoryOrdering};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: round-tripping a value through the bit encoding
// =============================================================================

@test
fn test_atomic_f64_round_trips_zero() {
    let a = AtomicF64.new(0.0);
    assert(a.load(MemoryOrdering.Relaxed) == 0.0);
}

@test
fn test_atomic_f64_round_trips_two() {
    // 2.0 is 0x4000000000000000 as an IEEE 754 double — the pattern the
    // previous version of this test spelled out by hand.
    let a = AtomicF64.new(2.0);
    assert(a.load(MemoryOrdering.Relaxed) == 2.0);
}

@test
fn test_atomic_f64_round_trips_negative_zero() {
    // -0.0 is 0x8000000000000000: the sign bit and nothing else. It
    // compares EQUAL to 0.0 under IEEE 754, so equality cannot tell them
    // apart — dividing into it can, and that is the point of keeping the
    // sign through the encoding.
    let a = AtomicF64.new(-0.0);
    let v = a.load(MemoryOrdering.Relaxed);
    assert(v == 0.0);
    assert(1.0 / v < 0.0);
}

@test
fn test_atomic_f64_round_trips_a_large_magnitude() {
    let a = AtomicF64.new(1.0e300);
    assert(a.load(MemoryOrdering.Relaxed) == 1.0e300);
}

// =============================================================================
// Section 2: store replaces, and the cell is independent per instance
// =============================================================================

@test
fn test_atomic_f64_store_replaces_the_value() {
    let a = AtomicF64.new(1.0);
    a.store(7.5, MemoryOrdering.Relaxed);
    assert(a.load(MemoryOrdering.Relaxed) == 7.5);
}

@test
fn test_atomic_f64_two_cells_are_independent() {
    // What the old `field_independence` test was after, through the
    // public surface: writing one must not move the other.
    let a = AtomicF64.new(1.0);
    let b = AtomicF64.new(2.0);
    a.store(99.0, MemoryOrdering.Relaxed);
    assert(a.load(MemoryOrdering.Relaxed) == 99.0);
    assert(b.load(MemoryOrdering.Relaxed) == 2.0);
}

// =============================================================================
// Section 3: fetch_add — the CAS retry loop (A118)
// =============================================================================

@test
fn test_atomic_f64_fetch_add_returns_the_previous_value() {
    // The PREVIOUS value is the contract, not the new one.
    let a = AtomicF64.new(1.0);
    let prev = a.fetch_add(2.0, MemoryOrdering.Relaxed);
    assert(prev == 1.0);
    assert(a.load(MemoryOrdering.Relaxed) == 3.0);
}

@test
fn test_atomic_f64_fetch_add_is_repeatable() {
    // Two adds in a row. A loop that swallowed its second iteration would
    // pass the single-add test and fail here.
    let a = AtomicF64.new(0.0);
    let _ = a.fetch_add(1.5, MemoryOrdering.Relaxed);
    let _ = a.fetch_add(2.5, MemoryOrdering.Relaxed);
    assert(a.load(MemoryOrdering.Relaxed) == 4.0);
}

@test
fn test_atomic_f64_fetch_sub_is_fetch_add_negated() {
    let a = AtomicF64.new(10.0);
    let prev = a.fetch_sub(4.0, MemoryOrdering.Relaxed);
    assert(prev == 10.0);
    assert(a.load(MemoryOrdering.Relaxed) == 6.0);
}

fn main() {}
