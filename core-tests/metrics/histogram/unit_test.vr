// =============================================================================
// core-tests/metrics/histogram/unit_test.vr
// =============================================================================
//
// `core/metrics/histogram.vr` — Prometheus-style histograms.
// =============================================================================

mount core.metrics.histogram.{HistogramBuckets, Histogram};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: HistogramBuckets record construction
// =============================================================================

@test
fn test_histogram_buckets_empty_bounds() {
    let empty: List<Float> = [];
    let b: HistogramBuckets = HistogramBuckets { bounds: empty };
    assert_eq(b.bounds.len(), 0);
}

@test
fn test_histogram_buckets_single_bound() {
    let mut bounds: List<Float> = [];
    bounds.push(1.0);
    let b: HistogramBuckets = HistogramBuckets { bounds: bounds };
    assert_eq(b.bounds.len(), 1);
    assert_eq(b.bounds[0], 1.0);
}

@test
fn test_histogram_buckets_canonical_prometheus_default() {
    // Prometheus default 11-bucket distribution: HTTP-latency canonical.
    let mut bounds: List<Float> = [];
    bounds.push(0.005);
    bounds.push(0.01);
    bounds.push(0.025);
    bounds.push(0.05);
    bounds.push(0.1);
    bounds.push(0.25);
    bounds.push(0.5);
    bounds.push(1.0);
    bounds.push(2.5);
    bounds.push(5.0);
    bounds.push(10.0);
    let b: HistogramBuckets = HistogramBuckets { bounds: bounds };
    assert_eq(b.bounds.len(), 11);
    assert_eq(b.bounds[0], 0.005);
    assert_eq(b.bounds[10], 10.0);
}

@test
fn test_histogram_buckets_field_independence() {
    let empty1: List<Float> = [];
    let mut nonempty: List<Float> = [];
    nonempty.push(1.0);
    nonempty.push(2.0);
    let a: HistogramBuckets = HistogramBuckets { bounds: empty1 };
    let b: HistogramBuckets = HistogramBuckets { bounds: nonempty };
    assert_eq(a.bounds.len(), 0);
    assert_eq(b.bounds.len(), 2);
}

// =============================================================================
// observe — the operation the histogram exists for (A118)
// =============================================================================
//
// Everything above pins bucket LAYOUT. Nothing recorded a sample, so
// `observe` was on the repository's unexercised-methods roster — and it
// was broken: it ends in `AtomicF64.fetch_add`, whose CAS retry loop
// called `AtomicU64.compare_exchange_weak`, a spelling `core/sync/atomic.vr`
// did not declare. Measured 2026-09-12: `Histogram.observe(5.0)` answered
// `Panic: method 'AtomicU64.compare_exchange_weak' not found`.
//
// The reads were fine throughout, which is why nothing noticed: a fresh
// histogram's snapshot answers 0 whether or not `observe` works.

@test
fn test_histogram_counts_and_sums_what_it_observes() {
    let b = HistogramBuckets.linear(0.0, 10.0, 5);
    let h = Histogram.new(b);

    let empty = h.snapshot();
    assert(empty.count() == 0_u64);

    h.observe(5.0);
    h.observe(15.0);
    h.observe(25.0);

    let s = h.snapshot();
    // BOTH numbers, not just the count: a sum that stayed at zero while
    // the count moved would mean the float accumulator silently dropped
    // every sample, which is exactly the failure mode this pins.
    assert(s.count() == 3_u64);
    assert(s.sum() == 45.0);
}

fn main() {}
