// =============================================================================
// core-tests/metrics/ewma/unit_test.vr
// =============================================================================
//
// `core/metrics/ewma.vr` — Exponentially Weighted Moving Average.
// =============================================================================

mount core.metrics.ewma.{LOAD_AVG_1, LOAD_AVG_5, LOAD_AVG_15, RateMeter};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: Linux load-average decay constants
//
//   Standard Linux `loadavg(5)` decay constants — exp(-5/60) per minute
//   for 1-minute, exp(-5/300) for 5-minute, exp(-5/900) for 15-minute.
//   Pinned at the canonical 4-decimal-place IEEE 754 values used by
//   Linux kernel (kernel/sched/loadavg.c).
// =============================================================================

@test
fn test_load_avg_1_canonical_value() {
    assert_eq(LOAD_AVG_1, 0.9200);
}

@test
fn test_load_avg_5_canonical_value() {
    assert_eq(LOAD_AVG_5, 0.9835);
}

@test
fn test_load_avg_15_canonical_value() {
    assert_eq(LOAD_AVG_15, 0.9945);
}

// =============================================================================
// Section 2: Width invariants
//
//   Decay constants strictly grow with the window — a 15-minute
//   average decays slowest, 1-minute fastest.
// =============================================================================

@test
fn test_load_avg_ordering_1_lt_5_lt_15() {
    // The 1-minute decay constant is smallest (most-aggressive decay).
    assert(LOAD_AVG_1 < LOAD_AVG_5);
    assert(LOAD_AVG_5 < LOAD_AVG_15);
}

@test
fn test_load_avg_all_below_one() {
    // Decay constants must be < 1.0 — otherwise the moving average
    // would never converge.
    assert(LOAD_AVG_1 < 1.0);
    assert(LOAD_AVG_5 < 1.0);
    assert(LOAD_AVG_15 < 1.0);
}

@test
fn test_load_avg_all_positive() {
    assert(LOAD_AVG_1 > 0.0);
    assert(LOAD_AVG_5 > 0.0);
    assert(LOAD_AVG_15 > 0.0);
}

@test
fn test_load_avg_15_closest_to_one() {
    // 15-minute window is closest to 1.0 — it weights history most.
    let to_one_1 = 1.0 - LOAD_AVG_1;
    let to_one_15 = 1.0 - LOAD_AVG_15;
    assert(to_one_15 < to_one_1);
}

// =============================================================================
// RateMeter — the surface that COUNTS, not just the constants
// =============================================================================
//
// The tests above pin the decay constants. Nothing in this folder called
// `mark` or read a rate, so the meter's behaviour was untested while its
// arithmetic was pinned — and `check-doc-methods-exercised` listed
// `mark`, `one_minute_rate`, `five_minute_rate` and
// `fifteen_minute_rate` as called by nothing that runs.
//
// The rates stay at zero here ON PURPOSE, and that is the assertion.
// `mark` ticks only once the sample period has elapsed, and the period
// defaults to five seconds (the Dropwizard default), so a test that runs
// in milliseconds must see zero. A non-zero rate here would mean the
// meter had invented a sample it never took.

@test
fn test_rate_meter_counts_every_marked_event() {
    let mut m = RateMeter.new();
    assert(m.count() == 0_u64);
    m.mark(5_u64);
    assert(m.count() == 5_u64);
    m.mark(3_u64);
    assert(m.count() == 8_u64);
}

@test
fn test_rate_meter_reports_zero_before_the_first_tick() {
    // Five seconds have not passed, so no sample exists yet. Zero is the
    // right answer; anything else is a rate over a period that never ran.
    let mut m = RateMeter.new();
    assert(m.one_minute_rate() == 0.0);
    m.mark(100_u64);
    assert(m.one_minute_rate() == 0.0);
    assert(m.five_minute_rate() == 0.0);
    assert(m.fifteen_minute_rate() == 0.0);
    // …and the count still moved, which separates "the meter is inert"
    // from "the meter has not sampled yet".
    assert(m.count() == 100_u64);
}

fn main() {}
