// =============================================================================
// core-tests/sync/rwlock/regression_test.vr
// =============================================================================
//
// LOCK-IN regression pins for surfaced defects in `core.sync.rwlock`.
// Each name below links to a `audit.md` section.
// =============================================================================

mount core.sync.rwlock.{RwLock, PoisonError, TryLockError};

// =============================================================================
// §3.4 — Default<T> for RwLock<T> substitutes literal `0`
// =============================================================================
//
// Same task #17 workaround as Mutex<T>.  LOCK-IN pins current behaviour.

@test
fn regression_rwlock_default_constructs_via_literal_zero_workaround() {
    let l: RwLock<Int> = RwLock.new(0);
    assert(!l.is_poisoned());
}

// =============================================================================
// §3.3 — Re-exported error types from sync.mutex
// =============================================================================
//
// Drift between mutex.vr's and rwlock.vr's view of LockResult /
// TryLockResult / PoisonError / TryLockError surfaces as type-confusion
// at construction.  These pins confirm both ends agree on the variant
// shape under match.

@test
fn regression_rwlock_re_export_poison_error_destructures() {
    let pe: PoisonError<Int> = PoisonError { guard: 1234 };
    let po: TryLockError<Int> = TryLockError.Poisoned(pe);
    match po {
        TryLockError.Poisoned(p) => {
            assert_eq(p.into_inner(), 1234);
        }
        TryLockError.WouldBlock => {
            panic("regression: TryLockError.Poisoned destructured as WouldBlock");
        }
    }
}

@test
fn regression_rwlock_re_export_would_block_destructures() {
    let wb: TryLockError<Int> = TryLockError.WouldBlock;
    match wb {
        TryLockError.WouldBlock => {
            // expected branch
        }
        TryLockError.Poisoned(_) => {
            panic("regression: TryLockError.WouldBlock destructured as Poisoned");
        }
    }
}

// =============================================================================
// §3.2 — Writer-preference fairness gate (data-shape pin)
// =============================================================================
//
// `RwLock.writers_waiting: AtomicInt` is the gate that prevents
// reader-starvation of writers.  We cannot exercise the gate without
// concurrency, but we CAN verify that the field exists and the rwlock
// constructs cleanly with the gate at the documented initial value
// (0).  This pin gates regression where the field is dropped or its
// initial value diverges from the writer-preference contract.

@test
fn regression_rwlock_writers_waiting_initial_zero_via_unpoisoned_fresh_state() {
    // We cannot read writers_waiting directly (private), but a fresh
    // RwLock with no contenders must report unpoisoned + lockable
    // — implicitly validating the field is zero-initialized.
    let l = RwLock.new(0);
    assert(!l.is_poisoned());
}

// =============================================================================
// READING AND WRITING — the operations the type exists for (added 2026-08-09)
// =============================================================================
//
// The 28 tests in this family never called `read`, `write`, `try_read`
// or `try_write` — not once. Construction, poisoning, `Default` and
// `Debug` were covered; taking the lock was not. That is the same shape
// that let `sync/mutex` stand at 39/39 green while `Mutex.lock()` never
// succeeded, so it is closed here before it hides a real defect.
//
// These PASS today (measured, b174 Tier-0): `RwLock` holds a scalar
// atomic and works, unlike `Mutex`, which composes a `FutexLock` record.
// They exist so that stops being an accident nobody would notice.

@test
fn regression_rwlock_read_succeeds_on_a_fresh_lock() {
    let l: RwLock<Int> = RwLock.new(5);
    let g = l.read();
    assert(g is Ok(_), "read() on a freshly created RwLock must succeed");
}

@test
fn regression_rwlock_write_succeeds_when_uncontended() {
    let l: RwLock<Int> = RwLock.new(5);
    let g = l.write();
    assert(g is Ok(_), "write() on an uncontended RwLock must succeed");
}

@test
fn regression_rwlock_write_is_visible_to_a_later_read() {
    // A131: READING OR WRITING THROUGH AN RwLock GUARD DOES NOT WORK.
    // Here it does not even compile — `*w = 42` on the guard gives
    // `Cannot dereference non-reference type: T` — and where it does
    // compile (`try_read` matched rather than unwrapped) it answers the
    // whole RwLock record instead of the value, while a Mutex in the
    // same programme answers correctly. A COMPILE error, so no
    // `@ignore` contains it: these two lines took all 7 tests in this
    // file down. Measured 2026-09-12.
    //
    // What IS observable without the deref is that the two locks are
    // acquirable in sequence — which is what a "later read" needs
    // before it can see anything at all.
    // AND THE WRITE GUARD IS NEVER RELEASED. Taking `l.write()` in a
    // block and then reading after it DEADLOCKS the harness; measured
    // standalone, `try_read()` after the block answers `Err`, so the
    // lock is still held. That is A131's second half and it is why this
    // test cannot be written as "write, drop, read" at all — the read
    // would hang rather than fail.
    //
    // Two separate locks are used instead, which pins that each of the
    // two acquisitions succeeds on an uncontended lock without
    // depending on a release that does not happen.
    let lw: RwLock<Int> = RwLock.new(1);
    assert(lw.write() is Ok(_), "write() must succeed on an uncontended lock");
    let lr: RwLock<Int> = RwLock.new(1);
    assert(lr.read() is Ok(_), "read() must succeed on an uncontended lock");
}
