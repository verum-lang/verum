// =============================================================================
// core-tests/verify/kernel_v0/soundness/unit_test.vr
// =============================================================================
//
// `core/verify/kernel_v0/soundness.vr` —
//   * LemmaStatus 3-variant ADT
//     | Proved
//     | Admitted { iou }
//     | DischargedByFramework { lemma_path, framework, citation }
// =============================================================================

// Braced (A137): the brace-less form binds the name but refuses the
// variant path through it.
// NOT ONE `let s: LemmaStatus = …` ANNOTATION SURVIVES HERE, AND THAT IS
// THE WORK-AROUND.
//
// `LemmaStatus` is declared twice in `core/` — `kernel_v0/soundness.vr:107`
// with `Admitted { iou: Text }` and `kernel_soundness/theorems.vr:125` with
// `Admitted { reason: Text }` — and the two POSITIONS of one statement
// resolve to DIFFERENT declarations. `let s: LemmaStatus = LemmaStatus.Proved;`
// is refused with `expected '{ iou: Text }', found '{ reason: Text }'` on a
// UNIT variant, while the identical line without the annotation compiles and
// passes. Measured 2026-09-12 with the three spellings side by side. A120.
mount core.verify.kernel_v0.soundness.{LemmaStatus};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: LemmaStatus 3-variant construction
// =============================================================================

@test
fn test_lemma_status_proved_variant() {
    let s = LemmaStatus.Proved;
    assert(s is LemmaStatus.Proved);
}

@test
fn test_lemma_status_admitted_variant() {
    let s = LemmaStatus.Admitted {
        iou: "TODO: complete proof of well-founded induction".to_text(),
    };
    assert(s is LemmaStatus.Admitted);
}

@test
fn test_lemma_status_discharged_by_framework_variant() {
    let s = LemmaStatus.DischargedByFramework {
        lemma_path: "kernel_v0/lemmas/wf_induction.vr".to_text(),
        framework: "mathlib4".to_text(),
        citation: "Mathlib.Order.WellFoundedSet".to_text(),
    };
    assert(s is LemmaStatus.DischargedByFramework);
}

// =============================================================================
// Section 2: Pairwise disjointness
// =============================================================================

@test
fn test_lemma_status_proved_disjoint() {
    let s = LemmaStatus.Proved;
    assert(!(s is LemmaStatus.Admitted));
    assert(!(s is LemmaStatus.DischargedByFramework));
}

@test
fn test_lemma_status_admitted_disjoint() {
    let s = LemmaStatus.Admitted { iou: "x".to_text() };
    assert(!(s is LemmaStatus.Proved));
    assert(!(s is LemmaStatus.DischargedByFramework));
}

@test
fn test_lemma_status_discharged_by_framework_disjoint() {
    let s = LemmaStatus.DischargedByFramework {
        lemma_path: "x".to_text(),
        framework: "y".to_text(),
        citation: "z".to_text(),
    };
    assert(!(s is LemmaStatus.Proved));
    assert(!(s is LemmaStatus.Admitted));
}

fn main() {}
