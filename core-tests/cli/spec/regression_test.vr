mount core.cli.spec.{ArgSpec, CommandSpec, FlagSpec};
mount core.cli.builder.AppBuilder;
mount core.cli.parser.{
    arg, flag, many, optional, parse_argv, ArgParser, FlagParser,
    Parser, ParserDescription, ParseStep,
};
mount core.cli.error.{ParseError, ParseErrorKind};
mount core.base.maybe.Maybe;
mount core.collections.List;
mount core.text.Text;
mount core.base.result.Result;

@test
fn test_command_lookup_returns_the_declared_subcommand_for_its_alias() {
    let leaf = CommandSpec.new("inspect", "Inspect inputs");
    let build = AppBuilder.new("build", "Build inputs").alias("b").subcommand(leaf).build();
    let root = CommandSpec.new("tool", "Tool").add_subcommand(build);
    for name in ["build", "b"] {
        let selected = root.find_subcommand(&name).unwrap();
        assert(selected.find_subcommand(&"inspect").is_some());
    }
    assert(root.find_subcommand(&"inspect").is_none());
    assert(root.find_subcommand(&"missing").is_none());
}

@test
fn test_nested_command_counter_accepts_repeated_switches() {
    let flag = FlagSpec.value("verbose", "Increase verbosity").short('v').counter();
    let inspect = CommandSpec.new("inspect", "Inspect inputs").add_flag(flag);
    let report = CommandSpec.new("report", "Report commands").add_subcommand(inspect);

    let mut argv: List<Text> = List.new();
    argv.push("report".to_text());
    argv.push("inspect".to_text());
    argv.push("-vv".to_text());
    argv.push("--verbose".to_text());
    assert(parse_argv(&report, argv) is Result.Ok);

    let mut invalid_argv: List<Text> = List.new();
    invalid_argv.push("report".to_text());
    invalid_argv.push("inspect".to_text());
    invalid_argv.push("--other".to_text());
    assert(parse_argv(&report, invalid_argv) is Result.Err);
}

@test
fn test_short_bundle_continues_after_a_multibyte_flag() {
    let root = CommandSpec.new("tool", "Tool")
        .add_flag(FlagSpec.switch("lambda", "Count lambdas").short('λ'))
        .add_flag(FlagSpec.switch("verbose", "Verbose").short('v'));
    let valid: List<Text> = ["tool", "-λv"];
    let undeclared: List<Text> = ["tool", "-λz"];
    assert(parse_argv(&root, valid) is Result.Ok);
    assert(parse_argv(&root, undeclared) is Result.Err);
}

@test
fn test_required_positionals_belong_to_the_selected_command() {
    let leaf = CommandSpec.new("inspect", "Inspect").add_arg(ArgSpec.required("input", "Input"));
    let root = CommandSpec.new("tool", "Tool").add_subcommand(leaf);
    let missing: List<Text> = ["tool", "inspect"];
    let present: List<Text> = ["tool", "inspect", "document"];
    assert(parse_argv(&root, missing) is Result.Err);
    assert(parse_argv(&root, present) is Result.Ok);
}

@test
fn test_flag_parser_preserves_attached_values_and_leaves_mismatches_in_place() {
    let mode = flag(FlagSpec.value("mode", "Mode"));
    let model = flag(FlagSpec.value("model", "Model"));
    let tokens: List<Text> = ["--mode=λ=x", "--mode=", "--mode", "", "--model=z", "--mode"];
    let input = tokens.as_slice();
    assert(mode.parse(input, 0) is ParseStep.Matched { value: "λ=x", next: 1 });
    assert(mode.parse(input, 1) is ParseStep.Matched { value: "", next: 2 });
    assert(mode.parse(input, 2) is ParseStep.Matched { value: "", next: 4 });
    assert(mode.parse(input, 4) is ParseStep.Mismatch(_));
    assert(model.parse(input, 4) is ParseStep.Matched { value: "z", next: 5 });
    assert(mode.parse(input, 5) is ParseStep.Failed(_));

    let repeated = many<Text, FlagParser>(mode);
    match repeated.parse(input, 0) {
        ParseStep.Matched { value, next } => {
            assert_eq(next, 4);
            assert_eq(value.len(), 3);
            assert_eq(value[0], "λ=x");
            assert_eq(value[1], "");
            assert_eq(value[2], "");
        },
        _ => panic("expected three mode options"),
    };
}

@test
fn test_optional_parser_preserves_errors_after_consuming_an_option() {
    let required = optional<Text, ArgParser>(arg(ArgSpec.required("item", "Item")));
    let tokens: List<Text> = ["value", "--mode"];
    let input = tokens.as_slice();
    assert(required.parse(input, 0) is ParseStep.Matched { value: Maybe.Some("value"), next: 1 });
    assert(required.parse(input, 2) is ParseStep.Matched { value: Maybe.None, next: 2 });

    let mode = optional<Text, FlagParser>(flag(FlagSpec.value("mode", "Mode")));
    assert(mode.parse(input, 1) is ParseStep.Failed(_));
}

type BorrowedToken is { stride: Int };

implement Parser<&Text> for BorrowedToken {
    fn parse(&self, tokens: &[Text], at: Int) -> ParseStep<&Text> {
        if at == tokens.len() {
            return ParseStep.Mismatch(ParseError.missing_required("token"));
        }
        if tokens[at] == "invalid" {
            return ParseStep.Failed(ParseError.bare(ParseErrorKind.InvalidValue, "invalid token"));
        }
        ParseStep.Matched { value: &tokens[at], next: at + self.stride }
    }

    fn describe(&self) -> ParserDescription {
        arg(ArgSpec.required("token", "Input")).describe()
    }
}

@test
fn test_many_retains_distinct_borrowed_and_owned_values() {
    let tokens: List<Text> = ["skipped", "first", "second"];
    let input = tokens.as_slice();
    let borrowed = many<&Text, BorrowedToken>(BorrowedToken { stride: 1 });
    match borrowed.parse(input, 1) {
        ParseStep.Matched { value, next } => {
            assert_eq(next, 3);
            assert_eq(value.len(), 2);
            assert_eq(*value[0], "first");
            assert_eq(*value[1], "second");
        },
        _ => panic("expected two borrowed tokens"),
    }
    let owned = many<Text, ArgParser>(arg(ArgSpec.required("item", "Input")));
    match owned.parse(input, 1) {
        ParseStep.Matched { value, next } => {
            assert_eq(next, 3);
            assert_eq(value.len(), 2);
            assert_eq(value[0], "first");
            assert_eq(value[1], "second");
        },
        _ => panic("expected two owned tokens"),
    }
}

@test
fn test_many_terminates_on_absence_and_propagates_committed_failure() {
    let tokens: List<Text> = ["ok", "invalid"];
    let repeated = many<&Text, BorrowedToken>(BorrowedToken { stride: 1 });
    match repeated.parse(tokens.as_slice(), 2) {
        ParseStep.Matched { value, next } => {
            assert(value.is_empty());
            assert_eq(next, 2);
        },
        _ => panic("expected an empty repetition at end of input"),
    }
    match repeated.parse(tokens.as_slice(), 0) {
        ParseStep.Failed(error) => assert_eq(*error.message(), "invalid token"),
        _ => panic("expected the diagnostic from the second token"),
    };
}

@test
fn test_many_refuses_nonprogress_and_out_of_range_positions() {
    let tokens: List<Text> = ["a", "b"];
    let input = tokens.as_slice();
    let zero = many<&Text, BorrowedToken>(BorrowedToken { stride: 0 });
    let back = many<&Text, BorrowedToken>(BorrowedToken { stride: -1 });
    let ahead = many<&Text, BorrowedToken>(BorrowedToken { stride: 3 });
    assert(zero.parse(input, 0) is ParseStep.Failed(_));
    assert(back.parse(input, 1) is ParseStep.Failed(_));
    assert(ahead.parse(input, 0) is ParseStep.Failed(_));
    assert(zero.parse(input, -1) is ParseStep.Failed(_));
    assert(zero.parse(input, 3) is ParseStep.Failed(_));
    let opt = optional<&Text, BorrowedToken>(BorrowedToken { stride: 3 });
    assert(opt.parse(input, 0) is ParseStep.Failed(_));
}
