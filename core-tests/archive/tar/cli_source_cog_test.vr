fn assert_entry(entries: &List<TarEntry>, path: &Text, expected: &List<Byte>) {
    let mut matched = 0;
    let mut i = 0;
    while i < entries.len() {
        let entry = &entries[i];
        if *entry.path() == *path {
            matched = matched + 1;
            assert(entry.entry_type() is EntryType.RegularFile);
            let content: &List<Byte> = entry.content();
            assert(content.len() == expected.len());
            let mut j = 0;
            while j < expected.len() { assert(content[j] == expected[j]); j = j + 1; }
        }
        i = i + 1;
    }
    assert(matched == 1);
}

@test
fn actual_cli_archive_preserves_exact_paths_and_binary_contents() {
    let bytes = captured_tar();
    assert(bytes.len() == 5120);
    let limits = TarReadLimits {
        max_input_bytes: 5120, max_entries: 3,
        max_entry_bytes: 87, max_total_content_bytes: 102,
        max_extensions: 1, max_extension_bytes: 145,
        max_text_bytes: 144, max_trailing_padding_bytes: 0,
    };
    let entries = read_archive_strict(bytes.as_slice(), &limits).unwrap();
    assert(entries.len() == 3);
    let expected_0: List<Byte> = [
        0x5B_u8, 0x63_u8, 0x6F_u8, 0x67_u8, 0x5D_u8, 0x0A_u8, 0x6E_u8, 0x61_u8, 0x6D_u8, 0x65_u8, 0x20_u8, 0x3D_u8,
        0x20_u8, 0x22_u8, 0x61_u8, 0x72_u8, 0x63_u8, 0x68_u8, 0x69_u8, 0x76_u8, 0x65_u8, 0x2D_u8, 0x66_u8, 0x69_u8,
        0x6E_u8, 0x61_u8, 0x6C_u8, 0x69_u8, 0x7A_u8, 0x61_u8, 0x74_u8, 0x69_u8, 0x6F_u8, 0x6E_u8, 0x2D_u8, 0x34_u8,
        0x38_u8, 0x30_u8, 0x36_u8, 0x63_u8, 0x61_u8, 0x39_u8, 0x61_u8, 0x39_u8, 0x62_u8, 0x62_u8, 0x36_u8, 0x34_u8,
        0x37_u8, 0x33_u8, 0x34_u8, 0x39_u8, 0x34_u8, 0x36_u8, 0x33_u8, 0x61_u8, 0x38_u8, 0x34_u8, 0x66_u8, 0x34_u8,
        0x36_u8, 0x63_u8, 0x64_u8, 0x36_u8, 0x61_u8, 0x37_u8, 0x38_u8, 0x22_u8, 0x0A_u8, 0x76_u8, 0x65_u8, 0x72_u8,
        0x73_u8, 0x69_u8, 0x6F_u8, 0x6E_u8, 0x20_u8, 0x3D_u8, 0x20_u8, 0x22_u8, 0x31_u8, 0x2E_u8, 0x32_u8, 0x2E_u8,
        0x33_u8, 0x22_u8, 0x0A_u8,
    ];
    assert_entry(&entries, &"Verum.toml".to_text(), &expected_0);
    let expected_1: List<Byte> = [
        0x00_u8, 0xFF_u8, 0x42_u8, 0x80_u8, 0x7F_u8, 0xFE_u8, 0x00_u8,
    ];
    assert_entry(&entries, &"src/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/binary.dat".to_text(), &expected_1);
    let expected_2: List<Byte> = [
        0x73_u8, 0x68_u8, 0x6F_u8, 0x72_u8, 0x74_u8, 0x00_u8, 0xFF_u8, 0x80_u8,
    ];
    assert_entry(&entries, &"src/short.bin".to_text(), &expected_2);
}

fn main() {
    actual_cli_archive_preserves_exact_paths_and_binary_contents();
    print("tar-cli-producer: 1 passed");
}
