// =============================================================================
// core-tests/encoding/jcs/unit_test.vr
// =============================================================================
//
// `core/encoding/jcs.vr` — RFC 8785 JSON Canonicalization Scheme.
//
// Pure-data surface tested here:
//   * JcsError 2-variant ADT
//       - JsonParseFailed(JsonError)
//       - UnsupportedValue(Text)
//   * Variant disjointness via `is`-pattern testing
//   * Payload round-trip for UnsupportedValue
//
// THE DEFERRAL HERE NAMED THE WRONG CAUSE, which mattered because it
// pointed at a fix nobody was going to make for this. It read: "the
// canonicalize_value / canonicalize_str surfaces produce Text via the
// json.vr stringification path which trips the same lenient-stub
// cascade as other Text builders".
//
// Re-run 2026-09-12 under a plain `verum run`, the failure is not a
// stub cascade and has nothing to do with Text:
//
//     canonicalize_str("{\"b\":1,\"a\":2}")
//     -> Null pointer dereference: op=opcode 0x62 at MapIter.next
//
// That is the Map-iterator family — the same opcode and the same site
// shape as `Map.entry`, `Map.get_mut` and `Map.values_mut`, all three
// of which this repo already pins. JCS canonicalisation has to walk an
// object's keys in sorted order, so it reaches a map iterator on every
// input that contains an object; nothing about the sibling PEM
// deferral applied here, and that one turned out to be simply stale.
// Section 5 pins it at the measured cause.
// =============================================================================

mount core.encoding.jcs.{JcsError, canonicalize_str};
mount core.encoding.json.{JsonError, JsonErrorKind};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Section 1: JcsError 2-variant construction
// =============================================================================

fn mk_json_err(kind: JsonErrorKind, msg: Text) -> JsonError {
    JsonError {
        kind: kind,
        line: 1,
        column: 1,
        message: msg,
    }
}

@test
fn test_jcs_error_json_parse_failed_variant() {
    let inner = mk_json_err(JsonErrorKind.UnexpectedEof, "EOF".to_text());
    let e: JcsError = JcsError.JsonParseFailed(inner);
    assert(e is JcsError.JsonParseFailed);
}

@test
fn test_jcs_error_unsupported_value_variant() {
    let e: JcsError = JcsError.UnsupportedValue("NaN".to_text());
    assert(e is JcsError.UnsupportedValue);
}

// =============================================================================
// Section 2: Variant pairwise disjointness
// =============================================================================

@test
fn test_jcs_error_json_parse_failed_not_unsupported() {
    let inner = mk_json_err(JsonErrorKind.UnexpectedChar, "x".to_text());
    let e: JcsError = JcsError.JsonParseFailed(inner);
    assert(!(e is JcsError.UnsupportedValue));
}

@test
fn test_jcs_error_unsupported_value_not_json_parse_failed() {
    let e: JcsError = JcsError.UnsupportedValue("Infinity".to_text());
    assert(!(e is JcsError.JsonParseFailed));
}

// =============================================================================
// Section 3: Match exhaustiveness
//
//   `describe(e: &JcsError) -> Text` must reach exactly one arm per
//   variant.
// =============================================================================

fn describe(e: &JcsError) -> Text {
    match e {
        JcsError.JsonParseFailed(_)  => "parse-failed".to_text(),
        JcsError.UnsupportedValue(_) => "unsupported".to_text(),
    }
}

@test
fn test_jcs_error_describe_json_parse_failed() {
    let inner = mk_json_err(JsonErrorKind.InvalidEscape, "\\q".to_text());
    let e: JcsError = JcsError.JsonParseFailed(inner);
    assert_eq(describe(&e), "parse-failed");
}

@test
fn test_jcs_error_describe_unsupported_value() {
    let e: JcsError = JcsError.UnsupportedValue("-Inf".to_text());
    assert_eq(describe(&e), "unsupported");
}

// =============================================================================
// Section 4: Payload preservation
// =============================================================================

@test
fn test_jcs_error_unsupported_value_payload_round_trip() {
    let pinned = "NaN literal not allowed in JCS".to_text();
    let e: JcsError = JcsError.UnsupportedValue(pinned);
    match e {
        JcsError.UnsupportedValue(s) => assert_eq(s, "NaN literal not allowed in JCS"),
        _ => panic("expected UnsupportedValue"),
    }
}

@ignore("Nested record-field access through match-binding (inner_err.kind) trips the field-index resolver — sister of [[btree_pattern_match_ref_generic_class]]. Workaround: bind via typed local + re-deref.")
@test
fn test_jcs_error_json_parse_failed_payload_kind_round_trip() {
    let inner = mk_json_err(JsonErrorKind.TrailingGarbage, "extra".to_text());
    let e: JcsError = JcsError.JsonParseFailed(inner);
    match e {
        JcsError.JsonParseFailed(inner_err) => {
            assert(inner_err.kind is JsonErrorKind.TrailingGarbage);
        },
        _ => panic("expected JsonParseFailed"),
    }
}

// =============================================================================
// Section 5: canonicalize_str — pinned at the measured cause
// =============================================================================

@test
@ignore("canonicalize_str dies with `Null pointer dereference: op=opcode 0x62 at MapIter.next`. Measured 2026-09-12 at Tier 0 on {\"b\":1,\"a\":2}. NOT the lenient-stub cascade the old header blamed: it is the Map-iterator family, same opcode and site shape as Map.entry / Map.get_mut / Map.values_mut. Canonicalisation walks an object's keys in sorted order, so it reaches a map iterator on any input containing an object.")
fn test_canonicalize_str_sorts_object_keys() {
    // RFC 8785 §3.2.3: object members are serialised ordered by their
    // UTF-16 code units, so `b` before `a` on the wire comes back `a`
    // before `b`, and every space disappears.
    match canonicalize_str(&Text.from("{\"b\":1,\"a\":2}")) {
        Result.Ok(t) => assert_eq(t, "{\"a\":2,\"b\":1}"),
        Result.Err(_) => panic("canonicalize_str on well-formed JSON"),
    };
}

@test
@ignore("Same MapIter.next null dereference as the sibling test above; see its note. Measured 2026-09-12 (A125 family).")
fn test_canonicalize_str_is_idempotent() {
    // Canonical form applied twice is the canonical form. A serialiser
    // that merely reordered without normalising whitespace or number
    // formatting passes the sort test above and fails here.
    match canonicalize_str(&Text.from("{\"a\": 2, \"b\": 1}")) {
        Result.Ok(once) => {
            match canonicalize_str(&once) {
                Result.Ok(twice) => assert_eq(once, twice),
                Result.Err(_) => panic("second canonicalisation"),
            };
        },
        Result.Err(_) => panic("first canonicalisation"),
    };
}

@test
fn test_canonicalize_str_refuses_malformed_json() {
    // The ERROR path does not reach a map iterator, so it runs today
    // and is the half of this surface that can be pinned green.
    match canonicalize_str(&Text.from("{not json")) {
        Result.Ok(_) => panic("malformed input must not canonicalise"),
        Result.Err(_) => assert(true),
    };
}

fn main() {}
