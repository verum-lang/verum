// Blocking-pool owners are created by their public constructors.
module pool_contracts;
mount core.runtime.pool.ThreadPool;

fn identity(value: Int) -> Int { value }

@test
fn worker_count_default_executes() {
    let pool = ThreadPool.new(0);
    let mut work = pool.submit(identity, 73);
    assert_eq(work.join(), 73);
}

@test
fn completed_task_outlives_its_local_pool() {
    let mut work = {
        let pool = ThreadPool.new(1);
        pool.submit(identity, 41)
    };
    assert_eq(work.join(), 41);
}

@test
fn a_job_can_be_discarded_before_another_is_collected() {
    let pool = ThreadPool.new(1);
    drop(pool.submit(identity, 17));
    let mut work = pool.submit(identity, 53);
    assert_eq(work.join(), 53);
}
