// =============================================================================
// core-tests/base/env/property_test.vr
// =============================================================================
//
// Algebraic-law verification for `core/base/env.vr` — environment
// variables, args, exit codes, locale.
//
// Laws verified:
//   §A  set_var followed by var returns the same value (round-trip)
//   §B  remove_var followed by var_opt returns Maybe.None
//   §C  args_count == args().len() (consistency between forms)
//   §D  var on a never-set variable returns Maybe.None (or VarError)
//   §E  set_var twice keeps the latest value (last-write-wins)
//
// Note: env tests TOUCH global state (the OS env), so cleanup is
// essential. Each test uses a unique key prefix to avoid cross-test
// contamination.
// =============================================================================

// THE PRELUDE DOES NOT CARRY `env`, BY DESIGN, and this file assumed it
// did. `core/mod.vr`'s prelude is curated — its inclusion law admits
// only names "the LANGUAGE ITSELF requires in scope everywhere", and it
// says why: a directory glob once published all 316 top-level names of
// `base/`, so a bare `parse("1.2.3")` silently bound to the meta-term
// parser. Every env name below is therefore mounted explicitly, exactly
// as the sibling `regression_test.vr` mounts them.
//
// All six laws in this file had been failing to COMPILE — `set_var`,
// `var`, `remove_var`, `var_opt` all unbound — which is why they took
// an identical 504ms and reported as six separate failures rather than
// one. Measured 2026-09-12.
mount core.prelude.*;
mount core.base.env.{args, args_count, var, var_opt, set_var, remove_var, exit};
mount core.collections.list.List;

// =============================================================================
// §A  set_var ↔ var round-trip.
// =============================================================================

@test
fn law_set_var_then_var_round_trip() {
    let key = "VERUM_TEST_PROP_A";
    set_var(key, "round-trip-value");
    let v = var(key);
    assert(v.is_ok());
    assert_eq(v.unwrap(), "round-trip-value");
    remove_var(key);   // cleanup
}

// =============================================================================
// §B  remove_var clears the value.
// =============================================================================

@test
fn law_remove_var_clears() {
    let key = "VERUM_TEST_PROP_B";
    set_var(key, "tmp");
    remove_var(key);
    let v = var_opt(key);
    assert(v.is_none());
}

// =============================================================================
// §C  args_count consistency.
// =============================================================================

@test
fn law_args_count_matches_args_len() {
    let n = args_count();
    // `args()` returns `List<Text>`; `Args` is the ITERATOR type, which
    // nothing here constructs. The annotation was the second reason
    // this law could not compile.
    let xs: List<Text> = args();
    assert_eq(xs.len(), n);
}

// =============================================================================
// §D  var on never-set returns Maybe.None / VarError.
// =============================================================================

@test
fn law_var_opt_unset_returns_none() {
    let key = "VERUM_TEST_PROP_D_NEVER_SET";
    // Make sure it's not set (cleanup before assert):
    remove_var(key);
    let v = var_opt(key);
    assert(v.is_none());
}

// =============================================================================
// §E  Last-write-wins on set_var.
// =============================================================================

@test
fn law_set_var_last_write_wins() {
    let key = "VERUM_TEST_PROP_E";
    set_var(key, "first");
    set_var(key, "second");
    set_var(key, "third");
    let v = var(key);
    assert_eq(v.unwrap(), "third");
    remove_var(key);   // cleanup
}

// =============================================================================
// §F  @property — round-trip with sampled keys / values.
// =============================================================================

@property
fn prop_set_then_var_round_trip(value: Text) {
    // Use a fixed key to avoid namespace pollution; only the value varies.
    let key = "VERUM_TEST_PROP_F_ROUND_TRIP";

    // THE LAW HAS A PRECONDITION AND IT WAS NOT STATED. An environment
    // variable is a NUL-terminated C string: a value carrying an
    // embedded NUL cannot be stored, on any platform, and no fix to
    // `set_var` will change that. The generator draws arbitrary `Text`,
    // so it finds one — measured 2026-09-12, the drawn value was
    // "3@KmsaPT\u{301}].💩😀=sb?\0\u{301}r\u{301}a5<(" and it took the whole
    // test RUNNER down with SIGABRT, losing every remaining test in the
    // process. (The abort was a second, separate defect — `set_var`
    // bottomed out in the host's setter, which PANICS rather than
    // failing — and that is fixed where it belongs, in the
    // interpreter. A law asserting something false would still be a
    // false law.)
    if value.contains("\0") {
        return;
    }

    set_var(key, value.clone());
    let recovered = var(key);
    assert(recovered.is_ok());
    assert_eq(recovered.unwrap(), value);
    remove_var(key);
}

// =============================================================================
// §G  @test_case — exit codes are bounded.
// =============================================================================

@test_case(0)        // success
@test_case(1)        // generic error
@test_case(2)        // misuse
@test_case(127)      // command not found
@test_case(128)      // base for signal-induced exit
fn parametrised_exit_code_in_byte_range(code: Int) {
    // exit() takes any Int but POSIX truncates to low 8 bits.
    // We don't actually call exit() in tests (it would terminate the
    // runner) — just verify the value is in the typical range.
    assert(code >= 0 && code <= 255);
}

// =============================================================================
// Entry point
// =============================================================================

fn main() {
    // `verum test` synthesises a per-test main.
}
