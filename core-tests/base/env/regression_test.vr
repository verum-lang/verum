// =============================================================================
// core-tests/base/env/regression_test.vr
// =============================================================================
//
// Regression pins for `core.base.env` — process arguments,
// environment variables, exit codes, and standard environment helpers.
// =============================================================================

mount core.base.{
    args, arg, args_count, args_os, Args,
    var, var_opt, set_var, remove_var, VarError,
    exit, exit_success, exit_failure,
    home_dir, user, path, temp_dir, shell, locale,
};
mount core.{Maybe, Result, Text};
mount core.collections.list.List;

// =============================================================================
// REGRESSION §A: `args_count()` returns > 0 and `arg(0)` returns
// Maybe.None. The two accessors must be consistent — either both say
// "no argv" (count=0, arg(i)=Maybe.None) or both say "argv present"
// (count>0, arg(0)=Maybe.Some(program_name)).
//
// THE STATED CAUSE WAS WRONG AND IT MATTERED. This section used to
// blame the `--interp` harness and prescribe a workaround: "avoid
// asserting on arg(i) when running under `--interp` without explicit
// argv setup". Re-measured 2026-09-12 under a plain `verum run`, where
// argv is unambiguously present, the failure is identical — so the
// harness had nothing to do with it, and the workaround taught every
// later test to stop asking.
//
// WHAT THE RE-MEASUREMENT FOUND, and it is the whole shape of the
// defect. In ONE programme, across a mount of `core.base.env`:
//
//     args_count()   ->  3
//     args().len()   ->  3, and the three entries are the REAL argv
//                        ("…/verum", "run", "…/main.vr")
//     arg(0)         ->  Maybe.None        (and arg(1), arg(2) too)
//
// `args()` is implemented as `arg(i)` in a loop inside `core.base.env`
// and breaks on the first Maybe.None. It returns three values, so
// `arg(i)` ANSWERS CORRECTLY when called from inside the module and
// answers None when entered directly from outside it. Both outside
// spellings fail alike — the mounted bare name and the dotted
// `core.base.env.arg(0)` — so it is the module boundary, not the
// spelling.
//
// That rules out the plumbing: argv is present, initialised and
// readable. `args_count()` reads `PROCESS_ARGC` across the same
// boundary and is right. Only the direct cross-module entry into `arg`,
// which reads the POINTER static `PROCESS_ARGV`, comes back empty.
// =============================================================================

@test
@ignore("arg(i) answers Maybe.None for every index when entered across the module boundary, while args() — the same arg(i) in a loop inside core.base.env — returns the real argv in the same programme. Measured 2026-09-12 under a plain `verum run`, not a harness artefact. See §A1, which pins the discriminator and passes.")
fn regression_pin_arg_zero_consistent_with_args_count() {
    let count = args_count();
    let first = arg(0);
    if count > 0 {
        assert(first.is_some());
    } else {
        assert(first.is_none());
    }
}

// =============================================================================
// REGRESSION §A1: THE DISCRIMINATOR, and it passes today.
//
// §A is red and `@ignore`d, which means it protects nothing. This one
// pins what the re-measurement established, so a fix that repairs
// `arg` cannot quietly break the route that works, and a regression in
// `args()` cannot hide behind `arg`'s known failure.
// =============================================================================

@test
fn regression_args_sees_argv_even_where_arg_does_not() {
    // args() walks arg(i) INSIDE the module. Whatever ails the direct
    // cross-module call, this route reaches the real argv.
    let all = args();
    let count = args_count();
    assert(count >= 1);
    assert(all.len() >= 1);
    // The two module-internal readers agree with each other. They did
    // NOT agree with arg(i) when this was written, and that gap is the
    // defect; if a fix closes it, §A goes green and this stays green.
    assert_eq(all.len(), count);
}

// =============================================================================
// REGRESSION §B: `args_count()` is a non-negative Int. A defect that
// returned a negative count would silently break every iteration
// pattern over argv.
// =============================================================================

@test
fn regression_args_count_non_negative() {
    let n = args_count();
    assert(n >= 0);
}

// =============================================================================
// REGRESSION §C: `arg(i)` returns Maybe.None for negative or out-of-range
// indices regardless of args_count. A defect that wrapped to a
// positive index modulo size would silently produce wrong values.
// =============================================================================

@test
fn regression_arg_negative_index_is_none() {
    let v = arg(-1);
    assert(v.is_none());
}

@test
fn regression_arg_large_index_is_none() {
    let v = arg(1_000_000);
    assert(v.is_none());
}

// =============================================================================
// REGRESSION §D: `var_opt` for a non-existent key returns Maybe.None. A
// defect that returned an empty string or panic would silently break
// optional-config patterns.
// =============================================================================

@test
fn regression_var_opt_returns_none_for_missing_key() {
    let key = "REGRESSION_VAR_THAT_SHOULD_NEVER_EXIST_XYZZY_12345".to_text();
    let v = var_opt(&key);
    assert(v.is_none());
}

// =============================================================================
// REGRESSION §E: `var` for a non-existent key returns Result.Err(NotPresent).
// =============================================================================

@test
fn regression_var_returns_err_not_present_for_missing_key() {
    let key = "REGRESSION_VAR_THAT_SHOULD_NEVER_EXIST_XYZZY_67890".to_text();
    let r = var(&key);
    assert(r.is_err());
    match r {
        Err(e) => match e {
            VarError.NotPresent => {},
            _ => {},   // accept any VarError variant — not all imps fix NotPresent
        },
        Ok(_) => panic("missing key should return Err"),
    }
}

// =============================================================================
// REGRESSION §F: VarError variants disjoint under Eq.
// =============================================================================

@test
fn regression_var_error_variants_disjoint() {
    let a = VarError.NotPresent;
    // Payload contract per core/base/env.vr: NotUnicode carries the RAW
    // BYTES that failed decoding (List<Byte>), not a Text — the fixture
    // previously passed Text and pinned the wrong contract (same idiom
    // as unit_test's test_var_error_not_unicode).
    let bad_bytes: List<Byte> = [0xFF, 0xFE, 0x00];
    let b = VarError.NotUnicode(bad_bytes);
    // Both must be constructible — variant tag pin via match.
    match a {
        VarError.NotPresent => {},
        _ => panic("expected NotPresent"),
    }
    match b {
        VarError.NotUnicode(_) => {},
        _ => panic("expected NotUnicode"),
    }
}

// =============================================================================
// REGRESSION §G: `temp_dir()` returns a non-empty Text. A defect that
// returned an empty string would silently break every tempfile creation.
// =============================================================================

@test
fn regression_temp_dir_non_empty() {
    let t = temp_dir();
    assert(t.len() > 0);
}

// =============================================================================
// REGRESSION §H: `args()` returns a List<Text> (possibly empty under
// --interp).
// =============================================================================

@test
fn regression_args_returns_list_text() {
    let xs: List<Text> = args();
    let n = xs.len();
    assert(n >= 0);
}

fn main() {}
