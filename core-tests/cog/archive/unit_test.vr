mount core.cog.archive.{
    ARCHIVE_VERSION_MAJOR, ARCHIVE_VERSION_MINOR, ARCHIVE_HEADER_SIZE,
    FLAG_IS_STDLIB, FLAG_COMPRESSED, FLAG_HAS_DEBUG_INFO, FLAG_HAS_SOURCE_MAP,
    FLAG_STRIP_FIELD_NAMES, FLAG_STRIP_VARIANT_NAMES, FLAG_STRIP_CONSTRAINTS,
    FLAG_STRIP_PROTOCOL_DETAILS, ArchiveError, read_header, read_archive_bytes,
    is_stdlib, is_compressed, has_debug_info, has_source_map, is_stripped,
    find_module, module_bytes, total_payload_size, topological_order,
};

@test
fn archive_version_and_header_size_match_the_wire() {
    assert(ARCHIVE_VERSION_MAJOR == 1 && ARCHIVE_VERSION_MINOR == 0);
    assert_eq(ARCHIVE_HEADER_SIZE, 32);
}

@test
fn storage_and_metadata_flags_match_the_writer() {
    assert_eq(FLAG_IS_STDLIB, 1);
    assert_eq(FLAG_COMPRESSED, 2);
    assert_eq(FLAG_HAS_DEBUG_INFO, 4);
    assert_eq(FLAG_HAS_SOURCE_MAP, 8);
    assert_eq(FLAG_STRIP_FIELD_NAMES, 16);
    assert_eq(FLAG_STRIP_VARIANT_NAMES, 32);
    assert_eq(FLAG_STRIP_CONSTRAINTS, 64);
    assert_eq(FLAG_STRIP_PROTOCOL_DETAILS, 128);
}

// ArchiveBuilder::stdlib() with DEBUG_INFO and STRIP_VARIANT_NAMES.
// Stored "a" contains A5. Stored "b" contains 42 FF and depends on "a".
fn compact_archive() -> List<Byte> {
    [
        0x56_u8, 0x42_u8, 0x43_u8, 0x41_u8, 0x01_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x25_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0x02_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x23_u8, 0x00_u8, 0x00_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x46_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0xa5_u8, 0x42_u8, 0xff_u8, 0x01_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x61_u8,
        0x20_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x01_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x7e_u8, 0x7d_u8, 0x11_u8, 0x47_u8,
        0xa5_u8, 0x51_u8, 0xb2_u8, 0xff_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x01_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0x62_u8, 0x21_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8,
        0x00_u8, 0x02_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x80_u8,
        0xfd_u8, 0x39_u8, 0x29_u8, 0x61_u8, 0x6f_u8, 0x64_u8, 0x2a_u8, 0x01_u8, 0x00_u8, 0x00_u8,
        0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8, 0x00_u8,
    ]
}

@test
fn reads_stored_payloads_and_dependency_order() {
    let bytes = compact_archive();
    let header = read_header(&bytes).unwrap();
    assert(is_stdlib(&header) && has_debug_info(&header) && is_stripped(&header));
    assert(!is_compressed(&header) && !has_source_map(&header));
    let archive = read_archive_bytes(&bytes).unwrap();
    assert_eq(total_payload_size(&archive), 3);
    assert(archive.header().index_size == 70);
    assert_eq(*archive.sha256(), "86c4c2e39bd617e69ccaac4a9446ae53efce8e018e336cdc9c3732f3d070cfcd");
    let first = find_module(&archive, &"a").unwrap();
    assert_eq(first.content_hash, 18424878795829902718_u64);
    assert(find_module(&archive, &"missing") is Maybe.None);
    let payload = module_bytes(&archive, &"b").unwrap();
    assert_eq(payload.len(), 2);
    assert_eq(payload[0], 0x42_u8);
    assert_eq(payload[1], 0xff_u8);
    let order = topological_order(&archive).unwrap();
    assert_eq(order.len(), 2);
    assert_eq(order[0], "a");
    assert_eq(order[1], "b");
}

@test
fn accepts_genuine_legacy_index_size_and_refuses_mismatched_extents() {
    let mut bytes = compact_archive();
    bytes[24] = 0_u8;
    assert(read_archive_bytes(&bytes).is_ok());
    bytes[24] = 69_u8;
    assert(read_archive_bytes(&bytes) is Result.Err(ArchiveError.TruncatedIndex { offset: _, size: _, total: _ }));
}

@test
fn rejects_malformed_names_and_dependencies() {
    let mut duplicate = compact_archive();
    duplicate[72] = 0x61_u8;
    assert(read_archive_bytes(&duplicate) is Result.Err(ArchiveError.InvalidIndexEncoding(_)));
    let mut invalid_name = compact_archive();
    invalid_name[39] = 0xff_u8;
    assert(read_archive_bytes(&invalid_name) is Result.Err(ArchiveError.InvalidIndexEncoding(_)));
    let mut foreign_dep = compact_archive();
    foreign_dep[101] = 2_u8;
    assert(read_archive_bytes(&foreign_dep) is Result.Err(ArchiveError.InvalidIndexEncoding(_)));
}

@test
fn reports_a_cycle_only_when_requesting_dependency_order() {
    let mut bytes = compact_archive();
    bytes[101] = 1_u8;
    let archive = read_archive_bytes(&bytes).unwrap();
    assert(topological_order(&archive) is Result.Err(_));
}
