mount core.cog.archive.{ArchiveError};
mount core.io.protocols.{IoErrorKind, StreamError};

@test
fn distinct_archive_failure_kinds() {
    let version = ArchiveError.UnsupportedVersion { major: 2, minor: 0 };
    let header = ArchiveError.TruncatedHeader { expected: 32, found: 16 };
    let index = ArchiveError.TruncatedIndex { offset: 64, size: 128, total: 100 };
    let payload = ArchiveError.TruncatedModule { module: "app", offset: 32, size: 9, total: 35 };
    assert(version is ArchiveError.UnsupportedVersion);
    assert(header is ArchiveError.TruncatedHeader);
    assert(index is ArchiveError.TruncatedIndex);
    assert(payload is ArchiveError.TruncatedModule);
    assert(!(version is ArchiveError.IoFailure));
}

@test
fn invalid_index_retains_its_reason() {
    let error = ArchiveError.InvalidIndexEncoding("invalid UTF-8 module name");
    match error {
        ArchiveError.InvalidIndexEncoding(message) => assert_eq(message, "invalid UTF-8 module name"),
        _ => panic("expected an invalid index"),
    }
}

@test
fn io_failure_retains_missing_and_denied_kinds() {
    let missing = ArchiveError.IoFailure(StreamError.new(IoErrorKind.NotFound));
    let denied = ArchiveError.IoFailure(StreamError.new(IoErrorKind.PermissionDenied));
    match missing {
        ArchiveError.IoFailure(error) => assert(error.kind() is IoErrorKind.NotFound),
        _ => panic("expected missing file"),
    }
    match denied {
        ArchiveError.IoFailure(error) => assert(error.kind() is IoErrorKind.PermissionDenied),
        _ => panic("expected denied access"),
    }
}
