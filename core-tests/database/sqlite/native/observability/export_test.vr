module core.database.sqlite.native.observability.tests.export;
mount core.database.sqlite.native.observability.registry.registry_new;
mount core.database.sqlite.native.observability.exporter.{MetricExporter, prometheus, json_lines, otlp, otlp_export};

@test
fn test_registry_values_and_exported_buckets() {
    let mut reg = registry_new();
    assert(reg.counter_value(&"reads") is Maybe.None);
    assert_eq(otlp_export(&otlp(), &reg).len(), 0);

    reg.add_counter("reads", 4_i64);
    reg.inc_counter("reads");
    reg.set_gauge("depth", 2_i64);
    reg.set_gauge("depth", -3_i64);
    reg.observe("latency_ns", 10000_i64);
    reg.observe("latency_ns", 10001_i64);
    reg.observe("latency_ns", 10000000001_i64);

    assert_eq(reg.counter_count(), 1);
    assert_eq(reg.gauge_count(), 1);
    assert_eq(reg.histogram_count(), 1);
    assert_eq(reg.counter_value(&"reads").unwrap(), 5_i64);
    assert_eq(reg.gauge_value(&"depth").unwrap(), -3_i64);
    assert_eq(reg.histogram_observations(&"latency_ns").unwrap(), 3_i64);

    let scrape = prometheus().render(&reg);
    assert(scrape.starts_with(&"# TYPE reads counter\nreads 5\n# TYPE depth gauge\ndepth -3\n"));
    assert(scrape.contains(&"latency_ns_bucket{le=\"10000\"} 1\nlatency_ns_bucket{le=\"100000\"} 2\n"));
    assert(scrape.ends_with(&"latency_ns_bucket{le=\"+Inf\"} 3\nlatency_ns_sum 10000020002\nlatency_ns_count 3\n"));
    let json = json_lines().render(&reg);
    assert_eq(json, "{\"type\":\"counter\",\"name\":\"reads\",\"value\":5}\n{\"type\":\"gauge\",\"name\":\"depth\",\"value\":-3}\n{\"type\":\"histogram\",\"name\":\"latency_ns\",\"count\":3,\"sum_ns\":10000020002}\n");
    assert_eq(otlp_export(&otlp(), &reg).len(), 3);
}

fn escaped_name_observations() -> Text {
    let mut reg = registry_new();
    reg.inc_counter("read\"\\\n\t雪");
    reg.set_gauge("поток🙂\r\u{1f}", -2_i64);
    reg.observe("ms\b\f\"\\", 17_i64);
    json_lines().render(&reg)
}

@test
fn test_json_lines_preserves_quotes_controls_and_unicode() {
    let encoded = escaped_name_observations();
    let mut expected = Text.new();
    expected.push_str("{\"type\":\"counter\",\"name\":\"read\\\"\\\\\\n\\t雪\",\"value\":1}\n");
    expected.push_str("{\"type\":\"gauge\",\"name\":\"поток🙂\\r\\u001f\",\"value\":-2}\n");
    expected.push_str("{\"type\":\"histogram\",\"name\":\"ms\\b\\f\\\"\\\\\",\"count\":1,\"sum_ns\":17}\n");
    assert_eq(encoded, expected);
}

fn main() {}
