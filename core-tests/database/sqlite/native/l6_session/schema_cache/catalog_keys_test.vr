module core.database.sqlite.native.tests.catalog_keys;

mount core.base.result.Result;
mount core.database.sqlite.native.l5_sql.ast.{CreateTableStmt, TableRef};
mount core.database.sqlite.native.l6_session.schema_cache.{
    IndexMeta, SchemaCache, SessionSchemaError, schema_cache_new, table_meta_from_create
};

fn create_table(schema: Text, name: Text) -> CreateTableStmt {
    CreateTableStmt {
        if_not_exists: false, temporary: false, table: TableRef { schema, name, alias: "" },
        columns: [], constraints: [], strict: false, without_rowid: false,
    }
}

fn register_table(cache: &mut SchemaCache, schema: Text, name: Text, root: Int) -> Result<(), SessionSchemaError> {
    let create = create_table(schema, name);
    cache.register_table(table_meta_from_create(&create, root, ""))
}

fn index_meta(schema: Text, name: Text, root: Int) -> IndexMeta {
    IndexMeta { schema, name, root_page: root, table_name: "items", columns: [], unique: false }
}

@test
fn test_catalog_keys_keep_schema_and_object_names_separate() {
    let mut cache = schema_cache_new();
    register_table(&mut cache, "a.b", "c", 2).unwrap();
    register_table(&mut cache, "a", "b.c", 3).unwrap();
    register_table(&mut cache, "", "a.b.c", 4).unwrap();
    register_table(&mut cache, "схема", "имя.таблицы", 5).unwrap();
    assert(register_table(&mut cache, "main", "a.b.c", 6).is_err());
    assert_eq(cache.table_count(), 4);
    assert(cache.lookup_table_by_root(4).is_some());
    assert(cache.lookup_table_by_root(6).is_none());
    let replacement = create_table("a", "b.c");
    cache.replace_table(table_meta_from_create(&replacement, 7, ""));
    assert(cache.lookup_table_by_root(3).is_none());
    assert(cache.lookup_table_by_root(7).is_some());
    let before = cache.cookie();
    cache.drop_table(&"a.b", &"c").unwrap();
    assert(cache.drop_table(&"a.b", &"c").is_err());
    assert_eq(cache.cookie(), before + 1);
    assert(cache.lookup_table(&"a", &"b.c").is_ok());
    assert(cache.has_table(&"main", &"a.b.c"));
    assert(cache.has_table(&"схема", &"имя.таблицы"));

    cache.register_index(index_meta("a.b", "c", 10)).unwrap();
    cache.register_index(index_meta("a", "b.c", 11)).unwrap();
    cache.register_index(index_meta("main", "a.b.c", 12)).unwrap();
    assert(cache.register_index(index_meta("", "a.b.c", 13)).is_err());
    assert_eq(cache.index_count(), 3);
    assert_eq(cache.lookup_index(&"", &"a.b.c").unwrap().root_page, 12);
    assert_eq(cache.indexes_for_table(&"a", &"items").len(), 1);
    cache.drop_index(&"a", &"b.c").unwrap();
    assert(cache.lookup_index(&"a", &"b.c").is_err());
    assert_eq(cache.lookup_index(&"a.b", &"c").unwrap().root_page, 10);
    assert_eq(cache.cookie(), before + 2);
}

fn main() {}
