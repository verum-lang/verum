scratchpad/
internal/
# Multi-session task pool (machine-local work queue; see docs/architecture/multi-session-taskpool.md)
.taskpool/
# Build artifacts
target/

# Verum CLI per-project state: build/verify caches AND secrets.
# `verum` writes .verum/{cache,verify-cache} here, and cog signing puts
# .verum/signing.key + .verum/enterprise.toml alongside them
# (crates/verum_cli/src/cog.rs, cog_manager.rs). Untracked but unignored,
# a signing key was one `git add -A` away from being published.
.verum/
**/target/

# LLVM/MLIR (built locally via llvm/build.sh)
llvm/*
!llvm/build.sh
!llvm/llvm.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Playwright/testing artifacts
.playwright-mcp/

# Nested lock files (root Cargo.lock is tracked)
**/fuzz/Cargo.lock
vcs/**/Cargo.lock
vcs/proof_stability/Cargo.lock
vcs/testlibs/**/Cargo.lock

# Z3 (prebuilt, downloaded by setup script)
z3/*
!z3/setup.ps1

# Environment
.env
.env.*
.z3-trace
# Python bytecode from the vcs/scripts gates (check_no_double_colon,
# check_no_str_alias, check_op_byte_docs, vr_gate_scan). These run from
# `make` and from CI, so the cache regenerates in every checkout and
# would otherwise sit untracked in everyone's `git status`.
__pycache__/
*.pyc
