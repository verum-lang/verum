// Executable concrete category models.
//
// This module supplies the terminal category: one object and one arrow.
// It does not identify that category with Set, Cat, Top, or a Grothendieck
// construction. Universal accessibility requires a model and checked evidence
// for that exact model; no such evidence is manufactured here.

@arch_module(
    foundation: Foundation.Mltt,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.math.concrete_accessible;

mount core.math.category.{Category};

/// The terminal category has Unit as both its object and arrow carrier.
/// Every pair of its arrows is composable. This is an executable finite model,
/// not a representation of the category of all sets or topological spaces.
public type TerminalCategory is {};

public fn terminal_category() -> TerminalCategory {
    TerminalCategory {}
}

public fn terminal_identity(object: &()) -> () { () }

public fn terminal_compose(first: &(), second: &()) -> () { () }

public fn terminal_source(arrow: &()) -> () { () }

public fn terminal_target(arrow: &()) -> () { () }

/// Evaluate the identity equation using the actual category operations.
/// The Bool result is a diagnostic; it is not an inhabitant of a proof type.
public fn terminal_left_identity(arrow: &()) -> Bool {
    terminal_compose(&terminal_identity(&terminal_source(arrow)), arrow) == *arrow
}

public fn terminal_right_identity(arrow: &()) -> Bool {
    terminal_compose(arrow, &terminal_identity(&terminal_target(arrow))) == *arrow
}

public fn terminal_associativity(first: &(), second: &(), third: &()) -> Bool {
    terminal_compose(&terminal_compose(first, second), third)
        == terminal_compose(first, &terminal_compose(second, third))
}

implement Category<(), ()> for TerminalCategory {
    fn id(object: &()) -> () { terminal_identity(object) }
    fn compose(first: &(), second: &()) -> () { terminal_compose(first, second) }
    fn source(arrow: &()) -> () { terminal_source(arrow) }
    fn target(arrow: &()) -> () { terminal_target(arrow) }
    fn left_identity(arrow: &()) -> Bool { terminal_left_identity(arrow) }
    fn right_identity(arrow: &()) -> Bool { terminal_right_identity(arrow) }
    fn associativity(first: &(), second: &(), third: &()) -> Bool {
        terminal_associativity(first, second, third)
    }
}
