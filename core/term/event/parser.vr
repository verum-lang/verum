// =============================================================================
// event/parser.vr - ANSI Input Sequence Parser (FSM)
// =============================================================================
// Layer: 1 (Event System)
// Dependencies: types.vr, keys.vr
// =============================================================================
//

// Finite state machine for parsing ANSI terminal input sequences into
// structured Event values. Handles:
//  - Printable ASCII and UTF-8 characters
//  - Control characters (Ctrl+A..Z, Enter, Tab, Backspace)
//  - CSI sequences (arrow keys, function keys, mouse, focus)
//  - SS3 sequences (F1-F4, keypad)
//  - OSC sequences (paste, etc.)
//  - SGR mouse protocol parsing
//

// All 9 states of the parser DFA are defined here.
//

// Spec: 40-terminal-tui-architecture.md §5.2
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.term.event.parser;

mount super.types.{Event, KeyEvent};
mount super.mouse.parse_sgr_mouse;
mount super.keys.{KeyCode, Modifiers};
mount core.collections.deque.Deque;

// =============================================================================
// Parser State — DFA states
// =============================================================================

/// Parser state machine states.
type ParserState is
    | Ground                              // Initial state, waiting for input
    | EscapeStart                         // Received ESC (0x1B)
    | CsiEntry                            // Received ESC [
    | CsiParam {                          // Collecting CSI parameters
        params: List<Int>,
        current: Int,
        has_question: Bool,               // CSI ? prefix (private mode)
        has_lt: Bool,                     // CSI < prefix (SGR mouse)
    }
    | CsiIntermediate                     // CSI intermediate bytes
    | SsThree                             // Received ESC O (SS3)
    | OscString {                         // Received ESC ] (OSC)
        code: Int,
        data: List<Byte>,
        parsing_code: Bool,
    }
    | DcsEntry                            // Received ESC P (DCS)
    | Utf8Sequence {                      // Collecting multi-byte UTF-8
        bytes: [Byte; 4],
        len: Int,
        expected: Int,
    };

// =============================================================================
// InputParser
// =============================================================================

/// ANSI input sequence parser.
/// Feed bytes via feed(), extract events via next_event().
public type InputParser is {
    state: ParserState,
    pending_events: Deque<Event>,
};

implement InputParser {
    /// Create a new parser in the Ground state.
    public fn new() -> InputParser {
        InputParser {
            state: ParserState.Ground,
            pending_events: Deque.new(),
        }
    }

    /// Feed a slice of bytes to the parser.
    /// Returns the number of events recognized.
    public fn feed(&mut self, data: &[Byte]) -> Int {
        let before = self.pending_events.len();
        for i in 0..data.len() { self.process_byte(data[i]); }
        self.pending_events.len() - before
    }

    /// Extract the next recognized event, if any.
    public fn next_event(&mut self) -> Maybe<Event> {
        self.pending_events.pop_front()
    }

    /// Check if there are pending events.
    public fn has_pending(&self) -> Bool {
        self.pending_events.len() > 0
    }

    /// Reset the parser to Ground state, discarding partial sequences.
    public fn reset(&mut self) {
        self.state = ParserState.Ground;
    }

    // =========================================================================
    // Core FSM: process one byte
    // =========================================================================

    fn process_byte(&mut self, byte: Byte) {
        if self.state is ParserState.Ground {
            match byte {
                0x1B => self.state = ParserState.EscapeStart,
                0x0D | 0x0A => self.emit_key(KeyCode.Enter, Modifiers.NONE),
                0x09 => self.emit_key(KeyCode.Tab, Modifiers.NONE),
                0x7F | 0x08 => self.emit_key(KeyCode.Backspace, Modifiers.NONE),
                0x00 => self.emit_key(KeyCode.Null, Modifiers.CTRL),
                b if b >= 1 && b <= 26 => self.emit_key(KeyCode.Char((b - 1 + 0x61) as Char), Modifiers.CTRL),
                b if b >= 0x80 => self.begin_utf8(b),
                b if b >= 0x20 => self.emit_char(b as Char),
                _ => {},
            }
        } else if self.state is ParserState.EscapeStart {
            match byte {
                0x5B => self.state = ParserState.CsiEntry,
                0x4F => self.state = ParserState.SsThree,
                0x5D => self.state = ParserState.OscString { code: 0, data: List.new(), parsing_code: true },
                0x50 => self.state = ParserState.DcsEntry,
                0x1B => self.emit_key(KeyCode.Escape, Modifiers.NONE),
                b if b >= 0x20 && b < 0x7F => {
                    self.emit_key(KeyCode.Char(b as Char), Modifiers.ALT);
                    self.state = ParserState.Ground;
                },
                _ => { self.emit_key(KeyCode.Escape, Modifiers.NONE); self.state = ParserState.Ground; },
            }
        } else if self.state is ParserState.CsiEntry {
            self.state = ParserState.CsiParam {
                params: List.new(), current: -1, has_question: byte == 0x3F, has_lt: byte == 0x3C,
            };
            if byte != 0x3F && byte != 0x3C { self.process_csi_byte(byte); }
        } else if self.state is ParserState.CsiParam {
            self.process_csi_byte(byte);
        } else if self.state is ParserState.CsiIntermediate {
            if byte >= 0x40 && byte <= 0x7E { self.state = ParserState.Ground; }
        } else if self.state is ParserState.SsThree {
            self.parse_ss3(byte);
            self.state = ParserState.Ground;
        } else if self.state is ParserState.OscString {
            self.process_osc_byte(byte);
        } else if self.state is ParserState.DcsEntry {
            if byte == 0x1B { self.state = ParserState.Ground; }
        } else if self.state is ParserState.Utf8Sequence {
            self.process_utf8_byte(byte);
        }
    }

    fn process_osc_byte(&mut self, byte: Byte) {
        if byte == 0x07 || byte == 0x1B {
            self.complete_osc();
            self.state = ParserState.Ground;
            return;
        }
        match &mut self.state {
            ParserState.OscString { ref mut code, ref mut data, ref mut parsing_code } => {
                if *parsing_code && byte == 0x3B {
                    *parsing_code = false;
                } else if *parsing_code && byte >= 0x30 && byte <= 0x39 {
                    let digit = (byte - 0x30) as Int;
                    if *code <= (Int.MAX - digit) / 10 { *code = *code * 10 + digit; }
                } else {
                    data.push(byte);
                }
            },
            _ => {},
        }
    }

    fn process_utf8_byte(&mut self, byte: Byte) {
        if byte < 0x80 || byte > 0xBF {
            self.state = ParserState.Ground;
            return;
        }
        let result: Maybe<Char> = match &mut self.state {
            ParserState.Utf8Sequence { ref mut bytes, ref mut len, expected } => {
                bytes[*len] = byte;
                *len = *len + 1;
                if *len == *expected { Maybe.Some(decode_utf8(bytes, *len)) } else { Maybe.None }
            },
            _ => Maybe.None,
        };
        if let Maybe.Some(ch) = result { self.emit_char(ch); self.state = ParserState.Ground; }
    }

    fn process_csi_byte(&mut self, byte: Byte) {
        if byte >= 0x40 && byte <= 0x7E {
            let event: Maybe<Event> = match &mut self.state {
                ParserState.CsiParam { ref mut params, current, has_lt, has_question } => {
                    params.push(*current);
                    if *has_lt {
                        match parse_sgr_mouse(params, byte) {
                            Maybe.Some(mouse) => Maybe.Some(Event.Mouse(mouse)),
                            Maybe.None => Maybe.None,
                        }
                    } else if *has_question { Maybe.None } else { csi_event(params, byte) }
                },
                _ => Maybe.None,
            };
            self.state = ParserState.Ground;
            if let Maybe.Some(e) = event { self.pending_events.push_back(e); }
            return;
        }
        let valid = match &mut self.state {
            ParserState.CsiParam { ref mut params, ref mut current, has_lt, .. } => {
                if byte >= 0x30 && byte <= 0x39 {
                    let digit = (byte - 0x30) as Int;
                    let value = (*current).max(0);
                    if value > (Int.MAX - digit) / 10 { false } else {
                        *current = value * 10 + digit;
                        true
                    }
                } else if byte == 0x3B && (!*has_lt || params.len() < 2) {
                    params.push(*current);
                    *current = -1;
                    true
                } else { false }
            },
            _ => false,
        };
        if !valid { self.state = ParserState.CsiIntermediate; }
    }

    // =========================================================================
    // SS3 parsing (F1-F4, keypad)
    // =========================================================================

    fn parse_ss3(&mut self, byte: Byte) {
        let code = match byte {
            0x50 => KeyCode.Fn(1),   // ESC O P
            0x51 => KeyCode.Fn(2),   // ESC O Q
            0x52 => KeyCode.Fn(3),   // ESC O R
            0x53 => KeyCode.Fn(4),   // ESC O S
            0x41 => KeyCode.Up,      // ESC O A (some terminals)
            0x42 => KeyCode.Down,    // ESC O B
            0x43 => KeyCode.Right,   // ESC O C
            0x44 => KeyCode.Left,    // ESC O D
            0x48 => KeyCode.Home,    // ESC O H
            0x46 => KeyCode.End,     // ESC O F
            _ => KeyCode.Null,
        };
        self.emit_key(code, Modifiers.NONE);
    }

    // =========================================================================
    // OSC completion
    // =========================================================================

    fn complete_osc(&mut self) {
        match &self.state {
            OscString { code, ref data, .. } => {
                match *code {
                    // OSC 52: clipboard content (base64 encoded)
                    52 => {
                        // Decode paste data — for now just convert bytes to text
                        let text = bytes_to_text(data);
                        self.pending_events.push_back(Event.Paste(text));
                    }
                    // Other OSC codes are informational; ignore for now
                    _ => {}
                }
            }
            _ => {}
        }
    }

    // =========================================================================
    // UTF-8 decoding
    // =========================================================================

    /// Start collecting a UTF-8 multi-byte sequence.
    fn begin_utf8(&mut self, first_byte: Byte) {
        let mut bytes: [Byte; 4] = [0; 4];
        bytes[0] = first_byte;

        let expected = if (first_byte & 0xE0) == 0xC0 {
            2   // 110xxxxx -> 2-byte sequence
        } else if (first_byte & 0xF0) == 0xE0 {
            3   // 1110xxxx -> 3-byte sequence
        } else if (first_byte & 0xF8) == 0xF0 {
            4   // 11110xxx -> 4-byte sequence
        } else {
            // Invalid lead byte — emit replacement character
            self.emit_char('\u{FFFD}');
            return;
        };

        self.state = ParserState.Utf8Sequence {
            bytes: bytes,
            len: 1,
            expected: expected,
        };
    }

    // =========================================================================
    // Event emission helpers
    // =========================================================================

    fn emit_key(&mut self, code: KeyCode, modifiers: Modifiers) {
        self.pending_events.push_back(Event.Key(KeyEvent.with_mods(code, modifiers)));
    }

    fn emit_char(&mut self, ch: Char) {
        self.emit_key(KeyCode.Char(ch), Modifiers.NONE);
    }
}

// =============================================================================
// Utility functions
// =============================================================================

/// Decode a complete CSI independently of the parser state that holds its parameters.
fn csi_event(params: &List<Int>, final_byte: Byte) -> Maybe<Event> {
    let code: KeyCode = match final_byte {
        0x41 => KeyCode.Up,
        0x42 => KeyCode.Down,
        0x43 => KeyCode.Right,
        0x44 => KeyCode.Left,
        0x48 => KeyCode.Home,
        0x46 => KeyCode.End,
        0x5A => return Maybe.Some(Event.Key(KeyEvent.with_mods(KeyCode.BackTab, Modifiers.SHIFT))),
        0x49 => return Maybe.Some(Event.FocusGained),
        0x4F => return Maybe.Some(Event.FocusLost),
        0x7E => {
            let number = if params.len() > 0 { params[0] } else { 0 };
            match number {
                1 => KeyCode.Home,
                2 => KeyCode.Insert,
                3 => KeyCode.Delete,
                4 => KeyCode.End,
                5 => KeyCode.PageUp,
                6 => KeyCode.PageDown,
                15 => KeyCode.Fn(5),
                17 => KeyCode.Fn(6),
                18 => KeyCode.Fn(7),
                19 => KeyCode.Fn(8),
                20 => KeyCode.Fn(9),
                21 => KeyCode.Fn(10),
                23 => KeyCode.Fn(11),
                24 => KeyCode.Fn(12),
                25 => KeyCode.Fn(13),
                26 => KeyCode.Fn(14),
                28 => KeyCode.Fn(15),
                29 => KeyCode.Fn(16),
                31 => KeyCode.Fn(17),
                32 => KeyCode.Fn(18),
                33 => KeyCode.Fn(19),
                34 => KeyCode.Fn(20),
                _ => return Maybe.None
            }
        },
        _ => return Maybe.None,
    };
    Maybe.Some(Event.Key(KeyEvent.with_mods(code, csi_modifiers(params))))
}

fn csi_modifiers(params: &List<Int>) -> Modifiers {
    if params.len() < 2 || params[1] <= 1 { return Modifiers.NONE; }
    let bits = params[1] - 1;
    let mut mods: Modifiers = Modifiers.NONE;
    if (bits & 1) != 0 { mods = mods.union(Modifiers.SHIFT); }
    if (bits & 2) != 0 { mods = mods.union(Modifiers.ALT); }
    if (bits & 4) != 0 { mods = mods.union(Modifiers.CTRL); }
    if (bits & 8) != 0 { mods = mods.union(Modifiers.SUPER); }
    mods
}

/// Decode a UTF-8 byte sequence into a single Char.
fn decode_utf8(bytes: &[Byte; 4], len: Int) -> Char {
    let cp = match len {
        2 => {
            ((bytes[0] & 0x1F) as Int) << 6
                | (bytes[1] & 0x3F) as Int
        }
        3 => {
            ((bytes[0] & 0x0F) as Int) << 12
                | ((bytes[1] & 0x3F) as Int) << 6
                | (bytes[2] & 0x3F) as Int
        }
        4 => {
            ((bytes[0] & 0x07) as Int) << 18
                | ((bytes[1] & 0x3F) as Int) << 12
                | ((bytes[2] & 0x3F) as Int) << 6
                | (bytes[3] & 0x3F) as Int
        }
        _ => 0xFFFD,  // Replacement character
    };
    cp as Char
}

/// Convert a List of bytes to Text (assuming UTF-8).
fn bytes_to_text(data: &List<Byte>) -> Text {
    let mut result = "";
    for i in 0..data.len() {
        result = result + (data[i] as Char).to_text();
    }
    result
}
