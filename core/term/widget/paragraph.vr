// =============================================================================
// paragraph.vr - Paragraph widget (text display with wrapping)
// =============================================================================
@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.term.widget.paragraph;

mount super.protocol.{Widget, Styled};
mount super.block.{Block, Alignment};
mount super.input.grapheme_next;
mount super.super.render.buffer.Buffer;
mount super.super.render.cell.grapheme_width;
mount super.super.layout.rect.Rect;
mount super.super.style.style.Style;

/// Text wrap mode.
public type Wrap is
    | NoWrap       // Truncate at boundary
    | WordWrap     // Wrap at word boundaries
    | CharWrap;    // Wrap at character boundaries

/// A line of styled text — sequence of spans.
public type Line is {
    spans: List<TextSpan>,
};

/// A span — fragment of text with a single style.
public type TextSpan is {
    content: Text,
    style: Style,
};

implement TextSpan {
    /// Create an unstyled span.
    public fn raw(content: Text) -> TextSpan {
        TextSpan { content: content, style: Style.DEFAULT }
    }

    /// Create a styled span.
    public fn styled(content: Text, style: Style) -> TextSpan {
        TextSpan { content: content, style: style }
    }

    /// Borrow the text of this span.
    public fn content(&self) -> &Text { &self.content }

    /// Return the style applied to this span.
    public fn style(&self) -> Style { self.style }

    /// Chain two spans into a Line: span1.then(span2) -> Line.
    public fn then(self, next: TextSpan) -> Line {
        let mut spans = List.new();
        spans.push(self);
        spans.push(next);
        Line { spans: spans }
    }

    /// Get the display width of this span.
    public fn width(&self) -> Int {
        let mut width = 0;
        let mut byte = 0;
        while byte < self.content.len() {
            let next = grapheme_next(&self.content, byte);
            width = width + grapheme_width(&self.content.slice(byte, next));
            byte = next;
        }
        width
    }
}

implement Line {
    /// Create a line from a list of spans.
    public fn from(spans: List<TextSpan>) -> Line {
        Line { spans: spans }
    }

    /// Borrow the spans in display order.
    public fn spans(&self) -> &[TextSpan] { self.spans.as_slice() }

    /// Create a line from raw (unstyled) text.
    public fn raw(text: Text) -> Line {
        let mut spans = List.new();
        spans.push(TextSpan.raw(text));
        Line { spans: spans }
    }

    /// Create a line from a single styled span.
    public fn styled(text: Text, style: Style) -> Line {
        let mut spans = List.new();
        spans.push(TextSpan.styled(text, style));
        Line { spans: spans }
    }

    /// Get the display width of this line.
    public fn width(&self) -> Int {
        let mut w = 0;
        for span in &self.spans {
            w = w + span.width();
        }
        w
    }

    /// Draw the prefix that fits before the exclusive right edge.
    public(in core.term.widget) fn write(
        &self, buf: &mut Buffer, x: Int, y: Int, right: Int, base: Style,
    ) -> Int {
        let mut col = x;
        for span in &self.spans {
            if col >= right { break; }
            let (end, complete) = write_text(buf, col, y, right, &span.content, base.patch(span.style));
            col = end;
            if !complete { break; }
        }
        col
    }
}

/// Write whole graphemes within the row and report whether the whole run fit.
public(in core.term.widget) fn write_text(
    buf: &mut Buffer, x: Int, y: Int, right: Int, text: &Text, style: Style,
) -> (Int, Bool) {
    // A UTF-8 run occupies at most one terminal column per byte.
    if text.len() <= right - x && buf.in_bounds(right - 1, y) {
        return (buf.set_string(x, y, text, style), true);
    }
    let mut byte = 0;
    let mut col = x;
    while byte < text.len() && col < right {
        let next = grapheme_next(text, byte);
        let width = grapheme_width(&text.slice(byte, next)).max(1);
        if width > right - col { break; }
        if col + width > 0 && !buf.in_bounds(col + width - 1, y) { break; }
        col = col + width;
        byte = next;
    }
    if byte == text.len() { return (buf.set_string(x, y, text, style), true); }
    (buf.set_string(x, y, &text.slice(0, byte), style), false)
}

/// Paragraph — displays formatted text with optional wrapping and scrolling.
public type Paragraph is {
    text: List<Line>,
    block: Maybe<Block>,
    style: Style,
    wrap: Wrap,
    scroll: (Int, Int),       // (horizontal_offset, vertical_offset)
    alignment: Alignment,
};

implement Paragraph {
    /// Create a new empty paragraph.
    public fn new() -> Paragraph {
        Paragraph {
            text: List.new(),
            block: Maybe.None,
            style: Style.DEFAULT,
            wrap: Wrap.NoWrap,
            scroll: (0, 0),
            alignment: Alignment.Left,
        }
    }

    // Builder API
    public fn text(self, text: List<Line>) -> Paragraph {
        Paragraph { text: text, ..self }
    }

    public fn block(self, block: Block) -> Paragraph {
        Paragraph { block: Maybe.Some(block), ..self }
    }

    public fn wrap(self, wrap: Wrap) -> Paragraph {
        Paragraph { wrap: wrap, ..self }
    }

    public fn scroll(self, scroll: (Int, Int)) -> Paragraph {
        Paragraph { scroll: scroll, ..self }
    }

    public fn alignment(self, alignment: Alignment) -> Paragraph {
        Paragraph { alignment: alignment, ..self }
    }
}

implement Styled for Paragraph {
    fn style(self, style: Style) -> Paragraph {
        Paragraph { style: style, ..self }
    }
}

implement Widget for Paragraph {
    fn render(&self, area: Rect, buf: &mut Buffer) {
        // Render block and get inner area
        let text_area = match self.block {
            Maybe.Some(block) => {
                let inner = block.inner(area);
                block.render(area, buf);
                inner
            }
            Maybe.None => area,
        };

        if text_area.width() < 1 || text_area.height() < 1 { return; }

        // Apply background style
        buf.set_style(text_area, self.style);

        // Render text lines with scroll offset
        let mut y = text_area.y;
        let skip_lines = self.scroll.1;
        let h_offset = self.scroll.0;

        let mut line_idx = 0;
        for line in &self.text {
            if line_idx < skip_lines {
                line_idx = line_idx + 1;
                continue;
            }
            if y >= text_area.bottom() { break; }

            // Calculate line x position based on alignment
            let line_width = line.width();
            let start_x = match self.alignment {
                Left => text_area.x,
                Center => text_area.x + (text_area.width() - line_width).max(0) / 2,
                Right => text_area.x + (text_area.width() - line_width).max(0),
            };

            line.write(buf, start_x - h_offset, y, text_area.right(), self.style);

            y = y + 1;
            line_idx = line_idx + 1;
        }
    }
}
