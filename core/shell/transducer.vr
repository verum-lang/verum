// =============================================================================
// shell/transducer.vr — Transducer composition for stream pipelines
// =============================================================================
// Layer: 5 (Shell)
// Dependencies: core, base.cell, base.protocols, base.iterator
// =============================================================================
//

// Composable, allocation-free stream operators built on rank-2 polymorphism.
//

// A *reducer* `R(acc, x) -> ReduceResult<acc>` is the universal stream-folding
// shape: any pipeline endpoint (collecting to a List, summing, sending into a
// channel, printing) can be expressed as a reducer.  The `ReduceResult` wrapper
// is what lets a stage say "stop, the answer is final" — see
// `core.base.iterator`, which owns the type.
//

// A *transducer* `T<A, B>` is a transformation of reducers — given a downstream
// reducer over `B`, it produces an equivalent reducer over `A`. Crucially,
// the quantification over the result type `R` lives *inside* the transducer
// (rank-2): the transducer must work for ANY R the caller chooses.
//

// Why rank-2:
//  * Composition is associative without allocation: `compose(t1, compose(t2, t3))`
//  produces the same nested reducer as `compose(compose(t1, t2), t3)`. SMT
//  proof of this identity lives in `vcs/specs/L3-extended/shell/`.
//  * The accumulator never leaks into observable types — pipelines compose
//  without committing to a particular sink shape.
//  * One transducer flows through `List`, async `Stream`, channel `Receiver`,
//  and any other reducible without rewriting.
//

// Implementation note: in current Verum (v0.6) rank-2 fn types are accepted
// in struct fields and as parameters; the implementation here closely follows
// the pattern in `core/async/stream.vr` for explicit closures-over-state.
//

// =============================================================================

module core.shell.transducer;

mount core.{Maybe, Result, List, Bool, Int, Text};
mount core.base.cell.{Cell};
mount core.base.protocols.{Clone};

// =============================================================================
// The algebra itself lives in core.base.iterator — this module only supplies
// shell-flavoured factories over it.
// =============================================================================
//

// `Reducer`, `ReduceResult`, `Transducer` and `StatefulTransducer` are declared
// once, in `core.base.iterator`, and mounted here.  This module used to
// re-declare all three locally; `Transducer` and `StatefulTransducer` were
// character-for-character identical to the base ones, and the local `Reducer`
// was `fn(R, A) -> R` — i.e. it had dropped the `ReduceResult` wrapper, so no
// shell transducer could signal early termination and every driver below
// walked the whole input even after the answer was known.
//

// A reducer is `fn(R, A) -> ReduceResult<R>`: it returns `Continue(acc)` to ask
// for more input, or `Reduced(acc)` to stop the fold.  A transducer transforms
// one reducer into another; the quantification over the accumulator `R` lives
// *inside* the transformation (rank-2), so a transducer works for any sink.

mount core.base.iterator.{Reducer, ReduceResult, Transducer, StatefulTransducer};

// =============================================================================
// Base reducers — building blocks for endpoints
// =============================================================================

// A *sink* is the endpoint of a pipeline, so none of the three below ever
// terminates early on its own: each consumes whatever it is handed and asks
// for more.  Early termination is introduced upstream, by `taking` /
// `taking_while`, and merely travels through these unchanged.

/// Append-to-list reducer. Sink for `transduce_list`.
public fn list_appender<A>() -> Reducer<A, List<A>> {
    |acc: List<A>, x: A| { acc.push(x); ReduceResult.Continue(acc) }
}

/// Counting reducer — discards values, returns the count.
public fn counter<A>() -> Reducer<A, Int> {
    |acc: Int, _x: A| ReduceResult.Continue(acc + 1)
}

/// Identity-discard reducer — used as the unit element for compose() proofs.
public fn drain<A>() -> Reducer<A, ()> {
    |acc: (), _x: A| ReduceResult.Continue(acc)
}

// =============================================================================
// Base transducers
// =============================================================================

/// `mapping(f)` applies `f` to every element flowing through.
/// `f` must be `Pure` (compiler-checked when callers pass `pure fn(...)`).
///
/// Transforming a value neither creates nor absorbs a stop signal, so the
/// downstream's `ReduceResult` is returned verbatim.
public fn mapping<A, B>(f: fn(A) -> B) -> Transducer<A, B> {
    Transducer {
        transform: |reducer: Reducer<B, R>| -> Reducer<A, R> {
            |acc: R, x: A| reducer(acc, f(x))
        },
    }
}

/// `filtering(pred)` lets through only elements satisfying `pred`.
///
/// Rejecting an element is not a reason to stop the fold, so the reject arm
/// answers `Continue`; the accept arm forwards whatever the downstream says.
public fn filtering<A>(pred: fn(&A) -> Bool) -> Transducer<A, A> {
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| if pred(&x) { reducer(acc, x) } else { ReduceResult.Continue(acc) }
        },
    }
}

/// `taking(n)` limits the stream to the first `n` elements. Stateful.
///
/// Terminates the fold as soon as the quota is met — this is the whole point
/// of `ReduceResult`, and it is what the pre-migration local `Reducer` could
/// not express: it used to keep consuming the rest of the input and silently
/// discard it.  `n <= 0` is `Reduced` on the very first element, so nothing
/// downstream is ever invoked.
public fn taking<A>(n: Int) -> Transducer<A, A> {
    let counter = Cell.new(0);
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                let cur = counter.get();
                if cur < n {
                    counter.set(cur + 1);
                    // The element that fills the quota is still delivered;
                    // the fold stops immediately after it.
                    match reducer(acc, x) {
                        ReduceResult.Continue(next) => {
                            if cur + 1 >= n {
                                ReduceResult.Reduced(next)
                            } else {
                                ReduceResult.Continue(next)
                            }
                        }
                        ReduceResult.Reduced(next) => ReduceResult.Reduced(next),
                    }
                } else {
                    ReduceResult.Reduced(acc)
                }
            }
        },
    }
}

/// `dropping(n)` skips the first `n` elements.
///
/// Skipping is never a reason to stop: the interesting elements are the ones
/// still to come.  Only the downstream can terminate this stage.
public fn dropping<A>(n: Int) -> Transducer<A, A> {
    let counter = Cell.new(0);
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                let cur = counter.get();
                if cur < n {
                    counter.set(cur + 1);
                    ReduceResult.Continue(acc)
                } else {
                    reducer(acc, x)
                }
            }
        },
    }
}

/// `taking_while(pred)` lets through elements until `pred` fails.
/// After the first false, the fold stops.
///
/// The `still_taking` cell is retained rather than relying solely on the
/// `Reduced` signal: a transducer may be driven by a caller that chooses to
/// ignore early termination, and the predicate must not be re-tested against
/// later elements once it has failed.
public fn taking_while<A>(pred: fn(&A) -> Bool) -> Transducer<A, A> {
    let still_taking = Cell.new(true);
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                if !still_taking.get() { return ReduceResult.Reduced(acc); }
                if pred(&x) {
                    reducer(acc, x)
                } else {
                    still_taking.set(false);
                    ReduceResult.Reduced(acc)
                }
            }
        },
    }
}

/// `dropping_while(pred)` skips elements while `pred` holds, then lets all
/// subsequent elements through.
///
/// Like `dropping`, discarding a prefix is never grounds to stop.
public fn dropping_while<A>(pred: fn(&A) -> Bool) -> Transducer<A, A> {
    let dropped = Cell.new(false);
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                if dropped.get() { return reducer(acc, x); }
                if pred(&x) { ReduceResult.Continue(acc) }
                else        { dropped.set(true); reducer(acc, x) }
            }
        },
    }
}

/// `dedup_consecutive` removes adjacent duplicates. Requires `Eq + Clone`.
///
/// Suppressing a duplicate is a filter decision, not a stop decision.
public fn dedup_consecutive<A: Eq + Clone>() -> Transducer<A, A> {
    let prev: Cell<Maybe<A>> = Cell.new(Maybe.None);
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                let same = match prev.get() {
                    Maybe.Some(p) => p == x,
                    Maybe.None    => false,
                };
                prev.set(Maybe.Some(x.clone()));
                if same { ReduceResult.Continue(acc) } else { reducer(acc, x) }
            }
        },
    }
}

/// `flat_mapping(f)` produces a list of B per A and flattens.
///
/// One input element expands to many downstream steps, so termination has to
/// be honoured *within* the expansion: if the downstream says `Reduced`
/// part-way through `f(x)`, the remaining elements of that same list are not
/// delivered, and the signal propagates upward.
public fn flat_mapping<A, B>(f: fn(A) -> List<B>) -> Transducer<A, B> {
    Transducer {
        transform: |reducer: Reducer<B, R>| -> Reducer<A, R> {
            |acc: R, x: A| {
                let mut a = acc;
                for y in f(x).into_iter() {
                    match reducer(a, y) {
                        ReduceResult.Continue(next) => { a = next; }
                        ReduceResult.Reduced(next)  => { return ReduceResult.Reduced(next); }
                    }
                }
                ReduceResult.Continue(a)
            }
        },
    }
}

/// `tap(f)` performs a side effect per element, passes the value through.
/// Useful for logging. Note: `tap` admits IO via `f`; the resulting
/// transducer is no longer Pure — caller must annotate accordingly.
///
/// The side effect fires for every element `tap` is handed, including the one
/// on which the downstream terminates; the downstream's answer is forwarded
/// unchanged.
public fn tap<A>(f: fn(&A)) -> Transducer<A, A> {
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| { f(&x); reducer(acc, x) }
        },
    }
}

// =============================================================================
// compose — associative composition
// =============================================================================

/// `compose(t1, t2)` = `t1` applied first, then `t2` over the resulting stream.
/// Equational law (proven separately): `compose(t1, compose(t2, t3))`
/// is observationally equal to `compose(compose(t1, t2), t3)`.
public fn compose<A, B, C>(
    t1: Transducer<A, B>,
    t2: Transducer<B, C>,
) -> Transducer<A, C> {
    Transducer {
        transform: |reducer: Reducer<C, R>| -> Reducer<A, R> {
            (t1.transform)((t2.transform)(reducer))
        },
    }
}

/// `compose3` — three-way fold over compose. Pure sugar.
public fn compose3<A, B, C, D>(
    t1: Transducer<A, B>,
    t2: Transducer<B, C>,
    t3: Transducer<C, D>,
) -> Transducer<A, D> {
    compose(t1, compose(t2, t3))
}

/// `identity` — the unit element for `compose`. `compose(identity, t) == t`,
/// `compose(t, identity) == t`.
public fn identity<A>() -> Transducer<A, A> {
    Transducer {
        transform: |reducer: Reducer<A, R>| -> Reducer<A, R> {
            |acc: R, x: A| reducer(acc, x)
        },
    }
}

// =============================================================================
// Apply: drive a transducer over a List producing a new collection
// =============================================================================

// Every driver below stops pulling from the input the moment the pipeline
// answers `Reduced`, and returns the accumulator carried by that answer.  The
// match idiom mirrors `core.base.iterator`'s `reduce_with`, which is the
// reference implementation of an early-terminating fold.

/// Transduces a `List<A>` into `List<B>`. Single pass, no intermediate
/// buffers per stage — the entire pipeline collapses into one inlined fold.
public fn transduce_list<A, B>(xs: List<A>, t: Transducer<A, B>) -> List<B> {
    let reducer: Reducer<B, List<B>> = list_appender();
    let stream_reducer: Reducer<A, List<B>> = (t.transform)(reducer);
    let mut acc: List<B> = [];
    for x in xs.into_iter() {
        match stream_reducer(acc, x) {
            ReduceResult.Continue(next) => acc = next,
            ReduceResult.Reduced(final_acc) => return final_acc,
        }
    }
    acc
}

/// Transduces a `List<A>` into a single accumulator value.
public fn transduce_into<A, B, R>(
    xs: List<A>,
    t: Transducer<A, B>,
    initial: R,
    sink: Reducer<B, R>,
) -> R {
    let stream_reducer: Reducer<A, R> = (t.transform)(sink);
    let mut acc = initial;
    for x in xs.into_iter() {
        match stream_reducer(acc, x) {
            ReduceResult.Continue(next) => acc = next,
            ReduceResult.Reduced(final_acc) => return final_acc,
        }
    }
    acc
}

// =============================================================================
// StatefulTransducer — when the state must outlive the reducer's lifetime
// =============================================================================
//

// Use this when the state is large enough that you don't want it captured
// by the closure (e.g. windowing buffers, debounce trackers). The state is
// supplied externally and threaded through.
//

// `StatefulTransducer` is mounted from `core.base.iterator` above; the factories
// that build one (`take`, `drop`, `drop_while`, `dedupe`, `enumerate`) live
// there too.  This module contributes only the list driver below.

/// Drive a stateful transducer.
public fn transduce_stateful<A, B, S, R>(
    xs: List<A>,
    t: StatefulTransducer<A, B, S>,
    initial: R,
    sink: Reducer<B, R>,
) -> R {
    let mut state = t.initial_state;
    let stream_reducer: Reducer<A, R> = (t.transform)(sink, &mut state);
    let mut acc = initial;
    for x in xs.into_iter() {
        match stream_reducer(acc, x) {
            ReduceResult.Continue(next) => acc = next,
            ReduceResult.Reduced(final_acc) => return final_acc,
        }
    }
    acc
}
