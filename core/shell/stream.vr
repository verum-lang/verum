// =============================================================================
// shell/stream.vr — Streaming output with backpressure
// =============================================================================
// Layer: 5 (Shell)
// Dependencies: shell.{exec, result, context}, async.{channel, cancellation, generator}, io.process
// =============================================================================
//

// Long-running commands (`tail -f`, `journalctl -f`, `tcpdump`, `cargo
// watch`) emit a continuous stream of stdout. Naive `read-to-EOF` doesn't
// work and naive `fn*` yields can flood memory if the producer outpaces
// the consumer.
//

// The line generator and bounded receiver share one producer. It polls the
// child, buffers partial UTF-8 lines, and reaps on exit or cancellation.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.shell.stream;

mount core.{Maybe, Result, List, Text, Byte, Bool, Int};
mount core.base.protocols.{Display, Debug, Clone};
mount core.async.channel.{
    Sender, Receiver, bounded,
    TrySendError,
};
mount core.async.cancellation.{CancellationToken, CancellationTokenSource};
mount core.async.task.{spawn};
mount core.io.process.{Command, Child, ExitStatus, Stdio};
mount core.shell.context.{ShellContext};
mount core.shell.jobs.{JobHandle};
mount core.shell.result.{ShellResult, ShellError};

// =============================================================================
// OverflowPolicy — what to do when the consumer can't keep up
// =============================================================================

public type OverflowPolicy is
    /// Producer awaits free space — true backpressure. Default.
    | Block
    /// Drop the oldest queued item; insert the new one.
    | DropOldest
    /// Discard the new item; queue stays as-is.
    | DropNewest
    /// Sample every Nth item (drop the others).
    | Sample(Int)
    /// When full, consume the oldest line and append `f(oldest, new)` as the newest.
    | Coalesce(fn(Text, Text) -> Text);

implement Clone for OverflowPolicy {
    fn clone(&self) -> OverflowPolicy {
        match self {
            Block          => Block,
            DropOldest     => DropOldest,
            DropNewest     => DropNewest,
            Sample(n)      => Sample(*n),
            Coalesce(f)    => Coalesce(*f),
        }
    }
}

// =============================================================================
// StreamConfig — tunables
// =============================================================================

public type StreamConfig is {
    /// Bounded channel capacity (lines).
    buffer:        Int,
    /// What to do on overflow.
    on_overflow:   OverflowPolicy,
    /// FD read chunk size in bytes.
    read_chunk:    Int,
    /// Total stdout byte budget for the producer, including line delimiters.
    /// `0` = no limit. Default 16 MiB.
    max_memory:    Int,
}

implement StreamConfig {
    public fn default() -> StreamConfig {
        StreamConfig {
            buffer:      256,
            on_overflow: OverflowPolicy.Block,
            read_chunk:  8192,
            max_memory:  16 * 1024 * 1024,
        }
    }

    /// Lossy preset: small buffer, drop-oldest. Use for metrics-style fast
    /// producers where freshness matters more than completeness.
    public fn lossy(buffer: Int) -> StreamConfig {
        let mut c = StreamConfig.default();
        c.buffer = buffer;
        c.on_overflow = OverflowPolicy.DropOldest;
        c
    }

    /// Sampled preset: keep every Nth line.
    public fn sampled(buffer: Int, every_n: Int) -> StreamConfig {
        let mut c = StreamConfig.default();
        c.buffer = buffer;
        c.on_overflow = OverflowPolicy.Sample(every_n);
        c
    }
}

implement Clone for StreamConfig {
    fn clone(&self) -> StreamConfig {
        StreamConfig {
            buffer:      self.buffer,
            on_overflow: self.on_overflow.clone(),
            read_chunk:  self.read_chunk,
            max_memory:  self.max_memory,
        }
    }
}

// =============================================================================
// LineStream — handle pair returned by stream_lines_bounded
// =============================================================================

public type LineStream is {
    /// The receiver of UTF-8 lines (without trailing newline). `Maybe.None` =
    /// stream ended (process exited normally).
    pub receiver: Receiver<Result<Text, ShellError>>,
    /// Job driving the producer. `await()` to wait for child exit;
    /// `kill()` to terminate.
    pub job:      JobHandle,
}

implement LineStream {
    /// Drains the receiver into a List. Useful in tests.
    pub async fn collect(&mut self) -> Result<List<Text>, ShellError> {
        let mut out: List<Text> = [];
        loop {
            match self.receiver.recv_fut().await {
                Maybe.None        => return Result.Ok(out),
                Maybe.Some(Result.Ok(s)) => out.push(s),
                Maybe.Some(Result.Err(e)) => return Result.Err(e),
            }
        }
    }

    /// Drives the consumer with a side-effecting closure. Stops when the
    /// receiver is exhausted or the closure returns `false`.
    pub async fn for_each(&mut self, f: fn(&Text) -> Bool) -> Result<(), ShellError> {
        loop {
            match self.receiver.recv_fut().await {
                Maybe.None        => return Result.Ok(()),
                Maybe.Some(Result.Ok(s)) => if !f(&s) { return Result.Ok(()); },
                Maybe.Some(Result.Err(e)) => return Result.Err(e),
            }
        }
    }
}

// =============================================================================
// stream_lines — simple async-generator API for moderate streams
// =============================================================================
//

/// Yield stdout lines with bounded prefetch and no total output cap.
public async fn* stream_lines(cmd_text: &Text) -> Result<Text, ShellError> {
    let mut config = StreamConfig.default();
    config.max_memory = 0;
    let mut stream = match stream_lines_bounded(cmd_text, config).await {
        Result.Ok(stream) => stream,
        Result.Err(error) => { yield Result.Err(error); return; },
    };
    while let Maybe.Some(line) = stream.receiver.recv_fut().await {
        yield line;
    }
}

fn strip_trailing_newline(s: Text) -> Text {
    let line = match s.strip_suffix("\n") { Maybe.Some(line) => line, Maybe.None => s };
    match line.strip_suffix("\r") { Maybe.Some(line) => line, Maybe.None => line }
}

// =============================================================================
// stream_lines_bounded — backpressure-aware variant
// =============================================================================

/// Spawns the command and returns a `LineStream` whose receiver is a
/// bounded channel of size `config.buffer`. Cancellation propagates through
/// `LineStream.job.kill()`.
pub async fn stream_lines_bounded(
    cmd_text: &Text,
    config: StreamConfig,
) -> Result<LineStream, ShellError>

{
    if config.buffer <= 0 || config.read_chunk <= 0 || config.max_memory < 0 {
        return Result.Err(ShellError.SpawnFailed {
            command: cmd_text.clone(), reason: "invalid stream buffer, read size, or byte limit",
        });
    }
    if let OverflowPolicy.Sample(n) = &config.on_overflow {
        if *n <= 0 {
            return Result.Err(ShellError.SpawnFailed {
                command: cmd_text.clone(), reason: "sample interval must be positive",
            });
        }
    }
    let ctx = ShellContext.default();
    let shell_prog = ctx.resolve_shell();
    let flag = ctx.shell_command_flag();

    let mut command = Command.new(shell_prog);
    command.arg(flag);
    command.arg(cmd_text.clone());
    ctx.configure_command(&mut command);
    command.stdout(Stdio.Piped);

    let child = command.spawn().map_err(|reason| ShellError.SpawnFailed {
        command: cmd_text.clone(),
        reason,
    })?;

    let (tx, rx): (Sender<Result<Text, ShellError>>, Receiver<Result<Text, ShellError>>) = bounded(config.buffer);
    let cancel = CancellationTokenSource.new();
    let token = cancel.token();
    let cmd_for_producer = cmd_text.clone();
    let read_chunk = config.read_chunk;
    let mem_limit = config.max_memory;
    let policy = config.on_overflow.clone();

    // Producer task — reads lines, applies overflow policy, watches cancel.
    let task = spawn(async move {
        pump_lines(child, tx, &token, cmd_for_producer, read_chunk, mem_limit, &policy).await
    });

    Result.Ok(LineStream {
        receiver: rx,
        job: JobHandle.from_task(task, cancel, cmd_text.clone()),
    })
}

/// One producer owns both the read end and the unreaped child. A partial
/// line remains buffered across polls, including across UTF-8 boundaries.
async fn pump_lines(
    mut child: Child, tx: Sender<Result<Text, ShellError>>, token: &CancellationToken,
    command: Text, read_chunk: Int, mem_limit: Int, policy: &OverflowPolicy,
) -> Result<ShellResult, ShellError> {
    let start = core.time.instant.Instant.now();
    let mut status: Maybe<ExitStatus> = Maybe.None;
    let mut pending: List<Byte> = [];
    let mut seen: Int = 0;
    let mut sample_counter: Int = 0;
    let mut failure: Maybe<ShellError> = Maybe.None;
    loop {
        if status.is_none() {
            match child.try_wait() {
                Result.Ok(s) => { status = s; },
                Result.Err(reason) => {
                    child.close_output();
                    return finish_stream_error(&tx, ShellError.SpawnFailed { command, reason });
                },
            }
        }
        if tx.is_closed() {
            failure = Maybe.Some(stream_stopped(&command, token));
            break;
        }
        if let Maybe.Some(reason) = token.reason() {
            failure = Maybe.Some(ShellError.Cancelled { command: command.clone(), reason: reason.message() });
            break;
        }
        let chunk: Maybe<List<Byte>> = match child.read_stdout_ready(read_chunk) {
            Result.Ok(value) => value,
            Result.Err(reason) => {
                failure = Maybe.Some(ShellError.SpawnFailed { command: command.clone(), reason });
                break;
            },
        };
        if let Maybe.Some(bytes) = chunk {
            let eof = bytes.is_empty();
            for byte in bytes {
                seen = seen + 1;
                if mem_limit > 0 && seen > mem_limit {
                    failure = Maybe.Some(ShellError.SpawnFailed { command: command.clone(),
                        reason: f"stdout byte limit ({mem_limit} bytes) exceeded" });
                    break;
                }
                pending.push(byte);
                if byte != ('\n' as Byte) { continue; }
                if let Result.Err(error) = publish_line(&pending, &tx, policy, &mut sample_counter, token, &command).await {
                    failure = Maybe.Some(error);
                    break;
                }
                pending.clear();
            }
            if failure.is_some() { break; }
            if eof && !pending.is_empty() {
                if let Result.Err(error) = publish_line(&pending, &tx, policy, &mut sample_counter, token, &command).await {
                    failure = Maybe.Some(error);
                }
                pending.clear();
            }
            if failure.is_some() { break; }
            core.async.task.yield_now().await;
        } else if child.output_is_closed() && status.is_some() {
            return Result.Ok(ShellResult.new(status.unwrap(), [], [], command, start.elapsed()));
        } else {
            core.async.timer.sleep_ms(1).await;
        }
    }
    child.close_output();
    if status.is_none() { let _ = child.kill(); let _ = child.wait(); }
    finish_stream_error(&tx, failure.unwrap())
}

fn finish_stream_error(tx: &Sender<Result<Text, ShellError>>, error: ShellError) -> Result<ShellResult, ShellError> {
    // The stream has one producer. Reserve room for the terminal error even
    // when the consumer has stopped reading; joining the job must still finish.
    let _ = tx.take_oldest_if_full();
    let _ = tx.try_send(Result.Err(error.clone()));
    Result.Err(error)
}

async fn publish_line(
    bytes: &List<Byte>, tx: &Sender<Result<Text, ShellError>>, policy: &OverflowPolicy,
    sample_counter: &mut Int, token: &CancellationToken, command: &Text,
) -> Result<(), ShellError> {
    let line = Text.from_utf8(bytes.as_slice()).map_err(|_| ShellError.SpawnFailed {
        command: command.clone(), reason: "invalid UTF-8 in child stdout".into(),
    })?;
    let sent = route_via_policy(tx, Result.Ok(strip_trailing_newline(line)), policy, sample_counter, token).await;
    if sent { Result.Ok(()) } else { Result.Err(stream_stopped(command, token)) }
}

fn stream_stopped(command: &Text, token: &CancellationToken) -> ShellError {
    match token.reason() {
        Maybe.Some(r) => ShellError.Cancelled { command: command.clone(), reason: r.message() },
        Maybe.None => ShellError.SpawnFailed { command: command.clone(), reason: "stream receiver closed" },
    }
}

/// Return the pending item on backpressure so cancellation can be observed
/// even while a connected consumer has stopped draining the channel.
async fn route_via_policy(
    tx: &Sender<Result<Text, ShellError>>, mut item: Result<Text, ShellError>,
    policy: &OverflowPolicy, sample_counter: &mut Int, token: &CancellationToken,
) -> Bool {
    if let OverflowPolicy.Sample(n) = policy {
        let index = *sample_counter;
        *sample_counter = index + 1;
        if index % *n != 0 { return true; }
    }
    loop {
        if token.is_cancelled() { return false; }
        match tx.try_send(item) {
            Result.Ok(_) => return true,
            Result.Err(TrySendError.Disconnected(_)) => return false,
            Result.Err(TrySendError.Full(value)) => {
                match policy {
                    DropNewest => return true,
                    DropOldest => {
                        let _ = tx.take_oldest_if_full();
                        item = value;
                    },
                    Coalesce(merge) => {
                        item = match (tx.take_oldest_if_full(), value) {
                            (Maybe.Some(Result.Ok(old)), Result.Ok(new)) => Result.Ok(merge(old, new)),
                            (_, current) => current,
                        };
                    },
                    _ => {
                        item = value;
                        core.async.timer.sleep_ms(1).await;
                    },
                }
            },
        }
    }
}
