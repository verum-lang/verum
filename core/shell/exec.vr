// =============================================================================
// shell/exec.vr — Shell command executor
// =============================================================================
// Layer: 5 (Shell)
// Dependencies: core, io.process, time, async.cancellation, shell.{escape, result, context}
// =============================================================================
//

// Two layered APIs:
//

//  * `run(program, args)` — direct exec without shell interpretation. The
//  argv is built explicitly; nothing the caller passes is interpreted as
//  shell metacharacters. Equivalent to `execvp` / `CreateProcessA`.
//  * `sh(cmd_text)` — shell dispatch via `<shell> -c "<cmd>"`. The caller's
//  command text is fed to the shell and *will* be parsed; auto-escape
//  in `sh#"..."` literals lifts user data through `ShellEscape` so
//  interpolations are individual safe tokens.
//

// Both functions:
//  * apply the active `ShellContext` (cwd, env, flavour, permissions)
//  * intercept through `ShellContext.mock` when set — no real spawn
//  * record the dispatched line for diagnostics
//  * measure wall-clock duration
//  * surface failure as a typed `ShellError`
//

// Execution is implemented synchronously for the interpreter path (Tier 0)
// and as `async fn` returning a Future in compiled paths so it composes with
// nursery / select / cancellation. The async surface is what callers should
// always reach for; the sync path falls out automatically when the runtime
// ticks the future to completion.
//

// =============================================================================

@arch_module(
    exposes: [Capability.Spawn(TaskLifetime.Detached), Capability.Exec(ExecTarget.Program("*"))],
    requires: [Capability.Exec(ExecTarget.Syscall(0))],
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LCls,
    lifecycle: Lifecycle.Definition
)
module core.shell.exec;

mount core.{Maybe, Result, List, Text};
mount core.base.protocols.{Display, Debug, Clone};
mount core.io.process.{Child, Command, ExitStatus, Stdio};
mount core.async.future.Future;
mount core.async.poll.Poll;
mount core.async.waker.{Context, Waker};
mount core.base.memory.{Shared, drop, replace};
mount core.sync.{AtomicBool, MemoryOrdering, Send};
mount core.time.duration.{Duration};
mount core.time.instant.{Instant};
mount core.async.cancellation.{CancellationToken};
mount core.shell.escape.{ShellFlavour, ShellEscape, default_flavour};
mount core.shell.result.{ShellResult, ShellError};
mount core.shell.context.{ShellContext, MockResponse, PermissionSet};

// =============================================================================
// run() — exec a program with explicit argv (no shell interpretation)
// =============================================================================

/// Executes `program` with `args` and returns the captured result.
/// Honours the active `ShellContext` (cwd, env, permissions, mock).
///

/// This is the *recommended primitive* for programmatic dispatch — the
/// argv structure is preserved, no shell parsing happens between the
/// caller and the kernel exec.
public async fn run(program: &Text, args: List<Text>)
    -> Result<ShellResult, ShellError>

{
    let request = ProcessRequest.Program(program.clone(), args, true);
    ProcessFuture.new(request, JobCancellation.new(), Duration.zero()).await
}

// =============================================================================
// sh() — exec a command through the active shell
// =============================================================================

/// Executes `cmd_text` through `<shell> -c "<cmd>"`. The text *is* parsed
/// by the shell — auto-escape in `sh#"..."` literals already lifted any
/// embedded values into safe tokens, so this is the standard path.
///

/// Returns a `ShellResult` regardless of exit status; call `.ok()?` on
/// the result to convert non-zero exits into `Err`.
public async fn sh(cmd_text: &Text) -> ShellResult {
    match sh_check(cmd_text).await {
        Result.Ok(r)  => r,
        Result.Err(e) => ShellResult.from_error(e),
    }
}

/// Like `sh()` but returns `Result<ShellResult, ShellError>` so the `?`
/// operator works at the call site without an extra `.ok()`.
public async fn sh_check(cmd_text: &Text)
    -> Result<ShellResult, ShellError>

{
    let request = ProcessRequest.Script(cmd_text.clone());
    ProcessFuture.new(request, JobCancellation.new(), Duration.zero()).await
}

/// Executes an argv command with cancellable, bounded reads from both child pipes.
public async fn run_with_cancel(
    program: &Text, args: List<Text>, token: &CancellationToken, grace: Duration,
) -> Result<ShellResult, ShellError> {
    let request = ProcessRequest.Program(program.clone(), args, false);
    ProcessFuture.new(request, token.clone(), grace).await
}

/// Executes a cancellable command through the configured shell.
public async fn sh_with_cancel(
    cmd_text: &Text, token: &CancellationToken, grace: Duration,
) -> Result<ShellResult, ShellError> {
    let request = ProcessRequest.CancellableScript(cmd_text.clone());
    ProcessFuture.new(request, token.clone(), grace).await
}

type ProcessRequest is Program(Text, List<Text>, Bool) | Script(Text) | CancellableScript(Text);
type ProcessStep is Progress | Waiting | Exited(ExitStatus) | Failed(ShellError);

type ProcessCancellation is protocol {
    fn cancellation_message(&self) -> Maybe<Text>;
};

implement ProcessCancellation for CancellationToken {
    fn cancellation_message(&self) -> Maybe<Text> {
        match self.reason() {
            Maybe.Some(reason) => Maybe.Some(reason.message()),
            Maybe.None => Maybe.None,
        }
    }
}

// Job handles can request cancellation from another thread. Only this flag
// crosses that boundary. The polling task owns the child and both output pipes.
public(in super) type JobCancellation is { requested: Shared<AtomicBool> };
implement Send for JobCancellation {}

implement JobCancellation {
    public(in super) fn new() -> JobCancellation {
        JobCancellation { requested: Shared.new(AtomicBool.new(false)) }
    }

    public(in super) fn clone(&self) -> JobCancellation {
        JobCancellation { requested: self.requested.clone() }
    }

    public(in super) fn cancel(&self) {
        self.requested.store(true, MemoryOrdering.Release);
    }
}

implement ProcessCancellation for JobCancellation {
    fn cancellation_message(&self) -> Maybe<Text> {
        if self.requested.load(MemoryOrdering.Acquire) { Maybe.Some("cancelled") } else { Maybe.None }
    }
}

type affine RunningProcess is {
    child: Child,
    command: Text,
    start: Instant,
    stdout: List<Byte>,
    stderr: List<Byte>,
    status: Maybe<ExitStatus>,
    owns_pid: Bool,
    cancellation: Maybe<Text>,
    terminate_at: Maybe<Instant>,
};

implement RunningProcess {
    fn start(
        request: ProcessRequest, cancellation: Maybe<Text>, active: &mut Maybe<RunningProcess>,
    ) -> Result<Maybe<ShellResult>, ShellError> {
        let ctx = ShellContext.default();
        let (program, args, display_cmd, verbose_dispatch): (Text, List<Text>, Text, Bool) = match request {
            ProcessRequest.Program(program, args, verbose) => {
                let label = render_argv(&program, &args);
                (program, args, label, verbose)
            },
            ProcessRequest.Script(text) => {
                let args: List<Text> = [ctx.shell_command_flag(), text.clone()];
                (ctx.resolve_shell(), args, text, true)
            },
            ProcessRequest.CancellableScript(text) => {
                let program = ctx.resolve_shell();
                let args: List<Text> = [ctx.shell_command_flag(), text];
                let label = render_argv(&program, &args);
                (program, args, label, false)
            },
        };
        ctx.permissions.check_run(&program)?;
        if verbose_dispatch && ctx.verbose { log_dispatched(&display_cmd); }
        if ctx.dry_run { return Result.Ok(Maybe.Some(synthesise_dry_run(display_cmd))); }
        if let Maybe.Some(mut mock) = ctx.mock.clone() {
            match mock.dispatch(&display_cmd) {
                Maybe.Some(response) => {
                    return Result.Ok(Maybe.Some(synthesise_mock_result(response, display_cmd)));
                },
                Maybe.None => if ctx.mock.as_ref().unwrap().strict_no_match {
                    let reason = if verbose_dispatch {
                        "no mock response matched and strict_no_match=true"
                    } else { "no mock response matched" };
                    return Result.Err(ShellError.SpawnFailed { command: display_cmd, reason });
                },
            }
        }
        if let Maybe.Some(reason) = cancellation {
            return Result.Err(ShellError.Cancelled { command: display_cmd, reason });
        }

        let start = Instant.now();
        let mut command = Command.new(program);
        command.args(args.as_slice());
        ctx.configure_command(&mut command);
        command.stdout(Stdio.Piped);
        command.stderr(Stdio.Piped);
        match command.spawn() {
            Result.Err(reason) => Result.Err(ShellError.SpawnFailed { command: display_cmd, reason }),
            Result.Ok(child) => {
                *active = Maybe.Some(RunningProcess {
                    child, command: display_cmd, start, stdout: [], stderr: [],
                    status: Maybe.None, owns_pid: true, cancellation: Maybe.None, terminate_at: Maybe.None,
                });
                Result.Ok(Maybe.None)
            },
        }
    }

    fn stop(&mut self) {
        self.child.close_output();
        if self.owns_pid {
            let _ = self.child.kill();
            let _ = self.child.wait();
            self.owns_pid = false;
        }
    }

    fn step(&mut self, cancellation: Maybe<Text>, grace: Duration) -> ProcessStep {
        if self.owns_pid {
            match self.child.try_wait() {
                Result.Ok(Maybe.Some(status)) => {
                    self.owns_pid = false;
                    self.status = Maybe.Some(status);
                },
                Result.Ok(Maybe.None) => {},
                Result.Err(reason) => {
                    // The OS can no longer confirm ownership of this PID.
                    self.owns_pid = false;
                    return ProcessStep.Failed(ShellError.SpawnFailed { command: self.command.clone(), reason });
                },
            }
        }
        if self.cancellation.is_none() {
            if let Maybe.Some(reason) = cancellation {
                self.cancellation = Maybe.Some(reason);
                if self.owns_pid {
                    let _ = self.child.terminate();
                    self.terminate_at = Maybe.Some(Instant.now());
                }
            }
        }
        let grace_expired = match &self.terminate_at {
            Maybe.Some(sent) => sent.elapsed().as_millis() >= grace.as_millis(),
            Maybe.None => false,
        };
        if self.owns_pid && grace_expired {
            let _ = self.child.kill();
            self.terminate_at = Maybe.None;
        }
        if !self.owns_pid {
            let empty: Maybe<Text> = Maybe.None;
            if let Maybe.Some(reason) = replace(&mut self.cancellation, empty) {
                return ProcessStep.Failed(ShellError.Cancelled { command: self.command.clone(), reason });
            }
        }

        let mut progress = false;
        match self.child.read_stdout_ready(65536) {
            Result.Ok(Maybe.Some(bytes)) => { for b in bytes { self.stdout.push(b); } progress = true; },
            Result.Err(reason) => return ProcessStep.Failed(ShellError.SpawnFailed { command: self.command.clone(), reason }),
            _ => {},
        }
        match self.child.read_stderr_ready(65536) {
            Result.Ok(Maybe.Some(bytes)) => { for b in bytes { self.stderr.push(b); } progress = true; },
            Result.Err(reason) => return ProcessStep.Failed(ShellError.SpawnFailed { command: self.command.clone(), reason }),
            _ => {},
        }
        if self.child.output_is_closed() {
            let empty: Maybe<ExitStatus> = Maybe.None;
            if let Maybe.Some(status) = replace(&mut self.status, empty) { return ProcessStep.Exited(status); }
        }
        if progress { ProcessStep.Progress } else { ProcessStep.Waiting }
    }

    fn finish(&mut self, status: ExitStatus) -> ShellResult {
        let stdout: List<Byte> = [];
        let stderr: List<Byte> = [];
        ShellResult.new(status, replace(&mut self.stdout, stdout), replace(&mut self.stderr, stderr),
            self.command.clone(), self.start.elapsed())
    }
}

implement Drop for RunningProcess {
    fn drop(&mut self) { self.stop(); }
}

public(in super) type ProcessFuture<C> is {
    request: Maybe<ProcessRequest>, active: Maybe<RunningProcess>, cancel: C, grace: Duration,
};

// A live process transfers its sole OS handle, the owned descriptors and buffers
// with the future. Its source of cancellation must independently support transfer.
implement<C: Send> Send for ProcessFuture<C> {}

implement<C> ProcessFuture<C> {
    fn new(request: ProcessRequest, cancel: C, grace: Duration) -> ProcessFuture<C> {
        let grace = if grace.as_millis() == 0 { Duration.from_millis(5000) } else { grace };
        ProcessFuture { request: Maybe.Some(request), active: Maybe.None, cancel, grace }
    }
}

implement<C: ProcessCancellation> Future for ProcessFuture<C> {
    type Output = Result<ShellResult, ShellError>;

    fn poll(&mut self, cx: &mut Context) -> Poll<Result<ShellResult, ShellError>> {
        let empty: Maybe<ProcessRequest> = Maybe.None;
        if let Maybe.Some(request) = replace(&mut self.request, empty) {
            match RunningProcess.start(request, self.cancel.cancellation_message(), &mut self.active) {
                Result.Ok(Maybe.None) => {},
                Result.Ok(Maybe.Some(result)) => return Poll.Ready(Result.Ok(result)),
                Result.Err(error) => return Poll.Ready(Result.Err(error)),
            }
        }
        let cancellation = self.cancel.cancellation_message();
        let step = match &mut self.active {
            Maybe.Some(process) => process.step(cancellation, self.grace),
            Maybe.None => panic("shell process polled after completion"),
        };
        match step {
            ProcessStep.Progress => { cx.waker().wake_by_ref(); Poll.Pending },
            ProcessStep.Waiting => {
                schedule_pipe_retry(cx.waker().clone());
                Poll.Pending
            },
            ProcessStep.Exited(status) => {
                let result = match &mut self.active {
                    Maybe.Some(process) => process.finish(status),
                    Maybe.None => unreachable(),
                };
                let empty: Maybe<RunningProcess> = Maybe.None;
                drop(replace(&mut self.active, empty));
                Poll.Ready(Result.Ok(result))
            },
            ProcessStep.Failed(error) => {
                let empty: Maybe<RunningProcess> = Maybe.None;
                drop(replace(&mut self.active, empty));
                Poll.Ready(Result.Err(error))
            },
        }
    }
}

fn schedule_pipe_retry(waker: Waker) {
    let runtime = match core.async.executor.current_runtime() {
        Maybe.Some(runtime) => runtime,
        Maybe.None => { waker.wake(); return; },
    };
    let deadline = Instant.now() + Duration.from_millis(1);
    runtime.register_timer(deadline.as_nanos() as UInt64, waker);
}

public(in super) fn background_process(command: Text, cancel: JobCancellation, grace: Duration)
    -> ProcessFuture<JobCancellation> {
    ProcessFuture.new(ProcessRequest.CancellableScript(command), cancel, grace)
}

public(in super) fn checked_process(command: Text) -> ProcessFuture<JobCancellation> {
    ProcessFuture.new(ProcessRequest.Script(command), JobCancellation.new(), Duration.zero())
}

// =============================================================================
// Internals
// =============================================================================

/// Reconstruct a human-readable command line from program + argv.
/// Used purely for diagnostics — never re-parsed.
fn render_argv(program: &Text, args: &List<Text>) -> Text {
    let mut out = Text.with_capacity(program.len() + args.len() * 8);
    out.push_str(program);
    for a in args.iter() {
        out.push(' ');
        // Quote conservatively for display: visually delineate args with
        // whitespace or shell metacharacters; do not pretend to be
        // shell-correct (that would be confusing — diagnostics are diagnostics).
        if needs_display_quoting(a) {
            out.push('"');
            out.push_str(a);
            out.push('"');
        } else {
            out.push_str(a);
        }
    }
    out
}

fn needs_display_quoting(s: &Text) -> Bool {
    if s.is_empty() { return true; }
    for ch in s.chars() {
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '"' || ch == '\'' {
            return true;
        }
    }
    false
}

fn synthesise_mock_result(resp: MockResponse, command: Text) -> ShellResult {
    ShellResult.new(
        ExitStatus.from_exit_code(resp.exit_code),
        resp.stdout,
        resp.stderr,
        command,
        Duration.from_millis(0),
    )
}

fn synthesise_dry_run(command: Text) -> ShellResult {
    let mut message: Text = "[dry-run] ";
    message.push_str(&command);
    message.push('\n');
    let stdout = message.into_bytes();
    ShellResult.new(
        ExitStatus.from_exit_code(0),
        stdout,
        [],
        command,
        Duration.from_millis(0),
    )
}

fn log_dispatched(cmd: &Text) {
    // Diagnostics output goes to stderr to leave stdout clean for piping.
    let message: Text = f"$ {cmd}\n";
    eprint(&message);
}
