// =============================================================================
// protocols.vr - Core protocols (traits)
// =============================================================================
// Layer: 0 (Core)
// Dependencies: ordering.vr
// =============================================================================

// Import types from other core modules

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.base.protocols;
mount core.intrinsics.conversion.f64_to_bits;
mount core.intrinsics.memory.slice_len;
mount core.base.ordering.{Ordering, Less, Equal, Greater};
mount core.base.maybe.{Maybe, Some, None};
mount core.base.result.{Result, Ok, Err};

// =============================================================================
// Partial Equality Protocol
// =============================================================================

/// Protocol for types that can be compared for partial equality.
/// Unlike Eq, PartialEq does not require reflexivity (a == a may be false).
/// This is useful for types like floating-point NaN values.
public type PartialEq is protocol {
    /// Test equality with another value of the same type.
    fn eq(&self, other: &Self) -> Bool;

    /// Test inequality (default implementation).
    @inline(always)
    fn ne(&self, other: &Self) -> Bool {
        !self.eq(other)
    }
};

// =============================================================================
// Equality Protocol
// =============================================================================

/// Protocol for types with reflexive equality.
/// Types implementing Eq guarantee that a == a is always true.
/// This is a marker protocol that extends PartialEq.
public type Eq is protocol extends PartialEq {};

/// Compare a binary product through each component's declared relation.
implement<A: PartialEq, B: PartialEq> PartialEq for (A, B) {
    fn eq(&self, other: &Self) -> Bool {
        self.0.eq(&other.0) && self.1.eq(&other.1)
    }
}

implement<A: Eq, B: Eq> Eq for (A, B) {}

/// Compare lengths first, then call each element's equality from left to right.
/// The first mismatch ends the comparison.
public fn equal_elements<T: PartialEq>(left: &[T], right: &[T]) -> Bool {
    let length = slice_len(left);
    if length != slice_len(right) { return false; }
    let mut i: USize = 0;
    while i < length {
        if !left[i].eq(&right[i]) { return false; }
        i += 1;
    }
    true
}

implement<T: PartialEq> PartialEq for [T] {
    fn eq(&self, other: &Self) -> Bool { equal_elements(self, other) }
}

implement<T: Eq> Eq for [T] {}

implement<T: PartialEq, const N: Int> PartialEq for [T; N] {
    fn eq(&self, other: &Self) -> Bool { equal_elements(self, other) }
}

implement<T: Eq, const N: Int> Eq for [T; N] {}

// =============================================================================
// Ordering Protocol
// =============================================================================

/// Protocol for types with total ordering.
public type Ord is protocol extends Eq {
    /// Compare with another value, returning an Ordering.
    fn cmp(&self, other: &Self) -> Ordering;

    /// Less than.
    @inline(always)
    fn lt(&self, other: &Self) -> Bool {
        self.cmp(other) is Less
    }

    /// Less than || equal.
    @inline(always)
    fn le(&self, other: &Self) -> Bool {
        !(self.cmp(other) is Greater)
    }

    /// Greater than.
    @inline(always)
    fn gt(&self, other: &Self) -> Bool {
        self.cmp(other) is Greater
    }

    /// Greater than || equal.
    @inline(always)
    fn ge(&self, other: &Self) -> Bool {
        !(self.cmp(other) is Less)
    }

    /// Returns the maximum of self && other.
    @inline(always)
    fn max(self, other: Self) -> Self {
        if self.ge(&other) { self } else { other }
    }

    /// Returns the minimum of self && other.
    @inline(always)
    fn min(self, other: Self) -> Self {
        if self.le(&other) { self } else { other }
    }

    /// Clamp value between min && max bounds.
    @inline(always)
    fn clamp(self, min_val: Self, max_val: Self) -> Self {
        assert(min_val.le(&max_val), "min must be <= max");
        if self.lt(&min_val) { min_val }
        else if self.gt(&max_val) { max_val }
        else { self }
    }
};

// =============================================================================
// Partial Ordering Protocol
// =============================================================================

/// Protocol for types with partial ordering (may have incomparable values).
public type PartialOrd is protocol extends PartialEq {
    /// Compare with another value, returning Maybe<Ordering>.
    /// Returns Maybe.None if values are not comparable.
    fn partial_cmp(&self, other: &Self) -> Maybe<Ordering>;

    /// Less than (returns false if !comparable).
    fn lt(&self, other: &Self) -> Bool {
        self.partial_cmp(other).map(|o| o is Less).unwrap_or(false)
    }

    /// Less than || equal (returns false if !comparable).
    fn le(&self, other: &Self) -> Bool {
        self.partial_cmp(other).map(|o| !(o is Greater)).unwrap_or(false)
    }

    /// Greater than (returns false if !comparable).
    fn gt(&self, other: &Self) -> Bool {
        self.partial_cmp(other).map(|o| o is Greater).unwrap_or(false)
    }

    /// Greater than || equal (returns false if !comparable).
    fn ge(&self, other: &Self) -> Bool {
        self.partial_cmp(other).map(|o| !(o is Less)).unwrap_or(false)
    }
};

/// Blanket: every total-order type is also a partial-order type
/// — `partial_cmp` always returns `Maybe.Some(cmp)` since totals never
/// produce `Maybe.Maybe.None`.  Lets primitives (Int / Byte / Char /
/// UInt8..128 / Int8..128 / USize / ISize / Bool) and any user
/// type that implements `Ord` automatically satisfy `PartialOrd`
/// without 16+ repetitive `implement PartialOrd for X` blocks.
///
/// Mirrors Rust's `impl<T: Ord> PartialOrd for T` discipline.
/// `Float` / `Float32` / `Float64` retain their explicit
/// `PartialOrd` impls because they're NOT `Ord` (NaN breaks
/// totality) and need bespoke `partial_cmp` that returns
/// `Maybe.Maybe.None` on NaN.
implement<T: Ord> PartialOrd for T {
    fn partial_cmp(&self, other: &T) -> Maybe<Ordering> {
        Maybe.Some(self.cmp(other))
    }
}

// =============================================================================
// Hashing Protocol
// =============================================================================

/// Protocol for types that can be hashed.
public type Hash is protocol {
    /// Feed this value into a Hasher.
    fn hash(&self, hasher: &mut Hasher);

    /// Compute hash directly (convenience method).
    fn hash_value(&self) -> Int {
        let mut hasher = DefaultHasher.new();
        self.hash(&mut hasher);
        hasher.finish()
    }
};

/// Hasher state for computing hash values.
public type Hasher is protocol {
    /// Write bytes to the hasher.
    fn write(&mut self, bytes: &[Byte]);

    /// Write a single byte.
    fn write_byte(&mut self, byte: Byte) {
        self.write(&[byte]);
    }

    /// Write an Int.
    ///
    /// Feeds the 8 little-endian bytes of `n` one at a time through
    /// `write_byte` — the canonical byte-mixer chain.  This is
    /// allocation-free and produces the exact byte sequence of
    /// `n.to_le_bytes()`, so every arrival shape agrees on the hash:
    /// the Tier-0 `DefaultHasher` intercept (`fxhash_bytes(state,
    /// &n.to_le_bytes())`), this default body running under dyn
    /// dispatch, and the Tier-1 AOT body.  The previous form
    /// `self.write(int_to_bytes(n))` leaned on the fn-form
    /// `@intrinsic("to_ne_bytes")`, whose VBC lowering is a raw i64
    /// reinterpret (`Mov`) rather than a real `[Byte; 8]` container —
    /// the write step then saw a non-slice value and silently hashed
    /// nothing (state stayed 0; #44-B `test_hash_some_different`).
    fn write_int(&mut self, n: Int) {
        let mut i: Int = 0;
        while i < 8 {
            self.write_byte(((n >> (i * 8)) & 0xFF) as Byte);
            i = i + 1;
        }
    }

    /// Finalize && return the hash value.
    fn finish(&self) -> Int;
};

/// Default FxHash-based hasher for performance.
///

/// Implements the canonical FxHash algorithm
/// (`rotate_left(5)` ⊕ byte) ⊗ SEED), the same construction
/// used by `rustc`'s internal `rustc-hash` crate. FxHash is
/// designed for fast hashing of small keys, not for adversarial
/// input — it's NOT cryptographically strong and NOT
/// HashDoS-resistant. Code that hashes attacker-controlled keys
/// (network input, protocol IDs, etc.) should use a keyed
/// hasher seeded with per-process randomness; this default is
/// for compiler-internal / trusted-input use.
public type DefaultHasher is {
    state: Int,
};

implement DefaultHasher {
    @inline(always)
    public fn new() -> DefaultHasher {
        // Canonical FxHash starts at 0 — the first byte
        // contributes via the XOR step before any multiply, so
        // the initial multiplication isn't a no-op.
        DefaultHasher { state: 0 }
    }
}

implement Hasher for DefaultHasher {
    fn write(&mut self, bytes: &[Byte]) {
        // Canonical FxHash 64-bit step:
        //  state := (state.rotate_left(5) ^ byte) * SEED
        //
        // Indexed iteration (`while i < n`) rather than `for byte in bytes`
        // — the `for x in &[T]` form on a slice trips an LLVM
        // `SmallVectorBase.grow_pod` SIGSEGV in the slice-iter
        // lowering (task #9, shared root with task #11 / #11 was the
        // hash-defect manifestation).  Indexed access mirrors the
        // canonical stdlib pattern (utf8_validate / kmp_failure_table)
        // and is uniformly supported on both Tier-0 and Tier-1 paths.
        //
        // The Tier-0 interpreter additionally bypasses this body via
        // a dedicated intercept at
        // `crates/verum_vbc/src/interpreter/dispatch_table/handlers/
        // hasher_runtime.rs`, which calls the canonical `fxhash_bytes`
        // helper directly on the heap record's `state` field.  The
        // body retains the indexed-while form so the AOT path (which
        // doesn't hit the intercept) also produces correct hashes.
        let n = bytes.len();
        let mut i: Int = 0;
        while i < n {
            let rotated = self.state.rotate_left(5);
            let mixed = rotated ^ (bytes[i] as Int);
            self.state = mixed.wrapping_mul(0x517cc1b727220a95);
            i = i + 1;
        }
    }

    fn finish(&self) -> Int {
        self.state
    }
}

// =============================================================================
// Clone Protocol
// =============================================================================

/// Protocol for types that can be cloned.
public type Clone is protocol {
    /// Create a deep copy of this value.
    fn clone(&self) -> Self;

    /// Clone from another value (default implementation).
    fn clone_from(&mut self, source: &Self) {
        *self = source.clone();
    }
};

// =============================================================================
// Copy Protocol (Marker)
// =============================================================================

/// Marker protocol for types that are trivially copyable.
/// Types implementing Copy are implicitly cloned on assignment.
public type Copy is protocol extends Clone {};

// =============================================================================
// Default Protocol
// =============================================================================

/// Protocol for types with a default value.
public type Default is protocol {
    /// Return the default value for this type.
    fn default() -> Self;
};

// =============================================================================
// Debug Protocol
// =============================================================================

/// Protocol for debug formatting.
public type Debug is protocol {
    /// Format value for debugging output.
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError>;
};

// =============================================================================
// Display Protocol
// =============================================================================

/// Protocol for user-facing formatting.
public type Display is protocol {
    /// Format value for display output.
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError>;
};

// =============================================================================
// Drop Protocol
// =============================================================================

/// Protocol for resource cleanup on value destruction — the foundation
/// for RAII-style resource management (file handles, GPU buffers, locks).
/// When a value implementing `Drop` goes out of scope the CBGR runtime
/// calls `drop()` automatically, exactly once per owned value.
///
/// This is the SINGLE authority for the `Drop` protocol (T0500); the
/// byte-identical copy that lived in `core.base.ops` was removed.
public type Drop is protocol {
    /// Clean up resources owned by this value.
    fn drop(&mut self);
};

// =============================================================================
// Deref Protocols
// =============================================================================

/// Protocol for automatic dereferencing.
public type Deref is protocol {
    /// The target type after dereferencing.
    type Target;

    /// Get a reference to the underlying value.
    fn deref(&self) -> &Self.Target;
};

/// Protocol for mutable dereferencing.
public type DerefMut is protocol extends Deref {
    /// Get a mutable reference to the underlying value.
    fn deref_mut(&mut self) -> &mut Self.Target;
};

// =============================================================================
// AsRef / AsMut Protocols
// =============================================================================

/// Protocol for reference conversions.
public type AsRef<T> is protocol {
    /// Convert this reference to a reference of type T.
    fn as_ref(&self) -> &T;
};

/// Protocol for mutable reference conversions.
public type AsMut<T> is protocol {
    /// Convert this mutable reference to a mutable reference of type T.
    fn as_mut(&mut self) -> &mut T;
};

// =============================================================================
// Into / From Protocols
// =============================================================================

/// Protocol for fallible type conversions.
public type TryFrom<T> is protocol {
    /// The error type if conversion fails.
    type Error;

    /// Try to convert from T to Self.
    fn try_from(value: T) -> Result<Self, Self.Error>;
};

/// Protocol for infallible type conversions.
public type From<T> is protocol {
    /// Convert from T to Self.
    fn from(value: T) -> Self;
};

/// Protocol for converting into another type.
public type Into<T> is protocol {
    /// Convert self into T.
    fn into(self) -> T;
};

// Reflexive From: every type converts From itself. Without
// this, `let y: T = x.into()` for `x: T` fails to compile —
// the `Into` blanket below requires a `From<T>` instance, and
// the same-type case has no provider. This impl makes
// `.into()` chains uniformly applicable, including the trivial
// identity case that callers naturally hit when threading
// values through generic code that may or may not need
// conversion.
implement<T> From<T> for T {
    fn from(value: T) -> T {
        value
    }
}

// Blanket implementation: Into<T> from From<Self>
implement<T, U: From<T>> Into<U> for T {
    fn into(self) -> U {
        U.from(self)
    }
}

/// Protocol for fallible type conversions (reverse direction).
///

/// This is the reciprocal of TryFrom. Where TryFrom allows you to write
/// `U.try_from(value)`, TryInto allows you to write `value.try_into()`.
///

/// A blanket implementation provides TryInto<U> for any T where U: TryFrom<T>.
///

/// # Examples
///

/// ```verum
/// let n: Int = 42;
/// let result: Result<PositiveInt, Text> = n.try_into();
/// assert(result.is_ok());
/// ```
public type TryInto<T> is protocol {
    /// The error type if conversion fails.
    type Error;

    /// Try to convert self into T.
    fn try_into(self) -> Result<T, Self.Error>;
};

// Blanket implementation: TryInto<U> from TryFrom<T>
implement<T, U: TryFrom<T>> TryInto<U> for T {
    type Error = U.Error;

    fn try_into(self) -> Result<U, U.Error> {
        U.try_from(self)
    }
}

// =============================================================================
// Formatter for Debug/Display
// =============================================================================

/// Format error type.
public type FormatError is {};

implement Display for FormatError {
    fn fmt(&self, _f: &mut Formatter) -> Result<(), FormatError> {
        Result.Ok(())
    }
}

implement Debug for FormatError {
    fn fmt_debug(&self, _f: &mut Formatter) -> Result<(), FormatError> {
        Result.Ok(())
    }
}

implement PartialEq for FormatError {
    fn eq(&self, _other: &FormatError) -> Bool { true }
}

implement Eq for FormatError {}

/// Format result alias - used by Display and Debug implementations.
public type FmtResult is Result<Unit, FormatError>;

// =============================================================================
// Format spec types (moved from core/text/format.vr — task #48 twin
// merge; they are pure base-layer types so the canonical Formatter can
// carry `spec` without a base→text dependency)
// =============================================================================

// =============================================================================
// TextAlignment
// =============================================================================

// Text alignment in formatted output.
public type TextAlignment is
    | Left      // Left-align (default)
    | Center    // Center-align
    | Right;    // Right-align

implement Default for TextAlignment {
    fn default() -> TextAlignment {
        Left
    }
}

// =============================================================================
// Sign Handling
// =============================================================================

// Sign display mode for numeric formatting.
public type Sign is
    | Minus     // Only show '-' for negatives (default)
    | Plus      // Show '+' for positives, '-' for negatives
    | Space;    // Show ' ' for positives, '-' for negatives

implement Default for Sign {
    fn default() -> Sign {
        Minus
    }
}

// =============================================================================
// Format Spec
// =============================================================================

// Formatting specification (parsed from format strings).
public type FormatSpec is {
    // Fill character for padding
    fill: Char,
    // TextAlignment mode
    align: TextAlignment,
    // Sign handling for numbers
    sign: Sign,
    // Minimum width
    width: Maybe<Int>,
    // Precision for floats/strings
    precision: Maybe<Int>,
    // Use alternate form (e.g., 0x for hex)
    alternate: Bool,
    // Type specifier (b=binary, o=octal, x=hex, X=HEX, e=exp, f=fixed)
    format_type: Maybe<Char>,
};

implement FormatSpec {
    // Create default format spec.
    public fn new() -> FormatSpec {
        FormatSpec {
            fill: ' ',
            align: Left,
            sign: Minus,
            width: Maybe.None,
            precision: Maybe.None,
            alternate: false,
            format_type: Maybe.None,
        }
    }

    // Set width.
    public fn with_width(mut self, w: Int) -> FormatSpec {
        self.width = Maybe.Some(w);
        self
    }

    // Set precision.
    public fn with_precision(mut self, p: Int) -> FormatSpec {
        self.precision = Maybe.Some(p);
        self
    }

    // Set alignment.
    public fn with_align(mut self, a: TextAlignment) -> FormatSpec {
        self.align = a;
        self
    }

    // Set fill character.
    public fn with_fill(mut self, c: Char) -> FormatSpec {
        self.fill = c;
        self
    }

    // Enable alternate form.
    public fn alternate_form(mut self) -> FormatSpec {
        self.alternate = true;
        self
    }

    // Enable zero padding (sets fill='0' and align=Right).
    public fn zero_padded(mut self) -> FormatSpec {
        self.fill = '0';
        self.align = Right;
        self
    }

    // Check if zero padding is enabled (fill='0' and right-aligned).
    fn is_zero_padded(&self) -> Bool {
        self.fill == '0' && self.align == Right
    }

    // Set type specifier.
    public fn with_type(mut self, t: Char) -> FormatSpec {
        self.format_type = Maybe.Some(t);
        self
    }
}

implement Default for FormatSpec {
    fn default() -> FormatSpec {
        FormatSpec.new()
    }
}

/// Formatter state for writing formatted output.
///
/// SINGLE canonical formatter (task #48): carries the output buffer
/// AND the active format spec. The writing methods' canonical bodies
/// live in `core/text/format.vr`'s `implement Formatter` block;
/// constructors live here beside the type.
public type Formatter is {
    buffer: &mut Text,
    spec: FormatSpec,
};

/// Source-compat alias for the historical extended-formatter name
/// (task #48 twin merge). Lives in the TARGET's own module so the
/// archive alias-import pass resolves the target TypeId in-module.
public type TextFormatter is Formatter;

// =============================================================================
// Numeric rendering helpers (moved with the write surface — task #48)
// =============================================================================

public fn int_to_string(value: Int, buf: &mut [Byte]) -> Int {
    if buf.len() == 0 {
        return 0;
    }

    if value == 0 {
        buf[0] = '0' as Byte;
        return 1;
    }

    let negative = value < 0;
    let mut mag = value.unsigned_abs();

    // Write digits in reverse order.
    let mut pos = 0;
    while mag > 0_u64 && pos < buf.len() {
        let digit = (mag % 10_u64) as Byte;
        buf[pos] = '0' as Byte + digit;
        mag = mag / 10_u64;
        pos = pos + 1;
    }

    // Add sign if negative.
    if negative && pos < buf.len() {
        buf[pos] = '-' as Byte;
        pos = pos + 1;
    }

    // Reverse the buffer in place.
    let mut i = 0;
    let mut j = pos - 1;
    while i < j {
        let tmp = buf[i];
        buf[i] = buf[j];
        buf[j] = tmp;
        i = i + 1;
        j = j - 1;
    }

    pos
}


/// Write the fixed-point decimal prefix that fits in `buf`. Midpoints
/// round away from zero. Binary64 values are exact integers times powers
/// of two, including subnormals; no floating-point rounding is needed.
public fn float_to_string(value: Float, buf: &mut [Byte], precision: Int) -> Int {
    let bits = f64_to_bits(value);
    let exponent = ((bits >> 52) & 0x7ff_u64) as Int;
    let mut significand = bits & 0x000f_ffff_ffff_ffff_u64;
    let negative = (bits >> 63) != 0_u64;
    if exponent == 2047 {
        let word = if significand != 0_u64 { "NaN" } else if negative { "-inf" } else { "inf" };
        let bytes = word.as_bytes();
        let mut i = 0;
        while i < bytes.len() && i < buf.len() { buf[i] = bytes[i]; i = i + 1; }
        return i;
    }

    let mut shift = -1074;
    if exponent != 0 {
        significand = significand | (1_u64 << 52);
        shift = exponent - 1075;
    }
    if significand == 0_u64 { shift = 0; }
    while shift < 0 && (significand & 1_u64) == 0_u64 {
        significand = significand >> 1;
        shift = shift + 1;
    }

    // M * 2^-k = (M * 5^k) * 10^-k. The largest possible numerator
    // has 767 decimal digits (53 significand bits and at most 1074
    // factors of five), so 86 base-10^9 limbs cover every binary64.
    let mut limbs = [0_u32; 86];
    let mut used = 1;
    limbs[0] = (significand % 1_000_000_000_u64) as UInt32;
    if significand >= 1_000_000_000_u64 {
        limbs[1] = (significand / 1_000_000_000_u64) as UInt32;
        used = 2;
    }
    let scale = if shift < 0 { -shift } else { 0 };
    let mut steps = if shift < 0 { -shift } else { shift };
    let base = if shift < 0 { 5_u64 } else { 2_u64 };
    let chunk = if shift < 0 { 13 } else { 29 };
    while steps > 0 {
        let count = if steps < chunk { steps } else { chunk };
        let mut factor = 1_u64;
        let mut k = 0;
        while k < count { factor = factor * base; k = k + 1; }
        let mut carry = 0_u64;
        let mut i = 0;
        while i < used {
            let product = (limbs[i] as UInt64) * factor + carry;
            limbs[i] = (product % 1_000_000_000_u64) as UInt32;
            carry = product / 1_000_000_000_u64;
            i = i + 1;
        }
        while carry > 0_u64 {
            limbs[used] = (carry % 1_000_000_000_u64) as UInt32;
            used = used + 1;
            carry = carry / 1_000_000_000_u64;
        }
        steps = steps - count;
    }

    let decimal = [1_u32, 10_u32, 100_u32, 1000_u32, 10_000_u32,
                   100_000_u32, 1_000_000_u32, 10_000_000_u32, 100_000_000_u32];
    let places = if precision < 0 { 0 } else { precision };
    let last = scale - places;
    if last > 0 && (last - 1) / 9 < used {
        let omitted = last - 1;
        if (limbs[omitted / 9] / decimal[omitted % 9]) % 10_u32 >= 5_u32 {
            let mut i = last / 9;
            let mut carry = decimal[last % 9];
            while carry != 0_u32 {
                if i == used { used = used + 1; }
                let sum = limbs[i] + carry;
                limbs[i] = sum % 1_000_000_000_u32;
                carry = sum / 1_000_000_000_u32;
                i = i + 1;
            }
        }
    }

    let mut first = (used - 1) * 9;
    let mut leading = limbs[used - 1];
    while leading >= 10_u32 { leading = leading / 10_u32; first = first + 1; }
    let mut place = if first > scale { first } else { scale };
    let mut pos = 0;
    if negative && pos < buf.len() { buf[pos] = 45_u8; pos = pos + 1; }
    while place >= last && pos < buf.len() {
        if place == scale - 1 {
            buf[pos] = 46_u8;
            pos = pos + 1;
            if pos == buf.len() { break; }
        }
        let digit = if place >= 0 && place / 9 < used {
            (limbs[place / 9] / decimal[place % 9]) % 10_u32
        } else { 0_u32 };
        buf[pos] = 48_u8 + (digit as Byte);
        pos = pos + 1;
        place = place - 1;
    }
    pos
}

implement Formatter {
    /// Create a new Formatter writing into the given Text buffer,
    /// with the default format spec.
    public fn new(buffer: &mut Text) -> Formatter {
        Formatter {
            buffer: buffer,
            spec: FormatSpec.new(),
        }
    }

    /// Create a Formatter with an explicit format spec (the f-string
    /// machinery parses `{value:spec}` into a FormatSpec and builds
    /// the formatter through this).
    public fn with_spec(buffer: &mut Text, spec: FormatSpec) -> Formatter {
        Formatter {
            buffer: buffer,
            spec: spec,
        }
    }


    // Write with padding based on alignment.
    fn write_padded(&mut self, s: &Text, padding: Int) -> Result<(), FormatError> {
        let fill = self.spec.fill;

        match self.spec.align {
            Left => {
                self.buffer.push_str(s);
                for _ in range(0, padding) {
                    self.buffer.push(fill);
                }
            }
            Right => {
                for _ in range(0, padding) {
                    self.buffer.push(fill);
                }
                self.buffer.push_str(s);
            }
            Center => {
                let left = padding / 2;
                let right = padding - left;
                for _ in range(0, left) {
                    self.buffer.push(fill);
                }
                self.buffer.push_str(s);
                for _ in range(0, right) {
                    self.buffer.push(fill);
                }
            }
        }
        Result.Ok(())
    }


    // Write formatted bytes.
    //
    // Indexed iteration (`while i < n`) rather than `for b in bytes` —
    // the `for x in &[T]` form on a slice value (e.g. one produced by
    // `Text.as_bytes()`) trips an LLVM `SmallVectorBase.grow_pod`
    // SIGSEGV in the slice-iter lowering (task #9 / task #11 share
    // root).  Indexed access mirrors the canonical stdlib pattern
    // (`utf8_validate` / `kmp_failure_table`) and is uniformly
    // supported on both Tier-0 and Tier-1 paths.
    public fn write_bytes(&mut self, bytes: &[Byte]) -> Result<(), FormatError> {
        let n = bytes.len();
        let mut i: Int = 0;
        while i < n {
            self.buffer.push(bytes[i] as Char);
            i = i + 1;
        }
        Result.Ok(())
    }


    // =========================================================================
    // Integer Formatting
    // =========================================================================

    // Format an integer.
    public fn write_int(&mut self, n: Int) -> Result<(), FormatError> {
        let ty = self.spec.format_type.unwrap_or('d');

        match ty {
            'b' => self.write_int_base(n, 2, false),
            'o' => self.write_int_base(n, 8, false),
            'x' => self.write_int_base(n, 16, false),
            'X' => self.write_int_base(n, 16, true),
            _ => self.write_int_decimal(n),
        }
    }


    // Format integer as decimal.
    fn write_int_decimal(&mut self, n: Int) -> Result<(), FormatError> {
        let mut buf = [0_u8; 32];
        let len = int_to_string(n, &mut buf);

        let s = unsafe {
            Text.from_utf8_unchecked(&buf[..len])
        };

        // Handle sign
        let (sign_str, value_str) = if n < 0 {
            ("-", s.slice(1, s.len()))
        } else {
            match self.spec.sign {
                Plus => ("+", s),
                Space => (" ", s),
                Minus => ("", s),
            }
        };

        self.write_with_sign(&sign_str, &value_str)
    }


    /// Format a signed integer in base 2 through 16, applying the current spec.
    public(in core) fn write_int_base(&mut self, n: Int, base: Int, uppercase: Bool) -> Result<(), FormatError> {
        if base < 2 || base > 16 { return Result.Err(FormatError {}); }
        // One sign, two prefix bytes and at most 64 binary digits.
        let mut bytes: [Byte; 67] = [0; 67];
        let mut start = 67;
        let radix = base as UInt64;
        let mut magnitude = n.unsigned_abs();
        loop {
            let digit = (magnitude % radix) as Byte;
            start = start - 1;
            bytes[start] = if digit < 10_u8 { ('0' as Byte) + digit } else {
                let letter = if uppercase { 'A' } else { 'a' };
                (letter as Byte) + (digit - 10_u8)
            };
            magnitude = magnitude / radix;
            if magnitude == 0_u64 { break; }
        }
        if self.spec.alternate {
            let prefix = match base {
                2 => 'b', 8 => 'o', 16 => if uppercase { 'X' } else { 'x' }, _ => '\0',
            };
            if prefix != '\0' {
                start = start - 2;
                bytes[start] = '0' as Byte;
                bytes[start + 1] = prefix as Byte;
            }
        }
        let sign = if n < 0 { '-' } else {
            match self.spec.sign { Plus => '+', Space => ' ', Minus => '\0' }
        };
        if sign != '\0' {
            start = start - 1;
            bytes[start] = sign as Byte;
        }
        let text = Text.from_utf8_unchecked(&bytes[start..67]);
        self.write_str(&text)
    }

    // Write value with sign, handling zero padding.
    fn write_with_sign(&mut self, sign: &Text, value: &Text) -> Result<(), FormatError> {
        let total_len = sign.len() + value.len();

        match self.spec.width {
            Maybe.Some(w) if total_len < w => {
                if self.spec.is_zero_padded() {
                    // Sign, then zeros, then value
                    self.buffer.push_str(sign);
                    for _ in range(0, w - total_len) {
                        self.buffer.push('0');
                    }
                    self.buffer.push_str(value);
                    Result.Ok(())
                } else {
                    // Normal padding
                    let full = sign.concat(value);
                    self.write_padded(&full, w - total_len)
                }
            }
            _ => {
                self.buffer.push_str(sign);
                self.buffer.push_str(value);
                Result.Ok(())
            }
        }
    }


    // =========================================================================
    // Float Formatting
    // =========================================================================

    // Format a float.
    public fn write_float(&mut self, f: Float) -> Result<(), FormatError> {
        let ty = self.spec.format_type.unwrap_or('g');
        let precision = self.spec.precision.unwrap_or(6);

        let s = f.to_precision(precision);

        // Handle sign for positive numbers
        let (sign, value) = if f < 0.0 || f.is_sign_negative() {
            ("", s) // Already has '-'
        } else {
            match self.spec.sign {
                Plus => ("+", s),
                Space => (" ", s),
                Minus => ("", s),
            }
        };

        let full = sign + &value;
        self.write_str(&full)
    }


    // =========================================================================
    // Accessors
    // =========================================================================

    // Get current width specification.
    public fn width(&self) -> Maybe<Int> {
        self.spec.width
    }


    // Get current precision specification.
    public fn precision(&self) -> Maybe<Int> {
        self.spec.precision
    }


    // Get current alignment.
    public fn align(&self) -> TextAlignment {
        self.spec.align
    }


    // Get current fill character.
    public fn fill(&self) -> Char {
        self.spec.fill
    }


    // Check if alternate form is enabled.
    public fn alternate(&self) -> Bool {
        self.spec.alternate
    }


    // =========================================================================
    // Basic Output
    // =========================================================================

    // Write a string to output.
    public fn write_str(&mut self, s: &Text) -> Result<(), FormatError> {
        // Apply width/precision if specified
        let s = match self.spec.precision {
            Maybe.Some(p) if s.char_count() > p => {
                // Truncate to precision characters
                let mut res: Text = "";
                let mut count = 0;
                for ch in s.chars() {
                    if count >= p {
                        break;
                    }
                    res.push(ch);
                    count = count + 1;
                }
                res
            }
            _ => s.clone(),
        };

        match self.spec.width {
            Maybe.Some(w) if s.char_count() < w => {
                let padding = w - s.char_count();
                self.write_padded(&s, padding)
            }
            _ => {
                self.buffer.push_str(&s);
                Result.Ok(())
            }
        }
    }


    // Write a single character.
    public fn write_char(&mut self, c: Char) -> Result<(), FormatError> {
        self.buffer.push(c);
        Result.Ok(())
    }
}

// =============================================================================
// Sized Protocol (Marker)
// =============================================================================

/// Marker protocol for types with known size at compile time.
/// Implementations declare a fixed value layout; generic callers must carry
/// this bound explicitly. Primitive implementations live with their types.
public type Sized is protocol {};

// =============================================================================
// Send / Sync Protocols (Markers)
// =============================================================================

/// Marker protocol for types that can be safely transferred across threads.
public type Send is protocol {};

/// Marker protocol for types whose references can be shared across threads.
public type Sync is protocol {};

// =============================================================================
// Unpin Protocol (Marker)
// =============================================================================

/// Marker protocol for types that don't require pinning.
public type Unpin is protocol {};

// =============================================================================
// Operator Protocols
// =============================================================================

/// Protocol for addition.
public type Add<Rhs = Self> is protocol {
    type Output;
    fn add(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for subtraction.
public type Sub<Rhs = Self> is protocol {
    type Output;
    fn sub(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for multiplication.
public type Mul<Rhs = Self> is protocol {
    type Output;
    fn mul(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for division.
public type Div<Rhs = Self> is protocol {
    type Output;
    fn div(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for remainder.
public type Rem<Rhs = Self> is protocol {
    type Output;
    fn rem(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for negation.
public type Neg is protocol {
    type Output;
    fn neg(self) -> Self.Output;
};

/// Protocol for bitwise AND.
public type BitAnd<Rhs = Self> is protocol {
    type Output;
    fn bitand(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for bitwise OR.
public type BitOr<Rhs = Self> is protocol {
    type Output;
    fn bitor(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for bitwise XOR.
public type BitXor<Rhs = Self> is protocol {
    type Output;
    fn bitxor(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for bitwise NOT.
public type Not is protocol {
    type Output;
    fn not(self) -> Self.Output;
};

/// Protocol for left shift.
public type Shl<Rhs = Self> is protocol {
    type Output;
    fn shl(self, rhs: Rhs) -> Self.Output;
};

/// Protocol for right shift.
public type Shr<Rhs = Self> is protocol {
    type Output;
    fn shr(self, rhs: Rhs) -> Self.Output;
};

// =============================================================================
// Index Protocols
// =============================================================================

/// Protocol for indexing.
public type Index<Idx> is protocol {
    type Output;
    fn index(&self, idx: Idx) -> &Self.Output;
};

/// Protocol for mutable indexing.
public type IndexMut<Idx> is protocol extends Index<Idx> {
    fn index_mut(&mut self, idx: Idx) -> &mut Self.Output;
};

// =============================================================================
// Zero / One Protocols (for numeric operations)
// =============================================================================

/// Protocol for additive identity.
public type Zero is protocol {
    fn zero() -> Self;
    fn is_zero(&self) -> Bool;
};

/// Protocol for multiplicative identity.
public type One is protocol {
    fn one() -> Self;
    fn is_one(&self) -> Bool;
};

// =============================================================================
// Atomic Protocol (for generic atomic operations)
// =============================================================================

/// Marker protocol for value representations admitted by atomic operations.
///

/// Types implementing Atomic can be used with generic atomic intrinsics:
/// - atomic_load<T>
/// - atomic_store<T>
/// - atomic_cmpxchg<T>
/// - atomic_xchg<T>
/// - atomic_add<T> (also requires T: Integer)
/// - atomic_sub<T> (also requires T: Integer)
///

/// ## Supported Sizes
/// The standard library admits scalar widths of 1, 2, 4, and 8 bytes.
/// Target support is a separate requirement: target_has_atomic<T>() reports
/// support for the selected target. This protocol alone does not prove it.
public type Atomic is protocol extends Copy + Sized {};

// Atomic implementations for primitive integer types
// The compiler dispatches to appropriate atomic instructions based on type size.
// Note: Pointer atomics use type-specific intrinsics (atomic_load_ptr, atomic_store_ptr, etc.)
implement Atomic for UInt8  {}
implement Atomic for UInt16 {}
implement Atomic for UInt32 {}
implement Atomic for UInt64 {}
implement Atomic for Int8   {}
implement Atomic for Int16  {}
implement Atomic for Int32  {}
implement Atomic for Int    {}
implement Atomic for Bool   {}

// =============================================================================
// Integer Protocol
// =============================================================================

/// Marker protocol for integer arithmetic, independently of atomic support.
///

/// Types implementing both Integer and Atomic can use fetch-and-modify atomics:
/// - atomic_add<T>
/// - atomic_sub<T>
/// - atomic_and<T>
/// - atomic_or<T>
/// - atomic_xor<T>
public type Integer is protocol extends Numeric {};

// Integer implementations for unsigned types
// The compiler uses T.size and T.is_signed type properties for dispatch.
implement Integer for UInt8   {}
implement Integer for UInt16  {}
implement Integer for UInt32  {}
implement Integer for UInt64  {}
implement Integer for UInt128 {}

// Integer implementations for signed types
implement Integer for Int8   {}
implement Integer for Int16  {}
implement Integer for Int32  {}
implement Integer for Int128 {}
implement Integer for Int    {}

// =============================================================================
// SignedInteger Protocol
// =============================================================================

/// Marker protocol for signed integer types.
///

/// Types implementing SignedInteger support operations that depend on
/// signed arithmetic semantics, such as wrapping_neg which handles MIN.
public type SignedInteger is protocol extends Integer {};

implement SignedInteger for Int8   {}
implement SignedInteger for Int16  {}
implement SignedInteger for Int32  {}
implement SignedInteger for Int128 {}
implement SignedInteger for Int    {}

// =============================================================================
// Numeric Protocol (for generic arithmetic intrinsics)
// =============================================================================

/// Marker protocol for all numeric types (integers and floats).
///

/// Types implementing Numeric support basic arithmetic operations:
/// - add, sub, mul, div, rem (via intrinsics)
///

/// This protocol is used by the generic arithmetic intrinsics in
/// stdlib.intrinsics to provide type-safe arithmetic for all numeric types.
public type Numeric is protocol extends Copy + Sized {};

// Numeric implementations for integer types
implement Numeric for UInt8   {}
implement Numeric for UInt16  {}
implement Numeric for UInt32  {}
implement Numeric for UInt64  {}
implement Numeric for UInt128 {}
implement Numeric for Int8    {}
implement Numeric for Int16   {}
implement Numeric for Int32   {}
implement Numeric for Int128  {}
implement Numeric for Int     {}

// Numeric implementations for floating-point types
implement Numeric for Float   {}
implement Numeric for Float32 {}

// =============================================================================
// SignedNumeric Protocol
// =============================================================================

/// Marker protocol for signed numeric types (signed integers and floats).
///

/// Types implementing SignedNumeric support operations that depend on
/// sign, such as negation.
public type SignedNumeric is protocol extends Numeric {};

implement SignedNumeric for Int8    {}
implement SignedNumeric for Int16   {}
implement SignedNumeric for Int32   {}
implement SignedNumeric for Int128  {}
implement SignedNumeric for Int     {}
implement SignedNumeric for Float   {}
implement SignedNumeric for Float32 {}

// =============================================================================
// TypeId - Runtime type identification
// =============================================================================

/// Opaque type identifier for runtime type discrimination.
///

/// Used by the `Any` protocol for dynamic dispatch and downcasting.
/// Each distinct type has a unique TypeId at runtime.
public type TypeId is (UInt64);

implement Clone for TypeId {
    fn clone(&self) -> Self {
        TypeId(self.0)
    }
}

implement TypeId {
    /// Create a TypeId from a raw value.
    fn from_raw(id: UInt64) -> TypeId {
        TypeId(id)
    }

    /// Get the raw numeric value.
    fn raw(&self) -> UInt64 {
        self.0
    }

    /// The identifier of a type named at the call site.
    ///
    public fn of<T>() -> TypeId {
        TypeId(T.id)
    }
}

implement PartialEq for TypeId {
    fn eq(&self, other: &TypeId) -> Bool {
        self.0 == other.0
    }
}

implement Eq for TypeId {}

implement Hash for TypeId {
    fn hash(&self, hasher: &mut Hasher) {
        hasher.write_int(self.0 as Int);
    }
}

// =============================================================================
// Any Protocol (for type erasure and dynamic dispatch)
// =============================================================================

/// Protocol for type erasure, enabling dynamic dispatch and runtime type
/// identification.
///

/// Types implementing Any can:
/// - Be stored as `&dyn Any` for type-erased storage
/// - Have their TypeId queried at runtime
/// - Be downcast back to their concrete type
///

/// All types automatically implement Any.
public type Any is protocol {
    /// Get the TypeId of the concrete type.
    fn type_id(&self) -> TypeId;
};

// =============================================================================
// Describable Protocol (for error types)
// =============================================================================

/// Protocol for types that provide a human-readable description.
///

/// This is the base protocol for error types, enabling structured error handling.
/// All error types should implement Describable to provide a description.
///

/// # Examples
///

/// ```verum
/// type IoError is { message: Text, kind: IoErrorKind };
///

/// implement Describable for IoError {
///  fn description(&self) -> Text {
///  self.message.clone()
///  }
/// }
/// ```
public type Describable is protocol {
    /// Get a human-readable description.
    fn description(&self) -> Text;
};

// =============================================================================
// ErrorSource Protocol (extends Describable with error chaining)
// =============================================================================

/// Protocol for error types with source chaining.
///

/// Extends Describable with optional source error for building error chains.
/// Named `ErrorSource` to avoid collision with the concrete `Error` type in
/// `core.base.result`.
///

/// # Examples
///

/// ```verum
/// type IoError is { message: Text, cause: Maybe<Heap<dyn ErrorSource>> };
///

/// implement ErrorSource for IoError {
///  fn description(&self) -> Text { self.message.clone() }
///  fn source(&self) -> Maybe<&dyn ErrorSource> { Maybe.None }
/// }
/// ```
public type ErrorSource is protocol extends Describable {
    /// Get the underlying cause of this error, if any.
    fn source(&self) -> Maybe<&dyn ErrorSource> {
        Maybe.None
    }
};

// =============================================================================
// FromStr Protocol (parsing from text)
// =============================================================================

/// Protocol for types that can be parsed from a text representation.
///

/// This enables the standard parsing pattern:
/// ```verum
/// let n: Int = "42".parse()?;
/// ```
public type FromStr is protocol {
    /// The error type returned when parsing fails.
    type ParseError;

    /// Parse a string into this type.
    fn from_str(s: &Text) -> Result<Self, Self.ParseError>;
};

/// The canonical parse-failure record for the `FromStr` /
/// `from_str_radix` family: what failed, as a human-readable reason.
/// One error surface for BOTH parse entry points (semantic honesty:
/// a failed parse has a reason, not just an absence).
/// Parse error.
public type ParseError is {
    message: Text,
};

implement ParseError {
    /// Keep an owned diagnostic message without copying its bytes.
    public fn from_message(message: Text) -> ParseError {
        ParseError { message }
    }
}

implement Debug for ParseError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str("ParseError: ")?;
        f.write_str(&self.message)
    }
}

implement Display for ParseError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(&self.message)
    }
}

implement PartialEq for ParseError {
    fn eq(&self, other: &ParseError) -> Bool {
        self.message == other.message
    }
}

implement Eq for ParseError {}

// =============================================================================
// ToString Protocol
// =============================================================================

/// Protocol for converting values to Text.
///

/// All types implementing Display automatically get ToString.
public type ToString is protocol {
    /// Convert to a Text representation.
    fn to_string(&self) -> Text;
};

// Blanket implementation: any Display type can be converted to string
implement<T: Display> ToString for T {
    fn to_string(&self) -> Text {
        let mut buf = Text.new();
        let mut f = Formatter.new(&mut buf);
        let _ = self.fmt(&mut f);
        buf
    }
}

// =============================================================================
// Borrow / BorrowMut Protocols
// =============================================================================

/// Protocol for borrowing data as a reference of a different type.
///

/// Used for efficient lookups in hash maps and other collections
/// where owned and borrowed keys should be interchangeable.
///

/// # Contract
///

/// If a type implements both Borrow<T> and Hash, then the hash of
/// the borrowed form must equal the hash of the original.
public type Borrow<Borrowed> is protocol {
    /// Borrow this value as a reference to Borrowed.
    fn borrow(&self) -> &Borrowed;
};

/// Mutable variant of Borrow.
public type BorrowMut<Borrowed> is protocol extends Borrow<Borrowed> {
    /// Mutably borrow this value.
    fn borrow_mut(&mut self) -> &mut Borrowed;
};

// =============================================================================
// Compound Assignment Operator Protocols
// =============================================================================

/// Protocol for addition assignment (+=).
public type AddAssign<Rhs = Self> is protocol {
    fn add_assign(&mut self, rhs: Rhs);
};

/// Protocol for subtraction assignment (-=).
public type SubAssign<Rhs = Self> is protocol {
    fn sub_assign(&mut self, rhs: Rhs);
};

/// Protocol for multiplication assignment (*=).
public type MulAssign<Rhs = Self> is protocol {
    fn mul_assign(&mut self, rhs: Rhs);
};

/// Protocol for division assignment (/=).
public type DivAssign<Rhs = Self> is protocol {
    fn div_assign(&mut self, rhs: Rhs);
};

/// Protocol for remainder assignment (%=).
public type RemAssign<Rhs = Self> is protocol {
    fn rem_assign(&mut self, rhs: Rhs);
};

/// Protocol for bitwise AND assignment (&=).
public type BitAndAssign<Rhs = Self> is protocol {
    fn bitand_assign(&mut self, rhs: Rhs);
};

/// Protocol for bitwise OR assignment (|=).
public type BitOrAssign<Rhs = Self> is protocol {
    fn bitor_assign(&mut self, rhs: Rhs);
};

/// Protocol for bitwise XOR assignment (^=).
public type BitXorAssign<Rhs = Self> is protocol {
    fn bitxor_assign(&mut self, rhs: Rhs);
};

/// Protocol for left shift assignment (<<=).
public type ShlAssign<Rhs = Self> is protocol {
    fn shl_assign(&mut self, rhs: Rhs);
};

/// Protocol for right shift assignment (>>=).
public type ShrAssign<Rhs = Self> is protocol {
    fn shr_assign(&mut self, rhs: Rhs);
};

// =============================================================================
// Length Protocol — UFCS-style free `len()` dispatch
// =============================================================================

/// Protocol for types that report a length / count.
///
/// Universal `len(x)` free-function dispatch is provided via this
/// protocol — every type that has an inherent `.len(&self) -> Int`
/// method should `implement Length` so that callers can write
/// `len(x)` (the refinement-contract idiom in Dafny/Z3-style specs)
/// without colliding with module-local free `len(...)` overloads
/// such as `core.database.sqlite.native.cte_api.clause.len(&WithClause)`.
///
/// **Why a protocol** (rather than a single non-generic free fn):
///
/// * Verum's overload resolution prefers more-specific candidates
///   over more-generic ones, so a constrained `len<T: Length>` does
///   NOT shadow specialised `len(&WithClause)` etc.
/// * Inherent methods like `List.len(&self)` are kept as the
///   single source of truth — `Length` impls are one-line
///   delegators with `@inline(always)`, so the free-fn form
///   collapses to the inherent method at every call site.
public type Length is protocol {
    fn len(&self) -> Int;
};

/// Universal free-function `len(x)`.
///
/// Resolves via the `Length` protocol — works for any type that
/// implements `Length` (List, Map, Set, Deque, Text, slices,
/// HashMap-style containers).
///
/// This is the canonical entry point for refinement-contract code
/// (`requires idx <= len(arr)`, `decreases len(arr) - idx`, etc.).
@inline(always)
public fn len<T: Length>(container: &T) -> Int {
    container.len()
}

/// Universal free-function `is_empty(x)`.
///
/// Mirror of `len(x)` for the `is_empty()` predicate. Returns
/// `len(container) == 0` so a `Length` impl is sufficient — no
/// separate `IsEmpty` protocol needed.
@inline(always)
public fn is_empty<T: Length>(container: &T) -> Bool {
    container.len() == 0
}
