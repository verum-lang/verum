// =============================================================================
// base/semver_constraint.vr — SemVer 2.0 version constraint parser+matcher
// =============================================================================
// Layer: 1 (Foundation)
// Dependencies: core, base/semver, collections, text
// =============================================================================
//
// Cargo-compatible requirements use parse_cargo. parse_extended adds `||`
// alternatives and whitespace-separated conjunctions; parse is its compatibility
// alias. Both contracts share comparator semantics and identifier validation.
//
// Omitted minor/patch components remain omitted. Matching compares components
// directly, without incrementing an upper bound that could overflow UInt64.
// Release candidates need only satisfy the comparison predicates. By default,
// a prerelease also needs an explicit prerelease operand with its exact version
// triple in the same satisfied conjunction branch. MatchOptions can lift this
// admission rule without changing comparison ordering or exact equality.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LCls,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "SemVer 2.0 version constraint parser and matcher",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.base.semver_constraint;

mount collections.list.{List};
mount base.{Result, Ok, Err, Maybe, Some, None, Text};
mount base.semver.{SemVer, SemVerError};

// =============================================================================
// SemVerConstraint — algebraic constraint tree
// =============================================================================
//
// A constraint is a Boolean expression over comparison atoms.
// Constructors:
//   * `Any`     — matches every version
//   * `Empty`   — matches no version
//   * `Eq(v)`   — matches exactly `v`
//   * `Gt(v)`   — matches versions strictly greater than `v`
//   * `Gte(v)`  — matches versions greater-or-equal to `v`
//   * `Lt(v)`   — matches versions strictly less than `v`
//   * `Lte(v)`  — matches versions less-or-equal to `v`
//   * `And(a,b)` — both `a` and `b` must match
//   * `Or(a,b)`  — either `a` or `b` must match
//
// Parsed comparators retain their declared operator and optional components.
// The original comparison atoms remain available to programmatic callers.
public type SemVerConstraint is
      Any
    | Empty
    | Eq(SemVer)
    | Gt(SemVer)
    | Gte(SemVer)
    | Lt(SemVer)
    | Lte(SemVer)
    | Comparator(SemVerComparator)
    | And(Heap<SemVerConstraint>, Heap<SemVerConstraint>)
    | Or(Heap<SemVerConstraint>, Heap<SemVerConstraint>);

/// Operator of a parsed requirement comparator. The payload is produced by
/// the parsers and convenience constructors; omitted components are not zeroes.
public type SemVerOperator is
      Exact | Greater | GreaterEq | Less | LessEq | Tilde | Caret | Wildcard;

public type SemVerComparator is {
    operator: SemVerOperator,
    major: UInt64,
    minor: Maybe<UInt64>,
    patch: Maybe<UInt64>,
    pre_release: List<Text>,
};

public type SemVerConstraintError is
      InvalidConstraint(Text)
    | InvalidVersion(SemVerError);

implement Display for SemVerConstraintError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            InvalidConstraint(reason) => f.write_str(f"semver-constraint: invalid ({reason})".as_str()),
            InvalidVersion(e)         => e.fmt(f),
        }
    }
}

implement Debug for SemVerConstraintError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { self.fmt(f) }
}

implement Eq for SemVerConstraintError {
    fn eq(&self, other: &Self) -> Bool {
        match (self, other) {
            (InvalidConstraint(a), InvalidConstraint(b)) => a == b,
            (InvalidVersion(a),    InvalidVersion(b))    => a.eq(b),
            _ => false,
        }
    }
}

// =============================================================================
// MatchOptions
// =============================================================================

public type MatchOptions is {
    /// When true, pre-release versions are eligible for matching even
    /// when constraint operands are non-pre-release. Default is false
    /// (Cargo / npm semantics).
    allow_prerelease: Bool,
};

public fn match_options_default() -> MatchOptions {
    MatchOptions { allow_prerelease: false }
}

public fn match_options_allow_prerelease() -> MatchOptions {
    MatchOptions { allow_prerelease: true }
}

// =============================================================================
// Public API
// =============================================================================

/// Compatibility entry point for the extended requirement grammar.
/// Use parse_cargo when validating package publication requirements.
public fn parse(s: &Text) -> Result<SemVerConstraint, SemVerConstraintError> {
    parse_extended(s)
}

/// Parse Cargo-compatible requirements: one wildcard or at most 32 comma-
/// separated comparators, with ASCII spaces around operators and separators.
/// Empty text, OR and implicit whitespace-AND are rejected.
public fn parse_cargo(s: &Text) -> Result<SemVerConstraint, SemVerConstraintError> {
    parse_clause(s, false)
}

/// Parse the shared comparator grammar with `||` alternatives and implicit
/// space/tab-separated AND. This is an explicit extension, not the full npm
/// range language. Each conjunction contains at most 32 comparators.
public fn parse_extended(s: &Text) -> Result<SemVerConstraint, SemVerConstraintError> {
    let parts = split_by_or(s);
    let mut acc = parse_clause(&parts[0], true)?;
    let mut i = 1;
    while i < parts.len() {
        acc = or(acc, parse_clause(&parts[i], true)?);
        i = i + 1;
    }
    Result.Ok(acc)
}

/// Test whether `version` satisfies `constraint` under `options`.
public fn matches(c: &SemVerConstraint, v: &SemVer, opts: &MatchOptions) -> Bool {
    matches_impl(c, v, opts)
}

/// Test with default options (pre-release-strict).
public fn matches_default(c: &SemVerConstraint, v: &SemVer) -> Bool {
    matches_impl(c, v, &match_options_default())
}

/// Test allowing pre-release versions to match — convenience wrapper
/// over `matches(c, v, &match_options_allow_prerelease())`.
public fn matches_allow_prerelease(c: &SemVerConstraint, v: &SemVer) -> Bool {
    matches_impl(c, v, &match_options_allow_prerelease())
}

/// Render a constraint back to canonical text form.
public fn format_constraint(c: &SemVerConstraint) -> Text {
    format_impl(c)
}

// =============================================================================
// Convenience constructors — desugar shorthand operators
// =============================================================================

/// `=v` — exact match.
public fn exact(v: SemVer) -> SemVerConstraint {
    SemVerConstraint.Eq(v)
}

/// `^X.Y.Z` using Cargo compatibility, including prerelease operands.
public fn caret(v: SemVer) -> SemVerConstraint {
    comparator_from_version(SemVerOperator.Caret, v)
}

/// `~X.Y.Z` without incrementing the minor component.
public fn tilde(v: SemVer) -> SemVerConstraint {
    comparator_from_version(SemVerOperator.Tilde, v)
}

/// `~X.Y` retains its omitted patch component.
public fn tilde_minor(major: UInt64, minor: UInt64) -> SemVerConstraint {
    partial_comparator(SemVerOperator.Tilde, major, Maybe.Some(minor), Maybe.None)
}

/// `~X` retains its omitted minor and patch components.
public fn tilde_major(major: UInt64) -> SemVerConstraint {
    partial_comparator(SemVerOperator.Tilde, major, Maybe.None, Maybe.None)
}

/// `X.x` / `X.*` fixes only the major component.
public fn x_range_major(major: UInt64) -> SemVerConstraint {
    partial_comparator(SemVerOperator.Wildcard, major, Maybe.None, Maybe.None)
}

/// `X.Y.x` / `X.Y.*` fixes only the major and minor components.
public fn x_range_minor(major: UInt64, minor: UInt64) -> SemVerConstraint {
    partial_comparator(SemVerOperator.Wildcard, major, Maybe.Some(minor), Maybe.None)
}

fn comparator_from_version(operator: SemVerOperator, v: SemVer) -> SemVerConstraint {
    SemVerConstraint.Comparator(SemVerComparator {
        operator: operator, major: v.major(),
        minor: Maybe.Some(v.minor()), patch: Maybe.Some(v.patch()),
        pre_release: v.prerelease_identifiers().clone(),
    })
}

fn partial_comparator(
    operator: SemVerOperator, major: UInt64, minor: Maybe<UInt64>, patch: Maybe<UInt64>,
) -> SemVerConstraint {
    SemVerConstraint.Comparator(SemVerComparator {
        operator: operator, major: major, minor: minor, patch: patch,
        pre_release: List.new(),
    })
}

/// AND helper that flattens `Any` and absorbs `Empty`.
public fn and(a: SemVerConstraint, b: SemVerConstraint) -> SemVerConstraint {
    match (&a, &b) {
        (SemVerConstraint.Any, _)   => b,
        (_, SemVerConstraint.Any)   => a,
        (SemVerConstraint.Empty, _) => SemVerConstraint.Empty,
        (_, SemVerConstraint.Empty) => SemVerConstraint.Empty,
        _ => SemVerConstraint.And(Heap.new(a), Heap.new(b)),
    }
}

/// OR helper that flattens `Empty` while retaining each branch's prerelease admission.
public fn or(a: SemVerConstraint, b: SemVerConstraint) -> SemVerConstraint {
    match (&a, &b) {
        (SemVerConstraint.Empty, _) => b,
        (_, SemVerConstraint.Empty) => a,
        _ => SemVerConstraint.Or(Heap.new(a), Heap.new(b)),
    }
}

// =============================================================================
// Matching engine
// =============================================================================

fn matches_impl(c: &SemVerConstraint, v: &SemVer, opts: &MatchOptions) -> Bool {
    let (accepts, admits_prerelease) = match_evidence(c, v);
    accepts && (v.prerelease_identifiers().is_empty() || opts.allow_prerelease || admits_prerelease)
}

// The second component records an admitting operand only on a satisfied path.
// And combines admission within that branch; Or never borrows admission from
// a failing alternative. This also handles programmatically nested trees
// without expanding them into disjunctive normal form.
fn match_evidence(c: &SemVerConstraint, v: &SemVer) -> (Bool, Bool) {
    match c {
        SemVerConstraint.Any => (true, false),
        SemVerConstraint.Empty => (false, false),
        SemVerConstraint.Eq(target) => atom_evidence(v.cmp(target) is Ordering.Equal, compatible_operand(v, target)),
        SemVerConstraint.Gt(target) => atom_evidence(v.cmp(target) is Ordering.Greater, compatible_operand(v, target)),
        SemVerConstraint.Gte(target) => atom_evidence(!(v.cmp(target) is Ordering.Less), compatible_operand(v, target)),
        SemVerConstraint.Lt(target) => atom_evidence(v.cmp(target) is Ordering.Less, compatible_operand(v, target)),
        SemVerConstraint.Lte(target) => atom_evidence(!(v.cmp(target) is Ordering.Greater), compatible_operand(v, target)),
        SemVerConstraint.Comparator(comparator) => {
            atom_evidence(comparator_matches(comparator, v), compatible_comparator(comparator, v))
        },
        SemVerConstraint.And(a, b) => {
            let (left, left_pre) = match_evidence(&**a, v);
            let (right, right_pre) = match_evidence(&**b, v);
            (left && right, left && right && (left_pre || right_pre))
        },
        SemVerConstraint.Or(a, b) => {
            let (left, left_pre) = match_evidence(&**a, v);
            let (right, right_pre) = match_evidence(&**b, v);
            (left || right, left_pre || right_pre)
        },
    }
}

fn atom_evidence(accepts: Bool, admits: Bool) -> (Bool, Bool) {
    (accepts, accepts && admits)
}

fn compatible_operand(v: &SemVer, operand: &SemVer) -> Bool {
    !operand.prerelease_identifiers().is_empty()
        && operand.major() == v.major() && operand.minor() == v.minor() && operand.patch() == v.patch()
}

fn compatible_comparator(c: &SemVerComparator, v: &SemVer) -> Bool {
    if c.pre_release.is_empty() || c.major != v.major() { return false; }
    match (&c.minor, &c.patch) {
        (Maybe.Some(minor), Maybe.Some(patch)) => *minor == v.minor() && *patch == v.patch(),
        _ => false,
    }
}

fn comparator_matches(c: &SemVerComparator, v: &SemVer) -> Bool {
    match c.operator {
        SemVerOperator.Exact => comparator_exact(c, v),
        SemVerOperator.Wildcard => comparator_exact(c, v),
        SemVerOperator.Greater => comparator_order(c, v, true),
        SemVerOperator.GreaterEq => comparator_exact(c, v) || comparator_order(c, v, true),
        SemVerOperator.Less => comparator_order(c, v, false),
        SemVerOperator.LessEq => comparator_exact(c, v) || comparator_order(c, v, false),
        SemVerOperator.Tilde => comparator_tilde(c, v),
        SemVerOperator.Caret => comparator_caret(c, v),
    }
}

fn comparator_exact(c: &SemVerComparator, v: &SemVer) -> Bool {
    if v.major() != c.major { return false; }
    match &c.minor {
        Maybe.Some(minor) => { if v.minor() != *minor { return false; } },
        Maybe.None => {},
    }
    match &c.patch {
        Maybe.Some(patch) => { if v.patch() != *patch { return false; } },
        Maybe.None => {},
    }
    prerelease_order(c, v) is Ordering.Equal
}

fn comparator_order(c: &SemVerComparator, v: &SemVer, greater: Bool) -> Bool {
    if v.major() != c.major {
        return if greater { v.major() > c.major } else { v.major() < c.major };
    }
    match &c.minor {
        Maybe.None => return false,
        Maybe.Some(minor) => {
            if v.minor() != *minor {
                return if greater { v.minor() > *minor } else { v.minor() < *minor };
            }
        },
    }
    match &c.patch {
        Maybe.None => return false,
        Maybe.Some(patch) => {
            if v.patch() != *patch {
                return if greater { v.patch() > *patch } else { v.patch() < *patch };
            }
        },
    }
    if greater { prerelease_order(c, v) is Ordering.Greater } else { prerelease_order(c, v) is Ordering.Less }
}

fn comparator_tilde(c: &SemVerComparator, v: &SemVer) -> Bool {
    if v.major() != c.major { return false; }
    match &c.minor {
        Maybe.Some(minor) => { if v.minor() != *minor { return false; } },
        Maybe.None => {},
    }
    match &c.patch {
        Maybe.Some(patch) => { if v.patch() != *patch { return v.patch() > *patch; } },
        Maybe.None => {},
    }
    !(prerelease_order(c, v) is Ordering.Less)
}

fn comparator_caret(c: &SemVerComparator, v: &SemVer) -> Bool {
    if v.major() != c.major { return false; }
    let minor = match &c.minor {
        Maybe.Some(value) => *value,
        Maybe.None => return true,
    };
    let patch = match &c.patch {
        Maybe.Some(value) => *value,
        Maybe.None => return if c.major > 0 { v.minor() >= minor } else { v.minor() == minor },
    };
    if c.major > 0 {
        if v.minor() != minor { return v.minor() > minor; }
        if v.patch() != patch { return v.patch() > patch; }
    } else if minor > 0 {
        if v.minor() != minor { return false; }
        if v.patch() != patch { return v.patch() > patch; }
    } else if v.minor() != minor || v.patch() != patch {
        return false;
    }
    !(prerelease_order(c, v) is Ordering.Less)
}

// Compare only prerelease precedence through SemVer's shared ordering API.
fn prerelease_order(c: &SemVerComparator, v: &SemVer) -> Ordering {
    v.compare_prerelease(&c.pre_release)
}

// =============================================================================
// Shared scanner and comparator parser
// =============================================================================

fn requirement_space(b: Byte, extended: Bool) -> Bool {
    b == 0x20_u8 || (extended && b == 0x09_u8)
}

fn skip_requirement_space(bytes: &[Byte], start: Int, extended: Bool) -> Int {
    let mut i = start;
    while i < bytes.len() && requirement_space(bytes[i], extended) { i = i + 1; }
    i
}

fn operator_length(bytes: &[Byte], start: Int) -> Int {
    if start >= bytes.len() { return 0; }
    let b = bytes[start];
    if b == 0x3E_u8 || b == 0x3C_u8 {
        if start + 1 < bytes.len() && bytes[start + 1] == 0x3D_u8 { return 2; }
        return 1;
    }
    if b == 0x3D_u8 || b == 0x5E_u8 || b == 0x7E_u8 { return 1; }
    0
}

fn parse_clause(s: &Text, extended: Bool) -> Result<SemVerConstraint, SemVerConstraintError> {
    let bytes = s.as_bytes();
    let mut cursor = skip_requirement_space(bytes, 0, extended);
    let mut count = 0;
    let mut saw_any = false;
    let mut acc = SemVerConstraint.Any;
    loop {
        if cursor >= bytes.len() {
            return Result.Err(SemVerConstraintError.InvalidConstraint("missing comparator".to_text()));
        }
        if count == 32 {
            return Result.Err(SemVerConstraintError.InvalidConstraint("too many comparators".to_text()));
        }
        let body_start = skip_requirement_space(bytes, cursor + operator_length(bytes, cursor), extended);
        let mut end = body_start;
        while end < bytes.len() && !requirement_space(bytes[end], extended) && bytes[end] != 0x2C_u8 {
            end = end + 1;
        }
        if end == body_start {
            return Result.Err(SemVerConstraintError.InvalidConstraint("missing version".to_text()));
        }
        let atom = parse_atom(&slice_text(bytes, cursor, end), extended)?;
        let is_any = atom is SemVerConstraint.Any;
        if !extended && count > 0 && (saw_any || is_any) {
            return Result.Err(SemVerConstraintError.InvalidConstraint("wildcard must be the only comparator".to_text()));
        }
        saw_any = saw_any || is_any;
        acc = and(acc, atom);
        count = count + 1;
        cursor = skip_requirement_space(bytes, end, extended);
        if cursor == bytes.len() { return Result.Ok(acc); }
        if bytes[cursor] == 0x2C_u8 {
            cursor = skip_requirement_space(bytes, cursor + 1, extended);
        } else if !extended || cursor == end {
            return Result.Err(SemVerConstraintError.InvalidConstraint("expected comma between comparators".to_text()));
        }
    }
}

fn split_by_or(s: &Text) -> List<Text> {
    let bytes = s.as_bytes();
    let mut parts: List<Text> = List.new();
    let mut start = 0;
    let mut i = 0;
    while i + 1 < bytes.len() {
        if bytes[i] == 0x7C_u8 && bytes[i + 1] == 0x7C_u8 {
            parts.push(slice_text(bytes, start, i));
            i = i + 2;
            start = i;
        } else {
            i = i + 1;
        }
    }
    parts.push(slice_text(bytes, start, bytes.len()));
    parts
}

fn parse_atom(s: &Text, extended: Bool) -> Result<SemVerConstraint, SemVerConstraintError> {
    let bytes = s.as_bytes();
    let op_len = operator_length(bytes, 0);
    let operator = if op_len == 0 { SemVerOperator.Caret }
        else if bytes[0] == 0x3D_u8 { SemVerOperator.Exact }
        else if bytes[0] == 0x5E_u8 { SemVerOperator.Caret }
        else if bytes[0] == 0x7E_u8 { SemVerOperator.Tilde }
        else if bytes[0] == 0x3E_u8 {
            if op_len == 2 { SemVerOperator.GreaterEq } else { SemVerOperator.Greater }
        } else {
            if op_len == 2 { SemVerOperator.LessEq } else { SemVerOperator.Less }
        };
    let offset = skip_requirement_space(bytes, op_len, extended);
    let version = slice_text(bytes, offset, bytes.len());
    if op_len == 0 && is_wildcard(&version) { return Result.Ok(SemVerConstraint.Any); }
    parse_partial(&version, operator, op_len == 0)
}

fn is_wildcard(s: &Text) -> Bool {
    let bytes = s.as_bytes();
    bytes.len() == 1 && (bytes[0] == 0x2A_u8 || bytes[0] == 0x78_u8 || bytes[0] == 0x58_u8)
}

fn parse_partial(
    s: &Text, operator: SemVerOperator, default_operator: Bool,
) -> Result<SemVerConstraint, SemVerConstraintError> {
    let (before_build, build) = split_suffix(s, 0x2B_u8);
    let (core_part, prerelease) = split_suffix(&before_build, 0x2D_u8);
    let parts = split_dot(&core_part);
    if parts.len() > 3 {
        return Result.Err(SemVerConstraintError.InvalidConstraint("too many version components".to_text()));
    }
    let major = parse_component(&parts[0])?;
    let mut minor: Maybe<UInt64> = Maybe.None;
    let mut patch: Maybe<UInt64> = Maybe.None;
    let mut minor_wildcard = false;
    let mut has_wildcard = false;
    if parts.len() > 1 {
        if is_wildcard(&parts[1]) {
            minor_wildcard = true;
            has_wildcard = true;
        } else {
            minor = Maybe.Some(parse_component(&parts[1])?);
        }
    }
    if parts.len() > 2 {
        if is_wildcard(&parts[2]) {
            has_wildcard = true;
        } else if minor_wildcard {
            return Result.Err(SemVerConstraintError.InvalidConstraint("numeric component after wildcard".to_text()));
        } else {
            patch = Maybe.Some(parse_component(&parts[2])?);
        }
    }
    if patch.is_none() && (prerelease.is_some() || build.is_some()) {
        return Result.Err(SemVerConstraintError.InvalidConstraint("suffix requires a complete version".to_text()));
    }
    let pre_release = match &prerelease {
        Maybe.Some(text) => parse_identifiers(text, true)?,
        Maybe.None => List.new(),
    };
    match &build {
        Maybe.Some(text) => { parse_identifiers(text, false)?; },
        Maybe.None => {},
    }
    let selected_operator = if default_operator && has_wildcard { SemVerOperator.Wildcard } else { operator };
    Result.Ok(SemVerConstraint.Comparator(SemVerComparator {
        operator: selected_operator, major: major, minor: minor, patch: patch,
        pre_release: pre_release,
    }))
}

fn parse_component(s: &Text) -> Result<UInt64, SemVerConstraintError> {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return Result.Err(SemVerConstraintError.InvalidConstraint("empty version component".to_text()));
    }
    if bytes.len() > 1 && bytes[0] == 0x30_u8 {
        return Result.Err(SemVerConstraintError.InvalidConstraint("leading zero in version component".to_text()));
    }
    let mut value: UInt64 = 0_u64;
    let mut i = 0;
    while i < bytes.len() {
        let b = bytes[i];
        if b < 0x30_u8 || b > 0x39_u8 {
            return Result.Err(SemVerConstraintError.InvalidConstraint("non-digit in version component".to_text()));
        }
        let digit = (b - 0x30_u8) as UInt64;
        // Check before multiplication/addition; no wrapping or saturating parse.
        if value > 1_844_674_407_370_955_161_u64
            || (value == 1_844_674_407_370_955_161_u64 && digit > 5_u64) {
            return Result.Err(SemVerConstraintError.InvalidConstraint("version component overflows UInt64".to_text()));
        }
        value = value * 10_u64 + digit;
        i = i + 1;
    }
    Result.Ok(value)
}

fn parse_identifiers(s: &Text, prerelease: Bool) -> Result<List<Text>, SemVerConstraintError> {
    let identifiers = split_dot(s);
    let mut i = 0;
    while i < identifiers.len() {
        let bytes = identifiers[i].as_bytes();
        if bytes.is_empty() {
            return Result.Err(SemVerConstraintError.InvalidConstraint("empty identifier".to_text()));
        }
        let mut numeric = true;
        let mut j = 0;
        while j < bytes.len() {
            let b = bytes[j];
            let digit = b >= 0x30_u8 && b <= 0x39_u8;
            let letter = (b >= 0x41_u8 && b <= 0x5A_u8) || (b >= 0x61_u8 && b <= 0x7A_u8);
            if !digit && !letter && b != 0x2D_u8 {
                return Result.Err(SemVerConstraintError.InvalidConstraint("invalid identifier character".to_text()));
            }
            if !digit { numeric = false; }
            j = j + 1;
        }
        if prerelease && numeric && bytes.len() > 1 && bytes[0] == 0x30_u8 {
            return Result.Err(SemVerConstraintError.InvalidConstraint("leading zero in prerelease identifier".to_text()));
        }
        i = i + 1;
    }
    Result.Ok(identifiers)
}

// =============================================================================
// Formatter — render constraint back to canonical text
// =============================================================================

fn format_impl(c: &SemVerConstraint) -> Text {
    match c {
        SemVerConstraint.Any        => "*".to_text(),
        SemVerConstraint.Empty      => "<0.0.0".to_text(),
        SemVerConstraint.Eq(v)      => "=".to_text().concat(&f"{v}"),
        SemVerConstraint.Gt(v)      => ">".to_text().concat(&f"{v}"),
        SemVerConstraint.Gte(v)     => ">=".to_text().concat(&f"{v}"),
        SemVerConstraint.Lt(v)      => "<".to_text().concat(&f"{v}"),
        SemVerConstraint.Lte(v)     => "<=".to_text().concat(&f"{v}"),
        SemVerConstraint.Comparator(c) => format_comparator(c),
        SemVerConstraint.And(a, b)  => format_impl(&**a).concat(&", ".to_text()).concat(&format_impl(&**b)),
        SemVerConstraint.Or(a, b)   => format_impl(&**a).concat(&" || ".to_text()).concat(&format_impl(&**b)),
    }
}

fn format_comparator(c: &SemVerComparator) -> Text {
    let prefix = match c.operator {
        SemVerOperator.Exact => "=",
        SemVerOperator.Greater => ">",
        SemVerOperator.GreaterEq => ">=",
        SemVerOperator.Less => "<",
        SemVerOperator.LessEq => "<=",
        SemVerOperator.Tilde => "~",
        SemVerOperator.Caret => "^",
        SemVerOperator.Wildcard => "",
    };
    let mut out = prefix.to_text().concat(&f"{c.major}");
    match &c.minor {
        Maybe.Some(minor) => { out = out.concat(&f".{*minor}"); },
        Maybe.None => {},
    }
    match &c.patch {
        Maybe.Some(patch) => { out = out.concat(&f".{*patch}"); },
        Maybe.None => {},
    }
    if c.operator is SemVerOperator.Wildcard { out = out.concat(&".*"); }
    let mut i = 0;
    while i < c.pre_release.len() {
        let separator = if i == 0 { "-" } else { "." };
        out = out.concat(&separator).concat(&c.pre_release[i]);
        i = i + 1;
    }
    out
}

// =============================================================================
// Helpers
// =============================================================================

fn slice_text(bytes: &[Byte], start: Int, end: Int) -> Text {
    let mut buf: List<Byte> = List.new();
    let mut i = start;
    while i < end { buf.push(bytes[i]); i = i + 1; }
    Text.from_bytes(&buf).unwrap_or(Text.new())
}

fn split_suffix(s: &Text, delimiter: Byte) -> (Text, Maybe<Text>) {
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == delimiter {
            return (slice_text(bytes, 0, i), Maybe.Some(slice_text(bytes, i + 1, bytes.len())));
        }
        i = i + 1;
    }
    (s.clone(), Maybe.None)
}

fn split_dot(s: &Text) -> List<Text> {
    let bs = s.as_bytes();
    let mut parts: List<Text> = List.new();
    let mut start = 0;
    let mut i = 0;
    while i < bs.len() {
        if bs[i] == 0x2E_u8 {
            parts.push(slice_text(bs, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    parts.push(slice_text(bs, start, bs.len()));
    parts
}

