// =============================================================================
// base/semver.vr — Semantic Versioning 2.0.0 parser + comparator
// =============================================================================
// Layer: 0 (Base)
// Dependencies: core
// Reference: https://semver.org/spec/v2.0.0.html
// =============================================================================
//

// Semver 2.0.0 — the package-version grammar used by npm, Cargo,
// pip, Maven, RubyGems, Go modules, Helm charts, OCI images,
// Kubernetes CRDs, and every modern language ecosystem.
//

// # Grammar (EBNF fragment)
//

// ```
// version = major "." minor "." patch [ "-" pre-release ] [ "+" build-meta ]
// major = <non-leading-zero digits>
// pre-release = identifier *("." identifier)
// build-meta = alnum_id *("." alnum_id)
// ```
//

// # Examples
//

//  1.2.3
//  1.0.0-alpha
//  1.0.0-alpha.1
//  1.0.0-0.3.7
//  1.0.0-x.7.z.92
//  1.0.0+20130313144700
//  1.0.0-beta+exp.sha.5114f85
//

// # Ordering (§11)
//

//  major → minor → patch (numeric comparison each)
//  → pre-release: none > any prerelease
//  → within prereleases, dot-separated identifiers compared
//  left-to-right: numeric < alphanumeric by ASCII, fewer
//  identifiers < more when common prefix equal.
//  build-meta is IGNORED in precedence.
//

// # API
//

// ```
// let v: SemVer = SemVer.parse(&Text.from("1.2.3-beta.1+build.5"))?;
// assert(v.major() == 1);
// assert(v.prerelease_identifiers().len() == 2); // ["beta", "1"]
//

// // Total ordering.
// let a = SemVer.parse(&Text.from("1.0.0-alpha"))?;
// let b = SemVer.parse(&Text.from("1.0.0"))?;
// assert(a.cmp(&b) is Less); // prerelease < release
// ```
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.base.semver;

mount core.collections.list.{List};

// =============================================================================
// Typed value
// =============================================================================

public type SemVer is {
    major:       UInt64,
    minor:       UInt64,
    patch:       UInt64,
    /// Dot-separated pre-release identifiers. Empty = release.
    pre_release: List<Text>,
    /// Dot-separated build metadata identifiers. Ignored by
    /// `cmp` per §10.
    build_meta:  List<Text>,
};

public type SemVerError is
      Malformed(Text)
    | LeadingZero(Text)
    | InvalidIdentifier(Text)
    | Overflow(Text);

implement Display for SemVerError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            Malformed(reason)         => f.write_str(f"semver: malformed ({reason})".as_str()),
            LeadingZero(field)        => f.write_str(f"semver: leading zero on {field}".as_str()),
            InvalidIdentifier(field)  => f.write_str(f"semver: invalid identifier ({field})".as_str()),
            Overflow(field)           => f.write_str(f"semver: numeric overflow ({field})".as_str()),
        }
    }
}

implement Debug for SemVerError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            Malformed(reason)         => f.write_str(f"Malformed({reason})".as_str()),
            LeadingZero(field)        => f.write_str(f"LeadingZero({field})".as_str()),
            InvalidIdentifier(field)  => f.write_str(f"InvalidIdentifier({field})".as_str()),
            Overflow(field)           => f.write_str(f"Overflow({field})".as_str()),
        }
    }
}

implement Eq for SemVerError {
    fn eq(&self, other: &SemVerError) -> Bool {
        match (self, other) {
            (Malformed(a),         Malformed(b))         => a == b,
            (LeadingZero(a),       LeadingZero(b))       => a == b,
            (InvalidIdentifier(a), InvalidIdentifier(b)) => a == b,
            (Overflow(a),          Overflow(b))          => a == b,
            _ => false,
        }
    }
}

// UInt64.MAX = 18_446_744_073_709_551_615 — exactly 20 decimal digits.
// A major/minor/patch component longer than 20 digits cannot fit; reject pre-loop.
const MAX_NUMERIC_DIGITS: Int = 20;
// UInt64.MAX / 10 — the per-step guard against `v * 10` overflowing the
// next iteration. SemVer §9 numeric identifiers carry no semantic upper
// bound, so without this check a hostile manifest can wrap the major /
// minor / patch comparator silently.
const U64_MAX_DIV_10: UInt64 = 1_844_674_407_370_955_161_u64;

// =============================================================================
// Parser
// =============================================================================

fn parse_text(s: &Text) -> Result<SemVer, SemVerError> {
    let b = s.as_bytes();
    if b.len() == 0 {
        return Result.Err(SemVerError.Malformed(Text.from("empty")));
    }

    // Find separators.
    let mut dash: Int = -1;
    let mut plus: Int = -1;
    let mut i: Int = 0;
    while i < b.len() {
        if dash < 0 && b[i] == ('-' as Byte) { dash = i; }
        if plus < 0 && b[i] == ('+' as Byte) { plus = i; }
        i = i + 1;
    }
    // If a `+` appears before `-`, the `-` is inside build-meta
    // and not a prerelease separator.
    if plus >= 0 && dash > plus { dash = -1; }

    let core_end = if dash >= 0 { dash } else if plus >= 0 { plus } else { b.len() };

    let (major, minor, patch) = parse_core(b, 0, core_end)?;

    let mut pre_release: List<Text> = [];
    if dash >= 0 {
        let pre_end = if plus >= 0 { plus } else { b.len() };
        pre_release = parse_prerelease(b, dash + 1, pre_end)?;
    }

    let mut build_meta: List<Text> = [];
    if plus >= 0 {
        build_meta = parse_build_meta(b, plus + 1, b.len())?;
    }

    Result.Ok(SemVer {
        major: major, minor: minor, patch: patch,
        pre_release: pre_release, build_meta: build_meta,
    })
}

fn parse_core(b: &[Byte], start: Int, end: Int) -> Result<(UInt64, UInt64, UInt64), SemVerError> {
    // <major>.<minor>.<patch>
    let mut dot_positions: [Int; 2] = [-1; 2];
    let mut found: Int = 0;
    let mut i: Int = start;
    while i < end && found < 2 {
        if b[i] == ('.' as Byte) {
            dot_positions[found] = i;
            found = found + 1;
        }
        i = i + 1;
    }
    if found != 2 {
        return Result.Err(SemVerError.Malformed(Text.from("need major.minor.patch")));
    }
    let major = parse_numeric(b, start, dot_positions[0])?;
    let minor = parse_numeric(b, dot_positions[0] + 1, dot_positions[1])?;
    let patch = parse_numeric(b, dot_positions[1] + 1, end)?;
    Result.Ok((major, minor, patch))
}

fn parse_numeric(b: &[Byte], start: Int, end: Int) -> Result<UInt64, SemVerError> {
    if start >= end {
        return Result.Err(SemVerError.Malformed(Text.from("empty numeric")));
    }
    // Pre-loop length cap — anything past UInt64 width cannot represent.
    if end - start > MAX_NUMERIC_DIGITS {
        return Result.Err(SemVerError.Overflow(slice_text(b, start, end)));
    }
    // §9: "numeric identifiers MUST NOT include leading zeroes."
    if end - start > 1 && b[start] == ('0' as Byte) {
        return Result.Err(SemVerError.LeadingZero(slice_text(b, start, end)));
    }
    let mut v: UInt64 = 0_u64;
    let mut i: Int = start;
    while i < end {
        let c = b[i];
        if c < ('0' as Byte) || c > ('9' as Byte) {
            return Result.Err(SemVerError.InvalidIdentifier(slice_text(b, start, end)));
        }
        // Per-step guard: if v > MAX/10, the next `v * 10` overflows.
        // Length cap above admits 20-digit strings whose final value can
        // still exceed UInt64.MAX (e.g. `99999999999999999999`), so the
        // per-step check is required even with the cap.
        if v > U64_MAX_DIV_10 {
            return Result.Err(SemVerError.Overflow(slice_text(b, start, end)));
        }
        let next = v * 10_u64 + ((c - ('0' as Byte)) as UInt64);
        // Wrap-around defence: at v == MAX/10 = 1_844_674_407_370_955_161
        // the next `* 10 + d` overflows for d ≥ 6 (because MAX = ...615).
        if next < v {
            return Result.Err(SemVerError.Overflow(slice_text(b, start, end)));
        }
        v = next;
        i = i + 1;
    }
    Result.Ok(v)
}

fn parse_prerelease(b: &[Byte], start: Int, end: Int) -> Result<List<Text>, SemVerError> {
    // Dot-separated identifiers; each must be non-empty, ASCII
    // alphanumeric or hyphen. Numeric identifiers forbid leading zeros.
    let parts = split_dots(b, start, end);
    if parts.len() == 0 || (parts.len() == 1 && parts[0].0 == parts[0].1) {
        return Result.Err(SemVerError.Malformed(Text.from("empty prerelease")));
    }
    let mut out: List<Text> = [];
    let mut i: Int = 0;
    while i < parts.len() {
        let (id_start, id_end) = parts[i];
        if id_start == id_end {
            return Result.Err(SemVerError.Malformed(Text.from("empty identifier")));
        }
        validate_prerelease_id(b, id_start, id_end)?;
        out.push(slice_text(b, id_start, id_end));
        i = i + 1;
    }
    Result.Ok(out)
}

fn validate_prerelease_id(b: &[Byte], start: Int, end: Int) -> Result<(), SemVerError> {
    let mut is_numeric = true;
    let mut j: Int = start;
    while j < end {
        let c = b[j];
        if !is_prerelease_ch(c) {
            return Result.Err(SemVerError.InvalidIdentifier(slice_text(b, start, end)));
        }
        if !(c >= ('0' as Byte) && c <= ('9' as Byte)) { is_numeric = false; }
        j = j + 1;
    }
    if is_numeric && (end - start) > 1 && b[start] == ('0' as Byte) {
        return Result.Err(SemVerError.LeadingZero(slice_text(b, start, end)));
    }
    // Prerelease identifiers are text, with no UInt64 width restriction.
    // Their numeric order uses decimal length and lexicographic comparison.
    Result.Ok(())
}

fn parse_build_meta(b: &[Byte], start: Int, end: Int) -> Result<List<Text>, SemVerError> {
    let parts = split_dots(b, start, end);
    if parts.len() == 0 || (parts.len() == 1 && parts[0].0 == parts[0].1) {
        return Result.Err(SemVerError.Malformed(Text.from("empty build-meta")));
    }
    let mut out: List<Text> = [];
    let mut i: Int = 0;
    while i < parts.len() {
        let (id_start, id_end) = parts[i];
        if id_start == id_end {
            return Result.Err(SemVerError.Malformed(Text.from("empty build-meta identifier")));
        }
        let mut j: Int = id_start;
        while j < id_end {
            if !is_prerelease_ch(b[j]) {
                return Result.Err(SemVerError.InvalidIdentifier(slice_text(b, id_start, id_end)));
            }
            j = j + 1;
        }
        // Build-meta allows leading zeros (§10 — no numeric
        // comparison inside).
        out.push(slice_text(b, id_start, id_end));
        i = i + 1;
    }
    Result.Ok(out)
}

fn is_prerelease_ch(c: Byte) -> Bool {
    (c >= ('0' as Byte) && c <= ('9' as Byte))
        || (c >= ('A' as Byte) && c <= ('Z' as Byte))
        || (c >= ('a' as Byte) && c <= ('z' as Byte))
        || c == ('-' as Byte)
}

// =============================================================================
// Ordering (§11)
// =============================================================================

/// Total order per SemVer §11 (build-meta is NOT significant).
/// Private: the public surface is `implement Ord for SemVer`.
fn compare(a: &SemVer, b: &SemVer) -> Ordering {
    let c = cmp_u64(a.major, b.major);
    if c != Equal { return c; }
    let c = cmp_u64(a.minor, b.minor);
    if c != Equal { return c; }
    let c = cmp_u64(a.patch, b.patch);
    if c != Equal { return c; }

    compare_prerelease_identifiers(&a.pre_release, &b.pre_release)
}

fn compare_prerelease_identifiers(a: &List<Text>, b: &List<Text>) -> Ordering {
    // Pre-release: none > any prerelease (§11.3).
    match (a.len() == 0, b.len() == 0) {
        (true,  true)  => { return Equal; },
        (true,  false) => { return Greater; },
        (false, true)  => { return Less; },
        _              => {},
    }

    // Compare identifier-by-identifier (§11.4).
    let mut i: Int = 0;
    while i < a.len() && i < b.len() {
        let x = &a[i];
        let y = &b[i];
        let c = cmp_prerelease_id(x, y);
        if c != Equal { return c; }
        i = i + 1;
    }
    // §11.4.4: longer set > shorter when common prefix equal.
    cmp_int(a.len(), b.len())
}

fn cmp_prerelease_id(a: &Text, b: &Text) -> Ordering {
    let ab = a.as_bytes();
    let bb = b.as_bytes();
    let a_num = is_all_numeric(ab);
    let b_num = is_all_numeric(bb);
    // Numeric < alphanumeric (§11.4.3).
    if a_num && !b_num { return Less; }
    if !a_num && b_num { return Greater; }
    if a_num && b_num && ab.len() != bb.len() {
        // Leading zeroes are rejected by the parser, so decimal length is
        // numerical significance. Equal-length digits use the same ASCII
        // comparison below; no fixed-width conversion or saturation occurs.
        return cmp_int(ab.len(), bb.len());
    }
    // Equal-length numeric or two alphanumeric identifiers: ASCII order.
    let mut i: Int = 0;
    while i < ab.len() && i < bb.len() {
        if ab[i] < bb[i] { return Less; }
        if ab[i] > bb[i] { return Greater; }
        i = i + 1;
    }
    cmp_int(ab.len(), bb.len())
}

fn is_all_numeric(b: &[Byte]) -> Bool {
    if b.len() == 0 { return false; }
    let mut i: Int = 0;
    while i < b.len() {
        if b[i] < ('0' as Byte) || b[i] > ('9' as Byte) { return false; }
        i = i + 1;
    }
    true
}

fn cmp_u64(a: UInt64, b: UInt64) -> Ordering {
    if a < b { Less } else if a > b { Greater } else { Equal }
}

fn cmp_int(a: Int, b: Int) -> Ordering {
    if a < b { Less } else if a > b { Greater } else { Equal }
}

// =============================================================================
// Formatter
// =============================================================================

/// Render a SemVer as its canonical 2.0.0 string.
/// Private: the public surface is `implement Display for SemVer`.
fn render(v: &SemVer) -> Text {
    let mut out: List<Byte> = [];
    push_u64(&mut out, v.major);
    out.push('.' as Byte);
    push_u64(&mut out, v.minor);
    out.push('.' as Byte);
    push_u64(&mut out, v.patch);

    if v.pre_release.len() > 0 {
        out.push('-' as Byte);
        join_into(&mut out, &v.pre_release, '.' as Byte);
    }
    if v.build_meta.len() > 0 {
        out.push('+' as Byte);
        join_into(&mut out, &v.build_meta, '.' as Byte);
    }
    Text.from_utf8_unchecked(out.as_slice())
}

// =============================================================================
// Public surface — protocol-coherent, no ambient verbs
// =============================================================================
//
// SemVer's entire API is reached through the TYPE (`SemVer.parse`,
// `SemVer.zero` and read-only instance methods) or through the LANGUAGE's own protocols (`Display`
// for rendering, `Ord`/`Eq` for comparison).  Nothing here is a free
// function: a bare `parse` / `format` / `cmp` in the ambient namespace
// binds silently across unrelated domains (five stdlib modules used to
// export a free `parse`), which is exactly what design principle #2
// («No Magic: all dependencies explicit») forbids.

implement SemVer {
    /// Major component of this parsed version.
    public fn major(&self) -> UInt64 { self.major }

    /// Minor component of this parsed version.
    public fn minor(&self) -> UInt64 { self.minor }

    /// Patch component of this parsed version.
    public fn patch(&self) -> UInt64 { self.patch }

    /// Borrow the parsed prerelease identifiers without permitting mutation.
    /// An empty list denotes a release version.
    public fn prerelease_identifiers(&self) -> &List<Text> { &self.pre_release }

    /// Compare prerelease precedence with already parsed identifiers.
    /// Empty denotes a release. This shares Ord's identifier ordering and does
    /// not parse or validate the supplied identifiers or compare core numbers.
    public fn compare_prerelease(&self, identifiers: &List<Text>) -> Ordering {
        compare_prerelease_identifiers(&self.pre_release, identifiers)
    }

    /// Parse a canonical SemVer 2.0.0 string.
    public fn parse(s: &Text) -> Result<SemVer, SemVerError> {
        parse_text(s)
    }

    /// The all-zero version `0.0.0` — the identity lower bound for
    /// resolution loops and the "nothing pinned yet" sentinel.
    public fn zero() -> SemVer {
        SemVer {
            major: 0_u64,
            minor: 0_u64,
            patch: 0_u64,
            pre_release: List.new(),
            build_meta:  List.new(),
        }
    }
}

implement Display for SemVer {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(render(self).as_str())
    }
}

implement Eq for SemVer {
    /// Precedence equality per §11: build-meta is NOT significant, so
    /// `1.0.0+a == 1.0.0+b`.  Defined through the same comparison the
    /// Ord impl uses, so the two can never disagree.
    fn eq(&self, other: &SemVer) -> Bool {
        match compare(self, other) {
            Ordering.Equal => true,
            _              => false,
        }
    }
}

implement Ord for SemVer {
    fn cmp(&self, other: &SemVer) -> Ordering {
        compare(self, other)
    }
}

// =============================================================================
// Helpers
// =============================================================================

fn split_dots(b: &[Byte], start: Int, end: Int) -> List<(Int, Int)> {
    let mut out: List<(Int, Int)> = [];
    let mut cur_start: Int = start;
    let mut i: Int = start;
    while i < end {
        if b[i] == ('.' as Byte) {
            out.push((cur_start, i));
            cur_start = i + 1;
        }
        i = i + 1;
    }
    out.push((cur_start, end));
    out
}

fn slice_text(b: &[Byte], start: Int, end: Int) -> Text {
    let mut out: List<Byte> = [];
    let mut i: Int = start;
    while i < end { out.push(b[i]); i = i + 1; }
    Text.from_utf8_unchecked(out.as_slice())
}

fn push_u64(dst: &mut List<Byte>, n: UInt64) {
    if n == 0_u64 { dst.push('0' as Byte); return; }
    let mut buf: List<Byte> = [];
    let mut x = n;
    while x > 0_u64 {
        let d = (x % 10_u64) as Byte;
        buf.push(('0' as Byte) + d);
        x = x / 10_u64;
    }
    let mut i: Int = buf.len() - 1;
    while i >= 0 { dst.push(buf[i]); i = i - 1; }
}

fn join_into(dst: &mut List<Byte>, parts: &List<Text>, sep: Byte) {
    let mut i: Int = 0;
    while i < parts.len() {
        if i > 0 { dst.push(sep); }
        let pb = parts[i].as_bytes();
        let mut j: Int = 0;
        while j < pb.len() { dst.push(pb[j]); j = j + 1; }
        i = i + 1;
    }
}
