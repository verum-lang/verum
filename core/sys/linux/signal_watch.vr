module core.sys.linux.signal_watch;

mount core.sys.common.OSError;
mount core.sys.linux.errno.{EBADF, EBUSY, EINVAL};

@intrinsic("linux_signal_watch")
unsafe fn native_signal_watch(number: Int, operation: Int) -> Int;

/// Owns the process disposition until restoration. The native handler records
/// deliveries without entering the interpreter, allocating, or taking a lock.
public type affine SignalWatch is { number: Int32 };

implement SignalWatch {
    public fn new() -> SignalWatch { SignalWatch { number: 0 } }

    public unsafe fn install(&mut self, number: Int32) -> Result<(), OSError> {
        if number < 1 || number > 64 { return Result.Err(OSError.from_code(EINVAL)); }
        if self.number == number { return Result.Ok(()); }
        if self.number != 0 { return Result.Err(OSError.from_code(EBUSY)); }
        let result = unsafe { native_signal_watch(number as Int, 0) };
        if result < 0 { return Result.Err(OSError.from_code(-result)); }
        self.number = number;
        Result.Ok(())
    }

    public fn take(&self) -> Result<Int, OSError> {
        if self.number == 0 { return Result.Err(OSError.from_code(EBADF)); }
        let count = unsafe { native_signal_watch(self.number as Int, 1) };
        if count < 0 { return Result.Err(OSError.from_code(-count)); }
        Result.Ok(count)
    }

    public fn restore(&mut self) -> Result<(), OSError> {
        if self.number == 0 { return Result.Ok(()); }
        let result = unsafe { native_signal_watch(self.number as Int, 2) };
        if result < 0 { return Result.Err(OSError.from_code(-result)); }
        self.number = 0;
        Result.Ok(())
    }
}
