// =============================================================================
// sys/fs_watch.vr - Native filesystem watcher
// =============================================================================
// Layer: 2 (Sys)
// Dependencies: sys.{darwin,linux,windows}, base.memory
// =============================================================================
//

// Platform-native event-driven filesystem monitoring. Provides a uniform
// `FsWatcher` over:
//

//  * macOS — kqueue / EVFILT_VNODE
//  * Linux — inotify (raw inotify_init1 + inotify_add_watch syscalls)
//  * Windows — ReadDirectoryChangesW (overlapped + WaitForMultipleObjects;
//  parses FILE_NOTIFY_INFORMATION records out of a per-watch 4 KiB
//  buffer; subtree watching enabled, full filter mask covering
//  name/dir/write/attribute/size/creation changes)
//

// Sub-millisecond latency, kernel-driven; no polling overhead. Each
// `FsEvent` carries the affected path plus the kind of change (created,
// modified, deleted, renamed, attribute-changed).
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.sys.fs_watch;

// Ring 1 mounts the DEFINING module, not the root umbrella:
// `mount core.{…}` is an edge to everything the prelude re-exports, and
// the prelude publishes `format_debug` from `text.format` (ring 2)
// because the language emits that name. rings.toml states the same
// consequence for ring 0 and the same remedy (T1064).
mount core.base.maybe.{Maybe};
mount core.base.result.{Result};
mount core.collections.list.{List};
mount core.text.text.{Text};
mount core.base.protocols.{Display, Debug, Clone, Drop};
mount core.sys.common.{OSError, FileDesc};

// =============================================================================
// FsEventKind — what kind of change occurred
// =============================================================================

public type FsEventKind is
    | Created
    | Modified
    | Deleted
    | Renamed
    | AttribChanged;

implement Clone for FsEventKind {
    fn clone(&self) -> FsEventKind { *self }
}

// =============================================================================
// FsEvent — one observed change
// =============================================================================

public type FsEvent is {
    /// Watched path that fired. For inotify-style backends this is the
    /// directory; for kqueue/Windows the original target.
    pub path: Text,
    pub kind: FsEventKind,
}

// =============================================================================
// FsWatcher — kernel-event-driven monitor
// =============================================================================

@must_consume
public type FsWatcher is {
    inner: FsWatcherImpl,
}

implement FsWatcher {
    /// Open a fresh watcher. Returns Err on platforms where the native
    /// backend is unavailable or could not be initialised.
    public fn new() -> Result<FsWatcher, Text> {
        @cfg(target_os = "macos")
        {
            return match KqueueBackend.new() {
                Result.Ok(b)  => Result.Ok(FsWatcher { inner: FsWatcherImpl.Kqueue(b) }),
                Result.Err(e) => Result.Err(e),
            };
        }
        @cfg(target_os = "linux")
        {
            return match InotifyBackend.new() {
                Result.Ok(b)  => Result.Ok(FsWatcher { inner: FsWatcherImpl.Inotify(b) }),
                Result.Err(e) => Result.Err(e),
            };
        }
        @cfg(target_os = "windows")
        {
            return match RdcwBackend.new() {
                Result.Ok(b)  => Result.Ok(FsWatcher { inner: FsWatcherImpl.Rdcw(b) }),
                Result.Err(e) => Result.Err(e),
            };
        }
    }

    /// Add a path to the watch set. The same path may be added more than
    /// once; events fire once per registration.
    public fn add(&mut self, path: &Text) -> Result<(), Text> {
        match &mut self.inner {
            FsWatcherImpl.Kqueue(b)   => b.add(path),
            FsWatcherImpl.Inotify(b)  => b.add(path),
            FsWatcherImpl.Rdcw(b)     => b.add(path),
        }
    }

    /// Remove a previously-added watch.
    public fn remove(&mut self, path: &Text) -> Result<(), Text> {
        match &mut self.inner {
            FsWatcherImpl.Kqueue(b)   => b.remove(path),
            FsWatcherImpl.Inotify(b)  => b.remove(path),
            FsWatcherImpl.Rdcw(b)     => b.remove(path),
        }
    }

    /// Wait for the next event(s). Returns an empty list on timeout.
    /// Timeout in milliseconds; -1 = block forever.
    public fn wait(&mut self, timeout_ms: Int) -> Result<List<FsEvent>, Text> {
        match &mut self.inner {
            FsWatcherImpl.Kqueue(b)   => b.wait(timeout_ms),
            FsWatcherImpl.Inotify(b)  => b.wait(timeout_ms),
            FsWatcherImpl.Rdcw(b)     => b.wait(timeout_ms),
        }
    }
}

implement Drop for FsWatcher {
    fn drop(&mut self) {
        // Backend Drop impl handles native fd cleanup.
    }
}

// =============================================================================
// Internal backend dispatch
// =============================================================================

type FsWatcherImpl is
    | Kqueue(KqueueBackend)
    | Inotify(InotifyBackend)
    | Rdcw(RdcwBackend);

// =============================================================================
// macOS — kqueue / EVFILT_VNODE
// =============================================================================

@cfg(target_os = "macos")
mount core.sys.darwin.libsystem.{
    safe_kqueue, safe_open, safe_close, watch_vnode, wait_vnode,
    NOTE_DELETE, NOTE_WRITE, NOTE_EXTEND, NOTE_ATTRIB, NOTE_RENAME,
};

@cfg(target_os = "macos")
public type KqueueBackend is {
    kq_fd:    FileDesc,
    /// Tracked fds with their paths, indexed by fd.
    watches:  List<(FileDesc, Text)>,
}

@cfg(target_os = "macos")
implement KqueueBackend {
    public fn new() -> Result<KqueueBackend, Text> {
        let fd = safe_kqueue().map_err(|error| error.to_string())?;
        Result.Ok(KqueueBackend { kq_fd: fd, watches: [] })
    }

    public fn add(&mut self, path: &Text) -> Result<(), Text> {
        // Open the path so we can register its fd with kqueue.
        // O_RDONLY = 0, O_EVTONLY = 0x8000 — kernel-level "open just to watch".
        const O_EVTONLY: Int = 0x8000;
        let fd = safe_open(path.as_bytes(), O_EVTONLY, 0).map_err(|error| error.to_string())?;
        let mask = NOTE_WRITE | NOTE_EXTEND | NOTE_DELETE | NOTE_ATTRIB | NOTE_RENAME;
        if let Result.Err(error) = watch_vnode(self.kq_fd, fd, mask) {
            let _ = safe_close(fd);
            return Result.Err(error.to_string());
        }
        self.watches.push((fd, path.clone()));
        Result.Ok(())
    }

    public fn remove(&mut self, path: &Text) -> Result<(), Text> {
        let mut idx: Int = -1;
        for (i, (_fd, p)) in self.watches.iter().enumerate() {
            if p == path { idx = i as Int; break; }
        }
        if idx < 0 { return Result.Ok(()); }
        let (fd, _) = self.watches.remove(idx as usize);
        safe_close(fd).map_err(|error| error.to_string())
    }

    public fn wait(&mut self, timeout_ms: Int) -> Result<List<FsEvent>, Text> {
        let mut events: List<FsEvent> = [];
        let ready = wait_vnode(self.kq_fd, timeout_ms).map_err(|error| error.to_string())?;
        if let Maybe.Some((ident, flags)) = ready {
            for (fd, path) in self.watches.iter() {
                if fd.as_raw() == ident {
                    let kind = if (flags & NOTE_DELETE) != 0 { FsEventKind.Deleted }
                               else if (flags & NOTE_RENAME) != 0 { FsEventKind.Renamed }
                               else if (flags & (NOTE_WRITE | NOTE_EXTEND)) != 0 { FsEventKind.Modified }
                               else { FsEventKind.AttribChanged };
                    events.push(FsEvent { path: path.clone(), kind });
                    break;
                }
            }
        }
        Result.Ok(events)
    }
}

@cfg(target_os = "macos")
implement Drop for KqueueBackend {
    fn drop(&mut self) {
        for (fd, _) in self.watches.iter() { let _ = safe_close(*fd); }
        let _ = safe_close(self.kq_fd);
    }
}

// =============================================================================
// Linux — inotify
// =============================================================================
//

// The inotify_init1 / inotify_add_watch / inotify_rm_watch syscalls aren't
// pre-exported in `core.sys.linux.arch`, so we issue them through the raw
// syscall6 intrinsic with arch-conditional numbers.

@cfg(target_os = "linux")
mount core.sys.linux.syscall.{syscall_raw, close as sys_close, read as sys_read};

@cfg(target_os = "linux")
mount core.sys.common.{FileDesc};

// inotify event flags
@cfg(target_os = "linux") public const IN_CREATE:    UInt32 = 0x00000100;
@cfg(target_os = "linux") public const IN_MODIFY:    UInt32 = 0x00000002;
@cfg(target_os = "linux") public const IN_DELETE:    UInt32 = 0x00000200;
@cfg(target_os = "linux") public const IN_MOVED_FROM:UInt32 = 0x00000040;
@cfg(target_os = "linux") public const IN_MOVED_TO:  UInt32 = 0x00000080;
@cfg(target_os = "linux") public const IN_ATTRIB:    UInt32 = 0x00000004;
// Combined mask covering all of the above.
@cfg(target_os = "linux") public const IN_ALL_EVENTS: UInt32 = 0x00000FFF;

// inotify syscall numbers
@cfg(all(target_os = "linux", target_arch = "x86_64"))
public const SYS_INOTIFY_INIT1:    Int = 294;
@cfg(all(target_os = "linux", target_arch = "x86_64"))
public const SYS_INOTIFY_ADD_WATCH: Int = 254;
@cfg(all(target_os = "linux", target_arch = "x86_64"))
public const SYS_INOTIFY_RM_WATCH: Int = 255;

@cfg(all(target_os = "linux", target_arch = "aarch64"))
public const SYS_INOTIFY_INIT1:    Int = 26;
@cfg(all(target_os = "linux", target_arch = "aarch64"))
public const SYS_INOTIFY_ADD_WATCH: Int = 27;
@cfg(all(target_os = "linux", target_arch = "aarch64"))
public const SYS_INOTIFY_RM_WATCH: Int = 28;

@cfg(target_os = "linux")
public type InotifyBackend is {
    fd:       Int32,
    watches:  List<(FileDesc, Text)>,  // (wd, path)
}

@cfg(target_os = "linux")
implement InotifyBackend {
    public fn new() -> Result<InotifyBackend, Text> {
        // IN_CLOEXEC = 0x80000
        const IN_CLOEXEC: Int = 0x80000;
        let fd = unsafe { syscall_raw(SYS_INOTIFY_INIT1, IN_CLOEXEC, 0, 0, 0, 0, 0) };
        if fd < 0 { return Result.Err("inotify_init1 failed".into()); }
        Result.Ok(InotifyBackend { fd: fd as Int32, watches: [] })
    }

    public fn add(&mut self, path: &Text) -> Result<(), Text> {
        let path_c = nul_terminate(path);
        let wd = unsafe {
            syscall_raw(
                SYS_INOTIFY_ADD_WATCH,
                self.fd as Int,
                &path_c[0] as Int,
                IN_ALL_EVENTS as Int,
                0, 0, 0,
            )
        };
        if wd < 0 { return Result.Err(f"inotify_add_watch({path}) failed"); }
        self.watches.push((wd as Int32, path.clone()));
        Result.Ok(())
    }

    public fn remove(&mut self, path: &Text) -> Result<(), Text> {
        let mut idx: Int = -1;
        for (i, (_wd, p)) in self.watches.iter().enumerate() {
            if p == path { idx = i as Int; break; }
        }
        if idx < 0 { return Result.Ok(()); }
        let (wd, _) = self.watches.remove(idx as usize);
        let _ = unsafe {
            syscall_raw(SYS_INOTIFY_RM_WATCH, self.fd as Int, wd as Int, 0, 0, 0, 0)
        };
        Result.Ok(())
    }

    public fn wait(&mut self, timeout_ms: Int) -> Result<List<FsEvent>, Text> {
        // Pre-poll the inotify fd so blocking-read does not stall past the
        // requested timeout. Poll fd entry layout is { fd: i32, events: i16,
        // revents: i16 } — 8 bytes packed.
        if timeout_ms >= 0 {
            // POLLIN = 0x0001
            let mut pfd: [Int32; 2] = [self.fd, 0x00010000 as Int32];
            let r = unsafe {
                core.sys.linux.syscall.syscall_raw(
                    core.sys.linux.syscall.SYS_POLL,
                    &pfd[0] as Int,    // pollfd*
                    1,                  // nfds
                    timeout_ms,
                    0, 0, 0,
                )
            };
            if r == 0 { return Result.Ok([]); }       // timeout
            if r < 0  { return Result.Err("poll failed".into()); }
        }
        let mut buf: List<Byte> = List.with_capacity(4096);
        let mut i = 0;
        while i < 4096 { buf.push(0); i = i + 1; }
        let n = match sys_read(FileDesc.from_raw(self.fd), &mut buf) {
            Result.Ok(v)  => v,
            Result.Err(_) => return Result.Err("inotify read failed".into()),
        };
        if n == 0 { return Result.Ok([]); }
        // Parse inotify_event records out of `buf[0..n]`.
        // struct inotify_event { int wd; uint32 mask; uint32 cookie; uint32 len; char name[len]; };
        let mut events: List<FsEvent> = [];
        let mut p: Int = 0;
        while p < n {
            let wd: Int32 = read_i32_le(&buf, p);
            let mask: UInt32 = read_u32_le(&buf, p + 4) as UInt32;
            let len: UInt32 = read_u32_le(&buf, p + 12) as UInt32;
            // Find the path for this watch descriptor
            let mut path: Text = "".into();
            for (w, ppath) in self.watches.iter() {
                if *w == wd { path = ppath.clone(); break; }
            }
            let kind = if (mask & IN_DELETE) != 0     { FsEventKind.Deleted }
                       else if (mask & IN_CREATE) != 0 { FsEventKind.Created }
                       else if (mask & IN_MOVED_TO) != 0 || (mask & IN_MOVED_FROM) != 0 {
                           FsEventKind.Renamed
                       }
                       else if (mask & IN_ATTRIB) != 0 { FsEventKind.AttribChanged }
                       else { FsEventKind.Modified };
            events.push(FsEvent { path, kind });
            p = p + 16 + len as Int;
        }
        Result.Ok(events)
    }
}

@cfg(target_os = "linux")
implement Drop for InotifyBackend {
    fn drop(&mut self) {
        let _ = sys_close(FileDesc.from_raw(self.fd));
    }
}

@cfg(target_os = "linux")
fn read_i32_le(buf: &List<Byte>, off: Int) -> Int32 {
    let b0 = buf[off as usize] as Int32;
    let b1 = buf[(off + 1) as usize] as Int32;
    let b2 = buf[(off + 2) as usize] as Int32;
    let b3 = buf[(off + 3) as usize] as Int32;
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

@cfg(target_os = "linux")
fn read_u32_le(buf: &List<Byte>, off: Int) -> Int {
    let b0 = buf[off as usize] as Int;
    let b1 = buf[(off + 1) as usize] as Int;
    let b2 = buf[(off + 2) as usize] as Int;
    let b3 = buf[(off + 3) as usize] as Int;
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// =============================================================================
// Common helpers
// =============================================================================

@cfg(target_os = "linux")
fn nul_terminate(t: &Text) -> List<Byte> {
    let mut out = List.with_capacity(t.len() + 1);
    for b in t.clone().into_bytes().iter() { out.push(*b); }
    out.push(0);
    out
}

// =============================================================================
// Windows — ReadDirectoryChangesW
// =============================================================================
//

// One Handle per watched directory plus an Overlapped + buffer. Events
// arrive as a packed FILE_NOTIFY_INFORMATION list inside the buffer; we
// parse it into FsEvent records. Wait timeouts are honoured via
// WaitForMultipleObjects across the per-directory event handles.

@cfg(target_os = "windows")
mount core.sys.windows.kernel32.{
    Handle, SecurityAttributes, Overlapped,
    CreateFileA, CloseHandle, ReadDirectoryChangesW, GetOverlappedResult,
    WaitForMultipleObjects, GetLastError,
    FILE_FLAG_BACKUP_SEMANTICS,
    FILE_NOTIFY_CHANGE_FILE_NAME, FILE_NOTIFY_CHANGE_DIR_NAME,
    FILE_NOTIFY_CHANGE_LAST_WRITE, FILE_NOTIFY_CHANGE_ATTRIBUTES,
    FILE_NOTIFY_CHANGE_SIZE, FILE_NOTIFY_CHANGE_CREATION,
    FILE_ACTION_ADDED, FILE_ACTION_REMOVED, FILE_ACTION_MODIFIED,
    FILE_ACTION_RENAMED_OLD_NAME, FILE_ACTION_RENAMED_NEW_NAME,
};

// Minimal flags for the watch open. GENERIC_READ = 0x80000000;
// FILE_LIST_DIRECTORY = 0x0001 — we use the full FILE_LIST_DIRECTORY
// access right which is the canonical RDCW handle requirement.
@cfg(target_os = "windows") public const WIN_FILE_LIST_DIRECTORY: UInt32 = 0x00000001;
@cfg(target_os = "windows") public const WIN_FILE_SHARE_ALL:      UInt32 = 0x00000007; // RWD
@cfg(target_os = "windows") public const WIN_OPEN_EXISTING:       UInt32 = 3;
@cfg(target_os = "windows") public const WIN_INFINITE:            UInt32 = 0xFFFFFFFF;
@cfg(target_os = "windows") public const WIN_WAIT_TIMEOUT:        UInt32 = 0x102;

@cfg(target_os = "windows")
type RdcwWatch is {
    handle: Handle,
    path:   Text,
    /// Backing buffer for ReadDirectoryChangesW (4 KiB per watch).
    buffer: List<Byte>,
}

@cfg(target_os = "windows")
public type RdcwBackend is {
    watches: List<RdcwWatch>,
}

@cfg(target_os = "windows")
implement RdcwBackend {
    public fn new() -> Result<RdcwBackend, Text> {
        Result.Ok(RdcwBackend { watches: [] })
    }

    public fn add(&mut self, path: &Text) -> Result<(), Text> {
        let path_c = nul_terminate_win(path);
        let h = CreateFileA(
            &path_c[0] as &Byte,
            WIN_FILE_LIST_DIRECTORY,
            WIN_FILE_SHARE_ALL,
            0 as &SecurityAttributes,
            WIN_OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS,
            0 as Handle,
        );
        if h == (0 as Handle) {
            return Result.Err(f"CreateFileA({path}) failed (error {GetLastError()})");
        }
        let mut buf: List<Byte> = List.with_capacity(4096);
        let mut i = 0;
        while i < 4096 { buf.push(0); i = i + 1; }
        self.watches.push(RdcwWatch { handle: h, path: path.clone(), buffer: buf });
        Result.Ok(())
    }

    public fn remove(&mut self, path: &Text) -> Result<(), Text> {
        let mut idx: Int = -1;
        for (i, w) in self.watches.iter().enumerate() {
            if &w.path == path { idx = i as Int; break; }
        }
        if idx < 0 { return Result.Ok(()); }
        let w = self.watches.remove(idx as usize);
        let _ = CloseHandle(w.handle);
        Result.Ok(())
    }

    public fn wait(&mut self, timeout_ms: Int) -> Result<List<FsEvent>, Text> {
        let mut events: List<FsEvent> = [];
        // Issue a synchronous ReadDirectoryChangesW per watch with the
        // requested timeout. For simplicity we serialise — small N
        // (typically O(10) watches) makes this acceptable.
        let timeout: UInt32 = if timeout_ms < 0 { WIN_INFINITE } else { timeout_ms as UInt32 };
        for w in self.watches.iter_mut() {
            let mut bytes_returned: UInt32 = 0;
            let mut overlapped = Overlapped.zero();
            let filter = FILE_NOTIFY_CHANGE_FILE_NAME
                       | FILE_NOTIFY_CHANGE_DIR_NAME
                       | FILE_NOTIFY_CHANGE_LAST_WRITE
                       | FILE_NOTIFY_CHANGE_ATTRIBUTES
                       | FILE_NOTIFY_CHANGE_SIZE
                       | FILE_NOTIFY_CHANGE_CREATION;
            let ok = ReadDirectoryChangesW(
                w.handle,
                w.buffer.as_mut_ptr() as &unsafe mut Byte,
                w.buffer.len() as UInt32,
                1 as Int32,            // watch subtree
                filter,
                &mut bytes_returned,
                &mut overlapped,
                0 as &unsafe Byte,
            );
            if ok == 0 { continue; }
            // Wait for completion (overlapped → poll via GetOverlappedResult).
            let wait_result = WaitForMultipleObjects(
                1 as UInt32,
                &w.handle,
                0 as Int32,
                timeout,
            );
            if wait_result == WIN_WAIT_TIMEOUT { continue; }
            // Parse the buffer into FILE_NOTIFY_INFORMATION records.
            parse_fni_buffer(&w.buffer, bytes_returned as Int, &w.path, &mut events);
        }
        Result.Ok(events)
    }
}

@cfg(target_os = "windows")
implement Drop for RdcwBackend {
    fn drop(&mut self) {
        for w in self.watches.iter() {
            let _ = CloseHandle(w.handle);
        }
    }
}

// FILE_NOTIFY_INFORMATION layout:
//  DWORD NextEntryOffset;
//  DWORD Action;
//  DWORD FileNameLength; // bytes (UTF-16, len = bytes/2 chars)
//  WCHAR FileName[1]; // not NUL-terminated
//

// Records are packed; NextEntryOffset is relative to the current record's start.
@cfg(target_os = "windows")
fn parse_fni_buffer(
    buf: &List<Byte>,
    valid_len: Int,
    base_path: &Text,
    out: &mut List<FsEvent>,
) {
    let mut p: Int = 0;
    while p < valid_len {
        let next_off: UInt32 = read_u32_le(buf, p) as UInt32;
        let action:   UInt32 = read_u32_le(buf, p + 4) as UInt32;
        let name_len: Int    = read_u32_le(buf, p + 8);    // bytes
        // Decode UTF-16LE filename
        let name = decode_utf16_le(buf, p + 12, name_len);
        let kind = match action {
            FILE_ACTION_ADDED            => FsEventKind.Created,
            FILE_ACTION_REMOVED          => FsEventKind.Deleted,
            FILE_ACTION_MODIFIED         => FsEventKind.Modified,
            FILE_ACTION_RENAMED_OLD_NAME => FsEventKind.Renamed,
            FILE_ACTION_RENAMED_NEW_NAME => FsEventKind.Renamed,
            _ => FsEventKind.Modified,
        };
        let full = f"{base_path}\\{name}";
        out.push(FsEvent { path: full, kind });
        if next_off == 0 { break; }
        p = p + next_off as Int;
    }
}

@cfg(target_os = "windows")
fn read_u32_le(buf: &List<Byte>, off: Int) -> Int {
    let b0 = buf[off as usize] as Int;
    let b1 = buf[(off + 1) as usize] as Int;
    let b2 = buf[(off + 2) as usize] as Int;
    let b3 = buf[(off + 3) as usize] as Int;
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

@cfg(target_os = "windows")
fn decode_utf16_le(buf: &List<Byte>, off: Int, byte_len: Int) -> Text {
    // Full UTF-16LE → Text transcoder. Handles BMP (one 16-bit
    // unit) and supplementary planes (a high-surrogate D800..DBFF
    // followed by a low-surrogate DC00..DFFF that combine into a
    // 21-bit code point). Lone / mismatched surrogates fall through
    // as U+FFFD per Unicode §3.9 substitution. Works for any
    // legal Windows filename.
    let mut out = Text.with_capacity((byte_len / 2) as usize);
    let mut i: Int = 0;
    while i < byte_len {
        if i + 1 >= byte_len { break; }
        let lo = buf[(off + i)     as usize] as Int;
        let hi = buf[(off + i + 1) as usize] as Int;
        let cu = (hi << 8) | lo;          // first code unit
        if cu >= 0xD800 && cu <= 0xDBFF {
            // High surrogate — pair with the next low surrogate.
            if i + 3 >= byte_len {
                out.push('\u{FFFD}');
                break;
            }
            let lo2 = buf[(off + i + 2) as usize] as Int;
            let hi2 = buf[(off + i + 3) as usize] as Int;
            let cu2 = (hi2 << 8) | lo2;
            if cu2 >= 0xDC00 && cu2 <= 0xDFFF {
                let cp = 0x10000 + ((cu - 0xD800) << 10) + (cu2 - 0xDC00);
                out.push(cp as Char);
                i = i + 4;
            } else {
                // High surrogate without matching low — substitute.
                out.push('\u{FFFD}');
                i = i + 2;
            }
        } else if cu >= 0xDC00 && cu <= 0xDFFF {
            // Lone low surrogate — substitute.
            out.push('\u{FFFD}');
            i = i + 2;
        } else {
            // BMP character — direct emit.
            out.push(cu as Char);
            i = i + 2;
        }
    }
    out
}

@cfg(target_os = "windows")
fn nul_terminate_win(t: &Text) -> List<Byte> {
    let mut out = List.with_capacity(t.len() + 1);
    for b in t.clone().into_bytes().iter() { out.push(*b); }
    out.push(0);
    out
}
