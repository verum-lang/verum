// =============================================================================
// sys/process_native.vr - Native process spawn (no C runtime, fork-safe)
// =============================================================================
// Layer: 2 (Sys)
// Dependencies: sys.{linux,darwin}, base.memory
// =============================================================================
//

// Direct-syscall implementation of pipe + fork + dup2 + execve.
//

// ## Fork-safety contract
//

// After `fork()`, the child process:
//  * MUST NOT call any allocator (Verum heap is in indeterminate state —
//  mutex from the parent's allocator could be locked by another thread
//  that no longer exists in the child, causing deadlock).
//  * MUST NOT take any lock the parent might hold (futex, mutex, RwLock).
//  * MUST NOT touch any TLS that the parent's runtime might have
//  initialised (executor state, panic handlers, tracing buffers).
//  * MUST only call async-signal-safe syscalls (POSIX list).
//

// To honour this contract every byte the child needs (program path, argv
// pointer table, NUL-terminated args) is materialised in the *parent*
// **before** `fork()`. The child only:
//  1. Calls `dup2()` to wire pipe ends.
//  2. Calls `close()` on now-redundant pipe fds.
//  3. Calls `execve()` with the pre-built pointer arrays.
//  4. On execve failure, calls `_exit(127)` directly (no destructors,
//  no buffer flushing, no lock release).
//

// ## Layout of the pre-built argv buffer
//

//  buffer: [path_bytes\0 arg0_bytes\0 arg1_bytes\0 ... argN_bytes\0]
//  ptrs: [ &buffer[0] &buffer[off1] &buffer[off2] ... NULL ]
//

// Both are owned by the parent. After fork, the child references them
// by absolute pointer; their contents are read-only and the kernel
// preserves them across the exec call.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.sys.process_native;

// Ring 1 mounts the DEFINING module, not the root umbrella:
// `mount core.{…}` is an edge to everything the prelude re-exports, and
// the prelude publishes `format_debug` from `text.format` (ring 2)
// because the language emits that name. rings.toml states the same
// consequence for ring 0 and the same remedy (T1064).
mount core.base.maybe.{Maybe};
mount core.base.result.{Result};
mount core.collections.list.{List};
mount core.text.text.{Text};
mount core.sys.common.{OSError, FileDesc};

// Linux: direct syscalls
// Module-level platform-prefix mounts.  Per-item rename aliases
// (`mount X.{foo as bar}`) don't surface to AOT codegen (task #11);
// module-level alias `mount X as Y` followed by `Y.fn(...)` qualified
// access works because the call site uses path-lookup not bare-name
// lookup.
@cfg(target_os = "linux")
mount core.sys.linux.syscall as platform_syscall;
@cfg(target_os = "linux")
mount core.sys.linux.errno.EINTR;

@cfg(target_os = "linux")
mount core.sys.linux.syscall.{close as close_descriptor, read as read_descriptor, write as write_descriptor};

@cfg(target_os = "macos")
mount core.sys.darwin.libsystem as platform_syscall;
@cfg(target_os = "macos")
mount core.sys.darwin.errno.EINTR;
@cfg(target_os = "macos")
mount core.sys.darwin.libsystem.{safe_close as close_descriptor, safe_read as read_descriptor, safe_write as write_descriptor};

const PIPE_CHUNK_SIZE: Int = 4096;

// =============================================================================
// SpawnResult — what `native_spawn` returns
// =============================================================================

public type SpawnResult is {
    public(in core) pid:       Int,
    public(in core) stdin_fd:  Int,   // -1 if not piped
    public(in core) stdout_fd: Int,   // -1 if not piped
    public(in core) stderr_fd: Int,   // -1 if not piped
}

// =============================================================================
// ArgvBlob — pre-built, fork-safe argv layout
// =============================================================================
//

// One contiguous byte buffer holding all NUL-terminated strings, plus a
// pointer table. Both are computed in the parent so the child only reads.

type ArgvBlob is {
    /// Concatenated NUL-terminated strings: path\0arg0\0arg1\0...
    bytes: List<Byte>,
    /// Absolute pointers into `bytes` plus a trailing NULL terminator.
    /// `ptrs[0]` = path, `ptrs[i]` = arg(i-1) for i ≥ 1, `ptrs[last]` = 0.
    ptrs:  List<Int>,
}

fn build_argv_blob(program: &Text, args: &List<Text>) -> ArgvBlob {
    // First pass — compute total byte length and offsets.
    let n_args = args.len() as Int;
    let mut total_len: Int = 0;
    let mut offsets: List<Int> = List.with_capacity((n_args + 1) as usize);
    offsets.push(0);
    total_len = total_len + program.len() as Int + 1;  // path + NUL
    for a in args.iter() {
        offsets.push(total_len);
        total_len = total_len + a.len() as Int + 1;
    }

    // Second pass — populate the blob.
    let mut bytes: List<Byte> = List.with_capacity(total_len as usize);
    for b in program.clone().into_bytes().iter() { bytes.push(*b); }
    bytes.push(0);
    for a in args.iter() {
        for b in a.clone().into_bytes().iter() { bytes.push(*b); }
        bytes.push(0);
    }

    // Build pointer table referencing `bytes` start + offset.
    let base = &bytes[0] as Int;
    let mut ptrs: List<Int> = List.with_capacity((n_args + 2) as usize);
    let mut i: Int = 0;
    while i <= n_args {
        ptrs.push(base + offsets[i as usize]);
        i = i + 1;
    }
    ptrs.push(0);  // NULL terminator

    ArgvBlob { bytes, ptrs }
}

// =============================================================================
// native_spawn — pipe + fork + dup2 + execve flow
// =============================================================================

/// Spawn a child process with optional stdin/stdout/stderr pipes.
/// All argv preparation happens BEFORE fork; the child code path is
/// allocation-free and uses only async-signal-safe syscalls.
public fn native_spawn(
    program: &Text,
    args: &List<Text>,
    capture_stdin:  Bool,
    capture_stdout: Bool,
    capture_stderr: Bool,
) -> Result<SpawnResult, Text> {
    @cfg(any(target_os = "linux", target_os = "macos"))
    {
        let stdin_pipe = make_pipe(capture_stdin)?;
        let stdout_pipe = match make_pipe(capture_stdout) {
            Result.Ok(pipe) => pipe,
            Result.Err(error) => {
                close_pipe(stdin_pipe.reader, stdin_pipe.writer);
                return Result.Err(error);
            },
        };
        let stderr_pipe = match make_pipe(capture_stderr) {
            Result.Ok(pipe) => pipe,
            Result.Err(error) => {
                close_pipe(stdin_pipe.reader, stdin_pipe.writer);
                close_pipe(stdout_pipe.reader, stdout_pipe.writer);
                return Result.Err(error);
            },
        };

        // 2. Pre-build argv as a single contiguous, fork-stable blob.
        //  Owned by the parent; read by the child via absolute pointers.
        let blob = build_argv_blob(program, args);

        // Capture absolute pointers BEFORE fork. Post-fork access to
        // `blob` is read-only and uses these raw addresses — never the
        // List<Byte> wrapper (which the child must not touch).
        let prog_ptr_raw: Int = blob.ptrs[0];
        let argv_ptr_raw: Int = &blob.ptrs[0] as Int;

        // 3. fork()
        let pid = match do_fork() {
            Result.Ok(p)  => p,
            Result.Err(e) => {
                close_pipe(stdin_pipe.reader, stdin_pipe.writer);
                close_pipe(stdout_pipe.reader, stdout_pipe.writer);
                close_pipe(stderr_pipe.reader, stderr_pipe.writer);
                return Result.Err(f"fork failed (errno {e.code})");
            }
        };

        if pid == 0 {
            // ── Child path ───────────────────────────────────────────
            // ASYNC-SIGNAL-SAFE ONLY. No allocation, no locking, no
            // Verum runtime. Just dup2/close/execve/_exit.
            child_setup_stdio(stdin_pipe.reader, 0, stdin_pipe.writer);
            child_setup_stdio(stdout_pipe.writer, 1, stdout_pipe.reader);
            child_setup_stdio(stderr_pipe.writer, 2, stderr_pipe.reader);
            child_execve(prog_ptr_raw, argv_ptr_raw);
            // execve returned → exec failed → bail with conventional 127
            child_exit(127);
        }

        // ── Parent path ─────────────────────────────────────────────
        // Close child-only pipe ends; keep parent ends.
        if capture_stdin  { let _ = close_descriptor(FileDesc.from_raw(stdin_pipe.reader)); }
        if capture_stdout { let _ = close_descriptor(FileDesc.from_raw(stdout_pipe.writer)); }
        if capture_stderr { let _ = close_descriptor(FileDesc.from_raw(stderr_pipe.writer)); }

        // After fork the child has its own mappings for the prepared arguments.
        return Result.Ok(SpawnResult {
            pid:       pid,
            stdin_fd:  if capture_stdin  { stdin_pipe.writer  as Int } else { -1 },
            stdout_fd: if capture_stdout { stdout_pipe.reader as Int } else { -1 },
            stderr_fd: if capture_stderr { stderr_pipe.reader as Int } else { -1 },
        });
    }

    @cfg(target_os = "windows")
    {
        return Result.Err("native_spawn not implemented for Windows (use io.process.spawn directly)");
    }
}

// =============================================================================
// Child path — async-signal-safe, no heap, no lock acquisition
// =============================================================================

@cfg(target_os = "linux")
fn child_execve(prog_ptr: Int, argv_ptr: Int) {
    let envp = core.sys.common.get_environ();
    let _ = unsafe {
        core.sys.linux.syscall.syscall_raw(
            core.sys.linux.syscall.SYS_EXECVE,
            prog_ptr,
            argv_ptr,
            envp as Int,
            0, 0, 0,
        )
    };
}

@cfg(target_os = "macos")
fn child_execve(prog_ptr: Int, argv_ptr: Int) {
    // Read the child’s own environment table after fork. The parent may
    // subsequently change its copy without invalidating this one.
    let envp = platform_syscall.process_environment();
    let _ = unsafe { platform_syscall.execve(
        prog_ptr as *const Byte,
        argv_ptr as *const *const Byte,
        envp,
    ) };
}

// The child must exit before exec if its redirection could not be installed.
@cfg(target_os = "macos")
fn duplicate_child_fd(source: Int32, target: Int32) {
    if source == target { return; }
    loop {
        if unsafe { platform_syscall.dup2(source, target) } >= 0 { return; }
        if platform_syscall.errno() != EINTR { child_exit(127); }
    }
}

@cfg(target_os = "linux")
fn duplicate_child_fd(source: Int32, target: Int32) {
    if source == target { return; }
    loop {
        // dup3(flags=0) is available on both supported Linux architectures.
        let result = unsafe { platform_syscall.syscall_raw(platform_syscall.SYS_DUP3,
            source as Int, target as Int, 0, 0, 0, 0) };
        if result >= 0 { return; }
        if result != -EINTR { child_exit(127); }
    }
}

@cfg(any(target_os = "linux", target_os = "macos"))
fn child_setup_stdio(source: Int32, target: Int32, unused: Int32) {
    if source < 0 { return; }
    duplicate_child_fd(source, target);
    if source != target { child_close(source); }
    if unused != target { child_close(unused); }
}

@cfg(target_os = "linux")
fn child_close(fd: Int32) {
    let _ = unsafe { platform_syscall.syscall_raw(platform_syscall.SYS_CLOSE, fd as Int, 0, 0, 0, 0, 0) };
}

@cfg(target_os = "macos")
fn child_close(fd: Int32) { let _ = unsafe { platform_syscall.close(fd) }; }

@cfg(target_os = "linux")
fn child_exit(code: Int) -> ! {
    core.sys.linux.syscall.exit_group(code)
}

@cfg(target_os = "macos")
fn child_exit(code: Int) -> ! {
    unsafe { platform_syscall._exit(code as Int32) }
}

@cfg(any(target_os = "linux", target_os = "macos"))
fn close_pipe(reader: Int32, writer: Int32) {
    if reader >= 0 { let _ = close_descriptor(FileDesc.from_raw(reader)); }
    if writer >= 0 { let _ = close_descriptor(FileDesc.from_raw(writer)); }
}

type PipePair is { reader: Int32, writer: Int32 };

@cfg(any(target_os = "linux", target_os = "macos"))
fn make_pipe(requested: Bool) -> Result<PipePair, Text> {
    if !requested { return Result.Ok(PipePair { reader: -1 as Int32, writer: -1 as Int32 }); }
    let mut storage: [Byte; 8] = [0; 8];
    let address = (&mut storage[..]).as_mut_ptr() as Int;
    @cfg(target_os = "macos")
    {
        if unsafe { platform_syscall.pipe(address as *mut Int32) } != 0 {
            let code = platform_syscall.errno();
            return Result.Err(f"pipe failed (errno {code})");
        }
    }
    @cfg(target_os = "linux")
    {
        let rc = unsafe { platform_syscall.syscall_raw(platform_syscall.SYS_PIPE2, address, 0, 0, 0, 0, 0) };
        if rc < 0 { return Result.Err(f"pipe failed (errno {-rc})"); }
    }
    Result.Ok(PipePair {
        reader: @intrinsic("load_i32", address) as Int32,
        writer: @intrinsic("load_i32", address + 4) as Int32,
    })
}

@cfg(target_os = "linux")
fn do_fork() -> Result<Int, OSError> {
    platform_syscall.fork()
}

@cfg(target_os = "macos")
fn do_fork() -> Result<Int, OSError> {
    let r = unsafe { platform_syscall.fork() };
    if r >= 0 { return Result.Ok(r as Int); }
    Result.Err(OSError.from_code(platform_syscall.errno()))
}

// =============================================================================
// Public wrappers — used by core.io.process and core.shell.exec
// =============================================================================

/// Send a signal to a process. Maps to kill(2) on Unix.
public fn native_kill(pid: Int, sig: Int) -> Result<(), Text> {
    @cfg(any(target_os = "linux", target_os = "macos"))
    {
        if (pid as Int32) as Int != pid || (sig as Int32) as Int != sig {
            return Result.Err("kill argument does not fit a POSIX C int");
        }
    }
    @cfg(target_os = "linux")
    {
        return match platform_syscall.kill(pid, sig) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(error) => Result.Err(f"kill failed (errno {error.code})"),
        };
    }
    @cfg(target_os = "macos")
    {
        if unsafe { platform_syscall.kill(pid as Int32, sig as Int32) } == 0 {
            return Result.Ok(());
        }
        let code = platform_syscall.errno();
        return Result.Err(f"kill failed (errno {code})");
    }
    @cfg(target_os = "windows")
    {
        return Result.Err("native_kill not implemented for Windows");
    }
}

/// Write all bytes to a fd, retrying on EINTR / partial writes.
public fn native_fd_write_all(fd: Int, data: &[Byte]) -> Result<Int, Text> {
    @cfg(any(target_os = "linux", target_os = "macos"))
    {
        if (fd as Int32) as Int != fd { return Result.Err("file descriptor does not fit a POSIX C int"); }
        let mut storage: [Byte; 4096] = [0; 4096];
        let buffer = &mut storage[..];
        let mut total = 0;
        while total < data.len() {
            let size: Int = (data.len() - total).min(PIPE_CHUNK_SIZE);
            let mut offset = 0;
            while offset < size {
                buffer[offset] = data[total + offset];
                offset += 1;
            }
            let mut written = 0;
            while written < size {
                match write_descriptor(FileDesc.from_raw(fd as Int32), &buffer[written..size]) {
                    Result.Ok(0) => return Result.Err("write returned 0"),
                    Result.Ok(count) => written += count,
                    Result.Err(error) => if !error.interrupted() {
                        return Result.Err(f"write failed (errno {error.code})");
                    },
                }
            }
            total += written;
        }
        return Result.Ok(total);
    }
    @cfg(target_os = "windows")
    {
        return Result.Err("native_fd_write_all not implemented for Windows");
    }
}

/// Read up to `max` bytes from a fd. Returns the bytes read (possibly empty for EOF).
public fn native_fd_read_chunk(fd: Int, max: Int) -> Result<List<Byte>, Text> {
    @cfg(any(target_os = "linux", target_os = "macos"))
    {
        if max < 0 { return Result.Err("negative pipe read size"); }
        if max == 0 { return Result.Ok([]); }
        let size: Int = max.min(PIPE_CHUNK_SIZE);
        if (fd as Int32) as Int != fd { return Result.Err("file descriptor does not fit a POSIX C int"); }
        let descriptor = FileDesc.from_raw(fd as Int32);
        let mut storage: [Byte; 4096] = [0; 4096];
        let destination = &mut storage[..size];
        return read_pipe_bytes(descriptor, destination);
    }
    @cfg(target_os = "windows")
    {
        return Result.Err("native_fd_read_chunk not implemented for Windows");
    }
}

@cfg(any(target_os = "linux", target_os = "macos"))
fn read_pipe_bytes(fd: FileDesc, buffer: &mut [Byte]) -> Result<List<Byte>, Text> {
    loop {
        match read_descriptor(fd, &mut *buffer) {
            Result.Ok(count) => {
                let mut bytes: List<Byte> = List.with_capacity(count);
                let mut offset = 0;
                while offset < count {
                    bytes.push(buffer[offset]);
                    offset += 1;
                }
                return Result.Ok(bytes);
            },
            Result.Err(error) => if !error.interrupted() {
                return Result.Err(f"read failed (errno {error.code})");
            },
        }
    }
}
