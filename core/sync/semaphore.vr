// =============================================================================
// semaphore.vr - Counting semaphore
// =============================================================================
// Layer: 2.5 (Sync)
// Dependencies: core, sync/atomic
// =============================================================================
//

// Semaphore limits the number of concurrent accesses to a resource.
// Unlike Mutex, multiple threads can hold permits simultaneously.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.sync.semaphore;
mount core.sync.atomic.{AtomicInt, MemoryOrdering};
mount core.sync.condvar.Condvar;
mount core.sync.mutex.Mutex;

// =============================================================================
// Semaphore
// =============================================================================

// Counting semaphore for limiting concurrent access.
// Uses futex-based blocking under contention instead of spin-waiting.
public type Semaphore is {
    permits: AtomicInt,
    // Capacity changes, permit returns, and entry into the wait set are
    // serialized. Uncontended acquisitions only touch the permit counter.
    capacity: Mutex<Int>,
    changed: Condvar,
};

implement Semaphore {
    public fn new(permits: Int) -> Semaphore {
        assert(permits >= 0, "Semaphore permits must be non-negative");
        Semaphore {
            permits: AtomicInt.new(permits),
            capacity: Mutex.new(permits),
            changed: Condvar.new(),
        }
    }

    public fn binary() -> Semaphore { Semaphore.new(1) }

    public fn acquire(&self) { self.acquire_permits(1); }

    public fn acquire_many(&self, n: Int) {
        assert(n > 0, "Must acquire at least one permit");
        assert(n <= self.max_permits(), "Cannot acquire more than max permits");
        self.acquire_permits(n);
    }

    fn acquire_permits(&self, n: Int) {
        if self.try_acquire_many(n) { return; }
        let mut capacity = self.capacity.lock().unwrap_or_else(|p| p.into_inner());
        while !self.try_acquire_many(n) {
            capacity = self.changed.wait(capacity).unwrap_or_else(|p| p.into_inner());
        }
    }

    public fn try_acquire(&self) -> Bool { self.try_acquire_many(1) }

    /// Reserve all requested permits in one atomic transition.
    public fn try_acquire_many(&self, n: Int) -> Bool {
        assert(n > 0, "Must acquire at least one permit");
        let mut available = self.permits.load(MemoryOrdering.Relaxed);
        while available >= n {
            match self.permits.compare_exchange(available, available - n, MemoryOrdering.Acquire, MemoryOrdering.Relaxed) {
                Result.Ok(_) => return true,
                Result.Err(observed) => { available = observed; },
            }
        }
        false
    }

    public fn release(&self) { self.release_many(1); }

    public fn release_many(&self, n: Int) {
        assert(n > 0, "Must release at least one permit");
        let capacity = self.capacity.lock().unwrap_or_else(|p| p.into_inner());
        assert(n <= *capacity - self.available_permits(), "Semaphore released more than acquired");
        self.publish_permits(n);
    }

    // Called under the capacity mutex. A waiter registered before this
    // check is visible through the mutex. Later waiters recheck permits.
    // Different requests can need different counts, so waking a single
    // ineligible waiter could strand another with enough permits.
    fn publish_permits(&self, n: Int) {
        self.permits.fetch_add(n, MemoryOrdering.Release);
        if self.changed.waiter_count() > 0 { self.changed.notify_all(); }
    }

    public fn available_permits(&self) -> Int { self.permits.load(MemoryOrdering.Relaxed) }

    public fn max_permits(&self) -> Int {
        let capacity = self.capacity.lock().unwrap_or_else(|p| p.into_inner());
        *capacity
    }

    public fn add_permits(&self, n: Int) {
        assert(n >= 0, "Cannot add negative permits");
        if n == 0 { return; }
        let mut capacity = self.capacity.lock().unwrap_or_else(|p| p.into_inner());
        assert(n <= Int.MAX - *capacity, "Semaphore capacity overflow");
        *capacity += n;
        self.publish_permits(n);
    }

    /// Permanently remove one acquired permit from the capacity.
    public fn forget_permit(&self) {
        let mut capacity = self.capacity.lock().unwrap_or_else(|p| p.into_inner());
        assert(*capacity > self.available_permits(), "No acquired semaphore permit to forget");
        *capacity -= 1;
    }

    // Acquire && return RAII guard.
    public fn acquire_guard(&self) -> SemaphoreGuard {
        self.acquire();
        SemaphoreGuard { semaphore: self, permits: 1 }
    }

    /// Acquire one permit immediately and return it when the guard is dropped.
    public fn try_acquire_guard(&self) -> Maybe<SemaphoreGuard> {
        if self.try_acquire() {
            Maybe.Some(SemaphoreGuard { semaphore: self, permits: 1 })
        } else {
            Maybe.None
        }
    }

    // Acquire multiple && return RAII guard.
    public fn acquire_many_guard(&self, n: Int) -> SemaphoreGuard {
        self.acquire_many(n);
        SemaphoreGuard { semaphore: self, permits: n }
    }
}

implement Default for Semaphore {
    fn default() -> Semaphore {
        Semaphore.new(1)
    }
}

implement Debug for Semaphore {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str("Semaphore { permits: ")?;
        self.available_permits().fmt_debug(f)?;
        f.write_str("/")?;
        self.max_permits().fmt_debug(f)?;
        f.write_str(" }")
    }
}

// =============================================================================
// SemaphoreGuard
// =============================================================================

// RAII guard that releases permits on drop.
public type affine SemaphoreGuard is {
    semaphore: &Semaphore,
    permits: Int,
};

implement SemaphoreGuard {
    // Forget this guard, not releasing permits.
    public fn forget(self) {
        // Don't run drop
        forget(self);
    }
}

implement Drop for SemaphoreGuard {
    fn drop(&mut self) {
        self.semaphore.release_many(self.permits);
    }
}
