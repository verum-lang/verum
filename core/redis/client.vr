// =============================================================================
// redis/client.vr — Redis multi-purpose client + connection pool
// =============================================================================
// Layer: 4 (Redis subsystem — multi-purpose data store)
// Dependencies: core, base, collections, async, sync/{semaphore, rwlock},
//               net/tcp, redis/protocol
// =============================================================================
//
// Sends RESP2 and RESP3 commands over TCP. A semaphore bounds concurrent
// commands and pipelines. Completed exchanges return their connection to a
// LIFO pool. I/O and decoding errors discard the affected connection.
// Cluster redirects are reported to the caller.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "low-level Redis client + connection pool — multi-purpose data store entry".to_text(),
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.redis.client;

// The DI context is mounted here rather than arriving ambiently: the
// prelude published `context.standard`'s twelve names into every file
// for convenience, which core-reference-architecture.md §4ter forbids
// (a name belongs to the prelude iff the LANGUAGE requires it) and
// which principle 2 — no magic, every dependency explicit — forbids
// twice over.
mount core.context.standard.{Logger};
mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.List;
mount core.io.protocols.{Read, Write};
mount sync.semaphore.Semaphore;
mount sync.rwlock.{RwLock, RwLockWriteGuard};
mount net.tcp.{TcpStream};

mount core.redis.protocol.{
    RespValue, RespError,
    encode_command_text, encode_command, decode, cursor_new, Cursor,
};

// =============================================================================
// Errors
// =============================================================================

public type RedisError is
    | NotFound(Text)
    | Network(Text)
    | Auth(Text)
    | InvalidReply(Text)
    | TypeMismatch { expected: Text, found: Text }
    | RedirectLoop { hops: Int }
    | Backend(Text);

implement Display for RedisError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            RedisError.NotFound(k)             => f.write_str(f"redis: not found: {k}".as_str()),
            RedisError.Network(reason)         => f.write_str(f"redis: network: {reason}".as_str()),
            RedisError.Auth(reason)            => f.write_str(f"redis: auth: {reason}".as_str()),
            RedisError.InvalidReply(reason)    => f.write_str(f"redis: invalid reply: {reason}".as_str()),
            RedisError.TypeMismatch { expected, found } => f.write_str(
                f"redis: type mismatch (expected {expected}, found {found})".as_str()),
            RedisError.RedirectLoop { hops }   => f.write_str(f"redis: cluster redirect loop ({hops} hops)".as_str()),
            RedisError.Backend(reason)         => f.write_str(f"redis: backend: {reason}".as_str()),
        }
    }
}

implement Debug for RedisError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { self.fmt(f) }
}

// =============================================================================
// Configuration
// =============================================================================

@derive(Clone, Debug)
public type RedisConfig is {
    /// `host:port` — defaults to `127.0.0.1:6379`.
    address:           Text,
    /// Optional username (Redis 6 ACL).
    username:          Maybe<Text>,
    /// Optional password.
    password:          Maybe<Text>,
    /// 0..15 — selects the logical database after AUTH. Cluster
    /// mode rejects non-zero values.
    db:                Int { >= 0, <= 15 },
    pool_size:         Int { >= 1, <= 1024 },
    command_timeout_ms: Int { >= 1 },
    connect_timeout_ms: Int { >= 1 },
    tls:               Bool,
    /// Enable cluster-redirect handling (MOVED / ASK). Set to false
    /// for single-node Redis to avoid the redirect-decode overhead.
    cluster_mode:      Bool,
    /// Maximum redirect hops before giving up (RedirectLoop error).
    max_redirects:     Int { >= 1, <= 32 },
    client_name:       Maybe<Text>,
};

pub fn redis_config_default() -> RedisConfig {
    RedisConfig {
        address:           "127.0.0.1:6379".to_text(),
        username:          Maybe.None,
        password:          Maybe.None,
        db:                0,
        pool_size:         16,
        command_timeout_ms: 5_000,
        connect_timeout_ms: 5_000,
        tls:               false,
        cluster_mode:      false,
        max_redirects:     6,
        client_name:       Maybe.None,
    }
}

// =============================================================================
// Client
// =============================================================================

@derive(Debug)
public type RedisClient is {
    config:  RedisConfig,
    /// LIFO stack of warm connections.
    idle:    RwLock<List<RedisConnection>>,
    /// Counting semaphore — bounds concurrency.
    permits: Semaphore,
};

@derive(Debug)
type RedisConnection is {
    stream:         TcpStream,
    /// Server-reported version string (from HELLO reply, or empty
    /// on RESP2 fallback).
    server_version: Text,
    /// True iff RESP3 was successfully negotiated.
    resp3_enabled:  Bool,
    /// Buffer for incoming bytes — accumulates partial frames
    /// across socket reads.
    rx_buffer:      List<Byte>,
    /// Connection identifier from the server (CLIENT ID), used
    /// for diagnostics. -1 if unknown.
    client_id:      Int,
}

// =============================================================================
// Public constructor
// =============================================================================

pub async fn connect(config: RedisConfig) -> Result<RedisClient, RedisError>
    using [Logger]
{
    let connection = open_connection(&config)?;
    let mut idle: List<RedisConnection> = List.new();
    idle.push(connection);
    Result.Ok(RedisClient {
        permits: Semaphore.new(config.pool_size),
        idle: RwLock.new(idle),
        config,
    })
}

pub async fn connect_url(url: &Text) -> Result<RedisClient, RedisError>
    using [Logger]
{
    let cfg = parse_redis_url(url)?;
    connect(cfg).await
}

// =============================================================================
// Public command surface
// =============================================================================

/// Execute a single command. Args are typed text — the encoder
/// converts them to RESP BulkStrings on the wire.
pub async fn exec(
    client: &RedisClient,
    args:   &[Text],
) -> Result<RespValue, RedisError> {
    exec_with_redirects(client, args, 0).await
}

/// Execute a single command with binary-safe arguments.
pub async fn exec_bytes(
    client: &RedisClient,
    args:   &List<List<Byte>>,
) -> Result<RespValue, RedisError> {
    let frame = encode_command(args);
    exec_frame(client, frame.as_slice())
}

/// Pipelined execution — write N commands then read N replies.
/// Replies are returned in command order.
pub async fn exec_pipeline(
    client:   &RedisClient,
    commands: &List<List<Text>>,
) -> Result<List<RespValue>, RedisError> {
    if commands.is_empty() { return Result.Ok(List.new()); }
    let mut frames: List<Byte> = List.new();
    let mut i: Int = 0;
    while i < commands.len() {
        let bytes = encode_command_text(commands[i].as_slice());
        frames.extend_from_slice(bytes.as_slice());
        i += 1;
    }
    let _permit = client.permits.acquire_guard();
    let mut conn = acquire(client)?;
    write_frame(&mut conn, frames.as_slice())?;
    let mut results: List<RespValue> = List.with_capacity(commands.len());
    while results.len() < commands.len() {
        let value = read_one_frame(&mut conn)?;
        results.push(value);
    }
    recycle(client, conn)?;
    Result.Ok(results)
}

// =============================================================================
// Cluster-redirect handling
// =============================================================================

async fn exec_with_redirects(
    client: &RedisClient,
    args:   &[Text],
    hop:    Int,
) -> Result<RespValue, RedisError> {
    if hop > client.config.max_redirects {
        return Result.Err(RedisError.RedirectLoop { hops: hop });
    }
    let frame = encode_command_text(args);
    let v = exec_frame(client, frame.as_slice())?;

    // Cluster redirect handling.
    if client.config.cluster_mode {
        if let RespValue.Error_(msg) = &v {
            if msg.starts_with("MOVED ") || msg.starts_with("ASK ") {
                // Production clients reconnect to the redirect
                // target on a fresh connection; here we surface a
                // typed error and let the caller decide.  Full
                // cluster mode lands as a follow-up; the hook is
                // wired so single-node behaviour is unchanged.
                return Result.Err(RedisError.Backend(msg.clone()));
            }
        }
    }
    Result.Ok(v)
}

// =============================================================================
// Connection pool primitives
// =============================================================================

fn idle_connections(client: &RedisClient) -> Result<RwLockWriteGuard<List<RedisConnection>>, RedisError> {
    match client.idle.write() {
        Result.Ok(guard) => Result.Ok(guard),
        Result.Err(_) => Result.Err(RedisError.Backend("idle connection pool lock poisoned")),
    }
}

fn acquire(client: &RedisClient) -> Result<RedisConnection, RedisError> {
    {
        let mut idle = idle_connections(client)?;
        if let Maybe.Some(conn) = idle.pop() { return Result.Ok(conn); }
    }
    open_connection(&client.config)
}

fn recycle(client: &RedisClient, conn: RedisConnection) -> Result<(), RedisError> {
    let mut idle = idle_connections(client)?;
    idle.push(conn);
    Result.Ok(())
}

fn exec_frame(client: &RedisClient, frame: &[Byte]) -> Result<RespValue, RedisError> {
    let _permit = client.permits.acquire_guard();
    let mut conn = acquire(client)?;
    write_frame(&mut conn, frame)?;
    let reply = read_one_frame(&mut conn)?;
    recycle(client, conn)?;
    Result.Ok(reply)
}

// =============================================================================
// Connection lifecycle
// =============================================================================

fn open_connection(config: &RedisConfig) -> Result<RedisConnection, RedisError> {
    if config.tls { return Result.Err(RedisError.Network("Redis TLS transport is unavailable")); }
    let stream = match TcpStream.connect_timeout(config.address.clone(), config.connect_timeout_ms) {
        Result.Ok(stream) => stream,
        Result.Err(e) => return Result.Err(RedisError.Network(f"tcp connect: {e}")),
    };
    let timeout = Maybe.Some(config.command_timeout_ms);
    if let Result.Err(e) = stream.set_read_timeout(timeout) { return Result.Err(RedisError.Network(f"read timeout: {e}")); }
    if let Result.Err(e) = stream.set_write_timeout(timeout) { return Result.Err(RedisError.Network(f"write timeout: {e}")); }
    let mut conn = RedisConnection {
        stream,
        server_version: "".to_text(),
        resp3_enabled:  false,
        rx_buffer:      List.new(),
        client_id:      -1,
    };
    handshake(&mut conn, config)?;
    Result.Ok(conn)
}

fn handshake(conn: &mut RedisConnection, cfg: &RedisConfig) -> Result<(), RedisError> {
    let mut args: List<Text> = List.new();
    args.push("HELLO".to_text());
    args.push("3".to_text());
    if let Maybe.Some(pw) = &cfg.password {
        args.push("AUTH".to_text());
        args.push(cfg.username.clone().unwrap_or_else(|| "default".to_text()));
        args.push(pw.clone());
    }
    if let Maybe.Some(name) = &cfg.client_name {
        args.push("SETNAME".to_text());
        args.push(name.clone());
    }
    let resp = exec_on_connection(conn, args.as_slice())?;
    match resp {
        RespValue.MapValue(pairs) => {
            conn.resp3_enabled = true;
            extract_server_info(&pairs, conn);
        }
        RespValue.Array(_) => {
            conn.resp3_enabled = true;
        }
        RespValue.Error_(msg) => {
            // Server doesn't speak HELLO — fall back to RESP2 +
            // explicit AUTH/SELECT.
            if msg.starts_with("ERR unknown command") {
                conn.resp3_enabled = false;
                if let Maybe.Some(pw) = &cfg.password {
                    let mut auth: List<Text> = List.new();
                    auth.push("AUTH".to_text());
                    if let Maybe.Some(u) = &cfg.username {
                        auth.push(u.clone());
                    }
                    auth.push(pw.clone());
                    match exec_on_connection(conn, auth.as_slice())? {
                        RespValue.SimpleString(reply) if reply == "OK" => {}
                        RespValue.Error_(reason) => return Result.Err(RedisError.Auth(reason)),
                        _ => return Result.Err(RedisError.InvalidReply("unexpected AUTH reply")),
                    }
                }
            } else if msg.starts_with("WRONGPASS") || msg.starts_with("NOAUTH") {
                return Result.Err(RedisError.Auth(msg));
            } else {
                return Result.Err(RedisError.Backend(f"HELLO: {msg}"));
            }
        }
        other => return Result.Err(RedisError.InvalidReply(f"unexpected HELLO reply: {other}")),
    }
    if cfg.db != 0 {
        let mut sel: List<Text> = List.new();
        sel.push("SELECT".to_text());
        sel.push(f"{cfg.db}");
        let r = exec_on_connection(conn, sel.as_slice())?;
        match r {
            RespValue.SimpleString(_) => {}
            RespValue.Error_(m) => return Result.Err(RedisError.Backend(f"SELECT: {m}")),
            _ => return Result.Err(RedisError.InvalidReply("unexpected SELECT reply")),
        }
    }
    Result.Ok(())
}

fn hello_text(value: &RespValue) -> Maybe<Text> {
    match value {
        RespValue.SimpleString(text) => Maybe.Some(text.clone()),
        RespValue.BulkString(bytes) => Text.from_utf8(bytes.as_slice()).ok(),
        _ => Maybe.None,
    }
}

fn extract_server_info(pairs: &List<(RespValue, RespValue)>, conn: &mut RedisConnection) {
    let mut i: Int = 0;
    while i < pairs.len() {
        let (k, v) = &pairs[i];
        if let Maybe.Some(key) = hello_text(k) {
            match key.as_str() {
                "version" => {
                    if let Maybe.Some(version) = hello_text(v) {
                        conn.server_version = version;
                    }
                }
                "id" => {
                    if let RespValue.Integer(n) = v { conn.client_id = *n; }
                }
                _ => {}
            }
        }
        i = i + 1;
    }
}

// =============================================================================
// Per-connection command exec
// =============================================================================

fn write_frame(conn: &mut RedisConnection, frame: &[Byte]) -> Result<(), RedisError> {
    match conn.stream.write_all(frame) {
        Result.Ok(()) => Result.Ok(()),
        Result.Err(e) => Result.Err(RedisError.Network(f"write: {e}")),
    }
}

fn exec_on_connection(conn: &mut RedisConnection, args: &[Text]) -> Result<RespValue, RedisError> {
    let frame = encode_command_text(args);
    write_frame(conn, frame.as_slice())?;
    read_one_frame(conn)
}

fn read_one_frame(conn: &mut RedisConnection) -> Result<RespValue, RedisError> {
    loop {
        let cur = core.redis.protocol.cursor_new(conn.rx_buffer.clone());
        match decode(&cur) {
            Result.Ok((v, after)) => {
                conn.rx_buffer = after.remaining_bytes();
                match v {
                    // Push frames are out-of-band — skip them on
                    // request/reply paths. (Pub/sub consumers use
                    // the dedicated pubsub.vr surface.)
                    RespValue.Push(_) => continue,
                    other             => return Result.Ok(other),
                }
            }
            Result.Err(RespError.UnexpectedEof) => {
                let mut buf: [Byte; 4096] = [0_u8; 4096];
                let n = match conn.stream.read(&mut buf[..]) {
                    Result.Ok(n) => n,
                    Result.Err(e) => return Result.Err(RedisError.Network(f"read: {e}")),
                };
                if n == 0 {
                    return Result.Err(RedisError.Network("connection closed".to_text()));
                }
                let mut k: Int = 0;
                while k < n { conn.rx_buffer.push(buf[k]); k = k + 1; }
            }
            Result.Err(e) => return Result.Err(RedisError.InvalidReply(f"resp decode: {e}")),
        }
    }
}

// =============================================================================
// URL parsing
// =============================================================================

fn parse_redis_url(url: &Text) -> Result<RedisConfig, RedisError> {
    let mut cfg = redis_config_default();
    let stripped: Text = if url.starts_with("redis://") {
        url.substring(8, url.len())
    } else if url.starts_with("rediss://") {
        cfg.tls = true;
        url.substring(9, url.len())
    } else {
        return Result.Err(RedisError.Backend("redis url must start with redis:// or rediss://"));
    };
    let endpoint: Text = match stripped.find_byte(b'/') {
        Maybe.Some(i) => {
            let db_text = stripped.substring(i + 1, stripped.len());
            if !db_text.is_empty() {
                match db_text.parse_int() {
                    Result.Ok(db) if db >= 0 && db <= 15 => cfg.db = db,
                    _ => return Result.Err(RedisError.Backend("redis database must be between 0 and 15")),
                }
            }
            stripped.substring(0, i)
        },
        Maybe.None => stripped,
    };
    if let Maybe.Some(i) = endpoint.find_byte(b'@') {
        let auth = endpoint.substring(0, i);
        cfg.address = endpoint.substring(i + 1, endpoint.len());
        match auth.find_byte(b':') {
            Maybe.Some(j) => {
                if j > 0 { cfg.username = Maybe.Some(auth.substring(0, j)); }
                cfg.password = Maybe.Some(auth.substring(j + 1, auth.len()));
            },
            Maybe.None => cfg.username = Maybe.Some(auth),
        }
    } else {
        cfg.address = endpoint;
    }
    Result.Ok(cfg)
}
