// =============================================================================
// core/hash/crypto/mod.vr — collision- and preimage-resistant digests
// =============================================================================
// Layer: 1-2 (sha384 builds on sha512; otherwise core primitives only)
// =============================================================================
//

// These are the digests that may carry a security argument: content
// addressing, Merkle commitments, signature pre-hashing, key
// schedules, transcript binding.
//

//  * `sha256` / `sha384` / `sha512` — FIPS 180-4. Required by TLS 1.3,
//    JOSE/COSE, X.509 and most wire protocols; pick by the protocol.
//  * `blake3` — modern default when no protocol dictates the digest:
//    faster than SHA-2, tree-structured (parallel + verified
//    streaming), and an XOF.
//

// A digest alone authenticates nothing: it proves integrity only when
// the digest itself arrives over an authenticated channel. To
// authenticate data with a shared key, use `core.mac`.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.hash.crypto;

public module sha256;
public module sha384;
public module sha512;
public module blake3;
