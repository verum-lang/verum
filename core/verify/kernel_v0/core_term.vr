// =============================================================================
// kernel_v0 — CoreTerm inductive (bootstrap meta-theory)
// =============================================================================
//

// The 5-constructor minimal inductive that mirrors
// `verum_kernel.proof_checker.Term` exactly. This module is the
// Verum-language anchor for the bootstrap chain: every claim the
// minimal kernel makes is a claim about this CoreTerm inductive.
//

// **Faithfulness invariant** (cross-checked by future audit gate):
//

//  verum_kernel.proof_checker.Term variant set ≡ this module's
//  CoreTerm variant set. Drift is a CI failure.
//

//  Rust-side variants → this module's constructors:
//  Term.Var(usize) → Var(Int{>= 0})
//  Term.Universe(u32) → Universe(Int{>= 0})
//  Term.Pi(Heap, Heap) → Pi(Heap<CoreTerm>, Heap<CoreTerm>)
//  Term.Lam(Heap, Heap) → Lam(Heap<CoreTerm>, Heap<CoreTerm>)
//  Term.App(Heap, Heap) → App(Heap<CoreTerm>, Heap<CoreTerm>)
//

// **Why minimal**
//

// The full `core/verify/kernel_soundness/model.vr` mirrors the broader
// 35-variant Rust kernel (refinement, cubical, modal, quotient, ...).
// This module is DELIBERATELY smaller — exactly what the bootstrap-
// verified kernel needs. Phase 3 (#154) closes by regenerating
// `proof_checker.Term` FROM this module, so this is the source of
// truth post-bootstrap.
//

// **Trust delegation**
//

// Every theorem in core/verify/kernel_v0/ quantifies over CoreTerm.
// A reviewer who reads this file (~50 LOC) understands the entire
// term language the minimal kernel reasons about. No hidden
// dependencies, no forward references.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.verify.kernel_v0.core_term;

mount core.base.primitives.*;
mount core.prelude.{Clone, Heap, Maybe};

/// **Minimal CoC term** — the bootstrap kernel's inductive type.
///

/// De Bruijn-indexed variables; universe levels stratify CoreTerm
/// inside itself (Universe(n) inhabits Universe(n+1)); Π and λ carry
/// explicit domain annotations so type-checking is bidirectional;
/// App is the only elimination form for functions.
///

/// **Variants**
///

///  Var(i) — variable at de Bruijn index i (0 = innermost binder)
///  Universe(n) — n-th universe; Universe(0) = Type, Universe(1) = Type1, ...
///  Pi(A, B) — dependent function type Π(_:A). B; B under one binder
///  Lam(A, body) — λ(_:A). body; body under one binder
///  App(f, x) — application; β-reduces to subst(body, 0, x) when f = Lam
///

/// **What this DOES NOT include**
///

///  - Sigma (dependent pair) — separate kernel extension
///  - Refinement subtypes — separate extension layer
///  - Cubical (Path, hcomp, transp) — separate extension layer
///  - Quotient types, Inductive types, modal operators — separate
///  extension layers
///

/// Each extension lands in its own kernel_vN/ directory with its own
/// soundness lemmas relative to kernel_v0. This compositional
/// approach matches Verum's foundation-neutral philosophy: corpora
/// pick the extensions they need, audit gates verify each layer
/// independently.
public type CoreTerm is
    | Var { index: Int{>= 0} }
    | Universe { level: Int{>= 0} }
    | Pi {
        domain: Heap<CoreTerm>,
        body: Heap<CoreTerm>,
    }
    | Lam {
        domain: Heap<CoreTerm>,
        body: Heap<CoreTerm>,
    }
    | App {
        function: Heap<CoreTerm>,
        argument: Heap<CoreTerm>,
    };

/// **Constant** — the universe level Type (= Universe(0)).
/// Convention: most "is a type" judgments in kernel_v0 ask whether
/// the term inhabits Universe(0); higher levels are reserved for
/// universe polymorphism in extension layers.
public fn type_universe() -> CoreTerm {
    return universe(0);
}

/// Constructors build object-language syntax. Typing is checked by the rules.
public fn variable(index: Int{>= 0}) -> CoreTerm {
    CoreTerm.Var { index }
}

public fn universe(level: Int{>= 0}) -> CoreTerm {
    CoreTerm.Universe { level }
}

public fn product(domain: CoreTerm, body: CoreTerm) -> CoreTerm {
    CoreTerm.Pi { domain: Heap.new(domain), body: Heap.new(body) }
}

public fn abstraction(domain: CoreTerm, body: CoreTerm) -> CoreTerm {
    CoreTerm.Lam { domain: Heap.new(domain), body: Heap.new(body) }
}

public fn application(function: CoreTerm, argument: CoreTerm) -> CoreTerm {
    CoreTerm.App { function: Heap.new(function), argument: Heap.new(argument) }
}

public(in core.verify.kernel_v0) fn universe_level(term: &CoreTerm) -> Maybe<Int> {
    match term {
        CoreTerm.Universe { level } => Maybe.Some(level),
        _ => Maybe.None,
    }
}

/// Instantiate a product codomain at an argument of its declared domain.
public(in core.verify.kernel_v0) fn application_type(
    function_type: &CoreTerm, argument_type: &CoreTerm, argument: &CoreTerm,
) -> Maybe<CoreTerm> {
    match function_type {
        CoreTerm.Pi { domain, body } => {
            if !same_term(domain.as_ref(), argument_type) { return Maybe.None; }
            return substitute(body.as_ref(), 0, argument);
        },
        _ => Maybe.None,
    }
}

/// Syntactic identity of de Bruijn terms.
public fn same_term(term: &CoreTerm, other: &CoreTerm) -> Bool {
    match (term, other) {
        (CoreTerm.Var { index }, CoreTerm.Var { index: right }) => index == right,
        (CoreTerm.Universe { level }, CoreTerm.Universe { level: right }) => level == right,
        (CoreTerm.Pi { domain, body }, CoreTerm.Pi { domain: other_domain, body: other_body }) => {
            same_term(domain.as_ref(), other_domain.as_ref())
                && same_term(body.as_ref(), other_body.as_ref())
        },
        (CoreTerm.Lam { domain, body }, CoreTerm.Lam { domain: other_domain, body: other_body }) => {
            same_term(domain.as_ref(), other_domain.as_ref())
                && same_term(body.as_ref(), other_body.as_ref())
        },
        (CoreTerm.App { function, argument }, CoreTerm.App { function: other_function, argument: other_argument }) => {
            same_term(function.as_ref(), other_function.as_ref())
                && same_term(argument.as_ref(), other_argument.as_ref())
        },
        _ => false,
    }
}

/// Lift free indices at or above the cutoff when entering binders.
/// A transformation that would overflow the index representation fails.
public(in core.verify.kernel_v0) fn lifted(
    term: &CoreTerm, cutoff: Int, amount: Int,
) -> Maybe<CoreTerm> {
    if cutoff < 0 || amount < 0 { return Maybe.None; }
    match term {
        CoreTerm.Var { index } => {
            if index < cutoff { return Maybe.Some(variable(index)); }
            let shifted = index.checked_add(amount)?;
            return Maybe.Some(variable(shifted));
        },
        CoreTerm.Universe { level } => Maybe.Some(universe(level)),
        CoreTerm.Pi { domain, body } => {
            let next = cutoff.checked_add(1)?;
            let a = lifted(domain.as_ref(), cutoff, amount)?;
            let b = lifted(body.as_ref(), next, amount)?;
            Maybe.Some(product(a, b))
        },
        CoreTerm.Lam { domain, body } => {
            let next = cutoff.checked_add(1)?;
            let a = lifted(domain.as_ref(), cutoff, amount)?;
            let b = lifted(body.as_ref(), next, amount)?;
            Maybe.Some(abstraction(a, b))
        },
        CoreTerm.App { function, argument } => {
            let f = lifted(function.as_ref(), cutoff, amount)?;
            let x = lifted(argument.as_ref(), cutoff, amount)?;
            Maybe.Some(application(f, x))
        },
    }
}

/// Instantiate a binder. Under each additional binder the replacement
/// is lifted once and indices outside the removed binder move down.
public fn substitute(term: &CoreTerm, index: Int{>= 0}, replacement: &CoreTerm) -> Maybe<CoreTerm> {
    if index < 0 { return Maybe.None; }
    return substitute_under(term, index, replacement, 0);
}

fn substitute_under(term: &CoreTerm, index: Int, replacement: &CoreTerm, depth: Int) -> Maybe<CoreTerm> {
    match term {
        CoreTerm.Var { index: slot } => {
            if slot >= depth && slot - depth == index {
                return lifted(replacement, 0, depth);
            }
            if slot >= depth && slot - depth > index {
                return Maybe.Some(variable(slot - 1));
            }
            return Maybe.Some(variable(slot));
        },
        CoreTerm.Universe { level } => Maybe.Some(universe(level)),
        CoreTerm.Pi { domain, body } => {
            let next = depth.checked_add(1)?;
            let a = substitute_under(domain.as_ref(), index, replacement, depth)?;
            let b = substitute_under(body.as_ref(), index, replacement, next)?;
            Maybe.Some(product(a, b))
        },
        CoreTerm.Lam { domain, body } => {
            let next = depth.checked_add(1)?;
            let a = substitute_under(domain.as_ref(), index, replacement, depth)?;
            let b = substitute_under(body.as_ref(), index, replacement, next)?;
            Maybe.Some(abstraction(a, b))
        },
        CoreTerm.App { function, argument } => {
            let f = substitute_under(function.as_ref(), index, replacement, depth)?;
            let x = substitute_under(argument.as_ref(), index, replacement, depth)?;
            Maybe.Some(application(f, x))
        },
    }
}

implement Clone for CoreTerm {
    fn clone(&self) -> CoreTerm {
        match self {
            CoreTerm.Var { index } => variable(index),
            CoreTerm.Universe { level } => universe(level),
            CoreTerm.Pi { domain, body } => product(domain.as_ref().clone(), body.as_ref().clone()),
            CoreTerm.Lam { domain, body } => abstraction(domain.as_ref().clone(), body.as_ref().clone()),
            CoreTerm.App { function, argument } => application(function.as_ref().clone(), argument.as_ref().clone()),
        }
    }
}

/// Check strict positivity of the distinguished free variable in a constructor type.
public fn is_strictly_positive(
    ty: &CoreTerm,
    i_name: Int{>= 0},
) -> Bool {
    match ty {
        CoreTerm.Var { .. } => {
            // Leaf: positivity holds trivially since this is just a
            // de Bruijn reference, not a recursive use of I.
            return true;
        },
        CoreTerm.Universe { .. } => {
            return true;
        },
        CoreTerm.Pi { domain, body } => {
            // Domain is contravariant: i_name must NOT appear in it.
            // Body is covariant: recurse.
            let domain_clean = !occurs_in(domain.as_ref(), i_name);
            let body_ok = i_name < Int.MAX && is_strictly_positive(body.as_ref(), i_name + 1);
            return domain_clean && body_ok;
        },
        CoreTerm.Lam { .. } => {
            // Constructor types must be Π-chains. λ-binders inside a
            // constructor type signal a malformed declaration.
            return false;
        },
        CoreTerm.App { function, argument } => {
            // Both halves are positive iff i_name doesn't occur in
            // either contravariantly. Conservative: forbid recursive
            // use under any application head other than the trivial
            // `... → I` shape (handled by the surrounding Pi recursion).
            return !occurs_in(function.as_ref(), i_name)
                && !occurs_in(argument.as_ref(), i_name);
        },
    };
}

/// **Free occurrence check** — does the de Bruijn index `target` occur
/// freely anywhere in `term`? Used by the positivity check to rule
/// out contravariant occurrences.
public fn occurs_in(term: &CoreTerm, target: Int{>= 0}) -> Bool {
    // Tail-expression match — the result IS the function's value.
    // No trailing `;` so Verum's type-checker treats the match
    // as Bool-typed instead of Unit-typed.
    match term {
        CoreTerm.Var { index } => index == target,
        CoreTerm.Universe { .. } => false,
        CoreTerm.Pi { domain, body } => {
            occurs_in(domain.as_ref(), target)
                || (target < Int.MAX && occurs_in(body.as_ref(), target + 1))
        },
        CoreTerm.Lam { domain, body } => {
            occurs_in(domain.as_ref(), target)
                || (target < Int.MAX && occurs_in(body.as_ref(), target + 1))
        },
        CoreTerm.App { function, argument } => {
            occurs_in(function.as_ref(), target)
                || occurs_in(argument.as_ref(), target)
        },
    }
}
