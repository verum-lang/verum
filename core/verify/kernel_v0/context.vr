// The last entry holds the newest binder. Each type is stored in the frame
// immediately outside its binder and lifted into the current frame on lookup.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.verify.kernel_v0.context;

mount core.prelude.{List, Maybe};
mount super.core_term.{CoreTerm, lifted, same_term};

/// Environments are extended through a derivation that establishes a type.
public type Context is {
    types: List<CoreTerm>,
};

/// Construct an empty context — no bound variables in scope.
public fn empty() -> Context {
    return Context { types: List.new() };
}

implement Context {
    /// Return the number of bound variables (i.e., the stack depth).
    public fn depth(&self) -> Int{>= 0}
        ensures result == self.types.len()
    {
        return self.types.len();
    }

    /// The judgment owner checks the new binder before extending this stack.
    public(in core.verify.kernel_v0) fn extend(&self, ty: CoreTerm) -> Context
        ensures result.types.len() == self.types.len() + 1
    {
        let mut out: List<CoreTerm> = List.new();
        for entry in self.types.iter() {
            out.push(entry.clone());
        }
        out.push(ty);
        return Context { types: out };
    }

    public(in core.verify.kernel_v0) fn same(&self, other: &Context) -> Bool {
        if self.depth() != other.depth() {
            return false;
        }
        let mut i = 0;
        while i < self.depth() {
            if !same_term(&self.types[i], &other.types[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// Recover the binder type in its declaring frame.
    public fn lookup(&self, i: Int{>= 0}) -> Maybe<CoreTerm> {
        let len = self.types.len();
        if i < 0 || i >= len { return Maybe.None; }
        return Maybe.Some(self.types[len - 1 - i].clone());
    }

    /// Recover the binder type in the current frame, across its own binder
    /// and every binder introduced after it.
    public fn lookup_shifted(&self, i: Int{>= 0}) -> Maybe<CoreTerm> {
        let len = self.types.len();
        if i < 0 || i >= len { return Maybe.None; }
        return lifted(&self.types[len - 1 - i], 0, i + 1);
    }
}
