// Per-rule inventory of the abstract kernel-rule schemas, missing model
// judgments, executable refusals and unverified framework references.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.verify.kernel_soundness.theorems;

mount core.verify.kernel_soundness.judgment.{KernelRule, kernel_rule_name};

// =============================================================================
// LemmaStatus — structural schema, unsupported rule, admission or citation
// =============================================================================

/// Proved classifies a rule in the abstract schema. Each backend's encoding
/// determines the assumptions its declaration uses. Unsupported records an
/// executable refusal. ModelUnavailable identifies a native check outside the
/// model. Admitted records an unresolved obligation, and UnverifiedFrameworkReference
/// identifies an upstream citation whose applicability still requires verification.
public type LemmaStatus is
    | Proved
    | Unsupported { public reason: Text }
    | ModelUnavailable { public reason: Text }
    | Admitted { public reason: Text }
    | UnverifiedFrameworkReference {
        public lemma_path: Text,
        public framework: Text,
        public citation: Text,
    };

/// Classify each rule without conflating unsupported rules with assumptions.
public pure fn lemma_status(r: KernelRule) -> LemmaStatus {
    match r {
        // These entries concern the abstract rule schemas. A correspondence
        // proof must also relate the executable checker's decisions to the model.
        KernelRule.KVar => LemmaStatus.Proved,
        KernelRule.KUniv => LemmaStatus.Proved,
        KernelRule.KQuotElim => LemmaStatus.Proved,
        KernelRule.KUniverseAscent => LemmaStatus.Proved,
        KernelRule.KRefine => LemmaStatus.Proved,
        KernelRule.KEpsilonOf => LemmaStatus.Proved,
        KernelRule.KAlphaOf => LemmaStatus.Proved,
        KernelRule.KModalBigAnd => LemmaStatus.Proved,
        KernelRule.KModalBox => LemmaStatus.Proved,
        KernelRule.KModalDiamond => LemmaStatus.Proved,
        KernelRule.KShape => LemmaStatus.Proved,
        KernelRule.KFlat => LemmaStatus.Proved,
        KernelRule.KSharp => LemmaStatus.Proved,
        KernelRule.KPathTyForm => LemmaStatus.Proved,
        KernelRule.KPathOverForm => LemmaStatus.Proved,
        KernelRule.KTransp => LemmaStatus.Proved,
        KernelRule.KReflIntro => LemmaStatus.Proved,
        KernelRule.KRefineErase => LemmaStatus.Proved,
        KernelRule.KRefineIntro => LemmaStatus.Proved,
        KernelRule.KQuotForm => LemmaStatus.Proved,
        KernelRule.KQuotIntro => LemmaStatus.Proved,

        KernelRule.KRefineOmega => LemmaStatus.ModelUnavailable {
            reason: "The export lacks the ordinal modal-depth inequality checked by the executable omega formation rule",
        },
        KernelRule.KInductive => LemmaStatus.ModelUnavailable {
            reason: "The export lacks the declaration registry, parameter checks and declared universe used for inductive formation",
        },
        KernelRule.KPos => LemmaStatus.ModelUnavailable {
            reason: "The export lacks the checked strict-positivity judgment for constructor argument types",
        },
        KernelRule.KElim => LemmaStatus.ModelUnavailable {
            reason: "The export lacks the registered declaration and the typing judgment for every constructor branch",
        },
        KernelRule.KFwAx => LemmaStatus.ModelUnavailable {
            reason: "The export lacks the authoritative axiom registry lookup and coordinate policy used by the executable kernel",
        },

        KernelRule.KHComp => LemmaStatus.Unsupported {
            reason: "The executable kernel refuses composition until partial-element support and boundary coherence are checked",
        },
        KernelRule.KGlue => LemmaStatus.Unsupported {
            reason: "The executable kernel refuses gluing until equivalence and boundary coherence are checked",
        },
        KernelRule.KSmt => LemmaStatus.Unsupported {
            reason: "Opaque SMT envelopes have no checked reconstruction and are refused by the executable kernel",
        },

        // ---------- UNVERIFIED FRAMEWORK REFERENCES -----------------------
        // The inventory preserves the cited source for each outstanding obligation.
        KernelRule.KPiForm => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.subst.subst_preserves_typing"
            ),
            framework: Text.from("mathlib4"),
            citation: Text.from(
                "Mathlib.LambdaCalculus.LambdaPi.Substitution.subst_preserves_typing"
            ),
        },
        KernelRule.KLamIntro => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.cartesian.cartesian_closure_for_pi"
            ),
            framework: Text.from("mathlib4"),
            citation: Text.from("Mathlib.CategoryTheory.Closed.Cartesian"),
        },
        KernelRule.KAppElim => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.subst.subst_preserves_typing + \
                 core.verify.kernel_v0.lemmas.beta.church_rosser_confluence"
            ),
            framework: Text.from("mathlib4"),
            citation: Text.from(
                "Mathlib.LambdaCalculus.LambdaPi.Substitution + \
                 Mathlib.Computability.Lambda.ChurchRosser"
            ),
        },
        KernelRule.KSigmaForm => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.subst.subst_preserves_typing"
            ),
            framework: Text.from("mathlib4"),
            citation: Text.from(
                "Mathlib.LambdaCalculus.LambdaPi.Substitution.subst_preserves_typing \
                 (Sigma form via duality)"
            ),
        },
        KernelRule.KPairIntro => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.subst.subst_preserves_typing"
            ),
            framework: Text.from("mathlib4"),
            citation: Text.from(
                "Mathlib.LambdaCalculus.LambdaPi.Substitution + dependent-product structure"
            ),
        },
        KernelRule.KFstElim => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.eta.function_extensionality"
            ),
            framework: Text.from("zfc"),
            citation: Text.from(
                "Sigma-projection eta-rule (fst (a, b) ≡ a) — derivable from extensionality"
            ),
        },
        KernelRule.KSndElim => LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: Text.from(
                "core.verify.kernel_v0.lemmas.eta.function_extensionality"
            ),
            framework: Text.from("zfc"),
            citation: Text.from(
                "Sigma-projection eta-rule (snd (a, b) : B[a/x]) — derivable from extensionality + subst"
            ),
        },
        KernelRule.KEpsMu => LemmaStatus.Unsupported {
            reason: "No executable rule authorizes assigning an arbitrary articulation the type of an enactment; the biadjunction correspondence remains unverified",
        },
        KernelRule.KRoundTrip => LemmaStatus.Unsupported {
            reason: "No executable rule authorizes assigning an arbitrary term a recovered type; an encoding round-trip requires checked source correspondence",
        },
    }
}

/// Whether the abstract schema inventory classifies this entry as Proved.
public pure fn lemma_is_proved(r: KernelRule) -> Bool {
    match lemma_status(r) {
        LemmaStatus.Proved => true,
        _ => false,
    }
}

/// Return the reason for an explicit admission, excluding citations and refusals.
public pure fn lemma_admit_reason(r: KernelRule) -> Maybe<Text> {
    match lemma_status(r) {
        LemmaStatus.Admitted { reason } => Maybe.Some(reason),
        _ => Maybe.None,
    }
}

/// Return the citation text of an unverified framework reference.
public pure fn lemma_framework_reference(r: KernelRule) -> Maybe<Text> {
    match lemma_status(r) {
        LemmaStatus.UnverifiedFrameworkReference {
            lemma_path: _, framework: _, citation,
        } => Maybe.Some(citation),
        _ => Maybe.None,
    }
}

/// Unsupported is a refusal, distinct from an admitted assumption.
public pure fn lemma_unsupported_reason(r: KernelRule) -> Maybe<Text> {
    match lemma_status(r) {
        LemmaStatus.Unsupported { reason } => Maybe.Some(reason),
        _ => Maybe.None,
    }
}

/// Identify the native check missing from the abstract model.
public pure fn lemma_model_unavailable_reason(r: KernelRule) -> Maybe<Text> {
    match lemma_status(r) {
        LemmaStatus.ModelUnavailable { reason } => Maybe.Some(reason),
        _ => Maybe.None,
    }
}

/// The inventory name for the rule's lemma, including the names of omitted rules.
public pure fn lemma_name(r: KernelRule) -> Text {
    let rule_text = kernel_rule_name(r);
    rule_text + Text.from("_sound")
}
