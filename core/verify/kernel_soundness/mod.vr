// Inventory of the abstract kernel-rule schemas and their outstanding obligations.
// The Rust exporter generates foreign declarations from its canonical rule registry.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.verify.kernel_soundness;

public module model;
public module judgment;
public module rules;
public module theorems;
public module theorem;

// Re-export the top-level surface so callers can write
// `mount core.verify.kernel_soundness.{KernelRule, lemma_status, …};`
// without descending into the sub-paths.
public mount core.verify.kernel_soundness.judgment.{
    Context, Judgment, SideCondition, Derivation, KernelRule,
    kernel_rule_name, KERNEL_RULE_COUNT,
};
public mount core.verify.kernel_soundness.theorems.{
    LemmaStatus, lemma_status, lemma_is_proved, lemma_admit_reason, lemma_unsupported_reason,
    lemma_name, lemma_framework_reference, lemma_model_unavailable_reason,
};
public mount core.verify.kernel_soundness.theorem.{
    CorpusRow, corpus_row, corpus_rows,
    proved_rule_count, admitted_rule_count, admitted_lemma_iou_list, unverified_framework_rule_count,
    unsupported_rule_count, unsupported_lemma_list, model_unavailable_rule_count,
    corpus_has_only_structural_lemmas, corpus_admit_count,
};
