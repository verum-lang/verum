// =============================================================================
// core/net/weft/tracing.vr — TracingLayer
// =============================================================================
// Layer: 6 (Weft)
// Spec: net-framework spec §7.1, §7.7 (OTLP)
// =============================================================================
//

// Propagate the W3C traceparent and emit one start and one completion
// record for each request. Each record includes the service and span IDs.

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.weft.tracing;

mount core.base.log.{Logger, LogLevel};
mount core.io.stdio.eprintln;
mount core.tracing.context.{SpanContext, TraceFlags, TraceState};
mount core.tracing.id.{generate_trace_id, generate_span_id};
mount core.tracing.propagation.{extract_traceparent, inject_traceparent};
mount core.time.{Instant};
mount core.net.http.Response;
mount core.net.weft.service.{Layer};
mount core.net.weft.handler.{WeftRequest, Handler};
mount core.net.weft.error.WeftError;
mount core.net.weft.response_ext.{resp_with_header};

// =============================================================================
// Trace context
// =============================================================================

/// The W3C context used for request correlation and the outgoing traceparent.
public type TraceContext is { span: SpanContext };

implement TraceContext {
    /// Accept a valid incoming traceparent and propagate its sampled bit.
    public fn parse_header(header: &Text) -> Maybe<TraceContext> {
        let parent = extract_traceparent(header);
        if !parent.is_valid() { return Maybe.None; }
        let flags = TraceFlags.default().with_sampled(parent.is_sampled());
        Maybe.Some(TraceContext { span: SpanContext.new(
            parent.trace_id(), parent.span_id(), flags, TraceState.empty(), true,
        ) })
    }

    /// Generate a sampled local context with valid trace and span IDs.
    public fn synthesise() -> TraceContext {
        TraceContext { span: SpanContext.new(
            generate_trace_id(), generate_span_id(), TraceFlags.sampled(), TraceState.empty(), false,
        ) }
    }

    public fn to_header(&self) -> Text {
        inject_traceparent(&self.span)
    }
}

// =============================================================================
// TracingLayer
// =============================================================================

public type TracingLayer is {
    /// Service name recorded in every span. Typically the running app's
    /// name (e.g. "my-api").
    service_name: Text,
};

implement TracingLayer {
    public fn new() -> TracingLayer {
        TracingLayer { service_name: "weft-app" }
    }

    public fn named(name: Text) -> TracingLayer {
        TracingLayer { service_name: name }
    }
}

implement<H: Handler<Error = WeftError>> Layer<H> for TracingLayer {
    type Wrapped = TracingHandler<H>;
    fn wrap(&self, inner: H) -> TracingHandler<H> {
        TracingHandler {
            inner: inner,
            service_name: self.service_name.clone(),
        }
    }
}

// =============================================================================
// TracingHandler
// =============================================================================

public type TracingHandler<H> is {
    inner: H,
    service_name: Text,
};

implement<H: Handler<Error = WeftError>> Handler for TracingHandler<H> {
    async fn handle(&self, req: WeftRequest) -> Result<Response, WeftError> {
        let ctx = match req.headers.get(&"traceparent") {
            Maybe.Some(v) => match TraceContext.parse_header(v) {
                Maybe.Some(parent) => parent,
                Maybe.None => TraceContext.synthesise(),
            },
            Maybe.None    => TraceContext.synthesise(),
        };

        let start = Instant.now();
        let method = req.method.as_str();
        let path = req.path.clone();

        log_span_start(&self.service_name, &ctx, &method, &path);

        let result = self.inner.handle(req).await;

        let duration_ms = start.elapsed().as_millis();
        let (status_code, err_kind): (Int, Maybe<Text>) = match &result {
            Result.Ok(r)  => (r.status_code().code(), Maybe.None),
            Result.Err(e) => {
                let s = e.status();
                (s.code(), Maybe.Some(f"{e}"))
            }
        };
        log_span_end(&self.service_name, &ctx, status_code, duration_ms, &err_kind);

        // Stamp the response so downstream caches / load-balancers can
        // correlate with the same trace.
        match result {
            Result.Ok(r)  => Result.Ok(resp_with_header(r, &"traceparent", &ctx.to_header())),
            Result.Err(e) => Result.Err(e),
        }
    }
}

// Weft's default sink writes request spans to the process's standard error.
type SpanLogger is {};

implement Logger for SpanLogger {
    fn log(&self, level: LogLevel, message: &Text) {
        eprintln(&f"{level.name()} {message}");
    }

    fn is_enabled(&self, level: LogLevel) -> Bool { true }
}

fn log_span_start(service: &Text, ctx: &TraceContext, method: &Text, path: &Text) {
    let logger = SpanLogger {};
    let trace_id = ctx.span.trace_id().to_hex();
    let span_id = ctx.span.span_id().to_hex();
    logger.log(LogLevel.Info,
        &f"span.start service={service} trace_id={trace_id} span_id={span_id} method={method} path={path}");
}

fn log_span_end(service: &Text, ctx: &TraceContext, status: Int, duration_ms: Int, err: &Maybe<Text>) {
    let logger = SpanLogger {};
    let trace_id = ctx.span.trace_id().to_hex();
    let span_id = ctx.span.span_id().to_hex();
    let message = f"span.end service={service} trace_id={trace_id} span_id={span_id} status={status} duration_ms={duration_ms}";
    match err {
        Maybe.None => logger.log(LogLevel.Info, &message),
        Maybe.Some(reason) => logger.log(LogLevel.Warn, &f"{message} err={reason}"),
    }
}
