// =============================================================================
// core/net/weft/mod.vr — Weft public surface
// =============================================================================
// Layer: 6 (Weft — server framework core)
// Spec: net-framework spec §10
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.1")
)
module core.net.weft;

public mount .transport.*;
public mount .response_ext.*;
public mount .service.*;
public mount .error.*;
public mount .handler.*;
public mount .router.*;
public mount .connection.*;
public mount .listener.*;
public mount .io_uring_accept.*;
public mount .tls.*;
public mount .http2.*;
public mount .websocket.*;
public mount .rpc.*;
public mount .http3.*;
public mount .arena_pool.*;
public mount .bufpool.*;
public mount .refined_routes.*;
public mount .spiffe.*;
public mount .dst.*;
public mount .wasm_filter.*;
public mount .app.*;
public mount .backpressure.*;
public mount .adaptive.*;
public mount .timeout.*;
public mount .tracing.*;
public mount .metrics.*;
public mount .health.*;

// The following 5 files shipped production code but had no
// `public mount` here. `mount core.net.weft.<X>.*;` worked via
// direct file lookup but the umbrella's wildcard re-export
// (`mount core.net.weft.*;`) silently skipped them — handlers
// using `Json<T>` had to import the extractor by full path despite
// the umbrella convention of "import core.net.weft.* and get
// everything". Adding the missing forwards completes the surface.
public mount .h3.*;              // HTTP/3 server adapter
public mount .h3_priority.*;     // RFC 9218 priority extractor
public mount .json_extractor.*;  // Json<T> handler-arg extractor
public mount .metrics_otlp.*;    // OTLP/HTTP push exporter
public mount .zero_rtt_gate.*;   // 0-RTT replay-defence gate

// Convenience re-exports of the http surface that user code uniformly
// expects to be available via the weft umbrella (Response builder,
// StatusCode constants, Method enum) without needing a parallel
// `mount core.net.http.{Response, StatusCode}` next to every weft
// import.
public mount core.net.http.{Response, StatusCode, Method, Headers, Version};
