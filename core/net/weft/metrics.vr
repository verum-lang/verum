// =============================================================================
// core/net/weft/metrics.vr — MetricsLayer + Prometheus-style registry
// =============================================================================
// Layer: 6 (Weft)
// Spec: net-framework spec §7.2
// =============================================================================
//

// Request counters and millisecond latency histograms are exported through
// Prometheus text and OTLP. The registry synchronizes instrument lookup;
// each returned instrument owns its observations.

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.weft.metrics;

mount core.text.builder.{TextBuilder};
mount core.base.protocols.DerefMut;
mount core.collections.map.{Map};
mount core.collections.list.{List};
mount core.time.{Instant};
mount core.metrics.histogram.{Histogram, HistogramBuckets, HistogramSnapshot};
mount core.net.weft.metrics_otlp.OtlpHistogramSnapshot;
mount core.sync.Mutex;
mount core.sync.atomic.{AtomicInt, MemoryOrdering};
mount core.net.http.{Response};
mount core.net.weft.service.{Layer};
mount core.net.weft.handler.{WeftRequest, Handler};

// =============================================================================
// Metric types
// =============================================================================

/// Integral counter exported as an OTLP monotonic sum.
public type WeftCounter is {
    inner: AtomicInt,
};

implement WeftCounter {
    public fn new() -> WeftCounter { WeftCounter { inner: AtomicInt.new(0) } }

    public fn incr(&self) {
        self.add(1);
    }

    public fn add(&self, n: Int) {
        assert(n >= 0, "Weft counter increments must be nonnegative");
        let mut current = self.inner.load(MemoryOrdering.Relaxed);
        loop {
            let next = current.checked_add(n).expect("Weft counter exceeds Int");
            match self.inner.compare_exchange(current, next, MemoryOrdering.Relaxed, MemoryOrdering.Relaxed) {
                Result.Ok(_) => return,
                Result.Err(observed) => { current = observed; }
            }
        }
    }

    public fn value(&self) -> Int {
        self.inner.load(MemoryOrdering.Relaxed)
    }
}

const LATENCY_BOUNDS_MS: [Float; 11] = [
    5.0, 15.0, 30.0, 60.0, 120.0, 250.0, 500.0, 1000.0, 2500.0, 5000.0, 10000.0,
];

type LatencyObservations is {
    distribution: Histogram,
    sum_ms: Int,
};

/// Records integer milliseconds. An observation and its snapshot share one lock
/// so the total and every bucket describe the same set of requests.
public type WeftHistogram is { observations: Mutex<LatencyObservations> };

implement WeftHistogram {
    public fn new() -> WeftHistogram {
        let buckets = HistogramBuckets.custom(&LATENCY_BOUNDS_MS[..]);
        WeftHistogram { observations: Mutex.new(LatencyObservations {
            distribution: Histogram.new(buckets), sum_ms: 0,
        }) }
    }

    public fn observe_ms(&self, ms: Int) {
        assert(ms >= 0, "Request durations must be nonnegative");
        let mut guard = self.observations.lock().unwrap_or_else(|p| p.into_inner());
        let observations: &mut LatencyObservations = guard.deref_mut();
        let sum = observations.sum_ms.checked_add(ms).expect("Weft duration sum exceeds Int");
        observations.distribution.observe(ms as Float);
        observations.sum_ms = sum;
    }

    fn snapshot(&self) -> (HistogramSnapshot, Int) {
        let observations = self.observations.lock().unwrap_or_else(|p| p.into_inner());
        (observations.distribution.snapshot(), observations.sum_ms)
    }
}

// =============================================================================
// WeftMetricsRegistry
// =============================================================================

public type WeftMetricsRegistry is {
    counters: Mutex<Map<Text, Shared<WeftCounter>>>,
    histograms: Mutex<Map<Text, Shared<WeftHistogram>>>,
};

implement WeftMetricsRegistry {
    public fn new() -> WeftMetricsRegistry {
        WeftMetricsRegistry {
            counters: Mutex.new(Map.new()),
            histograms: Mutex.new(Map.new()),
        }
    }

    /// Get-or-create a counter with the given name.
    public fn counter(&self, name: &Text) -> Shared<WeftCounter> {
        let mut guard = self.counters.lock().unwrap_or_else(|p| p.into_inner());
        let instruments: &mut Map<Text, Shared<WeftCounter>> = guard.deref_mut();
        match instruments.get_key_value(name) {
            Maybe.Some((_, instrument)) => instrument.clone(),
            Maybe.None => {
                let instrument = Shared.new(WeftCounter.new());
                instruments.insert(name.clone(), instrument.clone());
                instrument
            }
        }
    }

    /// Get-or-create a histogram with the given name.
    public fn histogram(&self, name: &Text) -> Shared<WeftHistogram> {
        let mut guard = self.histograms.lock().unwrap_or_else(|p| p.into_inner());
        let instruments: &mut Map<Text, Shared<WeftHistogram>> = guard.deref_mut();
        match instruments.get_key_value(name) {
            Maybe.Some((_, instrument)) => instrument.clone(),
            Maybe.None => {
                let instrument = Shared.new(WeftHistogram.new());
                instruments.insert(name.clone(), instrument.clone());
                instrument
            }
        }
    }

    /// Snapshot every counter as `(name, value)` pairs. Order is
    /// deterministic — alphabetic by name. Used by the OTLP-push
    /// exporter to produce byte-stable wire output across runs.
    public fn counter_snapshot(&self) -> core.collections.list.List<(Text, Int)> {
        let mut out: core.collections.list.List<(Text, Int)> = [];
        let cs = self.counters.lock().unwrap_or_else(|p| p.into_inner());
        for (name, counter) in cs.iter() {
            out.push((name, counter.value()));
        }
        out.sort_unstable_by(|a, b| a.0.cmp(&b.0));
        out
    }

    /// Export disjoint millisecond buckets in metric-name order.
    public fn histogram_snapshot(&self) -> List<(Text, OtlpHistogramSnapshot)> {
        let mut out: List<(Text, OtlpHistogramSnapshot)> = [];
        let histograms = self.histograms.lock().unwrap_or_else(|p| p.into_inner());
        for (name, histogram) in histograms.iter() {
            let (distribution, sum_ms) = histogram.snapshot();
            out.push((name, OtlpHistogramSnapshot.from_milliseconds(&distribution, sum_ms)));
        }
        out.sort_unstable_by(|a, b| a.0.cmp(&b.0));
        out
    }

    /// Render in Prometheus text exposition format. Suitable for a
    /// `GET /metrics` handler.
    public fn render_prometheus(&self) -> Text {
        let mut out = TextBuilder.new();
        // Counters.
        let cs = self.counters.lock().unwrap_or_else(|p| p.into_inner());
        for (name, counter) in cs.iter() {
            out.push(&f"# TYPE {name} counter\n");
            out.push(&f"{name} {counter.value()}\n");
        }
        // Histograms.
        let hs = self.histograms.lock().unwrap_or_else(|p| p.into_inner());
        for (name, hist) in hs.iter() {
            out.push(&f"# TYPE {name} histogram\n");
            let (distribution, sum_ms_val) = hist.snapshot();
            let bounds = distribution.bounds();
            let counts = distribution.counts();
            let mut i = 0;
            while i < bounds.len() {
                let bound_ms = bounds[i] as Int;
                out.push(&f"{name}_bucket{{le=\"{bound_ms}\"}} {counts[i]}\n");
                i = i + 1;
            }
            let total = distribution.count();
            out.push(&f"{name}_bucket{{le=\"+Inf\"}} {total}\n");
            out.push(&f"{name}_sum {sum_ms_val}\n");
            out.push(&f"{name}_count {total}\n");
        }
        out.into_text()
    }
}

// =============================================================================
// MetricsLayer
// =============================================================================

public type MetricsLayer is {
    registry: Shared<WeftMetricsRegistry>,
};

implement MetricsLayer {
    public fn new(registry: Shared<WeftMetricsRegistry>) -> MetricsLayer {
        MetricsLayer { registry: registry }
    }

    /// Convenience: wire up a fresh WeftMetricsRegistry and return both.
    public fn with_new_registry() -> (MetricsLayer, Shared<WeftMetricsRegistry>) {
        let reg = Shared.new(WeftMetricsRegistry.new());
        (MetricsLayer { registry: reg.clone() }, reg)
    }
}

implement<H: Handler> Layer<H> for MetricsLayer {
    type Wrapped = MetricsHandler<H>;
    fn wrap(&self, inner: H) -> MetricsHandler<H> {
        MetricsHandler {
            inner: inner,
            registry: self.registry.clone(),
        }
    }
}

public type MetricsHandler<H> is {
    inner: H,
    registry: Shared<WeftMetricsRegistry>,
};

implement<H: Handler> Handler for MetricsHandler<H> {
    type Error = H.Error;

    async fn handle(&self, req: WeftRequest) -> Result<Response, H.Error> {
        let total = self.registry.counter(&Text.from("http_requests_total"));
        let latency = self.registry.histogram(&Text.from("http_request_duration_ms"));

        total.incr();
        let start = Instant.now();
        let result = self.inner.handle(req).await;
        let dt = start.elapsed().as_millis();
        latency.observe_ms(dt);

        match &result {
            Result.Err(_) => self.registry.counter(&Text.from("http_requests_errors_total")).incr(),
            Result.Ok(r) if r.status_code().is_server_error() =>
                self.registry.counter(&Text.from("http_requests_5xx_total")).incr(),
            Result.Ok(r) if r.status_code().is_client_error() =>
                self.registry.counter(&Text.from("http_requests_4xx_total")).incr(),
            _ => {}
        }

        result
    }
}
