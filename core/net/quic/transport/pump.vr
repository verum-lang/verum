// =============================================================================
// net/quic/transport/pump.vr — QuicConnection-level async I/O pump
// =============================================================================
// Layer: 5 (Network — QUIC)
// Dependencies: core, core.async, core.net.quic.*
// =============================================================================
//

// The ConnectionPump is the center of the pure-Verum transport: it
// takes a bound UdpTransport + a QuicConnectionSm<S> and runs the
// inbound/outbound/timer loop until the connection closes.
//

// Each pump tick:
//

//  1. **Drain inbound** — non-blocking `transport.recv` attempts;
//  for each datagram:
//  a. Walk coalesced QUIC packets (long header → short header
//  transition marks the end).
//  b. Route each packet through `rx.parse_{long,short}_packet`.
//  c. Feed decrypted payload through `dispatch.dispatch_frames`.
//  d. Forward CryptoChunks to `HandshakeDriver.on_crypto_chunk`.
//  e. Update `PathManager.on_inbound_bytes`.
//

//  2. **Timer check** — `loss.timer_fires_at()` reached → `loss.on_timer`
//  may emit a PROBE packet in the signalled PN space.
//

//  3. **Drain outbound** — accumulate frames for each active PN space:
//  a. CRYPTO frames from HandshakeDriver.take_outbound
//  b. ACK frames from PnSpace.build_ack_frame when
//  ack-eliciting packets are outstanding
//  c. STREAM frames from app-level writes
//  d. MAX_DATA / MAX_STREAM_DATA gate from flow_control heuristic
//  Each batch is packed into a packet via `tx.build_{long,short}_packet`,
//  HP-protected + AEAD-sealed, then UDP-sent via transport.
//

//  4. **Phase promotion** — when handshake_driver reports keys ready,
//  extract the traffic secrets + call `QuicConnection.promote_*`
//  + discard Initial/Handshake keys per RFC 9001 §4.9.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.transport.pump;

mount core.collections.list.{List};
mount core.time.instant.{Instant};
mount core.async.cancellation.{CancellationToken};
mount core.net.addr.{SocketAddr};

mount core.net.quic.frame.{QuicFrame, decode_all_frames};
mount core.net.quic.packet.{LongPacketType};
mount core.net.quic.recovery.{PnSpaceKind};
mount core.net.quic.error.{QuicError};
mount core.net.quic.path.{QuicPath, PathManager};
mount core.net.quic.connection_sm.{ConnState};
mount core.net.quic.connection_sm.rx.{InboundPacket};
mount core.net.quic.connection_sm.dispatch.{DispatchOutcome};
mount core.net.quic.connection_sm.handshake_driver.{HandshakeDriver, HandshakeOutput};
mount core.net.quic.connection_sm.keys.{derive_space_keys};
mount core.net.quic.connection_sm.path_control;
mount core.net.quic.pacer.{Pacer, PacerDecision};
mount core.net.quic.idle_timeout.{IdleTimeoutTracker, TickResult as IdleTickResult};

mount core.net.quic.transport.abstraction.{
    UdpTransport, InboundDatagram, TransportError, EcnCodepoint,
};

mount core.net.tls13.cipher_suite.{HashKind, AeadKind};

// =============================================================================
// Pump error
// =============================================================================

public type PumpError is
      Transport(TransportError)
    | Crypto(Text)
    | Handshake(Text)
    | QuicFrame(Text)
    | Quic(QuicError)
    | Cancelled;

implement Display for PumpError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            PumpError.Transport(e)         => f.write_str(f"QUIC pump transport: {e}".as_str()),
            PumpError.Crypto(reason)       => f.write_str(f"QUIC pump crypto: {reason}".as_str()),
            PumpError.Handshake(reason)    => f.write_str(f"QUIC pump handshake: {reason}".as_str()),
            PumpError.QuicFrame(reason)    => f.write_str(f"QUIC pump frame: {reason}".as_str()),
            PumpError.Quic(e)              => f.write_str(f"QUIC pump: {e}".as_str()),
            PumpError.Cancelled            => f.write_str("QUIC pump: cancelled"),
        }
    }
}

implement Debug for PumpError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            PumpError.Transport(e)         => f.write_str(f"Transport({e})".as_str()),
            PumpError.Crypto(reason)       => f.write_str(f"Crypto({reason})".as_str()),
            PumpError.Handshake(reason)    => f.write_str(f"Handshake({reason})".as_str()),
            PumpError.QuicFrame(reason)    => f.write_str(f"QuicFrame({reason})".as_str()),
            PumpError.Quic(e)              => f.write_str(f"Quic({e})".as_str()),
            PumpError.Cancelled            => f.write_str("Cancelled"),
        }
    }
}

implement PartialEq for PumpError {
    fn eq(&self, other: &PumpError) -> Bool {
        match (self, other) {
            (PumpError.Transport(a),   PumpError.Transport(b))   => a == b,
            (PumpError.Crypto(a),      PumpError.Crypto(b))      => a == b,
            (PumpError.Handshake(a),   PumpError.Handshake(b))   => a == b,
            (PumpError.QuicFrame(a),   PumpError.QuicFrame(b))   => a == b,
            (PumpError.Quic(a),        PumpError.Quic(b))        => a == b,
            (PumpError.Cancelled,      PumpError.Cancelled)      => true,
            _ => false,
        }
    }
}

implement Eq for PumpError {}

// =============================================================================
// ConnectionPump
// =============================================================================

/// The pump owns the transport + connection state + handshake driver +
/// path manager. It runs as a nursery-scoped async task; cancellation
/// is honoured via `CancellationToken` per the structured-concurrency
/// discipline.
public type ConnectionPump is {
    transport:        Heap<dyn UdpTransport>,
    peer_addr:        SocketAddr,
    connection:       ConnState,
    handshake:        HandshakeDriver,
    paths:            PathManager,
    /// Cipher suite + AEAD classification — set once handshake
    /// negotiates. Pump uses this to pick the right key length when
    /// deriving from TrafficSecret.
    negotiated_hash:  Maybe<HashKind>,
    negotiated_aead:  Maybe<AeadKind>,
    /// Once the 1-RTT keys are installed we transition the typed
    /// phase via `QuicConnection.promote_to_app`. Pump keeps a
    /// phase tag to gate app-level stream operations.
    phase_tag:        PumpPhase,
    /// RFC 9002 §7.7 token-bucket send pacer. Its rate is refreshed
    /// from `connection.cc.pacing_rate()` on every outbound drain,
    /// and `on_packet_sent` charges actual datagram bytes.
    pacer:            Pacer,
    /// When the pacer signals `NotYet(delay)` on a space, the pump
    /// records the earliest instant it's allowed to send again and
    /// skips emission until wall-clock catches up.
    pacing_next_ok:   Maybe<Instant>,
    pending:          List<List<QuicFrame>>,
    ack_due:          [Bool; 3],
    /// RFC 9000 §10.1 idle-timeout tracker. `Maybe.None` until the peer's
    /// `max_idle_timeout` transport parameter arrives; callers invoke
    /// `arm_idle_timer` once the local+peer values are known.
    idle:             Maybe<IdleTimeoutTracker>,
};

public type PumpPhase is PumpInitial | PumpHandshake | PumpOneRtt | PumpClosing | PumpDraining;

implement ConnectionPump {
    public fn new_client(
        transport: Heap<dyn UdpTransport>,
        peer_addr: SocketAddr,
        connection: ConnState,
        handshake: HandshakeDriver,
    ) -> ConnectionPump {
        let local = transport.local_addr();
        // The three-times amplification budget applies to an unvalidated server address.
        let path = QuicPath.new(local, peer_addr.clone(), true);
        ConnectionPump {
            transport:       transport,
            peer_addr:       peer_addr,
            connection:      connection,
            handshake:       handshake,
            paths:           PathManager.new(path),
            negotiated_hash: Maybe.None,
            negotiated_aead: Maybe.None,
            phase_tag:       PumpPhase.PumpInitial,
            pacer:           Pacer.with_mss(1200_u64),
            pacing_next_ok:  Maybe.None,
            pending:         [List<QuicFrame>.new(), List<QuicFrame>.new(), List<QuicFrame>.new()],
            ack_due:         [false; 3],
            idle:            Maybe.None,
        }
    }

    public fn new_server(
        transport: Heap<dyn UdpTransport>,
        peer_addr: SocketAddr,
        connection: ConnState,
        handshake: HandshakeDriver,
    ) -> ConnectionPump {
        let local = transport.local_addr();
        // Server starts unvalidated — enforces RFC 9000 §21.1.1.3
        // anti-amplification until peer echoes a PATH_RESPONSE.
        let path  = QuicPath.new(local, peer_addr.clone(), false);
        ConnectionPump {
            transport:       transport,
            peer_addr:       peer_addr,
            connection:      connection,
            handshake:       handshake,
            paths:           PathManager.new(path),
            negotiated_hash: Maybe.None,
            negotiated_aead: Maybe.None,
            phase_tag:       PumpPhase.PumpInitial,
            pacer:           Pacer.with_mss(1200_u64),
            pacing_next_ok:  Maybe.None,
            pending:         [List<QuicFrame>.new(), List<QuicFrame>.new(), List<QuicFrame>.new()],
            ack_due:         [false; 3],
            idle:            Maybe.None,
        }
    }

    // ==================== top-level loop ====================

    /// Arm the RFC 9000 §10.1 idle timer. Caller invokes once both
    /// local and peer `max_idle_timeout` transport parameters are
    /// known — typically immediately after the handshake driver
    /// decodes the peer's transport-params extension. `now` is the
    /// initial activity reference (pump construction time is fine).
    public fn arm_idle_timer(&mut self, local_max_ms: UInt64, peer_max_ms: UInt64, now: Instant) {
        self.idle = Maybe.Some(IdleTimeoutTracker.new(local_max_ms, peer_max_ms, now));
    }

    /// Run the pump until the connection closes or the cancellation
    /// token fires. Server + client use the same loop; role-specific
    /// behaviour is already baked into the inner HandshakeDriver.
    pub async fn run(&mut self, cancel: &CancellationToken) -> Result<(), PumpError> {
        loop {
            if cancel.is_cancelled() { return Result.Err(PumpError.Cancelled); }

            // 1. Drain inbound.
            self.drain_inbound_once().await?;

            // 2. Timer check.
            let now = Instant.now();
            self.check_timers(now.clone())?;

            // 2b. RFC 9000 §10.1 idle-timeout tick. When the tracker
            // expires, the spec (§10.2) allows silent close — we
            // move to Draining with a zero-duration drain expiry so
            // the outer loop terminates on the next iteration.
            match &self.idle {
                Maybe.Some(tracker) => match tracker.tick(now.clone()) {
                    IdleTickResult.Expired => {
                        self.phase_tag = PumpPhase.PumpDraining;
                        self.connection.start_draining(now);
                    },
                    IdleTickResult.Active(_) => {},
                },
                Maybe.None => {},
            }

            // 3. Drain outbound (accumulate + send).
            self.drain_outbound(now).await?;

            // 4. Phase promotion bookkeeping.
            self.check_handshake_progress()?;

            // Terminate when the connection reaches Closing/Draining
            // and the idle timer expired.
            match self.phase_tag {
                PumpPhase.PumpDraining => {
                    if self.connection.drain_complete(Instant.now()) { return Result.Ok(()); }
                },
                _ => {},
            }

            // Yield so other tasks get a chance (real impl suspends on
            // readable / writable notification from the reactor).
            core.async.yield_now().await;
        }
    }

    // ==================== step 1: inbound ====================

    async fn drain_inbound_once(&mut self) -> Result<(), PumpError> {
        // Non-blocking attempt — if nothing queued, return without
        // parking. Real reactors expose a `poll_recv` path; here we
        // fall back to a short-timeout recv that the SimUdpTransport
        // responds to immediately.
        match self.try_recv().await {
            Maybe.Some(Result.Ok(dg)) => {
                path_control.on_inbound_bytes(&mut self.paths, dg.bytes().len() as UInt64);
                self.process_datagram(&dg)?;
            },
            Maybe.Some(Result.Err(e)) => return Result.Err(PumpError.Transport(e)),
            Maybe.None => {},   // nothing to do
        }
        Result.Ok(())
    }

    async fn try_recv(&self) -> Maybe<Result<InboundDatagram, TransportError>> {
        // Minimal try-recv shim — calls recv with a zero-duration
        // timeout. In a full reactor this goes through
        // `transport.poll_recv`.
        match self.transport.recv().await {
            Result.Ok(dg) => Maybe.Some(Result.Ok(dg)),
            Result.Err(TransportError.WouldBlock) => Maybe.None,
            Result.Err(e) => Maybe.Some(Result.Err(e)),
        }
    }

    pub(in core.net.quic) fn process_datagram(&mut self, dg: &InboundDatagram) -> Result<(), PumpError> {
        let mut offset: Int = 0;
        while offset < dg.bytes().len() {
            let packet = match self.connection.open_packet(dg.bytes()[offset..]) {
                Result.Ok(Maybe.Some(p)) => p,
                _ => break,
            };
            offset = offset + self.handle_inbound_packet(packet)?;
        }
        Result.Ok(())
    }

    fn pn_space_for_long(&self, ptype: &LongPacketType) -> PnSpaceKind {
        match ptype {
            LongPacketType.Initial   => PnSpaceKind.Initial,
            LongPacketType.Handshake => PnSpaceKind.Handshake,
            _ => PnSpaceKind.Application,
        }
    }

    fn handle_inbound_packet(&mut self, packet: InboundPacket) -> Result<Int, PumpError> {
        let consumed = packet.consumed();
        match packet {
            InboundPacket.Long(p) => {
                let space = self.pn_space_for_long(p.packet_type());
                self.accept_frames(space, p.packet_number(), p.payload(), p.consumed())
            },
            InboundPacket.Short(p) => self.accept_frames(PnSpaceKind.Application, p.packet_number(),
                                                        p.payload(), p.consumed()),
            InboundPacket.VersionNegotiation { .. } => Result.Ok(consumed),
        }
    }

    fn accept_frames(&mut self, space: PnSpaceKind, pn: UInt64, payload: &[Byte], consumed: Int) -> Result<Int, PumpError> {
        let frames = match decode_all_frames(payload) {
            Result.Ok(f) => f, Result.Err(_) => return Result.Err(PumpError.QuicFrame(Text.from("decode frames"))),
        };
        let ack_eliciting = any_ack_eliciting(&frames);
        let now = Instant.now();
        let outcome = match self.connection.process_received(&frames, space, pn, now) {
            Result.Ok(v) => v, Result.Err(e) => return Result.Err(PumpError.Quic(e)),
        };
        if ack_eliciting { self.ack_due[space.as_index()] = true; }
        self.absorb_dispatch(space, outcome)?;
        match &mut self.idle { Maybe.Some(t) => t.on_packet_received(now, ack_eliciting), Maybe.None => {} }
        Result.Ok(consumed)
    }

    fn absorb_dispatch(&mut self, space: PnSpaceKind, mut outcome: DispatchOutcome) -> Result<(), PumpError> {
        // Forward CRYPTO chunks to the handshake driver.
        let mut i: Int = 0;
        while i < outcome.crypto_for_handshake().len() {
            let chunk = &outcome.crypto_for_handshake()[i];
            match self.handshake.on_crypto_chunk(chunk) {
                Result.Ok(()) => {}, Result.Err(_) => return Result.Err(PumpError.Handshake(Text.from("feed CRYPTO"))),
            }
            i = i + 1;
        }
        let mut outbound = outcome.take_outbound();
        self.pending[space.as_index()].append(&mut outbound);
        Result.Ok(())
    }

    // ==================== step 2: timers ====================

    fn check_timers(&mut self, now: Instant) -> Result<(), PumpError> {
        self.connection.recovery_tick(now);
        Result.Ok(())
    }

    // ==================== step 3: outbound ====================

    async fn drain_outbound(&mut self, now: Instant) -> Result<(), PumpError> {
        // RFC 9002 §7.7 — pacer's target rate tracks the CC's current
        // pacing estimate. Refresh once per drain; the bucket refill
        // inside `Pacer.check/on_packet_sent` handles sub-tick accuracy.
        self.pacer.set_rate(self.connection.pacing_rate());

        if let Maybe.Some(deadline) = self.pacing_next_ok {
            if now < deadline { return Result.Ok(()); }
        }

        let mut handshake_frames = self.handshake.take_outbound();
        while let Maybe.Some((space, frame)) = handshake_frames.pop_front() {
            self.pending[space.as_index()].push(frame);
        }

        let mut i = 0;
        while i < 3 {
            let space = match i {
                0 => PnSpaceKind.Initial, 1 => PnSpaceKind.Handshake, _ => PnSpaceKind.Application,
            };
            let mut frames = self.pending[i].split_off(0);
            let mut included_ack = false;
            if self.ack_due[i] {
                if let Maybe.Some(ack) = self.connection.pending_ack(space) {
                    frames.push(ack);
                    included_ack = true;
                }
            }
            if !frames.is_empty() {
                match self.send_packet_in_space(space, frames, now).await? {
                    Maybe.Some(mut deferred) => {
                        if included_ack { let _ = deferred.pop(); }
                        self.pending[i] = deferred;
                    },
                    Maybe.None => if included_ack { self.ack_due[i] = false; },
                }
            }
            i = i + 1;
        }
        Result.Ok(())
    }

    fn within_amplification_limit(&self, size: UInt64) -> Bool {
        path_control.gate_outbound(self.paths.active(), size) >= size
    }

    async fn send_packet_in_space(
        &mut self,
        space: PnSpaceKind,
        frames: List<QuicFrame>,
        now: Instant,
    ) -> Result<Maybe<List<QuicFrame>>, PumpError> {
        let (pn, wire) = match self.connection.protect_outbound(space, &frames) {
            Result.Ok(Maybe.Some(packet)) => packet,
            Result.Ok(Maybe.None) => return Result.Ok(Maybe.Some(frames)),
            Result.Err(_) => return Result.Err(PumpError.Crypto(Text.from("protect outgoing packet"))),
        };

        // Gate outbound against path anti-amplification.
        if !self.within_amplification_limit(wire.len() as UInt64) { return Result.Ok(Maybe.Some(frames)); }

        // RFC 9002 §7.7 pacing admission. The Initial PN space is
        // exempted so the first handshake packet isn't held up by an
        // empty bucket before cwnd/rate has been measured.
        let bytes_u64 = wire.len() as UInt64;
        let allow = match space {
            PnSpaceKind.Initial => true,
            _ => match self.pacer.check(bytes_u64, now.clone()) {
                PacerDecision.Send => true,
                PacerDecision.NotYet(delay) => {
                    let next = now.clone().checked_add(delay).unwrap_or_else(|| now.clone());
                    self.pacing_next_ok = Maybe.Some(next);
                    false
                },
            },
        };
        if !allow { return Result.Ok(Maybe.Some(frames)); }
        self.pacing_next_ok = Maybe.None;

        // Charge recovery, pacing and amplification only after transport acceptance.
        match self.transport.send(wire.as_slice(), &self.peer_addr, EcnCodepoint.NotEct).await {
            Result.Ok(()) => {}, Result.Err(e) => return Result.Err(PumpError.Transport(e)),
        }
        let tx_ack_eliciting = any_ack_eliciting(&frames);
        self.connection.record_outbound(space, pn, now, wire.len() as UInt32, frames);
        path_control.on_outbound_bytes(&mut self.paths, wire.len() as UInt64);
        // Drain the token bucket by the actual datagram size.
        self.pacer.on_packet_sent(bytes_u64, now.clone());
        // §10.1.1 — outbound reset only on the first ack-eliciting
        // send since the last activity; `on_packet_sent` on the
        // tracker enforces this with its `since_last_send` gate.
        match &mut self.idle {
            Maybe.Some(t) => t.on_packet_sent(now.clone(), tx_ack_eliciting),
            Maybe.None => {},
        }

        Result.Ok(Maybe.None)
    }

    // ==================== step 4: phase promotion ====================

    fn check_handshake_progress(&mut self) -> Result<(), PumpError> {
        match self.phase_tag {
            PumpPhase.PumpOneRtt | PumpPhase.PumpClosing | PumpPhase.PumpDraining => return Result.Ok(()),
            _ => {},
        }
        let (suite, tx, rx) = match self.handshake.completion() {
            Maybe.Some(HandshakeOutput.ClientHandshakeOutput(c)) => {
                let (client, server) = c.application_traffic();
                (c.negotiated_suite(), client, server)
            },
            Maybe.Some(HandshakeOutput.ServerHandshakeOutput(c)) => {
                let (client, server) = c.application_traffic();
                (c.negotiated_suite(), server, client)
            },
            Maybe.None => return Result.Ok(()),
        };
        let aead = suite.aead_kind();
        let tx_keys = match derive_space_keys(tx, &aead) { Result.Ok(k) => k, Result.Err(_) => return Result.Err(PumpError.Crypto(Text.from("derive application sending keys"))) };
        let rx_keys = match derive_space_keys(rx, &aead) { Result.Ok(k) => k, Result.Err(_) => return Result.Err(PumpError.Crypto(Text.from("derive application receiving keys"))) };
        self.connection.install_application_keys(tx_keys, rx_keys);
        self.negotiated_hash = Maybe.Some(suite.hash_kind());
        self.negotiated_aead = Maybe.Some(aead);
        self.phase_tag = PumpPhase.PumpOneRtt;
        Result.Ok(())
    }

    // ==================== accessors ====================

    public fn phase(&self) -> PumpPhase { self.phase_tag.clone() }
    public fn peer_addr(&self) -> SocketAddr { self.peer_addr.clone() }
}

fn any_ack_eliciting(frames: &List<QuicFrame>) -> Bool {
    let mut i: Int = 0;
    while i < frames.len() {
        if frames[i].is_ack_eliciting() { return true; }
        i = i + 1;
    }
    false
}
