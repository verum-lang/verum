// =============================================================================
// net/quic/api/server.vr — High-level pure-Verum QUIC server
// =============================================================================
// Layer: 5 (Network — QUIC)
// =============================================================================
//

// Server options describe the TLS credentials and the local QUIC receive limits.
// Accepting a peer requires a listener and a completed QUIC handshake.

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.api.server;

mount core.collections.list.{List};
mount core.time.duration.{Duration};
mount core.net.addr.{SocketAddr};
mount core.net.quic.transport_params.{TransportParams};
mount core.net.quic.api.stream.{QuicApiStream, QuicRecvStream, QuicStreamError};
mount core.net.tls13.cipher_suite.{CipherSuite};
mount core.net.tls13.named_group.{NamedGroup};
mount core.net.tls13.handshake.server_sm.{CertSigner};
mount core.net.tls13.handshake.dhe_pool.{DhePool, LocalDhePool};

// =============================================================================
// Options + error types
// =============================================================================

public type QuicServerOptions is {
    cert_chain:              List<List<Byte>>,
    signer:                  Heap<dyn CertSigner>,
    alpn_prefs:              List<List<Byte>>,
    accepted_groups:         List<NamedGroup>,
    suites:                  List<CipherSuite>,
    dhe_pool:                Heap<dyn DhePool>,
    params:                  TransportParams,
    idle_timeout:            Duration,
    /// Max simultaneously-live connections (0 = unbounded).
    max_connections:         UInt64,
};

implement QuicServerOptions {
    public fn from_cert(cert_chain: List<List<Byte>>, signer: Heap<dyn CertSigner>) -> QuicServerOptions {
        QuicServerOptions {
            cert_chain:       cert_chain,
            signer:           signer,
            alpn_prefs:       [],
            accepted_groups:  [NamedGroup.X25519, NamedGroup.Secp256r1],
            suites:           [
                CipherSuite.TlsAes128GcmSha256,
                CipherSuite.TlsChaCha20Poly1305Sha256,
                CipherSuite.TlsAes256GcmSha384,
            ],
            dhe_pool:         Heap.new(LocalDhePool.new()) as Heap<dyn DhePool>,
            params:           TransportParams.server_defaults(),
            idle_timeout:     Duration.from_secs(30),
            max_connections:  0_u64,
        }
    }

    /// The local parameters carried in the QUIC transport-parameters extension.
    public fn transport_params(&self) -> &TransportParams { &self.params }

    public fn with_alpn(mut self, alpn: List<List<Byte>>) -> QuicServerOptions {
        self.alpn_prefs = alpn;
        self
    }
}

public type QuicServerError is
      Bind(Text)
    | Handshake(Text)
    | Closed
    | StreamError(QuicStreamError);

implement Display for QuicServerError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            QuicServerError.Bind(reason)       => f.write_str(f"QUIC server: bind failed ({reason})".as_str()),
            QuicServerError.Handshake(reason)  => f.write_str(f"QUIC server: handshake failed ({reason})".as_str()),
            QuicServerError.Closed             => f.write_str("QUIC server: closed"),
            QuicServerError.StreamError(e)     => f.write_str(f"QUIC server stream: {e}".as_str()),
        }
    }
}

implement Debug for QuicServerError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            QuicServerError.Bind(reason)       => f.write_str(f"Bind({reason})".as_str()),
            QuicServerError.Handshake(reason)  => f.write_str(f"Handshake({reason})".as_str()),
            QuicServerError.Closed             => f.write_str("Closed"),
            QuicServerError.StreamError(e)     => f.write_str(f"StreamError({e})".as_str()),
        }
    }
}

implement PartialEq for QuicServerError {
    fn eq(&self, other: &QuicServerError) -> Bool {
        match (self, other) {
            (QuicServerError.Bind(a),         QuicServerError.Bind(b))         => a == b,
            (QuicServerError.Handshake(a),    QuicServerError.Handshake(b))    => a == b,
            (QuicServerError.Closed,          QuicServerError.Closed)          => true,
            (QuicServerError.StreamError(a),  QuicServerError.StreamError(b))  => a == b,
            _ => false,
        }
    }
}

implement Eq for QuicServerError {}

/// One freshly-accepted connection, along with its peer address and
/// a way to pull successive streams off of it.
public type QuicAccepted is {
    peer_addr:    SocketAddr,
    alpn:         Maybe<List<Byte>>,
    /// Opaque handle the integration layer uses to look up the
    /// underlying QuicConnectionSm<OneRtt> for stream creation /
    /// datagram send / close.
    connection_id: core.net.quic.connection_id.ConnectionId,
};

implement QuicAccepted {
    /// Await the next peer-initiated bidirectional stream.
    pub async fn next_bidi_stream(&mut self) -> Result<QuicApiStream, QuicServerError> {
        // Integration layer wires this into the connection's RecvStream
        // creation hook (RFC 9000 §3 stream opening).
        Result.Err(QuicServerError.Handshake(Text.from("pure-Verum server stream wire-up pending")))
    }

    /// Await the next peer-initiated unidirectional stream (recv-only).
    pub async fn next_uni_stream(&mut self) -> Result<QuicRecvStream, QuicServerError> {
        Result.Err(QuicServerError.Handshake(Text.from("pure-Verum server stream wire-up pending")))
    }

    /// Await the next inbound datagram.
    pub async fn next_datagram(&mut self) -> Result<List<Byte>, QuicServerError> {
        Result.Err(QuicServerError.Closed)
    }

    pub async fn send_datagram(&mut self, data: &[Byte]) -> Result<(), QuicServerError> {
        Result.Err(QuicServerError.Closed)
    }

    pub async fn close(&mut self, error_code: UInt64, reason: &Text) -> Result<(), QuicServerError> {
        Result.Err(QuicServerError.Closed)
    }
}

// =============================================================================
// QuicServer
// =============================================================================

public type QuicServer is {
    local_addr: SocketAddr,
};

implement QuicServer {
    /// Parse the listener address. A server handle requires a bound UDP transport.
    pub async fn bind(addr_text: &Text, opts: QuicServerOptions) -> Result<QuicServer, QuicServerError> {
        match SocketAddr.from_text(addr_text) {
            Result.Err(_) => Result.Err(QuicServerError.Bind(f"parse addr {addr_text}")),
            Result.Ok(_) => Result.Err(QuicServerError.Bind(Text.from("QUIC server listener transport is unavailable"))),
        }
    }

    pub async fn accept(&mut self) -> Result<QuicAccepted, QuicServerError> {
        Result.Err(QuicServerError.Closed)
    }

    /// Deliver accepted connections to a synchronous handler until the listener closes.
    pub async fn accept_loop<F>(&mut self, handler: F) -> Result<(), QuicServerError>
    where F: fn(QuicAccepted) -> (),
    {
        loop {
            match self.accept().await {
                Result.Ok(accepted) => { handler(accepted); },
                Result.Err(QuicServerError.Closed) => return Result.Ok(()),
                Result.Err(e) => return Result.Err(e),
            }
        }
    }

    public fn local_addr(&self) -> SocketAddr { self.local_addr.clone() }
}
