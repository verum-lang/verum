// =============================================================================
// net/quic/connection_sm/aead.vr — QUIC AEAD seal/open + HP helpers
// =============================================================================
// Layer: 5 (Network — QUIC)
// Dependencies: core, core.security.aead.{aes_gcm, chacha20_poly1305},
//  core.net.quic.crypto.header_protection
// =============================================================================
//

// QUIC AEAD differs from TLS 1.3's only in the nonce derivation:
// RFC 9001 §5.3 says
//

//  nonce = iv XOR pad_left(big_endian(packet_number), iv.len)
//

// where the packet number is the FULL reconstructed PN, not the
// wire-truncated form. AAD is the packet header including HP-cleared
// first byte and the wire-truncated PN bytes.
//

// This module gives seal/open helpers that take `QuicSpaceKeys` (the
// typed per-space key pair from connection_sm) and produce / consume
// the encrypted payload. Header protection is applied / removed
// outside of this module — see `packet_tx` / `packet_rx`.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.connection_sm.aead;

mount core.collections.list.{List};
mount core.base.memory.{Shared};
mount core.security.aead.aes_gcm.{
    aes128_gcm_seal, aes128_gcm_open,
    aes256_gcm_seal, aes256_gcm_open,
};
mount core.security.aead.chacha20_poly1305.{
    chacha20_poly1305_seal, chacha20_poly1305_open,
};
mount core.net.quic.crypto.header_protection.{HpKey, HpMask, compute_hp_mask};
mount core.net.tls13.cipher_suite.{AeadKind};

type PacketKey is Aes128([Byte; 16]) | Aes256([Byte; 32]) | ChaCha([Byte; 32]);

implement PacketKey {
    fn from_bytes(suite: &AeadKind, bytes: &[Byte]) -> Result<PacketKey, QuicAeadError> {
        match suite {
            AeadKind.Aes128Gcm => {
                if bytes.len() != 16 { return Result.Err(QuicAeadError.BadKeyLength(bytes.len())); }
                let mut key: [Byte; 16] = [0_u8; 16];
                let mut i = 0;
                while i < 16 { key[i] = bytes[i]; i = i + 1; }
                Result.Ok(PacketKey.Aes128(key))
            },
            AeadKind.Aes256Gcm | AeadKind.ChaCha20Poly1305 => {
                if bytes.len() != 32 { return Result.Err(QuicAeadError.BadKeyLength(bytes.len())); }
                let mut key: [Byte; 32] = [0_u8; 32];
                let mut i = 0;
                while i < 32 { key[i] = bytes[i]; i = i + 1; }
                match suite {
                    AeadKind.Aes256Gcm => Result.Ok(PacketKey.Aes256(key)),
                    _ => Result.Ok(PacketKey.ChaCha(key)),
                }
            },
            _ => Result.Err(QuicAeadError.UnsupportedAlgorithm),
        }
    }

    fn suite(&self) -> AeadKind {
        match self {
            PacketKey.Aes128(_) => AeadKind.Aes128Gcm,
            PacketKey.Aes256(_) => AeadKind.Aes256Gcm,
            PacketKey.ChaCha(_) => AeadKind.ChaCha20Poly1305,
        }
    }
}

fn packet_iv(bytes: &[Byte]) -> Result<[Byte; 12], QuicAeadError> {
    if bytes.len() != 12 { return Result.Err(QuicAeadError.BadKeyLength(bytes.len())); }
    let mut iv: [Byte; 12] = [0_u8; 12];
    let mut i = 0;
    while i < 12 { iv[i] = bytes[i]; i = i + 1; }
    Result.Ok(iv)
}

/// Packet protection for a single direction and packet number space.
public type QuicSpaceKeys is {
    packet_key: PacketKey,
    iv: [Byte; 12],
    hp_key: Shared<HpKey>,
};

implement QuicSpaceKeys {
    pub(in core.net.quic) fn from_derived(
        suite: &AeadKind, key: &[Byte], iv: &[Byte], hp: &[Byte],
    ) -> Result<QuicSpaceKeys, QuicAeadError> {
        let packet_key = PacketKey.from_bytes(suite, key)?;
        let nonce = packet_iv(iv)?;
        let header_key = match PacketKey.from_bytes(suite, hp)? {
            PacketKey.Aes128(k) => HpKey.AesEcb128(k),
            PacketKey.Aes256(k) => HpKey.AesEcb256(k),
            PacketKey.ChaCha(k) => HpKey.ChaCha20Block(k),
        };
        Result.Ok(QuicSpaceKeys { packet_key: packet_key, iv: nonce, hp_key: Shared.new(header_key) })
    }

    pub(in core.net.quic) fn updated(&self, key: &[Byte], iv: &[Byte]) -> Result<QuicSpaceKeys, QuicAeadError> {
        let packet_key = PacketKey.from_bytes(&self.packet_key.suite(), key)?;
        let nonce = packet_iv(iv)?;
        Result.Ok(QuicSpaceKeys { packet_key: packet_key, iv: nonce, hp_key: self.hp_key.clone() })
    }

    pub(in core.net.quic) fn packet_key_len(&self) -> Int {
        match &self.packet_key { PacketKey.Aes128(_) => 16, _ => 32 }
    }

    pub(in core.net.quic) fn header_mask(&self, sample: &[Byte; 16]) -> HpMask {
        compute_hp_mask(self.hp_key.get(), sample)
    }
}

public type QuicAeadError is
      BadKeyLength(Int)
    | UnsupportedAlgorithm
    | AeadFailure;

// QuicAeadError.AeadFailure surfaces no detail — RFC 9001
// §5.4 mandates value-blind AEAD opens to avoid an oracle
// for the QUIC packet-protection key material (same
// discipline as TLS 1.3 record / ticket / address-token).

implement Display for QuicAeadError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            BadKeyLength(n)  => f.write_str(f"QUIC AEAD: bad key length {n}".as_str()),
            UnsupportedAlgorithm => f.write_str("QUIC AEAD: unsupported algorithm"),
            AeadFailure      => f.write_str("QUIC AEAD: authentication failed"),
        }
    }
}

implement Debug for QuicAeadError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            BadKeyLength(n)  => f.write_str(f"BadKeyLength({n})".as_str()),
            UnsupportedAlgorithm => f.write_str("UnsupportedAlgorithm"),
            AeadFailure      => f.write_str("AeadFailure"),
        }
    }
}

implement PartialEq for QuicAeadError {
    fn eq(&self, other: &QuicAeadError) -> Bool {
        match (self, other) {
            (BadKeyLength(a), BadKeyLength(b)) => a == b,
            (UnsupportedAlgorithm, UnsupportedAlgorithm) => true,
            (AeadFailure,     AeadFailure)     => true,
            _ => false,
        }
    }
}

implement Eq for QuicAeadError {}

// =============================================================================
// Nonce construction — RFC 9001 §5.3
// =============================================================================

/// Build the per-packet nonce: `iv XOR pad_left(big-endian pn, 12)`.
/// Result is 12 bytes.
public fn build_nonce(iv: &[Byte; 12], packet_number: UInt64) -> [Byte; 12] {
    let mut nonce: [Byte; 12] = *iv;
    nonce[ 4] = nonce[ 4] ^ ((packet_number >> 56) & 0xFF_u64) as Byte;
    nonce[ 5] = nonce[ 5] ^ ((packet_number >> 48) & 0xFF_u64) as Byte;
    nonce[ 6] = nonce[ 6] ^ ((packet_number >> 40) & 0xFF_u64) as Byte;
    nonce[ 7] = nonce[ 7] ^ ((packet_number >> 32) & 0xFF_u64) as Byte;
    nonce[ 8] = nonce[ 8] ^ ((packet_number >> 24) & 0xFF_u64) as Byte;
    nonce[ 9] = nonce[ 9] ^ ((packet_number >> 16) & 0xFF_u64) as Byte;
    nonce[10] = nonce[10] ^ ((packet_number >>  8) & 0xFF_u64) as Byte;
    nonce[11] = nonce[11] ^ ((packet_number      ) & 0xFF_u64) as Byte;
    nonce
}

/// AEAD-seal `plaintext` under `keys` at the given packet number.
/// Returns ciphertext||tag concatenated.
public fn seal(
    keys: &QuicSpaceKeys,
    packet_number: UInt64,
    aad: &[Byte],
    plaintext: &[Byte],
) -> Result<List<Byte>, QuicAeadError> {
    let nonce = build_nonce(&keys.iv, packet_number);
    let mut out: List<Byte> = [];
    let succeeded = match &keys.packet_key {
        PacketKey.Aes128(key) => aes128_gcm_seal(key, &nonce, aad, plaintext, &mut out).is_ok(),
        PacketKey.Aes256(key) => aes256_gcm_seal(key, &nonce, aad, plaintext, &mut out).is_ok(),
        PacketKey.ChaCha(key) => chacha20_poly1305_seal(key, &nonce, aad, plaintext, &mut out).is_ok(),
    };
    if succeeded { Result.Ok(out) } else { Result.Err(QuicAeadError.AeadFailure) }
}

/// AEAD-open; on success returns plaintext bytes. On tag-mismatch or
/// any other failure returns AeadFailure — no distinguisher on
/// purpose (constant-time discipline).
public fn open(
    keys: &QuicSpaceKeys,
    packet_number: UInt64,
    aad: &[Byte],
    ciphertext: &[Byte],
) -> Result<List<Byte>, QuicAeadError> {
    let nonce = build_nonce(&keys.iv, packet_number);
    let mut out: List<Byte> = [];
    let succeeded = match &keys.packet_key {
        PacketKey.Aes128(key) => aes128_gcm_open(key, &nonce, aad, ciphertext, &mut out).is_ok(),
        PacketKey.Aes256(key) => aes256_gcm_open(key, &nonce, aad, ciphertext, &mut out).is_ok(),
        PacketKey.ChaCha(key) => chacha20_poly1305_open(key, &nonce, aad, ciphertext, &mut out).is_ok(),
    };
    if succeeded { Result.Ok(out) } else { Result.Err(QuicAeadError.AeadFailure) }
}
