// =============================================================================
// net/quic/connection_sm/handshake_driver.vr — TLS ↔ QUIC CRYPTO bridge
// =============================================================================
// Layer: 5 (Network — QUIC)
// Dependencies: core, collections,
//  core.net.tls13.handshake.{client_sm, server_sm},
//  core.net.quic.{frame, recovery}
// =============================================================================
//

// QUIC runs the TLS 1.3 handshake over a dedicated per-PN-space stream
// carried inside CRYPTO frames (RFC 9001 §4). Each PN space (Initial,
// Handshake, Application) has its own crypto offset counter starting
// at 0; the frames carry `(offset, data)` pairs and the receiver
// reassembles them before feeding into the TLS SM.
//

// Per RFC 9001:
//  * Initial-space CRYPTO — ClientHello / server-side (ServerHello on
//  its own — the rest already moves to
//  Handshake keys).
//  * Handshake-space CRYPTO — EncryptedExtensions / Certificate /
//  CertificateVerify / Finished.
//  * Application-space CRYPTO — NewSessionTicket / KeyUpdate signals.
//

// HandshakeDriver maintains:
//  * Inbound buffer per space (handles out-of-order CRYPTO frames).
//  * Outbound offset counter per space.
//  * An opaque role-specific TLS SM reference (client or server).
//

// Callers pump incoming CRYPTO frames via `on_crypto_chunk`, pull any
// emitted outbound bytes via `take_outbound` (per-space CRYPTO frames
// ready for wire assembly), and query `completion()` to know when the
// handshake has produced 1-RTT traffic keys so the connection_sm can
// promote to OneRtt.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.connection_sm.handshake_driver;

mount core.collections.list.{List};
mount core.base.memory.{replace};
mount core.net.quic.frame.{QuicFrame};
mount core.net.quic.recovery.{PnSpaceKind};
mount core.net.quic.connection_sm.dispatch.{CryptoChunk};

mount core.net.tls13.handshake.client_sm.{ClientSm, StepOutput};
mount core.net.tls13.handshake.server_sm.{ServerSm, ServerStepOutput};
mount core.net.tls13.error.{TlsError};
mount core.net.tls13.keyschedule.{TrafficSecret};

// =============================================================================
// Per-space CRYPTO stream reassembly buffer
// =============================================================================

/// Out-of-order reassembly of received CRYPTO bytes in one PN space.
/// Runs are stored sorted by `start` with no overlap; `next_readable`
/// advances past contiguous prefix as bytes become deliverable.
public type CryptoStream is {
    /// Next offset we are ready to consume.
    next_readable: UInt64,
    /// Sorted non-overlapping runs of received bytes, keyed by
    /// starting offset.
    runs:          List<CryptoRun>,
    /// Offset for our outbound CRYPTO frames in this space.
    tx_offset:     UInt64,
};

type CryptoRun is { start: UInt64, bytes: List<Byte> };

implement CryptoStream {
    public fn new() -> CryptoStream {
        CryptoStream { next_readable: 0_u64, runs: [], tx_offset: 0_u64 }
    }

    /// Insert a CRYPTO frame chunk. Idempotent on retransmit — already-
    /// delivered bytes are silently dropped.
    public fn insert(&mut self, offset: UInt64, data: &[Byte]) -> Result<(), TlsError> {
        let limit = (1_u64 << 62_u64) - 1_u64;
        if offset > limit || (data.len() as UInt64) > limit - offset { return Result.Err(TlsError.IllegalParameter); }
        let end = offset + (data.len() as UInt64);
        if data.len() == 0 || end <= self.next_readable { return Result.Ok(()); }
        let start = if offset < self.next_readable { self.next_readable } else { offset };
        let mut at = 0;
        while at < self.runs.len() {
            let existing = &self.runs[at];
            if existing.start + (existing.bytes.len() as UInt64) >= start { break; }
            at = at + 1;
        }
        let mut merged_start = start;
        let mut merged_end = end;
        let mut last = at;
        while last < self.runs.len() {
            let existing = &self.runs[last];
            if existing.start > merged_end { break; }
            let existing_end = existing.start + (existing.bytes.len() as UInt64);
            let mut pos = if start > existing.start { start } else { existing.start };
            while pos < end && pos < existing_end {
                if data[(pos - offset) as Int] != existing.bytes[(pos - existing.start) as Int] {
                    return Result.Err(TlsError.IllegalParameter);
                }
                pos = pos + 1_u64;
            }
            if existing.start < merged_start { merged_start = existing.start; }
            if existing_end > merged_end { merged_end = existing_end; }
            last = last + 1;
        }
        let mut bytes: List<Byte> = List.with_capacity((merged_end - merged_start) as Int);
        let mut pos = merged_start;
        let mut run = at;
        while pos < merged_end {
            if pos >= start && pos < end { bytes.push(data[(pos - offset) as Int]); }
            else {
                while run < last && pos >= self.runs[run].start + (self.runs[run].bytes.len() as UInt64) { run = run + 1; }
                let source = &self.runs[run];
                bytes.push(source.bytes[(pos - source.start) as Int]);
            }
            pos = pos + 1_u64;
        }
        while last > at { last = last - 1; let _ = self.runs.remove(last); }
        self.runs.insert(at, CryptoRun { start: merged_start, bytes: bytes });
        Result.Ok(())
    }

    /// Drain the complete contiguous prefix.
    public fn drain_readable(&mut self) -> List<Byte> {
        if self.runs.is_empty() || self.runs[0].start != self.next_readable { return List<Byte>.new(); }
        let head = self.runs.remove(0);
        self.next_readable = self.next_readable + (head.bytes.len() as UInt64);
        head.bytes
    }

    /// TLS handshake records carry a one-byte type and a three-byte body length.
    fn take_message(&mut self) -> Maybe<List<Byte>> {
        if self.runs.is_empty() || self.runs[0].start != self.next_readable ||
           self.runs[0].bytes.len() < 4 { return Maybe.None; }
        let n = 4 + ((self.runs[0].bytes[1] as Int) << 16)
                  + ((self.runs[0].bytes[2] as Int) << 8) + (self.runs[0].bytes[3] as Int);
        if n > self.runs[0].bytes.len() { return Maybe.None; }
        let mut head = self.runs.remove(0);
        self.next_readable = self.next_readable + (n as UInt64);
        if head.bytes.len() > n {
            let tail = head.bytes.split_off(n);
            self.runs.insert(0, CryptoRun { start: self.next_readable, bytes: tail });
        }
        Maybe.Some(head.bytes)
    }

    public fn reserve_outbound(&mut self, n: Int) -> Result<UInt64, TlsError> {
        let max_offset: UInt64 = (1_u64 << 62) - 1_u64;
        if n < 0 || (n as UInt64) > max_offset - self.tx_offset { return Result.Err(TlsError.IllegalParameter); }
        let off = self.tx_offset;
        self.tx_offset = off + (n as UInt64);
        Result.Ok(off)
    }
}

// =============================================================================
// HandshakeDriver — role-specific TLS SM wrapper
// =============================================================================

public type HandshakeRole is AsClient(ClientSm) | AsServer(ServerSm);

public type HandshakeDriver is {
    role:       Maybe<HandshakeRole>,
    /// Per-space inbound CRYPTO reassembly + outbound offset tracking.
    initial:    CryptoStream,
    handshake:  CryptoStream,
    application: CryptoStream,
    /// Queued outbound CRYPTO frames, tagged with target PN space.
    outbound:   List<(PnSpaceKind, QuicFrame)>,
    /// Populated once the handshake produces the application
    /// (1-RTT) traffic secrets.
    connected_secrets: Maybe<HandshakeOutput>,
};

public type HandshakeOutput is
      ClientHandshakeOutput(core.net.tls13.handshake.client_sm.Connected)
    | ServerHandshakeOutput(core.net.tls13.handshake.server_sm.ServerConnected);

implement HandshakeDriver {
    public fn client(sm: ClientSm) -> HandshakeDriver {
        HandshakeDriver {
            role:       Maybe.Some(HandshakeRole.AsClient(sm)),
            initial:    CryptoStream.new(),
            handshake:  CryptoStream.new(),
            application: CryptoStream.new(),
            outbound:   [],
            connected_secrets: Maybe.None,
        }
    }

    public fn server(sm: ServerSm) -> HandshakeDriver {
        HandshakeDriver {
            role:       Maybe.Some(HandshakeRole.AsServer(sm)),
            initial:    CryptoStream.new(),
            handshake:  CryptoStream.new(),
            application: CryptoStream.new(),
            outbound:   [],
            connected_secrets: Maybe.None,
        }
    }

    /// Emit initial ClientHello (client only). After this, caller
    /// pumps `on_crypto_chunk` with peer responses.
    public fn start_client(&mut self) -> Result<(), TlsError> {
        if !self.can_start_client() { return Result.Err(TlsError.UnexpectedMessage); }
        let (sm, wire) = start_client_role(replace(&mut self.role, Maybe<HandshakeRole>.None))?;
        self.role = Maybe.Some(HandshakeRole.AsClient(sm));
        self.enqueue_flight(wire)
    }

    fn can_start_client(&self) -> Bool {
        match &self.role {
            Maybe.Some(HandshakeRole.AsClient(ClientSm.StartSm { .. })) => true,
            _ => false,
        }
    }

    /// Ingest a CRYPTO chunk from a given PN space. Retries
    /// reassembly on that space and feeds the TLS SM if a full
    /// handshake message is now available.
    public fn on_crypto_chunk(&mut self, chunk: &CryptoChunk) -> Result<(), TlsError> {
        let (space, offset) = chunk.location();
        self.stream_for(&space).insert(offset, chunk.bytes())?;

        // Drain any ready bytes and feed to the TLS SM one message at
        // a time. The SM's decode layer picks message boundaries off
        // the uint24 length field in the Handshake record header.
        loop {
            let data = match self.stream_for(&space).take_message() {
                Maybe.Some(message) => message, Maybe.None => break,
            };
            let (outbound, connected) = self.feed_tls(data.as_slice())?;
            self.enqueue_flight(outbound)?;
            match connected {
                Maybe.Some(ho) => { self.connected_secrets = Maybe.Some(ho); },
                Maybe.None => {},
            }
        }
        Result.Ok(())
    }

    fn stream_for(&mut self, space: &PnSpaceKind) -> &mut CryptoStream {
        match space {
            PnSpaceKind.Initial     => &mut self.initial,
            PnSpaceKind.Handshake   => &mut self.handshake,
            PnSpaceKind.Application => &mut self.application,
        }
    }

    fn feed_tls(&mut self, wire: &[Byte]) ->
        Result<(List<Byte>, Maybe<HandshakeOutput>), TlsError>
    {
        let (next, outbound, connected) = advance_role(
            replace(&mut self.role, Maybe<HandshakeRole>.None), wire)?;
        self.role = Maybe.Some(next);
        Result.Ok((outbound, connected))
    }

    /// A TLS flight may contain ServerHello and Handshake-protected messages in one buffer.
    fn enqueue_flight(&mut self, wire: List<Byte>) -> Result<(), TlsError> {
        let mut pos = 0;
        while pos < wire.len() {
            if wire.len() - pos < 4 { return Result.Err(TlsError.DecodeError); }
            let body_len = ((wire[pos + 1] as Int) << 16) + ((wire[pos + 2] as Int) << 8)
                           + (wire[pos + 3] as Int);
            if body_len > wire.len() - pos - 4 { return Result.Err(TlsError.DecodeError); }
            let end = pos + 4 + body_len;
            let space = match wire[pos] {
                1_u8 | 2_u8 => PnSpaceKind.Initial,
                4_u8 => PnSpaceKind.Application,
                _ => PnSpaceKind.Handshake,
            };
            let bytes = List<Byte>.from_slice(wire.as_slice()[pos..end]);
            let offset = self.stream_for(&space).reserve_outbound(end - pos)?;
            self.outbound.push((space, QuicFrame.crypto_at(offset, bytes)));
            pos = end;
        }
        Result.Ok(())
    }

    /// Pull all queued outbound CRYPTO frames by PN space. Returns
    /// them batched so the caller can route to the right packet type
    /// (Initial / Handshake packets for their respective frames).
    public fn take_outbound(&mut self) -> List<(PnSpaceKind, QuicFrame)> {
        let mut out: List<(PnSpaceKind, QuicFrame)> = [];
        while self.outbound.len() > 0 {
            let item = self.outbound.remove(0);
            out.push(item);
        }
        out
    }

    public fn handshake_complete(&self) -> Bool {
        match &self.connected_secrets { Maybe.Some(_) => true, Maybe.None => false }
    }

    public fn completion(&self) -> Maybe<&HandshakeOutput> {
        match &self.connected_secrets { Maybe.Some(output) => Maybe.Some(output), Maybe.None => Maybe.None }
    }
}

fn start_client_role(role: Maybe<HandshakeRole>) -> Result<(ClientSm, List<Byte>), TlsError> {
    match role {
        Maybe.Some(HandshakeRole.AsClient(sm)) => sm.start(),
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn advance_role(role: Maybe<HandshakeRole>, wire: &[Byte])
    -> Result<(HandshakeRole, List<Byte>, Maybe<HandshakeOutput>), TlsError> {
    match role {
        Maybe.Some(HandshakeRole.AsClient(sm)) => {
            let (sm2, step) = sm.on_handshake(wire)?;
            let connected: Maybe<HandshakeOutput> = match step.connected {
                Maybe.Some(c) => Maybe.Some(HandshakeOutput.ClientHandshakeOutput(c)),
                Maybe.None    => Maybe.None,
            };
            Result.Ok((HandshakeRole.AsClient(sm2), step.outbound_handshake, connected))
        },
        Maybe.Some(HandshakeRole.AsServer(sm)) => {
            let (sm2, step) = sm.on_handshake(wire)?;
            let (outbound, completion) = step.into_output();
            let connected: Maybe<HandshakeOutput> = match completion {
                Maybe.Some(c) => Maybe.Some(HandshakeOutput.ServerHandshakeOutput(c)),
                Maybe.None    => Maybe.None,
            };
            Result.Ok((HandshakeRole.AsServer(sm2), outbound, connected))
        },
        Maybe.None => Result.Err(TlsError.UnexpectedMessage),
    }
}
