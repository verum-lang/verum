// =============================================================================
// net/quic/connection_sm/keys.vr — Traffic-secret → QuicSpaceKeys derivation
// =============================================================================
// Layer: 5 (Network — QUIC)
// Dependencies: core.net.tls13.keyschedule, core.net.quic.crypto.labels
// =============================================================================
//

// Bridge between TLS 1.3 traffic secrets (from the handshake SM) and
// QUIC's per-space key sets. RFC 9001 §5.1 mandates the labels are
// "quic key" / "quic iv" / "quic hp" rather than the "key" / "iv"
// used by the TLS record layer — everything else (HKDF-Expand-Label
// with the "tls13 " prefix + the same hash) is identical.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.connection_sm.keys;

mount core.net.tls13.keyschedule.schedule.{TrafficSecret};
mount core.net.tls13.cipher_suite.{AeadKind};
mount core.net.quic.crypto.labels.{LABEL_QUIC_KEY, LABEL_QUIC_IV, LABEL_QUIC_HP, LABEL_QUIC_KU};
mount core.net.quic.connection_sm.aead.{QuicSpaceKeys, QuicAeadError};

public type QuicKeyError is
      HkdfFailure
    | BadKeyLength(Int)
    | UnsupportedAlgorithm;

implement Display for QuicKeyError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            UnsupportedAlgorithm => f.write_str("QUIC keys: unsupported algorithm"),
            HkdfFailure       => f.write_str("QUIC keys: HKDF derivation failed"),
            BadKeyLength(n)   => f.write_str(f"QUIC keys: bad key length {n}".as_str()),
        }
    }
}

implement Debug for QuicKeyError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            UnsupportedAlgorithm => f.write_str("UnsupportedAlgorithm"),
            HkdfFailure       => f.write_str("HkdfFailure"),
            BadKeyLength(n)   => f.write_str(f"BadKeyLength({n})".as_str()),
        }
    }
}

implement PartialEq for QuicKeyError {
    fn eq(&self, other: &QuicKeyError) -> Bool {
        match (self, other) {
            (UnsupportedAlgorithm, UnsupportedAlgorithm) => true,
            (HkdfFailure,    HkdfFailure)    => true,
            (BadKeyLength(a), BadKeyLength(b)) => a == b,
            _ => false,
        }
    }
}

implement Eq for QuicKeyError {}

pub(in core.net.quic) fn key_error(error: QuicAeadError) -> QuicKeyError {
    match error {
        QuicAeadError.BadKeyLength(n) => QuicKeyError.BadKeyLength(n),
        QuicAeadError.UnsupportedAlgorithm => QuicKeyError.UnsupportedAlgorithm,
        QuicAeadError.AeadFailure => QuicKeyError.HkdfFailure,
    }
}

/// Derive QUIC v1 packet and header protection for the negotiated TLS suite.
public fn derive_space_keys(secret: &TrafficSecret, suite: &AeadKind) -> Result<QuicSpaceKeys, QuicKeyError> {
    let key_len = match suite {
        AeadKind.Aes128Gcm => 16,
        AeadKind.Aes256Gcm | AeadKind.ChaCha20Poly1305 => 32,
        _ => return Result.Err(QuicKeyError.UnsupportedAlgorithm),
    };
    let key = match secret.expand_traffic_label(&LABEL_QUIC_KEY, key_len) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    let iv = match secret.expand_traffic_label(&LABEL_QUIC_IV, 12) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    let hp = match secret.expand_traffic_label(&LABEL_QUIC_HP, key_len) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    match QuicSpaceKeys.from_derived(suite, key.as_slice(), iv.as_slice(), hp.as_slice()) {
        Result.Ok(keys) => Result.Ok(keys), Result.Err(e) => Result.Err(key_error(e)),
    }
}

/// Update the QUIC v1 packet key and IV while retaining header protection (RFC 9001 §6).
public fn rotate_space_keys(
    secret: &TrafficSecret, current: &QuicSpaceKeys,
) -> Result<(TrafficSecret, QuicSpaceKeys), QuicKeyError> {
    let next = match secret.next_generation_with_label(&LABEL_QUIC_KU) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    let key = match next.expand_traffic_label(&LABEL_QUIC_KEY, current.packet_key_len()) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    let iv = match next.expand_traffic_label(&LABEL_QUIC_IV, 12) {
        Result.Ok(v) => v, Result.Err(_) => return Result.Err(QuicKeyError.HkdfFailure),
    };
    match current.updated(key.as_slice(), iv.as_slice()) {
        Result.Ok(keys) => Result.Ok((next, keys)), Result.Err(e) => Result.Err(key_error(e)),
    }
}

/// Pick the AEAD key length given a negotiated AeadKind.
public fn aead_key_len_for(kind: &AeadKind) -> Int {
    match kind {
        AeadKind.Aes128Gcm        => 16,
        AeadKind.Aes256Gcm        => 32,
        AeadKind.ChaCha20Poly1305 => 32,
        AeadKind.Aes128Ccm        => 16,
        AeadKind.Aes128Ccm8       => 16,
        AeadKind.Unknown          => 0,
    }
}

public fn is_chacha_aead(kind: &AeadKind) -> Bool {
    match kind {
        AeadKind.ChaCha20Poly1305 => true,
        _ => false,
    }
}
