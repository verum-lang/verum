// =============================================================================
// net/quic/path.vr — QuicPath validation + anti-amplification (RFC 9000 §8, §21.1.1.3)
// =============================================================================
// Layer: 5 (Network — QUIC)
// Dependencies: core, core.time, core.net.addr
// =============================================================================
//

// RFC 9000 §8 — before a sender uses a new path, it MUST run path
// validation: send a PATH_CHALLENGE with 8 random bytes and accept
// only a PATH_RESPONSE that echoes the same bytes within a bounded
// time window. Server-initiated paths have an additional constraint:
//

// §21.1.1.3 anti-amplification: the server MUST NOT send more than
// 3× the bytes it has received from the client on a not-yet-validated
// path. This is the DDoS mitigation that prevents QUIC servers from
// being used as amplification reflectors.
//

// # States
//

//  Unvalidated(AmpBudget) — initial; enforces 3× cap.
//  Validating(Challenge) — challenge in flight; wait for response.
//  Validated — path is real; no budget limit.
//  Failed — challenge timeout; path abandoned.
//

// # Migration
//

// When a client migrates (new local address) or a peer migrates
// (reported new remote address), a fresh QuicPath is spun up on the
// target 4-tuple. The old path stays validated until PATH_CHALLENGE
// confirms the new one, at which point the old is retired.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.path;

mount core.base.primitives.*;
mount core.base.memory.{replace};
mount core.time.instant.{Instant};
mount core.time.duration.{Duration};
mount core.net.addr.{SocketAddr};
mount core.random.secure.{fill_secure_array};

// =============================================================================
// State
// =============================================================================

public type PathState is
      Unvalidated { received_bytes: UInt64, sent_bytes: UInt64 }
    | Validating { challenge: [Byte; 8], sent_at: Instant, attempts: UInt32 }
    | Validated
    | Failed;

public type QuicPath is {
    local:   SocketAddr,
    remote:  SocketAddr,
    state:   PathState,
    // In-progress validation retains the preceding unvalidated address budget.
    validation_budget: Maybe<(UInt64, UInt64)>,
    /// RTT seen on this specific path (populated on PATH_RESPONSE
    /// acceptance). Separate from the overall connection RTT
    /// estimator — useful for migration decisions.
    last_rtt: Maybe<Duration>,
};

public type PathError is
      AmplificationLimitExceeded
    | ChallengeTimeout
    | UnexpectedResponse;

implement Display for PathError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        let s = match self {
            AmplificationLimitExceeded => "QUIC path: amplification limit exceeded",
            ChallengeTimeout           => "QUIC path: PATH_CHALLENGE timed out",
            UnexpectedResponse         => "QUIC path: unexpected PATH_RESPONSE",
        };
        f.write_str(s)
    }
}

implement Debug for PathError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        let s = match self {
            AmplificationLimitExceeded => "AmplificationLimitExceeded",
            ChallengeTimeout           => "ChallengeTimeout",
            UnexpectedResponse         => "UnexpectedResponse",
        };
        f.write_str(s)
    }
}

implement PartialEq for PathError {
    fn eq(&self, other: &PathError) -> Bool {
        match (self, other) {
            (AmplificationLimitExceeded, AmplificationLimitExceeded) => true,
            (ChallengeTimeout,           ChallengeTimeout)           => true,
            (UnexpectedResponse,         UnexpectedResponse)         => true,
            _ => false,
        }
    }
}

implement Eq for PathError {}

// =============================================================================
// Constants
// =============================================================================

public const ANTI_AMPLIFICATION_FACTOR: UInt64 = 3_u64;
public const CHALLENGE_TIMEOUT: Duration = Duration.from_millis(500);
public const MAX_CHALLENGE_ATTEMPTS: UInt32 = 3_u32;

// =============================================================================
// API
// =============================================================================

implement QuicPath {
    /// New path — server-initiated paths start Unvalidated to enforce
    /// anti-amplification; client-initiated paths that have already
    /// verified 4-tuple via handshake may start Validated.
    public fn new(local: SocketAddr, remote: SocketAddr, initially_validated: Bool) -> QuicPath {
        let state = if initially_validated {
            PathState.Validated
        } else {
            PathState.Unvalidated { received_bytes: 0_u64, sent_bytes: 0_u64 }
        };
        QuicPath { local: local, remote: remote, state: state, validation_budget: Maybe.None, last_rtt: Maybe.None }
    }

    /// Can we send `n` bytes under the current anti-amplification
    /// budget? Returns Err if the path is Failed or if sending would
    /// exceed the 3× cap while unvalidated.
    public fn can_send(&self, n: UInt64) -> Result<(), PathError> {
        if self.is_failed() { return Result.Err(PathError.ChallengeTimeout); }
        if n > self.remaining_budget() { return Result.Err(PathError.AmplificationLimitExceeded); }
        Result.Ok(())
    }

    fn budget(&self) -> Maybe<(UInt64, UInt64)> {
        match &self.state {
            PathState.Unvalidated { received_bytes, sent_bytes } => Maybe.Some((*received_bytes, *sent_bytes)),
            PathState.Validating { .. } => self.validation_budget,
            _ => Maybe.None,
        }
    }

    pub(in core.net.quic) fn remaining_budget(&self) -> UInt64 {
        if self.is_failed() { return 0_u64; }
        match self.budget() {
            Maybe.Some((received, sent)) => received.saturating_mul(ANTI_AMPLIFICATION_FACTOR).saturating_sub(sent),
            Maybe.None => UInt64.MAX,
        }
    }

    fn account(&mut self, received: UInt64, sent: UInt64) {
        if let Maybe.Some((rx, tx)) = self.budget() {
            let new_rx = rx.saturating_add(received);
            let new_tx = tx.saturating_add(sent);
            if self.state is PathState.Validating { .. } {
                self.validation_budget = Maybe.Some((new_rx, new_tx));
            } else {
                self.state = PathState.Unvalidated { received_bytes: new_rx, sent_bytes: new_tx };
            }
        }
    }

    public fn on_bytes_sent(&mut self, n: UInt64) { self.account(0_u64, n); }
    public fn on_bytes_received(&mut self, n: UInt64) { self.account(n, 0_u64); }

    /// Begin validation — generate an 8-byte challenge and transition
    /// to Validating. Caller MUST emit a PATH_CHALLENGE frame carrying
    /// the returned bytes.
    public fn begin_validation(&mut self, now: Instant) -> [Byte; 8] {
        let mut challenge: [Byte; 8] = [0_u8; 8];
        fill_secure_array<8>(&mut challenge);
        let attempts = self.validation_attempts().saturating_add(1_u32);
        self.validation_budget = self.budget();
        self.state = PathState.Validating {
            challenge: challenge,
            sent_at:   now,
            attempts:  attempts,
        };
        challenge
    }

    /// Peer sent a PATH_RESPONSE. Returns Result.Ok(true) if the response
    /// echoes our pending challenge and the path transitions to
    /// Validated; Result.Ok(false) if the response is stale or path wasn't
    /// being validated; Err if genuinely malformed (response on a
    /// Failed path).
    public fn on_path_response(&mut self, data: &[Byte; 8], now: Instant) -> Result<Bool, PathError> {
        if self.is_failed() { return Result.Err(PathError.UnexpectedResponse); }
        let sent_at = match self.matching_challenge(data) {
            Maybe.Some(sent) => sent, Maybe.None => return Result.Ok(false),
        };
        self.last_rtt = now.duration_since(sent_at);
        self.validation_budget = Maybe.None;
        self.state = PathState.Validated;
        Result.Ok(true)
    }

    fn matching_challenge(&self, data: &[Byte; 8]) -> Maybe<Instant> {
        match &self.state {
            PathState.Validating { challenge, sent_at, .. } => {
                let mut i = 0;
                while i < 8 {
                    if data[i] != challenge[i] { return Maybe.None; }
                    i = i + 1;
                }
                Maybe.Some(*sent_at)
            },
            _ => Maybe.None,
        }
    }

    fn validation_attempts(&self) -> UInt32 {
        match &self.state { PathState.Validating { attempts, .. } => *attempts, _ => 0_u32 }
    }

    /// Timer fire — check for challenge timeout. Returns a signal the
    /// caller uses to re-challenge (if attempts < MAX) or retire the
    /// path (if MAX reached).
    public fn on_timer(&mut self, now: Instant) -> TimerOutcome {
        let outcome = self.timer_action(now);
        if outcome is TimerOutcome.Failed { self.state = PathState.Failed; }
        outcome
    }

    fn timer_action(&self, now: Instant) -> TimerOutcome {
        match &self.state {
            PathState.Validating { sent_at, attempts, .. } => {
                if now.duration_since(sent_at.clone())
                    .unwrap_or_else(|| Duration.from_micros(0)) >= CHALLENGE_TIMEOUT {
                    if *attempts >= MAX_CHALLENGE_ATTEMPTS {
                        TimerOutcome.Failed
                    } else {
                        TimerOutcome.ShouldReChallenge
                    }
                } else {
                    TimerOutcome.NoAction
                }
            },
            _ => TimerOutcome.NoAction,
        }
    }

    /// V7 theorem (spec §9): before the path is Validated, the
    /// server's `sent_bytes` MUST stay within `3 * received_bytes`.
    /// Returns true iff the current state does not violate that bound
    /// (a Validated path trivially satisfies it because the cap no
    /// longer applies). Useful for both SMT obligations and runtime
    /// DoS-hardening asserts in hot paths.
    public fn amp_budget_ok(&self) -> Bool {
        match self.budget() {
            Maybe.Some((received, sent)) => sent <= received.saturating_mul(ANTI_AMPLIFICATION_FACTOR),
            Maybe.None => true,
        }
    }

    public fn is_validated(&self) -> Bool {
        match &self.state { PathState.Validated => true, _ => false }
    }

    public fn is_failed(&self) -> Bool {
        match &self.state { PathState.Failed => true, _ => false }
    }

    public fn remote_addr(&self) -> SocketAddr { self.remote.clone() }
    public fn local_addr(&self)  -> SocketAddr { self.local.clone() }
}

public type TimerOutcome is NoAction | ShouldReChallenge | Failed;

// =============================================================================
// PathManager — multi-path bookkeeping for connection migration
// =============================================================================
//

// When a peer migrates (apparent source 4-tuple change), the
// PathManager tracks the old (primary) path as Validated and spins
// up a new QuicPath as Unvalidated. Once the new path validates, the
// old one can be retired.
//

// =============================================================================

public type PathManager is {
    /// Currently-active path. Writes go here; reads may arrive on
    /// `standby` when peer migration is in progress.
    active:  QuicPath,
    /// Candidate migration target; Maybe.None when no migration in flight.
    standby: Maybe<QuicPath>,
};

implement PathManager {
    public fn new(initial: QuicPath) -> PathManager {
        PathManager { active: initial, standby: Maybe.None }
    }

    /// Peer sent a packet from an unexpected 4-tuple → start a
    /// migration attempt. If there's no standby or `remote` differs
    /// from the current standby, replace it.
    public fn on_new_remote(&mut self, local: SocketAddr, remote: SocketAddr) {
        let replace = match &self.standby {
            Maybe.Some(s) => s.remote != remote,
            Maybe.None    => true,
        };
        if replace {
            // Server MUST start unvalidated (§8.1); client considers
            // peer migration path unvalidated too until PATH_CHALLENGE
            // succeeds.
            self.standby = Maybe.Some(QuicPath.new(local, remote, false));
        }
    }

    /// Standby path validated → promote it as active; retire old.
    public fn promote_standby(&mut self) -> Maybe<SocketAddr> {
        let valid = match &self.standby { Maybe.Some(path) => path.is_validated(), Maybe.None => false };
        if !valid { return Maybe.None; }
        match replace(&mut self.standby, Maybe<QuicPath>.None) {
            Maybe.Some(path) => {
                let retired = self.active.remote_addr();
                self.active = path;
                Maybe.Some(retired)
            },
            Maybe.None => Maybe.None,
        }
    }

    public fn active(&self) -> &QuicPath { &self.active }
    public fn active_mut(&mut self) -> &mut QuicPath { &mut self.active }
    public fn standby_mut(&mut self) -> Maybe<&mut QuicPath> {
        match &mut self.standby {
            Maybe.Some(s) => Maybe.Some(s),
            Maybe.None => Maybe.None,
        }
    }
}
