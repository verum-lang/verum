// Applications record observed QUIC counters and gauges in snapshots.
// The Prometheus exporter reads the same public measurements as other consumers.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.quic.stats;

public type QuicCounter is
      DatagramsSent
    | DatagramsReceived
    | DatagramsDropped
    | BytesSent
    | BytesReceived
    | InitialPacketsSent
    | InitialPacketsReceived
    | HandshakePacketsSent
    | HandshakePacketsReceived
    | OneRttPacketsSent
    | OneRttPacketsReceived
    | PacketsLost
    | PacketsSpuriouslyLost
    | RetransmittedPackets
    | TimeoutsFired
    | StreamsOpenedBidi
    | StreamsOpenedUni
    | StreamsClosed
    | StreamBytesSent
    | StreamBytesReceived
    | ZeroRttOffered
    | ZeroRttAccepted
    | ZeroRttRejected
    | KeyUpdatesInitiated
    | KeyUpdatesReceived
    | IntegrityFailures
    | PathsValidated
    | MigrationsCompleted
    | CidsIssued
    | CidsRetired;

implement QuicCounter {
    fn slot(&self) -> Int {
        match self {
            DatagramsSent => 0,
            DatagramsReceived => 1,
            DatagramsDropped => 2,
            BytesSent => 3,
            BytesReceived => 4,
            InitialPacketsSent => 5,
            InitialPacketsReceived => 6,
            HandshakePacketsSent => 7,
            HandshakePacketsReceived => 8,
            OneRttPacketsSent => 9,
            OneRttPacketsReceived => 10,
            PacketsLost => 11,
            PacketsSpuriouslyLost => 12,
            RetransmittedPackets => 13,
            TimeoutsFired => 14,
            StreamsOpenedBidi => 15,
            StreamsOpenedUni => 16,
            StreamsClosed => 17,
            StreamBytesSent => 18,
            StreamBytesReceived => 19,
            ZeroRttOffered => 20,
            ZeroRttAccepted => 21,
            ZeroRttRejected => 22,
            KeyUpdatesInitiated => 23,
            KeyUpdatesReceived => 24,
            IntegrityFailures => 25,
            PathsValidated => 26,
            MigrationsCompleted => 27,
            CidsIssued => 28,
            CidsRetired => 29,
        }
    }
}

public type QuicGauge is
      CongestionWindowBytes
    | BytesInFlight
    | RttSmoothedUs
    | RttMinUs
    | RttVarUs;

implement QuicGauge {
    fn slot(&self) -> Int {
        match self {
            CongestionWindowBytes => 0,
            BytesInFlight => 1,
            RttSmoothedUs => 2,
            RttMinUs => 3,
            RttVarUs => 4,
        }
    }
}

public type QuicStats is {
    counters: [UInt64; 30],
    gauges: [UInt64; 5],
};

implement QuicStats {
    public fn new() -> QuicStats {
        QuicStats { counters: [0_u64; 30], gauges: [0_u64; 5] }
    }

    public fn counter(&self, metric: QuicCounter) -> UInt64 {
        self.counters[metric.slot()]
    }

    /// Record the observed cumulative total for this snapshot.
    public fn set_counter(&mut self, metric: QuicCounter, total: UInt64) {
        self.counters[metric.slot()] = total;
    }

    public fn gauge(&self, metric: QuicGauge) -> UInt64 {
        self.gauges[metric.slot()]
    }

    public fn set_gauge(&mut self, metric: QuicGauge, value: UInt64) {
        self.gauges[metric.slot()] = value;
    }

    /// Add the counters and retain the latest nonzero value of each gauge.
    public fn merge(&mut self, other: &QuicStats) {
        let mut i: Int = 0;
        while i < self.counters.len() {
            self.counters[i] = self.counters[i] + other.counters[i];
            i = i + 1;
        }
        let mut j: Int = 0;
        while j < self.gauges.len() {
            if other.gauges[j] > 0_u64 {
                self.gauges[j] = other.gauges[j];
            }
            j = j + 1;
        }
    }
}

public type EndpointCounter is
      ConnectionsOpened
    | ConnectionsClosed
    | StatelessResetsEmitted
    | VersionNegotiationsSent
    | RetriesEmitted
    | AmplificationLimitHits
    | DatagramsDroppedUntracked;

implement EndpointCounter {
    fn slot(&self) -> Int {
        match self {
            ConnectionsOpened => 0,
            ConnectionsClosed => 1,
            StatelessResetsEmitted => 2,
            VersionNegotiationsSent => 3,
            RetriesEmitted => 4,
            AmplificationLimitHits => 5,
            DatagramsDroppedUntracked => 6,
        }
    }
}

public type EndpointStats is {
    counters: [UInt64; 7],
    connections_active: UInt64,
    aggregate: QuicStats,
};

implement EndpointStats {
    public fn new() -> EndpointStats {
        EndpointStats {
            counters: [0_u64; 7],
            connections_active: 0_u64,
            aggregate: QuicStats.new(),
        }
    }

    public fn counter(&self, metric: EndpointCounter) -> UInt64 {
        self.counters[metric.slot()]
    }

    public fn set_counter(&mut self, metric: EndpointCounter, total: UInt64) {
        self.counters[metric.slot()] = total;
    }

    public fn active_connections(&self) -> UInt64 { self.connections_active }

    public fn set_active_connections(&mut self, count: UInt64) {
        self.connections_active = count;
    }

    public fn merge_connection(&mut self, stats: &QuicStats) {
        self.aggregate.merge(stats);
    }

    public fn aggregate(&self) -> &QuicStats { &self.aggregate }
}
