// =============================================================================
// net/tls13/handshake/client_sm.vr — TLS 1.3 client state machine (RFC 8446 §4.1.1)
// =============================================================================
// Layer: 5 (Network — TLS 1.3 core)
// =============================================================================
//

// Typed client state machine per RFC 8446 §4.1.1:
//

//  Start
//  └── send ClientHello ──▶ WaitServerHello
//  └── recv ServerHello ──▶ WaitEncryptedExtensions
//  └── recv EE ──▶ WaitCertCr
//  ├── recv CR ──▶ WaitCert
//  │ └── recv Cert ──▶ WaitCertVerify
//  └── recv Cert ──▶ WaitCertVerify
//  └── recv CV ──▶ WaitFinished
//  └── recv Fin ──▶ Connected
//

// Instead of one big enum with runtime state-check dispatch, each
// state is its own type carrying precisely the data that state needs
// — `find_method` on the wrong state is a compile-time error.
//

// This file implements the logic shape. Cryptographic steps
// (signature verify, chain validation, Finished MAC) delegate to
// `core.security.x509.chain` + `core.net.tls13.keyschedule` already
// landed in earlier phases.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.tls13.handshake.client_sm;

mount core.collections.list.{List};
mount core.base.memory.Shared;
mount core.time.instant.{Instant};
mount core.time.system_time.now_unix_s;
mount core.hash.crypto.sha256.{Sha256};
mount core.hash.crypto.sha384.{Sha384};
mount core.mac.hmac.{HmacSha256, HmacSha384, hmac_sha256, hmac_sha384};
mount core.security.x509.{X509Certificate, TrustStore, ChainError, parse_certificate, validate_chain};
mount core.security.x509.algorithm.{SignatureAlg, RsaPssParams, RsaPssHash};
mount core.security.x509.chain.verify_subject_signature;
mount core.security.ecc.x25519.{X25519, X25519SecretKey, X25519PublicKey};
mount core.security.ecc.p256.{P256, P256PrivateKey, P256PublicKey, P256Signature};
mount core.subtle.constant_time.{constant_time_eq};
mount core.net.tls13.version.{ProtocolVersion, LEGACY_VERSION_TLS_1_2, TLS_1_3, DOWNGRADE_SENTINEL_TLS12, DOWNGRADE_SENTINEL_TLS11};
mount core.net.tls13.cipher_suite.{CipherSuite, HashKind};
mount core.net.tls13.named_group.{NamedGroup};
mount core.net.tls13.sig_scheme.{SignatureScheme};
mount core.net.tls13.error.{TlsError};
mount core.net.tls13.keyschedule.{
    SecretBytes, EarlySecret, HandshakeSecret, MasterSecret,
    TrafficSecret,
};
mount core.net.tls13.keyschedule.hkdf_label.{hkdf_expand_label};
mount core.net.tls13.handshake.extension.{
    Extension, ExtensionContext,
    KeyShareEntry, ServerName,
};
mount core.net.tls13.handshake.messages.{
    ClientHello, ServerHello, EncryptedExtensions, CertificateMessage,
    CertificateEntry, CertificateRequest, CertificateVerify, Finished, KeyUpdate,
    NewSessionTicket,
    HandshakeMessage,
    encode_handshake, decode_handshake, is_hello_retry_request,
    HST_CERTIFICATE_VERIFY, HST_FINISHED,
};
mount core.net.tls13.handshake.resumption.{
    ClientSession, client_session_from_nst,
};
mount core.net.tls13.handshake.transcript.{Transcript};
mount core.net.tls13.handshake.codec.{CodecError, Tls13HandshakeReader};
mount core.net.tls13.handshake.dhe_pool.{DhePool, LocalDhePool, generate_offered_keyshares};

// =============================================================================
// Client configuration
// =============================================================================

public type Tls13ClientConfig is {
    server_name: Text,
    alpn:        List<List<Byte>>,            // offered protocols
    trust:       TrustStore,
    groups:      List<NamedGroup>,             // offered key-share groups
    suites:      List<CipherSuite>,            // offered cipher suites
    sig_schemes: List<SignatureScheme>,        // signature_algorithms value
    verify_hostname: Bool,
    /// 32 random bytes — MUST be CSPRNG-sourced. Handshake SM uses
    /// these as ClientHello.random.
    random:      [Byte; 32],
    /// Public halves of the ephemeral keypairs produced for this handshake.
    key_shares:  List<KeyShareEntry>,
};

implement Tls13ClientConfig {
    /// Configure an authenticated client. Supply a fresh CSPRNG ClientHello.random.
    public fn new(server_name: Text, trust: TrustStore, random: [Byte; 32],
                  groups: List<NamedGroup>, suites: List<CipherSuite>,
                  sig_schemes: List<SignatureScheme>, alpn: List<List<Byte>>)
                  -> Result<Tls13ClientConfig, TlsError> {
        if server_name.is_empty() || groups.is_empty() || suites.is_empty() || sig_schemes.is_empty() {
            return Result.Err(TlsError.IllegalParameter);
        }
        Result.Ok(Tls13ClientConfig {
            server_name, alpn, trust, groups, suites, sig_schemes, verify_hostname: true,
            random, key_shares: [],
        })
    }
}

// =============================================================================
// Phantom state markers — each is a distinct type
// =============================================================================

public type StateStart is ();
public type StateWaitServerHello is { /* held by WaitServerHello value */ };
public type StateWaitEe is ();
public type StateWaitCertOrCr is ();
public type StateWaitCert is ();
public type StateWaitCertVerify is ();
public type StateWaitFinished is ();
public type StateConnected is ();

// =============================================================================
// Per-state values
// =============================================================================

public type WaitServerHello is {
    config:     Tls13ClientConfig,
    transcript: Transcript,
    first_hello: List<Byte>,
    retry_suite: Maybe<CipherSuite>,
    /// DHE private keys keyed by group — caller matches ServerHello.key_share.group.
    /// We store them as raw bytes here; caller resolved them from an external
    /// DHE keystore on construction.
    dhe_privs:  List<(NamedGroup, List<Byte>)>,
};

public type WaitEncryptedExtensions is {
    config:     Tls13ClientConfig,
    transcript: Transcript,
    chosen_suite: CipherSuite,
    hash:       HashKind,
    handshake_secret: HandshakeSecret,
    client_hs_traffic: TrafficSecret,
    server_hs_traffic: TrafficSecret,
};

public type WaitCertOrCr is { inner: WaitEncryptedExtensions }
public type WaitCert is { inner: WaitEncryptedExtensions, cert_request: Maybe<CertificateRequest> }

public type WaitCertVerify is {
    inner:            WaitEncryptedExtensions,
    cert_request:     Maybe<CertificateRequest>,
    peer_certificate: X509Certificate,
    peer_chain_der:   List<List<Byte>>,
};

implement WaitCertVerify {
    /// Parsed leaf received in Certificate and awaiting CertificateVerify.
    public fn received_certificate(&self) -> &X509Certificate { &self.peer_certificate }

    /// DER entries in their original peer-supplied order, leaf first.
    public fn received_chain_der(&self) -> &[List<Byte>] { self.peer_chain_der.as_slice() }
}

public type WaitFinished is {
    inner:            WaitEncryptedExtensions,
    cert_request:     Maybe<CertificateRequest>,
    peer_certificate: X509Certificate,
};

public type Connected is { state: Shared<ConnectedData> };

implement Clone for Connected {
    fn clone(&self) -> Connected { Connected { state: self.state.clone() } }
}

implement Connected {
    public(in core.net) fn negotiated_suite(&self) -> &CipherSuite { &self.state.get().suite }
    public(in core.net) fn application_traffic(&self) -> (&TrafficSecret, &TrafficSecret) {
        let connection = self.state.get();
        (&connection.client_ap_traffic, &connection.server_ap_traffic)
    }
}

type ConnectedData is {
    config:     Tls13ClientConfig,
    suite:      CipherSuite,
    hash:       HashKind,
    master_secret:    MasterSecret,
    client_ap_traffic: TrafficSecret,
    server_ap_traffic: TrafficSecret,
    resumption_master: SecretBytes,
    exporter_master:   SecretBytes,
    peer_certificate:  X509Certificate,
};

// =============================================================================
// ClientSm enum — a sum over the per-state types
// =============================================================================

public type ClientSm is
      StartSm { config: Tls13ClientConfig }
    | WaitServerHelloSm(WaitServerHello)
    | WaitEncryptedExtensionsSm(WaitEncryptedExtensions)
    | WaitCertOrCrSm(WaitCertOrCr)
    | WaitCertSm(WaitCert)
    | WaitCertVerifySm(WaitCertVerify)
    | WaitFinishedSm(WaitFinished)
    | ConnectedSm(Connected)
    | ClosedSm;

// =============================================================================
// Step — one input message advances the SM
// =============================================================================

public type StepOutput is {
    /// Bytes of outbound handshake messages to transmit. Empty if no
    /// response is required at this step.
    public(in core.net) outbound_handshake: List<Byte>,
    /// If non-Maybe.None, the handshake is done — application traffic can flow.
    public(in core.net) connected: Maybe<Connected>,
};

implement StepOutput {
    /// Whether this step produced the completed connection state.
    public fn is_connected(&self) -> Bool { self.connected.is_some() }
}

implement ClientSm {
    /// Initial state; emit ClientHello.
    public fn new(config: Tls13ClientConfig) -> ClientSm {
        ClientSm.StartSm { config: config }
    }

    /// Drive the initial ClientHello emission. Transitions
    /// Start → WaitServerHello.
    public fn start(self) -> Result<(ClientSm, List<Byte>), TlsError> {
        let mut pool = LocalDhePool.new();
        self.start_with_key_pool(&mut pool)
    }

    /// Start with a caller-owned source of fresh ephemeral keypairs.
    public fn start_with_key_pool(self, pool: &mut dyn DhePool) -> Result<(ClientSm, List<Byte>), TlsError> {
        match self {
            ClientSm.StartSm { config } => {
                let mut prepared = config;
                let (shares, dhe_privs) = generate_offered_keyshares(pool, List.from_slice(prepared.groups.as_slice()))?;
                prepared.key_shares = shares;
                let ch = build_client_hello(&prepared);
                let msg = HandshakeMessage.ClientHelloMsg(ch);
                let mut wire: List<Byte> = [];
                with_tls_error(encode_handshake(&msg, &mut wire), TlsError.InternalError(Text.from("encode CH failed")))?;
                let next = ClientSm.WaitServerHelloSm(WaitServerHello {
                    config: prepared, transcript: Transcript.new(HashKind.Sha256),
                    first_hello: wire.clone(), retry_suite: Maybe.None, dhe_privs: dhe_privs,
                });
                Result.Ok((next, wire))
            },
            _ => Result.Err(TlsError.UnexpectedMessage),
        }
    }

    /// Feed an inbound handshake message (already decoded from the
    /// record layer). Returns an updated SM + any outbound messages
    /// that must be transmitted in response.
    public fn on_handshake(self, wire: &[Byte]) -> Result<(ClientSm, StepOutput), TlsError> {
        let mut r = Tls13HandshakeReader.new(wire);
        let msg = decode_handshake(&mut r).map_err(decode_error)?;
        if !r.is_at_end() { return Result.Err(TlsError.DecodeError); }

        match self {
            ClientSm.WaitServerHelloSm(ws) => on_server_hello(ws, msg, wire),
            ClientSm.WaitEncryptedExtensionsSm(we) => on_encrypted_extensions(we, msg, wire),
            ClientSm.WaitCertOrCrSm(inner) => on_cert_or_cr(inner, msg, wire),
            ClientSm.WaitCertSm(inner) => on_certificate(inner, msg, wire),
            ClientSm.WaitCertVerifySm(inner) => on_certificate_verify(inner, msg, wire),
            ClientSm.WaitFinishedSm(inner) => on_finished(inner, msg, wire),
            _ => Result.Err(TlsError.UnexpectedMessage),
        }
    }

    /// Feed a post-handshake message (RFC 8446 §4.6). Returns a
    /// `PostHandshakeOutcome` telling the caller what happened:
    ///  * `NewSession(session)` — store against the connection's
    ///  authority so the next connect can resume.
    ///  * `CertificateRequestReceived(cr)` — server asked the
    ///  client to authenticate (§4.6.2). Caller must build a
    ///  Certificate+CertificateVerify+Finished triplet if it
    ///  advertised `post_handshake_auth` in its ClientHello,
    ///  else it MUST abort with unexpected_message.
    ///  * `Ignored` — KeyUpdate / unknown post-handshake messages
    ///  are decoded but handled elsewhere (KeyUpdate is driven
    ///  by `keyschedule.rotate`, not this SM).
    ///

    /// Precondition: ClientSm is in `ConnectedSm`. Any other state
    /// is a protocol violation → returns UnexpectedMessage.
    public fn on_post_handshake(
        &self,
        wire: &[Byte],
        now: Instant,
    ) -> Result<PostHandshakeOutcome, TlsError> {
        match self {
            ClientSm.ConnectedSm(c) => {
                let mut r = Tls13HandshakeReader.new(wire);
                let msg = with_tls_error(decode_handshake(&mut r), TlsError.DecodeError)?;
                match msg {
                    HandshakeMessage.NewSessionTicketMsg(nst) => {
                        // Copy resumption_master bytes; the helper
                        // takes ownership so the connection keeps
                        // its own copy intact for subsequent tickets.
                        let established = c.state.get();
                        let slice = established.resumption_master.as_slice();
                        let mut rm_bytes: List<Byte> = [];
                        let mut i: Int = 0;
                        while i < slice.len() {
                            rm_bytes.push(slice[i]);
                            i = i + 1;
                        }
                        let session = client_session_from_nst(
                            &nst,
                            established.suite.clone(),
                            rm_bytes,
                            now,
                        );
                        Result.Ok(PostHandshakeOutcome.NewSession(session))
                    },
                    HandshakeMessage.CertificateRequestMsg(cr) => {
                        // §4.6.2 — the caller MUST have advertised
                        // `post_handshake_auth` in its ClientHello to
                        // legitimately receive this message. This SM
                        // surfaces the CR and lets the caller assemble
                        // the response; producing the cert-chain + sig
                        // lives in the application layer (it needs a
                        // client-certificate identity this library
                        // doesn't otherwise know about).
                        Result.Ok(PostHandshakeOutcome.CertificateRequestReceived(cr))
                    },
                    _ => Result.Ok(PostHandshakeOutcome.Ignored),
                }
            },
            _ => Result.Err(TlsError.UnexpectedMessage),
        }
    }
}

// =============================================================================
// PostHandshakeOutcome — what the SM extracted from one post-handshake record
// =============================================================================

public type PostHandshakeOutcome is
      NewSession(ClientSession)
    | CertificateRequestReceived(CertificateRequest)
    | Ignored;

// =============================================================================
// Transition handlers
// =============================================================================

fn on_server_hello(
    mut ws: WaitServerHello,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.HelloRetryRequestMsg(sh) => {
            if ws.retry_suite.is_some() {
                // Only one HRR per handshake (RFC 8446 §4.1.4).
                return Result.Err(TlsError.UnexpectedMessage);
            }
            validate_server_hello(&ws.config, &sh)?;
            ws.transcript = Transcript.new(sh.cipher_suite.hash_kind());
            ws.transcript.append(ws.first_hello.as_slice());
            ws.transcript.reseed_for_hrr();
            ws.transcript.append(wire);
            // Build a fresh ClientHello matching HRR-selected group.
            let new_ch = rebuild_client_hello_for_hrr(&ws.config, &sh)?;
            let new_msg = HandshakeMessage.ClientHelloMsg(new_ch);
            let mut out_wire: List<Byte> = [];
            with_tls_error(encode_handshake(&new_msg, &mut out_wire), TlsError.InternalError(Text.from("encode CH2 failed")))?;
            ws.transcript.append(out_wire.as_slice());
            let next = ClientSm.WaitServerHelloSm(WaitServerHello {
                config: ws.config, transcript: ws.transcript,
                first_hello: ws.first_hello, retry_suite: Maybe.Some(sh.cipher_suite), dhe_privs: ws.dhe_privs,
            });
            Result.Ok((next, StepOutput {
                outbound_handshake: out_wire,
                connected: Maybe.None,
            }))
        },

        HandshakeMessage.ServerHelloMsg(sh) => {
            // Validate downgrade sentinel.
            check_downgrade_sentinel(&sh.random)?;

            // Pick the negotiated version from supported_versions ext.
            let negotiated_ver = select_server_version(&sh.extensions)?;
            if !negotiated_ver.eq(&TLS_1_3) {
                return Result.Err(TlsError.ProtocolVersion);
            }

            // Cipher suite
            let suite = sh.cipher_suite.clone();
            validate_server_hello(&ws.config, &sh)?;
            if let Maybe.Some(previous) = &ws.retry_suite {
                if previous.to_u16() != suite.to_u16() { return Result.Err(TlsError.IllegalParameter); }
            }
            let hash = suite.hash_kind();

            // key_share from server — match against our keypair.
            let server_share = select_server_key_share(&sh.extensions)?;
            let dhe_priv = find_dhe_priv(&ws.dhe_privs, server_share.named_group())?;

            // Compute the DHE shared secret via core.security.ecc.* —
            // X25519 / secp256r1 / secp384r1 all dispatched below in
            // compute_dhe(). Returns an H-group-sized shared secret.
            let dhe_shared = compute_dhe(server_share.named_group(), dhe_priv.as_slice(), server_share.public_bytes())?;

            // Absorb SH into transcript.
            let mut transcript = ws.transcript;
            if ws.retry_suite.is_none() {
                transcript = Transcript.new(hash);
                transcript.append(ws.first_hello.as_slice());
            }
            transcript.append(wire);
            let transcript_after_sh = transcript.snapshot();

            // Derive Early → Handshake secrets.
            let early = with_tls_error(EarlySecret.derive_no_psk(hash), TlsError.InternalError(Text.from("early secret")))?;
            let derived = with_tls_error(early.to_handshake_input(), TlsError.InternalError(Text.from("derive handshake")))?;
            let handshake_secret = with_tls_error(HandshakeSecret.derive(hash, derived.as_slice(), dhe_shared.as_slice()), TlsError.InternalError(Text.from("handshake secret")))?;
            let client_hs = with_tls_error(handshake_secret.client_traffic(transcript_after_sh.as_slice()), TlsError.InternalError(Text.from("client hs traffic")))?;
            let server_hs = with_tls_error(handshake_secret.server_traffic(transcript_after_sh.as_slice()), TlsError.InternalError(Text.from("server hs traffic")))?;

            let next = ClientSm.WaitEncryptedExtensionsSm(WaitEncryptedExtensions {
                config: ws.config,
                transcript: transcript,
                chosen_suite: suite,
                hash: hash,
                handshake_secret: handshake_secret,
                client_hs_traffic: client_hs,
                server_hs_traffic: server_hs,
            });
            Result.Ok((next, StepOutput { outbound_handshake: [], connected: Maybe.None }))
        },

        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn on_encrypted_extensions(
    mut we: WaitEncryptedExtensions,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.EncryptedExtensionsMsg(ee) => {
            we.transcript.append(wire);
            // Validate: ALPN selection if we offered ALPN (§4.2.7).
            // We don't enforce here — caller inspects ee.extensions.
            let _ = ee;
            Result.Ok((ClientSm.WaitCertOrCrSm(WaitCertOrCr { inner: we }),
                StepOutput { outbound_handshake: [], connected: Maybe.None }))
        },
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn on_cert_or_cr(
    inner: WaitCertOrCr,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.CertificateRequestMsg(cr) => {
            let mut inside = inner.inner;
            inside.transcript.append(wire);
            Result.Ok((ClientSm.WaitCertSm(WaitCert { inner: inside, cert_request: Maybe.Some(cr) }),
                StepOutput { outbound_handshake: [], connected: Maybe.None }))
        },
        HandshakeMessage.CertificateMsg(cm) => {
            let mut inside = inner.inner;
            inside.transcript.append(wire);
            on_certificate_inner(inside, cm, Maybe.None)
        },
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn on_certificate(
    inner: WaitCert,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.CertificateMsg(cm) => {
            let mut inside = inner.inner;
            inside.transcript.append(wire);
            on_certificate_inner(inside, cm, inner.cert_request)
        },
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn on_certificate_inner(
    inside: WaitEncryptedExtensions,
    cm: CertificateMessage,
    cert_request: Maybe<CertificateRequest>,
) -> Result<(ClientSm, StepOutput), TlsError> {
    if !cm.certificate_request_context.is_empty() || cm.certificate_list.is_empty() {
        return Result.Err(TlsError.BadCertificate);
    }
    let ee_entry = &cm.certificate_list[0];
    let peer_cert = with_tls_error(parse_certificate(ee_entry.cert_data.as_slice()), TlsError.BadCertificate)?;

    let mut chain_der: List<List<Byte>> = [];
    let mut i: Int = 0;
    while i < cm.certificate_list.len() {
        chain_der.push(cm.certificate_list[i].cert_data.clone());
        i = i + 1;
    }

    Result.Ok((ClientSm.WaitCertVerifySm(WaitCertVerify {
        inner: inside,
        cert_request: cert_request,
        peer_certificate: peer_cert,
        peer_chain_der: chain_der,
    }), StepOutput { outbound_handshake: [], connected: Maybe.None }))
}

fn on_certificate_verify(
    inner: WaitCertVerify,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.CertificateVerifyMsg(cv) => {
            // Per RFC 8446 §4.4.3: verify signature over
            //  64 × 0x20 || "TLS 1.3, server CertificateVerify" || 0x00 ||
            //  Transcript-Hash(ClientHello..Certificate)
            let transcript_hash = inner.inner.transcript.snapshot();
            let signed_input = build_cert_verify_signed_input(
                transcript_hash.as_slice(),
                /* is_server = */ true,
            );
            let mut offered = false;
            for scheme in &inner.inner.config.sig_schemes {
                if scheme.to_u16() == cv.algorithm.to_u16() { offered = true; }
            }
            if !offered || !cv.algorithm.is_valid_for_certificate_verify() {
                return Result.Err(TlsError.IllegalParameter);
            }
            verify_certificate_signature(&inner.peer_certificate, &cv, signed_input.as_slice())?;
            let parsed_chain = parse_chain(&inner.peer_chain_der)?;
            let hostname = if inner.inner.config.verify_hostname {
                Maybe.Some(&inner.inner.config.server_name)
            } else { Maybe.None };
            match validate_chain(&parsed_chain, &inner.inner.config.trust, hostname, now_unix_s() as Int64) {
                Result.Ok(_) => {},
                Result.Err(e) => return Result.Err(map_chain_error(e)),
            }

            let mut inside = inner.inner;
            inside.transcript.append(wire);
            Result.Ok((ClientSm.WaitFinishedSm(WaitFinished {
                inner: inside,
                cert_request: inner.cert_request,
                peer_certificate: inner.peer_certificate,
            }), StepOutput { outbound_handshake: [], connected: Maybe.None }))
        },
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

fn on_finished(
    inner: WaitFinished,
    msg: HandshakeMessage,
    wire: &[Byte],
) -> Result<(ClientSm, StepOutput), TlsError> {
    match msg {
        HandshakeMessage.FinishedMsg(fin) => {
            // Verify server Finished = HMAC(finished_key_server,
            //  Transcript-Hash(ClientHello..CertificateVerify))
            let srv_fin_key = with_tls_error(inner.inner.server_hs_traffic.finished_key(), TlsError.InternalError(Text.from("server finished key")))?;
            let th = inner.inner.transcript.snapshot();
            let expected = hmac_for_hash(inner.inner.hash, srv_fin_key.as_slice(), th.as_slice());
            if !constant_time_bytes_eq(expected.as_slice(), fin.verify_data.as_slice()) {
                return Result.Err(TlsError.DecryptError);
            }

            let mut transcript = inner.inner.transcript;
            transcript.append(wire);

            // Derive application traffic secrets + exporter + resumption.
            let master_input = with_tls_error(inner.inner.handshake_secret.to_master_input(), TlsError.InternalError(Text.from("master input")))?;
            let master_secret = with_tls_error(MasterSecret.derive(inner.inner.hash, master_input.as_slice()), TlsError.InternalError(Text.from("master secret")))?;

            let transcript_after_sfin = transcript.snapshot();
            let client_ap = with_tls_error(master_secret.client_traffic(transcript_after_sfin.as_slice()), TlsError.InternalError(Text.from("client ap traffic")))?;
            let server_ap = with_tls_error(master_secret.server_traffic(transcript_after_sfin.as_slice()), TlsError.InternalError(Text.from("server ap traffic")))?;
            let exporter = with_tls_error(master_secret.exporter_master(transcript_after_sfin.as_slice()), TlsError.InternalError(Text.from("exporter master")))?;

            // Build client Finished = HMAC(finished_key_client, transcript-hash-so-far)
            let cli_fin_key = with_tls_error(inner.inner.client_hs_traffic.finished_key(), TlsError.InternalError(Text.from("client finished key")))?;
            let cli_fin_verify = hmac_for_hash(inner.inner.hash, cli_fin_key.as_slice(), transcript_after_sfin.as_slice());

            let cli_fin = HandshakeMessage.FinishedMsg(Finished { verify_data: cli_fin_verify });
            let mut out_wire: List<Byte> = [];
            with_tls_error(encode_handshake(&cli_fin, &mut out_wire), TlsError.InternalError(Text.from("encode CFin")))?;
            transcript.append(out_wire.as_slice());
            let transcript_after_cfin = transcript.snapshot();
            let resumption_master = with_tls_error(master_secret.resumption_master(transcript_after_cfin.as_slice()), TlsError.InternalError(Text.from("resumption master")))?;

            let connected = Connected { state: Shared.new(ConnectedData {
                config: inner.inner.config,
                suite:  inner.inner.chosen_suite,
                hash:   inner.inner.hash,
                master_secret:     master_secret,
                client_ap_traffic: client_ap,
                server_ap_traffic: server_ap,
                resumption_master: resumption_master,
                exporter_master:   exporter,
                peer_certificate:  inner.peer_certificate,
            }) };

            Result.Ok((ClientSm.ConnectedSm(connected.clone()),
                StepOutput { outbound_handshake: out_wire, connected: Maybe.Some(connected) }))
        },
        _ => Result.Err(TlsError.UnexpectedMessage),
    }
}

// =============================================================================
// Helpers
// =============================================================================

fn build_client_hello(config: &Tls13ClientConfig) -> ClientHello {
    let mut exts: List<Extension> = [];
    // server_name
    let mut names: List<ServerName> = [];
    names.push(ServerName { host_name: config.server_name.clone() });
    exts.push(Extension.ServerNameExt { names: names });
    // supported_versions
    let mut versions: List<ProtocolVersion> = [];
    versions.push(TLS_1_3);
    exts.push(Extension.SupportedVersionsClient { versions: versions });
    // supported_groups
    exts.push(Extension.SupportedGroupsExt { groups: config.groups.clone() });
    // signature_algorithms
    exts.push(Extension.SignatureAlgorithmsExt { schemes: config.sig_schemes.clone() });
    // key_share
    exts.push(Extension.KeyShareClient { shares: config.key_shares.clone() });
    // ALPN
    if config.alpn.len() > 0 {
        exts.push(Extension.AlpnExt { protocols: config.alpn.clone() });
    }

    ClientHello {
        legacy_version:      LEGACY_VERSION_TLS_1_2,
        random:              config.random,
        legacy_session_id:   [],  // empty per RFC 8446 (no middlebox compat optional)
        cipher_suites:       config.suites.clone(),
        legacy_compression_methods: [0_u8],
        extensions:          exts,
    }
}

fn rebuild_client_hello_for_hrr(
    config: &Tls13ClientConfig,
    sh: &ServerHello,
) -> Result<ClientHello, TlsError> {
    let mut cookie: Maybe<List<Byte>> = Maybe.None;
    for ext in &sh.extensions {
        match ext {
            // Every supported group already has a share in the initial hello.
            Extension.KeyShareHelloRetryRequest { .. } => return Result.Err(TlsError.IllegalParameter),
            Extension.CookieExt { cookie: received } => {
                if cookie.is_some() || received.is_empty() { return Result.Err(TlsError.IllegalParameter); }
                cookie = Maybe.Some(received.clone());
            },
            Extension.SupportedVersionsServer { .. } => {},
            _ => return Result.Err(TlsError.IllegalParameter),
        }
    }
    match cookie {
        Maybe.Some(bytes) => {
            let mut ch = build_client_hello(config);
            ch.extensions.push(Extension.CookieExt { cookie: bytes });
            Result.Ok(ch)
        },
        Maybe.None => Result.Err(TlsError.IllegalParameter),
    }
}

fn with_tls_error<T, E>(result: Result<T, E>, error: TlsError) -> Result<T, TlsError> {
    match result { Result.Ok(value) => Result.Ok(value), Result.Err(_) => Result.Err(error) }
}

fn decode_error(_error: CodecError) -> TlsError { TlsError.DecodeError }

fn validate_server_hello(config: &Tls13ClientConfig, sh: &ServerHello) -> Result<(), TlsError> {
    let selected = select_server_version(&sh.extensions)?;
    if sh.legacy_version.to_u16() != LEGACY_VERSION_TLS_1_2.to_u16()
        || sh.legacy_compression_method != 0_u8 || !sh.legacy_session_id_echo.is_empty()
        || selected.to_u16() != TLS_1_3.to_u16() {
        return Result.Err(TlsError.IllegalParameter);
    }
    let mut i: Int = 0;
    while i < config.suites.len() {
        if config.suites[i].to_u16() == sh.cipher_suite.to_u16() && sh.cipher_suite.is_supported() {
            return Result.Ok(());
        }
        i = i + 1;
    }
    Result.Err(TlsError.IllegalParameter)
}

fn check_downgrade_sentinel(random: &[Byte; 32]) -> Result<(), TlsError> {
    let tail_start = 32 - 8;
    let mut is_tls12_sentinel = true;
    let mut is_tls11_sentinel = true;
    let mut i: Int = 0;
    while i < 8 {
        if random[tail_start + i] != DOWNGRADE_SENTINEL_TLS12[i] { is_tls12_sentinel = false; }
        if random[tail_start + i] != DOWNGRADE_SENTINEL_TLS11[i] { is_tls11_sentinel = false; }
        i = i + 1;
    }
    if is_tls12_sentinel || is_tls11_sentinel {
        return Result.Err(TlsError.ProtocolVersion);
    }
    Result.Ok(())
}

fn select_server_version(exts: &List<Extension>) -> Result<ProtocolVersion, TlsError> {
    let mut i: Int = 0;
    while i < exts.len() {
        match &exts[i] {
            Extension.SupportedVersionsServer { selected } => return Result.Ok(selected.clone()),
            _ => {},
        }
        i = i + 1;
    }
    Result.Err(TlsError.MissingExtension)
}

fn select_server_key_share(exts: &List<Extension>) -> Result<KeyShareEntry, TlsError> {
    let mut i: Int = 0;
    while i < exts.len() {
        match &exts[i] {
            Extension.KeyShareServer { share } => return Result.Ok(share.clone()),
            _ => {},
        }
        i = i + 1;
    }
    Result.Err(TlsError.MissingExtension)
}

fn find_dhe_priv(privs: &List<(NamedGroup, List<Byte>)>, g: &NamedGroup) -> Result<List<Byte>, TlsError> {
    let mut i: Int = 0;
    while i < privs.len() {
        let (gk, v) = &privs[i];
        if gk.to_u16() == g.to_u16() { return Result.Ok(v.clone()); }
        i = i + 1;
    }
    Result.Err(TlsError.IllegalParameter)
}

/// Compute the (EC)DHE shared secret for the negotiated group.
/// Dispatches to core.security.ecc.{x25519, p256} and converts all-
/// zero / invalid-point outcomes into TlsError.IllegalParameter per
/// RFC 8446 §7.4.2 ("Peers MUST validate each other's public key
/// ... [and] abort with a fatal illegal_parameter if the [KA]
/// output is the all-zero value").
///

/// `priv_bytes` is the raw private-key bytes this client produced
/// for the matching KeyShareEntry (stored in the WaitServerHello
/// state's `dhe_privs` table).
/// `peer_pub_bytes` is ServerHello.key_share's key_exchange field.
fn compute_dhe(
    group: &NamedGroup,
    priv_bytes: &[Byte],
    peer_pub_bytes: &[Byte],
) -> Result<List<Byte>, TlsError> {
    match group {
        NamedGroup.X25519 => {
            if priv_bytes.len() != 32 || peer_pub_bytes.len() != 32 {
                return Result.Err(TlsError.IllegalParameter);
            }
            let mut sk_raw: [Byte; 32] = [0_u8; 32];
            let mut pk_raw: [Byte; 32] = [0_u8; 32];
            let mut i: Int = 0;
            while i < 32 {
                sk_raw[i] = priv_bytes[i];
                pk_raw[i] = peer_pub_bytes[i];
                i = i + 1;
            }
            let sk = X25519.secret_key_from_bytes(&sk_raw);
            match X25519.diffie_hellman(&sk, &pk_raw) {
                Result.Ok(shared) => {
                    let mut out: List<Byte> = List.with_capacity(32);
                    out.extend_from_slice(&shared[..]);
                    Result.Ok(out)
                },
                Result.Err(_) => Result.Err(TlsError.IllegalParameter),
            }
        },

        NamedGroup.Secp256r1 => {
            // Private half is a 32-byte scalar; public half is an
            // uncompressed 65-byte point (0x04 || X || Y).
            if priv_bytes.len() != 32 {
                return Result.Err(TlsError.IllegalParameter);
            }
            let mut sk_raw: [Byte; 32] = [0_u8; 32];
            let mut i: Int = 0;
            while i < 32 { sk_raw[i] = priv_bytes[i]; i = i + 1; }
            let sk = with_tls_error(P256.private_key_from_bytes(&sk_raw), TlsError.IllegalParameter)?;
            let pk = with_tls_error(P256.public_key_from_bytes(peer_pub_bytes), TlsError.IllegalParameter)?;
            match P256.ecdh(&sk, &pk) {
                Result.Ok(shared) => {
                    // P256SharedSecret is a [Byte; 32] — same shape as X25519.
                    let mut out: List<Byte> = List.with_capacity(32);
                    out.extend_from_slice(&shared[..]);
                    Result.Ok(out)
                },
                Result.Err(_) => Result.Err(TlsError.IllegalParameter),
            }
        },

        // P-384 / P-521 / X448 — not in v1 (spec §1.1). These groups
        // should never be selected if Tls13ClientConfig.groups was built
        // via default_offer_list.
        _ => Result.Err(TlsError.IllegalParameter),
    }
}

fn build_cert_verify_signed_input(transcript_hash: &[Byte], is_server: Bool) -> List<Byte> {
    let ctx: &[Byte] = if is_server {
        b"TLS 1.3, server CertificateVerify"
    } else {
        b"TLS 1.3, client CertificateVerify"
    };
    let mut out: List<Byte> = List.with_capacity(64 + ctx.len() + 1 + transcript_hash.len());
    // 64 × 0x20 space pad
    let mut i: Int = 0;
    while i < 64 { out.push(0x20_u8); i = i + 1; }
    out.extend_from_slice(ctx);
    out.push(0_u8);
    out.extend_from_slice(transcript_hash);
    out
}

fn verify_certificate_signature(
    cert: &X509Certificate,
    cv: &CertificateVerify,
    signed: &[Byte],
) -> Result<(), TlsError> {
    let algorithm = match cv.algorithm {
        SignatureScheme.Ed25519Scheme => SignatureAlg.Ed25519Sig,
        SignatureScheme.EcdsaSecp256r1Sha256 => SignatureAlg.EcdsaWithSha256,
        SignatureScheme.RsaPssRsaeSha256 =>
            SignatureAlg.RsaPss(RsaPssParams.digest_length_salt(RsaPssHash.Sha256Hash)),
        SignatureScheme.RsaPssRsaeSha384 =>
            SignatureAlg.RsaPss(RsaPssParams.digest_length_salt(RsaPssHash.Sha384Hash)),
        SignatureScheme.RsaPssRsaeSha512 =>
            SignatureAlg.RsaPss(RsaPssParams.digest_length_salt(RsaPssHash.Sha512Hash)),
        // The X.509 decoder currently recognizes RSAE public keys. A PSS-only
        // scheme requires an id-RSASSA-PSS key with compatible parameters.
        _ => return Result.Err(TlsError.UnsupportedCertificate),
    };
    match verify_subject_signature(cert, &algorithm, signed, cv.signature.as_slice()) {
        Result.Ok(()) => Result.Ok(()),
        Result.Err(ChainError.BadSignature(_)) => Result.Err(TlsError.DecryptError),
        Result.Err(_) => Result.Err(TlsError.BadCertificate),
    }
}

fn parse_chain(der: &List<List<Byte>>) -> Result<List<X509Certificate>, TlsError> {
    let mut out: List<X509Certificate> = [];
    let mut i: Int = 0;
    while i < der.len() {
        let c = with_tls_error(parse_certificate(der[i].as_slice()), TlsError.BadCertificate)?;
        out.push(c);
        i = i + 1;
    }
    Result.Ok(out)
}

fn map_chain_error(e: ChainError) -> TlsError {
    match e {
        ChainError.EmptyChain | ChainError.ChainTooLong { .. } => TlsError.BadCertificate,
        ChainError.UnknownIssuer => TlsError.UnknownCa,
        ChainError.IssuerSubjectMismatch(_) => TlsError.BadCertificate,
        ChainError.NotYetValid(_) => TlsError.CertificateExpired,
        ChainError.Expired(_) => TlsError.CertificateExpired,
        ChainError.BadSignature(_) => TlsError.BadCertificate,
        ChainError.NonCaIssuer(_) => TlsError.BadCertificate,
        ChainError.NoKeyCertSign(_) => TlsError.BadCertificate,
        ChainError.PathLenExceeded => TlsError.BadCertificate,
        ChainError.HostnameMismatch => TlsError.BadCertificate,
        ChainError.NameConstraintViolation => TlsError.BadCertificate,
        ChainError.EkuMismatch => TlsError.UnsupportedCertificate,
        ChainError.UnsupportedAlgorithm(_) => TlsError.UnsupportedCertificate,
    }
}

fn hmac_for_hash(hash: HashKind, key: &[Byte], msg: &[Byte]) -> List<Byte> {
    match hash {
        HashKind.Sha256 => {
            let mut mac = HmacSha256.new(key);
            mac.update(msg);
            List.from_slice(&mac.finalize()[..])
        },
        HashKind.Sha384 => {
            let mut mac = HmacSha384.new(key);
            mac.update(msg);
            List.from_slice(&mac.finalize()[..])
        },
    }
}

/// Local alias retained for call-site readability — all callers now
/// dispatch to `core.subtle.constant_time.constant_time_eq`
/// which is the single audited implementation (spec §8.2).
fn constant_time_bytes_eq(a: &[Byte], b: &[Byte]) -> Bool {
    constant_time_eq(a, b)
}
