// =============================================================================
// core/net/resolve.vr — hostname resolution to socket addresses
// =============================================================================
// Layer: 5 (network client)
// Dependencies: core, core.net.addr, core.net.dns, core.io
// =============================================================================
//

// Numeric endpoint parsing belongs to core.net.addr. This module additionally
// resolves hostnames for network clients.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.resolve;

mount core.collections.list.{List};
mount core.io.{IoError, IoErrorKind};
mount core.net.addr.{SocketAddr, Ipv4Addr, Ipv6Addr};
mount core.net.dns.{resolve as dns_resolve};

/// Resolve an endpoint into candidate addresses in connection-attempt order.
public type ToSocketAddrs is protocol {
    fn to_socket_addrs(&self) -> Result<List<SocketAddr>, IoError>;
};

fn resolve_host(host: &Text, port: Int) -> Result<List<SocketAddr>, IoError> {
    if port < 0 || port > 65535 {
        return Result.Err(IoError.with_message(IoErrorKind.InvalidInput, f"Port out of range: {port}"));
    }
    if host.is_empty() {
        return Result.Err(IoError.with_message(IoErrorKind.InvalidInput, "Missing host"));
    }
    if host.starts_with("[") {
        if host.ends_with("]") {
            let literal = host.slice(1, host.len() - 1);
            if let Result.Ok(ip) = Ipv6Addr.parse(&literal) {
                return Result.Ok([SocketAddr.new_v6(ip, port)]);
            }
        }
        return Result.Err(IoError.with_message(IoErrorKind.InvalidInput, f"Invalid IPv6 address: {host}"));
    }
    if let Result.Ok(ip) = Ipv4Addr.parse(host) {
        return Result.Ok([SocketAddr.new_v4(ip, port)]);
    }
    if let Result.Ok(ip) = Ipv6Addr.parse(host) {
        return Result.Ok([SocketAddr.new_v6(ip, port)]);
    }
    if host.contains(":") || host.contains("[") || host.contains("]") {
        return Result.Err(IoError.with_message(IoErrorKind.InvalidInput, f"Invalid host: {host}"));
    }

    match dns_resolve(host, port) {
        Result.Ok(addrs) if addrs.is_empty() =>
            Result.Err(IoError.with_message(IoErrorKind.NotFound, f"Cannot resolve: {host}")),
        Result.Ok(addrs) => Result.Ok(addrs),
        Result.Err(error) =>
            Result.Err(IoError.with_message(IoErrorKind.NotFound, f"Cannot resolve {host}: {error}")),
    }
}

implement ToSocketAddrs for (&Text, Int) {
    fn to_socket_addrs(&self) -> Result<List<SocketAddr>, IoError> {
        let (host, port) = *self;
        resolve_host(host, port)
    }
}

/// Accept a numeric socket address or a hostname with an explicit port.
implement ToSocketAddrs for Text {
    fn to_socket_addrs(&self) -> Result<List<SocketAddr>, IoError> {
        match self.rsplit_once(":") {
            Maybe.Some((host, port_str)) => {
                let port = match port_str.parse_int() {
                    Result.Ok(p) => p,
                    Result.Err(_) => return Result.Err(IoError.with_message(IoErrorKind.InvalidInput, f"Invalid port: {port_str}")),
                };
                resolve_host(&host, port)
            },
            Maybe.None => Result.Err(IoError.with_message(IoErrorKind.InvalidInput, f"Invalid address (missing port): {self}")),
        }
    }
}

implement ToSocketAddrs for SocketAddr {
    fn to_socket_addrs(&self) -> Result<List<SocketAddr>, IoError> {
        Result.Ok([*self])
    }
}
