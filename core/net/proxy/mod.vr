// =============================================================================
// core/net/proxy/mod.vr — L7 reverse-proxy toolkit
// =============================================================================
// Layer: 6 (Weft)
// Spec: net-framework spec §6, §9.3
// =============================================================================
//

// Building blocks for proxy / API-gateway servers. Sits on top of Weft
// Service/Layer; each piece is usable in isolation for non-proxy
// workloads (e.g. the circuit breaker can wrap a DB driver).
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.net.proxy;

public mount .upstream_pool.*;
public mount .health_check.*;
public mount .loadbalancer.*;
public mount .circuit_breaker.*;
public mount .retry.*;
public mount .rate_limit.*;
