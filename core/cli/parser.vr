// =============================================================================
// cli/parser.vr — argv tokenizer + recursive-descent parser
// =============================================================================
// Layer: 5 (CLI)
// Dependencies: core, text, cli.spec, cli.error, cli.types
// Spec: cli-framework spec §5
// =============================================================================
//

// `parse_argv` walks an argv vector against a `CommandSpec` and produces
// a `ParseOutcome` — the matched (sub)command, every captured flag, every
// captured arg, and any non-fatal diagnostics. Fatal errors short-circuit
// to `Result.Err(ParseError)` but we still accumulate the full diagnostic list
// when possible (multi-error mode — clig.dev §errors).
//

// The parser is GNU-getopt-compatible:
//   --long value      // long flag with separate value token
//   --long=value      // long flag with attached value
//   -s value          // short with separate value
//   -svalue           // short with attached value (when arity > 0)
//   -abc              // bundled switches (when each is arity 0)
//   --                // end-of-options sentinel
//   -                 // bare dash is positional (stdin/stdout convention)
//   --no-foo          // negation of `--foo` (when negatable=true)
//
// Topic separator (oclif-style colon) is supported via
// `CommandSettings.topic_separator`.
//
// ParseOutcome captures values as Text — the `runtime` layer converts
// to typed values via `FromArg` after parsing succeeds. This separation
// keeps the parser pure and stateless wrt the user's type system.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.cli.parser;

mount core.base.{Maybe, Result};
mount core.base.protocols.Default;
mount core.collections.{List, Map, Set};
mount core.text.Text;
mount core.cli.spec.{
    CommandSpec, ArgSpec, FlagSpec, GroupKind, Arity,
    TopicSeparator, CommandSettings,
};
mount core.cli.error.{ParseError, ParseErrorKind, ParseDiagnostic};

// =============================================================================
// Captured values
// =============================================================================

/// A captured flag value as raw Text (typing happens in runtime layer).
public type CapturedFlag is {
    /// All values captured for this flag (length matches arity).
    /// For switches (arity Exactly(0)) this is empty and the count reflects occurrences.
    public(in core.cli) values:  List<Text>,
    /// Number of times the flag appeared (for counter / repeated tracking).
    public(in core.cli) occurrences: Int,
};

implement Default for CapturedFlag {
    fn default() -> CapturedFlag {
        CapturedFlag { values: List.new(), occurrences: 0 }
    }
}

/// A captured positional argument.
public type CapturedArg is {
    public(in core.cli) name:   Text,            // declared arg-spec name
    public(in core.cli) values: List<Text>,
};

/// Outcome of parsing argv against a CommandSpec.
public type ParseOutcome is {
    /// Sequence of subcommand names traversed, root-first.
    /// Example: argv `app deploy prod --env=staging` → ["app", "deploy", "prod"].
    public(in core.cli) command_path: List<Text>,
    /// Flags captured at every level along the path. Persistent flags appear
    /// at the level they were declared; non-persistent at the level they
    /// were given.
    public(in core.cli) flags:        Map<Text, CapturedFlag>,
    /// Positional arguments captured at the leaf command.
    public(in core.cli) args:         List<CapturedArg>,
    /// Argv tokens after `--` (passed verbatim to the leaf handler).
    public(in core.cli) trailing:     List<Text>,
    /// Non-fatal diagnostics gathered during recovery.
    public(in core.cli) warnings:     List<ParseError>,
    /// Whether help / version flag was seen — runtime short-circuits dispatch.
    public(in core.cli) help_requested:    Bool,
    public(in core.cli) version_requested: Bool,
};

// =============================================================================
// ParseState — internal cursor over argv
// =============================================================================

/// Stateful cursor over argv. Construction is done by `parse_argv`;
/// users typically don't touch this directly.
public type ParseState is {
    argv:   List<Text>,
    cursor: Int,
    /// Whether we've crossed `--` (everything after is positional).
    after_double_dash: Bool,
};

implement ParseState {
    public fn new(argv: List<Text>) -> ParseState {
        ParseState { argv: argv, cursor: 0, after_double_dash: false }
    }

    @inline
    fn at_end(&self) -> Bool { self.cursor >= self.argv.len() }

    @inline
    fn peek(&self) -> Maybe<&Text> {
        if self.at_end() { Maybe.None } else { Maybe.Some(&self.argv[self.cursor]) }
    }

    @inline
    fn advance(&mut self) -> Maybe<Text> {
        if self.at_end() { Maybe.None } else {
            let tok = self.argv[self.cursor].clone();
            self.cursor = self.cursor + 1;
            Maybe.Some(tok)
        }
    }
}

// =============================================================================
// Token classification
// =============================================================================

/// Lexical class of an argv token.
type TokenKind is
    | TLong(Text, Maybe<Text>)   // (name, optional attached value)
    | TShort(Text)               // raw bytes after single dash, e.g. "vvv" or "p8080"
    | TDoubleDash                // standalone "--"
    | TPositional(Text);         // bare token

/// Classify a single argv token. Numbers like `-1` are positional iff
/// `allow_negative_numbers = true` AND they parse as numbers.
fn classify(tok: Text, settings: &CommandSettings) -> TokenKind {
    let dd = Text.from("--");
    let dash = Text.from("-");
    if tok == dd { return TokenKind.TDoubleDash; }
    if tok.len() < 2 || !tok.starts_with(&dash) {
        return TokenKind.TPositional(tok);
    }

    // Long flag --name[=value]
    if tok.starts_with(&dd) {
        let (name, value) = split_long_option(&tok);
        TokenKind.TLong(name, value)
    } else {
        // Short flag(s): -abc, -p8080, -1 (negative number)
        if settings.allow_negative_numbers && looks_like_number(&tok) {
            return TokenKind.TPositional(tok);
        }
        TokenKind.TShort(tok.slice(1, tok.len()))
    }
}

/// Split a long option after its two leading dashes. An empty value after
/// the first equals sign is still an explicit value.
fn split_long_option(token: &Text) -> (Text, Maybe<Text>) {
    let body = token.slice(2, token.len());
    match body.find(&"=") {
        Maybe.Some(index) => (body.slice(0, index), Maybe.Some(body.slice(index + 1, body.len()))),
        Maybe.None => (body, Maybe.None),
    }
}

fn looks_like_number(s: &Text) -> Bool {
    if s.len() < 2 { return false; }
    let dash = Text.from("-");
    if !s.starts_with(&dash) { return false; }
    let rest = s.slice(1, s.len());
    let mut i: Int = 0;
    let mut saw_digit = false;
    let mut saw_dot = false;
    while i < rest.len() {
        match rest.byte_at(i) {
            Maybe.Some(c) => {
                if c >= b'0' && c <= b'9' {
                    saw_digit = true;
                } else if c == b'.' && !saw_dot {
                    saw_dot = true;
                } else {
                    return false;
                }
            },
            Maybe.None => return false,
        }
        i = i + 1;
    }
    saw_digit
}

// =============================================================================
// Top-level parser
// =============================================================================

/// Parse argv against a root CommandSpec. The first argv token (program
/// name) is consumed regardless of its spelling. The command path uses
/// the declared names of the root and each selected subcommand.
public fn parse_argv(
    root: &CommandSpec,
    argv: List<Text>,
) -> Result<ParseOutcome, ParseError> {
    let mut state = ParseState.new(argv);

    // Skip argv[0] (program name).
    state.advance();

    let mut outcome = ParseOutcome {
        command_path: List.new(),
        flags: Map.new(),
        args: List.new(),
        trailing: List.new(),
        warnings: List.new(),
        help_requested: false,
        version_requested: false,
    };

    outcome.command_path.push(root.name.clone());
    parse_command(root, &mut state, &mut outcome)?;
    Result.Ok(outcome)
}

/// Follow subcommands as their tokens are consumed. Only the selected leaf
/// enforces required arguments, flags and groups.
fn parse_command(
    root: &CommandSpec,
    state: &mut ParseState,
    outcome: &mut ParseOutcome,
) -> Result<Unit, ParseError> {
    let mut cmd: &CommandSpec = root;
    let mut positional_idx: Int = 0;

    while !state.at_end() {
        let tok = state.advance().unwrap();
        if state.after_double_dash {
            outcome.trailing.push(tok);
            continue;
        }

        match classify(tok, &cmd.settings) {
            TokenKind.TDoubleDash => {
                state.after_double_dash = true;
            },
            TokenKind.TLong(name, attached) => {
                handle_long(cmd, &name, attached, state, outcome)?;
            },
            TokenKind.TShort(body) => {
                handle_short(cmd, &body, state, outcome)?;
            },
            TokenKind.TPositional(tok_text) => {
                // Possible subcommand?
                if positional_idx == 0 {
                    match cmd.subcommand_index(&tok_text) {
                        Maybe.Some(i) => {
                            cmd = &cmd.subcommands[i];
                            outcome.command_path.push(cmd.name.clone());
                            continue;
                        },
                        Maybe.None => {},
                    }
                }
                handle_positional(cmd, &tok_text, &mut positional_idx, outcome)?;
            },
        }
    }

    // Check required-arg satisfaction at this leaf.
    let mut i: Int = 0;
    while i < cmd.args.len() {
        let a = &cmd.args[i];
        if a.arity.is_required() {
            let captured = captured_arg_index(&outcome.args, &a.name);
            match captured {
                Maybe.Some(_) => {},
                Maybe.None => return Result.Err(ParseError.missing_required(a.name.clone())),
            }
        }
        i = i + 1;
    }

    // Check required flags.
    let mut j: Int = 0;
    while j < cmd.flags.len() {
        let f = &cmd.flags[j];
        if f.arity.is_required() {
            let key = flag_key(f);
            if outcome.flags.get_key_value(&key) is Maybe.None {
                return Result.Err(ParseError.missing_required(key));
            }
        }
        j = j + 1;
    }

    // Check group constraints.
    check_groups(cmd, outcome)?;

    // Subcommand-required guard.
    if cmd.settings.subcommand_required && cmd.subcommands.len() > 0 {
        return Result.Err(ParseError.bare(
            ParseErrorKind.MissingRequired,
            Text.from(f"command '{cmd.name}' requires a subcommand"),
        ));
    }

    Result.Ok(())
}

// =============================================================================
// Long flags
// =============================================================================

fn handle_long(
    cmd: &CommandSpec,
    name: &Text,
    attached: Maybe<Text>,
    state: &mut ParseState,
    outcome: &mut ParseOutcome,
) -> Result<Unit, ParseError> {
    // Built-in --help / --version short-circuits.
    let help_t = Text.from("help");
    let version_t = Text.from("version");
    let no_prefix = Text.from("no-");
    if !cmd.settings.disable_help_flag && name == &help_t {
        outcome.help_requested = true;
        return Result.Ok(());
    }
    if !cmd.settings.disable_version_flag && name == &version_t {
        outcome.version_requested = true;
        return Result.Ok(());
    }

    // Negation: --no-foo when foo.negatable = true.
    if name.starts_with(&no_prefix) {
        let positive_name = name.slice(3, name.len());
        match cmd.find_flag_long(&positive_name) {
            Maybe.Some(f) => if f.is_negatable() {
                let key = flag_key(f);
                let cap = CapturedFlag {
                    values: { let mut v: List<Text> = List.new(); v.push(Text.from("false")); v },
                    occurrences: 1,
                };
                outcome.flags.insert(key, cap);
                return Result.Ok(());
            },
            Maybe.None => {},
        }
    }

    let f = match cmd.find_flag_long(name) {
        Maybe.Some(f) => f,
        Maybe.None => {
            return Result.Err(
                ParseError.unknown_flag(Text.from(f"--{name}"), &cmd.long_names())
                    .with_see_help(cmd.name.clone())
            );
        },
    };

    capture_flag(f, attached, state, outcome)
}

// =============================================================================
// Short flags (single + bundled + value-attached)
// =============================================================================

fn handle_short(
    cmd: &CommandSpec,
    body: &Text,
    state: &mut ParseState,
    outcome: &mut ParseOutcome,
) -> Result<Unit, ParseError> {
    if body.len() == 0 {
        return Result.Err(ParseError.bare(
            ParseErrorKind.UnknownFlag,
            Text.from("empty short flag"),
        ));
    }

    let mut i: Int = 0;
    while i < body.len() {
        let ch = match body.char_at(i) {
            Maybe.Some(c) => c,
            Maybe.None => return Result.Ok(()),
        };

        let next = i + ch.len_utf8();

        // Built-in -h / -V.
        if !cmd.settings.disable_help_flag && ch == 'h' {
            outcome.help_requested = true;
            return Result.Ok(());
        }
        if !cmd.settings.disable_version_flag && ch == 'V' {
            outcome.version_requested = true;
            return Result.Ok(());
        }

        let f = match cmd.find_flag_short(ch) {
            Maybe.Some(f) => f,
            Maybe.None => {
                return Result.Err(
                    ParseError.unknown_flag(Text.from(f"-{ch}"), &cmd.long_names())
                        .with_see_help(cmd.name.clone())
                );
            },
        };

        if f.arity.is_switch() {
            // Switch — record presence and continue with rest of bundle.
            let key = flag_key(f);
            increment_capture(&mut outcome.flags, key);
            i = next;
            continue;
        }

        // Value-bearing short: rest of body is the attached value, if non-empty.
        let rest = if next < body.len() {
            Maybe.Some(body.slice(next, body.len()))
        } else {
            Maybe.None
        };
        return capture_flag(f, rest, state, outcome);
    }
    Result.Ok(())
}

// =============================================================================
// Generic flag-capture machinery
// =============================================================================

fn capture_flag(
    f: &FlagSpec,
    attached: Maybe<Text>,
    state: &mut ParseState,
    outcome: &mut ParseOutcome,
) -> Result<Unit, ParseError> {
    let key = flag_key(f);

    if f.arity.is_switch() {
        increment_capture(&mut outcome.flags, key);
        return Result.Ok(());
    }

    // Determine how many values to consume.
    let lower = f.arity.lower_bound();
    let upper_opt = f.arity.upper_bound();

    let mut values: List<Text> = List.new();

    // An attached value is part of the flag itself.
    match attached {
        Maybe.Some(v) => values.push(v),
        Maybe.None => {},
    }

    let dash = Text.from("-");
    while !state.at_end() {
        match upper_opt {
            Maybe.Some(hi) => if values.len() >= hi { break; },
            Maybe.None => {},
        }
        // A required first value may itself begin with a dash.
        let starts_option = match state.peek() {
            Maybe.Some(t) => t.starts_with(&dash) && t != &dash,
            Maybe.None => false,
        };
        if starts_option && (lower == 0 || !values.is_empty()) { break; }
        values.push(state.advance().unwrap());
    }

    let took = values.len();
    if took == 0 && lower > 0 { return Result.Err(ParseError.missing_value(key)); }
    if took < lower {
        return Result.Err(ParseError.bare(
            ParseErrorKind.TooFewValues,
            Text.from(f"flag '{key}' requires at least {lower} values, got {took}"),
        ));
    }

    let stored = outcome.flags.entry(key).or_default();
    if stored.occurrences > 0 && !f.is_repeated() && !f.is_counter() {
        return Result.Err(ParseError.duplicate_flag(flag_key(f)));
    }
    stored.values.append(&mut values);
    stored.occurrences += 1;
    Result.Ok(())
}

fn flag_key(f: &FlagSpec) -> Text {
    match &f.long {
        Maybe.Some(long) => long.clone(),
        Maybe.None => match f.short {
            Maybe.Some(c) => Text.from(f"{c}"),
            Maybe.None => Text.from("?"),
        },
    }
}

fn increment_capture(flags: &mut Map<Text, CapturedFlag>, key: Text) {
    let stored = flags.entry(key).or_default();
    stored.occurrences += 1;
}

// =============================================================================
// Positional arguments
// =============================================================================

fn handle_positional(
    cmd: &CommandSpec,
    tok: &Text,
    pos_idx: &mut Int,
    outcome: &mut ParseOutcome,
) -> Result<Unit, ParseError> {
    if *pos_idx >= cmd.args.len() {
        // No matching arg-slot — surface as TooManyValues unless trailing
        // positional is variadic.
        if cmd.args.len() > 0 {
            let last = &cmd.args[cmd.args.len() - 1];
            if matches_unlimited(last) {
                push_arg_value(outcome, &last.name, tok.clone());
                return Result.Ok(());
            }
        }
        return Result.Err(ParseError.bare(
            ParseErrorKind.TooManyValues,
            Text.from(f"unexpected positional argument '{tok}'"),
        ));
    }

    let a = &cmd.args[*pos_idx];
    push_arg_value(outcome, &a.name, tok.clone());

    // Advance pos_idx unless this slot is variadic.
    if !matches_unlimited(a) {
        *pos_idx = *pos_idx + 1;
    }
    Result.Ok(())
}

fn matches_unlimited(a: &ArgSpec) -> Bool {
    match a.arity {
        Arity.Unlimited => true,
        Arity.AtLeast(_) => true,
        _ => false,
    }
}

fn push_arg_value(outcome: &mut ParseOutcome, name: &Text, value: Text) {
    match captured_arg_index(&outcome.args, name) {
        Maybe.Some(idx) => outcome.args[idx].values.push(value),
        Maybe.None => {
            let mut new_arg = CapturedArg { name: name.clone(), values: List.new() };
            new_arg.values.push(value);
            outcome.args.push(new_arg);
        },
    }
}

fn captured_arg_index(args: &List<CapturedArg>, name: &Text) -> Maybe<Int> {
    let mut i: Int = 0;
    while i < args.len() {
        if &args[i].name == name { return Maybe.Some(i); }
        i = i + 1;
    }
    Maybe.None
}

// =============================================================================
// Group constraint checking
// =============================================================================

fn check_groups(cmd: &CommandSpec, outcome: &ParseOutcome) -> Result<Unit, ParseError> {
    let mut i: Int = 0;
    while i < cmd.groups.len() {
        let g = &cmd.groups[i];
        let present_count = count_present(&g.members, &outcome.flags);

        match g.kind {
            GroupKind.Exclusive => {
                if present_count > 1 {
                    return Result.Err(ParseError.mutex_conflict(g.name.clone(), g.members.clone()));
                }
            },
            GroupKind.Required => {
                if present_count != 1 {
                    return Result.Err(ParseError.mutex_conflict(g.name.clone(), g.members.clone()));
                }
            },
            GroupKind.RequiredAll => {
                if present_count != g.members.len() {
                    return Result.Err(ParseError.bare(
                        ParseErrorKind.MissingRequired,
                        Text.from(f"all members of group '{g.name}' are required"),
                    ));
                }
            },
            GroupKind.OptionalAll => {
                if present_count != 0 && present_count != g.members.len() {
                    return Result.Err(ParseError.bare(
                        ParseErrorKind.RequiresMissing,
                        Text.from(
                            f"group '{g.name}' is all-or-nothing: \
                              specify all members or none"
                        ),
                    ));
                }
            },
        }
        i = i + 1;
    }
    Result.Ok(())
}

fn count_present(members: &List<Text>, flags: &Map<Text, CapturedFlag>) -> Int {
    let mut n: Int = 0;
    let mut i: Int = 0;
    while i < members.len() {
        if flags.get_key_value(&members[i]) is Maybe.Some(_) { n = n + 1; }
        i = i + 1;
    }
    n
}

// =============================================================================
// Parser<A> protocol — composable combinator surface (spec §3.3)
// =============================================================================
//
// The `Parser<A>` protocol describes a stateful parser that consumes
// part of a `ParseState` and returns either a parsed `A` or a
// `ParseError`. Concrete combinators (`arg`, `flag`, `many`, etc.)
// build small parsers that the runtime composes into the parse tree.
//
// Phase 0 ships only the protocol + the `ArgParser` / `FlagParser`
// adapters that wrap a single `ArgSpec` / `FlagSpec`. The `parse_argv`
// driver above is the production path; combinator-driven parsers are
// for tooling that needs to reason about partial parses (linters,
// REPL completion, structured-input adapters).
//

/// A description of what a parser consumes — used by the help renderer
/// when the parser is built combinator-style instead of derived from a
/// spec tree.
public type ParserDescription is {
    /// Human-readable label (e.g. "<PORT>", "--verbose").
    label:    Text,
    /// One-line help string.
    help:     Text,
    /// Category hint for completion / placeholder rendering.
    kind:     Text,
};

/// A parser of `A` values. Implementations consume part of `state.argv`
/// starting at `state.cursor` and return either a parsed value or an
/// error explaining why the consumption failed.
public type Parser<A> is protocol {
    fn parse(&self, state: &mut ParseState) -> Result<A, ParseError>;
    fn describe(&self) -> ParserDescription;
}

// -----------------------------------------------------------------------------
// ArgParser — wraps a single ArgSpec for combinator-mode use
// -----------------------------------------------------------------------------

public type ArgParser is {
    spec: ArgSpec,
};

implement Parser<Text> for ArgParser {
    fn parse(&self, state: &mut ParseState) -> Result<Text, ParseError> {
        match state.advance() {
            Maybe.Some(tok) => Result.Ok(tok),
            Maybe.None => Result.Err(ParseError.missing_required(self.spec.name.clone())),
        }
    }

    fn describe(&self) -> ParserDescription {
        ParserDescription {
            label: self.spec.name.clone(),
            help: self.spec.help.clone(),
            kind: self.spec.kind_hint.clone(),
        }
    }
}

/// Build an `ArgParser` from an `ArgSpec`.
public fn arg(spec: ArgSpec) -> ArgParser {
    ArgParser { spec: spec }
}

// -----------------------------------------------------------------------------
// FlagParser — wraps a FlagSpec
// -----------------------------------------------------------------------------

public type FlagParser is {
    spec: FlagSpec,
};

implement Parser<Maybe<Text>> for FlagParser {
    fn parse(&self, state: &mut ParseState) -> Result<Maybe<Text>, ParseError> {
        let (name, attached) = match state.peek() {
            Maybe.Some(token) if token.len() > 2 && token.starts_with(&"--") => split_long_option(token),
            _ => return Result.Ok(Maybe.None),
        };
        match &self.spec.long {
            Maybe.Some(expected) if &name == expected => {},
            _ => return Result.Ok(Maybe.None),
        }
        state.cursor = state.cursor + 1;
        match attached {
            Maybe.Some(value) => Result.Ok(Maybe.Some(value)),
            Maybe.None => match state.advance() {
                Maybe.Some(value) => Result.Ok(Maybe.Some(value)),
                Maybe.None => Result.Err(ParseError.missing_value(name)),
            },
        }
    }

    fn describe(&self) -> ParserDescription {
        let label = match &self.spec.long {
            Maybe.Some(l) => { let mut s = Text.from("--"); s.push_str(l); s },
            Maybe.None => Text.from("--?"),
        };
        ParserDescription {
            label: label,
            help: self.spec.help.clone(),
            kind: self.spec.kind_hint.clone(),
        }
    }
}

/// Build a `FlagParser` from a `FlagSpec`.
public fn flag(spec: FlagSpec) -> FlagParser {
    FlagParser { spec: spec }
}

// -----------------------------------------------------------------------------
// Combinators — Phase 0 ships the structural form; the runtime path
// in `parse_argv` is the optimised implementation. These exist for
// tooling that wants to compose parsers programmatically.
// -----------------------------------------------------------------------------

/// Make a parser optional: if it fails non-fatally (no input consumed)
/// produce `Maybe.None` instead of `Err`.
public type OptionalParser<A, P: Parser<A>> is {
    inner: P,
};

implement<A, P: Parser<A>> Parser<Maybe<A>> for OptionalParser<A, P> {
    fn parse(&self, state: &mut ParseState) -> Result<Maybe<A>, ParseError> {
        let saved_cursor = state.cursor;
        match self.inner.parse(state) {
            Result.Ok(v) => Result.Ok(Maybe.Some(v)),
            Result.Err(_) if state.cursor == saved_cursor => Result.Ok(Maybe.None),
            Result.Err(err) => Result.Err(err),
        }
    }

    fn describe(&self) -> ParserDescription {
        let mut d = self.inner.describe();
        let mut lab = Text.from("[");
        lab.push_str(&d.label);
        lab.push_str("]");
        d.label = lab;
        d
    }
}

public fn optional<A, P: Parser<A>>(inner: P) -> OptionalParser<A, P> {
    OptionalParser { inner: inner }
}

/// Run `inner` zero or more times, collecting into a List.
public type ManyParser<A, P: Parser<A>> is {
    inner: P,
};

implement<A, P: Parser<A>> Parser<List<A>> for ManyParser<A, P> {
    fn parse(&self, state: &mut ParseState) -> Result<List<A>, ParseError> {
        let mut out: List<A> = List.new();
        loop {
            let saved = state.cursor;
            match self.inner.parse(state) {
                Result.Ok(v) => out.push(v),
                Result.Err(_) => {
                    state.cursor = saved;
                    return Result.Ok(out);
                },
            }
        }
    }

    fn describe(&self) -> ParserDescription {
        let mut d = self.inner.describe();
        d.label.push_str("...");
        d
    }
}

public fn many<A, P: Parser<A>>(inner: P) -> ManyParser<A, P> {
    ManyParser { inner: inner }
}

// =============================================================================
// ParserTransformer — rank-2 polymorphic transformer (spec §3.4)
// =============================================================================
//
// Phase 0 ships the transformer SHAPE — concrete implementations
// (`with_logging`, `with_telemetry`, `with_permission`) land alongside
// the relevant subsystems. This decouples the parser-protocol surface
// from logging/telemetry/security so they can evolve independently.
//

public type ParserTransformer is {
    name: Text,
    apply_label: Text,
};

implement ParserTransformer {
    public fn new(name: Text) -> ParserTransformer {
        ParserTransformer { name: name, apply_label: Text.from("apply") }
    }
}
