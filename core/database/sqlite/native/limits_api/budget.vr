// =============================================================================
// limits_api/budget.vr — per-connection limit table
// =============================================================================
// Spec: SQLite C API
//

// The engine stores one budget per category. sqlite3_limit(db, cat, n)
// returns the PREVIOUS value and sets a new one clamped to the
// category's hard maximum. A negative `n` queries without writing.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.limits_api.budget;

mount core.database.sqlite.native.limits_api.category.{LimitCategory, default_hard_max};

public type LimitBudget is {
    length: Int,
    sql_length: Int,
    column: Int,
    expr_depth: Int,
    compound_select: Int,
    vdbe_op: Int,
    function_arg: Int,
    attached: Int,
    like_pattern_length: Int,
    variable_number: Int,
    trigger_depth: Int,
    worker_threads: Int,
}

public fn new_budget() -> LimitBudget {
    LimitBudget {
        length:              default_hard_max(&LimitCategory.LcLength),
        sql_length:          default_hard_max(&LimitCategory.LcSqlLength),
        column:              default_hard_max(&LimitCategory.LcColumn),
        expr_depth:          default_hard_max(&LimitCategory.LcExprDepth),
        compound_select:     default_hard_max(&LimitCategory.LcCompoundSelect),
        vdbe_op:             default_hard_max(&LimitCategory.LcVdbeOp),
        function_arg:        default_hard_max(&LimitCategory.LcFunctionArg),
        attached:            default_hard_max(&LimitCategory.LcAttached),
        like_pattern_length: default_hard_max(&LimitCategory.LcLikePatternLength),
        variable_number:     default_hard_max(&LimitCategory.LcVariableNumber),
        trigger_depth:       default_hard_max(&LimitCategory.LcTriggerDepth),
        worker_threads:      default_hard_max(&LimitCategory.LcWorkerThreads),
    }
}

implement LimitBudget {
    public fn get(&self, c: &LimitCategory) -> Int {
        match c {
            LimitCategory.LcLength             => self.length,
            LimitCategory.LcSqlLength          => self.sql_length,
            LimitCategory.LcColumn             => self.column,
            LimitCategory.LcExprDepth          => self.expr_depth,
            LimitCategory.LcCompoundSelect     => self.compound_select,
            LimitCategory.LcVdbeOp             => self.vdbe_op,
            LimitCategory.LcFunctionArg        => self.function_arg,
            LimitCategory.LcAttached           => self.attached,
            LimitCategory.LcLikePatternLength  => self.like_pattern_length,
            LimitCategory.LcVariableNumber     => self.variable_number,
            LimitCategory.LcTriggerDepth       => self.trigger_depth,
            LimitCategory.LcWorkerThreads      => self.worker_threads,
        }
    }

    /// Matches sqlite3_limit: negative `n` queries, non-negative sets
    /// after clamping. Returns the PREVIOUS value.
    public fn sqlite3_limit(&mut self, c: &LimitCategory, n: Int) -> Int {
        let prev = self.get(c);
        if n < 0 { return prev; }
        let hard = default_hard_max(c);
        let clamped = if n > hard { hard } else { n };
        match c {
            LimitCategory.LcLength             => self.length = clamped,
            LimitCategory.LcSqlLength          => self.sql_length = clamped,
            LimitCategory.LcColumn             => self.column = clamped,
            LimitCategory.LcExprDepth          => self.expr_depth = clamped,
            LimitCategory.LcCompoundSelect     => self.compound_select = clamped,
            LimitCategory.LcVdbeOp             => self.vdbe_op = clamped,
            LimitCategory.LcFunctionArg        => self.function_arg = clamped,
            LimitCategory.LcAttached           => self.attached = clamped,
            LimitCategory.LcLikePatternLength  => self.like_pattern_length = clamped,
            LimitCategory.LcVariableNumber     => self.variable_number = clamped,
            LimitCategory.LcTriggerDepth       => self.trigger_depth = clamped,
            LimitCategory.LcWorkerThreads      => self.worker_threads = clamped,
        }
        prev
    }
}
