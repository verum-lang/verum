// Update-hook event record.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.update_hook_payload.event;

mount base.{Bool, Text, Int64};
// The op taxonomy is owned by `hooks_api.op` (UpdateOp, sqlite3.h numeric
// codes via op_numeric/op_name/is_write). This module used to declare a
// THIRD public enum with the same variant spellings (`UpdateHookOp` —
// sibling of the deleted ext.hooks `ExtUpdateOp`); duplicate variant
// names across types made the bare constructors unresolvable (T0555).
// Re-export the canon; `UpdateHookOp` stays as an alias for source
// compatibility, and the payload-specific helpers delegate.
public mount core.database.sqlite.native.hooks_api.op.{
    UpdateOp, UoInsert, UoUpdate, UoDelete, op_numeric, op_name,
};

public type UpdateHookOp is UpdateOp;

public fn op_code(o: &UpdateOp) -> Int {
    op_numeric(o)
}

public fn is_insert(o: &UpdateOp) -> Bool { match o { UoInsert => true, _ => false } }
public fn is_update(o: &UpdateOp) -> Bool { match o { UoUpdate => true, _ => false } }
public fn is_delete(o: &UpdateOp) -> Bool { match o { UoDelete => true, _ => false } }

public type UpdateEvent is {
    op: UpdateOp,
    db_name: Text,      // "main" / "temp" / attached name
    table: Text,
    rowid: Int64,
};

public fn event(op: UpdateOp, db_name: Text, table: Text, rowid: Int64) -> UpdateEvent {
    UpdateEvent { op: op, db_name: db_name, table: table, rowid: rowid }
}

public fn is_main_db(e: &UpdateEvent) -> Bool {
    e.db_name == "main".clone()
}

public fn is_temp_db(e: &UpdateEvent) -> Bool {
    e.db_name == "temp".clone()
}

public fn is_attached_db(e: &UpdateEvent) -> Bool {
    !is_main_db(e) && !is_temp_db(e)
}

// Note: the update-hook is NOT invoked for FK cascades, trigger-caused
// changes, or vtab INSTEAD OF — document that invariant.
public fn is_direct_user_change(e: &UpdateEvent) -> Bool {
    true   // hook fires only for direct writes; included for clarity
}
