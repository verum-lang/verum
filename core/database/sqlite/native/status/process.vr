// Spec: SQLite C API — sqlite3_status64.
@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.status.process;

mount core.database.sqlite.native.status.kind.ProcessKind;
mount core.database.sqlite.native.status.counter.{StatusCounter, counter_zero};

public type ProcessStatus is {
    memory_used: StatusCounter,
    pagecache_used: StatusCounter,
    pagecache_overflow: StatusCounter,
    pagecache_size: StatusCounter,
    malloc_size: StatusCounter,
    malloc_count: StatusCounter,
    parser_stack: StatusCounter,
}

public fn process_status_new() -> ProcessStatus {
    ProcessStatus {
        memory_used: counter_zero(), pagecache_used: counter_zero(),
        pagecache_overflow: counter_zero(), pagecache_size: counter_zero(),
        malloc_size: counter_zero(), malloc_count: counter_zero(), parser_stack: counter_zero(),
    }
}

implement ProcessStatus {
    /// Return the current value and maximum observed since reset. Peak-only
    /// selectors leave the current component at zero.
    public fn read(&self, kind: &ProcessKind) -> (Int64, Int64) {
        match kind {
            ProcessKind.PsMemoryUsed => self.memory_used.snapshot(),
            ProcessKind.PsPagecacheUsed => self.pagecache_used.snapshot(),
            ProcessKind.PsPagecacheOverflow => self.pagecache_overflow.snapshot(),
            ProcessKind.PsPagecacheSize => self.pagecache_size.snapshot(),
            ProcessKind.PsMallocSize => self.malloc_size.snapshot(),
            ProcessKind.PsMallocCount => self.malloc_count.snapshot(),
            ProcessKind.PsParserStack => self.parser_stack.snapshot(),
            ProcessKind.PsScratchUsed | ProcessKind.PsScratchOverflow | ProcessKind.PsScratchSize => (0_i64, 0_i64),
        }
    }

    public fn reset_high_water(&mut self, kind: &ProcessKind) {
        match kind {
            ProcessKind.PsMemoryUsed => self.memory_used.reset_high_water(),
            ProcessKind.PsPagecacheUsed => self.pagecache_used.reset_high_water(),
            ProcessKind.PsPagecacheOverflow => self.pagecache_overflow.reset_high_water(),
            ProcessKind.PsPagecacheSize => self.pagecache_size.reset_high_water(),
            ProcessKind.PsMallocSize => self.malloc_size.reset_high_water(),
            ProcessKind.PsMallocCount => self.malloc_count.reset_high_water(),
            ProcessKind.PsParserStack => self.parser_stack.reset_high_water(),
            ProcessKind.PsScratchUsed | ProcessKind.PsScratchOverflow | ProcessKind.PsScratchSize => {},
        }
    }

    public fn read_and_reset(&mut self, kind: &ProcessKind) -> (Int64, Int64) {
        let sample = self.read(kind);
        self.reset_high_water(kind);
        sample
    }

    public fn note_allocation_request(&mut self, requested_bytes: Int64) {
        self.malloc_size.observe_peak(requested_bytes);
    }

    /// Record one successful request and the actual size charged by the allocator.
    public fn note_allocation(&mut self, requested_bytes: Int64, allocated_bytes: Int64) {
        assert(requested_bytes > 0_i64 && allocated_bytes >= requested_bytes, "invalid SQLite allocation size");
        self.memory_used.add(allocated_bytes);
        self.malloc_count.add(1_i64);
        self.note_allocation_request(requested_bytes);
    }

    public fn note_free(&mut self, allocated_bytes: Int64) {
        let (allocations, _) = self.malloc_count.snapshot();
        assert(allocated_bytes > 0_i64 && allocations > 0_i64, "no matching SQLite allocation");
        let (bytes, _) = self.memory_used.snapshot();
        let remaining = allocations - 1_i64;
        assert(allocated_bytes <= bytes && bytes - allocated_bytes >= remaining &&
            (remaining > 0_i64 || allocated_bytes == bytes), "free size disagrees with outstanding SQLite allocations");
        self.memory_used.sub(allocated_bytes);
        self.malloc_count.sub(1_i64);
    }

    public fn observe_pagecache_usage(&mut self, pages: Int64, overflow_bytes: Int64) {
        assert(pages >= 0_i64 && overflow_bytes >= 0_i64, "negative SQLite page cache usage");
        self.pagecache_used.observe(pages);
        self.pagecache_overflow.observe(overflow_bytes);
    }

    public fn note_pagecache_request(&mut self, bytes: Int64) { self.pagecache_size.observe_peak(bytes); }
    public fn note_parser_depth(&mut self, depth: Int64) { self.parser_stack.observe_peak(depth); }
}
