// Spec: SQLite C API — sqlite3_stmt_status.
@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.status.stmt;

mount core.database.sqlite.native.status.kind.{SqliteStatStmtKind, stmt_code};

/// One count per statement event selector (SQLite codes 1 through 8).
public type StmtStatus is { counts: [Int64; 8] }

public fn stmt_status_new() -> StmtStatus { StmtStatus { counts: [0_i64; 8] } }

implement StmtStatus {
    public fn read(&self, kind: &SqliteStatStmtKind) -> Int64 {
        self.counts[stmt_code(kind) - 1]
    }

    public fn read_and_reset(&mut self, kind: &SqliteStatStmtKind) -> Int64 {
        let slot = stmt_code(kind) - 1;
        let count = self.counts[slot];
        self.counts[slot] = 0_i64;
        count
    }

    fn note(&mut self, kind: &SqliteStatStmtKind) {
        let slot = stmt_code(kind) - 1;
        self.counts[slot] = self.counts[slot].checked_add(1_i64).expect("SQLite event count exceeds Int64");
    }

    public fn note_full_scan_step(&mut self) { self.note(&SqliteStatStmtKind.SsFullscanStep); }
    public fn note_sort(&mut self) { self.note(&SqliteStatStmtKind.SsSort); }
    public fn note_autoindex(&mut self) { self.note(&SqliteStatStmtKind.SsAutoindex); }
    public fn note_vm_step(&mut self) { self.note(&SqliteStatStmtKind.SsVmStep); }
    public fn note_reprepare(&mut self) { self.note(&SqliteStatStmtKind.SsReprepare); }
    public fn note_run(&mut self) { self.note(&SqliteStatStmtKind.SsRun); }
    public fn note_filter_miss(&mut self) { self.note(&SqliteStatStmtKind.SsFilterMiss); }
    public fn note_filter_hit(&mut self) { self.note(&SqliteStatStmtKind.SsFilterHit); }

    /// More than one full-scan step per ten VM steps.
    public fn is_scan_heavy(&self) -> Bool {
        self.read(&SqliteStatStmtKind.SsFullscanStep) > self.read(&SqliteStatStmtKind.SsVmStep) / 10_i64
    }
}
