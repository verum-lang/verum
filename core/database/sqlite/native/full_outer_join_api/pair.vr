// A binary-join pair — two source table aliases + join kind + ON predicate id.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.1")
)
module core.database.sqlite.native.full_outer_join_api.pair;

mount core.database.sqlite.native.full_outer_join_api.join_kind.{
    JoinKind, preserves_left, preserves_right, is_outer, is_cross,
};
mount base.{Bool, Text};

// Renamed from `JoinPair` (T0458).  Two modules declared that simple
// name: this one — a query-planner record pairing two table ALIASES with
// the kind of join and its ON predicate — and `core/async/select.vr`'s
// `JoinPair<A, B, FA, FB> { fut_a, fut_b, result_a, result_b }`, the pair
// of futures behind `join(a, b)`.  The layout registry keys by the simple
// name, so a read of `result_a` resolved against THIS record's fields and
// failed; that is what fails
// the `test_compile_stdlib_async_select` fixture (verum_vbc's
// codegen test_params surface).
//
// This side yields for the same reason `ColumnSchema` did (209236f17): it
// is internal to the bundled SQLite engine, while `join(a, b)` is one of
// the language's built-in async forms.  The new name also says what the
// record IS — a pair of aliases, not a pair of anything joinable.
//
// The real cure is a module-qualified registry key (T0458's acceptance).
// A rename is the local remedy, and naming it as such is the point: the
// class stays open.
public type JoinAliasPair is {
    left_alias: Text,
    right_alias: Text,
    kind: JoinKind,
    on_predicate_id: Int,    // key into predicate table; -1 when USING/NATURAL or no ON
    natural: Bool,           // NATURAL JOIN sugar
};

public fn new(left: Text, right: Text, kind: JoinKind) -> JoinAliasPair {
    JoinAliasPair {
        left_alias: left,
        right_alias: right,
        kind: kind,
        on_predicate_id: -1,
        natural: false,
    }
}

public fn with_on(mut p: JoinAliasPair, pred_id: Int) -> JoinAliasPair {
    p.on_predicate_id = pred_id;
    p
}

public fn as_natural(mut p: JoinAliasPair) -> JoinAliasPair {
    p.natural = true;
    p
}

public fn keeps_left_unmatched(p: &JoinAliasPair) -> Bool {
    preserves_left(&p.kind)
}

public fn keeps_right_unmatched(p: &JoinAliasPair) -> Bool {
    preserves_right(&p.kind)
}

public fn has_on(p: &JoinAliasPair) -> Bool {
    p.on_predicate_id >= 0
}
