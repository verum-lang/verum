// =============================================================================
// alter/engine.vr — ALTER execution state machine
// =============================================================================
// Spec: sqlite-native.md §17
//

// State sequence:
//

//  Init → Validating → GeneratingSql → Executing → ApplyingDelta → Done
//

// On validation failure → `Failed(AlterValidationError)`. On execution
// failure → `Failed(ExecutionError(message))`.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.alter.engine;

mount base.{Text, Bool, Maybe};
mount core.database.sqlite.native.alter.op.{
    AlterOp, op_target_table, append_identifier,
    AoRenameTable, AoRenameColumn, AoAddColumn, AoDropColumn, AoAlterColumnDefault,
};
mount core.database.sqlite.native.alter.validator.{
    AlterValidationError, AlterSchemaSnapshot, validate, error_kind,
};
mount core.database.sqlite.native.alter.delta.{
    SchemaDelta, ImpactReport, delta_from, report_for,
};

// -----------------------------------------------------------------------------
// AlterEnginePhase
// -----------------------------------------------------------------------------

public type AlterEngineFailure is
      AefValidation(AlterValidationError)
    | AefExecution(Text);

public type AlterEnginePhase is
      EpInit
    | EpValidating
    | EpGeneratingSql
    | EpExecuting(Text)            // SQL string
    | EpApplyingDelta(SchemaDelta)
    | EpDone(SchemaDelta)
    | EpFailed(AlterEngineFailure);

public fn phase_name(p: &AlterEnginePhase) -> Text {
    match p {
        EpInit             => "init".clone(),
        EpValidating       => "validating".clone(),
        EpGeneratingSql    => "generating_sql".clone(),
        EpExecuting(_)     => "executing".clone(),
        EpApplyingDelta(_) => "applying_delta".clone(),
        EpDone(_)          => "done".clone(),
        EpFailed(_)        => "failed".clone(),
    }
}

// -----------------------------------------------------------------------------
// AlterEngine
// -----------------------------------------------------------------------------

public type AlterEngine is {
    op: AlterOp,
    phase: AlterEnginePhase,
}

public fn engine_new(op: AlterOp) -> AlterEngine {
    AlterEngine { op: op, phase: EpInit }
}

implement AlterEngine {
    public fn current_phase(&self) -> AlterEnginePhase {
        clone_phase(&self.phase)
    }

    public fn is_terminal(&self) -> Bool {
        match &self.phase {
            EpDone(_) | EpFailed(_) => true,
            _                       => false,
        }
    }

    /// Step the engine. The caller drives execution by feeding back
    /// `validate_against` (snapshot) + `sql_runner` (executor). The
    /// loop in the L7 façade is:
    ///

    ///  while !engine.is_terminal() { engine.step(snap, runner); }
    public fn step(
        &mut self,
        snap: &AlterSchemaSnapshot,
        sql_runner: fn(&Text) -> Maybe<Text>,
    ) {
        let next: AlterEnginePhase = match &self.phase {
            EpInit => EpValidating,
            EpValidating => match validate(&self.op, snap) {
                Result.Ok(_) => EpGeneratingSql,
                Result.Err(e) => EpFailed(AefValidation(e)),
            },
            EpGeneratingSql => EpExecuting(generate_sql(&self.op)),
            EpExecuting(sql) => match sql_runner(sql) {
                Maybe.None => EpApplyingDelta(delta_from(&self.op)),
                Maybe.Some(err) => EpFailed(AefExecution(err)),
            },
            EpApplyingDelta(d) => EpDone(clone_delta(d)),
            EpDone(_) | EpFailed(_) => return,
        };
        self.phase = next;
    }

    public fn delta(&self) -> Maybe<SchemaDelta> {
        match &self.phase {
            EpDone(d)          => Maybe.Some(clone_delta(d)),
            EpApplyingDelta(d) => Maybe.Some(clone_delta(d)),
            _                  => Maybe.None,
        }
    }
}

// -----------------------------------------------------------------------------
// SQL generation
// -----------------------------------------------------------------------------

public fn generate_sql(op: &AlterOp) -> Text {
    let mut out = "ALTER TABLE ".clone();
    append_identifier(&mut out, &op_target_table(op));
    match op {
        AoRenameTable(_, new) => {
            out.push_str(&" RENAME TO ");
            append_identifier(&mut out, new);
        }
        AoRenameColumn(_, old, new) => {
            out.push_str(&" RENAME COLUMN ");
            append_identifier(&mut out, old);
            out.push_str(&" TO ");
            append_identifier(&mut out, new);
        }
        AoAddColumn(_, def) => {
            out.push_str(&" ADD COLUMN ");
            def.append_definition(&mut out);
        }
        AoDropColumn(_, col) => {
            out.push_str(&" DROP COLUMN ");
            append_identifier(&mut out, col);
        }
        AoAlterColumnDefault(_, col, exp) => {
            out.push_str(&" ALTER COLUMN ");
            append_identifier(&mut out, col);
            match exp {
                Maybe.Some(e) => { out.push_str(&" SET DEFAULT "); out.push_str(e); },
                Maybe.None => { out.push_str(&" DROP DEFAULT"); },
            }
        }
    }
    out
}

fn clone_phase(p: &AlterEnginePhase) -> AlterEnginePhase {
    match p {
        EpInit              => EpInit,
        EpValidating        => EpValidating,
        EpGeneratingSql     => EpGeneratingSql,
        EpExecuting(s)      => EpExecuting(s.clone()),
        EpApplyingDelta(d)  => EpApplyingDelta(clone_delta(d)),
        EpDone(d)           => EpDone(clone_delta(d)),
        EpFailed(f)         => EpFailed(clone_failure(f)),
    }
}

fn clone_failure(f: &AlterEngineFailure) -> AlterEngineFailure {
    match f {
        AefValidation(e) => AefValidation(clone_validation_error(e)),
        AefExecution(t)  => AefExecution(t.clone()),
    }
}

// Pattern-match every variant of AlterValidationError to perform a
// proper deep clone. Pre-fix `clone_failure` collapsed every
// `AefValidation` into `AefExecution(error_kind(...))` with a "we
// can't deeply clone here" comment — that lost (1) the variant
// identity (every validation error became an "execution" error
// downstream), (2) the structured payload (table/column names
// reduced to a single discriminant tag string like
// "no_such_table"). Diagnostics displayed via `Display for
// AlterValidationError` were unreachable for any cloned phase
// because the cloned phase no longer carried an
// AlterValidationError at all.
fn clone_validation_error(e: &AlterValidationError) -> AlterValidationError {
    match e {
        AlterValidationError.VeNoSuchTable(t) =>
            AlterValidationError.VeNoSuchTable(t.clone()),
        AlterValidationError.VeNoSuchColumn(t, c) =>
            AlterValidationError.VeNoSuchColumn(t.clone(), c.clone()),
        AlterValidationError.VeDuplicateName(n) =>
            AlterValidationError.VeDuplicateName(n.clone()),
        AlterValidationError.VeNotNullWithoutDefault(t, c) =>
            AlterValidationError.VeNotNullWithoutDefault(t.clone(), c.clone()),
        AlterValidationError.VePrimaryKey(t, c) =>
            AlterValidationError.VePrimaryKey(t.clone(), c.clone()),
        AlterValidationError.VeForeignKey(t, c) =>
            AlterValidationError.VeForeignKey(t.clone(), c.clone()),
    }
}

fn clone_delta(d: &SchemaDelta) -> SchemaDelta {
    match d {
        SchemaDelta.SdTableRenamed(a, b) =>
            SchemaDelta.SdTableRenamed(a.clone(), b.clone()),
        SchemaDelta.SdColumnRenamed(t, a, b) =>
            SchemaDelta.SdColumnRenamed(t.clone(), a.clone(), b.clone()),
        SchemaDelta.SdColumnAdded(t, c) =>
            SchemaDelta.SdColumnAdded(t.clone(), c.clone()),
        SchemaDelta.SdColumnDropped(t, c) =>
            SchemaDelta.SdColumnDropped(t.clone(), c.clone()),
        SchemaDelta.SdColumnDefaultChanged(t, c, e) =>
            SchemaDelta.SdColumnDefaultChanged(
                t.clone(),
                c.clone(),
                match e { Maybe.Some(s) => Maybe.Some(s.clone()), Maybe.None => Maybe.None },
            ),
    }
}
