// Pipe-separated formatter matching shell output.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.explain_opcode_dump.formatter;

mount core.database.sqlite.native.explain_opcode_dump.row.{
    ExplainOpcodeRow, has_p4, has_p5, has_comment,
};
mount base.{Bool, Text};

public fn format_row(r: &ExplainOpcodeRow) -> Text {
    let mut out = Text.new();
    out.push_int(r.addr);
    out.push_byte('|' as Byte);
    out.push_str(&r.opcode);
    out.push_byte('|' as Byte);
    out.push_int(r.p1);
    out.push_byte('|' as Byte);
    out.push_int(r.p2);
    out.push_byte('|' as Byte);
    out.push_int(r.p3);
    out.push_byte('|' as Byte);
    out.push_str(&r.p4);
    out.push_byte('|' as Byte);
    out.push_int(r.p5);
    if has_comment(r) {
        out.push_byte('|' as Byte);
        out.push_str(&r.comment);
    }
    out
}

public fn has_trailing_comment_column(r: &ExplainOpcodeRow) -> Bool {
    has_comment(r)
}
