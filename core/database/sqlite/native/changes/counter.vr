// =============================================================================
// changes/counter.vr — per-connection row-change counters
// =============================================================================
// Spec: SQLite C API — sqlite3_changes / sqlite3_total_changes /
//  sqlite3_last_insert_rowid and their 64-bit variants.
//

// Counters are always stored as Int64 internally; the 32-bit accessors
// in `engine` use the C int width.
//

//  * `statement_changes` — changes from the most recent INSERT/UPDATE/
//  DELETE statement completed on this connection
//  * `total_changes` — cumulative since the connection was opened
//  * `last_insert_rowid` — rowid of the most recent successful INSERT
//  into a rowid table
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.changes.counter;

mount base.{Bool};

public type ChangeCounter is {
    statement_changes: Int64,
    total_changes: Int64,
    last_insert_rowid: Int64,
    /// Monotone version — incremented on every mutation. Useful for
    /// hooks that want to detect "anything happened between snapshots".
    version: Int64,
}

public fn new_counter() -> ChangeCounter {
    ChangeCounter {
        statement_changes: 0 as Int64,
        total_changes: 0 as Int64,
        last_insert_rowid: 0 as Int64,
        version: 0 as Int64,
    }
}

implement ChangeCounter {
    public(in core.database.sqlite.native.changes) fn last_statement_rows(&self) -> Int64 { self.statement_changes }
    public(in core.database.sqlite.native.changes) fn total_rows(&self) -> Int64 { self.total_changes }
    public(in core.database.sqlite.native.changes) fn last_rowid(&self) -> Int64 { self.last_insert_rowid }
    public(in core.database.sqlite.native.changes) fn revision(&self) -> Int64 { self.version }

    /// Record a completed DML statement with no auxiliary changes.
    public fn record_statement(&mut self, changes: Int64) {
        self.record_statement_with_auxiliary(changes, 0_i64);
    }

    /// Include trigger and foreign-key writes in the total. Exclude rows
    /// deleted by REPLACE constraint resolution from both counts.
    public fn record_statement_with_auxiliary(&mut self, changes: Int64, auxiliary_rows: Int64) {
        assert(changes >= 0_i64 && auxiliary_rows >= 0_i64, "negative SQLite row count");
        assert(changes <= Int64.MAX - self.total_changes, "SQLite total changes exceed Int64");
        let new_total = self.total_changes + changes;
        assert(auxiliary_rows <= Int64.MAX - new_total, "SQLite total changes exceed Int64");
        self.statement_changes = changes;
        self.total_changes = new_total + auxiliary_rows;
        self.version = self.version + 1_i64;
    }

    /// Record a successful insert into a rowid table, including one
    /// in a transaction that is rolled back later.
    public fn record_insert(&mut self, rowid: Int64) {
        self.override_last_insert_rowid(rowid);
    }

    /// Explicit override — matches sqlite3_set_last_insert_rowid.
    public fn override_last_insert_rowid(&mut self, rowid: Int64) {
        self.last_insert_rowid = rowid;
        self.version = self.version + 1_i64;
    }
}

/// True iff the last statement made no visible modifications.
public fn is_noop(c: &ChangeCounter) -> Bool {
    c.statement_changes == 0_i64
}
