// =============================================================================
// iter/outcome.vr — RawStepOutcome sum
// =============================================================================
// Spec: SQLite C API
//

// `RawStepOutcome` is the typed counterpart to sqlite3_step's return
// integer. The five SQLite codes the catalogue exposes:
//

//  SQLITE_ROW = 100
//  SQLITE_DONE = 101
//  SQLITE_BUSY = 5
//  SQLITE_ERROR = 1
//  SQLITE_MISUSE = 21
//

// Anything else is wrapped in `RawOther(code)` so callers can route
// extended error codes themselves.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.iter.outcome;

mount base.{Text, Bool};

public type RawStepOutcome is
      RawRow
    | RawDone
    | RawBusy
    | RawError(Text)
    | RawMisuse
    | RawOther(Int);

public const SQLITE_ROW: Int     = 100;
public const SQLITE_DONE: Int    = 101;
public const SQLITE_BUSY: Int    = 5;
public const SQLITE_ERROR: Int   = 1;
public const SQLITE_MISUSE: Int  = 21;

public fn outcome_code(o: &RawStepOutcome) -> Int {
    match o {
        RawRow         => SQLITE_ROW,
        RawDone        => SQLITE_DONE,
        RawBusy        => SQLITE_BUSY,
        RawError(_)    => SQLITE_ERROR,
        RawMisuse      => SQLITE_MISUSE,
        RawOther(c)    => *c,
    }
}

public fn outcome_kind_name(o: &RawStepOutcome) -> Text {
    match o {
        RawRow         => "row".clone(),
        RawDone        => "done".clone(),
        RawBusy        => "busy".clone(),
        RawError(_)    => "error".clone(),
        RawMisuse      => "misuse".clone(),
        RawOther(_)    => "other".clone(),
    }
}

/// True iff this outcome means "another row is ready" — the caller
/// should fetch the row and step again.
public fn has_row(o: &RawStepOutcome) -> Bool {
    match o {
        RawRow => true,
        _     => false,
    }
}

/// True iff this outcome means "the loop should stop".
public fn is_terminal(o: &RawStepOutcome) -> Bool {
    match o {
        RawDone | RawError(_) | RawMisuse | RawOther(_) => true,
        _ => false,
    }
}

/// True iff the caller may retry after a back-off.
public fn is_retriable(o: &RawStepOutcome) -> Bool {
    match o {
        RawBusy => true,
        _      => false,
    }
}

/// Translate a raw C-API integer into a RawStepOutcome. Caller passes
/// `error_message` only for the error-class codes.
public fn from_code(code: Int, error_message: Text) -> RawStepOutcome {
    if code == SQLITE_ROW    { return RawRow; }
    if code == SQLITE_DONE   { return RawDone; }
    if code == SQLITE_BUSY   { return RawBusy; }
    if code == SQLITE_ERROR  { return RawError(error_message); }
    if code == SQLITE_MISUSE { return RawMisuse; }
    RawOther(code)
}
