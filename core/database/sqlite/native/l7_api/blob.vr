@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l7_api.blob;

// Incremental reads and fixed-size writes address a single cell in the connection's row store.

mount collections.List;
mount core.database.sqlite.native.l4_vdbe.register.Register;
mount core.database.sqlite.native.incrblob.flags.BlobOpenMode;
mount core.database.sqlite.native.incrblob.error.BlobError;
mount core.database.sqlite.native.l6_session.connection.mode_can_write;
mount core.database.sqlite.native.l6_session.row_store.CellAddress;
mount core.database.sqlite.native.l7_api.database.{Database, SqliteApiDbError};
mount core.text.text.Text;

fn location(db: &Database, schema: &Text, table: &Text, column: &Text, rowid: Int64) -> Result<CellAddress, SqliteApiDbError> {
    if rowid < 1_i64 { return Result.Err(DbBindRange(rowid as Int)); }
    let meta = match db.conn_view_for_blob().schema().lookup_table(schema, table) {
        Result.Ok(meta) => meta,
        Result.Err(_) => return Result.Err(DbCannotOpen(f"Unknown BLOB table {schema}.{table}")),
    };
    if !meta.has_rowid() { return Result.Err(DbCannotOpen("BLOB access requires a rowid table")); }
    match meta.column_index(column) {
        Maybe.Some(index) => Result.Ok(CellAddress { root: meta.root_page(), row: (rowid - 1_i64) as Int, column: index }),
        Maybe.None => Result.Err(DbCannotOpen(f"Unknown BLOB column {column}")),
    }
}

fn cell(db: &Database, loc: &CellAddress) -> Result<&Register, SqliteApiDbError> {
    match db.conn_view_for_blob().cell_at(loc) {
        Maybe.Some(value) => Result.Ok(value),
        Maybe.None => Result.Err(DbBindRange(loc.row)),
    }
}

fn bytes(value: &Register) -> Result<&[Byte], SqliteApiDbError> {
    match value {
        RBlob(data) => Result.Ok(data.as_slice()),
        RText(text) => Result.Ok(text.as_bytes()),
        _ => Result.Err(DbDataTypeMismatch),
    }
}

public fn blob_open(
    db: &mut Database, schema: &Text, table: &Text, column: &Text, rowid: Int64, write_mode: Bool,
) -> Result<Int64, SqliteApiDbError> {
    if write_mode && !mode_can_write(db.mode()) { return Result.Err(DbReadonly); }
    let loc = location(db, schema, table, column, rowid)?;
    let length = (bytes(cell(db, &loc)?)?).len();
    let mode = if write_mode { BlobOpenMode.BomReadWrite } else { BlobOpenMode.BomReadOnly };
    Result.Ok(db.conn_mut_for_blob().blob_engine_mut().open(
        schema.clone(), table.clone(), column.clone(), rowid, mode, length,
    ))
}

public fn blob_bytes(db: &Database, handle_id: Int64) -> Result<Int, SqliteApiDbError> {
    match db.conn_view_for_blob().blob_engine_view().lookup_size(handle_id) {
        Maybe.Some(length) => Result.Ok(length),
        Maybe.None => Result.Err(DbCannotOpen("BLOB handle is closed")),
    }
}

// Validate the live handle and the current cell before issuing any mutation.
fn access(db: &Database, id: Int64, offset: Int, length: Int, write: Bool) -> Result<CellAddress, SqliteApiDbError> {
    let handle = match db.conn_view_for_blob().blob_engine_view().access(&id, offset, length, write) {
        Result.Ok(handle) => handle,
        Result.Err(BlobError.BeReadOnly) => return Result.Err(DbReadonly),
        Result.Err(BlobError.BeOutOfRange(_, _)) => return Result.Err(DbBindRange(offset)),
        Result.Err(_) => return Result.Err(DbCannotOpen("BLOB handle is closed")),
    };
    let target = handle.target();
    let loc = location(db, &target.schema, &target.table, &target.column, target.rowid)?;
    if (bytes(cell(db, &loc)?)?).len() != handle.byte_len() {
        return Result.Err(DbCorrupt("BLOB size changed while the handle was open"));
    }
    Result.Ok(loc)
}

public fn blob_read(db: &Database, handle_id: Int64, offset: Int, length: Int) -> Result<List<Byte>, SqliteApiDbError> {
    let loc = access(db, handle_id, offset, length, false)?;
    let contents = bytes(cell(db, &loc)?)?;
    Result.Ok(List.from_slice(&contents[offset..offset + length]))
}

fn replace_bytes(value: &Register, offset: Int, data: &[Byte]) -> Result<Register, SqliteApiDbError> {
    let mut updated: List<Byte> = List.from_slice(bytes(value)?);
    let mut i = 0;
    while i < data.len() {
        updated[offset + i] = data[i];
        i = i + 1;
    }
    if value is RText(_) {
        return match Text.from_utf8(updated.as_slice()) {
            Result.Ok(text) => Result.Ok(RText(text)),
            Result.Err(_) => Result.Err(DbDataTypeMismatch),
        };
    }
    Result.Ok(RBlob(updated))
}

public fn blob_write(db: &mut Database, handle_id: Int64, offset: Int, data: &[Byte]) -> Result<(), SqliteApiDbError> {
    let loc = access(db, handle_id, offset, data.len(), true)?;
    if data.len() == 0 { return Result.Ok(()); }
    let updated = replace_bytes(cell(db, &loc)?, offset, data)?;
    if !db.conn_mut_for_blob().replace_cell_at(loc, updated) {
        return Result.Err(DbBindRange(loc.row));
    }
    Result.Ok(())
}

fn reopen_size(db: &Database, handle_id: Int64, rowid: Int64) -> Result<Int, SqliteApiDbError> {
    let handle = match db.conn_view_for_blob().blob_engine_view().lookup(&handle_id) {
        Result.Ok(handle) => handle,
        Result.Err(_) => return Result.Err(DbCannotOpen("BLOB handle is closed")),
    };
    let target = handle.target();
    let loc = location(db, &target.schema, &target.table, &target.column, rowid)?;
    Result.Ok((bytes(cell(db, &loc)?)?).len())
}

public fn blob_reopen(db: &mut Database, handle_id: Int64, new_rowid: Int64) -> Result<(), SqliteApiDbError> {
    let size = match reopen_size(db, handle_id, new_rowid) {
        Result.Ok(size) => size,
        Result.Err(e) => {
            db.conn_mut_for_blob().blob_engine_mut().close(handle_id);
            return Result.Err(e);
        }
    };
    match db.conn_mut_for_blob().blob_engine_mut().reopen(handle_id, new_rowid, size) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(_) => Result.Err(DbCannotOpen("BLOB handle is closed")),
    }
}

public fn blob_close(db: &mut Database, handle_id: Int64) -> Result<(), SqliteApiDbError> {
    db.conn_mut_for_blob().blob_engine_mut().close(handle_id);
    Result.Ok(())
}
