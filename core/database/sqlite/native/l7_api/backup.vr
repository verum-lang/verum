@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l7_api.backup;

// A backup copies committed pages from the source pager. An unfinished batch
// stays in the destination cache. The last successful step installs the exact
// source extent and synchronizes it before returning BoDone.

mount core.base.result.Result;
mount core.database.sqlite.native.l1_pager.pager.{Pager, pager_write, pager_close};
mount core.database.sqlite.native.l1_pager.db_header.parse_header;
mount core.database.sqlite.native.backup_api.handle.{BackupHandle, new_handle};
mount core.database.sqlite.native.backup_api.outcome.BackupOutcome;
mount core.database.sqlite.native.backup_api.request.{BackupStepRequest, requested_pages, is_noop};
mount core.database.sqlite.native.errors.code.{ExtIoErrRead, ExtIoErrWrite, extended_of, PcMisuse};
mount core.database.sqlite.native.l7_api.database.{Database, SqliteApiDbError, open_path_admin};
mount core.database.sqlite.native.l6_session.connection.mode_can_write;

type SourceVersion is { pages: Int, writes: Int, change: UInt32 };

/// A backup owns its destination until finish or abandon returns it to the caller.
public type affine BackupSession is ActiveBackup {
    dst: Database, progress: BackupHandle, source: SourceVersion, scope: Shared<Int>,
};

implement BackupSession {
    public fn page_count(&self) -> Int {
        match self { ActiveBackup { progress, .. } => progress.page_count() }
    }

    public fn remaining(&self) -> Int {
        match self { ActiveBackup { progress, .. } => progress.remaining() }
    }
}

fn backup_source(src: &Database) -> Result<&Pager, SqliteApiDbError> {
    if src.is_in_tx() { return Result.Err(SqliteApiDbError.DbBusy); }
    if src.has_unpersisted_sql() {
        return Result.Err(SqliteApiDbError.DbUnsupported("the SQL connection has changes outside the pager"));
    }
    Result.Ok(src.pager_view())
}

fn source_version(src: &Pager) -> Result<SourceVersion, SqliteApiDbError> {
    if src.is_closed() {
        return Result.Err(SqliteApiDbError.DbIoError("backup source is closed"));
    }
    if src.dirty_count_view() != 0 { return Result.Err(SqliteApiDbError.DbBusy); }
    match src.has_backup_sidecar() {
        Result.Ok(true) => return Result.Err(SqliteApiDbError.DbUnsupported("the source has a rollback journal or WAL")),
        Result.Ok(false) => {}
        Result.Err(_) => return Result.Err(SqliteApiDbError.DbIoError("cannot inspect source journals")),
    }
    let total = match src.stored_pages() {
        Result.Ok(n) => n,
        Result.Err(_) => return Result.Err(SqliteApiDbError.DbIoError("cannot determine source extent")),
    };
    let writes = src.write_generation();
    if total == 0 { return Result.Ok(SourceVersion { pages: 0, writes, change: 0_u32 }); }
    let first = match src.read_storage(1) {
        Result.Ok(page) => page,
        Result.Err(_) => return Result.Err(SqliteApiDbError.DbIoError("cannot read source header")),
    };
    let header = match parse_header(first.bytes()) {
        Result.Ok(h) => h,
        Result.Err(e) => return Result.Err(SqliteApiDbError.DbCorrupt(e)),
    };
    if header.page_bytes() != src.page_size_view() {
        return Result.Err(SqliteApiDbError.DbCorrupt("source header and pager disagree on page size"));
    }
    if header.uses_wal() {
        return Result.Err(SqliteApiDbError.DbUnsupported("backup requires a rollback-journal source"));
    }
    Result.Ok(SourceVersion { pages: total, writes, change: header.change_counter() })
}

fn same_version(a: &SourceVersion, b: &SourceVersion) -> Bool {
    a.pages == b.pages && a.writes == b.writes && a.change == b.change
}

fn initial_source_version(src: &Pager) -> Result<SourceVersion, SqliteApiDbError> {
    let mut guard = match src.backup_read_lock() {
        Result.Ok(lock) => lock,
        Result.Err(e) if e.is_busy() => return Result.Err(SqliteApiDbError.DbBusy),
        Result.Err(_) => return Result.Err(SqliteApiDbError.DbIoError("cannot lock the backup source")),
    };
    let version = source_version(src);
    if guard.release().is_err() {
        return Result.Err(SqliteApiDbError.DbIoError("cannot release the backup source"));
    }
    version
}

public fn backup_init_to_path(src: &Database, dst_path: &Text) -> Result<BackupSession, SqliteApiDbError> {
    let source = backup_source(src)?;
    let version = initial_source_version(source)?;
    let dst = open_path_admin(dst_path)?;
    start_session(source, src.connection_scope(), dst, version)
}

public fn backup_init_into(src: &Database, dst: Database) -> Result<BackupSession, SqliteApiDbError> {
    let scope = src.connection_scope();
    if scope.ptr_eq(&dst.connection_scope()) {
        return Result.Err(SqliteApiDbError.DbMisuse("backup source and destination share a connection"));
    }
    let source = match backup_source(src) {
        Result.Ok(pager) => pager,
        Result.Err(e) => { dst.close(); return Result.Err(e); }
    };
    let version = match initial_source_version(source) {
        Result.Ok(v) => v,
        Result.Err(e) => { dst.close(); return Result.Err(e); }
    };
    start_session(source, scope, dst, version)
}

fn start_session(source: &Pager, scope: Shared<Int>, dst: Database, version: SourceVersion) -> Result<BackupSession, SqliteApiDbError> {
    let status = destination_status(source, &dst);
    if !(status is DestReady) { dst.close(); return Result.Err(destination_error(status)); }
    let progress = new_handle(0 as Int64, 0 as Int64, "main", 0 as Int64, "main", version.pages);
    Result.Ok(ActiveBackup { dst, progress, source: version, scope })
}

type DestinationStatus is DestReady | DestReadOnly | DestBusy | DestWrongPageSize | DestHasJournal | DestJournalIo | DestSameFile;

fn destination_status(source: &Pager, dst: &Database) -> DestinationStatus {
    if !mode_can_write(dst.mode()) || dst.pager_view().is_read_only() { return DestReadOnly; }
    if dst.is_in_tx() || dst.has_unpersisted_sql() || dst.pager_view().is_closed()
        || dst.pager_view().dirty_count_view() != 0 { return DestBusy; }
    if source.page_size_view() != dst.pager_view().page_size_view() { return DestWrongPageSize; }
    match source.shares_backup_file(dst.pager_view()) {
        Result.Ok(true) => return DestSameFile,
        Result.Ok(false) => {}
        Result.Err(_) => return DestJournalIo,
    }
    match dst.pager_view().reserve_backup() {
        Result.Ok(_) => {}
        Result.Err(e) if e.is_busy() => return DestBusy,
        Result.Err(_) => return DestJournalIo,
    }
    match dst.pager_view().has_backup_sidecar() {
        Result.Ok(true) => DestHasJournal,
        Result.Ok(false) => DestReady,
        Result.Err(_) => DestJournalIo,
    }
}

fn destination_error(status: DestinationStatus) -> SqliteApiDbError {
    match status {
        DestReadOnly => SqliteApiDbError.DbReadonly,
        DestWrongPageSize => SqliteApiDbError.DbCorrupt("incompatible backup page sizes"),
        DestSameFile => SqliteApiDbError.DbMisuse("source and destination are the same database file"),
        DestHasJournal => SqliteApiDbError.DbUnsupported("the destination has a rollback journal or WAL"),
        DestJournalIo => SqliteApiDbError.DbIoError("cannot inspect destination journals"),
        _ => SqliteApiDbError.DbBusy,
    }
}

/// Copy a bounded batch and persist the complete destination before reporting BoDone.
public fn backup_step(session: &mut BackupSession, src: &Database, req: BackupStepRequest) -> BackupOutcome {
    match session {
        ActiveBackup { dst, progress, source, scope } => {
            if !scope.ptr_eq(&src.connection_scope()) {
                return BackupOutcome.failed(extended_of(PcMisuse, 0), "backup step received a different source connection");
            }
            let pager = match backup_source(src) {
                Result.Ok(p) => p,
                Result.Err(SqliteApiDbError.DbBusy) => return BackupOutcome.BoBusy,
                Result.Err(_) => return BackupOutcome.failed(ExtIoErrRead(), "source has changes outside the pager"),
            };
            copy_batch(dst.pager_mut(), progress, source, pager, &req)
        }
    }
}

fn copy_batch(
    dst: &mut Pager, progress: &mut BackupHandle, previous: &mut SourceVersion,
    src: &Pager, req: &BackupStepRequest,
) -> BackupOutcome {
    if !progress.is_live() { return BackupOutcome.BoDone; }
    if is_noop(req) { return BackupOutcome.BoOk; }
    let mut guard = match src.backup_read_lock() {
        Result.Ok(lock) => lock,
        Result.Err(e) if e.is_busy() => return BackupOutcome.BoBusy,
        Result.Err(_) => return BackupOutcome.failed(ExtIoErrRead(), "cannot lock the backup source"),
    };
    let outcome = copy_locked_batch(dst, progress, previous, src, req);
    if guard.release().is_err() {
        return BackupOutcome.failed(ExtIoErrRead(), "cannot release the backup source");
    }
    outcome
}

fn copy_locked_batch(
    dst: &mut Pager, progress: &mut BackupHandle, previous: &mut SourceVersion,
    src: &Pager, req: &BackupStepRequest,
) -> BackupOutcome {
    let version = match source_version(src) {
        Result.Ok(v) => v,
        Result.Err(SqliteApiDbError.DbBusy) => return BackupOutcome.BoBusy,
        Result.Err(_) => return BackupOutcome.failed(ExtIoErrRead(), "cannot read the backup source"),
    };
    if !same_version(previous, &version) {
        dst.discard_backup();
        progress.restart(version.pages);
        *previous = version;
    }

    let count = requested_pages(req, progress.remaining());
    let mut i = 0;
    while i < count {
        let number = progress.page_count() - progress.remaining() + 1;
        let page = match src.read_storage(number) {
            Result.Ok(p) => p,
            Result.Err(_) => return BackupOutcome.failed(ExtIoErrRead(), f"cannot read backup page {number}"),
        };
        if pager_write(dst, &page).is_err() {
            return BackupOutcome.failed(ExtIoErrWrite(), f"cannot write backup page {number}");
        }
        progress.record_progress(1);
        i = i + 1;
    }
    if progress.remaining() > 0 { return BackupOutcome.BoOk; }
    let final_version = match source_version(src) {
        Result.Ok(v) => v,
        Result.Err(SqliteApiDbError.DbBusy) => return BackupOutcome.BoBusy,
        Result.Err(_) => return BackupOutcome.failed(ExtIoErrRead(), "cannot verify the backup source"),
    };
    if !same_version(previous, &final_version) {
        dst.discard_backup();
        progress.restart(final_version.pages);
        *previous = final_version;
        return BackupOutcome.BoOk;
    }
    match dst.has_backup_sidecar() {
        Result.Ok(true) => return BackupOutcome.BoBusy,
        Result.Ok(false) => {}
        Result.Err(_) => return BackupOutcome.failed(ExtIoErrWrite(), "cannot inspect destination journals"),
    }
    if dst.finish_backup(progress.page_count()).is_err() {
        return BackupOutcome.failed(ExtIoErrWrite(), "cannot finalize the backup destination");
    }
    progress.finish();
    BackupOutcome.BoDone
}

/// Transfer the owned destination. Only BoDone establishes a completed backup.
public fn backup_finish(session: BackupSession) -> Database {
    match session { ActiveBackup { dst, .. } => dst }
}

/// Return the partial destination to its owner for cleanup.
public fn backup_abandon(session: BackupSession) -> Database { backup_finish(session) }

fn drain_and_close(
    dst: &mut Pager, src: &Pager, progress: &mut BackupHandle, version: &mut SourceVersion,
) -> BackupOutcome {
    loop {
        let outcome = copy_batch(dst, progress, version, src, &BackupStepRequest.BsrAll);
        match outcome {
            BackupOutcome.BoOk => {}
            BackupOutcome.BoDone => {
                if pager_close(dst).is_err() {
                    return BackupOutcome.failed(ExtIoErrWrite(), "cannot close the backup destination");
                }
                return BackupOutcome.BoDone;
            }
            _ => {
                dst.discard_backup();
                let _ = pager_close(dst);
                return outcome;
            }
        }
    }
}

/// Copy the source and reopen the completed file after a successful close.
public fn backup_to_path_in_one_go(src: &Database, dst_path: &Text) -> Result<Database, SqliteApiDbError> {
    let source = backup_source(src)?;
    let mut version = initial_source_version(source)?;
    let mut dst = open_path_admin(dst_path)?;
    let status = destination_status(source, &dst);
    if !(status is DestReady) {
        dst.close();
        return Result.Err(destination_error(status));
    }
    let mut progress = new_handle(0 as Int64, 0 as Int64, "main", 0 as Int64, "main", version.pages);
    let outcome = drain_and_close(dst.pager_mut(), source, &mut progress, &mut version);
    match outcome {
        BackupOutcome.BoDone => open_path_admin(dst_path),
        BackupOutcome.BoBusy | BackupOutcome.BoLocked => Result.Err(SqliteApiDbError.DbBusy),
        _ => Result.Err(SqliteApiDbError.DbIoError(outcome.failure_message())),
    }
}
