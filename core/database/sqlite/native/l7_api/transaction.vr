@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l7_api.transaction;

// =============================================================================
// l7_api/transaction.vr — affine user-facing SqliteTransaction handle
// =============================================================================
// Layer: 7 — public API.
// Spec: database.md §4.1 + §5.5; sqlite-native.md §13.
//

// `SqliteTransaction` is affine: at most one consuming use, not mandatory
// consumption. Callers must finish a transaction through `Database.commit_tx`
// or `Database.rollback_tx` as an API obligation. There is no @must_consume
// declaration or rollback Drop guard here. Scope-exit, panic and cancellation
// cleanup cannot be inferred from this token; see docs/architecture/resource-mode-contract.md.
//

// Why a token instead of a borrowed Database?
//

//  This API keeps the connection separate from the token: methods on
//  `Database` consume `SqliteTransaction`. The token holds a depth snapshot
//  and transaction kind, not a borrow or identity of the originating
//  Database. Callers must use the originating connection; the depth check
//  is not proof that an unrelated connection owns this transaction.
//

//  The `with_transaction` callback combinator wraps both halves so most
//  user code never names a `SqliteTransaction` value at all — see
//  `Database.with_transaction` in `database.vr`.
//

// Defence-in-depth fields:
//

//  * `started_at_depth` — snapshot of `SqliteNativeConnection.tx_depth()` when
//  `begin_tx` fired. `commit_tx` cross-checks the current depth before
//  issuing COMMIT, reporting `DbMisuse(..)` for an unmatched nested scope.
//  `rollback_tx` deliberately tolerates stale depth as a recovery path.
// =============================================================================

mount base.{Result, Ok, Err, Text};

/// SqliteTransaction-isolation flavour that shapes the underlying BEGIN.
///

/// Mirrors SQLite's three flavours:
///

///  * `Deferred` — no locks until first read/write (BEGIN; default)
///  * `Immediate` — RESERVED lock immediately (BEGIN IMMEDIATE)
///  * `Exclusive` — EXCLUSIVE lock immediately (BEGIN EXCLUSIVE)
///

/// `Deferred` is the right pick for read-heavy workloads; `Immediate`
/// avoids SQLITE_BUSY surprises in concurrent-writer setups.
public type TxKind is TkDeferred | TkImmediate | TkExclusive;

/// Affine transaction handle. User code obtains it through
/// `Database.begin_tx_*` and finishes the transaction through
/// `Database.commit_tx` / `Database.rollback_tx` (or the
/// `Database.with_transaction` combinator that wraps both).
///

/// Affine semantics:
///  * At most one consuming use; references may observe the live owner.
///  * Unused locals are permitted; this is not a linear/@must_consume type.
///  * `commit_tx` / `rollback_tx` take the token by value, including on error.
///    Consumption does not prove successful COMMIT/ROLLBACK or runtime cleanup.
public type affine SqliteTransaction is {
    /// Tx-depth snapshot for outer-vs-savepoint sanity checking.
    started_at_depth: Int,
    /// Isolation flavour the BEGIN ran with. Surfaced for tracing and
    /// for the rare caller that wants to assert on it.
    kind: TxKind,
};

/// Construct a fresh transaction handle. Internal — use
/// `Database.begin_tx_*` from user code.
public fn tx_make(started_at_depth: Int, kind: TxKind) -> SqliteTransaction {
    SqliteTransaction { started_at_depth: started_at_depth, kind: kind }
}

implement SqliteTransaction {
    /// Tx-depth at the moment `begin_tx` was issued. Used by the
    /// commit/rollback pair to verify they're closing the *outermost*
    /// transaction (depth_now == started_at_depth + 1) rather than a
    /// nested savepoint that the user forgot to release.
    public fn started_at_depth(&self) -> Int { self.started_at_depth }

    /// The isolation flavour this transaction began with.
    public fn kind(&self) -> TxKind { self.kind }

    /// Render the kind as the SQL keyword we'd emit on BEGIN.
    public fn begin_keyword(&self) -> Text {
        match self.kind {
            TkDeferred  => "DEFERRED".clone(),
            TkImmediate => "IMMEDIATE".clone(),
            TkExclusive => "EXCLUSIVE".clone(),
        }
    }
}
