// =============================================================================
// session/change.vr — Change record + ChangeSet container
// =============================================================================
// Spec: sqlite-native.md §22 (CDC) — sqlite3session_changeset
//

// A `Change` is one INSERT / UPDATE / DELETE event:
//

//  * `op` — what happened
//  * `table` — fully-qualified name (`schema.table`)
//  * `pk_columns` — bitset of columns that form the primary key
//  (carried in the changeset so the applier can
//  skip a schema lookup)
//  * `old_row` — column values BEFORE the change
//  (empty for INSERT)
//  * `new_row` — column values AFTER the change
//  (empty for DELETE)
//

// `ChangeSet` is a sequence of `Change` records in commit order.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.session.change;

mount base.{Text, Bool, Maybe};
mount collections.List;
mount core.base.protocols.Clone;
mount core.database.sqlite.native.l4_vdbe.register.Register;

// -----------------------------------------------------------------------------
// Op
// -----------------------------------------------------------------------------

public type SessionChangeOp is OpInsert | OpUpdate | OpDelete;

public fn change_op_name(o: &SessionChangeOp) -> Text {
    match o {
        OpInsert => "INSERT".clone(),
        OpUpdate => "UPDATE".clone(),
        OpDelete => "DELETE".clone(),
    }
}

public fn change_op_code(o: &SessionChangeOp) -> Int {
    match o {
        OpInsert => 18,    // SQLITE_INSERT
        OpUpdate => 23,    // SQLITE_UPDATE
        OpDelete => 9,     // SQLITE_DELETE
    }
}

// -----------------------------------------------------------------------------
// Change
// -----------------------------------------------------------------------------

public type Change is {
    op: SessionChangeOp,
    table: Text,
    /// True for each column that is part of the primary key.
    /// Length matches the table's column count.
    pk_columns: List<Bool>,
    old_row: List<Register>,
    new_row: List<Register>,
}

public fn change_insert(table: Text, pk_columns: List<Bool>, new_row: List<Register>) -> Change {
    Change {
        op: OpInsert,
        table: table,
        pk_columns: pk_columns,
        old_row: List.new(),
        new_row: new_row,
    }
}

public fn change_update(
    table: Text,
    pk_columns: List<Bool>,
    old_row: List<Register>,
    new_row: List<Register>,
) -> Change {
    Change {
        op: OpUpdate,
        table: table,
        pk_columns: pk_columns,
        old_row: old_row,
        new_row: new_row,
    }
}

public fn change_delete(table: Text, pk_columns: List<Bool>, old_row: List<Register>) -> Change {
    Change {
        op: OpDelete,
        table: table,
        pk_columns: pk_columns,
        old_row: old_row,
        new_row: List.new(),
    }
}

implement Clone for SessionChangeOp {
    fn clone(&self) -> SessionChangeOp {
        match self { OpInsert => OpInsert, OpUpdate => OpUpdate, OpDelete => OpDelete }
    }
}

implement Clone for Change {
    fn clone(&self) -> Change {
        Change {
            op: self.op.clone(),
            table: self.table.clone(),
            pk_columns: self.pk_columns.clone(),
            old_row: self.old_row.clone(),
            new_row: self.new_row.clone(),
        }
    }
}

implement Change {
    public fn column_count(&self) -> Int { self.pk_columns.len() }

    public fn operation(&self) -> SessionChangeOp { self.op.clone() }
    public fn table_name(&self) -> &Text { &self.table }
    public fn key_columns(&self) -> &[Bool] { self.pk_columns.as_slice() }
    public fn old_values(&self) -> &[Register] { self.old_row.as_slice() }
    public fn new_values(&self) -> &[Register] { self.new_row.as_slice() }

    fn key_row(&self) -> &[Register] {
        match self.op { OpInsert => self.new_values(), _ => self.old_values() }
    }

    /// Extract the complete key in schema order. Each flagged column must be present.
    public fn primary_key(&self) -> List<Register> {
        let row = self.key_row();
        let mut key: List<Register> = List.new();
        let mut i = 0;
        while i < self.pk_columns.len() {
            if self.pk_columns[i] {
                assert(i < row.len(), "changeset row is missing a primary-key column");
                key.push(row[i].clone());
            }
            i = i + 1;
        }
        key
    }

    public(in core.database.sqlite.native.session) fn inverted(&self) -> Change {
        let table = self.table.clone();
        let mask = self.pk_columns.clone();
        match self.op {
            OpInsert => change_delete(table, mask, self.new_row.clone()),
            OpDelete => change_insert(table, mask, self.old_row.clone()),
            OpUpdate => change_update(table, mask, self.new_row.clone(), self.old_row.clone()),
        }
    }

    /// Compare the primary-key columns of two changes on the same table.
    public fn pk_matches(&self, other: &Change) -> Bool {
        if self.table != other.table { return false; }
        if self.pk_columns.len() != other.pk_columns.len() { return false; }
        let a = self.key_row();
        let b = other.key_row();
        let mut i: Int = 0;
        while i < self.pk_columns.len() {
            if self.pk_columns[i] != other.pk_columns[i] { return false; }
            if self.pk_columns[i] {
                if i >= a.len() || i >= b.len() { return false; }
                if !registers_equal(&a[i], &b[i]) { return false; }
            }
            i = i + 1;
        }
        true
    }
}

// -----------------------------------------------------------------------------
// ChangeSet
// -----------------------------------------------------------------------------

public type ChangeSet is {
    changes: List<Change>,
}

public fn changeset_empty() -> ChangeSet { ChangeSet { changes: List.new() } }

implement ChangeSet {
    public fn len(&self) -> Int { self.changes.len() }
    public fn is_empty(&self) -> Bool { self.changes.len() == 0 }

    public fn record(&mut self, c: Change) {
        self.changes.push(c);
    }

    /// Borrow the events in their recorded order.
    public fn entries(&self) -> &[Change] { self.changes.as_slice() }

    /// Return independent copies of the recorded events.
    public fn iter(&self) -> List<Change> { self.changes.clone() }

    /// Group changes by table — used by the applier to batch by
    /// target table and avoid repeatedly looking up schema metadata.
    public fn group_by_table(&self) -> List<(Text, List<Change>)> {
        let mut buckets: List<(Text, List<Change>)> = List.new();
        let mut i: Int = 0;
        while i < self.changes.len() {
            let table = self.changes[i].table.clone();
            let mut found_idx: Int = -1;
            let mut k: Int = 0;
            while k < buckets.len() {
                if buckets[k].0 == table { found_idx = k; break; }
                k = k + 1;
            }
            if found_idx < 0 {
                let mut bucket: List<Change> = List.new();
                bucket.push(self.changes[i].clone());
                buckets.push((table, bucket));
            } else {
                buckets[found_idx].1.push(self.changes[i].clone());
            }
            i = i + 1;
        }
        buckets
    }

    /// Per-table change counts — surface for telemetry / EXPLAIN.
    public fn table_summary(&self) -> List<(Text, Int)> {
        let groups = self.group_by_table();
        let mut out: List<(Text, Int)> = List.new();
        let mut i: Int = 0;
        while i < groups.len() {
            out.push((groups[i].0.clone(), groups[i].1.len()));
            i = i + 1;
        }
        out
    }
}

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn registers_equal(a: &Register, b: &Register) -> Bool {
    match a {
        Register.RNull => match b { Register.RNull => true, _ => false },
        Register.RInt(x) => match b {
            Register.RInt(y) => x == y,
            Register.RRowId(y) => x == y,
            _ => false,
        },
        Register.RReal(x) => match b {
            Register.RReal(y) => x == y,
            Register.RInt(y) => x == (y as Float64),
            _ => false,
        },
        Register.RText(xs) => match b { Register.RText(ys) => xs == ys, _ => false },
        Register.RBlob(xb) => match b { Register.RBlob(yb) => bytes_equal(xb, yb), _ => false },
        Register.RRowId(x) => match b {
            Register.RRowId(y) => x == y,
            Register.RInt(y) => x == y,
            _ => false,
        },
    }
}

fn bytes_equal(a: &List<Byte>, b: &List<Byte>) -> Bool {
    if a.len() != b.len() { return false; }
    let mut i: Int = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    true
}
