// =============================================================================
// session/patch.vr — PatchSet (compact form of ChangeSet)
// =============================================================================
// Spec: sqlite-native.md §22 (CDC) — sqlite3session_patchset
//

// `SessionPatch` is the compact analogue of `Change`: only the modified
// columns are present, with NULL standing for "unchanged" in the
// `new_row`. Used when the consumer doesn't need OLD row values
// and bandwidth matters (replication over WAN).
//

// Conversion `ChangeSet → PatchSet` is lossy in two ways:
//  * OLD row is dropped except for primary-key columns
//  * NEW row drops cells that match OLD
//

// Reverse `PatchSet → ChangeSet` is impossible without the target
// database state (which the applier already has).
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.session.patch;

mount base.{Bool, Maybe};
mount collections.List;
mount core.database.sqlite.native.l4_vdbe.register.Register;
mount core.database.sqlite.native.session.change.{
    Change, SessionChangeOp, ChangeSet,
};

// -----------------------------------------------------------------------------
// PatchCell — Maybe.Some(value) means "set", Maybe.None means "unchanged"
// -----------------------------------------------------------------------------

public type PatchCell is { value: Maybe<Register> };

// -----------------------------------------------------------------------------
// SessionPatch
// -----------------------------------------------------------------------------

public type SessionPatch is {
    op: SessionChangeOp,
    table: Text,
    pk_columns: List<Bool>,
    /// PK column values (used to locate the target row).
    pk_values: List<Register>,
    /// New value per column; Maybe.None for cells unchanged from OLD.
    new_cells: List<PatchCell>,
}

implement PatchCell {
    /// None preserves the old value. Some(RNull) writes SQL NULL.
    public fn value(&self) -> &Maybe<Register> { &self.value }
}

implement SessionPatch {
    public fn operation(&self) -> SessionChangeOp { self.op.clone() }
    public fn table_name(&self) -> &Text { &self.table }
    public fn key_columns(&self) -> &[Bool] { self.pk_columns.as_slice() }
    public fn primary_key(&self) -> &[Register] { self.pk_values.as_slice() }
    public fn cells(&self) -> &[PatchCell] { self.new_cells.as_slice() }
}

// -----------------------------------------------------------------------------
// PatchSet
// -----------------------------------------------------------------------------

public type PatchSet is { patches: List<SessionPatch> }

public fn patchset_empty() -> PatchSet { PatchSet { patches: List.new() } }

implement PatchSet {
    public fn len(&self) -> Int { self.patches.len() }
    public fn entries(&self) -> &[SessionPatch] { self.patches.as_slice() }

    public fn record(&mut self, p: SessionPatch) {
        self.patches.push(p);
    }
}

// -----------------------------------------------------------------------------
// Conversion: ChangeSet → PatchSet
// -----------------------------------------------------------------------------

public fn from_changeset(cs: &ChangeSet) -> PatchSet {
    let mut out = patchset_empty();
    let changes = cs.entries();
    let mut i: Int = 0;
    while i < changes.len() {
        out.record(patch_from_change(&changes[i]));
        i = i + 1;
    }
    out
}

fn patch_from_change(c: &Change) -> SessionPatch {
    let before = c.old_values();
    let after = c.new_values();
    let mut new_cells: List<PatchCell> = List.new();
    match c.operation() {
        SessionChangeOp.OpInsert => {
            // Every cell present.
            let mut i: Int = 0;
            while i < after.len() {
                new_cells.push(PatchCell { value: Maybe.Some(after[i].clone()) });
                i = i + 1;
            }
        }
        SessionChangeOp.OpUpdate => {
            // Maybe.None for cells that didn't change.
            let mut i: Int = 0;
            while i < after.len() {
                let unchanged: Bool = if i < before.len() {
                    registers_equal(&before[i], &after[i])
                } else { false };
                if unchanged {
                    new_cells.push(PatchCell { value: Maybe.None });
                } else {
                    new_cells.push(PatchCell { value: Maybe.Some(after[i].clone()) });
                }
                i = i + 1;
            }
        }
        SessionChangeOp.OpDelete => {
            // No new values for delete.
        }
    }
    SessionPatch {
        op: c.operation(),
        table: c.table_name().clone(),
        pk_columns: List.from_slice(c.key_columns()),
        pk_values: c.primary_key(),
        new_cells: new_cells,
    }
}

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn registers_equal(a: &Register, b: &Register) -> Bool {
    match a {
        Register.RNull => match b { Register.RNull => true, _ => false },
        Register.RInt(x) => match b {
            Register.RInt(y) => x == y,
            Register.RRowId(y) => x == y,
            _ => false,
        },
        Register.RReal(x) => match b {
            Register.RReal(y) => x == y,
            _ => false,
        },
        Register.RText(xs) => match b { Register.RText(ys) => xs == ys, _ => false },
        Register.RBlob(xb) => match b {
            Register.RBlob(yb) => {
                if xb.len() != yb.len() { return false; }
                let mut i: Int = 0;
                while i < xb.len() {
                    if xb[i] != yb[i] { return false; }
                    i = i + 1;
                }
                true
            }
            _ => false,
        },
        Register.RRowId(x) => match b { Register.RRowId(y) => x == y, _ => false },
    }
}
