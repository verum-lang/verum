@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.cursor_table;

// =============================================================================
// l4_vdbe/cursor_table.vr — per-program cursor registry
// =============================================================================
// Layer: 4
// Spec: sqlite-native.md §11.3
//

// Each VDBE program declares its cursors at build time (via
// `VdbeProgram.declare_cursor`) and the interpreter opens real
// L3 BtreeCursors lazily when it encounters an `OpenRead` / `OpenWrite`
// / `OpenEphemeral` / `SorterOpen` opcode. The `CursorTable` is the
// slot array the interpreter consults on every cursor-bound opcode
// (`Column`, `Next`, `SeekGE`, …).
//

// Ownership:
//

//  * The program owns the cursor *declarations* (metadata — root
//  page, n_cols, kind).
//  * The interpreter owns the cursor *instances* — live L3
//  BtreeCursors, ephemeral in-memory B-trees, sorter state.
//

// Cursor slots are typed via a small sum so the interpreter can
// dispatch without looking up the declaration again. Ephemeral and
// sorter slots lazily construct their backing store on first use.
// =============================================================================

mount collections.{List, Map};
mount base.{Result, Ok, Err, Text, Maybe};
mount core.database.sqlite.native.l3_btree.{
    Btree, BtreeCursor, BtreeKind,
    btree_new, cursor_new, cursor_root,
};
mount core.database.sqlite.native.l3_btree.cursor.PathStep;
mount core.database.sqlite.native.l3_btree.record_compare.{
    RecordColumnSchema, RecordSchema, record_schema_binary,
};
mount core.database.sqlite.native.l2_record.collation.{
    CollationKind, Binary, Nocase, Rtrim, UserDefined,
    CollationRegistry, binary_cmp, nocase_cmp, rtrim_cmp,
};
mount core.base.ordering.{Ordering, Less, Equal, Greater};
mount core.database.sqlite.native.l4_vdbe.register.Register;

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

public type CursorSlotKind is
      CskClosed
    | CskBtree                      // real B-tree cursor backed by the pager
    | CskEphemeral                  // in-memory temp B-tree (OpenEphemeral)
    | CskSorter;                    // sort-only ephemeral

public type CursorSlot is {
    kind: CursorSlotKind,
    cursor_id: Int,
    root_page: Int,
    n_cols: Int,
    // Backing tree — only set when kind is CskBtree / CskEphemeral.
    // Sorter stores nothing here; its state lives in SorterTable below.
    btree: Maybe<Btree>,
    // Active cursor position. Maybe.None until the cursor is Rewound / Seek'd.
    position: Maybe<BtreeCursor>,
    // Whether this cursor was opened for writing. OpenWrite sets this;
    // OpenRead leaves it false. Used to reject Insert/Delete on
    // read-only cursors.
    writable: Bool,
    // Cursor position is local; persistent rows belong to their root page.
    row_bank: Int,
    pos: Int,
};

// -----------------------------------------------------------------------------
// Row comparison helpers (used by sort_by_prefix)
// -----------------------------------------------------------------------------

/// Three-way compare of two registers. Returns -1 / 0 / 1.
/// Rules follow SQLite's type-affinity rough order:
///  NULL < numeric < text < blob
/// Within numeric, ints and reals compare via Float64 widening.
fn cmp_register(a: &Register, b: &Register) -> Int {
    // Dispatch on both tags.
    match a {
        RNull => match b {
            RNull => 0,
            _     => -1,
        },
        RInt(x) => match b {
            RNull     => 1,
            RInt(y)   => if x < y { -1 } else if x > y { 1 } else { 0 },
            RRowId(y) => if x < y { -1 } else if x > y { 1 } else { 0 },
            RReal(y)  => {
                let xf: Float64 = (x as Float64);
                if xf < y { -1 } else if xf > y { 1 } else { 0 }
            }
            RText(_)  => -1,
            RBlob(_)  => -1,
        },
        RRowId(x) => match b {
            RNull     => 1,
            RInt(y)   => if x < y { -1 } else if x > y { 1 } else { 0 },
            RRowId(y) => if x < y { -1 } else if x > y { 1 } else { 0 },
            RReal(y)  => {
                let xf: Float64 = (x as Float64);
                if xf < y { -1 } else if xf > y { 1 } else { 0 }
            }
            RText(_)  => -1,
            RBlob(_)  => -1,
        },
        RReal(x) => match b {
            RNull     => 1,
            RInt(y)   => {
                let yf: Float64 = (y as Float64);
                if x < yf { -1 } else if x > yf { 1 } else { 0 }
            }
            RRowId(y) => {
                let yf: Float64 = (y as Float64);
                if x < yf { -1 } else if x > yf { 1 } else { 0 }
            }
            RReal(y)  => if x < y { -1 } else if x > y { 1 } else { 0 },
            RText(_)  => -1,
            RBlob(_)  => -1,
        },
        RText(ref xs) => match b {
            RNull     => 1,
            RInt(_) | RReal(_) | RRowId(_) => 1,
            RText(ref ys) => {
                if xs < ys { -1 } else if xs > ys { 1 } else { 0 }
            }
            RBlob(_) => -1,
        },
        RBlob(ref xs) => match b {
            RNull => 1,
            RInt(_) | RReal(_) | RRowId(_) | RText(_) => 1,
            RBlob(ref ys) => {
                // Byte-wise compare.
                let na = xs.len();
                let nb = ys.len();
                let mut i: Int = 0;
                let mn = if na < nb { na } else { nb };
                while i < mn {
                    let xi = xs[i] as Int;
                    let yi = ys[i] as Int;
                    if xi < yi { return -1; }
                    if xi > yi { return 1; }
                    i = i + 1;
                }
                if na < nb { -1 } else if na > nb { 1 } else { 0 }
            }
        },
    }
}

/// Compare two rows using the first `n_keys` cells as sort keys.
/// `dir_bits` bitmask: bit k set → key k is DESC.
fn compare_rows_prefix(
    a: &List<Register>,
    b: &List<Register>,
    n_keys: Int,
    dir_bits: Int,
) -> Int {
    let mut k: Int = 0;
    while k < n_keys {
        if k >= a.len() || k >= b.len() { return 0; }
        let c = cmp_register(&a[k], &b[k]);
        if c != 0 {
            let desc = ((dir_bits >> k) & 1) == 1;
            if desc { return -c; } else { return c; }
        }
        k = k + 1;
    }
    0
}

/// Schema-aware row comparator (#157).  Same shape as
/// `compare_rows_prefix` but each TEXT comparison runs through the
/// per-column collation chosen by `schema`.  Non-text registers fall
/// back to the existing `cmp_register` semantics (which already
/// implements SQLite's type-class ordering).  `dir_bits` overrides
/// `schema[k].desc` when the bit is set — the L5 ORDER BY codegen
/// uses dir_bits as the canonical source-of-truth, schema.desc is
/// the per-index default.
fn compare_rows_prefix_with_schema(
    a: &List<Register>,
    b: &List<Register>,
    n_keys: Int,
    dir_bits: Int,
    schema: &RecordSchema,
    registry: Maybe<&CollationRegistry>,
) -> Int {
    let mut k: Int = 0;
    while k < n_keys {
        if k >= a.len() || k >= b.len() { return 0; }
        // Pick the collation for this key column; default to BINARY
        // when the schema is shorter than the key prefix.
        let coll: CollationKind = if k < schema.columns.len() {
            clone_collation_kind(&schema.columns[k].collation)
        } else {
            Binary
        };
        let c = cmp_register_with_collation(&a[k], &b[k], &coll, registry);
        if c != 0 {
            let bit_desc = ((dir_bits >> k) & 1) == 1;
            let sch_desc = if k < schema.columns.len() { schema.columns[k].desc } else { false };
            let desc = bit_desc || sch_desc;
            if desc { return -c; } else { return c; }
        }
        k = k + 1;
    }
    0
}

fn clone_collation_kind(k: &CollationKind) -> CollationKind {
    match k {
        Binary => Binary,
        Nocase => Nocase,
        Rtrim => Rtrim,
        UserDefined(ref name) => UserDefined(name.clone()),
    }
}

/// Per-register comparator with per-column collation dispatch.  When
/// both sides are RText, dispatches through `coll` + `registry`.
/// Otherwise falls through to the standard `cmp_register` shape.
fn cmp_register_with_collation(
    a: &Register, b: &Register,
    coll: &CollationKind,
    registry: Maybe<&CollationRegistry>,
) -> Int {
    match a {
        RText(ref xs) => match b {
            RText(ref ys) => {
                let ord: Ordering = match coll {
                    Binary => binary_cmp(xs, ys),
                    Nocase => nocase_cmp(xs, ys),
                    Rtrim  => rtrim_cmp(xs, ys),
                    UserDefined(ref name) => match registry {
                        Maybe.Some(r) => match r.user_fn_for(name) {
                            Maybe.Some(fn_cmp) => fn_cmp(xs, ys),
                            Maybe.None => binary_cmp(xs, ys),
                        },
                        Maybe.None => binary_cmp(xs, ys),
                    },
                };
                match ord {
                    Less => -1,
                    Equal => 0,
                    Greater => 1,
                }
            }
            _ => cmp_register(a, b),
        }
        _ => cmp_register(a, b),
    }
}

fn cursor_slot_empty(cursor_id: Int) -> CursorSlot {
    CursorSlot {
        kind: CskClosed,
        cursor_id: cursor_id,
        root_page: 0,
        n_cols: 0,
        btree: Maybe.None,
        position: Maybe.None,
        writable: false,
        row_bank: cursor_id,
        pos: 0,
    }
}

public type CursorTableError is
      NoSuchSlot(cursor_id: Int)
    | AlreadyOpen(cursor_id: Int)
    | WrongKind(cursor_id: Int, expected: Text)
    | WriteOnReadOnly(cursor_id: Int);

implement Display for CursorTableError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            NoSuchSlot(id)            => f.write_str(f"sqlite VDBE cursor: no such slot {id}".as_str()),
            AlreadyOpen(id)           => f.write_str(f"sqlite VDBE cursor: slot {id} already open".as_str()),
            WrongKind(id, expected)   => f.write_str(f"sqlite VDBE cursor {id}: wrong kind, expected {expected}".as_str()),
            WriteOnReadOnly(id)       => f.write_str(f"sqlite VDBE cursor {id}: write on read-only cursor".as_str()),
        }
    }
}

implement Debug for CursorTableError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            NoSuchSlot(id)            => f.write_str(f"NoSuchSlot(cursor_id: {id})".as_str()),
            AlreadyOpen(id)           => f.write_str(f"AlreadyOpen(cursor_id: {id})".as_str()),
            WrongKind(id, expected)   => f.write_str(f"WrongKind(cursor_id: {id}, expected: {expected})".as_str()),
            WriteOnReadOnly(id)       => f.write_str(f"WriteOnReadOnly(cursor_id: {id})".as_str()),
        }
    }
}

implement PartialEq for CursorTableError {
    fn eq(&self, other: &CursorTableError) -> Bool {
        match (self, other) {
            (NoSuchSlot(a),          NoSuchSlot(b))          => a == b,
            (AlreadyOpen(a),         AlreadyOpen(b))         => a == b,
            (WrongKind(ia, ea),      WrongKind(ib, eb))      => ia == ib && ea == eb,
            (WriteOnReadOnly(a),     WriteOnReadOnly(b))     => a == b,
            _ => false,
        }
    }
}

implement Eq for CursorTableError {}

// -----------------------------------------------------------------------------
// Cursor table
// -----------------------------------------------------------------------------

type RowBank is {
    root_page: Int,
    revision: Int,
    rows: List<List<Register>>,
    next_rowid: Int64,
    dirty: Bool,
};

public(in core.database.sqlite.native) type CursorWriteback is {
    public(in core.database.sqlite.native) root_page: Int,
    public(in core.database.sqlite.native) revision: Int,
    public(in core.database.sqlite.native) rows: List<List<Register>>,
};

fn row_bank(root_page: Int, revision: Int, rows: List<List<Register>>) -> RowBank {
    let next_rowid = (rows.len() as Int64) + 1_i64;
    RowBank { root_page, revision, rows, next_rowid, dirty: false }
}

public type CursorTable is {
    banks: List<RowBank>,
    slots: List<CursorSlot>,
    page_size: Int,
    reserved_bytes: Int,
};

/// Build a fresh table sized for `n` cursors; each slot is CskClosed.
public fn cursor_table_new(n: Int, page_size: Int, reserved_bytes: Int) -> CursorTable {
    let mut slots: List<CursorSlot> = List.new();
    let mut banks: List<RowBank> = List.new();
    let mut i: Int = 0;
    while i < n {
        slots.push(cursor_slot_empty(i));
        banks.push(row_bank(0, 0, []));
        i = i + 1;
    }
    CursorTable {
        slots, banks,
        page_size: page_size,
        reserved_bytes: reserved_bytes,
    }
}

implement CursorTable {
    public fn size(&self) -> Int { self.slots.len() }

    // The first bank per cursor is reserved for transient rows. Persistent
    // banks are keyed by the actual OpenRead/OpenWrite root and outlive Close.
    fn root_bank(&self, root_page: Int) -> Int {
        let mut i = self.slots.len();
        while i < self.banks.len() {
            if self.banks[i].root_page == root_page { return i; }
            i = i + 1;
        }
        -1
    }

    public(in core.database.sqlite.native) fn has_root(&self, root_page: Int) -> Bool {
        self.root_bank(root_page) >= 0
    }

    public(in core.database.sqlite.native) fn seed_root(&mut self, root_page: Int, revision: Int, rows: List<List<Register>>) {
        if root_page > 0 && self.root_bank(root_page) < 0 {
            self.banks.push(row_bank(root_page, revision, rows));
        }
    }

    public(in core.database.sqlite.native) fn pending_writes(&self) -> List<CursorWriteback> {
        let mut writes: List<CursorWriteback> = List.new();
        let mut i = self.slots.len();
        while i < self.banks.len() {
            let bank = &self.banks[i];
            if bank.dirty {
                writes.push(CursorWriteback {
                    root_page: bank.root_page, revision: bank.revision, rows: bank.rows.clone(),
                });
            }
            i = i + 1;
        }
        writes
    }

    public(in core.database.sqlite.native) fn persistent_root(&self, cursor_id: Int) -> Int {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return 0; }
        self.banks[self.slots[cursor_id].row_bank].root_page
    }

    // ORDER BY and DISTINCT operate on a cursor's private result rows.
    fn detach_query_rows(&mut self, cursor_id: Int) {
        let bank = self.slots[cursor_id].row_bank;
        if bank != cursor_id {
            self.banks[cursor_id] = row_bank(0, 0, self.banks[bank].rows.clone());
            self.slots[cursor_id].row_bank = cursor_id;
            self.slots[cursor_id].writable = false;
        }
    }

    // -------------------------------------------------------------------------
    // OpenRead / OpenWrite
    // -------------------------------------------------------------------------

    public fn open_read(
        &mut self,
        cursor_id: Int,
        root_page: Int,
        n_cols: Int,
        kind: BtreeKind,
    ) -> Result<(), CursorTableError> {
        self.open_btree(cursor_id, root_page, n_cols, kind, false)
    }

    public fn open_write(
        &mut self,
        cursor_id: Int,
        root_page: Int,
        n_cols: Int,
        kind: BtreeKind,
    ) -> Result<(), CursorTableError> {
        self.open_btree(cursor_id, root_page, n_cols, kind, true)
    }

    fn open_btree(
        &mut self,
        cursor_id: Int,
        root_page: Int,
        n_cols: Int,
        kind: BtreeKind,
        writable: Bool,
    ) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        let existing = self.slots[cursor_id].kind;
        match existing {
            CskClosed => {}
            _         => { return Result.Err(AlreadyOpen(cursor_id)); }
        }
        let tree = match btree_new(kind, root_page, self.page_size, self.reserved_bytes) {
            Result.Ok(t)  => t,
            Result.Err(_) => { return Result.Err(WrongKind(cursor_id, "btree_new".clone())); }
        };
        let mut bank = cursor_id;
        if root_page > 0 {
            bank = self.root_bank(root_page);
            if bank < 0 {
                bank = self.banks.len();
                self.banks.push(row_bank(root_page, 0, []));
            }
        }
        self.slots[cursor_id] = CursorSlot {
            kind: CskBtree,
            cursor_id: cursor_id,
            root_page: root_page,
            n_cols: n_cols,
            btree: Maybe.Some(tree),
            position: Maybe.None,
            writable: writable,
            row_bank: bank,
            pos: 0,
        };
        Result.Ok(())
    }

    // -------------------------------------------------------------------------
    // OpenEphemeral / SorterOpen
    // -------------------------------------------------------------------------

    public fn open_ephemeral(&mut self, cursor_id: Int, n_cols: Int) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        // Ephemeral tables are backed by a fresh in-memory btree at
        // synthetic root_page 0 (the cursor table notes the
        // specialness via CskEphemeral; a real allocator lives in
        // L1 pager's temp-store path).
        self.slots[cursor_id] = CursorSlot {
            kind: CskEphemeral,
            cursor_id: cursor_id,
            root_page: 0,
            n_cols: n_cols,
            btree: Maybe.None,
            position: Maybe.None,
            writable: true,
            row_bank: cursor_id,
            pos: 0,
        };
        Result.Ok(())
    }

    public fn open_sorter(&mut self, cursor_id: Int) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        self.slots[cursor_id] = CursorSlot {
            kind: CskSorter,
            cursor_id: cursor_id,
            root_page: 0,
            n_cols: 0,
            btree: Maybe.None,
            position: Maybe.None,
            writable: true,
            row_bank: cursor_id,
            pos: 0,
        };
        Result.Ok(())
    }

    // -------------------------------------------------------------------------
    // Close / inspect
    // -------------------------------------------------------------------------

    public fn close(&mut self, cursor_id: Int) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        self.slots[cursor_id] = cursor_slot_empty(cursor_id);
        self.banks[cursor_id] = row_bank(0, 0, []);
        Result.Ok(())
    }

    public fn kind(&self, cursor_id: Int) -> CursorSlotKind {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return CskClosed;
        }
        self.slots[cursor_id].kind
    }

    public fn is_writable(&self, cursor_id: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return false;
        }
        self.slots[cursor_id].writable
    }

    // -------------------------------------------------------------------------
    // Positioning
    // -------------------------------------------------------------------------

    public fn rewind(&mut self, cursor_id: Int) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        self.slots[cursor_id].pos = 0;
        // For CskBtree we *also* seat the B-tree cursor at the root
        // so page-backed streams can begin iteration. The row-store
        // path (CskEphemeral + v1 test harness) only needs pos=0.
        match self.slots[cursor_id].kind {
            CskBtree => {
                let btree_opt = self.slots[cursor_id].btree;
                match btree_opt {
                    Maybe.Some(ref tree) => {
                        let mut cur = cursor_new(tree);
                        let _ = cursor_root(&mut cur);
                        self.slots[cursor_id].position = Maybe.Some(cur);
                    }
                    Maybe.None => {}
                }
            }
            _ => {}
        }
        Result.Ok(())
    }

    /// Reject a write attempt on a read-only cursor. The interpreter
    /// calls this before any Insert / Delete opcode.
    public fn ensure_writable(&self, cursor_id: Int) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        if !self.slots[cursor_id].writable {
            return Result.Err(WriteOnReadOnly(cursor_id));
        }
        Result.Ok(())
    }

    // -------------------------------------------------------------------------
    // Row-store operations (in-memory cursor pipeline)
    // -------------------------------------------------------------------------

    /// Append a row to the cursor's row store. Used by INSERT
    /// opcodes AND by test harnesses that pre-populate ephemeral
    /// tables. Auto-issues the next rowid and returns it.
    public fn append_row(&mut self, cursor_id: Int, row: List<Register>) -> Result<Int64, CursorTableError> {
        self.ensure_writable(cursor_id)?;
        let idx = self.slots[cursor_id].row_bank;
        let bank = &mut self.banks[idx];
        bank.rows.push(row);
        bank.dirty = true;
        let rid = bank.next_rowid;
        bank.next_rowid = rid + 1_i64;
        Result.Ok(rid)
    }

    /// Bulk-install a row list. Used by the test harness and by the
    /// future pager streaming adapter.
    public fn install_rows(&mut self, cursor_id: Int, rows: List<List<Register>>) -> Result<(), CursorTableError> {
        if cursor_id < 0 || cursor_id >= self.slots.len() {
            return Result.Err(NoSuchSlot(cursor_id));
        }
        let idx = self.slots[cursor_id].row_bank;
        self.banks[idx].next_rowid = (rows.len() as Int64) + 1_i64;
        self.banks[idx].rows = rows;
        self.slots[cursor_id].pos = 0;
        Result.Ok(())
    }

    /// Has the cursor still got rows to emit? Used by the interpreter
    /// to decide whether Rewind/Next should fall through or jump.
    public fn has_more(&self, cursor_id: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        let s = &self.slots[cursor_id];
        s.pos < self.banks[s.row_bank].rows.len()
    }

    /// Advance the cursor. Returns true if a row is now current;
    /// false if the cursor has exhausted the store.
    public fn advance(&mut self, cursor_id: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        let s = &mut self.slots[cursor_id];
        s.pos = s.pos + 1;
        s.pos < self.banks[s.row_bank].rows.len()
    }

    /// Read column `col` of the current row. Returns RNull if the
    /// cursor is past the end or col is out of range.
    public fn peek_cell(&self, cursor_id: Int, col: Int) -> Register {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return RNull; }
        let s = &self.slots[cursor_id];
        if s.pos >= self.banks[s.row_bank].rows.len() { return RNull; }
        let row = &self.banks[s.row_bank].rows[s.pos];
        if col < 0 || col >= row.len() { return RNull; }
        row[col]
    }

    /// Clone the current row into a fresh List<Register>. Used by
    /// the ResultRow emission path that wants to hand the caller an
    /// owned row rather than a register-file slice.
    public fn peek_row(&self, cursor_id: Int) -> List<Register> {
        let mut out: List<Register> = List.new();
        if cursor_id < 0 || cursor_id >= self.slots.len() { return out; }
        let s = &self.slots[cursor_id];
        if s.pos >= self.banks[s.row_bank].rows.len() { return out; }
        let row = &self.banks[s.row_bank].rows[s.pos];
        let mut i: Int = 0;
        while i < row.len() {
            out.push(row[i]);
            i = i + 1;
        }
        out
    }

    /// Compare the cursor's current key (first `n_keys` columns of
    /// the current row) against `key_values`.  Returns `Maybe.Maybe.None`
    /// if the cursor is exhausted or the slot is invalid; otherwise
    /// `Maybe.Some(c)` where c is -1 / 0 / +1 from comparing column-by-
    /// column under the type-class ordering used by `cmp_register`
    /// (NULL < numeric < text < blob, with int/real promoted via
    /// Float64 widening).  `n_keys` is clamped to the row's column
    /// count and the key_values list length — short prefixes match.
    ///
    /// Used by Idx{GT,GE,LT,LE} opcodes for index range-scan upper-
    /// bound checks (#164).  The interpreter compares against the
    /// returned sign:
    ///   * IdxGT: jump if c > 0 (cursor.key > bound)
    ///   * IdxGE: jump if c >= 0
    ///   * IdxLT: jump if c < 0
    ///   * IdxLE: jump if c <= 0
    /// A `Maybe.None` return is interpreted as "past EOF" — every Idx*
    /// variant jumps so the loop terminates cleanly.
    public fn cmp_current_key_to(
        &self,
        cursor_id: Int,
        key_values: &List<Register>,
        n_keys: Int,
    ) -> Maybe<Int> {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return Maybe.None; }
        let s = &self.slots[cursor_id];
        if s.pos >= self.banks[s.row_bank].rows.len() { return Maybe.None; }
        let row = &self.banks[s.row_bank].rows[s.pos];
        let mut k: Int = 0;
        while k < n_keys {
            if k >= row.len() || k >= key_values.len() { break; }
            let c = cmp_register(&row[k], &key_values[k]);
            if c != 0 { return Maybe.Some(c); }
            k = k + 1;
        }
        Maybe.Some(0)
    }

    /// The rowid that would be assigned to the next appended row.
    /// NewRowid opcode reads this.
    public fn peek_next_rowid(&self, cursor_id: Int) -> Int64 {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return 0 as Int64; }
        self.banks[self.slots[cursor_id].row_bank].next_rowid
    }

    /// Table rows in this in-memory store use their current one-based
    /// position as rowid. Removing an earlier row changes that position.
    public fn current_rowid(&self, cursor_id: Int) -> Int64 {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return 0 as Int64; }
        let s = &self.slots[cursor_id];
        if s.pos >= self.banks[s.row_bank].rows.len() { return 0 as Int64; }
        (s.pos as Int64) + 1_i64
    }

    /// Remove the current row. Used by Delete opcode. Leaves pos
    /// unchanged so Next lands on the successor.
    public fn delete_current(&mut self, cursor_id: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        if !self.slots[cursor_id].writable { return false; }
        let pos = self.slots[cursor_id].pos;
        let idx = self.slots[cursor_id].row_bank;
        let bank = &mut self.banks[idx];
        if pos >= bank.rows.len() { return false; }
        let _ = bank.rows.remove(pos);
        bank.dirty = true;
        true
    }

    /// Overwrite the row at the current `pos` with `row`. Used by
    /// UPDATE codegen: evaluate per-column assignments into
    /// contiguous registers, then call this to commit.
    public fn replace_current_row(&mut self, cursor_id: Int, row: List<Register>) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        if !self.slots[cursor_id].writable { return false; }
        let pos = self.slots[cursor_id].pos;
        let idx = self.slots[cursor_id].row_bank;
        let bank = &mut self.banks[idx];
        if pos >= bank.rows.len() { return false; }
        bank.rows[pos] = row;
        bank.dirty = true;
        true
    }

    /// Total rows currently in the store.
    public fn row_count(&self, cursor_id: Int) -> Int {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return 0; }
        self.banks[self.slots[cursor_id].row_bank].rows.len()
    }

    public fn current_position(&self, cursor_id: Int) -> Int {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return -1; }
        self.slots[cursor_id].pos
    }

    /// Number of columns declared at open time. Interpreter reads
    /// this to know how many registers an Insert's data_reg range
    /// covers.
    public fn n_cols_of(&self, cursor_id: Int) -> Int {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return 0; }
        self.slots[cursor_id].n_cols
    }

    /// Read a specific cell at an explicit position. Does NOT touch
    /// the cursor's current `pos`; used by the L6 writeback bridge
    /// to extract all rows back to the connection's table_store.
    public fn peek_cell_at(&self, cursor_id: Int, pos: Int, col: Int) -> Register {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return RNull; }
        let s = &self.slots[cursor_id];
        if pos < 0 || pos >= self.banks[s.row_bank].rows.len() { return RNull; }
        let row = &self.banks[s.row_bank].rows[pos];
        if col < 0 || col >= row.len() { return RNull; }
        row[col]
    }

    /// Clone the entire row at `pos`.
    public fn peek_row_at(&self, cursor_id: Int, pos: Int) -> List<Register> {
        let mut out: List<Register> = List.new();
        if cursor_id < 0 || cursor_id >= self.slots.len() { return out; }
        let s = &self.slots[cursor_id];
        if pos < 0 || pos >= self.banks[s.row_bank].rows.len() { return out; }
        let row = &self.banks[s.row_bank].rows[pos];
        let mut i: Int = 0;
        while i < row.len() {
            out.push(row[i]);
            i = i + 1;
        }
        out
    }

    /// Remove adjacent rows that agree on the first `n_cells` cells.
    /// Intended to follow `sort_by_prefix` for SELECT DISTINCT paths.
    public fn dedup_adjacent(&mut self, cursor_id: Int, n_cells: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        if n_cells <= 0 { return true; }
        self.detach_query_rows(cursor_id);
        let bank = &mut self.banks[cursor_id];
        let mut kept: List<List<Register>> = List.new();
        let mut i: Int = 0;
        while i < bank.rows.len() {
            let push_it = if kept.len() == 0 {
                true
            } else {
                let prev = &kept[kept.len() - 1];
                compare_rows_prefix(prev, &bank.rows[i], n_cells, 0) != 0
            };
            if push_it { kept.push(bank.rows[i].clone()); }
            i = i + 1;
        }
        bank.rows = kept;
        self.slots[cursor_id].pos = 0;
        true
    }

    /// In-place stable sort of the row-store by the first `n_keys`
    /// cells of each row. `dir_bits` is a bitmask: bit k set → key k
    /// is DESC. Used by the SortRowStore opcode backing ORDER BY.
    public fn sort_by_prefix(&mut self, cursor_id: Int, n_keys: Int, dir_bits: Int) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        if n_keys <= 0 { return true; }
        self.detach_query_rows(cursor_id);
        let bank = &mut self.banks[cursor_id];
        // Stable insertion sort — v1 row counts are bounded by the
        // test-harness row-store; real pager streams will back a
        // merge-based sorter later.
        let n = bank.rows.len();
        let mut i: Int = 1;
        while i < n {
            let mut j: Int = i;
            while j > 0 {
                let cmp = compare_rows_prefix(&bank.rows[j - 1], &bank.rows[j], n_keys, dir_bits);
                if cmp <= 0 { break; }
                let tmp = bank.rows[j - 1].clone();
                bank.rows[j - 1] = bank.rows[j].clone();
                bank.rows[j] = tmp;
                j = j - 1;
            }
            i = i + 1;
        }
        true
    }

    /// Schema-aware variant of `sort_by_prefix` (#157) — for ORDER
    /// BY clauses that reference a column with an explicit COLLATE
    /// modifier OR that sort an indexed column whose schema declares
    /// a non-BINARY collation.  `schema` provides per-key collation
    /// + per-key DESC default; `dir_bits` overrides DESC for keys
    /// whose bit is set.  `registry` carries any user-defined
    /// comparator fns referenced via `UserDefined(name)`.
    public fn sort_by_prefix_with_schema(
        &mut self,
        cursor_id: Int,
        n_keys: Int,
        dir_bits: Int,
        schema: &RecordSchema,
        registry: Maybe<&CollationRegistry>,
    ) -> Bool {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return false; }
        if n_keys <= 0 { return true; }
        self.detach_query_rows(cursor_id);
        let bank = &mut self.banks[cursor_id];
        let n = bank.rows.len();
        let mut i: Int = 1;
        while i < n {
            let mut j: Int = i;
            while j > 0 {
                let cmp = compare_rows_prefix_with_schema(
                    &bank.rows[j - 1], &bank.rows[j], n_keys, dir_bits, schema, registry,
                );
                if cmp <= 0 { break; }
                let tmp = bank.rows[j - 1].clone();
                bank.rows[j - 1] = bank.rows[j].clone();
                bank.rows[j] = tmp;
                j = j - 1;
            }
            i = i + 1;
        }
        true
    }

    /// Snapshot every row into a fresh List<List<Register>>. Used by
    /// the bridge to write back to the connection's table_store
    /// after a prepared statement finishes.
    public fn snapshot_rows(&self, cursor_id: Int) -> List<List<Register>> {
        let mut out: List<List<Register>> = List.new();
        if cursor_id < 0 || cursor_id >= self.slots.len() { return out; }
        let row_total = self.banks[self.slots[cursor_id].row_bank].rows.len();
        let mut i: Int = 0;
        while i < row_total {
            out.push(self.peek_row_at(cursor_id, i));
            i = i + 1;
        }
        out
    }

    // -------------------------------------------------------------------------
    // B-tree cursor accessors — used by cursor_btree_dispatch.vr (#147)
    // -------------------------------------------------------------------------

    /// Read the slot's BtreeCursor by clone.  Returns Maybe.None when the
    /// slot is closed OR has no position (cursor opened but not yet
    /// rewound/seeked).  Used by Column / RowIdOp dispatch which
    /// only need an immutable view.
    public fn btree_cursor_for(&self, cursor_id: Int) -> Maybe<BtreeCursor> {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return Maybe.None; }
        match &self.slots[cursor_id].position {
            Maybe.Some(c) => Maybe.Some(clone_btree_cursor(c)),
            Maybe.None    => Maybe.None,
        }
    }

    /// Mutable variant — same as `btree_cursor_for` but for opcodes
    /// that need to advance the cursor (Next/Prev/Rewind/Seek).
    /// Caller must follow up with `store_btree_cursor` to write back
    /// the mutated cursor.
    public fn btree_cursor_mut_for(&self, cursor_id: Int) -> Maybe<BtreeCursor> {
        self.btree_cursor_for(cursor_id)
    }

    /// Persist a (potentially mutated) BtreeCursor back into the
    /// slot.  No-op if the slot is closed.
    public fn store_btree_cursor(&mut self, cursor_id: Int, cursor: BtreeCursor) {
        if cursor_id < 0 || cursor_id >= self.slots.len() { return; }
        self.slots[cursor_id].position = Maybe.Some(cursor);
    }
}

/// Deep-clone a BtreeCursor — its `path` is a List<PathStep>.
fn clone_btree_cursor(src: &BtreeCursor) -> BtreeCursor {
    let mut path: List<PathStep> = List.new();
    let mut i: Int = 0;
    while i < src.path.len() {
        path.push(PathStep {
            page_no: src.path[i].page_no,
            cell_index: src.path[i].cell_index,
        });
        i = i + 1;
    }
    BtreeCursor {
        root_page: src.root_page,
        page_size: src.page_size,
        path: path,
        valid: src.valid,
        at_end: src.at_end,
    }
}
