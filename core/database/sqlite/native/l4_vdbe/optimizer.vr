@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.optimizer;

// =============================================================================
// l4_vdbe/optimizer.vr — Pre-emission peephole passes
// =============================================================================
// Layer: 4
// Spec: sqlite-native.md §11.5
//

// Before handing a `VdbeProgram` to the interpreter, the codegen runs
// a small set of purity-preserving passes to eliminate obvious waste:
//

//  * Noop elimination — drop `Noop` instructions and renumber
//  jump targets.
//  * Jump threading — `Goto A; A: Goto B` → `Goto B`.
//  * Constant folding (Add) — `Integer 1 → r1; Integer 2 → r2;
//  Add r1 r2 → r3` → `Integer 3 → r3`.
//  * Dead-register writes — `SCopy r1 → r2` when r2 is never read
//  before next overwrite.
//

// For now we ship Noop elimination + Jump threading + one-shot
// constant fold for Add/Subtract/Multiply. The remaining passes will
// land with the planner work in L5.
// =============================================================================

mount collections.List;
mount base.{Text, Maybe};
mount core.database.sqlite.native.l4_vdbe.opcode.{Opcode, clone_opcode};
mount core.database.sqlite.native.l4_vdbe.program.VdbeProgram;

// -----------------------------------------------------------------------------
// Pass: Noop elimination
// -----------------------------------------------------------------------------

/// Remove every `Noop` instruction and remap jump targets onto the new
/// position space. Returns the number of instructions removed.
public fn eliminate_noops(program: &mut VdbeProgram) -> Int {
    // First pass: build old_idx → new_idx mapping.
    let n = program.instructions.len();
    let mut new_idx: List<Int> = List.with_capacity(n + 1);
    let mut cur: Int = 0;
    let mut i: Int = 0;
    while i < n {
        // Each old instruction boundary maps to the number of retained
        // instructions before it, including a run of trailing Noops.
        new_idx.push(cur);
        if !(program.instructions[i] is Opcode.Noop) { cur = cur + 1; }
        i = i + 1;
    }
    new_idx.push(cur);
    // Second pass: rewrite with remapped jumps.
    if cur == n { return 0; }
    let mut new_ops: List<Opcode> = List.with_capacity(cur);
    let mut j: Int = 0;
    while j < n {
        match program.instructions[j] {
            Noop => {},
            _ => {
                let remapped = remap_jumps(&program.instructions[j], &new_idx);
                new_ops.push(remapped);
            }
        }
        j = j + 1;
    }
    let dropped = n - new_ops.len();
    program.instructions = new_ops;
    dropped
}

fn remap_one(target: Int, mapping: &List<Int>) -> Int {
    if target < 0 || target >= mapping.len() {
        return target;
    }
    mapping[target]
}

fn remap_jumps(op: &Opcode, mapping: &List<Int>) -> Opcode {
    match op {
        Init(t)           => Init(remap_one(t, mapping)),
        Goto(t)           => Goto(remap_one(t, mapping)),
        Gosub(r, t)       => Gosub(r, remap_one(t, mapping)),
        Once(t)           => Once(remap_one(t, mapping)),
        Eq(a, b, t)       => Eq(a, b, remap_one(t, mapping)),
        Ne(a, b, t)       => Ne(a, b, remap_one(t, mapping)),
        Lt(a, b, t)       => Lt(a, b, remap_one(t, mapping)),
        Le(a, b, t)       => Le(a, b, remap_one(t, mapping)),
        Gt(a, b, t)       => Gt(a, b, remap_one(t, mapping)),
        Ge(a, b, t)       => Ge(a, b, remap_one(t, mapping)),
        If(r, t)          => If(r, remap_one(t, mapping)),
        IfNot(r, t)       => IfNot(r, remap_one(t, mapping)),
        IfNull(r, t)      => IfNull(r, remap_one(t, mapping)),
        NotNull(r, t)     => NotNull(r, remap_one(t, mapping)),
        Rewind(c, t)      => Rewind(c, remap_one(t, mapping)),
        Last(c, t)        => Last(c, remap_one(t, mapping)),
        Next(c, t)        => Next(c, remap_one(t, mapping)),
        Prev(c, t)        => Prev(c, remap_one(t, mapping)),
        SeekGE(c, k, n, t) => SeekGE(c, k, n, remap_one(t, mapping)),
        SeekGT(c, k, n, t) => SeekGT(c, k, n, remap_one(t, mapping)),
        SeekLE(c, k, n, t) => SeekLE(c, k, n, remap_one(t, mapping)),
        SeekLT(c, k, n, t) => SeekLT(c, k, n, remap_one(t, mapping)),
        Found(c, t, k, n)    => Found(c, remap_one(t, mapping), k, n),
        NotFound(c, t, k, n) => NotFound(c, remap_one(t, mapping), k, n),
        IdxGT(c, t, k, n)    => IdxGT(c, remap_one(t, mapping), k, n),
        IdxGE(c, t, k, n)    => IdxGE(c, remap_one(t, mapping), k, n),
        IdxLT(c, t, k, n)    => IdxLT(c, remap_one(t, mapping), k, n),
        IdxLE(c, t, k, n)    => IdxLE(c, remap_one(t, mapping), k, n),
        SorterNext(c, t)     => SorterNext(c, remap_one(t, mapping)),
        other => clone_opcode(other),
    }
}

// -----------------------------------------------------------------------------
// Pass: Jump threading
// -----------------------------------------------------------------------------

/// Collapse chains `Goto A; A: Goto B; B: Goto C` → all outer jumps go
/// to C. Single linear scan, resolving each jump target by walking at
/// most `N` steps (where `N = instructions.len()`) to handle pathological
/// loops — returns to the original target on cycle detection.
public fn thread_jumps(program: &mut VdbeProgram) -> Int {
    let n = program.instructions.len();
    let mut changed: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let op = clone_opcode(&program.instructions[i]);
        let new_op = match op {
            Goto(t)           => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Goto(rt) } else { Goto(t) } }
            Eq(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Eq(a, b, rt) } else { Eq(a, b, t) } }
            Ne(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Ne(a, b, rt) } else { Ne(a, b, t) } }
            Lt(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Lt(a, b, rt) } else { Lt(a, b, t) } }
            Le(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Le(a, b, rt) } else { Le(a, b, t) } }
            Gt(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Gt(a, b, rt) } else { Gt(a, b, t) } }
            Ge(a, b, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; Ge(a, b, rt) } else { Ge(a, b, t) } }
            If(r, t)          => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; If(r, rt) } else { If(r, t) } }
            IfNot(r, t)       => { let rt = resolve_goto(t, &program.instructions, n); if rt != t { changed = changed + 1; IfNot(r, rt) } else { IfNot(r, t) } }
            other             => other,
        };
        program.instructions[i] = new_op;
        i = i + 1;
    }
    changed
}

fn resolve_goto(target: Int, ops: &List<Opcode>, budget: Int) -> Int {
    let mut cur = target;
    let mut steps: Int = 0;
    while steps < budget && cur >= 0 && cur < ops.len() {
        match ops[cur] {
            Goto(next) => {
                if next == cur { return cur; }   // self-loop guard
                cur = next;
                steps = steps + 1;
            }
            _ => { return cur; }
        }
    }
    cur
}

// -----------------------------------------------------------------------------
// Pass: Dead-code elimination
// -----------------------------------------------------------------------------

/// Drop instructions unreachable from PC 0 via fall-through + jump
/// edges.  Worklist algorithm: mark PC 0 reachable; for every reachable
/// instruction, mark its fall-through successor (if non-terminator)
/// AND its jump target (if any) reachable; iterate until fixed point;
/// drop instructions marked unreachable from the back.
///
/// Returns the number of instructions removed.  After this pass, jump
/// targets in the surviving program need re-mapping (call
/// `eliminate_noops` after — the index gaps left by removed
/// instructions are picked up via the same renumbering machinery).
///
/// Ported from the now-deleted `optimizer/dead_code.vr` parallel tree
/// (#133 — single-canonical-tree consolidation).
public fn eliminate_dead_code(program: &mut VdbeProgram) -> Int {
    let n = program.instructions.len();
    if n == 0 { return 0; }

    // Reachability mark.
    let mut reachable: List<Bool> = List.new();
    let mut i: Int = 0;
    while i < n { reachable.push(false); i = i + 1; }

    // Worklist seeded with PC 0 (entry).
    let mut worklist: List<Int> = List.new();
    worklist.push(0);
    reachable[0] = true;

    while let Maybe.Some(pc) = worklist.pop() {
        let op = &program.instructions[pc];

        // Fall-through successor (pc + 1) unless this is a terminator
        // or unconditional branch.
        if opcode_falls_through(op) {
            let nxt = pc + 1;
            if nxt < n && !reachable[nxt] {
                reachable[nxt] = true;
                worklist.push(nxt);
            }
        }

        // Jump targets.
        let targets = opcode_jump_targets(op);
        let mut t: Int = 0;
        while t < targets.len() {
            let tgt = targets[t];
            if tgt >= 0 && tgt < n && !reachable[tgt] {
                reachable[tgt] = true;
                worklist.push(tgt);
            }
            t = t + 1;
        }
    }

    // Replace dead instructions with Noop in place; the subsequent
    // `eliminate_noops` call handles index repacking + jump retarget.
    let mut edits: Int = 0;
    let mut j: Int = 0;
    while j < n {
        if !reachable[j] {
            program.instructions[j] = Noop;
            edits = edits + 1;
        }
        j = j + 1;
    }
    edits
}

/// `true` iff control falls through to PC+1 after `op` executes.
/// Halt, Return, Goto and Init have no fall-through. Once falls through on its first visit.
fn opcode_falls_through(op: &Opcode) -> Bool {
    match op {
        Halt(_, _)        => false,
        Return(_)         => false,
        Goto(_)           => false,
        Init(_)           => false,
        _                 => true,
    }
}

/// All jump-target instruction indices reachable from `op`.  Empty
/// for non-branching instructions.
fn opcode_jump_targets(op: &Opcode) -> List<Int> {
    let mut out: List<Int> = List.new();
    match op {
        Init(t)              => { out.push(t); }
        Goto(t)              => { out.push(t); }
        Gosub(_, t)          => { out.push(t); }
        Once(t)              => { out.push(t); }
        Eq(_, _, t)          => { out.push(t); }
        Ne(_, _, t)          => { out.push(t); }
        Lt(_, _, t)          => { out.push(t); }
        Le(_, _, t)          => { out.push(t); }
        Gt(_, _, t)          => { out.push(t); }
        Ge(_, _, t)          => { out.push(t); }
        If(_, t)             => { out.push(t); }
        IfNot(_, t)          => { out.push(t); }
        IfNull(_, t)         => { out.push(t); }
        NotNull(_, t)        => { out.push(t); }
        Rewind(_, t)         => { out.push(t); }
        Last(_, t)           => { out.push(t); }
        Next(_, t)           => { out.push(t); }
        Prev(_, t)           => { out.push(t); }
        SeekGE(_, _, _, t)   => { out.push(t); }
        SeekGT(_, _, _, t)   => { out.push(t); }
        SeekLE(_, _, _, t)   => { out.push(t); }
        SeekLT(_, _, _, t)   => { out.push(t); }
        Found(_, t, _, _)    => { out.push(t); }
        NotFound(_, t, _, _) => { out.push(t); }
        IdxGT(_, t, _, _)    => { out.push(t); }
        IdxGE(_, t, _, _)    => { out.push(t); }
        IdxLT(_, t, _, _)    => { out.push(t); }
        IdxLE(_, t, _, _)    => { out.push(t); }
        SorterNext(_, t)     => { out.push(t); }
        _ => {}
    }
    out
}

// -----------------------------------------------------------------------------
// Pass: Move-chain collapse
// -----------------------------------------------------------------------------

/// Forward a single-register move chain and clear its intermediate register.
/// A jump into the second move must still see the original register contents.
public fn collapse_move_chains(program: &mut VdbeProgram) -> Int {
    let n = program.instruction_count();
    if n < 2 { return 0; }
    let mut incoming: List<Bool> = List.with_capacity(n);
    let mut pc: Int = 0;
    while pc < n { incoming.push(false); pc = pc + 1; }
    pc = 0;
    while pc < n {
        let op = &program.instructions[pc];
        // A return resumes at a dynamic continuation outside the explicit jump targets.
        if op is Opcode.Return(_) { return 0; }
        for target in opcode_jump_targets(op) {
            if target >= 0 && target < n { incoming[target] = true; }
        }
        pc = pc + 1;
    }

    let mut edits: Int = 0;
    pc = 0;
    while pc + 1 < n {
        if !incoming[pc + 1] {
            let pair = move_chain(&program.instructions[pc], &program.instructions[pc + 1]);
            if let Maybe.Some((src, via, dst)) = pair {
                program.replace(pc, Opcode.Move(src, dst, 1));
                program.replace(pc + 1, Opcode.SoftNull(via));
                edits = edits + 1;
                pc = pc + 2;
                continue;
            }
        }
        pc = pc + 1;
    }
    edits
}

fn move_chain(first: &Opcode, second: &Opcode) -> Maybe<(Int, Int, Int)> {
    match (first, second) {
        (Opcode.Move(src, via, 1), Opcode.Move(next, dst, 1)) => {
            if *via == *next && *src != *via && *via != *dst && *src != *dst {
                return Maybe.Some((*src, *via, *dst));
            }
            Maybe.None
        }
        _ => Maybe.None,
    }
}

// -----------------------------------------------------------------------------
// Driver
// -----------------------------------------------------------------------------

/// Run every pass to fixed-point.  The passes are designed to converge
/// in O(1) iterations on well-formed programs but we run a small
/// fixed-point loop so passes that expose new opportunities for each
/// other (DCE → noop_elim → jump_threading) all benefit.
///
/// Order matters:
///   1. `thread_jumps`        — collapse Goto chains so DCE sees real targets
///   2. `collapse_move_chains` — forward moves with a single entry
///   3. `eliminate_dead_code`  — mark unreachable Noops
///   4. `eliminate_noops`     — drop Noops + retarget jumps
///
/// Returns the total number of edits across every pass + iteration.
public fn optimize(program: &mut VdbeProgram) -> Int {
    let max_iters: Int = 4;
    let mut total: Int = 0;
    let mut iter: Int = 0;
    while iter < max_iters {
        let threaded = thread_jumps(program);
        let collapsed = collapse_move_chains(program);
        let dead = eliminate_dead_code(program);
        let dropped = eliminate_noops(program);
        let iter_edits = threaded + collapsed + dead + dropped;
        total = total + iter_edits;
        if iter_edits == 0 { break; }
        iter = iter + 1;
    }
    total
}
