@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.dce;

// Follow SSA definitions from observable instructions and terminators, then
// remove unreferenced definitions in their original block order.

mount collections.List;
mount base.Maybe;
mount core.database.sqlite.native.l4_vdbe.ssa.value.{SsaValue, value_id_raw};
mount core.database.sqlite.native.l4_vdbe.ssa.inst.{SsaInst, inst_dst, inst_operands};
mount core.database.sqlite.native.l4_vdbe.ssa.block.block_id;
mount core.database.sqlite.native.l4_vdbe.ssa.program.SsaProgram;

public fn has_side_effect(inst: &SsaInst) -> Bool {
    match inst {
        IBranch(_, _, _)        => true,
        IJump(_)                => true,
        IHalt(_, _)             => true,
        IReturn(_)              => true,
        IYield(_)               => true,
        IResultRow(_)           => true,
        IAggStep(_, _, _)       => true,
        ICursorInsert(_, _, _, _) => true,
        ICursorDelete(_)        => true,
        ICursorOpen(_, _, _, _) => true,
        ICursorClose(_)         => true,
        ICursorRewind(_, _)     => true,
        ICursorNext(_, _)       => true,
        ICursorPrev(_, _)       => true,
        ICursorLast(_, _)       => true,
        ITransactionBegin(_)    => true,
        ITransactionCommit      => true,
        ITransactionRollback(_) => true,
        ICallFn(_, _, _)        => true,   // conservative — fn may have effects
        IAggFinal(_, _)          => true,   // finalization can invoke user code
        _                       => false,
    }
}

public type DceReport is {
    instructions_before: Int,
    instructions_after: Int,
    public(in core.database.sqlite.native.l4_vdbe.ssa) removed: Int,
    iterations: Int,
};

type LiveValues is {
    marked: List<Bool>,
    pending: List<Int>,
};

fn mark_operands(live: &mut LiveValues, operands: &List<SsaValue>) {
    for operand in operands {
        let id = value_id_raw(&operand.id());
        assert(id > 0 && id < live.marked.len(), "invalid SQLite SSA operand ID");
        if !live.marked[id] {
            live.marked[id] = true;
            live.pending.push(id);
        }
    }
}

fn record_instruction(inst: &SsaInst, defs: &mut List<Maybe<List<SsaValue>>>, live: &mut LiveValues) {
    let operands = inst_operands(inst);
    if has_side_effect(inst) { mark_operands(live, &operands); }
    match inst_dst(inst) {
        Maybe.Some(dst) => {
            let id = value_id_raw(&dst.id());
            assert(id > 0 && id < defs.len(), "invalid SQLite SSA definition ID");
            assert(defs[id] is Maybe.None, "duplicate SQLite SSA definition");
            defs[id] = Maybe.Some(operands);
        }
        Maybe.None => {}
    }
}

fn propagate(defs: &List<Maybe<List<SsaValue>>>, live: &mut LiveValues) -> Int {
    let mut next = 0;
    let mut rounds = 0;
    while next < live.pending.len() {
        let end = live.pending.len();
        rounds = rounds + 1;
        while next < end {
            let id = live.pending[next];
            match &defs[id] {
                Maybe.Some(inputs) => mark_operands(live, inputs),
                Maybe.None => {}
            }
            next = next + 1;
        }
    }
    rounds
}

fn keep_instruction(marked: &List<Bool>, inst: &SsaInst) -> Bool {
    if has_side_effect(inst) { return true; }
    match inst_dst(inst) {
        Maybe.Some(dst) => marked[value_id_raw(&dst.id())],
        Maybe.None => true,
    }
}

public fn run_dce(prog: &mut SsaProgram) -> DceReport {
    let before = prog.total_instr_count();
    let mut defs: List<Maybe<List<SsaValue>>> = List.new();
    let mut live = LiveValues { marked: List.new(), pending: List.new() };
    while defs.len() < prog.value_count() {
        defs.push(Maybe.None);
        live.marked.push(false);
    }
    let mut b = 0;
    while b < prog.block_count() {
        let block = prog.graph().get(&block_id(b));
        for phi in block.phis() { record_instruction(phi, &mut defs, &mut live); }
        for inst in block.instructions() { record_instruction(inst, &mut defs, &mut live); }
        record_instruction(block.terminator(), &mut defs, &mut live);
        b = b + 1;
    }
    let iterations = propagate(&defs, &mut live);
    let marked = &live.marked;
    b = 0;
    while b < prog.block_count() {
        prog.graph_mut().get_mut(&block_id(b)).retain_instructions(|inst| keep_instruction(marked, inst));
        b = b + 1;
    }
    let after = prog.total_instr_count();
    DceReport {
        instructions_before: before,
        instructions_after: after,
        removed: before - after,
        iterations: iterations,
    }
}
