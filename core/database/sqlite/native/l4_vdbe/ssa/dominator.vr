@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.dominator;

mount collections.List;
mount base.Maybe;
mount core.database.sqlite.native.l4_vdbe.ssa.block.{BlockId, block_id, block_id_raw};
mount core.database.sqlite.native.l4_vdbe.ssa.cfg.Cfg;

/// Dominance over the blocks reachable from the entry of a SQLite SSA graph.
public type DomTree is {
    entry: Int,
    idom: List<Int>,
    frontiers: List<List<BlockId>>,
};

/// Analyze the current terminators. The graph's predecessor cache may be stale.
public fn build_dom_tree(cfg: &Cfg) -> DomTree {
    let entry = block_id_raw(&cfg.entry_id());
    let graph = reachable_graph(cfg, entry);
    let idom = compute_idoms(&graph, entry);
    let frontiers = compute_frontiers(&graph, &idom);
    DomTree { entry: entry, idom: idom, frontiers: frontiers }
}

implement DomTree {
    /// The entry, unreachable blocks and unknown IDs have no immediate dominator.
    public fn immediate_dominator(&self, b: &BlockId) -> Maybe<BlockId> {
        let raw = block_id_raw(b);
        if raw < 0 || raw >= self.idom.len() { return Maybe.None; }
        let parent = self.idom[raw];
        if parent < 0 { return Maybe.None; }
        Maybe.Some(block_id(parent))
    }

    /// Whether every path from entry to reachable `b` passes through `a`.
    public fn dominates(&self, a: &BlockId, b: &BlockId) -> Bool {
        let target = block_id_raw(a);
        let mut cursor = block_id_raw(b);
        if cursor < 0 || cursor >= self.idom.len() { return false; }
        if cursor != self.entry && self.idom[cursor] < 0 { return false; }
        while cursor >= 0 {
            if cursor == target { return true; }
            cursor = self.idom[cursor];
        }
        false
    }

    /// Blocks with a predecessor dominated by `b` which `b` does not strictly dominate.
    public fn frontier_of(&self, b: &BlockId) -> List<BlockId> {
        let raw = block_id_raw(b);
        if raw < 0 || raw >= self.frontiers.len() { return List.new(); }
        self.frontiers[raw].clone()
    }
}

type ReachableGraph is {
    rpo: List<Int>,
    predecessors: List<List<Int>>,
};

type DfsStep is Visit(Int) | Finish(Int);

/// Record incoming reachable edges and reverse postorder in one depth-first traversal.
fn reachable_graph(cfg: &Cfg, entry: Int) -> ReachableGraph {
    let count = cfg.block_count();
    let mut seen: List<Bool> = List.from_elem(false, count);
    let mut predecessors: List<List<Int>> = List.new();
    let mut i = 0;
    while i < count { predecessors.push(List.new()); i = i + 1; }
    let mut order: List<Int> = List.new();
    let mut work: List<DfsStep> = List.new();
    work.push(DfsStep.Visit(entry));
    while let Maybe.Some(step) = work.pop() {
        match step {
            DfsStep.Visit(source) => {
                if !seen[source] {
                    seen[source] = true;
                    work.push(DfsStep.Finish(source));
                    let targets = cfg.get(&block_id(source)).successors();
                    let mut index = targets.len();
                    while index > 0 {
                        index = index - 1;
                        let target = block_id_raw(&targets[index]);
                        assert(target >= 0 && target < count, "invalid SQLite SSA successor");
                        predecessors[target].push(source);
                        work.push(DfsStep.Visit(target));
                    }
                }
            },
            DfsStep.Finish(source) => order.push(source),
        }
    }
    order.reverse();
    ReachableGraph { rpo: order, predecessors: predecessors }
}

/// Cooper, Harvey and Kennedy's iterative immediate-dominator algorithm.
fn compute_idoms(graph: &ReachableGraph, entry: Int) -> List<Int> {
    let count = graph.predecessors.len();
    let mut idom: List<Int> = List.from_elem(-1, count);
    let mut rank: List<Int> = List.from_elem(-1, count);
    let mut i = 0;
    while i < graph.rpo.len() { rank[graph.rpo[i]] = i; i = i + 1; }
    idom[entry] = entry;
    let mut changed = true;
    while changed {
        changed = false;
        let mut p = 1;
        while p < graph.rpo.len() {
            let block = graph.rpo[p];
            let mut parent = -1;
            for pred in &graph.predecessors[block] {
                if idom[*pred] >= 0 {
                    if parent < 0 { parent = *pred; }
                    else { parent = intersect(parent, *pred, &idom, &rank); }
                }
            }
            if idom[block] != parent { idom[block] = parent; changed = true; }
            p = p + 1;
        }
    }
    idom[entry] = -1;
    idom
}

fn intersect(first: Int, second: Int, idom: &List<Int>, rank: &List<Int>) -> Int {
    let mut a = first;
    let mut b = second;
    while a != b {
        while rank[a] > rank[b] { a = idom[a]; }
        while rank[b] > rank[a] { b = idom[b]; }
    }
    a
}

fn compute_frontiers(graph: &ReachableGraph, idom: &List<Int>) -> List<List<BlockId>> {
    let count = idom.len();
    let mut frontiers: List<List<BlockId>> = List.new();
    let mut last_target: List<Int> = List.from_elem(-1, count);
    let mut i = 0;
    while i < count { frontiers.push(List.new()); i = i + 1; }
    let mut target = 0;
    while target < count {
        for pred in &graph.predecessors[target] {
            let mut runner = *pred;
            // Each chain ends at the target's immediate dominator. A second
            // visit for this target has already covered the rest of the chain.
            while runner >= 0 && runner != idom[target] && last_target[runner] != target {
                frontiers[runner].push(block_id(target));
                last_target[runner] = target;
                runner = idom[runner];
            }
        }
        target = target + 1;
    }
    frontiers
}
