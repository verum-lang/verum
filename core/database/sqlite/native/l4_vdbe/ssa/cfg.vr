@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.cfg;

// =============================================================================
// l4_vdbe/ssa/cfg.vr — Control-flow graph
// =============================================================================
// Layer: 4
// Spec: sqlite-native.md §4.4
//
// Owns the basic-block array + entry-block id.  Predecessor lists on
// blocks are populated by `compute_preds()` once construction is
// complete.
// =============================================================================

mount collections.List;
mount base.{Maybe};
mount core.database.sqlite.native.l4_vdbe.ssa.block.{
    BasicBlock, BlockId, block_id, block_id_raw, block_new
};

// -----------------------------------------------------------------------------
// Cfg
// -----------------------------------------------------------------------------

public type Cfg is {
    blocks: List<BasicBlock>,
    entry: BlockId,
};

/// Empty CFG with a single entry block.  The entry block has the
/// placeholder terminator and no instructions.
public fn cfg_new() -> Cfg {
    let mut bs: List<BasicBlock> = List.new();
    bs.push(block_new(block_id(0)));
    Cfg { blocks: bs, entry: block_id(0) }
}

implement Cfg {
    public fn block_count(&self) -> Int { self.blocks.len() }

    /// Allocate a fresh block.  Returns its id.  The new block has
    /// the placeholder terminator and must be patched before
    /// `compute_preds()` is called.
    public fn new_block(&mut self) -> BlockId {
        let id = block_id(self.blocks.len());
        self.blocks.push(block_new(id));
        id
    }

    public fn entry_id(&self) -> BlockId { self.entry }

    fn contains(&self, index: Int) -> Bool { index >= 0 && index < self.blocks.len() }

    public fn get(&self, id: &BlockId) -> &BasicBlock {
        let index = block_id_raw(id);
        assert(self.contains(index), "invalid SQLite SSA block id");
        &self.blocks[index]
    }

    public fn try_get_mut(&mut self, id: BlockId) -> Maybe<&mut BasicBlock> {
        let index = block_id_raw(&id);
        if !self.contains(index) { return Maybe.None; }
        Maybe.Some(&mut self.blocks[index])
    }

    public fn get_mut(&mut self, id: &BlockId) -> &mut BasicBlock {
        match self.try_get_mut(*id) {
            Maybe.Some(block) => block,
            Maybe.None => panic("invalid SQLite SSA block id"),
        }
    }

    public fn total_instr_count(&self) -> Int {
        let mut total = 0;
        for block in &self.blocks { total = total + block.instr_count(); }
        total
    }

    /// Validate every edge before replacing the cached predecessor lists.
    public fn compute_preds(&mut self) {
        for block in &self.blocks {
            let targets = block.successors();
            for target in &targets {
                assert(self.contains(block_id_raw(target)), "invalid SQLite SSA successor");
            }
        }
        let mut i = 0;
        while i < self.blocks.len() {
            self.blocks[i].clear_predecessors();
            i = i + 1;
        }
        let mut source = 0;
        while source < self.blocks.len() {
            let targets = self.blocks[source].successors();
            for target in &targets {
                self.blocks[block_id_raw(target)].add_predecessor(block_id(source));
            }
            source = source + 1;
        }
    }
}
