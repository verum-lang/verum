@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.jump_threading;

// Fold constant branches and thread jumps through empty blocks. Phi operands
// are keyed by the immediate predecessor. Keep the last jump into a phi block
// in place, even when earlier jumps in the same chain can be bypassed.

mount collections.{List, Map};
mount base.Maybe;
mount core.database.sqlite.native.l4_vdbe.ssa.value.value_id_raw;
mount core.database.sqlite.native.l4_vdbe.ssa.inst.SsaInst;
mount core.database.sqlite.native.l4_vdbe.ssa.block.{BlockId, block_id, block_id_raw, block_id_eq};
mount core.database.sqlite.native.l4_vdbe.ssa.cfg.Cfg;
mount core.database.sqlite.native.l4_vdbe.ssa.program.SsaProgram;

public type JumpThreadReport is {
    public(in core.database.sqlite.native.l4_vdbe.ssa) threaded_jumps: Int,
    public(in core.database.sqlite.native.l4_vdbe.ssa) folded_branches: Int,
    iterations: Int,
};

/// Run both transformations until a round makes no edits.
public fn run_jump_threading(prog: &mut SsaProgram) -> JumpThreadReport {
    let cfg = prog.graph_mut();
    cfg.compute_preds();
    let constants = branch_constants(cfg);
    let mut report = JumpThreadReport { threaded_jumps: 0, folded_branches: 0, iterations: 0 };
    loop {
        let folded = fold_constant_branches(cfg, &constants);
        let threaded = thread_empty_jumps(cfg);
        report.iterations = report.iterations + 1;
        report.folded_branches = report.folded_branches + folded;
        report.threaded_jumps = report.threaded_jumps + threaded;
        if folded == 0 && threaded == 0 { break; }
    }
    if report.folded_branches > 0 || report.threaded_jumps > 0 { cfg.compute_preds(); }
    report
}

fn branch_constants(cfg: &Cfg) -> Map<Int, Bool> {
    let mut constants: Map<Int, Bool> = Map.new();
    let mut b = 0;
    while b < cfg.block_count() {
        let insts = cfg.get(&block_id(b)).instructions();
        let mut i = 0;
        while i < insts.len() {
            match &insts[i] {
                SsaInst.IIntImm(dst, value) => { constants.insert(value_id_raw(&dst.id()), value != 0_i64); }
                SsaInst.INull(dst) => { constants.insert(value_id_raw(&dst.id()), false); }
                _ => {}
            }
            i = i + 1;
        }
        b = b + 1;
    }
    constants
}

fn folded_edges(term: &SsaInst, constants: &Map<Int, Bool>) -> Maybe<(BlockId, BlockId)> {
    match term {
        SsaInst.IBranch(cond, on_true, on_false) => {
            match constants.get(value_id_raw(&cond.id())) {
                Maybe.Some(true) => Maybe.Some((on_true.clone(), on_false.clone())),
                Maybe.Some(false) => Maybe.Some((on_false.clone(), on_true.clone())),
                Maybe.None => Maybe.None,
            }
        }
        _ => Maybe.None,
    }
}

fn fold_constant_branches(cfg: &mut Cfg, constants: &Map<Int, Bool>) -> Int {
    let mut count = 0;
    let mut b = 0;
    while b < cfg.block_count() {
        let source = block_id(b);
        match folded_edges(cfg.get(&source).terminator(), constants) {
            Maybe.Some((kept, dropped)) => {
                if !block_id_eq(&kept, &dropped) {
                    cfg.get_mut(&dropped).remove_phi_predecessor(&source);
                }
                cfg.get_mut(&source).set_terminator(SsaInst.IJump(kept));
                count = count + 1;
            }
            Maybe.None => {}
        }
        b = b + 1;
    }
    count
}

// Return the next transparent edge. Crossing into a phi block would change
// which predecessor supplies its value, so the preceding jump is an endpoint.
fn next_target(cfg: &Cfg, source: Int) -> Maybe<Int> {
    let block = cfg.get(&block_id(source));
    if block.instr_count() == 1 {
        match block.terminator() {
            SsaInst.IJump(target) => {
                if cfg.get(target).phis().len() == 0 { return Maybe.Some(block_id_raw(target)); }
            }
            _ => {}
        }
    }
    Maybe.None
}

// Resolve each path once. Leave cycles and the edges leading into them intact.
fn chain_targets(cfg: &Cfg) -> List<Int> {
    let unseen = -1;
    let visiting = -2;
    let cyclic = -3;
    let mut targets: List<Int> = List.new();
    while targets.len() < cfg.block_count() { targets.push(unseen); }
    let mut start = 0;
    while start < targets.len() {
        if targets[start] == unseen {
            let mut path: List<Int> = List.new();
            let mut at = start;
            while targets[at] == unseen {
                path.push(at);
                targets[at] = visiting;
                match next_target(cfg, at) {
                    Maybe.Some(next) => { at = next; }
                    Maybe.None => { targets[at] = at; break; }
                }
            }
            let endpoint = if targets[at] == visiting { cyclic } else { targets[at] };
            for member in &path { targets[*member] = endpoint; }
        }
        start = start + 1;
    }
    let mut i = 0;
    while i < targets.len() {
        if targets[i] == cyclic { targets[i] = i; }
        i = i + 1;
    }
    targets
}

fn threaded_terminator(term: &SsaInst, targets: &List<Int>) -> Maybe<SsaInst> {
    match term {
        SsaInst.IJump(target) => {
            let raw = block_id_raw(target);
            if targets[raw] != raw { return Maybe.Some(SsaInst.IJump(block_id(targets[raw]))); }
        }
        SsaInst.IBranch(cond, on_true, on_false) => {
            let left = block_id_raw(on_true);
            let right = block_id_raw(on_false);
            if targets[left] != left || targets[right] != right {
                return Maybe.Some(SsaInst.IBranch(cond.clone(), block_id(targets[left]), block_id(targets[right])));
            }
        }
        _ => {}
    }
    Maybe.None
}

fn thread_empty_jumps(cfg: &mut Cfg) -> Int {
    let targets = chain_targets(cfg);
    let mut count = 0;
    let mut b = 0;
    while b < cfg.block_count() {
        let source = block_id(b);
        match threaded_terminator(cfg.get(&source).terminator(), &targets) {
            Maybe.Some(term) => {
                cfg.get_mut(&source).set_terminator(term);
                count = count + 1;
            }
            Maybe.None => {}
        }
        b = b + 1;
    }
    count
}
