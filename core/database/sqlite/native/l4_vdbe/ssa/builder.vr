@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.builder;

// =============================================================================
// l4_vdbe/ssa/builder.vr — SsaBuilder for direct codegen emission
// =============================================================================
// Layer: 4
// Spec: sqlite-native.md §4.4 (SSA as canonical IR)
//
// The builder emits typed SSA instructions directly into a program. Each
// block owns its register definitions. Terminating a block opens the next
// one, and finalization validates its successor IDs and records predecessors.
// =============================================================================

mount collections.{List, Map};
mount base.{Text, Maybe};
mount core.database.sqlite.native.l4_vdbe.ssa.value.{SValueKind, ValueId, SsaValue, ssa_value};
mount core.database.sqlite.native.l4_vdbe.ssa.inst.{SsaInst, CursorOpKind};
mount core.database.sqlite.native.l4_vdbe.ssa.block.BlockId;
mount core.database.sqlite.native.l4_vdbe.ssa.program.{SsaProgram, ssa_program_new};

// -----------------------------------------------------------------------------
// SsaBuilder — emit-style API building an SsaProgram
// -----------------------------------------------------------------------------

public type SsaBuilder is {
    /// Program under construction.
    program: SsaProgram,
    /// Block currently receiving emitted instructions.  Updated by
    /// `terminate_block` (called from emit_terminator) to point at
    /// the freshly-allocated successor block.
    current_block: BlockId,
    /// Per-VDBE-register reaching definitions in the current block.
    /// Reset on every block boundary (cross-block resolution is
    /// the phi insertion pass's job).
    reaching_defs: Map<Int, ValueId>,
}

public fn ssa_builder_new(sql: Text) -> SsaBuilder {
    let prog = ssa_program_new(sql);
    let entry = prog.graph().entry_id();
    SsaBuilder {
        program: prog,
        current_block: entry,
        reaching_defs: Map.new(),
    }
}

implement SsaBuilder {
    public fn current_block_id(&self) -> BlockId { self.current_block.clone() }

    public fn block_count(&self) -> Int { self.program.block_count() }

    public fn value_count(&self) -> Int { self.program.value_count() }

    /// Allocate a fresh SSA value of the given static kind.  Each
    /// emit_* helper that produces a result value calls this.
    public fn fresh_value(&mut self, kind: SValueKind) -> SsaValue {
        let id = self.program.fresh_value_id();
        ssa_value(id, kind)
    }

    /// Push a non-terminator instruction into the current block.
    /// Caller is responsible for ensuring the instruction shape
    /// matches the SsaInst variant (use the typed emit_* helpers
    /// below rather than calling this directly).
    public fn push(&mut self, inst: SsaInst) {
        self.program.graph_mut().get_mut(&self.current_block).push_inst(inst);
    }

    /// Emit a terminator + open a fresh successor block.  The
    /// builder's `current_block` advances to the new block; the
    /// reaching-def map resets.  Returns the new block's id so
    /// callers can patch jump targets if needed.
    public fn terminate(&mut self, term: SsaInst) -> BlockId {
        self.program.graph_mut().get_mut(&self.current_block).set_terminator(term);
        let next = self.program.graph_mut().new_block();
        self.current_block = next.clone();
        self.reaching_defs = Map.new();
        next
    }

    /// Record that VDBE register `reg_idx` was just written by
    /// SSA value `v`.  Subsequent `read_reg` in the same block
    /// returns `v`; cross-block reads fall through to phi
    /// insertion later.
    public fn def_reg(&mut self, reg_idx: Int, v: &SsaValue) {
        self.reaching_defs.insert(reg_idx, v.id());
    }

    /// Resolve a VDBE register read.  Returns the in-block reaching
    /// definition's SsaValue (kind reconstructed as SValueKind.SkAny — the
    /// type-inference pass refines kinds later).  Maybe.None when the
    /// register has not been defined in the current block; the
    /// builder caller should record a pending-phi placeholder via
    /// `mint_pending`.
    public fn read_reg(&self, reg_idx: Int) -> Maybe<SsaValue> {
        match self.reaching_defs.get(reg_idx) {
            Maybe.Some(id) => Maybe.Some(ssa_value(id, SValueKind.SkAny)),
            Maybe.None     => Maybe.None,
        }
    }

    /// Mint a pending-phi placeholder — used when the codegen
    /// reads a register that has no in-block reaching def.  The
    /// final phi insertion pass will substitute the real
    /// reaching-def from a predecessor block.
    public fn mint_pending(&mut self, reg_idx: Int) -> SsaValue {
        let v = self.fresh_value(SValueKind.SkAny);
        self.def_reg(reg_idx, &v);
        v
    }

    /// Finish the build.  Computes predecessor lists, returns the
    /// SsaProgram ready for the optimizer + lower passes.
    public fn finalize(mut self) -> SsaProgram {
        self.program.graph_mut().compute_preds();
        let SsaBuilder { program, .. } = self;
        program
    }
}

// -----------------------------------------------------------------------------
// Typed emit_* helpers — one per common SsaInst variant
// -----------------------------------------------------------------------------

/// Materialise a typed integer immediate; defines `dst_reg` to the
/// freshly-minted SsaValue.
public fn emit_int_imm(b: &mut SsaBuilder, dst_reg: Int, value: Int64) -> SsaValue {
    let dst = b.fresh_value(SValueKind.SkInt);
    b.push(SsaInst.IIntImm(dst.clone(), value));
    b.def_reg(dst_reg, &dst);
    dst
}

/// Materialise a typed null; defines `dst_reg`.
public fn emit_null(b: &mut SsaBuilder, dst_reg: Int) -> SsaValue {
    let dst = b.fresh_value(SValueKind.SkNull);
    b.push(SsaInst.INull(dst.clone()));
    b.def_reg(dst_reg, &dst);
    dst
}

/// Pull a typed constant from the constant pool.
public fn emit_const(b: &mut SsaBuilder, dst_reg: Int, kind: SValueKind, const_idx: Int) -> SsaValue {
    let dst = b.fresh_value(kind);
    b.push(SsaInst.IConst(dst.clone(), const_idx));
    b.def_reg(dst_reg, &dst);
    dst
}

/// Binary arithmetic: dst = lhs OP rhs.  Result kind defaults to
/// the LHS kind (caller-side type checker validates compatibility).
public fn emit_arith(
    b: &mut SsaBuilder,
    op: ArithOp,
    dst_reg: Int,
    lhs_reg: Int,
    rhs_reg: Int,
) -> SsaValue {
    let lhs = read_or_pending(b, lhs_reg);
    let rhs = read_or_pending(b, rhs_reg);
    let kind = lhs.kind();
    let dst = b.fresh_value(kind);
    let inst = match op {
        AoAdd => SsaInst.IAdd(dst.clone(), lhs, rhs),
        AoSub => SsaInst.ISub(dst.clone(), lhs, rhs),
        AoMul => SsaInst.IMul(dst.clone(), lhs, rhs),
        AoDiv => SsaInst.IDiv(dst.clone(), lhs, rhs),
        AoRem => SsaInst.IRem(dst.clone(), lhs, rhs),
    };
    b.push(inst);
    b.def_reg(dst_reg, &dst);
    dst
}

public type ArithOp is AoAdd | AoSub | AoMul | AoDiv | AoRem;

/// Cursor open: no SSA value produced.  Inserted into current block.
public fn emit_cursor_open(
    b: &mut SsaBuilder,
    cursor_id: Int,
    op: CursorOpKind,
    root_page: Int,
    n_cols: Int,
) {
    b.push(SsaInst.ICursorOpen(cursor_id, op, root_page, n_cols));
}

/// Read column from cursor.  dst_kind = SValueKind.SkAny (the schema-aware
/// codegen layer can refine via ICast follow-up).
public fn emit_column(
    b: &mut SsaBuilder,
    dst_reg: Int,
    cursor_id: Int,
    col_idx: Int,
) -> SsaValue {
    let dst = b.fresh_value(SValueKind.SkAny);
    b.push(SsaInst.IColumn(dst.clone(), cursor_id, col_idx));
    b.def_reg(dst_reg, &dst);
    dst
}

/// Yield a result row from N consecutive registers.
public fn emit_result_row(b: &mut SsaBuilder, reg_start: Int, n_cols: Int) {
    let mut vs: List<SsaValue> = List.new();
    let mut i: Int = 0;
    while i < n_cols {
        vs.push(read_or_pending(b, reg_start + i));
        i = i + 1;
    }
    b.push(SsaInst.IResultRow(vs));
}

/// Halt the program.  Terminates the current block.
public fn emit_halt(b: &mut SsaBuilder, code: Int, msg: Text) -> BlockId {
    b.terminate(SsaInst.IHalt(code, msg))
}

/// Unconditional jump.  Terminates the current block; opens a
/// successor.  Returns the new block id.
public fn emit_jump(b: &mut SsaBuilder, target: BlockId) -> BlockId {
    b.terminate(SsaInst.IJump(target))
}

/// Conditional branch.  Terminates the current block.
public fn emit_branch(
    b: &mut SsaBuilder,
    cond_reg: Int,
    then_blk: BlockId,
    else_blk: BlockId,
) -> BlockId {
    let cond = read_or_pending(b, cond_reg);
    b.terminate(SsaInst.IBranch(cond, then_blk, else_blk))
}

// -----------------------------------------------------------------------------
// Helper: read or pending-phi
// -----------------------------------------------------------------------------

fn read_or_pending(b: &mut SsaBuilder, reg_idx: Int) -> SsaValue {
    match b.read_reg(reg_idx) {
        Maybe.Some(v) => v,
        Maybe.None    => b.mint_pending(reg_idx),
    }
}
