@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l4_vdbe.ssa.to_register_vm;

mount collections.List;
mount base.Maybe;
mount core.database.sqlite.native.l4_vdbe.opcode.Opcode;
mount core.database.sqlite.native.l4_vdbe.program.{VdbeProgram, ConstantEntry};
mount core.database.sqlite.native.l4_vdbe.ssa.value.{
    SsaValue, SValueKind, value_id_raw, kind_eq, kinds_compatible
};
mount core.database.sqlite.native.l4_vdbe.ssa.inst.{SsaInst, CmpKind, CursorOpKind, PhiOperand, inst_dst, inst_operands};
mount core.database.sqlite.native.l4_vdbe.ssa.block.{BlockId, block_id, block_id_raw};
mount core.database.sqlite.native.l4_vdbe.ssa.dominator.{DomTree, build_dom_tree};
mount core.database.sqlite.native.l4_vdbe.ssa.program.SsaProgram;
mount core.database.sqlite.native.builtins.registry.{kind_from_name, kind_code, arity_of, arity_accepts};

type Definition is { block: Int, position: Int, kind: SValueKind };

type IncomingEdge is { pred: Int, pc: Int, condition: Maybe<Int> };

type LowerState is {
    definitions: List<Maybe<Definition>>,
    dom: DomTree,
    starts: List<Int>,
    incoming: List<List<IncomingEdge>>,
    scratch_base: Int,
    scratch_count: Int,
    constant_count: Int,
};

fn slot(value: &SsaValue) -> Int { value_id_raw(&value.id()) - 1 }

fn record_definition(defs: &mut List<Maybe<Definition>>, inst: &SsaInst, block: Int, pos: Int) {
    if let Maybe.Some(dst) = inst_dst(inst) {
        let raw = value_id_raw(&dst.id());
        assert(raw > 0 && raw <= defs.len(), "invalid SQLite SSA definition ID");
        assert(defs[raw - 1] is Maybe.None, "duplicate SQLite SSA definition");
        defs[raw - 1] = Maybe.Some(Definition { block: block, position: pos, kind: dst.kind() });
    }
}

fn check_use(st: &LowerState, value: &SsaValue, block: Int, pos: Int) {
    let raw = value_id_raw(&value.id());
    assert(raw > 0 && raw <= st.definitions.len(), "invalid SQLite SSA operand ID");
    match &st.definitions[raw - 1] {
        Maybe.Some(def) => {
            assert(kind_eq(&def.kind, &value.kind()), "inconsistent SQLite SSA operand kind");
            if def.block == block {
                assert(def.position < pos, "SQLite SSA operand used before its definition");
            } else if st.dom.dominates(&block_id(block), &block_id(block)) {
                assert(st.dom.dominates(&block_id(def.block), &block_id(block)), "SQLite SSA definition does not dominate use");
            }
        }
        Maybe.None => panic("undefined SQLite SSA operand"),
    }
}

fn reserve_scratch(st: &mut LowerState, count: Int) {
    assert(count <= Int.MAX - st.scratch_base, "SQLite SSA register file too large");
    if count > st.scratch_count { st.scratch_count = count; }
}

// Pack SQL argument and result lists in their declared order, including repeated values.
fn pack(st: &mut LowerState, out: &mut VdbeProgram, values: &List<SsaValue>) -> Int {
    reserve_scratch(st, values.len());
    let mut i = 0;
    while i < values.len() {
        let _ = out.emit(Opcode.SCopy(slot(&values[i]), st.scratch_base + i));
        i = i + 1;
    }
    st.scratch_base
}

fn emit_edge(st: &mut LowerState, out: &mut VdbeProgram, pred: Int, target: &BlockId, cond: Maybe<Int>) {
    let dest = block_id_raw(target);
    assert(dest >= 0 && dest < st.incoming.len(), "invalid SQLite SSA successor");
    let pc = out.emit(Opcode.Goto(0));
    st.incoming[dest].push(IncomingEdge { pred: pred, pc: pc, condition: cond });
}

fn emit_terminator(st: &mut LowerState, out: &mut VdbeProgram, inst: &SsaInst, block: Int, end: Int) {
    match inst {
        IBranch(c, yes, no) => {
            check_use(st, c, block, end);
            if block_id_raw(yes) != block_id_raw(no) {
                emit_edge(st, out, block, yes, Maybe.Some(slot(c)));
            }
            emit_edge(st, out, block, no, Maybe.None);
        }
        IJump(target) => emit_edge(st, out, block, target, Maybe.None),
        IHalt(code, message) => {
            let index = out.add_constant(ConstantEntry.KText(message.clone()));
            let _ = out.emit(Opcode.Halt(code, index));
        }
        IReturn(_) => panic("SQLite SSA return requires a register VM call continuation"),
        IYield(_) => panic("SQLite SSA yield has no register VM resume operation"),
        _ => panic("invalid SQLite SSA terminator"),
    }
}

fn compare_opcode(kind: &CmpKind, left: Int, right: Int, target: Int) -> Opcode {
    match kind {
        CkEq => Opcode.Eq(left, right, target),
        CkNe => Opcode.Ne(left, right, target),
        CkLt => Opcode.Lt(left, right, target),
        CkLe => Opcode.Le(left, right, target),
        CkGt => Opcode.Gt(left, right, target),
        CkGe => Opcode.Ge(left, right, target),
    }
}

fn cast_opcode(dst: &SsaValue, src: &SsaValue) -> Opcode {
    let kind = dst.kind();
    if kind_eq(&kind, &src.kind()) || kind is SValueKind.SkAny {
        return Opcode.SCopy(slot(src), slot(dst));
    }
    let target = match kind {
        SkInt => 0, SkReal => 1, SkText => 2, SkBlob => 3,
        _ => panic("unsupported SQLite SSA cast destination"),
    };
    Opcode.CastVal(slot(src), target, slot(dst))
}

fn constant_opcode(out: &VdbeProgram, dst: &SsaValue, index: Int, count: Int) -> Opcode {
    assert(index >= 0 && index < count, "invalid SQLite SSA constant index");
    match out.constant_at(index) {
        KInt(_) => {
            assert(kind_eq(&dst.kind(), &SValueKind.SkInt), "invalid SQLite SSA constant kind");
            Opcode.Int64(index, slot(dst))
        }
        KReal(_) => {
            assert(kind_eq(&dst.kind(), &SValueKind.SkReal), "invalid SQLite SSA constant kind");
            Opcode.Real(index, slot(dst))
        }
        KText(_) => {
            assert(kind_eq(&dst.kind(), &SValueKind.SkText), "invalid SQLite SSA constant kind");
            Opcode.String8(index, slot(dst))
        }
        KBlob(_) => panic("SQLite register interpreter does not execute blob literals"),
        KAffinityStr(_) => panic("SQLite SSA affinity metadata is not a literal"),
    }
}

fn emit_body(st: &mut LowerState, out: &mut VdbeProgram, inst: &SsaInst) {
    let op = match inst {
        IConst(d, idx) => constant_opcode(out, d, idx, st.constant_count),
        INull(d) => Opcode.Null(slot(d), slot(d)),
        IIntImm(d, value) => {
            let small = value as Int;
            if (small as Int64) == value { Opcode.Integer(small, slot(d)) }
            else { Opcode.Int64(out.add_constant(ConstantEntry.KInt(value)), slot(d)) }
        }
        IAdd(d, a, b) => Opcode.Add(slot(a), slot(b), slot(d)),
        ISub(d, a, b) => Opcode.Subtract(slot(a), slot(b), slot(d)),
        IMul(d, a, b) => Opcode.Multiply(slot(a), slot(b), slot(d)),
        IDiv(d, a, b) => Opcode.Divide(slot(a), slot(b), slot(d)),
        IRem(d, a, b) => Opcode.Remainder(slot(a), slot(b), slot(d)),
        ICmp(d, kind, a, b) => {
            assert(kind_eq(&d.kind(), &SValueKind.SkBool), "SQLite SSA comparison requires a boolean destination");
            let pc = out.emit(Opcode.Integer(1, slot(d)));
            let _ = out.emit(compare_opcode(kind, slot(a), slot(b), pc + 3));
            Opcode.Integer(0, slot(d))
        }
        ICast(d, s) => cast_opcode(d, s),
        IResultRow(values) => Opcode.ResultRow(pack(st, out, values), values.len()),
        ICallFn(d, name, args) => {
            let kind = kind_from_name(name).expect("unknown SQLite SSA scalar function");
            assert(arity_accepts(&arity_of(&kind), args.len()), "invalid SQLite SSA scalar function arity");
            Opcode.ScalarFn(kind_code(&kind), args.len(), pack(st, out, args), slot(d))
        }
        ICursorOpen(cur, kind, root_page, n_cols) => match kind {
            CoOpenRead => Opcode.OpenRead(cur, root_page, n_cols),
            CoOpenWrite => Opcode.OpenWrite(cur, root_page, n_cols),
            CoOpenEphemeral => Opcode.OpenEphemeral(cur, n_cols),
            _ => panic("unsupported SQLite SSA cursor open kind"),
        },
        ICursorClose(cur) => Opcode.Close(cur),
        IColumn(d, cur, col) => Opcode.Column(cur, col, slot(d)),
        IRowId(d, cur) => Opcode.RowIdOp(cur, slot(d)),
        INewRowId(d, cur) => Opcode.NewRowid(cur, slot(d)),
        ICursorDelete(cur) => Opcode.Delete(cur),
        ITransactionBegin(mode) => Opcode.Transaction(mode),
        ITransactionCommit => Opcode.Commit,
        ITransactionRollback(savepoint) => Opcode.RollbackOp(savepoint),
        // Cursor side exits are absent from the SSA terminator graph. Records,
        // aggregate state and bitwise ops also lack an executable mapping here.
        _ => panic("unsupported SQLite SSA instruction in register lowering"),
    };
    let _ = out.emit(op);
}

// Validate one operand per actual predecessor and collect its source register.
// The predecessor cache can be stale after a terminator edit.
fn resolve_edges(st: &mut LowerState, ssa: &SsaProgram, out: &mut VdbeProgram) {
    let mut positions: List<Int> = List.from_elem(-1, st.starts.len());
    let mut dest = 0;
    while dest < st.starts.len() {
        let phis = ssa.graph().get(&block_id(dest)).phis();
        assert(phis.is_empty() || dest != block_id_raw(&ssa.graph().entry_id()), "SQLite SSA entry phi has no initial value");
        let mut sources: List<List<Int>> = List.new();
        let mut e = 0;
        while e < st.incoming[dest].len() {
            positions[st.incoming[dest][e].pred] = e;
            sources.push(List.new());
            e = e + 1;
        }
        reserve_scratch(st, phis.len());
        let mut p = 0;
        while p < phis.len() {
            match &phis[p] {
                IPhi(dst, inputs) => {
                    assert(inputs.len() == st.incoming[dest].len(), "SQLite SSA phi must cover every incoming edge");
                    let mut i = 0;
                    while i < inputs.len() {
                        let input: &PhiOperand = &inputs[i];
                        let pred = block_id_raw(&input.pred);
                        assert(pred >= 0 && pred < positions.len(), "invalid SQLite SSA phi predecessor");
                        let edge = positions[pred];
                        assert(edge >= 0, "invalid SQLite SSA phi predecessor");
                        assert(sources[edge].len() == p, "duplicate SQLite SSA phi predecessor");
                        check_use(st, &input.value, pred, ssa.graph().get(&input.pred).instructions().len());
                        assert(kinds_compatible(&dst.kind(), &input.value.kind()), "incompatible SQLite SSA phi kinds");
                        sources[edge].push(slot(&input.value));
                        i = i + 1;
                    }
                }
                _ => panic("invalid SQLite SSA phi"),
            }
            p = p + 1;
        }
        e = 0;
        while e < st.incoming[dest].len() {
            let edge: &IncomingEdge = &st.incoming[dest][e];
            positions[edge.pred] = -1;
            let mut target = st.starts[dest];
            if !phis.is_empty() {
                target = out.instruction_count();
                // Save all inputs before changing any phi destination. A loop
                // backedge can exchange its own phi registers in parallel.
                let mut i = 0;
                while i < phis.len() {
                    let _ = out.emit(Opcode.SCopy(sources[e][i], st.scratch_base + i));
                    i = i + 1;
                }
                i = 0;
                while i < phis.len() {
                    let dst = inst_dst(&phis[i]).unwrap();
                    let _ = out.emit(Opcode.SCopy(st.scratch_base + i, slot(&dst)));
                    i = i + 1;
                }
                let _ = out.emit(Opcode.Goto(st.starts[dest]));
            }
            let op = match edge.condition {
                Maybe.Some(reg) => Opcode.If(reg, target),
                Maybe.None => Opcode.Goto(target),
            };
            out.replace(edge.pc, op);
            e = e + 1;
        }
        dest = dest + 1;
    }
}

/// Lower a typed SSA graph for the register interpreter. Invalid value/edge
/// references and instructions without an executable lowering are rejected.
public fn lower_ssa_to_vdbe(ssa: &SsaProgram) -> VdbeProgram {
    let cfg = ssa.graph();
    let count = cfg.block_count();
    let slots = ssa.value_count() - 1;
    let mut defs: List<Maybe<Definition>> = List.new();
    while defs.len() < slots { defs.push(Maybe.None); }
    let mut incoming: List<List<IncomingEdge>> = List.new();
    let mut b = 0;
    while b < count {
        incoming.push(List.new());
        let block = cfg.get(&block_id(b));
        for phi in block.phis() { record_definition(&mut defs, phi, b, -1); }
        let mut i = 0;
        while i < block.instructions().len() {
            record_definition(&mut defs, &block.instructions()[i], b, i);
            i = i + 1;
        }
        b = b + 1;
    }
    let mut st = LowerState {
        definitions: defs, dom: build_dom_tree(cfg), starts: List.from_elem(0, count),
        incoming: incoming, scratch_base: slots, scratch_count: 0, constant_count: ssa.constant_count(),
    };
    let mut out = ssa.register_program(slots);
    b = 0;
    while b < count {
        st.starts[b] = out.instruction_count();
        let block = cfg.get(&block_id(b));
        let mut i = 0;
        while i < block.instructions().len() {
            let inst = &block.instructions()[i];
            for operand in &inst_operands(inst) { check_use(&st, operand, b, i); }
            emit_body(&mut st, &mut out, inst);
            i = i + 1;
        }
        emit_terminator(&mut st, &mut out, block.terminator(), b, i);
        b = b + 1;
    }
    resolve_edges(&mut st, ssa, &mut out);
    out.with_register_count(slots + st.scratch_count)
}
