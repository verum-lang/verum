@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l1_pager.journal.wal;

// =============================================================================
// l1_pager/journal/wal.vr — Write-Ahead Log writer + frame format
// =============================================================================
// Layer: 1
// Spec: sqlite-native.md §6.5, sqlite.org/walformat.html
//

// Wire layout:
//

//  +---------------- WAL header (32 B) ----------------+
//  | 0 4 magic (0x377f0682 LE / 0x377f0683 BE)
//  | 4 4 format_version (3007000)
//  | 8 4 page_size
//  |12 4 checkpoint_seq
//  |16 4 salt_1
//  |20 4 salt_2
//  |24 4 checksum_1
//  |28 4 checksum_2
//  +--------------- frame i (header 24 B) -------------+
//  | 0 4 page_number
//  | 4 4 db_size_after_commit (0 unless commit marker)
//  | 8 4 salt_1 (copied from header; invalidates the
//  | frame if they ever disagree)
//  |12 4 salt_2
//  |16 4 checksum_1
//  |20 4 checksum_2
//  +--------------- frame i payload (page_size bytes) -+
//

// SQLite WAL checksums accumulate two 32-bit words modulo 2^32. The last
// magic byte selects the input word order. Stored checksums are big-endian.
//

// This module covers the *serialisation* surface only. The actor that
// actually appends frames, drives fsync, and coordinates checkpoints
// lives in `l1_pager/pager.vr`. Recovery (replay on open) lives in
// `l1_pager/recovery.vr`.
// =============================================================================

mount collections.List;
mount base.{Result, Ok, Err, Text, Maybe};
mount core.database.sqlite.native.wal_frame_layout.constants.is_valid_page_size;

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------

/// Magic bytes for a little-endian WAL. File header byte 0..3.
public const WAL_MAGIC_LE: UInt32 = 0x377F0682;

/// WAL magic selecting big-endian checksum input words.
public const WAL_MAGIC_BE: UInt32 = 0x377F0683;

/// WAL format version — SQLite 3.7.0 onwards.
public const WAL_FORMAT_VERSION: UInt32 = 3007000;

public const WAL_HEADER_SIZE: Int = 32;
public const WAL_FRAME_HEADER_SIZE: Int = 24;

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

/// Parsed WAL header.
public type WalHeader is {
    magic: UInt32,
    format_version: UInt32,
    page_size: UInt32,
    checkpoint_seq: UInt32,
    salt_1: UInt32,
    salt_2: UInt32,
    checksum_1: UInt32,
    checksum_2: UInt32,
};

/// Parsed WAL frame header. `db_size_after_commit == 0` marks an
/// intermediate frame; `> 0` marks a commit marker and records the
/// resulting DB size in pages.
public type WalFrameHeader is {
    page_number: UInt32,
    db_size_after_commit: UInt32,
    salt_1: UInt32,
    salt_2: UInt32,
    checksum_1: UInt32,
    checksum_2: UInt32,
};

/// Running-checksum state. Position-dependent: feeding the frame
/// header and payload through `wal_running_checksum` yields the pair
/// that must be written into the frame header.
public type WalChecksum is {
    s1: UInt32,
    s2: UInt32,
    big_endian: Bool,
};

implement WalChecksum {
    /// The WAL magic determines the byte order of input words throughout the chain.
    public fn from_words(s1: u32, s2: u32, big_endian: Bool) -> WalChecksum {
        WalChecksum { s1, s2, big_endian }
    }

    public fn words(&self) -> (u32, u32) { (self.s1, self.s2) }

    public(in core.database.sqlite.native.l1_pager) fn matches(&self, s1: u32, s2: u32) -> Bool {
        self.s1 == s1 && self.s2 == s2
    }

    public(in core.database.sqlite.native.l1_pager) fn magic(&self) -> u32 {
        if self.big_endian { WAL_MAGIC_BE } else { WAL_MAGIC_LE }
    }

    public(in core.database.sqlite.native.l1_pager) fn frame(
        &self, header: &[Byte], payload: &[Byte],
    ) -> WalChecksum {
        let prefix = checksum_range(self, header, 0, 8);
        wal_running_checksum(prefix, payload)
    }

    public(in core.database.sqlite.native.l1_pager) fn verify_frame(
        &self, header: &[Byte], payload: &[Byte], salt1: u32, salt2: u32,
    ) -> Maybe<WalChecksum> {
        if read_u32_be(header, 0) == 0_u32 || read_u32_be(header, 8) != salt1
            || read_u32_be(header, 12) != salt2 { return Maybe.None; }
        let next = self.frame(header, payload);
        if !next.matches(read_u32_be(header, 16), read_u32_be(header, 20)) { return Maybe.None; }
        Maybe.Some(next)
    }
}

implement Clone for WalChecksum {
    fn clone(&self) -> WalChecksum { WalChecksum.from_words(self.s1, self.s2, self.big_endian) }
}

/// Live WAL state — runtime accumulator used by the pager actor.
public type Wal is {
    header: WalHeader,
    running: WalChecksum,
    next_frame_index: Int,
    next_frame_offset: Int,
};

// -----------------------------------------------------------------------------
// Construction
// -----------------------------------------------------------------------------

/// Fresh WAL state at the start of a journal. `salt_1` and `salt_2`
/// are fed from `core.sys.common.get_random_bytes` (or equivalent) so
/// that post-checkpoint truncation-recoveries see a fresh generation.
public fn wal_new(
    page_size: UInt32,
    salt_1: UInt32,
    salt_2: UInt32,
    checkpoint_seq: UInt32,
) -> Wal {
    let header = WalHeader {
        magic: WAL_MAGIC_LE,
        format_version: WAL_FORMAT_VERSION,
        page_size: page_size,
        checkpoint_seq: checkpoint_seq,
        salt_1: salt_1,
        salt_2: salt_2,
        checksum_1: 0 as UInt32,
        checksum_2: 0 as UInt32,
    };
    // Seed the running checksum from the header's first 24 bytes
    // (everything up to the checksum_1 field).
    let seed_bytes = wal_header_serialize_seed(&header);
    let running = wal_running_checksum(
        WalChecksum.from_words(0_u32, 0_u32, false),
        seed_bytes.as_slice(),
    );

    // Patch the header to carry the computed checksum.
    let hdr_final = WalHeader {
        magic: header.magic,
        format_version: header.format_version,
        page_size: header.page_size,
        checkpoint_seq: header.checkpoint_seq,
        salt_1: header.salt_1,
        salt_2: header.salt_2,
        checksum_1: running.s1,
        checksum_2: running.s2,
    };
    Wal {
        header: hdr_final,
        running: running,
        next_frame_index: 0,
        next_frame_offset: WAL_HEADER_SIZE,
    }
}

// -----------------------------------------------------------------------------
// Serialisation helpers
// -----------------------------------------------------------------------------

fn u32_be(buf: &mut List<Byte>, v: UInt32) {
    buf.push(((v >> 24) & 0xFF) as Byte);
    buf.push(((v >> 16) & 0xFF) as Byte);
    buf.push(((v >> 8)  & 0xFF) as Byte);
    buf.push((v & 0xFF) as Byte);
}

public(in core.database.sqlite.native.l1_pager) fn read_u32_be(buf: &[Byte], offset: Int) -> UInt32 {
    let b0 = buf[offset] as UInt32;
    let b1 = buf[offset + 1] as UInt32;
    let b2 = buf[offset + 2] as UInt32;
    let b3 = buf[offset + 3] as UInt32;
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

/// Serialise just the 24-byte header seed (fields before the checksums).
/// Fed to `wal_running_checksum` during `wal_new`.
fn wal_header_serialize_seed(h: &WalHeader) -> List<Byte> {
    let mut out: List<Byte> = List.new();
    u32_be(&mut out, h.magic);
    u32_be(&mut out, h.format_version);
    u32_be(&mut out, h.page_size);
    u32_be(&mut out, h.checkpoint_seq);
    u32_be(&mut out, h.salt_1);
    u32_be(&mut out, h.salt_2);
    out
}

/// Serialise the whole 32-byte WAL header in on-disk form.
public fn wal_header_serialize(h: &WalHeader) -> List<Byte> {
    let mut out: List<Byte> = List.new();
    u32_be(&mut out, h.magic);
    u32_be(&mut out, h.format_version);
    u32_be(&mut out, h.page_size);
    u32_be(&mut out, h.checkpoint_seq);
    u32_be(&mut out, h.salt_1);
    u32_be(&mut out, h.salt_2);
    u32_be(&mut out, h.checksum_1);
    u32_be(&mut out, h.checksum_2);
    out
}

/// Parse a 32-byte WAL header slice. Returns Err on short buffer or
/// magic-byte mismatch.
public fn wal_header_parse(buf: &[Byte]) -> Result<WalHeader, Text> {
    if buf.len() < WAL_HEADER_SIZE {
        return Result.Err("wal_header_parse: short buffer".clone());
    }
    let magic = read_u32_be(buf, 0);
    if magic != WAL_MAGIC_LE && magic != WAL_MAGIC_BE {
        return Result.Err("wal_header_parse: bad magic".clone());
    }
    Result.Ok(WalHeader {
        magic: magic,
        format_version: read_u32_be(buf, 4),
        page_size: read_u32_be(buf, 8),
        checkpoint_seq: read_u32_be(buf, 12),
        salt_1: read_u32_be(buf, 16),
        salt_2: read_u32_be(buf, 20),
        checksum_1: read_u32_be(buf, 24),
        checksum_2: read_u32_be(buf, 28),
    })
}

/// Serialise a 24-byte frame header.
public fn wal_frame_header_serialize(h: &WalFrameHeader) -> List<Byte> {
    let mut out: List<Byte> = List.new();
    u32_be(&mut out, h.page_number);
    u32_be(&mut out, h.db_size_after_commit);
    u32_be(&mut out, h.salt_1);
    u32_be(&mut out, h.salt_2);
    u32_be(&mut out, h.checksum_1);
    u32_be(&mut out, h.checksum_2);
    out
}

/// Parse a frame header from a 24-byte slice.
public fn wal_frame_header_parse(buf: &[Byte]) -> Result<WalFrameHeader, Text> {
    if buf.len() < WAL_FRAME_HEADER_SIZE {
        return Result.Err("wal_frame_header_parse: short buffer".clone());
    }
    Result.Ok(WalFrameHeader {
        page_number: read_u32_be(buf, 0),
        db_size_after_commit: read_u32_be(buf, 4),
        salt_1: read_u32_be(buf, 8),
        salt_2: read_u32_be(buf, 12),
        checksum_1: read_u32_be(buf, 16),
        checksum_2: read_u32_be(buf, 20),
    })
}

// -----------------------------------------------------------------------------
// Running checksum (walformat.html §3.1)
// -----------------------------------------------------------------------------

/// Advance the two unsigned 32-bit sums over complete pairs of input words.
public fn wal_running_checksum(seed: WalChecksum, data: &[Byte]) -> WalChecksum {
    checksum_range(&seed, data, 0, data.len())
}

fn checksum_word(data: &[Byte], i: Int, big_endian: Bool) -> Int {
    let a = data[i] as Int;
    let b = data[i + 1] as Int;
    let c = data[i + 2] as Int;
    let d = data[i + 3] as Int;
    if big_endian { (a << 24) | (b << 16) | (c << 8) | d }
    else { a | (b << 8) | (c << 16) | (d << 24) }
}

fn checksum_range(seed: &WalChecksum, data: &[Byte], start: Int, end: Int) -> WalChecksum {
    let mut s1 = seed.s1 as Int;
    let mut s2 = seed.s2 as Int;
    let mut i = start;
    while i + 8 <= end {
        s1 = (s1 + checksum_word(data, i, seed.big_endian) + s2) & 0xFFFFFFFF;
        s2 = (s2 + checksum_word(data, i + 4, seed.big_endian) + s1) & 0xFFFFFFFF;
        i = i + 8;
    }
    WalChecksum.from_words(s1 as u32, s2 as u32, seed.big_endian)
}

/// Validate the full on-disk header before accepting its seed or any frames.
public(in core.database.sqlite.native.l1_pager) fn verified_header_seed(bytes: &[Byte]) -> Maybe<WalChecksum> {
    if bytes.len() < WAL_HEADER_SIZE { return Maybe.None; }
    let magic = read_u32_be(bytes, 0);
    if (magic != WAL_MAGIC_LE && magic != WAL_MAGIC_BE) || read_u32_be(bytes, 4) != WAL_FORMAT_VERSION
        || !is_valid_page_size(read_u32_be(bytes, 8) as Int) { return Maybe.None; }
    let seed = WalChecksum.from_words(0_u32, 0_u32, magic == WAL_MAGIC_BE);
    let checksum = checksum_range(&seed, bytes, 0, 24);
    if !checksum.matches(read_u32_be(bytes, 24), read_u32_be(bytes, 28)) { return Maybe.None; }
    Maybe.Some(checksum)
}
