// =============================================================================
// incrblob/engine.vr — open/read/write/reopen/close orchestration
// =============================================================================
// Spec: SQLite C API
//

// `BlobEngine` keeps the running map of (handle_id → BlobHandle) and
// drives the four sqlite3_blob_* operations. The actual byte movement
// happens in the L4 interpreter; the engine's job is bookkeeping +
// bounds checking + mode enforcement.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.incrblob.engine;

mount base.{Text, Bool, Maybe};
mount collections.Map;
mount core.database.sqlite.native.incrblob.flags.{
    BlobOpenMode, BomReadOnly, BomReadWrite,
};
mount core.database.sqlite.native.incrblob.handle.{
    BlobHandle, blob_handle,
};
mount core.database.sqlite.native.incrblob.error.{
    BlobError, BeNoRow, BeNotABlob, BeReadOnly, BeOutOfRange, BeAborted,
};

public type BlobEngine is {
    handles: Map<Int64, BlobHandle>,
    next_handle_id: Int64,
}

public fn engine_new() -> BlobEngine {
    BlobEngine { handles: Map.new(), next_handle_id: 1 as Int64 }
}

implement BlobEngine {
    public fn open_handle_count(&self) -> Int {
        self.handles.len()
    }

    /// Open a handle. The caller has already resolved the column to a
    /// BLOB and passed in `byte_size`. Returns the handle's stable id.
    public fn open(
        &mut self,
        schema_name: Text,
        table_name: Text,
        column_name: Text,
        rowid: Int64,
        mode: BlobOpenMode,
        byte_size: Int,
    ) -> Int64 {
        let id = self.next_handle_id;
        self.next_handle_id = id + 1_i64;
        let handle = blob_handle(id, schema_name, table_name, column_name, rowid, mode, byte_size);
        self.handles.insert(handle.id(), handle);
        id
    }

    public(in core.database.sqlite.native) fn lookup(&self, handle_id: &Int64) -> Result<&BlobHandle, BlobError> {
        match self.handles.get_key_value(handle_id) {
            Maybe.Some((_, handle)) => Result.Ok(handle),
            Maybe.None => Result.Err(BeAborted),
        }
    }

    public(in core.database.sqlite.native) fn access(
        &self, handle_id: &Int64, offset: Int, length: Int, write: Bool,
    ) -> Result<&BlobHandle, BlobError> {
        let handle = self.lookup(handle_id)?;
        if write && !handle.permits_write() { return Result.Err(BeReadOnly); }
        if !handle.in_bounds(offset, length) { return Result.Err(BeOutOfRange(offset, length)); }
        Result.Ok(handle)
    }

    public fn validate_read(&self, handle_id: Int64, offset: Int, length: Int) -> Result<(), BlobError> {
        self.access(&handle_id, offset, length, false)?;
        Result.Ok(())
    }

    public fn validate_write(&self, handle_id: Int64, offset: Int, length: Int) -> Result<(), BlobError> {
        self.access(&handle_id, offset, length, true)?;
        Result.Ok(())
    }

    public fn reopen(&mut self, handle_id: Int64, new_rowid: Int64, new_byte_size: Int) -> Result<(), BlobError> {
        match self.handles.get_mut(&handle_id) {
            Maybe.Some(handle) => {
                handle.reopen(new_rowid, new_byte_size);
                Result.Ok(())
            }
            Maybe.None => Result.Err(BeAborted),
        }
    }

    public fn close(&mut self, handle_id: Int64) -> Bool {
        self.handles.remove(handle_id).is_some()
    }

    public fn lookup_size(&self, handle_id: Int64) -> Maybe<Int> {
        match self.lookup(&handle_id) {
            Result.Ok(handle) => Maybe.Some(handle.byte_len()),
            Result.Err(_) => Maybe.None,
        }
    }
}
