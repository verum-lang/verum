@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.datetime.format;

mount base.Text;
mount core.database.sqlite.native.datetime.instant.DatetimeInstant;
mount core.database.sqlite.native.datetime.julian.julian_day_int;

/// Format UTC calendar fields. An unsupported substitution yields `None`, as SQL NULL.
public fn strftime(format: &Text, instant: &DatetimeInstant) -> Maybe<Text> {
    let input = format.as_bytes();
    let (year, month, day) = instant.ymd_view().parts();
    let (h, m, s, ms) = instant.clock_parts();
    let mut out = Text.new();
    let mut i = 0;
    while i < input.len() {
        let byte = input[i];
        i = i + 1;
        if byte != 37_u8 { out.push_byte(byte); continue; }
        if i == input.len() { return Maybe.None; }
        match input[i] {
            89_u8 => append_number(&mut out, year, 4),       // Y
            109_u8 => append_number(&mut out, month, 2),    // m
            100_u8 => append_number(&mut out, day, 2),      // d
            72_u8 => append_number(&mut out, h, 2),         // H
            77_u8 => append_number(&mut out, m, 2),         // M
            83_u8 => append_number(&mut out, s, 2),         // S
            102_u8 => {                                    // f
                append_number(&mut out, s, 2);
                out.push_byte(46_u8);
                append_number(&mut out, ms, 3);
            },
            106_u8 => {                                    // j
                let ordinal = julian_day_int(year, month, day) - julian_day_int(year, 1, 1) + 1_i64;
                append_number(&mut out, ordinal as Int, 3);
            },
            74_u8 => out.push_str(&julian_text(instant.julian_real())),  // J
            115_u8 => { let epoch = instant.unix_seconds(); out.push_str(&f"{epoch}"); }, // s
            119_u8 => append_number(&mut out, instant.weekday(), 1),    // w
            37_u8 => out.push_byte(37_u8),                              // %
            _ => return Maybe.None,
        }
        i = i + 1;
    }
    Maybe.Some(out)
}

fn append_number(out: &mut Text, value: Int, width: Int) {
    let magnitude = if value < 0 { out.push_byte(45_u8); -value } else { value };
    let decimal = f"{magnitude}";
    let mut i = decimal.len();
    while i < width { out.push_byte(48_u8); i = i + 1; }
    out.push_str(&decimal);
}

/// SQLite's %J uses 16 significant digits. Its finite millisecond domain
/// has decimal exponents from -8 through 6, so only negative exponents
/// below -4 use scientific notation.
fn julian_text(jd: Float64) -> Text {
    if jd == 0.0 { return "0"; }
    let mut exponent = 0;
    let mut power: Float64 = 1.0;
    while jd >= power * 10.0 { power = power * 10.0; exponent = exponent + 1; }
    while jd < power { power = power / 10.0; exponent = exponent - 1; }
    let fixed = jd.to_precision(15 - exponent).trim_end_matches_char('0').trim_end_matches_char('.');
    if exponent >= -4 { return fixed; }
    let first = 1 - exponent;
    let mut result = fixed.slice(first, first + 1);
    if first + 1 < fixed.len() {
        result.push_byte(46_u8);
        result.push_str(&fixed.slice(first + 1, fixed.len()));
    }
    result.push_str("e-");
    append_number(&mut result, -exponent, 2);
    result
}
