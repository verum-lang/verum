// =============================================================================
// datetime/modifier.vr — date/time modifiers
// =============================================================================
// Spec: sqlite-native.md §15.6 (date/time modifiers)
//

// Each `DatetimeModifier` shifts an `Instant`. Recognised modifier strings:
//

//  'now' — replace with current wall-clock instant
//  '+N days' — add N days
//  '-N days' — subtract N days
//  '+N hours' — add N hours
//  '-N hours' — subtract N hours
//  '+N minutes' — etc.
//  '+N seconds'
//  '+N months' — calendar month add (overflow carries into the following month)
//  '+N years' — calendar year add (overflow carries into the following month)
//  'start of month' — set day = 1, time = 00:00:00
//  'start of year' — set month = 1, day = 1, time = 00:00:00
//  'start of day' — set time = 00:00:00
//  'weekday N' — advance to the next weekday N (0=Sunday)
//  'unixepoch' — REAL value is interpreted as unix seconds
//  'utc' / 'localtime' — timezone shift (not modelled here)
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.datetime.modifier;

mount core.base.maybe.Maybe;
mount core.database.sqlite.native.datetime.instant.{
    DatetimeInstant as Instant, try_from_ymd_hms, from_unix_seconds,
};

// -----------------------------------------------------------------------------
// DatetimeModifier
// -----------------------------------------------------------------------------

public type DatetimeModifier is
      MNow
    | MAddDays(Int64)
    | MAddHours(Int64)
    | MAddMinutes(Int64)
    | MAddSeconds(Int64)
    | MAddMonths(Int)
    | MAddYears(Int)
    | MStartOfDay
    | MStartOfMonth
    | MStartOfYear
    | MWeekday(Int)
    | MUnixEpoch
    | MUtc
    | MLocaltime;

public fn modifier_kind_name(m: &DatetimeModifier) -> Text {
    match m {
        MNow              => "now".clone(),
        MAddDays(_)       => "add_days".clone(),
        MAddHours(_)      => "add_hours".clone(),
        MAddMinutes(_)    => "add_minutes".clone(),
        MAddSeconds(_)    => "add_seconds".clone(),
        MAddMonths(_)     => "add_months".clone(),
        MAddYears(_)      => "add_years".clone(),
        MStartOfDay       => "start_of_day".clone(),
        MStartOfMonth     => "start_of_month".clone(),
        MStartOfYear      => "start_of_year".clone(),
        MWeekday(_)       => "weekday".clone(),
        MUnixEpoch        => "unixepoch".clone(),
        MUtc              => "utc".clone(),
        MLocaltime        => "localtime".clone(),
    }
}

// -----------------------------------------------------------------------------
// parse — Text → Maybe<DatetimeModifier>
// -----------------------------------------------------------------------------

public fn parse(text: &Text) -> Maybe<DatetimeModifier> {
    if *text == "now".clone() { return Maybe.Some(MNow); }
    if *text == "start of day".clone() { return Maybe.Some(MStartOfDay); }
    if *text == "start of month".clone() { return Maybe.Some(MStartOfMonth); }
    if *text == "start of year".clone() { return Maybe.Some(MStartOfYear); }
    if *text == "unixepoch".clone() { return Maybe.Some(MUnixEpoch); }
    if *text == "utc".clone() { return Maybe.Some(MUtc); }
    if *text == "localtime".clone() { return Maybe.Some(MLocaltime); }

    // weekday N
    if starts_with(text, &"weekday ".clone()) {
        let suffix = drop_prefix(text, 8);
        match parse_int_text(&suffix) {
            Maybe.Some(n) => if n >= 0 && n <= 6 { return Maybe.Some(MWeekday(n)); }
            Maybe.None    => {}
        }
    }

    // +N <unit> / -N <unit>
    let bs = text.as_bytes();
    if bs.len() < 3 { return Maybe.None; }
    let signed = bs[0] == (43 as Byte) || bs[0] == (45 as Byte);
    if !signed { return Maybe.None; }
    let neg = bs[0] == (45 as Byte);

    // Find the space separator.
    let mut sep: Int = -1;
    let mut i: Int = 1;
    while i < bs.len() {
        if bs[i] == (32 as Byte) { sep = i; break; }
        i = i + 1;
    }
    if sep < 0 { return Maybe.None; }

    let n_text = slice_text(text, 1, sep);
    let unit = slice_text(text, sep + 1, bs.len());
    let n_int = match parse_int_text(&n_text) {
        Maybe.Some(v) => v,
        Maybe.None    => return Maybe.None,
    };
    let signed_n = if neg { -n_int } else { n_int };

    if unit == "days".clone() || unit == "day".clone() {
        return Maybe.Some(MAddDays(signed_n as Int64));
    }
    if unit == "hours".clone() || unit == "hour".clone() {
        return Maybe.Some(MAddHours(signed_n as Int64));
    }
    if unit == "minutes".clone() || unit == "minute".clone() {
        return Maybe.Some(MAddMinutes(signed_n as Int64));
    }
    if unit == "seconds".clone() || unit == "second".clone() {
        return Maybe.Some(MAddSeconds(signed_n as Int64));
    }
    if unit == "months".clone() || unit == "month".clone() {
        return Maybe.Some(MAddMonths(signed_n));
    }
    if unit == "years".clone() || unit == "year".clone() {
        return Maybe.Some(MAddYears(signed_n));
    }
    Maybe.None
}

// -----------------------------------------------------------------------------
// apply — shift an Instant by a DatetimeModifier
// -----------------------------------------------------------------------------

/// Apply an instant-domain transformation. Input interpretation (unixepoch)
/// needs a numeric input and timezone conversions need a zone provider.
public fn apply(inst: &Instant, m: &DatetimeModifier, now_ns: Int64) -> Maybe<Instant> {
    match m {
        MNow => {
            let ms = now_ns / 1_000_000_i64;
            let floor_ms = if now_ns % 1_000_000_i64 < 0_i64 { ms - 1_i64 } else { ms };
            from_unix_seconds(0_i64).try_shift(floor_ms, 1_i64)
        },
        MAddDays(n) => inst.try_shift(*n, 86400000_i64),
        MAddHours(n) => inst.try_shift(*n, 3600000_i64),
        MAddMinutes(n) => inst.try_shift(*n, 60000_i64),
        MAddSeconds(n) => inst.try_shift_seconds(*n),
        MAddMonths(n) => add_months(inst, *n, 1),
        MAddYears(n) => add_months(inst, *n, 12),
        MStartOfDay => {
            let (y, mo, d) = inst.ymd_view().parts();
            try_from_ymd_hms(y, mo, d, 0, 0, 0, 0)
        },
        MStartOfMonth => {
            let (y, mo, _) = inst.ymd_view().parts();
            try_from_ymd_hms(y, mo, 1, 0, 0, 0, 0)
        },
        MStartOfYear => {
            let (y, _, _) = inst.ymd_view().parts();
            try_from_ymd_hms(y, 1, 1, 0, 0, 0, 0)
        },
        MWeekday(target) => {
            if *target < 0 || *target > 6 { return Maybe.None; }
            let delta = (*target - inst.weekday() + 7) % 7;
            inst.try_shift(delta as Int64, 86400000_i64)
        },
        MUnixEpoch | MUtc | MLocaltime => Maybe.None,
    }
}

fn add_months(inst: &Instant, count: Int, months_per_unit: Int) -> Maybe<Instant> {
    let (year, month, day) = inst.ymd_view().parts();
    let origin = year * 12 + month - 1;
    if count < (-4713 * 12 - origin) / months_per_unit ||
       count > (9999 * 12 + 11 - origin) / months_per_unit { return Maybe.None; }
    let total = origin + count * months_per_unit;
    let month_index = ((total % 12) + 12) % 12;
    let new_year = (total - month_index) / 12;
    let (h, m, s, ms) = inst.clock_parts();
    try_from_ymd_hms(new_year, month_index + 1, day, h, m, s, ms)
}

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn starts_with(t: &Text, prefix: &Text) -> Bool {
    let bs = t.as_bytes();
    let pb = prefix.as_bytes();
    if bs.len() < pb.len() { return false; }
    let mut i: Int = 0;
    while i < pb.len() {
        if bs[i] != pb[i] { return false; }
        i = i + 1;
    }
    true
}

fn drop_prefix(t: &Text, n: Int) -> Text {
    let bs = t.as_bytes();
    let mut out = Text.new();
    let mut i: Int = n;
    while i < bs.len() { out.push_byte(bs[i]); i = i + 1; }
    out
}

fn slice_text(t: &Text, lo: Int, hi: Int) -> Text {
    let bs = t.as_bytes();
    let mut out = Text.new();
    let mut i: Int = lo;
    while i < hi && i < bs.len() { out.push_byte(bs[i]); i = i + 1; }
    out
}

fn parse_int_text(t: &Text) -> Maybe<Int> {
    let bs = t.as_bytes();
    if bs.len() == 0 { return Maybe.None; }
    // Three-layer overflow defense (matches the recipe codified in
    // #70-#74). DateModifier arguments arrive from user-supplied SQL —
    // a long-digit input is either a typo or an attempt to wrap
    // `acc * 10 + d` past Int.MAX into a small-magnitude value that
    // slips past downstream range checks (e.g. month/day validators).
    if bs.len() > 19 { return Maybe.None; }
    let mut i: Int = 0;
    let mut acc: Int = 0;
    while i < bs.len() {
        if bs[i] < (48 as Byte) || bs[i] > (57 as Byte) { return Maybe.None; }
        if acc > 922_337_203_685_477_580 { return Maybe.None; }   // Int.MAX / 10
        acc = acc * 10 + ((bs[i] - (48 as Byte)) as Int);
        if acc < 0 { return Maybe.None; }                          // wrap-around guard
        i = i + 1;
    }
    Maybe.Some(acc)
}
