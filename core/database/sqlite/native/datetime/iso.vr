@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.datetime.iso;

mount base.Text;
mount core.database.sqlite.native.datetime.instant.{DatetimeInstant, try_from_ymd_hms};
mount core.database.sqlite.native.datetime.format.strftime;

// -----------------------------------------------------------------------------
// IsoParseResult
// -----------------------------------------------------------------------------

public type IsoParseError is
      IpeBadFormat
    | IpeBadDate
    | IpeBadTime
    | IpeOutOfRange;

implement Display for IsoParseError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        let s = match self {
            IpeBadFormat   => "ISO datetime: format invalid",
            IpeBadDate     => "ISO datetime: date component invalid",
            IpeBadTime     => "ISO datetime: time component invalid",
            IpeOutOfRange  => "ISO datetime: value out of range",
        };
        f.write_str(s)
    }
}

implement Debug for IsoParseError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        let s = match self {
            IpeBadFormat   => "IpeBadFormat",
            IpeBadDate     => "IpeBadDate",
            IpeBadTime     => "IpeBadTime",
            IpeOutOfRange  => "IpeOutOfRange",
        };
        f.write_str(s)
    }
}

implement PartialEq for IsoParseError {
    fn eq(&self, other: &IsoParseError) -> Bool {
        match (self, other) {
            (IpeBadFormat,  IpeBadFormat)  => true,
            (IpeBadDate,    IpeBadDate)    => true,
            (IpeBadTime,    IpeBadTime)    => true,
            (IpeOutOfRange, IpeOutOfRange) => true,
            _ => false,
        }
    }
}

implement Eq for IsoParseError {}

public fn parse_error_name(e: &IsoParseError) -> Text {
    match e {
        IpeBadFormat   => "bad_format".clone(),
        IpeBadDate     => "bad_date".clone(),
        IpeBadTime     => "bad_time".clone(),
        IpeOutOfRange  => "out_of_range".clone(),
    }
}

/// Parse SQLite calendar text, including time-only values anchored at 2000-01-01.
public fn parse(text: &Text) -> Result<DatetimeInstant, IsoParseError> {
    let bs = text.as_bytes();
    if bs.len() < 5 { return Result.Err(IpeBadFormat); }
    let mut year = 2000;
    let mut month = 1;
    let mut day = 1;
    let mut start = 0;
    if bs[2] != 58_u8 {
        let negative = bs[0] == 45_u8;
        let off = if negative { 1 } else { 0 };
        let end = off + 10;
        if bs.len() < end || bs[off + 4] != 45_u8 || bs[off + 7] != 45_u8 { return Result.Err(IpeBadFormat); }
        year = match digits(bs, off, 4) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadDate) };
        if negative { year = -year; }
        month = match digits(bs, off + 5, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadDate) };
        day = match digits(bs, off + 8, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadDate) };
        if bs.len() == end { return make_utc(year, month, day, 0, 0, 0, 0, 0); }
        if bs[end] != 32_u8 && bs[end] != 84_u8 { return Result.Err(IpeBadFormat); }
        start = end + 1;
    }
    if start + 5 > bs.len() || bs[start + 2] != 58_u8 { return Result.Err(IpeBadFormat); }
    let h = match digits(bs, start, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadTime) };
    let m = match digits(bs, start + 3, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadTime) };
    let mut s = 0;
    let mut ms = 0;
    let mut pos = start + 5;
    if pos < bs.len() && bs[pos] == 58_u8 {
        s = match digits(bs, pos + 1, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadTime) };
        pos = pos + 3;
        if pos < bs.len() && bs[pos] == 46_u8 {
            pos = pos + 1;
            let first = pos;
            let mut place = 100;
            while pos < bs.len() && bs[pos] >= 48_u8 && bs[pos] <= 57_u8 {
                let digit = (bs[pos] - 48_u8) as Int;
                if place > 0 { ms = ms + digit * place; place = place / 10; }
                else if pos == first + 3 && digit >= 5 && ms < 999 { ms = ms + 1; }
                pos = pos + 1;
            }
            if first == pos { return Result.Err(IpeBadTime); }
        }
    }
    let mut offset = 0;
    if pos < bs.len() {
        if bs[pos] == 90_u8 || bs[pos] == 122_u8 {
            pos = pos + 1;
        } else if bs[pos] == 43_u8 || bs[pos] == 45_u8 {
            if pos + 6 != bs.len() || bs[pos + 3] != 58_u8 { return Result.Err(IpeBadFormat); }
            let oh = match digits(bs, pos + 1, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadTime) };
            let om = match digits(bs, pos + 4, 2) { Maybe.Some(v) => v, Maybe.None => return Result.Err(IpeBadTime) };
            if oh > 14 || om > 59 { return Result.Err(IpeOutOfRange); }
            offset = oh * 3600 + om * 60;
            if bs[pos] == 45_u8 { offset = -offset; }
            pos = pos + 6;
        }
    }
    if pos != bs.len() { return Result.Err(IpeBadFormat); }
    make_utc(year, month, day, h, m, s, ms, offset)
}

fn digits(bs: &[Byte], off: Int, count: Int) -> Maybe<Int> {
    if off + count > bs.len() { return Maybe.None; }
    let mut acc = 0;
    let mut i = off;
    while i < off + count {
        let b = bs[i];
        if b < 48_u8 || b > 57_u8 { return Maybe.None; }
        acc = acc * 10 + ((b - 48_u8) as Int);
        i = i + 1;
    }
    Maybe.Some(acc)
}

fn make_utc(y: Int, m: Int, d: Int, h: Int, mi: Int, s: Int, ms: Int, offset: Int) -> Result<DatetimeInstant, IsoParseError> {
    match try_from_ymd_hms(y, m, d, h, mi, s, ms) {
        Maybe.Some(local) => match local.try_shift_seconds(-(offset as Int64)) {
            Maybe.Some(utc) => Result.Ok(utc),
            Maybe.None => Result.Err(IpeOutOfRange),
        },
        Maybe.None => Result.Err(IpeOutOfRange),
    }
}

/// Render UTC with millisecond precision.
public fn render(instant: &DatetimeInstant) -> Text {
    strftime("%Y-%m-%d %H:%M:%f", instant).expect("valid SQLite timestamp format")
}
