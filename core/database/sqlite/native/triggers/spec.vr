// =============================================================================
// triggers/spec.vr — TriggerDef record
// =============================================================================
// Spec: sqlite-native.md §17.1
//

// CREATE TRIGGER name
//  BEFORE | AFTER | INSTEAD OF
//  INSERT | UPDATE [OF col1, col2, ...] | DELETE
//  ON table
//  [FOR EACH ROW]
//  [WHEN condition]
// BEGIN
//  statement1;
//  statement2;
// END;
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.triggers.spec;

mount base.{Text, Maybe, Bool};
mount collections.List;

// -----------------------------------------------------------------------------
// Timing & event
// -----------------------------------------------------------------------------

public type SqlTriggerTiming is TtBefore | TtAfter | TtInsteadOf;

public type SqlTriggerEvent is
      TeInsert
    | TeDelete
    | TeUpdate(List<Text>);  // empty list = "any column"

public fn timing_name(t: &SqlTriggerTiming) -> Text {
    match t {
        TtBefore    => "BEFORE".clone(),
        TtAfter     => "AFTER".clone(),
        TtInsteadOf => "INSTEAD OF".clone(),
    }
}

public fn event_name(e: &SqlTriggerEvent) -> Text {
    match e {
        TeInsert    => "INSERT".clone(),
        TeDelete    => "DELETE".clone(),
        TeUpdate(_) => "UPDATE".clone(),
    }
}

// -----------------------------------------------------------------------------
// Trigger statement body — at parse time we only carry the raw SQL
// text; the L5 codegen re-parses it within the trigger context (so
// NEW.col / OLD.col bindings resolve correctly).
// -----------------------------------------------------------------------------

public type TriggerBodyStmt is { sql: Text };

public type TriggerDef is {
    name: Text,
    schema_name: Text,         // "main", "temp", "<attach-alias>"
    timing: SqlTriggerTiming,
    event: SqlTriggerEvent,
    table_name: Text,
    for_each_row: Bool,        // SQLite always true; kept for spec parity
    when_clause: Maybe<Text>,  // optional WHEN <expr>
    body: List<TriggerBodyStmt>,
    /// Assigned by the trigger store on registration.
    sub_program_id: Maybe<Int>,
};

public fn trigger_def_new(
    name: Text,
    table_name: Text,
    timing: SqlTriggerTiming,
    event: SqlTriggerEvent,
) -> TriggerDef {
    TriggerDef {
        name: name,
        schema_name: "main".clone(),
        timing: timing,
        event: event,
        table_name: table_name,
        for_each_row: true,
        when_clause: Maybe.None,
        body: List.new(),
        sub_program_id: Maybe.None,
    }
}

implement TriggerDef {
    public(in super.store) fn bind_subprogram(&mut self, id: Int) {
        assert(id > 0, "SQLite trigger subprogram identifiers must be positive");
        self.sub_program_id = Maybe.Some(id);
    }

    public(in super.fire) fn subprogram(&self) -> Maybe<Int> { self.sub_program_id }

    public(in super.store) fn name(&self) -> &Text { &self.name }

    public(in super.store) fn is_for_table(&self, table_name: &Text) -> Bool {
        self.table_name.eq(table_name)
    }

    public(in super.store) fn matches_hook(
        &self, table_name: &Text, timing: &SqlTriggerTiming, event: &SqlTriggerEvent,
    ) -> Bool {
        let same_timing = match self.timing {
            TtBefore    => timing is TtBefore,
            TtAfter     => timing is TtAfter,
            TtInsteadOf => timing is TtInsteadOf,
        };
        self.is_for_table(table_name) && same_timing && self.fires_on_event(event)
    }

    public fn add_body_stmt(&mut self, sql: Text) {
        self.body.push(TriggerBodyStmt { sql: sql });
    }

    public fn set_when(&mut self, expr_sql: Text) {
        self.when_clause = Maybe.Some(expr_sql);
    }

    public fn set_schema(&mut self, schema: Text) {
        self.schema_name = schema;
    }

    public fn fires_on_event(&self, evt: &SqlTriggerEvent) -> Bool {
        match self.event {
            TeInsert    => match evt { TeInsert    => true, _ => false },
            TeDelete    => match evt { TeDelete    => true, _ => false },
            TeUpdate(self_cols) => match evt {
                TeUpdate(other_cols) => {
                    // No specific cols on the trigger = any column matches
                    if self_cols.len() == 0 { return true; }
                    if other_cols.len() == 0 { return false; }
                    // Any overlap counts
                    let mut i: Int = 0;
                    while i < self_cols.len() {
                        let mut j: Int = 0;
                        while j < other_cols.len() {
                            if self_cols[i] == other_cols[j] { return true; }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    false
                }
                _ => false,
            },
        }
    }
}

// -----------------------------------------------------------------------------
// Special row binding tags — `NEW.col` / `OLD.col`
// -----------------------------------------------------------------------------

public type RowBindingKind is RbNew | RbOld;

public fn row_binding_name(k: &RowBindingKind) -> Text {
    match k {
        RbNew => "NEW".clone(),
        RbOld => "OLD".clone(),
    }
}

public fn row_binding_available_for_event(k: &RowBindingKind, e: &SqlTriggerEvent) -> Bool {
    match e {
        TeInsert    => match k { RbNew => true, RbOld => false },
        TeDelete    => match k { RbNew => false, RbOld => true },
        TeUpdate(_) => true,  // both NEW and OLD bound on UPDATE
    }
}
