// =============================================================================
// database/sqlite/native/migrations/store.vr — SqliteMigrationStore
// =============================================================================
// Layer: 2 (Database — SQLite adapter)
// Dependencies: core, base, common/migrations/{store, journal, migration},
//               sqlite/native/connection
// =============================================================================
//
// Native SQLite migration adapter. Its current transaction state does not
// restore schema/rows on rollback, so transactional execute_step refuses before
// SQL. The existing raw execution helpers remain a separate unqualified path;
// no-op lock methods do not guarantee serialization of migration runners.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "SQLite-specific MigrationStore implementing the universal protocol",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.sqlite.native.migrations.store;

mount base.{Text, Bool, Maybe, Some, None, Result, Ok, Err};
mount collections.List;
mount core.database.common.error.{DbError, AdapterId, AdSqlite, AdapterSpecific};
mount core.database.common.migrations.store.{
    MigrationStore, MigrationStoreConfig,
};
mount core.database.common.migrations.migration.{
    MigrationStatus, MsPending, MsApplied, MsRolledBack, MsFailed,
};
mount core.database.common.migrations.journal.{
    MigrationJournal, JournalEntry,
};
mount core.database.sqlite.native.migrations.journal_codec.decode_status;
mount core.database.sqlite.native.l6_session.connection.{SqliteNativeConnection};

// =============================================================================
// SqliteMigrationStore
// =============================================================================

public type SqliteMigrationStore is {
    conn: SqliteNativeConnection,
    config: MigrationStoreConfig,
};

public fn store_new(conn: SqliteNativeConnection, config: MigrationStoreConfig) -> SqliteMigrationStore {
    SqliteMigrationStore { conn: conn, config: config }
}

implement MigrationStore for SqliteMigrationStore {
    fn adapter_id(&self) -> AdapterId { AdSqlite }

    fn dialect(&self) -> Text { "sqlite".to_text() }

    fn config(&self) -> &MigrationStoreConfig { &self.config }

    async fn init(&mut self) -> Result<(), DbError> {
        // SQLite-canonical types. CREATE TABLE IF NOT EXISTS is idempotent.
        let table = &self.config.table_name;
        let sql = f"CREATE TABLE IF NOT EXISTS {table} (\n                version    INTEGER PRIMARY KEY,\n                name       TEXT NOT NULL,\n                status     TEXT NOT NULL,\n                applied_at INTEGER,\n                error      TEXT,\n                checksum   INTEGER NOT NULL\n            )";
        execute_raw(&mut self.conn, &sql).await
    }

    async fn load_journal(&mut self) -> Result<MigrationJournal, DbError> {
        let sql = f"SELECT version, name, status, applied_at, error, checksum FROM {self.config.table_name} ORDER BY version";
        let entries = query_journal_rows(&mut self.conn, &sql).await?;
        Result.Ok(MigrationJournal { entries: entries })
    }

    async fn upsert_entry(&mut self, entry: &JournalEntry) -> Result<(), DbError> {
        let (status_str, applied_at_opt, error_opt) = render_status(&entry.status);
        // SQLite's "UPSERT" — `INSERT ... ON CONFLICT DO UPDATE`.
        let table = &self.config.table_name;
        let version = entry.version;
        let name_lit = sql_text_literal(&entry.name);
        let status_lit = sql_text_literal(&status_str);
        let applied_lit = match applied_at_opt { Maybe.Some(t) => f"{t}", Maybe.None => "NULL".to_text() };
        let error_lit = match &error_opt { Maybe.Some(e) => sql_text_literal(e), Maybe.None => "NULL".to_text() };
        let checksum = entry.checksum;
        let sql = f"INSERT INTO {table} (version, name, status, applied_at, error, checksum)\n               VALUES ({version}, {name_lit}, {status_lit}, {applied_lit}, {error_lit}, {checksum})\n               ON CONFLICT(version) DO UPDATE SET\n                   name = excluded.name,\n                   status = excluded.status,\n                   applied_at = excluded.applied_at,\n                   error = excluded.error,\n                   checksum = excluded.checksum";
        execute_raw(&mut self.conn, &sql).await
    }

    /// No native runner-level lock is implemented here. These no-op methods
    /// do not provide serialization across separate migration statements.
    async fn acquire_lock(&mut self) -> Result<(), DbError> { Result.Ok(()) }
    async fn release_lock(&mut self) -> Result<(), DbError> { Result.Ok(()) }

    async fn execute_sql(&mut self, sql: &Text) -> Result<(), DbError> {
        if self.config.transactional {
            // Existing raw transaction wrapper; this path does not establish
            // the stronger execute_step atomicity contract.
            execute_raw(&mut self.conn, &"BEGIN".to_text()).await?;
            let exec_res = execute_raw(&mut self.conn, sql).await;
            match exec_res {
                Result.Ok(_)  => execute_raw(&mut self.conn, &"COMMIT".to_text()).await,
                Result.Err(e) => {
                    let _ = execute_raw(&mut self.conn, &"ROLLBACK".to_text()).await;
                    Result.Err(e)
                }
            }
        } else {
            execute_raw(&mut self.conn, sql).await
        }
    }

    async fn execute_step(&mut self, sql: &Text, entry: &JournalEntry) -> Result<(), DbError> {
        // The current native connection resets transaction state on rollback
        // but does not restore its schema/table store. Do not execute any SQL
        // while promising atomic migration+journal persistence.
        if self.config.transactional {
            return Result.Err(DbError.Adapter(AdapterSpecific.new(
                AdSqlite, "migration_atomicity_unavailable",
                "native SQLite migration rollback does not restore schema and row changes", false,
            )));
        }
        // This retains the existing nontransactional execution path; it is not
        // an atomic fallback and its SQL/journal failures remain observable.
        execute_raw(&mut self.conn, sql).await?;
        self.upsert_entry(entry).await
    }

    async fn drop_tracking_table(&mut self) -> Result<(), DbError> {
        let sql = f"DROP TABLE IF EXISTS {self.config.table_name}";
        execute_raw(&mut self.conn, &sql).await
    }
}

// =============================================================================
// Helpers
// =============================================================================

fn render_status(s: &MigrationStatus) -> (Text, Maybe<Int64>, Maybe<Text>) {
    match s {
        MsPending          => ("pending".to_text(),      Maybe.None,    Maybe.None),
        MsApplied(t)       => ("applied".to_text(),      Maybe.Some(*t), Maybe.None),
        MsRolledBack(t)    => ("rolled_back".to_text(),  Maybe.Some(*t), Maybe.None),
        MsFailed(e)        => ("failed".to_text(),       Maybe.None,    Maybe.Some(e.clone())),
    }
}

fn sql_text_literal(t: &Text) -> Text {
    let bs = t.as_bytes();
    let mut out = Text.new();
    out.push_byte(0x27_u8);
    let mut i: Int = 0;
    while i < bs.len() {
        let b = bs[i];
        if b == 0x27_u8 {
            out.push_byte(0x27_u8); out.push_byte(0x27_u8);
        } else {
            out.push_byte(b);
        }
        i = i + 1;
    }
    out.push_byte(0x27_u8);
    out
}

async fn execute_raw(conn: &mut SqliteNativeConnection, sql: &Text) -> Result<(), DbError> {
    conn.execute_simple(sql).await.map(|_| ())
}

async fn query_journal_rows(conn: &mut SqliteNativeConnection, sql: &Text) -> Result<List<JournalEntry>, DbError> {
    let raw_rows = conn.query_simple(sql).await?;
    let mut entries: List<JournalEntry> = List.new();
    let mut i: Int = 0;
    while i < raw_rows.len() {
        let r = &raw_rows[i];
        let version    = r.get_int64("version")?;
        let name       = r.get_text("name")?;
        let status_txt = r.get_text("status")?;
        let applied_at = r.get_int64_nullable("applied_at")?;
        let error      = r.get_text_nullable("error")?;
        let checksum   = r.get_int64("checksum")?;
        entries.push(JournalEntry {
            version: version as Int,
            name: name,
            status: decode_status(status_txt, applied_at, error)?,
            checksum: checksum,
        });
        i = i + 1;
    }
    Result.Ok(entries)
}

