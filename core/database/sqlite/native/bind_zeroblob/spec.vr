// =============================================================================
// bind_zeroblob/spec.vr — ZeroBlobSpec
// =============================================================================
// Spec: SQLite C API
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.bind_zeroblob.spec;

mount base.{Bool};

public type ZeroBlobApi is
      ZaV1         // sqlite3_bind_zeroblob (32-bit)
    | ZaV2;        // sqlite3_bind_zeroblob64

public type ZeroBlobSpec is {
    size_bytes: Int64,
    api: ZeroBlobApi,
}

implement ZeroBlobSpec {
    public(in core.database.sqlite.native.bind_zeroblob) fn size(&self) -> Int64 {
        if self.size_bytes < 0_i64 { 0_i64 } else { self.size_bytes }
    }

    public(in core.database.sqlite.native.bind_zeroblob) fn exceeds_bind_limit(&self, limit: Int) -> Bool {
        match &self.api {
            ZaV1 => false,
            ZaV2 => self.size_bytes < 0_i64 || self.size_bytes > (limit as Int64),
        }
    }
}

public fn v1_spec(size_bytes: Int) -> ZeroBlobSpec {
    ZeroBlobSpec { size_bytes: size_bytes as Int64, api: ZaV1 }
}

public fn v2_spec(size_bytes: Int64) -> ZeroBlobSpec {
    ZeroBlobSpec { size_bytes: size_bytes, api: ZaV2 }
}

/// The V1 size must fit a signed C int. A negative V1 size binds an empty BLOB.
/// The V2 constructor accepts the nonnegative range of its Int64 argument.
public fn is_valid(s: &ZeroBlobSpec) -> Bool {
    match &s.api {
        ZaV1 => s.size_bytes >= -2147483648_i64 && s.size_bytes <= 2147483647_i64,
        ZaV2 => s.size_bytes >= 0_i64,
    }
}
