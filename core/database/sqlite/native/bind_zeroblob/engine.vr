// =============================================================================
// bind_zeroblob/engine.vr — per-stmt zeroblob-bind slot
// =============================================================================
// Spec: SQLite C API
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.bind_zeroblob.engine;

mount base.{Bool, Maybe};
mount collections.List;
mount core.database.sqlite.native.limits_api.category.{LimitCategory, default_hard_max};
mount core.database.sqlite.native.limits_api.budget.LimitBudget;
mount core.database.sqlite.native.bind_zeroblob.spec.{
    ZeroBlobSpec, is_valid,
};

public type ZeroBlobSlot is {
    index: Int,
    spec: Maybe<ZeroBlobSpec>,
}

public fn empty_slot(index: Int) -> ZeroBlobSlot {
    ZeroBlobSlot { index: index, spec: Maybe.None }
}

public type ZeroBlobBindEngine is {
    slots: List<ZeroBlobSlot>,
    rejections: Int64,
}

public fn new_engine(n_params: Int) -> ZeroBlobBindEngine {
    let mut slots: List<ZeroBlobSlot> = List.new();
    let mut i: Int = 0;
    while i <= n_params { slots.push(empty_slot(i)); i = i + 1; }
    ZeroBlobBindEngine { slots: slots, rejections: 0 as Int64 }
}

implement ZeroBlobBindEngine {
    /// Bind using the default connection limit.
    public fn sqlite3_bind_zeroblob(&mut self, index: Int, spec: ZeroBlobSpec) -> Int {
        self.bind_with_length_limit(index, spec, default_hard_max(&LimitCategory.LcLength))
    }

    /// Use the connection's current SQLITE_LIMIT_LENGTH for the 64-bit binding.
    public fn bind_with_budget(&mut self, index: Int, spec: ZeroBlobSpec, budget: &LimitBudget) -> Int {
        self.bind_with_length_limit(index, spec, budget.get(&LimitCategory.LcLength))
    }

    fn bind_with_length_limit(&mut self, index: Int, spec: ZeroBlobSpec, limit: Int) -> Int {
        if spec.exceeds_bind_limit(limit) {
            self.rejections = self.rejections + 1_i64;
            return 18;
        }
        if index <= 0 || index >= self.slots.len() {
            self.rejections = self.rejections + 1_i64;
            return 25;
        }
        if !is_valid(&spec) {
            self.rejections = self.rejections + 1_i64;
            return 18;
        }
        self.slots[index] = ZeroBlobSlot { index: index, spec: Maybe.Some(spec) };
        0
    }

    public fn clear(&mut self, index: Int) -> Bool {
        if index <= 0 || index >= self.slots.len() { return false; }
        self.slots[index] = empty_slot(index);
        true
    }

    public fn rejection_count(&self) -> Int64 { self.rejections }

    /// A bound zero-length BLOB has size Some(0). An unbound parameter has None.
    public fn bound_size(&self, index: Int) -> Maybe<Int64> {
        if index <= 0 || index >= self.slots.len() { return Maybe.None; }
        match &self.slots[index].spec {
            Maybe.Some(s) => Maybe.Some(s.size()),
            Maybe.None => Maybe.None,
        }
    }

    public fn slot_size(&self, index: Int) -> Int64 {
        self.bound_size(index).unwrap_or(0_i64)
    }
}
