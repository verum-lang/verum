// =============================================================================
// dst/harness.vr — top-level DST state machine
// =============================================================================
// Spec: sqlite-native.md §22.5 (DST)
//

// `DstHarness` ties seed → generator → fault-schedule → oracle. The
// caller drives one `step()` per logical op; the harness reports
// every fault site + the final state to compare against the live DB
// after recovery.
//

// Lifecycle:
//

//  let mut h = harness_from_seed(0x1234, 100);
//  while !h.is_terminated() {
//  let plan = h.next_step();
//  // execute plan.op against the DB; if plan.fault is Some,
//  // inject it through the simulated VFS.
//  h.advance();
//  }
//  let expected = h.expected_state();
//  // assert!(expected.matches(&observed_after_recovery));
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.dst.harness;

mount base.{Bool, Maybe};
mount core.database.sqlite.native.dst.seed.seed_from_u64;
mount core.database.sqlite.native.dst.op.{
    DbOp, DstOpStream,
};
mount core.database.sqlite.native.dst.generator.{
    generator_new, default_mix,
};
mount core.database.sqlite.native.dst.fault.{
    Fault, FaultSchedule,
    generate_schedule, default_density, is_terminal,
};
mount core.database.sqlite.native.dst.oracle.{
    Oracle, oracle_replay,
};

// -----------------------------------------------------------------------------
// StepPlan — what the caller does at this op index
// -----------------------------------------------------------------------------

public type StepPlan is {
    public op_idx: Int,
    public op: DbOp,
    public fault: Maybe<Fault>,
    /// True if this fault terminates the run.
    public terminate: Bool,
}

// -----------------------------------------------------------------------------
// DstHarness
// -----------------------------------------------------------------------------

public type DstHarness is {
    stream: DstOpStream,
    schedule: FaultSchedule,
    op_idx: Int,
    terminated: Bool,
}

public fn harness_from_seed(seed: Int64, total_ops: Int) -> DstHarness {
    let s = seed_from_u64(seed);
    let mix = default_mix();
    let mut g = generator_new(s, mix);
    let stream = g.emit(total_ops);
    // Re-derive a fresh seed for the schedule so the fault choices
    // are statistically independent of the op draws.
    let mut sched_seed = seed_from_u64(seed + 1_i64);
    let schedule = generate_schedule(&mut sched_seed, total_ops, &default_density());
    harness_from_stream(stream, schedule)
}

/// Replay an operation stream with a caller-supplied fault schedule.
public fn harness_from_stream(stream: DstOpStream, schedule: FaultSchedule) -> DstHarness {
    DstHarness {
        stream: stream,
        schedule: schedule,
        op_idx: 0,
        terminated: false,
    }
}

implement DstHarness {
    public fn total_ops(&self) -> Int { self.stream.len() }
    public fn current_op(&self) -> Int { self.op_idx }
    public fn is_terminated(&self) -> Bool { self.terminated || self.op_idx >= self.stream.len() }

    public fn next_step(&self) -> Maybe<StepPlan> {
        if self.is_terminated() { return Maybe.None; }
        let fault: Maybe<Fault> = self.schedule.fault_at(self.op_idx);
        let terminate = match &fault {
            Maybe.Some(event) => is_terminal(event),
            Maybe.None => false,
        };
        Maybe.Some(StepPlan {
            op_idx: self.op_idx,
            op: self.stream.operation_at(self.op_idx).clone(),
            fault: fault,
            terminate: terminate,
        })
    }

    public fn advance(&mut self) {
        if self.is_terminated() { return; }
        if let Maybe.Some(event) = self.schedule.fault_at(self.op_idx) {
            self.terminated = is_terminal(&event);
        }
        self.op_idx += 1;
    }

    /// Compute the oracle state at the durability cut.
    public fn expected_state(&self) -> Oracle {
        let cut = self.durability_cut();
        oracle_replay(&self.stream, cut)
    }

    /// Exclusive prefix ending after the last commit before the crash.
    public fn durability_cut(&self) -> Int {
        let limit = self.schedule.terminal_at().unwrap_or(self.stream.len());
        self.stream.last_durable_index(limit) + 1
    }
}
