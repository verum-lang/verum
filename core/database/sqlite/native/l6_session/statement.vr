@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l6_session.statement;

// =============================================================================
// l6_session/statement.vr — prepared statement
// =============================================================================
// Layer: 6
// Spec: sqlite-native.md §16.3
//

// `PreparedStatement` is the compiled VdbeProgram + its execution
// state. SQLite's public API exposes it as `sqlite3_stmt`; in loom it
// is an affine record owned by the caller.
//

// Lifecycle:
//

//  prepare(sql) → PreparedStatement { program, state, ... }
//  bind_int(n, v) → patch a ?N parameter
//  step() → StepResult (Row | Done | ExecError)
//  current_row() → &RegisterFile view on the row registers
//  reset() → rewind pc to 0, preserve bindings
//  finalize() → consume the statement
//

// A fresh `state` is built by `prepare`; `reset` replaces it with a
// new one while preserving the compiled program.
// =============================================================================

mount collections.List;
mount base.{Result, Ok, Err, Text};
mount core.database.sqlite.native.l4_vdbe.{
    Register, RegisterFile, register_file_new,
    Opcode, VdbeProgram, program_new, VdbeState, vdbe_state_new, step, StepResult,
    run_until_row,
    CursorSlotKind,
};
mount core.database.sqlite.native.l5_sql.{
    compile, compile_with_schema, CompileError,
};
mount core.database.sqlite.native.l6_session.schema_cache.SchemaCache;

// -----------------------------------------------------------------------------
// PreparedStatement
// -----------------------------------------------------------------------------

public type StmtError is
      StmtCompile(CompileError)
    | StmtExec(Int /* code */, Text /* message */)
    | StmtMisuse(Text)
    | StmtBindOutOfRange(Int);

implement Display for StmtError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            StmtCompile(e)        => f.write_str(f"sqlite stmt: {e}".as_str()),
            StmtExec(code, msg)   => f.write_str(f"sqlite stmt exec error {code}: {msg}".as_str()),
            StmtMisuse(msg)       => f.write_str(f"sqlite stmt misuse: {msg}".as_str()),
            StmtBindOutOfRange(i) => f.write_str(f"sqlite stmt bind index {i} out of range".as_str()),
        }
    }
}

implement Debug for StmtError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            StmtCompile(e)        => f.write_str(f"StmtCompile({e})".as_str()),
            StmtExec(code, msg)   => f.write_str(f"StmtExec({code}, {msg})".as_str()),
            StmtMisuse(msg)       => f.write_str(f"StmtMisuse({msg})".as_str()),
            StmtBindOutOfRange(i) => f.write_str(f"StmtBindOutOfRange({i})".as_str()),
        }
    }
}

implement PartialEq for StmtError {
    fn eq(&self, other: &StmtError) -> Bool {
        match (self, other) {
            (StmtCompile(a),         StmtCompile(b))         => a == b,
            (StmtExec(ca, ma),       StmtExec(cb, mb))       => ca == cb && ma == mb,
            (StmtMisuse(a),          StmtMisuse(b))          => a == b,
            (StmtBindOutOfRange(a),  StmtBindOutOfRange(b))  => a == b,
            _ => false,
        }
    }
}

implement Eq for StmtError {}

public type PreparedStatement is {
    program: VdbeProgram,
    state: VdbeState,
    sql: Text,
    done: Bool,
    finalized: Bool,
    successful: Bool,
    published: Bool,
    row_scope: Maybe<Shared<Int>>,
    last_row_start: Int,
    last_row_cols: Int,
};

/// Compile `sql` into a prepared statement. The freshly-made state
/// starts at pc=0 with all registers null.
public fn prepare(sql: &Text) -> Result<PreparedStatement, StmtError> {
    let program = match compile(sql) {
        Result.Ok(p)  => p,
        Result.Err(e) => { return Result.Err(StmtCompile(e)); }
    };
    Result.Ok(prepared_program(sql, program))
}

/// Schema-aware prepare. Resolves column references against the
/// caller's SchemaCache so that SELECT ... FROM t works. Non-SELECT
/// statements take the same code path as `prepare`.
public fn prepare_with_schema(sql: &Text, schema: &SchemaCache) -> Result<PreparedStatement, StmtError> {
    let program = match compile_with_schema(sql, schema) {
        Result.Ok(p)  => p,
        Result.Err(e) => { return Result.Err(StmtCompile(e)); }
    };
    Result.Ok(prepared_program(sql, program))
}

public(in core.database.sqlite.native) fn prepared_program(sql: &Text, program: VdbeProgram) -> PreparedStatement {
    let state = vdbe_state_new(&program);
    PreparedStatement {
        program, state, sql: sql.clone(),
        done: false, finalized: false, successful: false, published: false, row_scope: Maybe.None,
        last_row_start: 0, last_row_cols: 0,
    }
}

implement PreparedStatement {
    public fn sql_text(&self) -> &Text { &self.sql }
    public fn is_done(&self) -> Bool { self.done }
    public(in core.database.sqlite.native.l6_session) fn is_finalized(&self) -> Bool { self.finalized }
    public fn result_column_count(&self) -> Int { self.program.result_column_count() }

    // -------------------------------------------------------------------------
    // Bindings
    // -------------------------------------------------------------------------

    public(in core.database.sqlite.native.l6_session) fn bind_value(&mut self, idx: Int, value: Register) {
        if !self.finalized { self.state.bindings_mut().set_positional(idx, value); }
    }

    public(in core.database.sqlite.native.l6_session) fn bind_named_value(&mut self, name: Text, value: Register) {
        if !self.finalized { self.state.bindings_mut().set_named(name, value); }
    }

    public(in core.database.sqlite.native.l6_session) fn clear_binding_values(&mut self) {
        self.state.bindings_mut().clear_values();
    }

    public fn bind_null(&mut self, idx: Int) { self.bind_value(idx, Register.RNull); }
    public fn bind_int(&mut self, idx: Int, value: Int64) { self.bind_value(idx, RInt(value)); }
    public fn bind_real(&mut self, idx: Int, value: Float64) { self.bind_value(idx, RReal(value)); }
    public fn bind_text(&mut self, idx: Int, value: Text) { self.bind_value(idx, RText(value)); }
    public fn bind_blob(&mut self, idx: Int, value: List<Byte>) { self.bind_value(idx, RBlob(value)); }

    public fn bind_int_named(&mut self, name: Text, value: Int64) { self.bind_named_value(name, RInt(value)); }
    public fn bind_text_named(&mut self, name: Text, value: Text) { self.bind_named_value(name, RText(value)); }

    // -------------------------------------------------------------------------
    // Step / row access
    // -------------------------------------------------------------------------

    /// Advance execution until a row, done, or error. Returns a tag
    /// the caller pattern-matches to decide whether to read a row.
    public fn step(&mut self) -> StepResult {
        self.step_with_budget(-1)
    }

    public(in core.database.sqlite.native.l6_session) fn step_with_budget(&mut self, budget: Int) -> StepResult {
        self.last_row_cols = 0;
        if self.done { return StepResult.Done; }
        let result = run_until_row(&mut self.state, &self.program, budget);
        match result {
            Row(start, cols) => {
                self.last_row_start = start;
                self.last_row_cols = cols;
                Row(start, cols)
            }
            Done => {
                self.done = true;
                self.successful = true;
                StepResult.Done
            }
            ExecError(c, m) => {
                self.done = true;
                ExecError(c, m)
            }
            Yield => Yield,
        }
    }

    /// Read the nth column of the current row. Returns RNull if no
    /// row is currently emitted or `n` is out of range.
    public fn column(&self, n: Int) -> Register {
        if n < 0 || n >= self.last_row_cols { return Register.RNull; }
        self.state.reg(self.last_row_start + n)
    }

    // -------------------------------------------------------------------------
    // Reset / finalize
    // -------------------------------------------------------------------------

    /// Rewind the statement to pc=0 without recompiling. Keeps the
    /// binding table so the caller can re-run the same query with
    /// different parameter values.
    public fn reset(&mut self) {
        if self.finalized { return; }
        let mut next = vdbe_state_new(&self.program);
        self.state.transfer_bindings_to(&mut next);
        self.rewind(next);
    }

    fn rewind(&mut self, state: VdbeState) {
        self.state = state;
        self.done = false;
        self.successful = false;
        self.published = false;
        self.row_scope = Maybe.None;
        self.last_row_start = 0;
        self.last_row_cols = 0;
    }

    public(in core.database.sqlite.native.l6_session) fn finish(&mut self) {
        let empty = program_new(Text.new(), 0);
        self.rewind(vdbe_state_new(&empty));
        self.done = true;
        self.finalized = true;
    }

    /// Clear every binding back to RNull. `reset` does NOT do this —
    /// SQLite's `sqlite3_clear_bindings` is a separate call for a
    /// reason (the typical `reset + rebind + step` loop only changes
    /// a subset of params).
    public fn clear_bindings(&mut self) {
        self.state.bindings_mut().clear();
    }

    // -------------------------------------------------------------------------
    // Introspection — useful for tests and EXPLAIN
    // -------------------------------------------------------------------------

    public fn instruction_count(&self) -> Int { self.program.instruction_count() }
    public fn program_counter(&self) -> Int { self.state.program_counter() }
    public fn cursor_count(&self) -> Int { self.program.cursor_count() }

    /// Accessors for the L6 cursor-bridge helpers. Exposed so
    /// `l6_session.bridge.seed_cursors_from_connection` and its
    /// writeback sibling can reach the state without requiring a
    /// visibility downgrade on the underlying fields.
    public(in core.database.sqlite.native) fn bind_row_scope(&mut self, scope: Shared<Int>) -> Bool {
        if self.done || self.state.program_counter() != 0 || self.row_scope.is_some() { return false; }
        self.row_scope = Maybe.Some(scope);
        true
    }
    public(in core.database.sqlite.native) fn completed(&self) -> Bool { self.successful }
    public(in core.database.sqlite.native) fn was_published(&self) -> Bool { self.published }
    public(in core.database.sqlite.native) fn mark_published(&mut self) { self.published = true; }
    public(in core.database.sqlite.native) fn bound_row_scope(&self) -> Maybe<Shared<Int>> { self.row_scope.clone() }
    public fn program_ref(&self) -> &VdbeProgram { &self.program }
    public fn state_ref(&self) -> &VdbeState { &self.state }
    public fn state_mut(&mut self) -> &mut VdbeState { &mut self.state }
}
