@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l6_session.bridge;

// =============================================================================
// l6_session/bridge.vr — seed / writeback between PreparedStatement cursors
//  and the SqliteNativeConnection's persistent row store
// =============================================================================
// Layer: 6
// Spec: sqlite-native.md §16.3 + §17
//

// Bridges the per-statement VdbeState.cursors and the connection-scoped
// table_store, so INSERT / SELECT across statements in the same
// connection see each other's rows.
// =============================================================================

mount collections.List;
mount base.{Result, Ok, Err, Text};
mount core.database.sqlite.native.l4_vdbe.opcode.Opcode;
mount core.database.sqlite.native.l4_vdbe.interpreter.{
    RowMutation, RowMutationKind, RmkInsert, RmkUpdate, RmkDelete,
};
mount core.database.sqlite.native.ext.hooks.{
    UpdateOp, UoInsert, UoUpdate, UoDelete,
};
mount core.database.sqlite.native.l6_session.connection.{SqliteNativeConnection, ConnectionError};
mount core.database.sqlite.native.l6_session.statement.PreparedStatement;

public fn seed_cursors_from_connection(
    stmt: &mut PreparedStatement,
    conn: &SqliteNativeConnection,
) {
    if !stmt.bind_row_scope(conn.row_scope()) { return; }
    let mut i = 0;
    while i < stmt.instruction_count() {
        let op = stmt.program_ref().get_opcode(i);
        let root = match op {
            Maybe.Some(Opcode.OpenRead(_, r, _)) | Maybe.Some(Opcode.OpenWrite(_, r, _))
                | Maybe.Some(Opcode.OpenIndex(_, r, _)) => r,
            _ => 0,
        };
        if root > 0 && !stmt.state_ref().cursor_table_ref().has_root(root) {
            stmt.state_mut().cursor_table_mut().seed_root(root, conn.row_revision(root), conn.rows_at(root));
        }
        i = i + 1;
    }
}

public fn writeback_cursors_to_connection(
    mut stmt: PreparedStatement,
    conn: &mut SqliteNativeConnection,
) -> Result<PreparedStatement, ConnectionError> {
    if stmt.was_published() { return Result.Ok(stmt); }
    if !stmt.completed() { return Result.Err(ConnectionError.IncompleteStatement); }
    let writes = stmt.state_ref().cursor_table_ref().pending_writes();
    if !writes.is_empty() {
        let scope = match stmt.bound_row_scope() {
            Maybe.Some(scope) => scope,
            Maybe.None => { return Result.Err(ConnectionError.StaleStatement); }
        };
        conn.publish_rows(scope, writes)?;
    }
    stmt.mark_published();
    if conn.registry_view().has_update_hook() {
        fire_update_hooks(stmt.state_mut().drain_mutations(), conn);
    }
    Result.Ok(stmt)
}

/// Deliver the completed statement's update-hook events in execution order.
fn fire_update_hooks(mutations: List<RowMutation>, conn: &mut SqliteNativeConnection) {
    if mutations.len() == 0 { return; }

    // We need both the schema (for root→table resolution) and the
    // mutable hook. Borrow them in turn — schema lookups don't
    // require &mut so we resolve into a small (op, table_meta, rowid)
    // staging list first, then iterate calling the hook.
    let main_db: Text = "main".clone();
    let mut staged: List<(UpdateOp, Text, Text, Int64)> = List.new();
    let mut i: Int = 0;
    while i < mutations.len() {
        let m = &mutations[i];
        if m.root_page > 0 {
            match conn.schema().lookup_table_by_root(m.root_page) {
                Maybe.Some(meta) => {
                    let op = match m.kind {
                        RmkInsert => UoInsert, RmkUpdate => UoUpdate, RmkDelete => UoDelete,
                    };
                    let schema_name = if meta.schema.is_empty() { main_db.clone() } else { meta.schema.clone() };
                    staged.push((op, schema_name, meta.name.clone(), m.rowid));
                }
                Maybe.None => {}
            }
        }
        i = i + 1;
    }

    // The registry owns the mutable hook slot and its dispatch.
    let mut k: Int = 0;
    while k < staged.len() {
        let entry = &staged[k];
        conn.registry_mut().invoke_update_hook(entry.0, entry.1.clone(), entry.2.clone(), entry.3);
        k = k + 1;
    }
}
