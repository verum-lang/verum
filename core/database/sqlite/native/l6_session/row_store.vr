@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l6_session.row_store;

mount core.database.sqlite.native.l4_vdbe.register.Register;
mount core.database.sqlite.native.l4_vdbe.cursor_table.CursorWriteback;

public(in core.database.sqlite.native) type CellAddress is {
    public(in core.database.sqlite.native) root: Int,
    public(in core.database.sqlite.native) row: Int,
    public(in core.database.sqlite.native) column: Int,
};

type SavedRows is { root: Int, previous: Maybe<List<List<Register>>> };

public(in core.database.sqlite.native) type ConnectionRows is {
    tables: Map<Int, List<List<Register>>>,
    revisions: Map<Int, Int>,
    scope: Shared<Int>,
    transaction: Bool,
    changes: Bool,
    changes_before_tx: Bool,
    undo: List<SavedRows>,
};

public(in core.database.sqlite.native) fn connection_rows() -> ConnectionRows {
    ConnectionRows { tables: Map.new(), revisions: Map.new(), scope: Shared.new(0),
        transaction: false, changes: false, changes_before_tx: false, undo: [] }
}

implement ConnectionRows {
    /// Row mutations are held by this connection until the SQL engine can write its page images.
    public(in core.database.sqlite.native) fn has_changes(&self) -> Bool { self.changes }

    public(in core.database.sqlite.native) fn scope(&self) -> Shared<Int> { self.scope.clone() }
    public(in core.database.sqlite.native) fn revision(&self, root: Int) -> Int {
        self.revisions.get_or(root, 0)
    }
    public(in core.database.sqlite.native) fn contains(&self, root: Int) -> Bool {
        self.tables.contains_key(root)
    }
    public(in core.database.sqlite.native) fn read(&self, root: Int) -> List<List<Register>> {
        self.tables.get_or(root, [])
    }

    public(in core.database.sqlite.native) fn cell(&self, address: &CellAddress) -> Maybe<&Register> {
        match self.tables.get_key_value(&address.root) {
            Maybe.Some((_, rows)) => {
                if address.row < 0 || address.row >= rows.len() || address.column < 0 || address.column >= rows[address.row].len() {
                    return Maybe.None;
                }
                Maybe.Some(&rows[address.row][address.column])
            }
            Maybe.None => Maybe.None,
        }
    }

    public(in core.database.sqlite.native) fn replace_cell(
        &mut self, address: CellAddress, value: Register,
    ) -> Bool {
        if self.cell(&address).is_none() { return false; }
        self.record_change(address.root);
        match self.tables.get_mut(&address.root) {
            Maybe.Some(rows) => { rows[address.row][address.column] = value; true }
            Maybe.None => false,
        }
    }

    fn record_change(&mut self, root: Int) {
        self.changes = true;
        let next = self.revision(root) + 1;
        let _ = self.revisions.insert(root, next);
        if self.transaction {
            for saved in self.undo.iter() { if saved.root == root { return; } }
            self.undo.push(SavedRows { root, previous: self.tables.get(root) });
        }
    }

    public(in core.database.sqlite.native) fn put(&mut self, root: Int, rows: List<List<Register>>) {
        self.record_change(root);
        let _ = self.tables.insert(root, rows);
    }
    public(in core.database.sqlite.native) fn remove(&mut self, root: Int) {
        if self.tables.contains_key(root) {
            self.record_change(root);
            let _ = self.tables.remove(root);
        }
    }
    public(in core.database.sqlite.native) fn begin(&mut self) {
        self.changes_before_tx = self.changes;
        self.transaction = true;
    }
    public(in core.database.sqlite.native) fn finish(&mut self, rollback: Bool) {
        self.transaction = false;
        self.scope = Shared.new(0);
        if rollback {
            self.changes = self.changes_before_tx;
            while let Maybe.Some(saved) = self.undo.pop() {
                match saved.previous {
                    Maybe.Some(rows) => { let _ = self.tables.insert(saved.root, rows); }
                    Maybe.None => { let _ = self.tables.remove(saved.root); }
                }
            }
        } else {
            self.undo.clear();
        }
    }

    // Validate every destination before publishing the first changed root.
    public(in core.database.sqlite.native) fn apply(&mut self, scope: Shared<Int>, writes: List<CursorWriteback>) -> Bool {
        if !self.scope.ptr_eq(&scope) { return false; }
        for change in writes.iter() {
            if self.revision(change.root_page) != change.revision { return false; }
        }
        for change in writes.iter() { self.put(change.root_page, change.rows.clone()); }
        true
    }
}
