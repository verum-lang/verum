@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l6_session.statement_lifecycle;

// =============================================================================
// l6_session/statement_lifecycle.vr — Prepared-statement bind/reset/finalize
// =============================================================================
// Layer: 6
// Spec: sqlite-native.md §17.2 (prepared-statement lifecycle)
//
// Standard SQLite-style prepared-statement lifecycle wired through
// the existing L4 VdbeProgram + L4 interpreter:
//
//   prepare → bind* → step (RowReady|Done|Error)+ → reset → bind* → step* → finalize
//
// Pre-fix: `statement.vr` shipped a `PreparedStatement` struct + a
// `prepare(sql)` constructor but no bind/reset/finalize machinery
// — the value was effectively read-only.  Post-fix: this module
// adds the full lifecycle + column-metadata access surface that
// real client code (DB drivers, ORM layers) needs.
//
// All operations are pure where possible; mutation is confined to
// the statement's VDBE state, which owns the execution registers, cursors
// and parameter bindings.
// =============================================================================

mount collections.List;
mount base.{Result, Text, Maybe};
mount core.database.sqlite.native.l4_vdbe.register.{Register, RegisterKind, register_kind};
mount core.database.sqlite.native.l4_vdbe.interpreter.StepResult;
mount core.database.sqlite.native.l6_session.statement.PreparedStatement;
mount core.database.sqlite.native.l6_session.sql_value.{
    SqlValue, ColumnType, sql_value_from_register, register_from_sql_value,
    value_type, value_to_int, value_to_real, value_to_text,
    value_to_blob, value_to_text16, value_bytes, value_bytes16,
    sql_text_from_utf16, column_type_code,
};

// -----------------------------------------------------------------------------
// StmtLifecycleError — augments StmtError with lifecycle-specific cases
// -----------------------------------------------------------------------------

public type LifecycleError is
      LeIndexOutOfRange(Int)
    | LeNoSuchParam(Text)
    | LeNotPositioned
    | LeNotResetable
    | LeAlreadyFinalized;

implement Display for LifecycleError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            LeIndexOutOfRange(i) => f.write_str(f"prepared stmt: bind index {i} out of range".as_str()),
            LeNoSuchParam(n)     => f.write_str(f"prepared stmt: no such named parameter '{n}'".as_str()),
            LeNotPositioned      => f.write_str("prepared stmt: cursor not positioned (call step first)"),
            LeNotResetable       => f.write_str("prepared stmt: not resetable in current state"),
            LeAlreadyFinalized   => f.write_str("prepared stmt: statement already finalized"),
        }
    }
}

// -----------------------------------------------------------------------------
// StepOutcome — the three terminal states of a step() call
// -----------------------------------------------------------------------------

public type StepOutcome is
      SoRowReady              // Result row available; call column_*
    | SoDone                  // Statement complete (no more rows)
    | SoErrored(Text);        // Runtime error; finalize / reset to recover

// -----------------------------------------------------------------------------
// Bind API
// -----------------------------------------------------------------------------

/// Bind a parameter by 1-based positional index (matches SQLite
/// `sqlite3_bind_*` semantics).  Index 0 is reserved/invalid.
///
/// The VDBE reads the bound register when it encounters
/// `Variable(reg_dst, idx)`.
public fn bind_positional(
    stmt: &mut PreparedStatement,
    index: Int,
    value: Register,
) -> Result<(), LifecycleError> {
    if stmt.is_finalized() { return Result.Err(LeAlreadyFinalized); }
    if index <= 0 { return Result.Err(LeIndexOutOfRange(index)); }
    stmt.bind_value(index, value);
    Result.Ok(())
}

/// Bind the name used by the SQL compiler, with the sigil removed:
/// pass `"user_id"` for the SQL parameter `:user_id`.
public fn bind_named(
    stmt: &mut PreparedStatement,
    name: Text,
    value: Register,
) -> Result<(), LifecycleError> {
    if stmt.is_finalized() { return Result.Err(LeAlreadyFinalized); }
    stmt.bind_named_value(name, value);
    Result.Ok(())
}

/// Convenience: bind every parameter to NULL.  Used by reset()
/// when the caller passes `clear_bindings=true`.
public fn clear_bindings(stmt: &mut PreparedStatement) {
    stmt.clear_binding_values();
}

// -----------------------------------------------------------------------------
// Step + lifecycle
// -----------------------------------------------------------------------------

/// Run the statement until the next ResultRow opcode or terminal
/// state.  Returns `SoRowReady` when a row is available (caller
/// reads via `column_*`); `SoDone` when no more rows remain;
/// `SoErrored(msg)` on runtime error.
///
/// On `SoRowReady`, the row's `(reg_start, n_cols)` window is
/// stamped into `stmt.last_row_start` / `stmt.last_row_cols` so
/// `column_value` can read each column from the register file.
public fn step_one(stmt: &mut PreparedStatement) -> StepOutcome {
    if stmt.is_finalized() { return SoErrored("prepared stmt: already finalized".clone()); }
    let max_steps: Int = 1000000;
    match stmt.step_with_budget(max_steps) {
        StepResult.Row(_, _) => SoRowReady,
        StepResult.Done => SoDone,
        StepResult.ExecError(code, msg) => SoErrored(format_exec_error(code, &msg)),
        StepResult.Yield => SoErrored(f"step_one: max_steps {max_steps} exceeded"),
    }
}

fn format_exec_error(code: Int, msg: &Text) -> Text {
    f"VDBE exec error (code {code}): {msg}"
}

/// Reset the statement to its initial state — clears the
/// interpreter's register file + cursor positions but DOES NOT
/// drop bindings (per SQLite semantics).  Pass
/// `also_clear_bindings = true` to drop them too (sqlite3_clear_bindings).
public fn reset(stmt: &mut PreparedStatement, also_clear_bindings: Bool) -> Result<(), LifecycleError> {
    if stmt.is_finalized() { return Result.Err(LeAlreadyFinalized); }
    stmt.reset();
    if also_clear_bindings {
        clear_bindings(stmt);
    }
    Result.Ok(())
}

/// Release execution state and bindings. Later bind, reset and finalize calls
/// return `LeAlreadyFinalized`; stepping reports a finalized statement.
public fn finalize(stmt: &mut PreparedStatement) -> Result<(), LifecycleError> {
    if stmt.is_finalized() { return Result.Err(LeAlreadyFinalized); }
    stmt.finish();
    Result.Ok(())
}

// -----------------------------------------------------------------------------
// Column accessors — read result-row values
// -----------------------------------------------------------------------------

/// Number of columns in the result row.  Available even before
/// the first step (returns the program's declared result-column
/// count).  O(1).
public fn column_count(stmt: &PreparedStatement) -> Int {
    stmt.result_column_count()
}

/// Column name at zero-based index `i`.  Returns the empty string
/// for out-of-range indices to match SQLite's defensive behaviour.
public fn column_name(stmt: &PreparedStatement, i: Int) -> Text {
    stmt.program_ref().result_column_name(i)
}

/// Declared column type as text (e.g. "INTEGER", "TEXT").  Empty
/// string for expressions without a declared type.
public fn column_declared_type(stmt: &PreparedStatement, i: Int) -> Text {
    stmt.program_ref().result_column_declared_type(i)
}

/// Column value at zero-based index `i` of the current result row.
/// Caller must have just received `SoRowReady` from `step_one`;
/// otherwise returns `RNull` (matches SQLite's defensive default).
///
/// Reads the register at `last_row_start + i` from the interpreter's
/// register file.  `step_one` populates `last_row_start` /
/// `last_row_cols` when it observes a `Row(start, n)` step result.
public fn column_value(stmt: &PreparedStatement, i: Int) -> Register {
    stmt.column(i)
}

/// Runtime kind of the column value (NULL / INTEGER / REAL / TEXT
/// / BLOB).  Wraps `register_kind` over `column_value`.
public fn column_kind(stmt: &PreparedStatement, i: Int) -> RegisterKind {
    register_kind(&column_value(stmt, i))
}

// =============================================================================
// Rich column accessors (#158) — `SqlValue`-based API matching
// the sqlite3_column_* C surface 1-to-1.
// =============================================================================

/// `sqlite3_column_value` — return the column as a first-class
/// `SqlValue`.  Out-of-range index → `VNull`, matching SQLite's
/// defensive default.  `RRowId` from the L4 register folds into
/// `VInt` (the rowid distinction is invisible at the API surface).
public fn column_sql_value(stmt: &PreparedStatement, i: Int) -> SqlValue {
    let r = stmt.column(i);
    sql_value_from_register(&r)
}

/// `sqlite3_column_type` — return the column's storage class.
public fn column_type(stmt: &PreparedStatement, i: Int) -> ColumnType {
    value_type(&column_sql_value(stmt, i))
}

/// `sqlite3_column_int64` — coerce the column to Int64.  NULL → 0,
/// REAL → trunc(...), TEXT → parse_leading_decimal_int, BLOB → 0.
public fn column_int(stmt: &PreparedStatement, i: Int) -> Int64 {
    value_to_int(&column_sql_value(stmt, i))
}

/// `sqlite3_column_double` — coerce to Float64.  NULL → 0.0,
/// INT → cast, TEXT → parse_leading_decimal_real, BLOB → 0.0.
public fn column_double(stmt: &PreparedStatement, i: Int) -> Float64 {
    value_to_real(&column_sql_value(stmt, i))
}

/// `sqlite3_column_text` — coerce to UTF-8 Text.  NULL → "",
/// INT/REAL → decimal repr, TEXT → bytes, BLOB → "".
public fn column_text(stmt: &PreparedStatement, i: Int) -> Text {
    value_to_text(&column_sql_value(stmt, i))
}

/// `sqlite3_column_text16` — coerce to UTF-16 code units (each
/// `Int` carries one 16-bit code unit; surrogate pairs naturally
/// expanded for code points > U+FFFF).
public fn column_text16(stmt: &PreparedStatement, i: Int) -> List<Int> {
    value_to_text16(&column_sql_value(stmt, i))
}

/// `sqlite3_column_blob` — coerce to a Blob (List<Byte>).
/// TEXT → UTF-8 bytes; INT/REAL/NULL → empty.
public fn column_blob(stmt: &PreparedStatement, i: Int) -> List<Byte> {
    value_to_blob(&column_sql_value(stmt, i))
}

/// `sqlite3_column_bytes` — byte length of the column's storage
/// representation (TEXT → UTF-8 byte count, BLOB → blob length,
/// INT/REAL/NULL → 0).
public fn column_bytes(stmt: &PreparedStatement, i: Int) -> Int {
    value_bytes(&column_sql_value(stmt, i))
}

/// `sqlite3_column_bytes16` — byte length of the UTF-16 encoding
/// (= 2 × number of UTF-16 code units).
public fn column_bytes16(stmt: &PreparedStatement, i: Int) -> Int {
    value_bytes16(&column_sql_value(stmt, i))
}

/// Numeric column-type code matching the SQLite C constants
/// (1 = INTEGER, 2 = FLOAT, 3 = TEXT, 4 = BLOB, 5 = NULL).
/// Useful for FFI bindings + serialisation.
public fn column_type_int(stmt: &PreparedStatement, i: Int) -> Int {
    column_type_code(&column_type(stmt, i))
}

// =============================================================================
// Rich bind accessors — symmetric with the column_* surface
// =============================================================================

/// `sqlite3_bind_value` analogue — bind a positional parameter via
/// the rich `SqlValue` type.  Lowers through the existing register
/// table so all bind paths converge in `bind_positional`.
public fn bind_sql_value(
    stmt: &mut PreparedStatement,
    idx: Int,
    v: SqlValue,
) -> Result<(), LifecycleError> {
    let r = register_from_sql_value(&v);
    bind_positional(stmt, idx, r)
}

/// `sqlite3_bind_text16` analogue — decode the UTF-16 code units
/// into UTF-8 Text and bind.  Returns `LeIndexOutOfRange` on bad
/// indices; emits `VNull` for unrecoverable UTF-16 (mismatched
/// surrogates) — matches SQLite's "best-effort" decode policy.
public fn bind_text16(
    stmt: &mut PreparedStatement,
    idx: Int,
    units: &List<Int>,
) -> Result<(), LifecycleError> {
    let v = sql_text_from_utf16(units);
    let r = register_from_sql_value(&v);
    bind_positional(stmt, idx, r)
}

// -----------------------------------------------------------------------------
// Execution convenience — step until done, collect rows
// -----------------------------------------------------------------------------

public type ExecOutcome is {
    rows: List<List<Register>>,
    error: Maybe<Text>,
}

/// Run the statement to completion, collecting every result row
/// into a `List<List<Register>>`.  Convenience wrapper; produces
/// the same observable behaviour as a manual step-loop.
public fn execute_collect(stmt: &mut PreparedStatement) -> ExecOutcome {
    let mut out = ExecOutcome { rows: List.new(), error: Maybe.None };
    let max_iter: Int = 1000000;
    let mut iter: Int = 0;
    while iter < max_iter {
        match step_one(stmt) {
            SoRowReady => {
                let mut row: List<Register> = List.new();
                // Fully-qualified path — bare `column_count` collides
                // with 4+ zero-arg `column_count()` siblings across
                // sqlite native modules; AOT-side lookup picks one of
                // those and rejects with arity mismatch.  Task #17/#39
                // mount-scope-aware lookup defect class.
                let n = core.database.sqlite.native.l6_session.statement_lifecycle.column_count(stmt);
                let mut c: Int = 0;
                while c < n {
                    row.push(column_value(stmt, c));
                    c = c + 1;
                }
                out.rows.push(row);
            }
            SoDone => return out,
            SoErrored(msg) => {
                out.error = Maybe.Some(msg);
                return out;
            }
        }
        iter = iter + 1;
    }
    out.error = Maybe.Some("execute_collect: max_iter exceeded".clone());
    out
}
