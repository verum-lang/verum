@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l5_sql.resolver;

// =============================================================================
// l5_sql/resolver.vr — name resolution for SELECT / DML expressions
// =============================================================================
// Layer: 5
// Spec: sqlite-native.md §13.1
//

// The resolver rewrites `EColumn(_, name)` AST nodes into
// `EColumnRef(cursor_id, col_idx)` using a ColumnScope built from the
// SchemaCache entry for the source table. Downstream codegen lowers
// `EColumnRef` into a `Column(cursor_id, col_idx, dst)` opcode.
//

// For v1 the resolver handles:
//

//  * SELECT from a single FROM table
//  * INSERT / UPDATE / DELETE targeting a single table
//  * Bare `SELECT expr` (no FROM) — nothing to resolve, passthrough
//

// Multi-table SELECT, subqueries, CTEs, and JOIN column resolution
// land with the planner enhancement; the resolver signature accepts
// a `List<ColumnScope>` for that forward-compatibility.
// =============================================================================

mount collections.{List, Map};
mount core.text.case_fold.equal_ascii_nocase;
mount base.{Result, Ok, Err, Text, Maybe};
mount core.database.sqlite.native.l5_sql.ast.{
    Expr, SqlLiteral, UnOp, BinOp, TableRef,
    SelectStmt, SelectKind, SimpleSelect, ResultColumnItem,
    FromItem, OrderTerm, LimitClause,
    InsertStmt, InsertSource, UpdateStmt, UpdateAssignment, DeleteStmt,
};
mount core.database.sqlite.native.l6_session.schema_cache.{
    TableMeta, SchemaCache,
};

// -----------------------------------------------------------------------------
// Errors
// -----------------------------------------------------------------------------

public type ResolveError is
      UnknownTable(name: Text)
    | UnknownColumn(column: Text)
    | AmbiguousColumn(column: Text)
    | TooComplex(what: Text);

public fn resolve_error_unknown_table(name: Text) -> ResolveError { UnknownTable(name) }
public fn resolve_error_unknown_column(col: Text) -> ResolveError { UnknownColumn(col) }

implement Display for ResolveError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            UnknownTable(name)    => f.write_str(f"sqlite unknown table: {name}".as_str()),
            UnknownColumn(col)    => f.write_str(f"sqlite unknown column: {col}".as_str()),
            AmbiguousColumn(col)  => f.write_str(f"sqlite ambiguous column reference: {col}".as_str()),
            TooComplex(what)      => f.write_str(f"sqlite query too complex to resolve: {what}".as_str()),
        }
    }
}

implement Debug for ResolveError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            UnknownTable(name)    => f.write_str(f"UnknownTable({name})".as_str()),
            UnknownColumn(col)    => f.write_str(f"UnknownColumn({col})".as_str()),
            AmbiguousColumn(col)  => f.write_str(f"AmbiguousColumn({col})".as_str()),
            TooComplex(what)      => f.write_str(f"TooComplex({what})".as_str()),
        }
    }
}

implement PartialEq for ResolveError {
    fn eq(&self, other: &ResolveError) -> Bool {
        match (self, other) {
            (UnknownTable(a),    UnknownTable(b))    => a == b,
            (UnknownColumn(a),   UnknownColumn(b))   => a == b,
            (AmbiguousColumn(a), AmbiguousColumn(b)) => a == b,
            (TooComplex(a),      TooComplex(b))      => a == b,
            _ => false,
        }
    }
}

implement Eq for ResolveError {}

// -----------------------------------------------------------------------------
// ColumnScope
// -----------------------------------------------------------------------------

/// One cursor's column name → col_idx map. SELECT chains multiple
/// scopes for JOIN disambiguation; v1 single-table path uses one.
public type ColumnScope is {
    cursor_id: Int,
    table: Text,                 // unqualified table name (for `t.col`)
    alias: Text,                 // user alias if any
    name_to_idx: Map<Text, Int>,
    n_cols: Int,
};

public fn scope_from_table_meta(
    cursor_id: Int,
    alias: Text,
    meta: &TableMeta,
) -> ColumnScope {
    let mut m: Map<Text, Int> = Map.new();
    let mut i: Int = 0;
    while i < meta.column_count() {
        let _ = m.insert(meta.column_name(i).to_ascii_lowercase(), i);
        i = i + 1;
    }
    ColumnScope {
        cursor_id: cursor_id,
        table: meta.name.clone(),
        alias: alias,
        name_to_idx: m,
        n_cols: meta.column_count(),
    }
}

// -----------------------------------------------------------------------------
// Column lookup over a list of scopes
// -----------------------------------------------------------------------------

fn lookup_unqualified(
    scopes: &List<ColumnScope>,
    name: &Text,
) -> Result<(Int, Int), ResolveError> {
    let key = name.to_ascii_lowercase();
    let mut found: Maybe<(Int, Int)> = Maybe.None;
    let mut i = 0;
    while i < scopes.len() {
        if let Maybe.Some((_, index)) = scopes[i].name_to_idx.get_key_value(&key) {
            if found.is_some() { return Result.Err(AmbiguousColumn(name.clone())); }
            found = Maybe.Some((scopes[i].cursor_id, *index));
        }
        i = i + 1;
    }
    match found {
        Maybe.Some(binding) => Result.Ok(binding),
        Maybe.None => Result.Err(UnknownColumn(name.clone())),
    }
}

fn lookup_qualified(
    scopes: &List<ColumnScope>,
    table: &Text,
    name: &Text,
) -> Result<(Int, Int), ResolveError> {
    let mut i: Int = 0;
    while i < scopes.len() {
        let s = &scopes[i];
        let qualifier = if s.alias.is_empty() { &s.table } else { &s.alias };
        if equal_ascii_nocase(qualifier, table) {
            if let Maybe.Some(index) = s.name_to_idx.get(name.to_ascii_lowercase()) {
                return Result.Ok((s.cursor_id, index));
            }
            return Result.Err(UnknownColumn(name.clone()));
        }
        i = i + 1;
    }
    Result.Err(UnknownTable(table.clone()))
}

// -----------------------------------------------------------------------------
// Expression rewrite
// -----------------------------------------------------------------------------

public fn resolve_expr(e: &Expr, scopes: &List<ColumnScope>) -> Result<Expr, ResolveError> {
    match e {
        EColumn(ref table, ref name) => {
            let binding = if table.name.is_empty() {
                lookup_unqualified(scopes, name)?
            } else {
                lookup_qualified(scopes, &table.name, name)?
            };
            Result.Ok(EColumnRef(binding.0, binding.1))
        }
        EUnary(op, ref inner) => Result.Ok(EUnary(op, resolve_child(inner, scopes)?)),
        EBinary(op, ref a, ref b) => Result.Ok(EBinary(op, resolve_child(a, scopes)?, resolve_child(b, scopes)?)),
        EFunc(ref name, ref args, distinct) => Result.Ok(EFunc(name.clone(), resolve_list(args, scopes)?, distinct)),
        EBetween(ref x, ref lo, ref hi, neg) => Result.Ok(EBetween(
            resolve_child(x, scopes)?, resolve_child(lo, scopes)?, resolve_child(hi, scopes)?, neg)),
        ELike(ref text, ref pattern, ref escape, neg) => Result.Ok(ELike(
            resolve_child(text, scopes)?, resolve_child(pattern, scopes)?, resolve_optional(escape, scopes)?, neg)),
        ECast(ref x, ref ty) => Result.Ok(ECast(resolve_child(x, scopes)?, ty.clone())),
        ECollate(ref x, ref collation) => Result.Ok(ECollate(resolve_child(x, scopes)?, collation.clone())),
        EIn(ref x, ref items, neg) => Result.Ok(EIn(resolve_child(x, scopes)?, resolve_list(items, scopes)?, neg)),
        ENullIf(ref a, ref b) => Result.Ok(ENullIf(resolve_child(a, scopes)?, resolve_child(b, scopes)?)),
        ECoalesce(ref items) => Result.Ok(ECoalesce(resolve_list(items, scopes)?)),
        ECase(ref scrutinee, ref arms, ref fallback) => {
            let resolved = resolve_optional(scrutinee, scopes)?;
            let mut mapped: List<(Expr, Expr)> = List.with_capacity(arms.len());
            let mut i = 0;
            while i < arms.len() {
                mapped.push((resolve_expr(&arms[i].0, scopes)?, resolve_expr(&arms[i].1, scopes)?));
                i = i + 1;
            }
            Result.Ok(ECase(resolved, mapped, resolve_optional(fallback, scopes)?))
        }
        EInSubquery(_, _, _) | EExists(_, _) | ESubquery(_) => Result.Err(TooComplex("subquery in expression")),
        ELit(ref literal) => Result.Ok(ELit(clone_literal(literal))),
        EVar(ref name) => Result.Ok(EVar(name.clone())),
        EPositional(index) => Result.Ok(EPositional(index)),
        EColumnRef(cursor, index) => Result.Ok(EColumnRef(cursor, index)),
    }
}

fn resolve_child(child: &Heap<Expr>, scopes: &List<ColumnScope>) -> Result<Heap<Expr>, ResolveError> {
    let resolved: Expr = resolve_expr(child.as_ref(), scopes)?;
    Result.Ok(Heap.new(resolved))
}

fn resolve_optional(child: &Maybe<Heap<Expr>>, scopes: &List<ColumnScope>) -> Result<Maybe<Heap<Expr>>, ResolveError> {
    match child {
        Maybe.Some(ref item) => Result.Ok(Maybe.Some(resolve_child(item, scopes)?)),
        Maybe.None => Result.Ok(Maybe.None),
    }
}

fn resolve_list(items: &List<Expr>, scopes: &List<ColumnScope>) -> Result<List<Expr>, ResolveError> {
    let mut mapped: List<Expr> = List.with_capacity(items.len());
    let mut i = 0;
    while i < items.len() {
        mapped.push(resolve_expr(&items[i], scopes)?);
        i = i + 1;
    }
    Result.Ok(mapped)
}

fn clone_literal(l: &SqlLiteral) -> SqlLiteral {
    match l {
        LNull  => LNull,
        LInt(i) => LInt(i),
        LReal(x) => LReal(x),
        LText(ref s) => LText(s.clone()),
        LBlob(ref b) => {
            let mut out: List<Byte> = List.with_capacity(b.len());
            out.extend_from_slice(b.as_slice());
            LBlob(out)
        }
        LTrue => LTrue,
        LFalse => LFalse,
        LCurrentDate => LCurrentDate,
        LCurrentTime => LCurrentTime,
        LCurrentTimestamp => LCurrentTimestamp,
        LStar => LStar,
    }
}

// -----------------------------------------------------------------------------
// Scope-building helpers — caller uses these to prep `scopes` for resolve_expr.
// -----------------------------------------------------------------------------

/// Build a one-cursor scope list for SELECT over a single table.
/// Returns the scope list plus the scalar cursor_id for convenience.
public fn build_single_table_scope(
    schema: &SchemaCache,
    tref: &TableRef,
    cursor_id: Int,
) -> Result<List<ColumnScope>, ResolveError> {
    let meta = match schema.lookup_table(&tref.schema, &tref.name) {
        Result.Ok(m)  => m,
        Result.Err(_) => { return Result.Err(UnknownTable(tref.name.clone())); }
    };
    let scope = scope_from_table_meta(cursor_id, tref.alias.clone(), &meta);
    let mut list: List<ColumnScope> = List.new();
    list.push(scope);
    Result.Ok(list)
}
