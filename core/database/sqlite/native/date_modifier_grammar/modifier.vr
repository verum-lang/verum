// DateModifier taxonomy.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.1")
)
module core.database.sqlite.native.date_modifier_grammar.modifier;

mount base.{Bool, Text, Int64};

public type DateUnit is
    | UDays
    | UHours
    | UMinutes
    | USeconds
    | UMonths
    | UYears
    ;

public fn unit_name(u: &DateUnit) -> Text {
    match u {
        UDays    => "days".clone(),
        UHours   => "hours".clone(),
        UMinutes => "minutes".clone(),
        USeconds => "seconds".clone(),
        UMonths  => "months".clone(),
        UYears   => "years".clone(),
    }
}

public fn is_variable_length(u: &DateUnit) -> Bool {
    // months and years are not fixed-duration (28–31 days / 365–366 days).
    match u {
        UMonths => true,
        UYears  => true,
        _       => false,
    }
}

public type DateModifier is
    | MdOffset { amount: Int64, unit: DateUnit }        // '+N DAYS' / '-5 MINUTES'
    | MdReplaceDate(Text)                           // 'YYYY-MM-DD'
    | MdReplaceTime(Text)                           // 'HH:MM:SS'
    | MdStartOfMonth
    | MdStartOfYear
    | MdStartOfDay
    | MdWeekday(Int64)                              // 0..6 (0=Sun)
    | MdLocalTime
    | MdUtc
    | MdUnixEpoch
    | MdJulianDay
    | MdSubsec
    ;

public fn modifier_kind(m: &DateModifier) -> Text {
    match m {
        DateModifier.MdOffset { .. }       => "offset".clone(),
        DateModifier.MdReplaceDate(_)      => "replace_date".clone(),
        DateModifier.MdReplaceTime(_)      => "replace_time".clone(),
        DateModifier.MdStartOfMonth        => "start_of_month".clone(),
        DateModifier.MdStartOfYear         => "start_of_year".clone(),
        DateModifier.MdStartOfDay          => "start_of_day".clone(),
        DateModifier.MdWeekday(_)          => "weekday".clone(),
        DateModifier.MdLocalTime           => "localtime".clone(),
        DateModifier.MdUtc                 => "utc".clone(),
        DateModifier.MdUnixEpoch           => "unixepoch".clone(),
        DateModifier.MdJulianDay           => "julianday".clone(),
        DateModifier.MdSubsec              => "subsec".clone(),
    }
}

public fn is_absolute(m: &DateModifier) -> Bool {
    match m {
        DateModifier.MdReplaceDate(_) => true,
        DateModifier.MdReplaceTime(_) => true,
        DateModifier.MdStartOfMonth   => true,
        DateModifier.MdStartOfYear    => true,
        DateModifier.MdStartOfDay     => true,
        DateModifier.MdWeekday(_)     => true,
        _                         => false,
    }
}

public fn is_timezone(m: &DateModifier) -> Bool {
    match m {
        DateModifier.MdLocalTime => true,
        DateModifier.MdUtc       => true,
        _                    => false,
    }
}

public fn is_output_format(m: &DateModifier) -> Bool {
    match m {
        DateModifier.MdUnixEpoch => true,
        DateModifier.MdJulianDay => true,
        DateModifier.MdSubsec    => true,
        _                    => false,
    }
}

public fn valid_weekday(n: Int64) -> Bool {
    n >= 0 as Int64 && n <= 6 as Int64
}
