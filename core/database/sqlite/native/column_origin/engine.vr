// =============================================================================
// column_origin/engine.vr — per-column origin table
// =============================================================================
// Spec: SQLite C API
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.column_origin.engine;

mount base.{Bool, Text};
mount collections.List;
mount core.database.sqlite.native.column_origin.info.ColumnOriginInfo;

public type ColumnOriginTable is {
    columns: List<ColumnOriginInfo>,
    /// Mirrors SQLITE_ENABLE_COLUMN_METADATA — if false, all accessors
    /// return empty strings.
    metadata_enabled: Bool,
}

public fn new_table(metadata_enabled: Bool) -> ColumnOriginTable {
    ColumnOriginTable {
        columns: List.new(),
        metadata_enabled: metadata_enabled,
    }
}

implement ColumnOriginTable {
    public fn push(&mut self, info: ColumnOriginInfo) {
        self.columns.push(info);
    }

    fn read(&self, col: Int, select: fn(&ColumnOriginInfo) -> Text) -> Text {
        if !self.metadata_enabled || col < 0 || col >= self.columns.len() {
            return "";
        }
        select(&self.columns[col])
    }

    public fn sqlite3_column_database_name(&self, col: Int) -> Text {
        self.read(col, |entry| entry.database.clone())
    }

    public fn sqlite3_column_table_name(&self, col: Int) -> Text {
        self.read(col, |entry| entry.table.clone())
    }

    public fn sqlite3_column_origin_name(&self, col: Int) -> Text {
        self.read(col, |entry| entry.origin.clone())
    }

    public fn sqlite3_column_decltype(&self, col: Int) -> Text {
        self.read(col, |entry| entry.decltype.clone())
    }

    public fn len(&self) -> Int { self.columns.len() }
}
