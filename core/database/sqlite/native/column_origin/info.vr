// =============================================================================
// column_origin/info.vr — ColumnOriginInfo
// =============================================================================
// Spec: SQLite C API
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.column_origin.info;

mount base.{Bool, Text};

public type ColumnOriginInfo is {
    /// Source schema ("main", "temp", ATTACH-ed).
    public(in super) database: Text,
    /// Source table — empty if the column is a computed expression.
    public(in super) table: Text,
    /// Source column — empty if derived.
    public(in super) origin: Text,
    /// Declared type (e.g. "INTEGER").
    public(in super) decltype: Text,
}

public fn new_info(
    database: Text,
    table: Text,
    origin: Text,
    decltype: Text,
) -> ColumnOriginInfo {
    ColumnOriginInfo {
        database: database,
        table: table,
        origin: origin,
        decltype: decltype,
    }
}

public fn derived_expression() -> ColumnOriginInfo {
    new_info("", "", "", "")
}

public fn is_derived(c: &ColumnOriginInfo) -> Bool {
    c.table.len() == 0 && c.origin.len() == 0
}
