@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.l0_vfs.posix_vfs;

// =============================================================================
// l0_vfs/posix_vfs.vr — Production POSIX VFS (Linux + macOS)
// =============================================================================
// Layer: 0
// Spec: sqlite-native.md §7.3
//

// Real-file VFS backed by the platform's POSIX syscall surface:
//

//  * open / close / unlink — via sys.linux.syscall (or sys.darwin.libsystem)
//  * pread / pwrite — via sys.common (atomic, no cursor)
//  * fsync (full or data) — via sys.durability
//  * byte-range locking — via sys.locking (5-state layered on top
//  in l0_vfs.locking)
//

// Windows (Win32Vfs) is a separate module — its open/lock surface has
// different semantics (HANDLE, OVERLAPPED, LockFileEx) and does not
// benefit from sharing code with POSIX.
//

// The `fetch`/`unfetch` memory-mapped capability is flagged as Unsupported
// in this v1 — the pager currently drives all I/O through pread/pwrite.
// `shm_map`/`shm_lock` are also Unsupported until the L1 WAL-index
// module lands (sqlite-native.md §8).
//

// Fully qualifies as a `SqliteFile` + `VfsProtocol` implementation.
// =============================================================================

mount collections.List;
mount base.{Result, Ok, Err, Text, Maybe};
mount core.sys.common.{
    FileDesc, OSError,
    pread, pwrite,
    ACCESS_F_OK, ACCESS_R_OK, ACCESS_W_OK,
};
mount core.intrinsics.runtime.time.realtime_nanos;

@cfg(target_os = "linux")
mount core.sys.linux.syscall as platform_syscall;

@cfg(target_os = "macos")
mount core.sys.darwin.libsystem as platform_libsystem;

mount core.database.sqlite.native.l0_vfs.vfs_protocol.{
    OpenFlags, SyncFlags, LockKind, VfsError, VfsErrorKind,
    AccessKind, DeviceFlags, device_flags_default, Timestamp,
    ShmLockFlags, SqliteFile, VfsProtocol,
};
mount core.database.sqlite.native.l0_vfs.locking.{
    SqliteLockManager, lock_manager_new,
    acquire_shared, acquire_reserved, acquire_pending, acquire_exclusive,
    release_all, check_reserved,
};

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

/// Stateless VFS singleton. Construct one per connection-pool and share.
public type PosixVfs is {};

/// Real-file handle. Owns the `FileDesc` plus the lock state machine.
public type PosixFile is {
    fd: FileDesc,
    path: Text,
    locks: SqliteLockManager,
    closed: Bool,
    delete_on_close: Bool,
};

// -----------------------------------------------------------------------------
// Open-flag translation
// -----------------------------------------------------------------------------
// Maps the semantic `OpenFlags` struct onto the raw platform O_* bitmask.
// Linux and macOS have different numeric values so we use cfg arms.

@cfg(target_os = "linux")
fn platform_oflags(flags: &OpenFlags) -> Int {
    // Linux: O_RDONLY=0, O_RDWR=2, O_CREAT=0o100, O_EXCL=0o200, O_TRUNC=0o1000
    let mut o: Int = 0;
    if flags.read_only {
        o = 0;   // O_RDONLY
    } else if flags.read_write {
        o = 2;   // O_RDWR
    } else {
        o = 0;
    }
    if flags.create     { o = o | 0o100; }
    if flags.exclusive  { o = o | 0o200; }
    // O_NOFOLLOW = 0o400_000 on Linux
    if flags.no_follow  { o = o | 0o400000; }
    o
}

@cfg(target_os = "macos")
fn platform_oflags(flags: &OpenFlags) -> Int {
    // Darwin: O_RDONLY=0, O_RDWR=2, O_CREAT=0x0200, O_EXCL=0x0800
    let mut o: Int = 0;
    if flags.read_only {
        o = 0;
    } else if flags.read_write {
        o = 2;
    }
    if flags.create     { o = o | 0x0200; }
    if flags.exclusive  { o = o | 0x0800; }
    // O_NOFOLLOW = 0x0100 on Darwin
    if flags.no_follow  { o = o | 0x0100; }
    o
}

// The platform wrappers add the terminator after copying the complete byte path.
fn validate_path(path: &[Byte]) -> Result<(), VfsError> {
    if path.len() >= 4096 {
        return Result.Err(VfsError { kind: InvalidArgument, message: "SQLite path is too long" });
    }
    let mut i = 0;
    while i < path.len() {
        if path[i] == 0 as Byte {
            return Result.Err(VfsError { kind: InvalidArgument, message: "SQLite path contains a NUL byte" });
        }
        i = i + 1;
    }
    Result.Ok(())
}

fn to_vfs_err(e: OSError) -> VfsError {
    let kind = if e.would_block() {
        VfsErrorKind.LockConflict
    } else if e.code == 2 {
        VfsErrorKind.NotFound   // ENOENT
    } else if e.code == 13 {
        VfsErrorKind.PermissionDenied   // EACCES
    } else if e.code == 17 {
        VfsErrorKind.AlreadyExists   // EEXIST
    } else if e.code == 28 {
        VfsErrorKind.DiskFull   // ENOSPC
    } else {
        VfsErrorKind.IoFailure
    };
    VfsError { kind: kind, message: e.message.clone() }
}

// -----------------------------------------------------------------------------
// Platform-specific primitive wrappers
// -----------------------------------------------------------------------------
// A tiny indirection layer keeps the `implement` bodies below identical
// across platforms.

@cfg(target_os = "linux")
fn sys_open(path: &[Byte], oflag: Int, mode: Int) -> Result<FileDesc, OSError> {
    platform_syscall.open(path, oflag, mode)
}

@cfg(target_os = "macos")
fn sys_open(path: &[Byte], oflag: Int, mode: Int) -> Result<FileDesc, OSError> {
    platform_libsystem.safe_open(path, oflag, mode)
}

@cfg(target_os = "linux")
fn sys_close(fd: FileDesc) -> Result<(), OSError> {
    platform_syscall.close(fd)
}

@cfg(target_os = "macos")
fn sys_close(fd: FileDesc) -> Result<(), OSError> {
    platform_libsystem.safe_close(fd)
}

@cfg(target_os = "linux")
fn sys_unlink(path: &[Byte]) -> Result<(), OSError> {
    platform_syscall.unlink(path)
}

@cfg(target_os = "macos")
fn sys_unlink(path: &[Byte]) -> Result<(), OSError> {
    platform_libsystem.safe_unlink(path)
}

// -----------------------------------------------------------------------------
// PosixFile methods (not part of the protocol surface — for tests/tools)
// -----------------------------------------------------------------------------

implement PosixFile {
    public fn fd(&self) -> FileDesc { self.fd }
    public fn path(&self) -> &Text { &self.path }
    public fn is_closed(&self) -> Bool { self.closed }

    public(in core.database.sqlite.native) fn reserve_backup(&self) -> Result<(), VfsError> {
        self.locks.reserve_backup()
    }

    public(in core.database.sqlite.native) fn release_backup(&self) -> Result<(), VfsError> {
        self.locks.release_backup()
    }

    public(in core.database.sqlite.native) fn same_file(&self, other: &PosixFile) -> Result<Bool, VfsError> {
        let first = match file_identity(self.fd) {
            Result.Ok(id) => id, Result.Err(e) => return Result.Err(to_vfs_err(e)),
        };
        let second = match file_identity(other.fd) {
            Result.Ok(id) => id, Result.Err(e) => return Result.Err(to_vfs_err(e)),
        };
        Result.Ok(first == second)
    }

    /// Each reader takes an independently releasable kernel lock on the same
    /// inode. A renamed or replaced pathname cannot protect the original file.
    public(in core.database.sqlite.native) fn backup_reader(&self) -> Result<PosixFile, VfsError> {
        let vfs = PosixVfs {};
        let mut reader = vfs.open(&self.path, core.database.sqlite.native.l0_vfs.vfs_protocol.flags_ro())?;
        let status = match self.same_file(&reader) {
            Result.Ok(true) => reader.lock(LockKind.Shared),
            Result.Ok(false) => Result.Err(VfsError { kind: LockConflict, message: "backup source pathname changed" }),
            Result.Err(e) => Result.Err(e),
        };
        match status {
            Result.Ok(_) => Result.Ok(reader),
            Result.Err(e) => { let _ = reader.close(); Result.Err(e) }
        }
    }
}

@cfg(target_os = "macos")
fn file_identity(fd: FileDesc) -> Result<(UInt64, UInt64), OSError> {
    let mut stat = platform_libsystem.safe_stat_zeroed();
    platform_libsystem.safe_fstat(fd, &mut stat)?;
    Result.Ok((stat.st_dev as UInt64, stat.st_ino))
}

@cfg(target_os = "linux")
fn file_identity(fd: FileDesc) -> Result<(UInt64, UInt64), OSError> {
    let mut stat = platform_syscall.stat_zeroed();
    platform_syscall.fstat(fd, &mut stat)?;
    Result.Ok((stat.st_dev, stat.st_ino))
}

// -----------------------------------------------------------------------------
// SqliteFile conformance
// -----------------------------------------------------------------------------

implement SqliteFile for PosixFile {
    fn read(&self, buf: &mut List<Byte>, offset: Int) -> Result<(), VfsError> {
        if self.closed {
            return Result.Err(VfsError { kind: Closed, message: "read on closed file" });
        }
        // SQLite's VFS accepts managed page storage. A fixed Byte array supplies
        // the packed buffer required by pread on every target.
        let mut packed: [Byte; 4096] = [0 as Byte; 4096];
        let mut done: Int = 0;
        while done < buf.len() {
            let left: Int = buf.len() - done;
            let count: Int = if left < 4096 { left } else { 4096 };
            let n: Int = match pread(self.fd, &mut packed[..count], offset + done) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(to_vfs_err(e)),
            };
            if n == 0 {
                while done < buf.len() { buf[done] = 0 as Byte; done = done + 1; }
                return Result.Err(VfsError { kind: ShortRead, message: "pread reached EOF" });
            }
            let mut i: Int = 0;
            while i < n { buf[done + i] = packed[i]; i = i + 1; }
            done = done + n;
        }
        Result.Ok(())
    }

    fn write(&mut self, buf: &[Byte], offset: Int) -> Result<(), VfsError> {
        if self.closed {
            return Result.Err(VfsError { kind: Closed, message: "write on closed file" });
        }
        let mut packed: [Byte; 4096] = [0 as Byte; 4096];
        let mut done: Int = 0;
        while done < buf.len() {
            let left: Int = buf.len() - done;
            let count: Int = if left < 4096 { left } else { 4096 };
            let mut i: Int = 0;
            while i < count { packed[i] = buf[done + i]; i = i + 1; }
            let n: Int = match pwrite(self.fd, &packed[..count], offset + done) {
                Result.Ok(n) => n,
                Result.Err(e) => return Result.Err(to_vfs_err(e)),
            };
            if n == 0 { return Result.Err(VfsError { kind: WriteFault, message: "pwrite made no progress" }); }
            done = done + n;
        }
        Result.Ok(())
    }

    fn truncate(&mut self, size: Int) -> Result<(), VfsError> {
        if self.closed {
            return Result.Err(VfsError { kind: Closed, message: "truncate on closed file" });
        }
        match core.sys.common.truncate(self.fd, size) {
            Result.Ok(_)  => Result.Ok(()),
            Result.Err(e) => Result.Err(to_vfs_err(e)),
        }
    }

    fn sync(&self, flags: SyncFlags) -> Result<(), VfsError> {
        if self.closed {
            return Result.Err(VfsError { kind: Closed, message: "sync on closed file" });
        }
        // **Sync mode dispatch** (post-fix):
        //

        //  `full=true` → `full_fsync` (F_FULLFSYNC / fsync /
        //  FlushFileBuffers — write-through).
        //  `data_only=true` → `data_only_fsync` (fdatasync on
        //  Linux; fsync on Darwin; same as
        //  full on Windows). ~5–20× faster
        //  per WAL-frame append.
        //  neither flag → `data_only_fsync` (defensive default).
        //

        // Pre-fix the function pessimistically called `full_fsync`
        // every time, ignoring `flags.data_only` entirely. WAL frame
        // appends fire at every commit; the per-frame cost dominated
        // throughput on rotational + datacenter SSDs that journal
        // metadata separately from data.
        if flags.full {
            match core.sys.common.full_fsync(self.fd) {
                Result.Ok(_)  => Result.Ok(()),
                Result.Err(e) => Result.Err(to_vfs_err(e)),
            }
        } else {
            match core.sys.common.data_only_fsync(self.fd) {
                Result.Ok(_)  => Result.Ok(()),
                Result.Err(e) => Result.Err(to_vfs_err(e)),
            }
        }
    }

    fn file_size(&self) -> Result<Int, VfsError> {
        if self.closed {
            return Result.Err(VfsError { kind: Closed, message: "file_size on closed file" });
        }
        match core.sys.common.file_size(self.fd) {
            Result.Ok(n)  => Result.Ok(n),
            Result.Err(e) => Result.Err(to_vfs_err(e)),
        }
    }

    fn lock(&mut self, kind: LockKind) -> Result<(), VfsError> {
        match kind {
            Unlocked  => release_all(&mut self.locks),
            Shared    => acquire_shared(&mut self.locks),
            Reserved  => acquire_reserved(&mut self.locks),
            Pending   => acquire_pending(&mut self.locks),
            Exclusive => acquire_exclusive(&mut self.locks),
        }
    }

    fn unlock(&mut self, kind: LockKind) -> Result<(), VfsError> {
        match kind {
            Unlocked => release_all(&mut self.locks),
            // "Unlock to shared" — drop reserved/pending/exclusive but
            // keep the shared byte.
            Shared => {
                if self.locks.holds_shared_only() {
                    Result.Ok(())
                } else {
                    // Drop the wider locks, re-acquire shared.
                    let _ = release_all(&mut self.locks);
                    acquire_shared(&mut self.locks)
                }
            }
            _ => Result.Err(VfsError {
                kind: InvalidArgument,
                message: "unlock target must be Unlocked or Shared",
            }),
        }
    }

    fn check_reserved_lock(&self) -> Result<Bool, VfsError> {
        check_reserved(&self.locks)
    }

    fn sector_size(&self) -> Int {
        // SQLite's default. Real sector probing requires ioctl BLKSSZGET
        // on Linux and F_GETSECSIZE on Darwin; 512 is the safe floor.
        512
    }

    fn device_characteristics(&self) -> DeviceFlags {
        let mut f = device_flags_default();
        // Conservative: only safe-append. Atomic-page is filesystem
        // specific (btrfs yes, ext4 no); probing is out of scope for v1.
        f.safe_append = true;
        f
    }

    fn fetch(&self, _offset: Int, _len: Int) -> Result<Maybe<List<Byte>>, VfsError> {
        // mmap-based fetch deferred to L1 once the pager can exploit it.
        Result.Ok(Maybe.None)
    }

    fn unfetch(&self, _offset: Int, _buf: &[Byte]) -> Result<(), VfsError> {
        Result.Ok(())
    }

    fn shm_map(&mut self, _region: Int, _size: Int, _extend: Bool)
        -> Result<List<Byte>, VfsError>
    {
        Result.Err(VfsError {
            kind: Unsupported,
            message: "shm_map pending WAL-index (L1) integration",
        })
    }

    fn shm_lock(&mut self, _start: Int, _count: Int, _flags: ShmLockFlags)
        -> Result<(), VfsError>
    {
        Result.Err(VfsError {
            kind: Unsupported,
            message: "shm_lock pending WAL-index (L1) integration",
        })
    }

    fn shm_barrier(&self) {}
    fn shm_unmap(&mut self, _delete_flag: Bool) {}

    fn close(&mut self) -> Result<(), VfsError> {
        if self.closed {
            return Result.Ok(());
        }
        // Release all locks before close — otherwise the kernel cleans
        // up via fd close, which is also fine, but explicit is clearer.
        let _ = release_all(&mut self.locks);
        let res = sys_close(self.fd);
        self.closed = true;

        if self.delete_on_close {
            match sys_unlink(self.path.as_bytes()) {
                Result.Ok(_) => {}
                Result.Err(e) => return Result.Err(to_vfs_err(e)),
            }
        }

        match res {
            Result.Ok(_)  => Result.Ok(()),
            Result.Err(e) => Result.Err(to_vfs_err(e)),
        }
    }
}

// -----------------------------------------------------------------------------
// VfsProtocol conformance
// -----------------------------------------------------------------------------

implement VfsProtocol for PosixVfs {
    type File = PosixFile;

    fn open(&self, path: &Text, flags: OpenFlags) -> Result<PosixFile, VfsError> {
        let raw = path.as_bytes();
        validate_path(raw)?;
        let oflag = platform_oflags(&flags);
        let mode: Int = if flags.create { 0o644 } else { 0 };
        match sys_open(raw, oflag, mode) {
            Result.Ok(fd) => {
                Result.Ok(PosixFile {
                    fd: fd,
                    path: path.clone(),
                    locks: lock_manager_new(fd),
                    closed: false,
                    delete_on_close: flags.delete_on_close,
                })
            }
            Result.Err(e) => Result.Err(to_vfs_err(e)),
        }
    }

    fn delete(&self, path: &Text, sync_dir: Bool) -> Result<(), VfsError> {
        let raw = path.as_bytes();
        validate_path(raw)?;
        match sys_unlink(raw) {
            Result.Ok(_)  => {
                if sync_dir {
                    // Best-effort directory sync on the parent.
                    let parent = parent_of(path);
                    let _ = core.sys.common.sync_directory(parent.as_bytes());
                }
                Result.Ok(())
            }
            Result.Err(e) => {
                if e.code == 2 {   // ENOENT
                    Result.Err(VfsError { kind: VfsErrorKind.NotFound, message: e.message.clone() })
                } else {
                    Result.Err(to_vfs_err(e))
                }
            }
        }
    }

    fn access(&self, path: &Text, kind: AccessKind) -> Result<Bool, VfsError> {
        // SQLite's three-valued probe maps onto POSIX access(2) modes:
        //  Exists → F_OK (presence test only)
        //  CanRead → F_OK | R_OK
        //  CanReadWrite → F_OK | R_OK | W_OK
        // sys.common.access returns Result.Ok(false) for ENOENT/EACCES/EROFS —
        // exactly what SQLite wants — and Err for genuine I/O faults.
        let mode: Int = match kind {
            Exists       => ACCESS_F_OK,
            CanRead      => ACCESS_F_OK | ACCESS_R_OK,
            CanReadWrite => ACCESS_F_OK | ACCESS_R_OK | ACCESS_W_OK,
        };
        let raw = path.as_bytes();
        validate_path(raw)?;
        match core.sys.common.access(raw, mode) {
            Result.Ok(b)  => Result.Ok(b),
            Result.Err(e) => Result.Err(to_vfs_err(e)),
        }
    }

    fn full_pathname(&self, path: &Text) -> Result<Text, VfsError> {
        // realpath() wrapper deferred; SQLite tolerates a relative path
        // passthrough for v1. PosixVfs callers are expected to canonicalise
        // via core.fs once it lands.
        Result.Ok(path.clone())
    }

    fn random_bytes(&self, len: Int) -> Result<List<Byte>, VfsError> {
        // Cryptographic-grade entropy from the kernel — getrandom on
        // Linux, getentropy on Darwin, BCryptGenRandom on Windows.
        // Required for unpredictable WAL header salts (sqlite-native.md
        // §6.5).
        //

        // Pre-fix the signature returned a bare `List<Byte>` and
        // funnelled entropy-source failures into an empty list,
        // which callers (WAL salt generator) would silently use as
        // zero bytes — letting an attacker forge WAL frames with
        // predictable checksums. Now every entropy-fetch failure
        // surfaces as `Result.Err(VfsError.IoFailure)` so callers MUST
        // explicitly handle the no-entropy case.
        if len <= 0 {
            return Result.Ok(List.new());
        }
        let mut out: List<Byte> = List.with_capacity(len);
        out.resize(len, 0 as Byte);
        let slice: &mut [Byte] = out.as_mut_slice();
        match core.sys.common.random_bytes(slice) {
            Result.Ok(_) => Result.Ok(out),
            Result.Err(_) => Result.Err(VfsError {
                kind: IoFailure,
                message: "PosixVfs.random_bytes: kernel entropy fetch failed".clone(),
            }),
        }
    }

    fn current_time(&self) -> Timestamp {
        // Wall-clock nanoseconds since the Unix epoch. SQLite WAL frame
        // headers and journal salts use this as a freshness probe; a
        // hard-zero (the previous stub) made every header timestamp
        // identical and broke replay ordering on multi-instance setups.
        Timestamp {
            nanos: realtime_nanos() as Int64,
            is_monotonic: false,
        }
    }

    fn get_last_error(&self) -> Maybe<VfsError> { Maybe.None }

    fn sleep_us(&self, _micros: Int) {
        // No-op; callers on PosixVfs already schedule via core.async.
    }
}

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn parent_of(path: &Text) -> Text {
    let raw = path.as_bytes();
    let mut last_slash: Int = -1;
    let mut i: Int = 0;
    while i < raw.len() {
        if raw[i] == (0x2F as Byte) {   // '/'
            last_slash = i;
        }
        i = i + 1;
    }
    if last_slash < 0 {
        return ".".clone();
    }
    if last_slash == 0 {
        return "/".clone();
    }
    // Manual slice — path.substr(0, last_slash)
    let mut out: List<Byte> = List.new();
    let mut j: Int = 0;
    while j < last_slash {
        out.push(raw[j]);
        j = j + 1;
    }
    Text.from_utf8(out.as_slice()).unwrap_or(".".clone())
}
