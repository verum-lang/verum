// =============================================================================
// errors/engine.vr — C-API name-aligned error accessors
// =============================================================================
// Spec: SQLite C API
//

//  sqlite3_errcode(db) → int (primary)
//  sqlite3_extended_errcode(db) → int (extended)
//  sqlite3_errmsg(db) → Text
//  sqlite3_error_offset(db) → int (-1 if N/A)
//  sqlite3_system_errno(db) → int
//  sqlite3_errstr(code) → Text (fallback)
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.errors.engine;

public mount core.database.sqlite.native.errors.message.{
    sqlite3_errcode, sqlite3_extended_errcode, sqlite3_errmsg,
    sqlite3_error_offset, sqlite3_system_errno, errstr as sqlite3_errstr,
};
