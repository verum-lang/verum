@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.vtabs.rtree.tree;

mount base.Maybe;
mount collections.List;
mount core.database.sqlite.native.vtabs.rtree.bbox.{BBox, MAX_DIMS};
mount core.database.sqlite.native.vtabs.rtree.node.{
    RTreeNode, LeafEntry, InternalEntry, internal_new, leaf_new, node_entry_count,
    node_mbb, node_parent, set_node_parent, RTREE_MAX_CELLS, RTREE_MIN_CELLS,
};

public type VtabRTree is {
    nodes: List<RTreeNode>,
    vacant: List<Int>,
    root_id: Int,
    n_dims: Int,
};

public fn rtree_new(n_dims: Int) -> VtabRTree {
    assert(n_dims >= 1 && n_dims <= MAX_DIMS, "R-tree dimensions must be between one and five");
    let mut nodes: List<RTreeNode> = List.new();
    nodes.push(leaf_new(0));
    VtabRTree { nodes: nodes, vacant: List.new(), root_id: 0, n_dims: n_dims }
}

// Start at opposite extremes on the first axis. Assign the remaining boxes
// by least enlargement, leaving each sibling at least the minimum occupancy.
fn split_groups(boxes: &List<BBox>) -> List<Bool> {
    let mut a = 0;
    let mut b = 0;
    let mut i = 1;
    while i < boxes.len() {
        if boxes[i].max_at(0) < boxes[a].max_at(0) { a = i; }
        if boxes[i].min_at(0) > boxes[b].min_at(0) { b = i; }
        i = i + 1;
    }
    if a == b { a = 0; b = boxes.len() - 1; }
    let mut left: List<Bool> = List.from_elem(false, boxes.len());
    left[a] = true;
    let mut left_box = boxes[a];
    let mut right_box = boxes[b];
    let mut left_count = 1;
    let mut right_count = 1;
    i = 0;
    while i < boxes.len() {
        if i != a && i != b {
            let remaining = boxes.len() - left_count - right_count;
            let mut take_left = left_count + remaining == RTREE_MIN_CELLS;
            if !take_left && right_count + remaining > RTREE_MIN_CELLS {
                let grow_left = left_box.enlargement_to_include(&boxes[i]);
                let grow_right = right_box.enlargement_to_include(&boxes[i]);
                take_left = grow_left < grow_right || (grow_left == grow_right && left_count <= right_count);
            }
            left[i] = take_left;
            if take_left {
                left_box = left_box.union(&boxes[i]);
                left_count = left_count + 1;
            } else {
                right_box = right_box.union(&boxes[i]);
                right_count = right_count + 1;
            }
        }
        i = i + 1;
    }
    left
}

// Child links and row entries stay in order within each sibling. Return whether
// the most recently appended entry moved to the sibling.
fn split_node(original: &mut RTreeNode, sibling_id: Int) -> (RTreeNode, Bool) {
    let mut boxes: List<BBox> = List.new();
    match original {
        Leaf(c) => { for entry in &c.entries { boxes.push(entry.bbox); } }
        Internal(c) => { for entry in &c.entries { boxes.push(entry.bbox); } }
    }
    let left = split_groups(&boxes);
    let mut sibling = match original {
        Leaf(c) => {
            let mut kept: List<LeafEntry> = List.new();
            let mut moved: List<LeafEntry> = List.new();
            let mut i = 0;
            while i < left.len() {
                if left[i] { kept.push(c.entries[i]); } else { moved.push(c.entries[i]); }
                i = i + 1;
            }
            c.entries = kept;
            let mut result_node = leaf_new(sibling_id);
            match &mut result_node { Leaf(r) => { r.entries = moved; } _ => unreachable() }
            result_node
        }
        Internal(c) => {
            let mut kept: List<InternalEntry> = List.new();
            let mut moved: List<InternalEntry> = List.new();
            let mut i = 0;
            while i < left.len() {
                if left[i] { kept.push(c.entries[i]); } else { moved.push(c.entries[i]); }
                i = i + 1;
            }
            c.entries = kept;
            let mut result_node = internal_new(sibling_id);
            match &mut result_node { Internal(r) => { r.entries = moved; } _ => unreachable() }
            result_node
        }
    };
    set_node_parent(&mut sibling, node_parent(original));
    (sibling, !left[left.len() - 1])
}

fn choose_child(entries: &List<InternalEntry>, bbox: &BBox) -> Int {
    assert(!entries.is_empty(), "empty internal R-tree node");
    let mut best = 0;
    let mut growth = entries[0].bbox.enlargement_to_include(bbox);
    let mut i = 1;
    while i < entries.len() {
        let g = entries[i].bbox.enlargement_to_include(bbox);
        if g < growth || (g == growth && entries[i].bbox.volume() < entries[best].bbox.volume()) {
            best = i;
            growth = g;
        }
        i = i + 1;
    }
    entries[best].child_node_id
}

fn child_position(entries: &List<InternalEntry>, child: Int) -> Int {
    let mut i = 0;
    while i < entries.len() {
        if entries[i].child_node_id == child { return i; }
        i = i + 1;
    }
    panic("missing R-tree child link")
}

implement VtabRTree {
    public fn dimensions(&self) -> Int { self.n_dims }
    public fn node_count(&self) -> Int { self.nodes.len() - self.vacant.len() }
    public fn root(&self) -> Int { self.root_id }

    fn allocate_node(&mut self) -> Int {
        if let Maybe.Some(id) = self.vacant.pop() { return id; }
        let id = self.nodes.len();
        self.nodes.push(leaf_new(id));
        id
    }

    fn release_node(&mut self, id: Int) {
        self.nodes[id] = leaf_new(id);
        self.vacant.push(id);
    }

    /// Insert a row and return the ID of the leaf that contains the new entry.
    public fn insert(&mut self, rowid: Int64, bbox: BBox) -> Int {
        assert(bbox.dimensions() == self.n_dims && !bbox.is_empty(), "invalid R-tree insertion box");
        let mut id = self.root_id;
        loop {
            match &mut self.nodes[id] {
                Leaf(c) => { c.entries.push(LeafEntry { rowid: rowid, bbox: bbox }); break; }
                Internal(c) => { id = choose_child(&c.entries, &bbox); }
            }
        }
        let mut inserted_leaf = id;
        loop {
            let parent = node_parent(&self.nodes[id]);
            let mut extra: Maybe<InternalEntry> = Maybe.None;
            if node_entry_count(&self.nodes[id]) > RTREE_MAX_CELLS {
                let sibling_id = self.allocate_node();
                let (sibling, last_moved) = split_node(&mut self.nodes[id], sibling_id);
                if id == inserted_leaf && last_moved { inserted_leaf = sibling_id; }
                match &sibling {
                    Internal(c) => {
                        for child in &c.entries {
                            set_node_parent(&mut self.nodes[child.child_node_id], Maybe.Some(sibling_id));
                        }
                    }
                    Leaf(_) => {}
                }
                extra = Maybe.Some(InternalEntry { child_node_id: sibling_id, bbox: node_mbb(&sibling).unwrap() });
                self.nodes[sibling_id] = sibling;
            }
            let entry = InternalEntry { child_node_id: id, bbox: node_mbb(&self.nodes[id]).unwrap() };
            match parent {
                Maybe.Some(up) => {
                    match &mut self.nodes[up] {
                        Internal(c) => {
                            let pos = child_position(&c.entries, id);
                            c.entries[pos] = entry;
                            if let Maybe.Some(s) = extra { c.entries.push(s); }
                        }
                        _ => unreachable(),
                    }
                    id = up;
                }
                Maybe.None => {
                    if let Maybe.Some(s) = extra {
                        let root = self.allocate_node();
                        let mut new_root = internal_new(root);
                        set_node_parent(&mut self.nodes[id], Maybe.Some(root));
                        set_node_parent(&mut self.nodes[s.child_node_id], Maybe.Some(root));
                        match &mut new_root {
                            Internal(c) => { c.entries.push(entry); c.entries.push(s); }
                            _ => unreachable(),
                        }
                        self.nodes[root] = new_root;
                        self.root_id = root;
                    }
                    return inserted_leaf;
                }
            }
        }
    }

    /// Return row IDs whose boxes overlap the query, including touching boundaries.
    public fn search(&self, query: &BBox) -> List<Int64> {
        let mut out: List<Int64> = List.new();
        let mut work: List<Int> = List.new();
        work.push(self.root_id);
        while let Maybe.Some(id) = work.pop() {
            match &self.nodes[id] {
                Leaf(c) => {
                    for entry in &c.entries {
                        if entry.bbox.overlaps(query) { out.push(entry.rowid); }
                    }
                }
                Internal(c) => {
                    let mut i = c.entries.len();
                    while i > 0 {
                        i = i - 1;
                        if c.entries[i].bbox.overlaps(query) { work.push(c.entries[i].child_node_id); }
                    }
                }
            }
        }
        out
    }

    public fn delete(&mut self, rowid: Int64) -> Bool {
        let mut work: List<Int> = List.new();
        work.push(self.root_id);
        while let Maybe.Some(id) = work.pop() {
            let removed = match &mut self.nodes[id] {
                Leaf(c) => {
                    let old = c.entries.len();
                    c.entries.retain(|entry| entry.rowid != rowid);
                    c.entries.len() != old
                }
                Internal(c) => {
                    let mut i = c.entries.len();
                    while i > 0 { i = i - 1; work.push(c.entries[i].child_node_id); }
                    false
                }
            };
            if removed {
                self.repair_after_delete(id);
                return true;
            }
        }
        false
    }

    fn repair_after_delete(&mut self, leaf: Int) {
        let mut id = leaf;
        while let Maybe.Some(up) = node_parent(&self.nodes[id]) {
            let bounds = node_mbb(&self.nodes[id]);
            let empty = bounds is Maybe.None;
            match &mut self.nodes[up] {
                Internal(c) => {
                    let pos = child_position(&c.entries, id);
                    match bounds {
                        Maybe.Some(b) => { c.entries[pos] = InternalEntry { child_node_id: id, bbox: b }; }
                        Maybe.None => { let _ = c.entries.remove(pos); }
                    }
                }
                _ => unreachable(),
            }
            if empty { self.release_node(id); }
            id = up;
        }
        loop {
            let next_root = match &self.nodes[self.root_id] {
                Internal(c) => {
                    if c.entries.len() > 1 { return; }
                    if c.entries.is_empty() { Maybe.None } else { Maybe.Some(c.entries[0].child_node_id) }
                }
                Leaf(_) => { return; }
            };
            match next_root {
                Maybe.Some(child) => {
                    let old_root = self.root_id;
                    self.root_id = child;
                    set_node_parent(&mut self.nodes[child], Maybe.None);
                    self.release_node(old_root);
                }
                Maybe.None => { self.nodes[self.root_id] = leaf_new(self.root_id); return; }
            }
        }
    }
}
