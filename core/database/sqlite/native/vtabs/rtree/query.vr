// =============================================================================
// rtree/query.vr — translate WHERE predicates → BBox range probe
// =============================================================================
// Spec: sqlite-native.md §16.3
//

// Common SQLite R-tree usage:
//

//  SELECT id FROM things_rtree
//  WHERE x_min <= 10 AND x_max >= 5
//  AND y_min <= 20 AND y_max >= 15;
//

// We collect every per-dimension lower / upper bound and build the
// final query bbox; the caller then runs `VtabRTree.search(&bbox)`.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.vtabs.rtree.query;

mount base.{Maybe, Bool};
mount collections.List;
mount core.database.sqlite.native.vtabs.rtree.bbox.{BBox, MAX_DIMS, bbox_new};

// -----------------------------------------------------------------------------
// PredicateAtom — one WHERE clause atom on a single coordinate
// -----------------------------------------------------------------------------

public type CoordOp is OpLE | OpGE | OpEq;

public type PredicateAtom is {
    /// Dimension index (0..n_dims-1).
    dim: Int,
    /// True for the `_max` slot, false for `_min` slot.
    is_max_slot: Bool,
    op: CoordOp,
    value: Float64,
};

public fn op_le(dim: Int, is_max_slot: Bool, value: Float64) -> PredicateAtom {
    PredicateAtom { dim: dim, is_max_slot: is_max_slot, op: OpLE, value: value }
}

public fn op_ge(dim: Int, is_max_slot: Bool, value: Float64) -> PredicateAtom {
    PredicateAtom { dim: dim, is_max_slot: is_max_slot, op: OpGE, value: value }
}

// -----------------------------------------------------------------------------
// QueryBuilder — accumulate atoms then build a probe bbox
// -----------------------------------------------------------------------------

type AxisBounds is { min_lo: Float64, min_hi: Float64, max_lo: Float64, max_hi: Float64 };

public type QueryBuilder is { axes: List<AxisBounds> };

public fn builder_new(n_dims: Int) -> QueryBuilder {
    assert(n_dims >= 1 && n_dims <= MAX_DIMS, "R-tree dimensions must be between one and five");
    let mut axes: List<AxisBounds> = List.new();
    while axes.len() < n_dims {
        axes.push(AxisBounds {
            min_lo: Float.NEG_INFINITY, min_hi: Float.INFINITY,
            max_lo: Float.NEG_INFINITY, max_hi: Float.INFINITY,
        });
    }
    QueryBuilder { axes: axes }
}

implement QueryBuilder {
    public fn add(&mut self, atom: PredicateAtom) {
        assert(atom.dim >= 0 && atom.dim < self.axes.len(), "invalid R-tree predicate dimension");
        assert(atom.value == atom.value, "R-tree coordinate is NaN");
        let mut axis = self.axes[atom.dim];
        let lower = !(atom.op is CoordOp.OpLE);
        let upper = !(atom.op is CoordOp.OpGE);
        if atom.is_max_slot {
            if lower && atom.value > axis.max_lo { axis.max_lo = atom.value; }
            if upper && atom.value < axis.max_hi { axis.max_hi = atom.value; }
        } else {
            if lower && atom.value > axis.min_lo { axis.min_lo = atom.value; }
            if upper && atom.value < axis.min_hi { axis.min_hi = atom.value; }
        }
        self.axes[atom.dim] = axis;
    }

    /// Build an overlap probe that includes every qualifying box. The caller
    /// applies residual predicates to the returned rows when an endpoint matters.
    public fn build(&self) -> BBox {
        let mut coords: List<Float64> = List.new();
        for axis in &self.axes {
            if axis.min_lo > axis.min_hi || axis.max_lo > axis.max_hi || axis.min_lo > axis.max_hi {
                coords.push(1.0); coords.push(0.0);
            } else {
                let lo = if axis.min_lo > axis.max_lo { axis.min_lo } else { axis.max_lo };
                let hi = if axis.min_hi < axis.max_hi { axis.min_hi } else { axis.max_hi };
                // A valid box required to span [hi, lo] necessarily contains hi.
                coords.push(if lo > hi { hi } else { lo });
                coords.push(hi);
            }
        }
        bbox_new(self.axes.len(), coords)
    }

    public fn dim_count(&self) -> Int { self.axes.len() }
}

// -----------------------------------------------------------------------------
// Convenience batch builder
// -----------------------------------------------------------------------------

public fn build_query(n_dims: Int, atoms: List<PredicateAtom>) -> BBox {
    let mut b = builder_new(n_dims);
    let mut i: Int = 0;
    while i < atoms.len() {
        b.add(atoms[i]);
        i = i + 1;
    }
    b.build()
}
