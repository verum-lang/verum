// =============================================================================
// fts5/index.vr — multi-segment inverted index
// =============================================================================
// Spec: sqlite-native.md §16.2 — fts5/index.vr
//

// An `Fts5Index` is a stack of segments organised into levels (level-N
// segments are the result of merging level-(N-1) segments). Reads
// scan every segment + union the postings; writes append a fresh
// level-0 segment.
//

// The actual segment-file format is the responsibility of the
// `segment` module; this module is the in-memory orchestration view.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.vtabs.fts5.index;

mount base.{Text, Maybe, Bool};
mount collections.List;
mount core.database.sqlite.native.vtabs.fts5.tokenizer.{Fts5VtabToken};
mount core.database.sqlite.native.vtabs.fts5.segment.{
    Fts5VtabSegment, Fts5SegmentPostingList,
    segment_from_tokens, segment_lookup, segment_merge,
    posting_list_new,
};

// -----------------------------------------------------------------------------
// Fts5VtabSegmentLevel
// -----------------------------------------------------------------------------

public type Fts5VtabSegmentLevel is {
    level: Int,
    segments: List<Fts5VtabSegment>,
};

public fn level_new(n: Int) -> Fts5VtabSegmentLevel { Fts5VtabSegmentLevel { level: n, segments: List.new() } }

// -----------------------------------------------------------------------------
// Fts5Index
// -----------------------------------------------------------------------------

public type Fts5Index is {
    levels: List<Fts5VtabSegmentLevel>,
    /// Level-0 segments above this count trigger a merge.
    merge_threshold: Int,
};

public fn index_new() -> Fts5Index {
    let mut levels: List<Fts5VtabSegmentLevel> = List.new();
    levels.push(level_new(0));
    Fts5Index { levels: levels, merge_threshold: 4 }
}

implement Fts5Index {
    /// Append a new level-0 segment.
    public fn add_segment(&mut self, seg: Fts5VtabSegment) {
        self.ensure_level(0);
        self.levels[0].segments.push(seg);
    }

    /// Build + add a fresh segment from a single document.
    public fn add_document(&mut self, rowid: Int64, column: Int, tokens: List<Fts5VtabToken>) {
        let seg = segment_from_tokens(rowid, column, tokens);
        self.add_segment(seg);
    }

    fn ensure_level(&mut self, level: Int) {
        while self.levels.len() <= level {
            self.levels.push(level_new(self.levels.len()));
        }
    }

    /// Lookup `term` across every segment + union the posting lists.
    public fn lookup(&self, term: &Text) -> Fts5SegmentPostingList {
        let mut union = posting_list_new();
        let mut l: Int = 0;
        while l < self.levels.len() {
            let mut s: Int = 0;
            while s < self.levels[l].segments.len() {
                match segment_lookup(&self.levels[l].segments[s], term) {
                    Maybe.Some(pl) => { union = union.merged(&pl); }
                    Maybe.None => {}
                }
                s = s + 1;
            }
            l = l + 1;
        }
        union
    }

    /// Total segment count across every level.
    public fn segment_count(&self) -> Int {
        let mut sum: Int = 0;
        let mut l: Int = 0;
        while l < self.levels.len() {
            sum = sum + self.levels[l].segments.len();
            l = l + 1;
        }
        sum
    }

    /// Returns true if a level-0 merge is needed.
    public fn needs_merge(&self) -> Bool {
        if self.levels.len() == 0 { return false; }
        self.levels[0].segments.len() >= self.merge_threshold
    }

    public fn level_count(&self) -> Int { self.levels.len() }

    public fn segments_at_level(&self, level: Int) -> Int {
        if level < 0 || level >= self.levels.len() { return 0; }
        self.levels[level].segments.len()
    }

    /// Promote an eligible level and return the number of segments it contained.
    public(in core.database.sqlite.native.vtabs.fts5) fn compact_level(&mut self, level: Int) -> Int {
        let count = self.segments_at_level(level);
        if count < self.merge_threshold { return 0; }
        let mut merged = self.levels[level].segments[0];
        let mut i = 1;
        while i < count {
            merged = segment_merge(&merged, &self.levels[level].segments[i]);
            i = i + 1;
        }
        self.ensure_level(level + 1);
        self.levels[level + 1].segments.push(merged);
        self.levels[level].segments.clear();
        count
    }
}
