// =============================================================================
// hooks_api/engine.vr — install/replace/uninstall hooks
// =============================================================================
// Spec: SQLite C API
//

// Each slot is (kind × Registration). install() swaps the old
// registration out, returning its handle (matches sqlite3_commit_hook
// "returns previous pArg" semantics). clear() installs the empty
// handle and returns the previous.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.hooks_api.engine;

mount base.{Bool, Text};
mount core.database.sqlite.native.hooks_api.registration.{
    HookRegistration, EngineHookKind,
    EhCommit, EhRollback, EhUpdate, EhPreupdate, EhWal, EhAutovacuumPages,
    new_registration, is_installed,
};

public type HooksEngine is {
    commit: HookRegistration,
    rollback: HookRegistration,
    update: HookRegistration,
    preupdate: HookRegistration,
    wal: HookRegistration,
    autovacuum_pages: HookRegistration,
}

public fn new_engine() -> HooksEngine {
    HooksEngine {
        commit:           new_registration(EhCommit,          "".clone(), 0 as Int64),
        rollback:         new_registration(EhRollback,        "".clone(), 0 as Int64),
        update:           new_registration(EhUpdate,          "".clone(), 0 as Int64),
        preupdate:        new_registration(EhPreupdate,       "".clone(), 0 as Int64),
        wal:              new_registration(EhWal,             "".clone(), 0 as Int64),
        autovacuum_pages: new_registration(EhAutovacuumPages, "".clone(), 0 as Int64),
    }
}

implement HooksEngine {
    /// Install `reg` into the slot indicated by its kind. Returns the
    /// previous handle (0 if nothing was installed).
    public fn install(&mut self, reg: HookRegistration) -> Int64 {
        match &reg.kind {
            EhCommit => {
                let prev = self.commit.handle;
                self.commit = reg;
                prev
            }
            EhRollback => {
                let prev = self.rollback.handle;
                self.rollback = reg;
                prev
            }
            EhUpdate => {
                let prev = self.update.handle;
                self.update = reg;
                prev
            }
            EhPreupdate => {
                let prev = self.preupdate.handle;
                self.preupdate = reg;
                prev
            }
            EhWal => {
                let prev = self.wal.handle;
                self.wal = reg;
                prev
            }
            EhAutovacuumPages => {
                let prev = self.autovacuum_pages.handle;
                self.autovacuum_pages = reg;
                prev
            }
        }
    }

    public fn any_installed(&self) -> Bool {
        is_installed(&self.commit)
            || is_installed(&self.rollback)
            || is_installed(&self.update)
            || is_installed(&self.preupdate)
            || is_installed(&self.wal)
            || is_installed(&self.autovacuum_pages)
    }
}
