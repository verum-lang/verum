// =============================================================================
// hooks_api/registration.vr — typed slot descriptors
// =============================================================================
// Spec: SQLite C API
//

// Each installed hook has a symbolic `tag` (diagnostics) and a
// pointer-handle treated as opaque by the catalogue.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.1")
)
module core.database.sqlite.native.hooks_api.registration;

mount base.{Bool, Text};

// Named `EngineHookKind`/`Eh*`, NOT `HookKind`/`Hk*` (T0555 layer 5):
// l7_api.hook_registry owns the user-facing `HookKind` with a DIFFERENT
// variant order — two public enums sharing bare variant spellings made
// the ambient constructor table first-wins to THIS one, so a user's
// `HkUpdate` carried tag 2 and read back as l7's `HkCommit`. One
// spelling, one type ([[vr-enum-tag-wire-byte-drift-class]]: variant
// order IS the wire; renaming beats reordering).
public type EngineHookKind is
      EhCommit
    | EhRollback
    | EhUpdate
    | EhPreupdate
    | EhWal
    | EhAutovacuumPages;

public fn kind_name(k: &EngineHookKind) -> Text {
    match k {
        EhCommit            => "commit".clone(),
        EhRollback          => "rollback".clone(),
        EhUpdate            => "update".clone(),
        EhPreupdate         => "preupdate".clone(),
        EhWal               => "wal".clone(),
        EhAutovacuumPages   => "autovacuum-pages".clone(),
    }
}

public type HookRegistration is {
    kind: EngineHookKind,
    tag: Text,
    /// Opaque `pArg` value; 0 => no hook installed.
    handle: Int64,
}

public fn new_registration(kind: EngineHookKind, tag: Text, handle: Int64) -> HookRegistration {
    HookRegistration { kind: kind, tag: tag, handle: handle }
}

public fn is_installed(r: &HookRegistration) -> Bool {
    r.handle != 0_i64
}
