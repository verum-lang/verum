// =============================================================================
// ext/fn_flags.vr — function-registration flags
// =============================================================================
// Spec: sqlite-native.md §19.1
//

// SQLite registration presets use the same bit values as the encoded function flags.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.ext.fn_flags;

public mount core.database.sqlite.native.result_codes.function.FunctionFlagBits as FnFlags;
mount core.database.sqlite.native.result_codes.function.new_flag_bits;

public fn flags_default() -> FnFlags { new_flag_bits(0) }

public fn flags_pure() -> FnFlags {
    flags_default().with_deterministic().with_innocuous()
}

public fn flags_random() -> FnFlags { flags_default().with_direct_only() }
