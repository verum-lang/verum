// =============================================================================
// core/database/sqlite/native/opcode_catalog/mod.vr
// =============================================================================
// Layer: 4-5 (codegen ↔ interpreter visible)
// Spec: sqlite-native.md §11.2, Appendix C
//

// DESIGN-FORWARD opcode catalogue — NOT the wire-level source of truth.
// `l4_vdbe/opcode.vr` carries the *enum* the interpreter actually
// dispatches on (109 opcodes, measured 2026-07-30); this catalogue
// describes 175 — the 66 extra are planned/spec-side entries the live
// engine does not implement yet. Until a pin test asserts the engine's
// enum is a name+number subset of this catalogue (LOOM wiring umbrella,
// pool T0469), treat the ENGINE enum as authoritative for anything that
// executes, and this module as forward metadata for codegen, EXPLAIN,
// the optimiser, fuzz mutators and debuggers.
//

// Layout:
//

//  * `metadata` — OpcodeKind + name table (~180 codes)
//  * `operand_shape` — operand kinds (jump-target / register / literal)
//  * `effects` — pure / writes-cursor / writes-pager / yields-row
//  * `error_codes` — SQLITE_* code table mapped to OpcodeDbError
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.database.sqlite.native.opcode_catalog;

public module metadata;
public module operand_shape;
public module effects;
public module error_codes;
