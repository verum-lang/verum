// =============================================================================
// core/database/postgres/replication_tracker.vr — LSN tracker + PositionStore
// =============================================================================
// Layer: 3 (Database — postgres adapter)
// Spec: database spec §6.1.7 (replication) + §6.1.8 (async).
// =============================================================================
//
// Tracks received, durable and applied WAL positions for a replication
// connection. The watcher periodically publishes a consistent snapshot.
// Shutdown waits for the watcher, then writes the last status. Clones
// share completion and retries, and the caller retains the connection.
// =============================================================================

@arch_module(
    exposes: [Capability.Read(ResourceTag.Database("*")), Capability.Write(ResourceTag.Database("*"))],
    requires: [Capability.Network(NetProtocol.Tcp, NetDirection.Bidirectional)],
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LCls,
    lifecycle: Lifecycle.Definition
)
module core.database.postgres.replication_tracker;

mount base.{Result, Ok, Err, Text, Maybe, None, Some, Bool};
mount core.database.common.error.DbError;
mount core.database.postgres.replication.Lsn;
mount core.database.postgres.pgoutput.PG_EPOCH_OFFSET_US;
mount core.database.postgres.async_replication.AsyncPgReplicationConnection;
mount core.async.cancellation.{CancellationToken, CancelReason, CancelledFuture, Registration};
mount core.async.select.{Either, select_either};
mount core.async.semaphore.{AsyncSemaphore};
mount core.base.memory.Weak;
mount core.async.timer.{Sleep, sleep_ms};
// Mounted rather than inherited: §4ter — the prelude carries only what
// the LANGUAGE requires, and this is library API.
mount core.sync.{Mutex, AtomicBool, MemoryOrdering};

// =============================================================================
// Tunables
// =============================================================================

/// Default standby-status auto-fire interval. 10 s gives the
/// server visibility into replica progress without saturating the
/// wire. Default `wal_sender_timeout` is 60 s, so 10 s leaves
/// plenty of headroom for transient stalls.
public const DEFAULT_INTERVAL_MS: Int = 10_000;

// =============================================================================
// Public types
// =============================================================================

public type TrackedPosition is {
    /// LSN we've received off the wire — the "I have observed this
    /// position" claim. Always >= flush.
    public write: Lsn,
    /// LSN we've durably persisted in our application's sink. The
    /// server uses this to recycle WAL — anything before this is
    /// safe to drop. Always >= apply.
    public flush: Lsn,
    /// LSN that downstream consumers have actually applied. Some
    /// consumers don't distinguish flush vs apply; default-equal
    /// is fine.
    public apply: Lsn,
};

implement TrackedPosition {
    public fn zero() -> TrackedPosition {
        TrackedPosition {
            write: Lsn.zero(),
            flush: Lsn.zero(),
            apply: Lsn.zero(),
        }
    }

    public fn clone(&self) -> TrackedPosition {
        TrackedPosition {
            write: Lsn.from_int(self.write.raw()),
            flush: Lsn.from_int(self.flush.raw()),
            apply: Lsn.from_int(self.apply.raw()),
        }
    }

    // The sink can apply ahead of durable storage. Retain that observation
    // internally, and advertise only the prefix that is also durable.
    fn reportable(&self) -> TrackedPosition {
        let mut pos = self.clone();
        if pos.flush.follows(&pos.write) { pos.flush = Lsn.from_int(pos.write.raw()); }
        if pos.apply.follows(&pos.flush) { pos.apply = Lsn.from_int(pos.flush.raw()); }
        pos
    }
}

public type StoreOutcome is
      SoStored
    | SoSkipped
    | SoFailed(Text);

/// Pluggable persistence — implement to land checkpoints somewhere
/// surviving process restart. The contract:
///
///   * `save` is called on every flush confirm (when
///     `persist_on_flush` is set) plus on every explicit
///     `checkpoint()` call. The implementer decides whether to
///     debounce / batch.
///   * `load` is called once at startup to recover the last
///     known position. Maybe.None → start fresh from `Lsn.zero()`.
///
/// Implementations MUST be thread-safe — `LsnTracker` clones
/// the `Shared<dyn PositionStore>` across the watcher task and
/// caller threads.
public type PositionStore is protocol {
    fn save(&self, pos: &TrackedPosition) -> StoreOutcome;
    fn load(&self) -> Maybe<TrackedPosition>;
};

/// In-process default — keeps the last-saved tuple in a
/// `Shared<Mutex<...>>`. Use for tests + ephemeral consumers
/// that don't need restart safety.
public type MemoryPositionStore is {
    last: Shared<Mutex<Maybe<TrackedPosition>>>,
};

implement MemoryPositionStore {
    public fn new() -> MemoryPositionStore {
        let empty: Maybe<TrackedPosition> = Maybe.None;
        let last: Mutex<Maybe<TrackedPosition>> = Mutex.new(empty);
        MemoryPositionStore { last: Shared.new(last) }
    }

    public fn clone(&self) -> MemoryPositionStore {
        MemoryPositionStore { last: self.last.clone() }
    }
}

implement PositionStore for MemoryPositionStore {
    fn save(&self, pos: &TrackedPosition) -> StoreOutcome {
        let mut g = self.last.lock().unwrap_or_else(|p| p.into_inner());
        *g = Maybe.Some(pos.clone());
        SoStored
    }

    fn load(&self) -> Maybe<TrackedPosition> {
        let g = self.last.lock().unwrap_or_else(|p| p.into_inner());
        match &*g {
            Maybe.Some(p) => Maybe.Some(p.clone()),
            Maybe.None    => Maybe.None,
        }
    }
}

public type LsnTrackerConfig is {
    public interval_ms: Int,
    /// `true` (default) — `confirm_flush` auto-saves to the store.
    /// `false` — store is only touched on explicit `checkpoint()`.
    public persist_on_flush: Bool,
};

/// Per-tracker counters surfaced via `LsnTracker.metrics()`.
/// All counters are monotonic — useful for diff-over-window
/// monitoring (e.g. status_writes per second).
public type LsnTrackerMetrics is {
    /// Standby-status update messages successfully written by
    /// the actor's `send_standby_status`. Each watcher tick + every
    /// shutdown contributes one.
    public status_writes: Int,
    /// Successful `PositionStore.save` calls (SoStored outcome).
    /// `confirm_flush` with `persist_on_flush=true` and
    /// every `checkpoint()` contribute.
    public flushes_persisted: Int,
    /// `PositionStore.save` calls that returned `SoFailed`. Diff
    /// from `flushes_persisted` plus `flushes_skipped` gives
    /// total save attempts.
    public save_failures: Int,
    /// `confirm_flush` calls that hit the `persist_on_flush=false`
    /// path (`SoSkipped`).
    public flushes_skipped: Int,
    /// Wall-clock micros at last status write. Lets observability
    /// detect a wedged watcher (no tick in N intervals).
    public last_status_us: Int,
};

implement LsnTrackerMetrics {
    public fn zero() -> LsnTrackerMetrics {
        LsnTrackerMetrics {
            status_writes: 0,
            flushes_persisted: 0,
            save_failures: 0,
            flushes_skipped: 0,
            last_status_us: 0,
        }
    }

    public fn clone(&self) -> LsnTrackerMetrics {
        LsnTrackerMetrics {
            status_writes: self.status_writes,
            flushes_persisted: self.flushes_persisted,
            save_failures: self.save_failures,
            flushes_skipped: self.flushes_skipped,
            last_status_us: self.last_status_us,
        }
    }
}

implement LsnTrackerConfig {
    public fn default() -> LsnTrackerConfig {
        LsnTrackerConfig {
            interval_ms: DEFAULT_INTERVAL_MS,
            persist_on_flush: true,
        }
    }
}

type TrackerShutdown is {
    stop: CancellationToken,
    watcher_done: CancellationToken,
    flush_permit: AsyncSemaphore,
    flushed: AtomicBool,
    registrations: Mutex<List<Registration>>,
};

public type LsnTracker is {
    state: Shared<Mutex<TrackedPosition>>,
    store: Shared<dyn PositionStore>,
    repl: AsyncPgReplicationConnection,
    config: LsnTrackerConfig,
    finish: Shared<TrackerShutdown>,
    /// Counter state — separate mutex from `state` so a metrics
    /// snapshot doesn't contend with the LSN tuple under load.
    metrics: Shared<Mutex<LsnTrackerMetrics>>,
};

implement LsnTracker {
    public fn clone(&self) -> LsnTracker {
        LsnTracker {
            state: self.state.clone(),
            store: self.store.clone(),
            repl: self.repl.clone(),
            config: LsnTrackerConfig {
                interval_ms: self.config.interval_ms,
                persist_on_flush: self.config.persist_on_flush,
            },
            finish: self.finish.clone(),
            metrics: self.metrics.clone(),
        }
    }

    /// Snapshot of monotonic counters. Cheap (clones a 5-int
    /// struct under the metrics mutex). Safe to call from
    /// observability code on a separate task — never blocks
    /// the LSN tuple write path.
    public fn metrics(&self) -> LsnTrackerMetrics {
        let guard = self.metrics.lock().unwrap_or_else(|p| p.into_inner());
        let counts: &LsnTrackerMetrics = &*guard;
        counts.clone()
    }

    /// Read the current LSN tuple. Cheap — clones a 24-byte
    /// struct under the state lock.
    public fn snapshot(&self) -> TrackedPosition {
        let guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
        let position: &TrackedPosition = &*guard;
        position.reportable()
    }

    /// Bump `write` to `lsn` if `lsn > write`. Other components
    /// stay put. Used by the consumer loop on every received
    /// XLogData to keep the server informed of wire progress.
    public fn update_received(&self, lsn: Lsn) {
        let mut guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
        let position: &mut TrackedPosition = &mut *guard;
        if lsn.follows(&position.write) {
            position.write = lsn;
        }
    }

    /// Mark `lsn` as durably persisted in the consumer's sink.
    /// Advances the durable position independently of application, and persists
    /// via PositionStore when `persist_on_flush`. Returns the
    /// store outcome — `SoSkipped` if persist_on_flush is false.
    public async fn confirm_flush(&self, lsn: Lsn) -> StoreOutcome {
        let snap_for_save = {
            let mut guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
            let position: &mut TrackedPosition = &mut *guard;
            if lsn.follows(&position.flush) {
                position.flush = Lsn.from_int(lsn.raw());
                if position.flush.follows(&position.write) {
                    position.write = Lsn.from_int(position.flush.raw());
                }
            }
            position.reportable()
        };
        let outcome = if self.config.persist_on_flush {
            self.store.save(&snap_for_save)
        } else {
            SoSkipped
        };
        record_flush_outcome(&self.metrics, &outcome);
        outcome
    }

    /// Mark `lsn` as fully applied downstream. Pure tuple
    /// advance — no persistence; the next periodic standby-status
    /// will surface it to the server.
    public fn confirm_apply(&self, lsn: Lsn) {
        let mut guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
        let position: &mut TrackedPosition = &mut *guard;
        if lsn.follows(&position.apply) {
            position.apply = Lsn.from_int(lsn.raw());
        }
    }

    /// Force a checkpoint — saves the current tuple to the
    /// PositionStore regardless of `persist_on_flush`. Useful
    /// before a clean shutdown or on a manual sync trigger.
    public fn checkpoint(&self) -> StoreOutcome {
        let snap = self.snapshot();
        let outcome = self.store.save(&snap);
        record_flush_outcome(&self.metrics, &outcome);
        outcome
    }

    /// Request the same final feedback when the token fires. Registering an
    /// already-cancelled token also stops the watcher.
    public fn attach_cancellation_token(&self, token: CancellationToken) {
        let stop: CancellationToken = self.finish.get().stop.clone();
        let registration = token.register(move || { stop.cancel(); });
        let mut guard = self.finish.get().registrations.lock().unwrap_or_else(|p| p.into_inner());
        if !self.finish.get().stop.is_cancelled() {
            let registrations: &mut List<Registration> = &mut *guard;
            registrations.push(registration);
        }
    }

    /// Stop the watcher task, send a final standby-status with
    /// the latest tuple, and wait for the wire write. Idempotent — second
    /// successful call skips the final write. A failed write can be retried.
    public async fn shutdown(&self) -> Result<(), DbError> {
        self.finish.stop.cancel();
        self.finish.watcher_done.cancelled().await;
        write_final(self.finish.get(), &self.repl, &self.state, &self.metrics).await
    }
}

// =============================================================================
// Constructor
// =============================================================================

/// Wire a tracker around an open `AsyncPgReplicationConnection`.
/// If `store.load()` returns `Maybe.Some(pos)`, the tracker resumes
/// from that tuple; otherwise it starts at `Lsn.zero()`.
///
/// Spawns one watcher task that ticks every `config.interval_ms`
/// and pumps the latest tuple through `repl.send_standby_status`.
public fn attach_tracker(
    repl: AsyncPgReplicationConnection,
    store: Shared<dyn PositionStore>,
    config: LsnTrackerConfig,
) -> LsnTracker {
    let initial = match store.load() {
        Maybe.Some(p) => p,
        Maybe.None    => TrackedPosition.zero(),
    };
    let positions: Mutex<TrackedPosition> = Mutex.new(initial);
    let state: Shared<Mutex<TrackedPosition>> = Shared.new(positions);
    let counters: Mutex<LsnTrackerMetrics> = Mutex.new(LsnTrackerMetrics.zero());
    let metrics: Shared<Mutex<LsnTrackerMetrics>> = Shared.new(counters);
    let registrations: List<Registration> = List.new();
    let finish: TrackerShutdown = TrackerShutdown {
        stop: CancellationToken.new(),
        watcher_done: CancellationToken.new(),
        flush_permit: AsyncSemaphore.new(1),
        flushed: AtomicBool.new(false),
        registrations: Mutex.new(registrations),
    };
    let finish_handle: Shared<TrackerShutdown> = Shared.new(finish);
    let watcher: StatusWatcher = StatusWatcher {
        owner: finish_handle.downgrade(),
        repl: repl.clone(),
        state: state.clone(),
        metrics: metrics.clone(),
        interval_ms: if config.interval_ms < 1 { 1 } else { config.interval_ms },
    };
    schedule_tick(Shared.new(watcher));
    LsnTracker {
        state: state,
        store: store,
        repl: repl,
        config: config,
        finish: finish_handle,
        metrics: metrics,
    }
}

/// Restart helper — convenience over `store.load()`. Returns the
/// `flush` LSN (resume-after-flush) when present, `Lsn.zero()`
/// otherwise. Pass directly to `start_logical(opts, start_lsn)`.
public fn load_start_lsn(store: &Shared<dyn PositionStore>) -> Lsn {
    match store.load() {
        Maybe.Some(p) => p.reportable().flush,
        Maybe.None    => Lsn.zero(),
    }
}

// =============================================================================
// Watcher actor
// =============================================================================

type StatusWatcher is {
    owner: Weak<TrackerShutdown>,
    repl: AsyncPgReplicationConnection,
    state: Shared<Mutex<TrackedPosition>>,
    metrics: Shared<Mutex<LsnTrackerMetrics>>,
    interval_ms: Int,
};

// Arm the successor only after this write completes. At most one timer or
// periodic write is outstanding, even when the socket is slow.
fn schedule_tick(watcher: Shared<StatusWatcher>) {
    let _ = spawn {
        if watcher.get().tick().await { schedule_tick(watcher); }
    };
}

implement StatusWatcher {
    async fn tick(&self) -> Bool {
        let finish = match self.owner.upgrade() {
            Maybe.Some(owner) => owner,
            Maybe.None => { return false; }
        };
        match select_either<CancelReason, (), CancelledFuture, Sleep>(
            finish.get().stop.cancelled(), sleep_ms(self.interval_ms),
        ).await {
            Either.Left(_) => {
                {
                    let mut guard = finish.get().registrations.lock().unwrap_or_else(|p| p.into_inner());
                    let registrations: &mut List<Registration> = &mut *guard;
                    registrations.clear();
                }
                let _ = write_final(finish.get(), &self.repl, &self.state, &self.metrics).await;
                finish.get().watcher_done.cancel();
                false
            }
            Either.Right(_) => {
                let snap = {
                    let guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
                    let position: &TrackedPosition = &*guard;
                    position.reportable()
                };
                if write_position(&self.repl, snap).await.is_ok() {
                    bump_status_write(&self.metrics);
                }
                true
            }
        }
    }
}

// =============================================================================
// Metrics helpers
// =============================================================================

async fn write_final(
    finish: &TrackerShutdown, repl: &AsyncPgReplicationConnection,
    state: &Shared<Mutex<TrackedPosition>>, metrics: &Shared<Mutex<LsnTrackerMetrics>>,
) -> Result<(), DbError> {
    let permit = finish.flush_permit.acquire().await.map_err(|_| DbError.Cancelled)?;
    let result = if finish.flushed.load(MemoryOrdering.Acquire) {
        Result.Ok(())
    } else {
        let snap = {
            let guard = state.lock().unwrap_or_else(|p| p.into_inner());
            let position: &TrackedPosition = &*guard;
            position.reportable()
        };
        let written = write_position(repl, snap).await;
        if written.is_ok() {
            bump_status_write(metrics);
            finish.flushed.store(true, MemoryOrdering.Release);
        }
        written
    };
    permit.release();
    result
}

async fn write_position(repl: &AsyncPgReplicationConnection, pos: TrackedPosition) -> Result<(), DbError> {
    repl.send_standby_status(
        pos.write, pos.flush, pos.apply, wall_clock_us() - PG_EPOCH_OFFSET_US, false,
    ).await
}

fn bump_status_write(metrics: &Shared<Mutex<LsnTrackerMetrics>>) {
    let mut guard = metrics.lock().unwrap_or_else(|p| p.into_inner());
    let counts: &mut LsnTrackerMetrics = &mut *guard;
    counts.status_writes = counts.status_writes + 1;
    counts.last_status_us = wall_clock_us();
}

fn record_flush_outcome(
    metrics: &Shared<Mutex<LsnTrackerMetrics>>,
    outcome: &StoreOutcome,
) {
    let mut guard = metrics.lock().unwrap_or_else(|p| p.into_inner());
    let counts: &mut LsnTrackerMetrics = &mut *guard;
    match outcome {
        SoStored      => { counts.flushes_persisted = counts.flushes_persisted + 1; }
        SoSkipped     => { counts.flushes_skipped   = counts.flushes_skipped + 1; }
        SoFailed(_)   => { counts.save_failures     = counts.save_failures + 1; }
    }
}

fn wall_clock_us() -> Int {
    core.time.system_time.SystemTime.now().duration_since_epoch().as_micros()
}
