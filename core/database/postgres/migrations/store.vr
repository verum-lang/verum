// =============================================================================
// database/postgres/migrations/store.vr — PostgresMigrationStore
// =============================================================================
// Layer: 2 (Database — Postgres adapter)
// Dependencies: core, base, common/migrations/{store, journal, migration},
//               postgres/{connection, transaction}
// =============================================================================
//
// Postgres-specific implementation of `MigrationStore`. Adds three
// Postgres-native concerns on top of the universal protocol:
//
//   1. **Advisory locks.** `pg_advisory_lock(<key>)` acquires a
//      session-level lock; `pg_advisory_unlock(<key>)` releases. The
//      key is FNV-1a of the tracking-table name so concurrent cogs
//      with different table names don't contend. This guarantees that
//      multiple Postgres clients running migrations against the same
//      database serialise — preventing duplicate-apply, lost-update,
//      and partial-DDL hazards.
//
//   2. **Transactional DDL.** Postgres allows DDL inside transactions
//      (unlike MySQL); `MigrationStoreConfig.transactional = true`
//      wraps every step in a transaction so the row-update in
//      `__verum_migrations` and the actual DDL commit atomically.
//
//   3. **JSONB-friendly column types.** The tracking table uses
//      Postgres-canonical types: `BIGINT` for version + checksum,
//      `TEXT` for name + status + error, `TIMESTAMPTZ` for
//      `applied_at`. These are emitted by `init()`'s SQL.
//
// **Categorical position.** This is the Postgres-side image of the
// Postgres-flavoured adjunction described in `common/migrations/store.vr`:
// `init` is the unit; `release_lock` after `execute` is the counit;
// the universal `MigrationRunner` factors uniquely through `init |>
// acquire_lock |> load_journal |> ... |> release_lock`.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Postgres-specific MigrationStore — advisory locks + transactional DDL",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.postgres.migrations.store;

mount base.{Text, Bool, Maybe, Some, None, Result, Ok, Err};
mount collections.List;
mount core.database.common.error.{DbError, AdapterSpecific, AdPostgres};
mount core.database.common.migrations.store.{
    MigrationStore, MigrationStoreConfig, advisory_lock_key_for, combine_migration_errors,
};
mount core.database.common.migrations.migration.{
    MigrationStatus, MsPending, MsApplied, MsRolledBack, MsFailed,
};
mount core.database.common.migrations.journal.{
    MigrationJournal, JournalEntry, journal_from_entries, journal_new,
};
mount core.database.postgres.connection.{PgConnection, PgTypedQueryResult};
mount core.database.postgres.transaction.{PgTransaction, begin_tx_read_only, commit_tx, rollback_tx};
mount core.database.postgres.wire.backend.TxIdle;
mount core.database.postgres.wire.typed.TypedValue;
mount core.database.postgres.migrations.journal_codec.{decode_entry, quote_tracking_table};

// =============================================================================
// PostgresMigrationStore
// =============================================================================

public type PostgresMigrationStore is {
    conn: PgConnection,
    config: MigrationStoreConfig,
    /// FNV-1a of `config.table_name` — the advisory-lock key.
    lock_key: Int64,
    /// Whether `acquire_lock` has been called and not yet released.
    /// Used by `release_lock` to be idempotent.
    lock_held: Bool,
};

public fn store_new(conn: PgConnection, config: MigrationStoreConfig) -> PostgresMigrationStore {
    let key = advisory_lock_key_for(&config.table_name);
    PostgresMigrationStore {
        conn: conn,
        config: config,
        lock_key: key,
        lock_held: false,
    }
}

fn state_error(message: &Text) -> DbError {
    DbError.Adapter(AdapterSpecific.new(AdPostgres, "migration_session_invalid", message.clone(), false))
}

fn require_idle(conn: &PgConnection) -> Result<(), DbError> {
    if conn.tx_status() is TxIdle { Result.Ok(()) }
    else { Result.Err(state_error(&"migration store requires an idle transaction")) }
}

/// Attempt to close every prepared statement after execution, retaining both
/// failures if execution and cleanup fail. A failed transport may prevent close.
fn query_typed(conn: &mut PgConnection, sql: &Text, params: &List<Maybe<TypedValue>>)
    -> Result<PgTypedQueryResult, DbError>
{
    let statement = conn.prepare(sql)?;
    let result = conn.execute_prepared_typed(&statement, params);
    let cleanup = conn.close_prepared(&statement);
    match (result, cleanup) {
        (Result.Ok(value), Result.Ok(_)) => Result.Ok(value),
        (Result.Err(error), Result.Ok(_)) => Result.Err(error),
        (Result.Ok(_), Result.Err(error)) => Result.Err(error),
        (Result.Err(error), Result.Err(cleanup)) =>
            Result.Err(combine_migration_errors(AdPostgres, error, &"close prepared statement", cleanup)),
    }
}

fn quoted_table(conn: &mut PgConnection, name: &Text) -> Result<Text, DbError> {
    let params: List<Maybe<TypedValue>> = [];
    let result = query_typed(conn, &"SELECT pg_catalog.current_setting('max_identifier_length')::bigint", &params)?;
    if result.rows.len() != 1 || result.rows[0].len() != 1 {
        return Result.Err(state_error(&"invalid PostgreSQL identifier limit response"));
    }
    match result.rows[0][0] {
        TypedValue.TvInt8(limit) => quote_tracking_table(name, limit),
        _ => Result.Err(state_error(&"identifier limit is not BIGINT")),
    }
}

/// Return the fully qualified name and OID, including for an unqualified alias.
/// A missing table is a valid first dry run; a different kind of object is not.
fn lookup_table(conn: &mut PgConnection, table: &Text) -> Result<Maybe<(Text, Int)>, DbError> {
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvText(table.clone()))];
    let sql = "SELECT pg_catalog.quote_ident(n.nspname)||'.'||pg_catalog.quote_ident(c.relname),c.oid::bigint,c.relkind IN ('r','p') FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE c.oid=pg_catalog.to_regclass($1::text)";
    let result = query_typed(conn, &sql, &params)?;
    if result.rows.len() == 0 { return Result.Ok(Maybe.None); }
    if result.rows.len() != 1 || result.rows[0].len() != 3 {
        return Result.Err(state_error(&"invalid tracking table identity response"));
    }
    match (&result.rows[0][0], &result.rows[0][1], &result.rows[0][2]) {
        (TypedValue.TvText(name), TypedValue.TvInt8(oid), TypedValue.TvBool(true)) =>
            Result.Ok(Maybe.Some((name.clone(), *oid))),
        _ => Result.Err(state_error(&"tracking relation is not a table")),
    }
}

/// Hold a relation lock until commit, including while waiting for concurrent
/// DDL. Check the acquired lock as well as the current name: a schema rename
/// can redirect a qualified name without acquiring locks on its tables.
fn lock_table(conn: &mut PgConnection, table: &Text, expected: Int, mode: &Text) -> Result<(), DbError> {
    conn.execute(&f"LOCK TABLE ONLY {table} IN {mode} MODE")?;
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvText(table.clone())), Maybe.Some(TypedValue.TvInt8(expected))];
    let held = "SELECT EXISTS (SELECT FROM pg_catalog.pg_locks WHERE pid=pg_catalog.pg_backend_pid() AND locktype='relation' AND granted AND relation=pg_catalog.to_regclass($1::text) AND relation::bigint=$2::bigint)";
    let result = query_typed(conn, &held, &params)?;
    if result.rows.len() == 1 && result.rows[0].len() == 1 && result.rows[0][0] is TypedValue.TvBool(true) {
        return Result.Ok(());
    }
    Result.Err(state_error(&"tracking table was replaced; reinitialize the store"))
}

fn rollback_if_active(conn: &mut PgConnection, error: DbError) -> DbError {
    if conn.tx_status() is TxIdle { return error; }
    match conn.execute(&"ROLLBACK") {
        Result.Ok(_) => error,
        Result.Err(cleanup) => combine_migration_errors(AdPostgres, error, &"rollback migration", cleanup),
    }
}

fn finish_transaction<T>(conn: &mut PgConnection, tx: PgTransaction, operation: Result<T, DbError>)
    -> Result<T, DbError>
{
    match operation {
        Result.Ok(value) => match commit_tx(conn, tx) {
            Result.Ok(_) => Result.Ok(value),
            Result.Err(error) => Result.Err(rollback_if_active(conn, error)),
        },
        Result.Err(error) => match rollback_tx(conn, tx) {
            Result.Ok(_) => Result.Err(error),
            Result.Err(cleanup) => Result.Err(combine_migration_errors(AdPostgres, error, &"rollback migration", cleanup)),
        },
    }
}

fn read_locked(conn: &mut PgConnection, table: &Text, expected: Int) -> Result<MigrationJournal, DbError> {
    lock_table(conn, table, expected, &"ACCESS SHARE")?;
    // The outer join supplies the source relation's identity even for an empty
    // journal. The presence flag distinguishes that row from malformed data.
    let sql = f"SELECT j.version,j.name,j.status,j.applied_at,j.error,j.checksum,j.tableoid IS NOT NULL,(SELECT t.typrelid::bigint FROM pg_catalog.pg_type t WHERE t.oid=pg_catalog.pg_typeof(j.*)::oid) FROM (VALUES (1)) AS seed(x) LEFT JOIN {table} AS j ON true ORDER BY j.version";
    let params: List<Maybe<TypedValue>> = [];
    let result = query_typed(conn, &sql, &params)?;
    let mut entries: List<JournalEntry> = List.with_capacity(result.rows.len());
    let mut previous: Maybe<Int> = Maybe.None;
    if result.rows.len() == 0 { return Result.Err(state_error(&"missing journal identity response")); }
    for mut row in result.rows.into_iter() {
        match row.pop() {
            Maybe.Some(TypedValue.TvInt8(oid)) if oid == expected => {},
            _ => return Result.Err(state_error(&"journal read reached a replacement table")),
        }
        match row.pop() {
            Maybe.Some(TypedValue.TvBool(false)) => continue,
            Maybe.Some(TypedValue.TvBool(true)) => {},
            _ => return Result.Err(state_error(&"invalid journal presence response")),
        }
        let entry = decode_entry(&row)?;
        if let Maybe.Some(version) = previous {
            if entry.version <= version { return Result.Err(state_error(&"duplicate or unordered journal versions")); }
        }
        previous = Maybe.Some(entry.version);
        entries.push(entry);
    }
    Result.Ok(journal_from_entries(entries))
}

fn read_relation(conn: &mut PgConnection, table: &Text, oid: Int) -> Result<MigrationJournal, DbError> {
    let tx = begin_tx_read_only(conn)?;
    let result = read_locked(conn, table, oid);
    finish_transaction(conn, tx, result)
}

fn read_current_journal(conn: &mut PgConnection, configured: &Text) -> Result<MigrationJournal, DbError> {
    let name = quoted_table(conn, configured)?;
    let (table, oid) = match lookup_table(conn, &name)? {
        Maybe.Some(resolved) => resolved,
        Maybe.None => return Result.Ok(journal_new()),
    };
    read_relation(conn, &table, oid)
}

implement MigrationStore for PostgresMigrationStore {
    fn dialect(&self) -> Text { "postgres".to_text() }

    fn config(&self) -> &MigrationStoreConfig { &self.config }

    async fn init(&mut self) -> Result<(), DbError> {
        // Postgres-canonical types. CREATE TABLE IF NOT EXISTS is
        // idempotent on Postgres ≥ 9.1 (which is the minimum we support).
        let table = &self.config.table_name;
        let sql = f"CREATE TABLE IF NOT EXISTS {table} (\n                version    BIGINT PRIMARY KEY,\n                name       TEXT NOT NULL,\n                status     TEXT NOT NULL,\n                applied_at BIGINT,\n                error      TEXT,\n                checksum   BIGINT NOT NULL\n            )";
        execute_raw(&mut self.conn, &sql).await
    }

    async fn load_journal(&mut self) -> Result<MigrationJournal, DbError> {
        require_idle(&self.conn)?;
        read_current_journal(&mut self.conn, &self.config.table_name)
    }

    async fn upsert_entry(&mut self, entry: &JournalEntry) -> Result<(), DbError> {
        let (status_str, applied_at_opt, error_opt) = render_status(&entry.status);
        let table = &self.config.table_name;
        let version = entry.version;
        let name_lit = sql_text_literal(&entry.name);
        let status_lit = sql_text_literal(&status_str);
        let applied_lit = match applied_at_opt { Maybe.Some(t) => f"{t}", Maybe.None => "NULL".to_text() };
        let error_lit = match &error_opt { Maybe.Some(e) => sql_text_literal(e), Maybe.None => "NULL".to_text() };
        let checksum = entry.checksum;
        let sql = f"INSERT INTO {table} (version, name, status, applied_at, error, checksum)\n               VALUES ({version}, {name_lit}, {status_lit}, {applied_lit}, {error_lit}, {checksum})\n               ON CONFLICT (version) DO UPDATE SET\n                   name = EXCLUDED.name,\n                   status = EXCLUDED.status,\n                   applied_at = EXCLUDED.applied_at,\n                   error = EXCLUDED.error,\n                   checksum = EXCLUDED.checksum";
        execute_raw(&mut self.conn, &sql).await
    }

    async fn acquire_lock(&mut self) -> Result<(), DbError> {
        if self.lock_held { return Result.Ok(()); }
        let sql = f"SELECT pg_advisory_lock({self.lock_key})";
        execute_raw(&mut self.conn, &sql).await?;
        self.lock_held = true;
        Result.Ok(())
    }

    async fn release_lock(&mut self) -> Result<(), DbError> {
        if !self.lock_held { return Result.Ok(()); }
        let sql = f"SELECT pg_advisory_unlock({self.lock_key})";
        execute_raw(&mut self.conn, &sql).await?;
        self.lock_held = false;
        Result.Ok(())
    }

    async fn execute_sql(&mut self, sql: &Text) -> Result<(), DbError> {
        if self.config.transactional {
            // Wrap in BEGIN ... COMMIT.
            let tx = self.conn.begin().await?;
            let exec_res = execute_in_tx(&tx, sql).await;
            match exec_res {
                Result.Ok(_)  => tx.commit().await,
                Result.Err(e) => {
                    let _ = tx.rollback().await;
                    Result.Err(e)
                }
            }
        } else {
            execute_raw(&mut self.conn, sql).await
        }
    }

    async fn drop_tracking_table(&mut self) -> Result<(), DbError> {
        let sql = f"DROP TABLE IF EXISTS {self.config.table_name}";
        execute_raw(&mut self.conn, &sql).await
    }
}

// =============================================================================
// Helpers
// =============================================================================

/// Render a `MigrationStatus` as `(status_text, applied_at?, error?)`.
fn render_status(s: &MigrationStatus) -> (Text, Maybe<Int64>, Maybe<Text>) {
    match s {
        MsPending          => ("pending".to_text(),      Maybe.None,    Maybe.None),
        MsApplied(t)       => ("applied".to_text(),      Maybe.Some(*t), Maybe.None),
        MsRolledBack(t)    => ("rolled_back".to_text(),  Maybe.Some(*t), Maybe.None),
        MsFailed(e)        => ("failed".to_text(),       Maybe.None,    Maybe.Some(e.clone())),
    }
}

/// SQL string literal — escape single quotes by doubling.
fn sql_text_literal(t: &Text) -> Text {
    let bs = t.as_bytes();
    let mut out = Text.new();
    out.push_byte(0x27_u8);  // '
    let mut i: Int = 0;
    while i < bs.len() {
        let b = bs[i];
        if b == 0x27_u8 {
            out.push_byte(0x27_u8); out.push_byte(0x27_u8);
        } else {
            out.push_byte(b);
        }
        i = i + 1;
    }
    out.push_byte(0x27_u8);
    out
}

// Connection helpers — these route through the canonical pg connection
// API. Because `MigrationStore.execute_sql` operates at the textual-SQL
// level (not the typed `sql#"..."` meta-fn level), we use the raw
// statement-execution path that postgres/connection.vr exposes for
// dynamic SQL.
async fn execute_raw(conn: &mut PgConnection, sql: &Text) -> Result<(), DbError> {
    conn.execute_simple(sql).await.map(|_| ())
}

async fn execute_in_tx(tx: &mut PgTransaction, sql: &Text) -> Result<(), DbError> {
    tx.execute_simple(sql).await.map(|_| ())
}

