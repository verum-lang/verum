// PostgreSQL migration storage: session ownership, typed journals and atomic steps.
@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Postgres-specific MigrationStore — advisory locks + transactional DDL",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.postgres.migrations.store;

mount core.base.maybe.Maybe;
mount core.base.result.Result;
mount core.text.text.Text;
mount core.collections.list.List;
mount core.database.common.error.{DbError, AdapterId, AdapterSpecific, AdPostgres};
mount core.database.common.migrations.store.{MigrationStore, MigrationStoreConfig, combine_migration_errors};
mount core.database.common.migrations.journal.{MigrationJournal, JournalEntry, journal_from_entries, journal_new};
mount core.database.postgres.connection.{PgConnection, PgTypedQueryResult};
mount core.database.postgres.transaction.{PgTransaction, begin_tx, begin_tx_read_only, commit_tx, rollback_tx};
mount core.database.postgres.wire.backend.{TxIdle, TxInTransaction};
mount core.database.postgres.wire.typed.TypedValue;
mount core.database.postgres.migrations.journal_codec.{decode_entry, entry_parameters, quote_tracking_table, transactional_sql};

/// Owns one session: advisory locks and each migration transaction stay on it.
public type PostgresMigrationStore is {
    private conn: PgConnection,
    private config: MigrationStoreConfig,
    private table: Maybe<(Text, Int)>,
    // Release uses the key actually acquired even after the relation was replaced.
    private held_lock: Maybe<Int>,
};

public fn store_new(conn: PgConnection, config: MigrationStoreConfig) -> PostgresMigrationStore {
    PostgresMigrationStore { conn: conn, config: config, table: Maybe.None, held_lock: Maybe.None }
}

fn state_error(message: &Text) -> DbError {
    DbError.Adapter(AdapterSpecific.new(AdPostgres, "migration_session_invalid", message.clone(), false))
}

fn require_idle(conn: &PgConnection) -> Result<(), DbError> {
    if conn.tx_status() is TxIdle { Result.Ok(()) }
    else { Result.Err(state_error(&"migration store requires an idle transaction")) }
}

/// Attempt to close every prepared statement after execution, retaining both
/// failures if execution and cleanup fail. A failed transport may prevent close.
fn query_typed(conn: &mut PgConnection, sql: &Text, params: &List<Maybe<TypedValue>>)
    -> Result<PgTypedQueryResult, DbError>
{
    let statement = conn.prepare(sql)?;
    let result = conn.execute_prepared_typed(&statement, params);
    let cleanup = conn.close_prepared(&statement);
    match (result, cleanup) {
        (Result.Ok(value), Result.Ok(_)) => Result.Ok(value),
        (Result.Err(error), Result.Ok(_)) => Result.Err(error),
        (Result.Ok(_), Result.Err(error)) => Result.Err(error),
        (Result.Err(error), Result.Err(cleanup)) =>
            Result.Err(combine_migration_errors(AdPostgres, error, &"close prepared statement", cleanup)),
    }
}

fn quoted_table(conn: &mut PgConnection, name: &Text) -> Result<Text, DbError> {
    let params: List<Maybe<TypedValue>> = [];
    let result = query_typed(conn, &"SELECT pg_catalog.current_setting('max_identifier_length')::bigint", &params)?;
    if result.rows.len() != 1 || result.rows[0].len() != 1 {
        return Result.Err(state_error(&"invalid PostgreSQL identifier limit response"));
    }
    match result.rows[0][0] {
        TypedValue.TvInt8(limit) => quote_tracking_table(name, limit),
        _ => Result.Err(state_error(&"identifier limit is not BIGINT")),
    }
}

/// Return the fully qualified name and OID, including for an unqualified alias.
/// A missing table is a valid first dry run; a different kind of object is not.
fn lookup_table(conn: &mut PgConnection, table: &Text) -> Result<Maybe<(Text, Int)>, DbError> {
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvText(table.clone()))];
    let sql = "SELECT pg_catalog.quote_ident(n.nspname)||'.'||pg_catalog.quote_ident(c.relname),c.oid::bigint,c.relkind IN ('r','p') FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE c.oid=pg_catalog.to_regclass($1::text)";
    let result = query_typed(conn, &sql, &params)?;
    if result.rows.len() == 0 { return Result.Ok(Maybe.None); }
    if result.rows.len() != 1 || result.rows[0].len() != 3 {
        return Result.Err(state_error(&"invalid tracking table identity response"));
    }
    match (&result.rows[0][0], &result.rows[0][1], &result.rows[0][2]) {
        (TypedValue.TvText(name), TypedValue.TvInt8(oid), TypedValue.TvBool(true)) =>
            Result.Ok(Maybe.Some((name.clone(), *oid))),
        _ => Result.Err(state_error(&"tracking relation is not a table")),
    }
}

fn require_table_identity(conn: &mut PgConnection, table: &Text, expected: Int) -> Result<(), DbError> {
    match lookup_table(conn, table)? {
        Maybe.Some((_, oid)) if oid == expected => Result.Ok(()),
        _ => Result.Err(state_error(&"tracking table was replaced; reinitialize the store")),
    }
}

/// Hold a relation lock until commit, including while waiting for concurrent
/// DDL. Check the acquired lock as well as the current name: a schema rename
/// can redirect a qualified name without acquiring locks on its tables.
fn lock_table(conn: &mut PgConnection, table: &Text, expected: Int, mode: &Text) -> Result<(), DbError> {
    conn.execute(&f"LOCK TABLE ONLY {table} IN {mode} MODE")?;
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvText(table.clone())), Maybe.Some(TypedValue.TvInt8(expected))];
    let held = "SELECT EXISTS (SELECT FROM pg_catalog.pg_locks WHERE pid=pg_catalog.pg_backend_pid() AND locktype='relation' AND granted AND relation=pg_catalog.to_regclass($1::text) AND relation::bigint=$2::bigint)";
    let result = query_typed(conn, &held, &params)?;
    if result.rows.len() == 1 && result.rows[0].len() == 1 && result.rows[0][0] is TypedValue.TvBool(true) {
        return Result.Ok(());
    }
    Result.Err(state_error(&"tracking table was replaced; reinitialize the store"))
}

fn rollback_if_active(conn: &mut PgConnection, error: DbError) -> DbError {
    if conn.tx_status() is TxIdle { return error; }
    match conn.execute(&"ROLLBACK") {
        Result.Ok(_) => error,
        Result.Err(cleanup) => combine_migration_errors(AdPostgres, error, &"rollback migration", cleanup),
    }
}

fn finish_transaction<T>(conn: &mut PgConnection, tx: PgTransaction, operation: Result<T, DbError>)
    -> Result<T, DbError>
{
    match operation {
        Result.Ok(value) => match commit_tx(conn, tx) {
            Result.Ok(_) => Result.Ok(value),
            Result.Err(error) => Result.Err(rollback_if_active(conn, error)),
        },
        Result.Err(error) => match rollback_tx(conn, tx) {
            Result.Ok(_) => Result.Err(error),
            Result.Err(cleanup) => Result.Err(combine_migration_errors(AdPostgres, error, &"rollback migration", cleanup)),
        },
    }
}

fn execute_transaction_sql(conn: &mut PgConnection, sql: &Text) -> Result<(), DbError> {
    let command = transactional_sql(sql)?;
    conn.execute(&command)?;
    if !(conn.tx_status() is TxInTransaction) {
        return Result.Err(state_error(&"migration did not retain its transaction"));
    }
    Result.Ok(())
}

fn execute_sequential_sql(conn: &mut PgConnection, sql: &Text) -> Result<(), DbError> {
    match conn.execute(sql) {
        Result.Ok(_) if conn.tx_status() is TxIdle => Result.Ok(()),
        Result.Ok(_) => Result.Err(rollback_if_active(conn, state_error(&"nontransactional SQL left an open transaction"))),
        Result.Err(error) => Result.Err(rollback_if_active(conn, error)),
    }
}

/// CREATE TABLE IF NOT EXISTS can still lose a concurrent catalog insertion.
/// Serialize initializers by the creation schema and name before the OID exists.
/// The two-int advisory key space is disjoint from the session's bigint OID.
fn initialize_table(conn: &mut PgConnection, table: &Text) -> Result<(Text, Int), DbError> {
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvText(table.clone()))];
    let bootstrap = "SELECT true FROM pg_catalog.parse_ident($1::text) AS name(parts) CROSS JOIN LATERAL pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtext('core.database.postgres.migrations.init'),pg_catalog.hashtext(pg_catalog.format('%I.%I',CASE WHEN parts[2] IS NULL THEN pg_catalog.current_schema()::text ELSE parts[1] END,COALESCE(parts[2],parts[1]))))";
    query_typed(conn, &bootstrap, &params)?;
    let sql = f"CREATE TABLE IF NOT EXISTS {table} (version BIGINT PRIMARY KEY,name TEXT NOT NULL,status TEXT NOT NULL,applied_at BIGINT,error TEXT,checksum BIGINT NOT NULL,CHECK ((status='pending' AND applied_at IS NULL AND error IS NULL) OR (status IN ('applied','rolled_back') AND applied_at IS NOT NULL AND error IS NULL) OR (status='failed' AND applied_at IS NULL AND error IS NOT NULL)))";
    conn.execute(&sql)?;
    let relation = lookup_table(conn, table)?;
    relation.ok_or_else(|| state_error(&"tracking table was not found after initialization"))
}

fn write_locked(conn: &mut PgConnection, table: &Text, expected: Int, sql: Maybe<&Text>, entry: &JournalEntry)
    -> Result<(), DbError>
{
    lock_table(conn, table, expected, &"ROW EXCLUSIVE")?;
    if let Maybe.Some(command) = sql {
        execute_transaction_sql(conn, command)?;
        // Our own transactional DDL can rename or replace the locked table.
        require_table_identity(conn, table, expected)?;
    }
    // The whole-row type denotes the actual SQL target (also for partitions).
    // Verify it from RETURNING before committing, even if another transaction
    // exchanged the schema names after the explicit relation lock.
    let insert = f"INSERT INTO {table} AS j (version,name,status,applied_at,error,checksum) VALUES ($1::bigint,$2::text,$3::text,$4::bigint,$5::text,$6::bigint) ON CONFLICT (version) DO UPDATE SET name=EXCLUDED.name,status=EXCLUDED.status,applied_at=EXCLUDED.applied_at,error=EXCLUDED.error,checksum=EXCLUDED.checksum RETURNING (SELECT t.typrelid::bigint FROM pg_catalog.pg_type t WHERE t.oid=pg_catalog.pg_typeof(j.*)::oid)";
    let params = entry_parameters(entry);
    let result = query_typed(conn, &insert, &params)?;
    if result.rows.len() != 1 || result.rows[0].len() != 1 {
        return Result.Err(state_error(&"journal upsert did not write one row"));
    }
    match result.rows[0][0] {
        TypedValue.TvInt8(oid) if oid == expected => Result.Ok(()),
        _ => Result.Err(state_error(&"journal upsert reached a replacement table")),
    }
}

fn persist_entry(conn: &mut PgConnection, table: &Text, expected: Int, sql: Maybe<&Text>, entry: &JournalEntry)
    -> Result<(), DbError>
{
    let tx = begin_tx(conn)?;
    let result = write_locked(conn, table, expected, sql, entry);
    finish_transaction(conn, tx, result)
}

fn read_locked(conn: &mut PgConnection, table: &Text, expected: Int) -> Result<MigrationJournal, DbError> {
    lock_table(conn, table, expected, &"ACCESS SHARE")?;
    // The outer join supplies the source relation's identity even for an empty
    // journal. The presence flag distinguishes that row from malformed data.
    let sql = f"SELECT j.version,j.name,j.status,j.applied_at,j.error,j.checksum,j.tableoid IS NOT NULL,(SELECT t.typrelid::bigint FROM pg_catalog.pg_type t WHERE t.oid=pg_catalog.pg_typeof(j.*)::oid) FROM (VALUES (1)) AS seed(x) LEFT JOIN {table} AS j ON true ORDER BY j.version";
    let params: List<Maybe<TypedValue>> = [];
    let result = query_typed(conn, &sql, &params)?;
    let mut entries: List<JournalEntry> = List.with_capacity(result.rows.len());
    let mut previous: Maybe<Int> = Maybe.None;
    if result.rows.len() == 0 { return Result.Err(state_error(&"missing journal identity response")); }
    for mut row in result.rows.into_iter() {
        match row.pop() {
            Maybe.Some(TypedValue.TvInt8(oid)) if oid == expected => {},
            _ => return Result.Err(state_error(&"journal read reached a replacement table")),
        }
        match row.pop() {
            Maybe.Some(TypedValue.TvBool(false)) => continue,
            Maybe.Some(TypedValue.TvBool(true)) => {},
            _ => return Result.Err(state_error(&"invalid journal presence response")),
        }
        let entry = decode_entry(&row)?;
        if let Maybe.Some(version) = previous {
            if entry.version <= version { return Result.Err(state_error(&"duplicate or unordered journal versions")); }
        }
        previous = Maybe.Some(entry.version);
        entries.push(entry);
    }
    Result.Ok(journal_from_entries(entries))
}

fn read_relation(conn: &mut PgConnection, table: &Text, oid: Int) -> Result<MigrationJournal, DbError> {
    let tx = begin_tx_read_only(conn)?;
    let result = read_locked(conn, table, oid);
    finish_transaction(conn, tx, result)
}

fn read_current_journal(conn: &mut PgConnection, configured: &Text) -> Result<MigrationJournal, DbError> {
    let name = quoted_table(conn, configured)?;
    let (table, oid) = match lookup_table(conn, &name)? {
        Maybe.Some(resolved) => resolved,
        Maybe.None => return Result.Ok(journal_new()),
    };
    read_relation(conn, &table, oid)
}

fn drop_locked(conn: &mut PgConnection, table: &Text, expected: Int) -> Result<(), DbError> {
    lock_table(conn, table, expected, &"ACCESS EXCLUSIVE")?;
    conn.execute(&f"DROP TABLE {table}")?;
    // A schema can be renamed while we own the table lock. If the name then
    // dropped another relation, the locked original still exists. Roll back.
    let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvInt8(expected))];
    let gone = "SELECT NOT EXISTS (SELECT FROM pg_catalog.pg_class WHERE oid::bigint=$1::bigint)";
    let result = query_typed(conn, &gone, &params)?;
    if result.rows.len() == 1 && result.rows[0].len() == 1 && result.rows[0][0] is TypedValue.TvBool(true) {
        return Result.Ok(());
    }
    Result.Err(state_error(&"drop reached a replacement tracking table"))
}

implement PostgresMigrationStore {
    fn initialized_table(&self) -> Result<(Text, Int), DbError> {
        match &self.table {
            Maybe.Some((name, oid)) => Result.Ok((name.clone(), *oid)),
            Maybe.None => Result.Err(state_error(&"initialize the migration store first")),
        }
    }

    fn drop_relation(&mut self, table: &Text, expected: Int) -> Result<(), DbError> {
        let tx = begin_tx(&mut self.conn)?;
        let result = drop_locked(&mut self.conn, table, expected);
        finish_transaction(&mut self.conn, tx, result)
    }
}

implement MigrationStore for PostgresMigrationStore {
    fn dialect(&self) -> Text { "postgres".to_text() }
    fn adapter_id(&self) -> AdapterId { AdPostgres }
    fn config(&self) -> &MigrationStoreConfig { &self.config }

    async fn init(&mut self) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        if self.held_lock is Maybe.Some(_) { return Result.Err(state_error(&"cannot reinitialize a locked store")); }
        let table = quoted_table(&mut self.conn, &self.config.table_name)?;
        let tx = begin_tx(&mut self.conn)?;
        let result = initialize_table(&mut self.conn, &table);
        let resolved = finish_transaction(&mut self.conn, tx, result)?;
        self.table = Maybe.Some(resolved);
        Result.Ok(())
    }

    async fn load_journal(&mut self) -> Result<MigrationJournal, DbError> {
        require_idle(&self.conn)?;
        let (table, oid) = match &self.table {
            Maybe.Some((name, key)) => (name.clone(), *key),
            Maybe.None => return read_current_journal(&mut self.conn, &self.config.table_name),
        };
        read_relation(&mut self.conn, &table, oid)
    }

    async fn upsert_entry(&mut self, entry: &JournalEntry) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        let (table, oid) = self.initialized_table()?;
        persist_entry(&mut self.conn, &table, oid, Maybe.None, entry)
    }

    async fn acquire_lock(&mut self) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        let (table, key) = self.initialized_table()?;
        if self.held_lock is Maybe.Some(_) { return require_table_identity(&mut self.conn, &table, key); }
        self.conn.execute(&f"SELECT pg_catalog.pg_advisory_lock({key}::bigint)")?;
        self.held_lock = Maybe.Some(key);
        // A different runner may have replaced the journal while we waited.
        match require_table_identity(&mut self.conn, &table, key) {
            Result.Ok(_) => Result.Ok(()),
            Result.Err(error) => match self.release_lock().await {
                Result.Ok(_) => Result.Err(error),
                Result.Err(cleanup) => Result.Err(combine_migration_errors(
                    AdPostgres, error, &"release obsolete relation lock", cleanup)),
            },
        }
    }

    async fn release_lock(&mut self) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        let key = match self.held_lock {
            Maybe.Some(value) => value,
            Maybe.None => return Result.Ok(()),
        };
        let params: List<Maybe<TypedValue>> = [Maybe.Some(TypedValue.TvInt8(key))];
        let result = query_typed(&mut self.conn, &"SELECT pg_catalog.pg_advisory_unlock($1::bigint)", &params)?;
        if result.rows.len() != 1 || result.rows[0].len() != 1 {
            return Result.Err(state_error(&"invalid advisory unlock response"));
        }
        match result.rows[0][0] {
            TypedValue.TvBool(true) => { self.held_lock = Maybe.None; Result.Ok(()) },
            TypedValue.TvBool(false) => {
                self.held_lock = Maybe.None;
                Result.Err(state_error(&"migration advisory lock was not held"))
            }
            _ => Result.Err(state_error(&"invalid advisory unlock response")),
        }
    }

    async fn execute_sql(&mut self, sql: &Text) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        if !self.config.transactional { return execute_sequential_sql(&mut self.conn, sql); }
        let tx = begin_tx(&mut self.conn)?;
        let result = execute_transaction_sql(&mut self.conn, sql);
        finish_transaction(&mut self.conn, tx, result)
    }

    async fn execute_step(&mut self, sql: &Text, entry: &JournalEntry) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        let (table, oid) = self.initialized_table()?;
        if self.config.transactional {
            return persist_entry(&mut self.conn, &table, oid, Maybe.Some(sql), entry);
        }
        require_table_identity(&mut self.conn, &table, oid)?;
        execute_sequential_sql(&mut self.conn, sql)?;
        // Nontransactional SQL has committed. Journal only the original table.
        persist_entry(&mut self.conn, &table, oid, Maybe.None, entry)
    }

    async fn drop_tracking_table(&mut self) -> Result<(), DbError> {
        require_idle(&self.conn)?;
        if self.held_lock is Maybe.Some(_) { return Result.Err(state_error(&"cannot drop a locked migration store")); }
        if self.table is Maybe.None { return Result.Ok(()); }
        let (table, oid) = self.initialized_table()?;
        self.acquire_lock().await?;
        let result = self.drop_relation(&table, oid);
        if result is Result.Ok(_) { self.table = Maybe.None; }
        let released = self.release_lock().await;
        match (result, released) {
            (Result.Ok(_), Result.Ok(_)) => Result.Ok(()),
            (Result.Err(error), Result.Ok(_)) => Result.Err(error),
            (Result.Ok(_), Result.Err(error)) => Result.Err(error),
            (Result.Err(error), Result.Err(cleanup)) => Result.Err(combine_migration_errors(
                AdPostgres, error, &"release dropped relation lock", cleanup)),
        }
    }
}
