// =============================================================================
// database/postgres/migrations/mod.vr — Postgres migration adapter entry-point
// =============================================================================
// Layer: 2 (Database — Postgres adapter)
// =============================================================================
//
// Postgres-specific facade over the universal migration subsystem
// (`core/database/common/migrations/`). Re-exports the universal
// types + the Postgres `MigrationStore` impl so callers can:
//
// ```verum
// mount core.database.common.error.DbError;
// mount core.database.postgres.config.PgConfig;
// mount core.database.postgres.connection.connect;
// mount core.database.common.migrations.plan.MigrationPlan;
// mount core.database.common.migrations.runner.{RunReport, RmStrict, runner_new};
// mount core.database.common.migrations.store.store_config_default;
// mount core.database.postgres.migrations.store.store_new;
//
// async fn apply_plan(config: &PgConfig, plan: &MigrationPlan, now_ns: Int64) -> Result<RunReport, DbError> {
//     let mut store = store_new(connect(config)?, store_config_default());
//     runner_new(RmStrict).execute(plan, &mut store, now_ns).await
// }
// ```
//
// The store serializes migration runs with a PostgreSQL advisory lock.
// In transactional mode each step commits its SQL and journal entry together.
// Journal writes lock and verify the original tracking relation.
// Versions, checksums and nanosecond timestamps use BIGINT.
// Names, statuses and errors use TEXT.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Postgres facade for migration subsystem — store + universal re-exports",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.postgres.migrations;

// Postgres-specific store
public mount core.database.postgres.migrations.store.{
    PostgresMigrationStore, store_new,
};

// Universal types — re-exported for ergonomic use
public mount core.database.common.migrations.{
    Migration, MigrationStatus,
    MsPending, MsApplied, MsRolledBack, MsFailed,
    migration_new, status_name,
    JournalEntry, MigrationJournal, journal_new, checksum_for_sql,
    MigrationPlan, MigrationPlanError,
    PeDuplicateVersion, PeUnknownDependency, PeCycle,
    build,
    MigrationRunner, RunMode, RunDecision, RunReport,
    RmDryRun, RmStrict, RmContinueOnDrift,
    RdSkip, RdApply, RdSkipDrift, RdAbortDrift,
    runner_new, run_mode_name, decision_kind_name,
    MigrationStore, MigrationStoreConfig, store_config_default,
};
