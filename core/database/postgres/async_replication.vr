// Demand-driven PostgreSQL replication. Each clone serializes protocol
// operations on the same wire. Reads consume frames only when requested.
@arch_module(
    exposes: [Capability.Read(ResourceTag.Database("*")), Capability.Write(ResourceTag.Database("*")), Capability.Persist(PersistenceMedium.DatabaseMedium("*")), Capability.Network(NetProtocol.Tcp, NetDirection.Bidirectional)],
    requires: [Capability.Exec(ExecTarget.Syscall(0)), Capability.Network(NetProtocol.Tcp, NetDirection.Bidirectional)],
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LCls,
    lifecycle: Lifecycle.Definition
)
module core.database.postgres.async_replication;

mount core.sync.mutex.{Mutex, MutexGuard};
mount collections.List;
mount core.database.common.error.{
    DbError, AdapterId, AdPostgres, AdapterSpecific,
};
mount core.database.postgres.replication.{
    PgReplicationConfig, PgReplicationConnection,
    LogicalReplicationOptions, IdentifySystemRow,
    Lsn, ReplicationMessage, RmKeepalive,
    connect_replication,
};
mount core.async.channel.OneshotSender;
mount core.async.cancellation.{CancellationToken, Registration};
mount core.time.instant.Instant;

// =============================================================================
// Tunables
// =============================================================================

/// Maximum duration of an idle socket read while holding the session lock.
public const DEFAULT_RECV_TIMEOUT_MS: Int = 1_000;

/// Historical event buffer capacity, retained for callers sizing their own queues.
public const DEFAULT_MSG_CAPACITY: Int = 256;

/// Historical command buffer capacity.
public const DEFAULT_STATUS_CAPACITY: Int = 16;

// =============================================================================
// Actor protocol
// =============================================================================

/// Request envelopes retained for callers building a channel-based adapter.
public type ReplRequest is
      RrStartLogical {
        opts: LogicalReplicationOptions,
        start_lsn: Lsn,
        ack: OneshotSender<Result<(), DbError>>,
    }
    | RrStartPhysical {
        slot: Text,
        start_lsn: Lsn,
        timeline: Maybe<Int>,
        ack: OneshotSender<Result<(), DbError>>,
    }
    | RrIdentifySystem {
        ack: OneshotSender<Result<core.database.postgres.replication.IdentifySystemRow, DbError>>,
    }
    | RrCreateLogicalSlot {
        slot: Text,
        plugin: Text,
        temporary: Bool,
        ack: OneshotSender<Result<(), DbError>>,
    }
    | RrDropSlot {
        slot: Text,
        wait: Bool,
        ack: OneshotSender<Result<(), DbError>>,
    }
    | RrShutdown {
        ack: OneshotSender<Result<(), DbError>>,
    };

/// Standby Status Update payload — written between read attempts.
public type StandbyStatusUpdate is {
    write: Lsn,
    flush: Lsn,
    apply: Lsn,
    client_time_us: Int,
    reply_requested: Bool,
};

/// Replication frames followed by one terminal event on close or wire failure.
public type ReplActorEvent is
      ReaEvent(ReplicationMessage)
    | ReaTerminated(DbError)
    | ReaClosed;

// A clone shares the session lock. The PostgreSQL protocol and its framing
// buffer always have a single owner, including while writing standby feedback.
type ReplicationSession is {
    wire: Maybe<PgReplicationConnection>,
    terminal: Maybe<ReplActorEvent>,
    registrations: List<Registration>,
    sent_at: Maybe<Instant>,
    estimate_us: Int,
    samples: Int,
};

type ReadStep is RsWaitForStart | RsRetry | RsEnd | RsEvent(ReplActorEvent);

implement ReplicationSession {
    fn active(&mut self) -> Result<&mut PgReplicationConnection, DbError> {
        match self.wire.as_mut() {
            Maybe.Some(wire) => Result.Ok(wire),
            Maybe.None => Result.Err(DbError.Adapter(AdapterSpecific.new(
                AdPostgres, "REPL_ACTOR_CLOSED".clone(), "replication session is closed".clone(), false,
            ))),
        }
    }

    fn close_wire(&mut self) -> Result<(), DbError> {
        self.registrations.clear();
        match self.wire.take() {
            Maybe.Some(wire) => {
                let result = wire.close();
                self.terminal = match &result {
                    Result.Ok(()) => Maybe.Some(ReaClosed),
                    Result.Err(e) => Maybe.Some(ReaTerminated(e.clone())),
                };
                result
            }
            Maybe.None => Result.Ok(()),
        }
    }

    fn identify_system_sync(&mut self) -> Result<IdentifySystemRow, DbError> {
        let wire = self.active()?;
        wire.identify_system()
    }

    fn create_logical_slot_sync(
        &mut self, slot: &Text, plugin: &Text, temporary: Bool,
    ) -> Result<(), DbError> {
        let wire = self.active()?;
        wire.create_logical_slot(slot, plugin, temporary)
    }

    fn drop_slot_sync(&mut self, slot: &Text, wait: Bool) -> Result<(), DbError> {
        let wire = self.active()?;
        wire.drop_slot(slot, wait)
    }

    fn start_logical_sync(
        &mut self, opts: LogicalReplicationOptions, start_lsn: Lsn,
    ) -> Result<(), DbError> {
        let wire = self.active()?;
        wire.start_logical(&opts, start_lsn)?;
        match wire.set_recv_timeout_ms(Maybe.Some(DEFAULT_RECV_TIMEOUT_MS)) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(e) => { let _ = self.close_wire(); Result.Err(e) }
        }
    }

    fn start_physical_sync(
        &mut self, slot: &Text, start_lsn: Lsn, timeline: Maybe<Int>,
    ) -> Result<(), DbError> {
        let wire = self.active()?;
        wire.start_physical(slot, start_lsn, timeline)?;
        match wire.set_recv_timeout_ms(Maybe.Some(DEFAULT_RECV_TIMEOUT_MS)) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(e) => { let _ = self.close_wire(); Result.Err(e) }
        }
    }

    fn send_standby_status_sync(
        &mut self, write: Lsn, flush: Lsn, apply: Lsn,
        client_time_us: Int, reply_requested: Bool,
    ) -> Result<(), DbError> {
        let wire = self.active()?;
        let streaming = wire.is_streaming();
        let result = wire.send_standby_status(write, flush, apply, client_time_us, reply_requested);
        match result {
            Result.Ok(()) => {
                self.sent_at = Maybe.Some(Instant.now());
                Result.Ok(())
            }
            Result.Err(e) => {
                if streaming {
                    let _ = self.close_wire();
                    self.terminal = Maybe.Some(ReaTerminated(e.clone()));
                }
                Result.Err(e)
            }
        }
    }

    fn step(&mut self) -> ReadStep {
        match self.terminal.take() {
            Maybe.Some(event) => { return RsEvent(event); }
            Maybe.None => {}
        }
        let result = match self.wire.as_mut() {
            Maybe.None => { return RsEnd; }
            Maybe.Some(wire) => {
                if !wire.is_streaming() { return RsWaitForStart; }
                wire.try_next_message()
            }
        };
        match result {
            Result.Ok(Maybe.Some(msg)) => {
                match &msg {
                    RmKeepalive(_) => {
                        if let Maybe.Some(sent) = self.sent_at.take() {
                            let sample = sent.elapsed().as_micros();
                            self.estimate_us = if self.samples == 0 {
                                sample
                            } else { self.estimate_us + (sample - self.estimate_us) / 8 };
                            self.samples = self.samples + 1;
                        }
                    }
                    _ => {}
                }
                RsEvent(ReaEvent(msg))
            }
            Result.Ok(Maybe.None) => RsRetry,
            Result.Err(e) => {
                let _ = self.close_wire();
                self.terminal = Maybe.None;
                RsEvent(ReaTerminated(e))
            }
        }
    }
}

public type AsyncPgReplicationConnection is {
    session: Shared<Mutex<ReplicationSession>>,
};

implement AsyncPgReplicationConnection {
    fn lock_session(&self) -> MutexGuard<ReplicationSession> {
        match self.session.lock() {
            Result.Ok(guard) => guard,
            Result.Err(poisoned) => poisoned.into_inner(),
        }
    }

    public fn clone(&self) -> AsyncPgReplicationConnection {
        AsyncPgReplicationConnection { session: self.session.clone() }
    }

    public fn rtt_estimate_us(&self) -> Maybe<Int> {
        let state = self.lock_session();
        if state.samples == 0 { Maybe.None } else { Maybe.Some(state.estimate_us) }
    }

    public fn rtt_samples(&self) -> Int {
        self.lock_session().samples
    }

    /// Closing the last handle releases the registration. The weak session
    /// reference lets a token outlive the connection.
    public fn attach_cancellation_token(&self, token: CancellationToken) {
        let weak: Weak<Mutex<ReplicationSession>> = self.session.downgrade();
        let registration = token.register(move || {
            let live: Maybe<Shared<Mutex<ReplicationSession>>> = weak.upgrade();
            if let Maybe.Some(session) = live {
                let connection = AsyncPgReplicationConnection { session: session };
                let _ = connection.close_sync();
            }
        });
        let mut state = self.lock_session();
        if state.wire.is_some() { state.registrations.push(registration); }
    }

    public async fn identify_system(&self) -> Result<IdentifySystemRow, DbError> {
        let mut state = self.lock_session();
        state.identify_system_sync()
    }

    public async fn create_logical_slot(
        &self, slot: &Text, plugin: &Text, temporary: Bool,
    ) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.create_logical_slot_sync(slot, plugin, temporary)
    }

    public async fn drop_slot(&self, slot: &Text, wait: Bool) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.drop_slot_sync(slot, wait)
    }

    public async fn start_logical(
        &self, opts: LogicalReplicationOptions, start_lsn: Lsn,
    ) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.start_logical_sync(opts, start_lsn)
    }

    public async fn start_physical(
        &self, slot: &Text, start_lsn: Lsn, timeline: Maybe<Int>,
    ) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.start_physical_sync(slot, start_lsn, timeline)
    }

    /// Pull on demand. No socket guard crosses a suspension point. Once
    /// the terminal event has been delivered, subsequent reads return None.
    public async fn next_event(&self) -> Maybe<ReplActorEvent> {
        loop {
            let step = { let mut state = self.lock_session(); state.step() };
            match step {
                RsEnd => { return Maybe.None; }
                RsEvent(event) => { return Maybe.Some(event); }
                RsWaitForStart => {
                    core.sys.time_ops.sleep_ms(10);
                    core.async.select.yield_now().await;
                }
                RsRetry => { core.async.select.yield_now().await; }
            }
        }
    }

    public async fn next_message(&self) -> Result<Maybe<ReplicationMessage>, DbError> {
        match self.next_event().await {
            Maybe.Some(ReaEvent(msg)) => Result.Ok(Maybe.Some(msg)),
            Maybe.Some(ReaTerminated(e)) => Result.Err(e),
            Maybe.Some(ReaClosed) | Maybe.None => Result.Ok(Maybe.None),
        }
    }

    public async fn send_standby_status(
        &self, write: Lsn, flush: Lsn, apply: Lsn,
        client_time_us: Int, reply_requested: Bool,
    ) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.send_standby_status_sync(write, flush, apply, client_time_us, reply_requested)
    }

    fn close_sync(&self) -> Result<(), DbError> {
        let mut state = self.lock_session();
        state.close_wire()
    }

    public async fn close(&self) -> Result<(), DbError> { self.close_sync() }
}

/// The handshake and command I/O use the synchronous PostgreSQL transport.
/// Streaming configures an idle read timeout. The caller yields
/// between idle reads while other handles can send feedback or close.
public async fn connect_replication_async(
    cfg: PgReplicationConfig,
) -> Result<AsyncPgReplicationConnection, DbError> {
    let wire = connect_replication(&cfg)?;
    let state = ReplicationSession {
        wire: Maybe.Some(wire), terminal: Maybe.None, registrations: List.new(),
        sent_at: Maybe.None, estimate_us: 0, samples: 0,
    };
    Result.Ok(AsyncPgReplicationConnection { session: Shared.new(Mutex.new(state)) })
}
