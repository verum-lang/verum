// =============================================================================
// database/common/migrations/runner.vr — MigrationRunner state machine
// =============================================================================
// Layer: 2 (Database — vendor-neutral)
// Dependencies: core, base, common/migrations/{migration, journal, plan, store}
// =============================================================================
//
// `MigrationRunner` walks a `MigrationPlan` from low to high version,
// skipping every step the journal already records as Applied, applying
// the rest through the supplied `MigrationStore`.
//
// **Three execution modes:**
//   * `RmDryRun`            — validate the plan, log every decision,
//                             do not apply any SQL.
//   * `RmStrict`            — abort on first failure; rollback applied
//                             steps in LIFO order if `auto_rollback`.
//   * `RmContinueOnDrift`   — apply checksum-mismatched steps as if
//                             fresh (use with care).
//
// **Vendor-neutralisation**: the runner takes a `&mut dyn MigrationStore`
// and delegates ALL database interaction to it. The runner contains zero
// SQL, zero connection handling, zero vendor-specific code.
//
// Each successful step is recorded through execute_step. Execution failures
// return DbError after attempted recovery and lock release. A known journal
// drift aborts the plan before any migration statement is executed.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "vendor-neutral migration runner orchestrating MigrationStore",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.common.migrations.runner;

mount base.{Text, Bool, Maybe, Result, Ok, Err};
mount collections.List;
mount core.database.common.error.{DbError};
mount core.database.common.migrations.migration.{
    Migration, MigrationStatus, MsApplied, MsPending, MsRolledBack, MsFailed, clone_migration,
};
mount core.database.common.migrations.plan.{MigrationPlan};
mount core.database.common.migrations.journal.{
    MigrationJournal, JournalEntry, journal_new, checksum_for_sql,
};
mount core.database.common.migrations.store.{MigrationStore, combine_migration_errors};

// -----------------------------------------------------------------------------
// Modes
// -----------------------------------------------------------------------------

public type RunMode is RmDryRun | RmStrict | RmContinueOnDrift;

public fn run_mode_name(m: &RunMode) -> Text {
    match m {
        RmDryRun           => "dry-run".clone(),
        RmStrict           => "strict".clone(),
        RmContinueOnDrift  => "continue-on-drift".clone(),
    }
}

// -----------------------------------------------------------------------------
// RunDecision — what the runner intends per migration
// -----------------------------------------------------------------------------

public type RunDecision is
      RdSkip(Int, Text)            // version, reason
    | RdApply(Int, Text)           // version, sql
    | RdSkipDrift(Int, Text)
    | RdAbortDrift(Int, Text);

public fn decision_kind_name(d: &RunDecision) -> Text {
    match d {
        RdSkip(_, _)        => "skip".clone(),
        RdApply(_, _)       => "apply".clone(),
        RdSkipDrift(_, _)   => "skip_drift".clone(),
        RdAbortDrift(_, _)  => "abort_drift".clone(),
    }
}

// -----------------------------------------------------------------------------
// RunReport
// -----------------------------------------------------------------------------

public type RunReport is {
    public dialect: Text,                  // store.dialect() at run start
    public applied: Int,
    public skipped: Int,
    public failed: Int,
    public rolled_back: Int,
    public aborted: Bool,
    public abort_reason: Maybe<Text>,
    public decisions: List<RunDecision>,
};

public fn report_zero(dialect: Text) -> RunReport {
    RunReport {
        dialect: dialect,
        applied: 0, skipped: 0, failed: 0, rolled_back: 0,
        aborted: false, abort_reason: Maybe.None,
        decisions: List.new(),
    }
}

// -----------------------------------------------------------------------------
// MigrationRunner
// -----------------------------------------------------------------------------

public type MigrationRunner is {
    mode: RunMode,
    auto_rollback: Bool,
};

public fn runner_new(mode: RunMode) -> MigrationRunner {
    MigrationRunner { mode: mode, auto_rollback: true }
}

implement MigrationRunner {
    public fn disable_rollback(mut self) -> MigrationRunner {
        self.auto_rollback = false;
        self
    }

    /// Compute the runner's decision per migration WITHOUT executing.
    /// Used to render a deployment-time preview.
    public fn plan_decisions(
        &self,
        plan: &MigrationPlan,
        journal: &MigrationJournal,
    ) -> List<RunDecision> {
        let mut out: List<RunDecision> = List.new();
        let mut i: Int = 0;
        while i < plan.ordered.len() {
            let m = &plan.ordered[i];
            let drift = journal.drift_detected(m);
            let applied = journal.is_applied(m.version);
            if applied && !drift {
                out.push(RdSkip(m.version, "already applied".clone()));
            } else if applied && drift {
                match self.mode {
                    RmContinueOnDrift => out.push(RdApply(m.version, m.up_sql.clone())),
                    _                  => out.push(RdAbortDrift(m.version, "checksum mismatch".clone())),
                }
            } else {
                match self.mode {
                    RmDryRun => out.push(RdSkip(m.version, "dry-run".clone())),
                    _        => out.push(RdApply(m.version, m.up_sql.clone())),
                }
            }
            i = i + 1;
        }
        out
    }

    /// Execute through the store's atomic step boundary. Once acquired, the
    /// lock is released on every Result path, including journal/recovery errors.
    public async fn execute(
        &self,
        plan: &MigrationPlan,
        store: &mut dyn MigrationStore,
        clock_ns: Int64,
    ) -> Result<RunReport, DbError> {
        if self.mode is RmDryRun {
            // Preview reads existing state but never creates a tracking table,
            // writes a journal entry or acquires a migration lock.
            let journal = store.load_journal().await?;
            let mut report = report_zero(store.dialect());
            let decisions = self.plan_decisions(plan, &journal);
            report.decisions = clone_decisions(&decisions);
            for decision in decisions.iter() {
                match decision {
                    RdAbortDrift(_, reason) => {
                        report.aborted = true;
                        if report.abort_reason is Maybe.None {
                            report.abort_reason = Maybe.Some(reason.clone());
                        }
                    }
                    _ => { report.skipped = report.skipped + 1; }
                }
            }
            return Result.Ok(report);
        }
        store.init().await?;
        store.acquire_lock().await?;
        let result = self.execute_locked(plan, store, clock_ns).await;
        let released = store.release_lock().await;
        match (result, released) {
            (Result.Ok(report), Result.Ok(_)) => Result.Ok(report),
            (Result.Err(error), Result.Ok(_)) => Result.Err(error),
            (Result.Ok(_), Result.Err(error)) => Result.Err(error),
            (Result.Err(primary), Result.Err(secondary)) => Result.Err(
                combine_migration_errors(store.adapter_id(), primary, &"release_lock", secondary)
            ),
        }
    }

    async fn execute_locked(
        &self,
        plan: &MigrationPlan,
        store: &mut dyn MigrationStore,
        clock_ns: Int64,
    ) -> Result<RunReport, DbError> {
        let mut report = report_zero(store.dialect());
        let mut journal = store.load_journal().await?;
        let decisions = self.plan_decisions(plan, &journal);
        report.decisions = clone_decisions(&decisions);
        // Reject known drift across the whole plan before applying an earlier
        // fresh step. A later incompatible journal row must not leave a partial
        // deployment that was already known to be invalid at planning time.
        for decision in decisions.iter() {
            match decision {
                RdAbortDrift(_, reason) => {
                    report.aborted = true;
                    report.abort_reason = Maybe.Some(reason.clone());
                    return Result.Ok(report);
                }
                _ => {},
            }
        }
        let mut applied_steps: List<Migration> = List.new();
        let mut idx: Int = 0;
        while idx < decisions.len() {
            let m = &plan.ordered[idx];
            match &decisions[idx] {
                RdSkip(_, _) | RdSkipDrift(_, _) => {
                    report.skipped = report.skipped + 1;
                }
                RdAbortDrift(_, reason) => {
                    report.aborted = true;
                    report.abort_reason = Maybe.Some(reason.clone());
                    break;
                }
                RdApply(_, sql) => {
                    let pending = entry_for(m, MsPending);
                    let applied = entry_for(m, MsApplied(clock_ns));
                    let step_result = match store.upsert_entry(&pending).await {
                        Result.Ok(_) => store.execute_step(sql, &applied).await,
                        Result.Err(error) => Result.Err(error),
                    };
                    match step_result {
                        Result.Ok(_) => {
                            journal.record_applied(m, clock_ns);
                            report.applied = report.applied + 1;
                            applied_steps.push(clone_migration(m));
                        }
                        Result.Err(error) => {
                            let mut failure = error;
                            let failed = entry_for(m, MsFailed(f"{failure:?}"));
                            match store.upsert_entry(&failed).await {
                                Result.Ok(_) => {},
                                Result.Err(secondary) => {
                                    failure = combine_migration_errors(store.adapter_id(), failure,
                                        &"record_failed", secondary);
                                }
                            }
                            if self.auto_rollback {
                                match self.rollback_lifo(&applied_steps, &mut journal,
                                    store, clock_ns, &mut report).await {
                                    Result.Ok(_) => {},
                                    Result.Err(secondary) => {
                                        failure = combine_migration_errors(store.adapter_id(), failure,
                                            &"rollback_applied_steps", secondary);
                                    }
                                }
                            }
                            return Result.Err(failure);
                        }
                    }
                }
            }
            idx = idx + 1;
        }
        Result.Ok(report)
    }

    async fn rollback_lifo(
        &self,
        applied: &List<Migration>,
        journal: &mut MigrationJournal,
        store: &mut dyn MigrationStore,
        clock_ns: Int64,
        report: &mut RunReport,
    ) -> Result<(), DbError> {
        let mut failure: Maybe<DbError> = Maybe.None;
        let mut i: Int = applied.len();
        while i > 0 {
            i = i - 1;
            let migration = &applied[i];
            match &migration.down_sql {
                Maybe.Some(sql) => {
                    let rolled_back = entry_for(migration, MsRolledBack(clock_ns));
                    match store.execute_step(sql, &rolled_back).await {
                        Result.Ok(_) => {
                            journal.record_rolled_back(migration, clock_ns);
                            report.rolled_back = report.rolled_back + 1;
                        }
                        Result.Err(error) => {
                            let mut current = error;
                            let failed = entry_for(migration, MsFailed(f"{current:?}"));
                            match store.upsert_entry(&failed).await {
                                Result.Ok(_) => {},
                                Result.Err(secondary) => {
                                    current = combine_migration_errors(store.adapter_id(), current,
                                        &"record_rollback_failed", secondary);
                                }
                            }
                            failure = Maybe.Some(match failure {
                                Maybe.None => current,
                                Maybe.Some(previous) => combine_migration_errors(
                                    store.adapter_id(), previous, &"rollback_previous_step", current),
                            });
                        }
                    }
                }
                Maybe.None => {} // Irreversible steps remain explicitly applied.
            }
        }
        match failure {
            Maybe.None => Result.Ok(()),
            Maybe.Some(error) => Result.Err(error),
        }
    }
}

fn entry_for(migration: &Migration, status: MigrationStatus) -> JournalEntry {
    JournalEntry {
        version: migration.version,
        name: migration.name.clone(),
        status: status,
        checksum: checksum_for_sql(&migration.up_sql),
    }
}

fn clone_decisions(ds: &List<RunDecision>) -> List<RunDecision> {
    let mut out: List<RunDecision> = List.new();
    let mut i: Int = 0;
    while i < ds.len() {
        let cloned = match &ds[i] {
            RdSkip(v, r)        => RdSkip(*v, r.clone()),
            RdApply(v, s)       => RdApply(*v, s.clone()),
            RdSkipDrift(v, r)   => RdSkipDrift(*v, r.clone()),
            RdAbortDrift(v, r)  => RdAbortDrift(*v, r.clone()),
        };
        out.push(cloned);
        i = i + 1;
    }
    out
}

