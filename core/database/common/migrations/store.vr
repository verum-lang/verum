// =============================================================================
// database/common/migrations/store.vr — MigrationStore protocol
// =============================================================================
// Layer: 2 (Database — vendor-neutral)
// Dependencies: core, base, common/protocol, common/error,
//               common/migrations/{migration, journal}
// =============================================================================
//
// MigrationRunner uses this protocol for tracking-table initialization,
// journal reads/writes, runner lock ownership and migration execution.
// execute_step is the boundary for SQL and its resulting journal entry.
// Adapters must report unsupported transaction or concurrency guarantees;
// database write locks alone do not serialize a multi-step migration runner.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "vendor-neutral protocol decoupling MigrationRunner from DB-specific persistence",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.TypecheckPlusTests,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.database.common.migrations.store;

mount base.{Text, Bool, Maybe, Result, Ok, Err};
mount collections.List;
mount core.database.common.error.{DbError, AdapterId, AdapterSpecific};
mount core.database.common.migrations.journal.{MigrationJournal, JournalEntry};

// =============================================================================
// Configuration
// =============================================================================

/// Universal migration-store configuration. Vendor-specific stores
/// extend with their own fields (advisory-lock key for Postgres, etc.).
public type MigrationStoreConfig is {
    /// Name of the persistent tracking table. Default `__verum_migrations`.
    public table_name: Text,
    /// If true, execute_step commits transactional database changes and its
    /// resulting journal entry in the same transaction. Unsupported adapters
    /// must refuse before SQL. Sequence increments and external effects are
    /// not necessarily transactional and are outside this rollback guarantee.
    /// If false, SQL and journal persistence are explicitly sequential.
    public transactional: Bool,
};

public fn store_config_default() -> MigrationStoreConfig {
    MigrationStoreConfig {
        table_name: "__verum_migrations".to_text(),
        transactional: true,
    }
}

implement MigrationStoreConfig {
    public fn with_table_name(mut self, name: Text) -> MigrationStoreConfig {
        self.table_name = name;
        self
    }

    public fn with_transactional(mut self, b: Bool) -> MigrationStoreConfig {
        self.transactional = b;
        self
    }
}

// =============================================================================
// MigrationStore — the core protocol
// =============================================================================

public type MigrationStore is protocol {
    /// Structured vendor identity for diagnostics; never inferred from a label.
    fn adapter_id(&self) -> AdapterId;

    /// Adapter dialect identifier (e.g., "sqlite", "postgres"). Used in
    /// diagnostics and run-report headers.
    fn dialect(&self) -> Text;

    /// Configuration used at construction.
    fn config(&self) -> &MigrationStoreConfig;

    /// Create the migration tracking table if it does not exist.
    /// Idempotent. Vendor chooses column types and dialect-specific
    /// quoting.
    async fn init(&mut self) -> Result<(), DbError>;

    /// Load every row of the tracking table into a `MigrationJournal`.
    async fn load_journal(&mut self) -> Result<MigrationJournal, DbError>;

    /// Persist a journal entry (INSERT or UPDATE on `(version)` conflict).
    async fn upsert_entry(&mut self, entry: &JournalEntry) -> Result<(), DbError>;

    /// Acquire the adapter's runner lock. PostgreSQL uses a session advisory
    /// lock tied to the tracking relation. Native SQLite currently has no
    /// equivalent runner lock and cannot promise multi-step serialization.
    async fn acquire_lock(&mut self) -> Result<(), DbError>;

    /// Release the lock acquired in `acquire_lock`. Called even on
    /// migration failure.
    async fn release_lock(&mut self) -> Result<(), DbError>;

    /// Execute one DDL/DML statement from a migration's up_sql/down_sql.
    /// The store decides whether to wrap in a transaction (per
    /// `config.transactional`).
    async fn execute_sql(&mut self, sql: &Text) -> Result<(), DbError>;

    /// Execute one migration statement and persist its resulting journal entry.
    /// With transactional=true transactional database changes and this entry
    /// share one commit. Nontransactional SQL effects (such as sequence
    /// increments or external calls) are outside this rollback guarantee.
    /// An adapter without that capability must fail before executing SQL.
    /// With transactional=false the statement precedes the journal write; a
    /// journal failure can therefore leave SQL effects committed.
    async fn execute_step(&mut self, sql: &Text, entry: &JournalEntry) -> Result<(), DbError>;

    /// Drop the entire migration tracking table. Used by tooling
    /// ("reset migrations") and by tests. Idempotent.
    async fn drop_tracking_table(&mut self) -> Result<(), DbError>;
}

/// Preserve both failures when recovery or lock release also fails. DbError
/// currently has no typed cause collection: the original Debug diagnostics are
/// retained, while callers must not infer safe retry from the combined error.
/// A single failure should be returned unchanged instead of using this helper.
public fn combine_migration_errors(
    adapter: AdapterId,
    primary: DbError,
    phase: &Text,
    secondary: DbError,
) -> DbError {
    DbError.Adapter(AdapterSpecific.new(
        adapter, "migration_cleanup_failed",
        f"primary: {primary:?}; {phase}: {secondary:?}", false,
    ))
}

// =============================================================================
// Convenience helpers
// =============================================================================

/// Default DDL fragment: column shape used by both SQLite and Postgres
/// MigrationStore impls. Adapters substitute their own integer / text
/// types around this canonical column set.
public fn canonical_columns_doc() -> Text {
    "version INTEGER PRIMARY KEY,
     name TEXT NOT NULL,
     status TEXT NOT NULL,
     applied_at INTEGER,
     error TEXT,
     checksum INTEGER NOT NULL".to_text()
}

/// FNV-1a 64-bit hash of a table-name string. This does not identify a
/// database relation: qualified/unqualified aliases can name the same table.
/// PostgreSQL migration locking resolves the actual relation identity instead.
public fn advisory_lock_key_for(table_name: &Text) -> Int64 {
    let mut h: Int64 = -3750763034362895579 as Int64;
    let bs = table_name.as_bytes();
    let mut i: Int = 0;
    while i < bs.len() {
        h = h ^ (bs[i] as Int64);
        h = h * 1099511628211_i64;
        i = i + 1;
    }
    h
}

