// Type information uses declaration-owned properties: T.size, T.alignment,
// T.stride, T.bits, T.name and T.id. Queries below expose additional facts.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.intrinsics.type_info;

/// Whether the declaration-owned destruction plan performs cleanup.
/// Missing destruction evidence is an error, never a guessed answer.
public meta fn needs_drop<T>() -> Bool { @intrinsic("needs_drop", T) }

/// Minimum alignment of all primitive types
public meta fn min_align() -> USize { UInt8.alignment as USize }
