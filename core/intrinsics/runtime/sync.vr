// =============================================================================
// core/intrinsics/runtime/sync.vr - Synchronization Intrinsics
// =============================================================================
// Layer: Stdlib (1)
// Dependencies: Operating system threading
//

// Efficient blocking synchronization using OS primitives.
//

// Implementation:
// - Linux: futex syscall
// - macOS: __ulock_wait/__ulock_wake
// - Windows: WaitOnAddress/WakeByAddressSingle
//

// Spec: 05-syntax-grammar.md
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.intrinsics.runtime.sync;

// =============================================================================
// SECTION 1: Futex Operations
// =============================================================================

/// Compare a 32-bit word with `expected` and park while it still matches.
/// The comparison and waiter registration must be atomic with respect to wake.
/// A zero timeout has no deadline. Results are 0 for a wake, -11 for an
/// initial mismatch, and -110 for a timeout. Other negative values report errors.
@intrinsic("futex_wait")
public fn futex_wait(addr: *const UInt32, expected: UInt32, timeout_ns: UInt64) -> Int32;

/// Wake up to `count` waiters already registered at this address.
/// Return the number woken, or a negative status on failure.
@intrinsic("futex_wake")
public fn futex_wake(addr: *const UInt32, count: UInt32) -> Int32;

/// Wake exactly one thread waiting on address.
@intrinsic("futex_wake_one")
@inline(always)
public fn futex_wake_one(addr: *const UInt32) -> Int32;

/// Wake all threads waiting on address.
@intrinsic("futex_wake_all")
public fn futex_wake_all(addr: *const UInt32) -> Int32;

// =============================================================================
// SECTION 2: Spinlock Operations
// =============================================================================

/// Try to acquire spinlock without blocking.
///

/// Returns: true if lock acquired, false if already held
@intrinsic("spinlock_try_lock")
@inline(always)
public fn spinlock_try_lock(lock: *mut UInt32) -> Bool;

/// Acquire spinlock, spinning until available.
///

/// Uses spin_hint() for power efficiency.
@intrinsic("spinlock_lock")
public fn spinlock_lock(lock: *mut UInt32);

/// Release spinlock.
@intrinsic("spinlock_unlock")
@inline(always)
public fn spinlock_unlock(lock: *mut UInt32);

/// Check if spinlock is held (non-blocking).
@intrinsic("spinlock_is_locked")
@inline(always)
public fn spinlock_is_locked(lock: *const UInt32) -> Bool;

// =============================================================================
// SECTION 3: CPU Hints and Fences
// =============================================================================

/// Hint to the CPU that we are in a spin loop (power-efficient pause).
@intrinsic("spin_hint")
@inline(always)
public fn spin_hint();

/// Alias for spin_hint (Rust-style name)
@intrinsic("spin_hint")
@inline(always)
public fn spin_loop_hint();

/// Full memory fence with specified ordering.
@intrinsic("memory_fence")
@inline(always)
public fn memory_fence(order: Int = 5);

/// Compiler-only fence (prevents reordering, no hardware barrier).
@intrinsic("compiler_fence")
@inline(always)
public fn compiler_fence(order: Int = 5);

// =============================================================================
// SECTION 4: WaitGroup primitives — migrated from `core/sync/waitgroup.vr`
// (#65 Phase 1.5).  Counter-based join: spawn N tasks, each calls done(),
// the parent calls wait() to block until count reaches zero.
// =============================================================================

/// Create a new waitgroup. Returns opaque handle.
@intrinsic("waitgroup_new")
public fn __waitgroup_new_raw() -> Int;

/// Increment the counter by `delta` (typically called before spawn).
@intrinsic("waitgroup_add")
public fn __waitgroup_add_raw(wg: Int, delta: Int) -> Int;

/// Decrement the counter (called by spawned task on completion).
@intrinsic("waitgroup_done")
public fn __waitgroup_done_raw(wg: Int) -> Int;

/// Block until the counter reaches zero.
@intrinsic("waitgroup_wait")
public fn __waitgroup_wait_raw(wg: Int) -> Int;

/// Non-blocking check; returns 1 if counter is zero.
@intrinsic("waitgroup_try_wait")
public fn __waitgroup_try_wait_raw(wg: Int) -> Int;

/// Destroy a waitgroup; reclaims the handle.
@intrinsic("waitgroup_destroy")
public fn __waitgroup_destroy_raw(wg: Int) -> Int;
