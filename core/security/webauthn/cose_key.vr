// =============================================================================
// security/webauthn/cose_key.vr — COSE_Key decoder for credential public keys
// =============================================================================
// Layer: 2 (Security primitives)
// Dependencies: core, base, encoding/cbor, security/webauthn/types
// =============================================================================
//
// **Purpose.** Decode a CBOR-encoded COSE_Key (the format
// authenticators use to express credential public keys) into a typed
// `CredentialPublicKey` ADT. This is the bridge between the
// authenticator's wire format and the cryptographic primitives in
// `core.security.{ecc, sig}`.
//
// **COSE_Key map labels (RFC 8152 + IANA COSE registry).**
//
//   1   kty       — key type:
//                    1 = OKP (Ed25519 / Ed448)
//                    2 = EC2 (P-256 / P-384 / P-521)
//                    3 = RSA
//   3   alg       — algorithm:
//                    -7   ES256, -8 EdDSA, -35 ES384, -36 ES512,
//                    -257 RS256, -37 PS256
//   -1  crv (EC2)  — curve: 1=P-256, 2=P-384, 3=P-521
//   -1  crv (OKP)  — curve: 6=Ed25519
//   -2  x          — EC2 x-coordinate or OKP x-coordinate (Ed25519 pubkey)
//   -3  y          — EC2 y-coordinate
//   -1  n (RSA)    — modulus
//   -2  e (RSA)    — public exponent
//
// **Wire encoding.** A CBOR map. WebAuthn requires canonical CBOR
// (RFC 8949 §4.2.1) for the COSE_Key inside AttestedCredentialData
// — keys must be sorted, integers must use shortest form, etc.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "COSE_Key decoder for WebAuthn credential public keys (Ed25519 / EC2 / RSA)",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.security.webauthn.cose_key;

mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.{List, Map};
mount core.encoding.cbor.{
    CborValue, decode, encode, from_signed,
    CborError,
};
mount core.hash.crypto.sha256.{Sha256};
mount core.security.ecc.ed25519.{Ed25519};
mount core.security.ecc.p256.{P256};
mount core.security.sig.rsa.{RsaPublicKey, RsaHash, verify_pkcs1_v15_prehashed, verify_pss_prehashed};
mount core.security.webauthn.types.{
    WebAuthnError,
    COSE_ALG_ES256, COSE_ALG_EDDSA, COSE_ALG_PS256, COSE_ALG_RS256,
    COSE_ALG_ES384, COSE_ALG_ES512,
};

// =============================================================================
// COSE key-type + curve constants (per IANA COSE registry)
// =============================================================================

pub const COSE_KTY_OKP:  Int = 1;
pub const COSE_KTY_EC2:  Int = 2;
pub const COSE_KTY_RSA:  Int = 3;

pub const COSE_CRV_P256:    Int = 1;
pub const COSE_CRV_P384:    Int = 2;
pub const COSE_CRV_P521:    Int = 3;
pub const COSE_CRV_ED25519: Int = 6;

// =============================================================================
// Typed credential public key
// =============================================================================

@derive(Eq, Clone, Debug)
pub type CredentialPublicKey is
    | Ed25519 { x: List<Byte> }                    // 32-byte Ed25519 pubkey
    | EcdsaP256 { x: List<Byte>, y: List<Byte> }   // 32-byte coords
    | EcdsaP384 { x: List<Byte>, y: List<Byte> }   // 48-byte coords
    | EcdsaP521 { x: List<Byte>, y: List<Byte> }   // 66-byte coords
    | Rsa { n: List<Byte>, e: List<Byte>, alg: Int }; // PS256 vs RS256

// =============================================================================
// Public API
// =============================================================================

/// Decode a CBOR-encoded COSE_Key into a typed credential public
/// key. Validates kty / alg / crv / coordinate-length consistency
/// per the registered IANA constants.
pub fn decode_cose_key(bytes: &[Byte]) -> Result<CredentialPublicKey, WebAuthnError> {
    let value = encoding.cbor.decode(bytes).map_err(|e| WebAuthnError.InvalidCbor(f"{e}"))?;
    decode_cose_key_value(&value)
}

/// Decode a parsed CborValue (the COSE_Key map). Useful when the
/// caller already has the CBOR value in hand (e.g., extracted from
/// AttestedCredentialData).
pub fn decode_cose_key_value(value: &CborValue) -> Result<CredentialPublicKey, WebAuthnError> {
    let map = value.as_map()
        .ok_or(WebAuthnError.InvalidCbor("COSE_Key not a map".to_text()))?;

    let kty = get_int(&map, 1)
        .ok_or(WebAuthnError.InvalidCbor("COSE_Key missing kty (label 1)".to_text()))?;
    let alg = get_int(&map, 3).unwrap_or(0);

    match kty {
        COSE_KTY_OKP => decode_okp(&map, alg),
        COSE_KTY_EC2 => decode_ec2(&map, alg),
        COSE_KTY_RSA => decode_rsa(&map, alg),
        other        => Result.Err(WebAuthnError.UnknownCoseKeyType(other)),
    }
}

fn decode_okp(map: &List<(CborValue, CborValue)>, alg: Int) -> Result<CredentialPublicKey, WebAuthnError> {
    let crv = get_int(map, -1).unwrap_or(0);
    if crv != COSE_CRV_ED25519 {
        return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
    }
    if alg != 0 && alg != COSE_ALG_EDDSA {
        return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
    }
    let x = get_bytes(map, -2)
        .ok_or(WebAuthnError.InvalidCbor("OKP missing x (label -2)".to_text()))?;
    if x.len() != 32 {
        return Result.Err(WebAuthnError.InvalidCbor(f"Ed25519 x must be 32 bytes, got {x.len()}"));
    }
    Result.Ok(CredentialPublicKey.Ed25519 { x })
}

fn decode_ec2(map: &List<(CborValue, CborValue)>, alg: Int) -> Result<CredentialPublicKey, WebAuthnError> {
    let crv = get_int(map, -1)
        .ok_or(WebAuthnError.InvalidCbor("EC2 missing crv (label -1)".to_text()))?;
    let x = get_bytes(map, -2)
        .ok_or(WebAuthnError.InvalidCbor("EC2 missing x (label -2)".to_text()))?;
    let y = get_bytes(map, -3)
        .ok_or(WebAuthnError.InvalidCbor("EC2 missing y (label -3)".to_text()))?;
    match crv {
        COSE_CRV_P256 => {
            if alg != 0 && alg != COSE_ALG_ES256 {
                return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
            }
            if x.len() != 32 || y.len() != 32 {
                return Result.Err(WebAuthnError.InvalidCbor("P-256 coords must be 32 bytes each".to_text()));
            }
            Result.Ok(CredentialPublicKey.EcdsaP256 { x, y })
        }
        COSE_CRV_P384 => {
            if alg != 0 && alg != COSE_ALG_ES384 {
                return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
            }
            if x.len() != 48 || y.len() != 48 {
                return Result.Err(WebAuthnError.InvalidCbor("P-384 coords must be 48 bytes each".to_text()));
            }
            Result.Ok(CredentialPublicKey.EcdsaP384 { x, y })
        }
        COSE_CRV_P521 => {
            if alg != 0 && alg != COSE_ALG_ES512 {
                return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
            }
            if x.len() != 66 || y.len() != 66 {
                return Result.Err(WebAuthnError.InvalidCbor("P-521 coords must be 66 bytes each".to_text()));
            }
            Result.Ok(CredentialPublicKey.EcdsaP521 { x, y })
        }
        other => Result.Err(WebAuthnError.UnsupportedAlgorithm(other)),
    }
}

fn decode_rsa(map: &List<(CborValue, CborValue)>, alg: Int) -> Result<CredentialPublicKey, WebAuthnError> {
    if alg != COSE_ALG_RS256 && alg != COSE_ALG_PS256 && alg != 0 {
        return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg));
    }
    let n = get_bytes(map, -1)
        .ok_or(WebAuthnError.InvalidCbor("RSA missing n (label -1)".to_text()))?;
    let e = get_bytes(map, -2)
        .ok_or(WebAuthnError.InvalidCbor("RSA missing e (label -2)".to_text()))?;
    Result.Ok(CredentialPublicKey.Rsa { n, e, alg })
}

// =============================================================================
// Helpers — CBOR map lookup by integer label
// =============================================================================

fn get_int(map: &List<(CborValue, CborValue)>, label: Int) -> Maybe<Int> {
    let mut i: Int = 0;
    while i < map.len() {
        let (k, v) = &map[i];
        if let Maybe.Some(ki) = k.as_int() {
            if ki == label {
                return v.as_int();
            }
        }
        i = i + 1;
    }
    Maybe.None
}

fn get_bytes(map: &List<(CborValue, CborValue)>, label: Int) -> Maybe<List<Byte>> {
    let mut i: Int = 0;
    while i < map.len() {
        let (k, v) = &map[i];
        if let Maybe.Some(ki) = k.as_int() {
            if ki == label {
                return v.as_bytes();
            }
        }
        i = i + 1;
    }
    Maybe.None
}

// =============================================================================
// Algorithm dispatch helper
// =============================================================================

/// Map a CredentialPublicKey to the negotiated COSE algorithm
/// identifier (used during signature verification dispatch).
pub fn alg_of(pk: &CredentialPublicKey) -> Int {
    match pk {
        CredentialPublicKey.Ed25519 { .. }       => COSE_ALG_EDDSA,
        CredentialPublicKey.EcdsaP256 { .. }     => COSE_ALG_ES256,
        CredentialPublicKey.EcdsaP384 { .. }     => COSE_ALG_ES384,
        CredentialPublicKey.EcdsaP521 { .. }     => COSE_ALG_ES512,
        CredentialPublicKey.Rsa { alg, .. }      => *alg,
    }
}

fn encode_p256_point(x: &List<Byte>, y: &List<Byte>) -> List<Byte> {
    let mut encoded: List<Byte> = List.with_capacity(65);
    encoded.push(0x04_u8);
    encoded.extend_from_slice(x.as_slice());
    encoded.extend_from_slice(y.as_slice());
    encoded
}

public(in core.security.webauthn) fn u2f_public_key(pk: &CredentialPublicKey) -> Result<List<Byte>, WebAuthnError> {
    match pk {
        CredentialPublicKey.EcdsaP256 { x, y } if x.len() == 32 && y.len() == 32 => Result.Ok(encode_p256_point(x, y)),
        _ => Result.Err(WebAuthnError.InvalidAttestation("fido-u2f requires a P-256 credential".to_text())),
    }
}

public(in core.security.webauthn) fn verify_credential_signature(
    pk:           &CredentialPublicKey,
    signed_input: &List<Byte>,
    sig:          &List<Byte>,
) -> Result<(), WebAuthnError> {
    match pk {
        CredentialPublicKey.Ed25519 { x } => {
            if sig.len() != 64 { return Result.Err(WebAuthnError.InvalidSignature); }
            if x.len() != 32 { return Result.Err(WebAuthnError.InvalidSignature); }
            let mut pk_arr: [Byte; 32] = [0_u8; 32];
            let mut k: Int = 0;
            while k < 32 { pk_arr[k] = x[k]; k = k + 1; }
            let mut sig_arr: [Byte; 64] = [0_u8; 64];
            let mut m: Int = 0;
            while m < 64 { sig_arr[m] = sig[m]; m = m + 1; }
            Ed25519.verify(&pk_arr, signed_input.as_slice(), &sig_arr)
                .map_err(|_| WebAuthnError.InvalidSignature)
        }
        CredentialPublicKey.EcdsaP256 { x, y } => {
            verify_ecdsa_p256(x, y, signed_input, sig)
        }
        CredentialPublicKey.Rsa { n, e, alg } => {
            verify_rsa(n, e, *alg, signed_input, sig)
        }
        _ => Result.Err(WebAuthnError.UnsupportedAlgorithm(alg_of(pk))),
    }
}

fn verify_ecdsa_p256(
    x: &List<Byte>, y: &List<Byte>,
    signed_input: &List<Byte>,
    sig: &List<Byte>,
) -> Result<(), WebAuthnError> {
    if x.len() != 32 || y.len() != 32 {
        return Result.Err(WebAuthnError.InvalidSignature);
    }
    let uncompressed = encode_p256_point(x, y);
    let pk = P256.public_key_from_bytes(uncompressed.as_slice())
        .map_err(|_| WebAuthnError.InvalidSignature)?;
    let p_sig = P256.signature_from_der(sig.as_slice())
        .map_err(|_| WebAuthnError.InvalidSignature)?;
    let digest = Sha256.digest(signed_input.as_slice());
    P256.verify_prehashed(&pk, &digest, &p_sig)
        .map_err(|_| WebAuthnError.InvalidSignature)
}

fn verify_rsa(
    n: &List<Byte>, e: &List<Byte>, alg: Int,
    signed_input: &List<Byte>,
    sig: &List<Byte>,
) -> Result<(), WebAuthnError> {
    let vk = RsaPublicKey.new(n.clone(), e.clone());
    let digest = Sha256.digest(signed_input.as_slice());
    let res = match alg {
        COSE_ALG_RS256 => verify_pkcs1_v15_prehashed(&vk, &digest[..], sig.as_slice(), RsaHash.Sha256_),
        COSE_ALG_PS256 => verify_pss_prehashed(&vk, &digest[..], sig.as_slice(), RsaHash.Sha256_, 32),
        _              => return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg)),
    };
    res.map_err(|_| WebAuthnError.InvalidSignature)
}

// =============================================================================
// Round-trip encoder
// =============================================================================

/// Re-encode a CredentialPublicKey to canonical CBOR. Useful for
/// tests + for storing the COSE_Key with deterministic bytes.
pub fn encode_cose_key(pk: &CredentialPublicKey) -> List<Byte> {
    let mut entries: List<(CborValue, CborValue)> = List.new();
    match pk {
        CredentialPublicKey.Ed25519 { x } => {
            entries.push((from_signed(1),  from_signed(COSE_KTY_OKP)));
            entries.push((from_signed(3),  from_signed(COSE_ALG_EDDSA)));
            entries.push((from_signed(-1), from_signed(COSE_CRV_ED25519)));
            entries.push((from_signed(-2), CborValue.CborBytes(x.clone())));
        }
        CredentialPublicKey.EcdsaP256 { x, y } => {
            entries.push((from_signed(1),  from_signed(COSE_KTY_EC2)));
            entries.push((from_signed(3),  from_signed(COSE_ALG_ES256)));
            entries.push((from_signed(-1), from_signed(COSE_CRV_P256)));
            entries.push((from_signed(-2), CborValue.CborBytes(x.clone())));
            entries.push((from_signed(-3), CborValue.CborBytes(y.clone())));
        }
        CredentialPublicKey.EcdsaP384 { x, y } => {
            entries.push((from_signed(1),  from_signed(COSE_KTY_EC2)));
            entries.push((from_signed(3),  from_signed(COSE_ALG_ES384)));
            entries.push((from_signed(-1), from_signed(COSE_CRV_P384)));
            entries.push((from_signed(-2), CborValue.CborBytes(x.clone())));
            entries.push((from_signed(-3), CborValue.CborBytes(y.clone())));
        }
        CredentialPublicKey.EcdsaP521 { x, y } => {
            entries.push((from_signed(1),  from_signed(COSE_KTY_EC2)));
            entries.push((from_signed(3),  from_signed(COSE_ALG_ES512)));
            entries.push((from_signed(-1), from_signed(COSE_CRV_P521)));
            entries.push((from_signed(-2), CborValue.CborBytes(x.clone())));
            entries.push((from_signed(-3), CborValue.CborBytes(y.clone())));
        }
        CredentialPublicKey.Rsa { n, e, alg } => {
            entries.push((from_signed(1),  from_signed(COSE_KTY_RSA)));
            entries.push((from_signed(3),  from_signed(*alg)));
            entries.push((from_signed(-1), CborValue.CborBytes(n.clone())));
            entries.push((from_signed(-2), CborValue.CborBytes(e.clone())));
        }
    }
    encoding.cbor.encode_canonical(&CborValue.CborMap(entries))
}

