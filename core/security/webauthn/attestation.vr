// =============================================================================
// security/webauthn/attestation.vr — attestation format verifiers
// =============================================================================
// Layer: 2 (Security primitives)
// Dependencies: core, base, encoding/cbor, security/{webauthn/{types, cose_key,
//               authenticator_data}, ecc/{p256, ed25519}, sig/rsa, hash/sha256,
//               x509}
// =============================================================================
//
// **Purpose.** Per-format verification of `attStmt` (the format-
// specific attestation statement inside an `AttestationObject`).
// Each format has its own statement structure, signed input, and
// trust model. WebAuthn L3 §8 defines:
//
//   `none`      — no attestation. Empty statement, accepted as-is.
//   `packed`    — the most common; either self-attested (signed by
//                 the credential's own private key) or x5c-chain
//                 attested (signed by a manufacturer-issued cert).
//   `fido-u2f`  — legacy CTAP1 P-256 over a custom message format.
//   `apple`     — Apple anonymous attestation (nonce extension OID
//                 1.2.840.113635.100.8.2).
//   `tpm`       — TPM 2.0 attestation (TPMT_PUBLIC + TPMS_ATTEST).
//   `android-key` — Android Keystore key attestation (extension
//                 1.3.6.1.4.1.11129.2.1.17).
//   `android-safetynet` — JWS-encoded SafetyNet response (deprecated).
//
// Packed and U2F verify the signed input. The caller checks the returned
// certificate chain against its configured trust roots. Apple, TPM and
// Android statements return InvalidAttestation. Apple requires both the
// attestation-certificate nonce and its subject key to match the request.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Per-format WebAuthn attestation verifiers (none, packed and fido-u2f)",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.security.webauthn.attestation;

mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.List;
mount core.encoding.cbor.CborValue;
mount core.security.x509.algorithm.{SignatureAlg, RsaPssParams, RsaPssHash};
mount core.security.x509.certificate.{X509Certificate, parse_certificate};
mount core.security.x509.chain.{verify_subject_signature};
mount core.security.webauthn.types.{
    AuthenticatorData, AttestationFormat,
    WebAuthnError,
    COSE_ALG_ES256, COSE_ALG_EDDSA, COSE_ALG_PS256, COSE_ALG_RS256,
};
mount core.security.webauthn.cose_key.{
    decode_cose_key_value, alg_of, verify_credential_signature, u2f_public_key,
};

// =============================================================================
// Output type
// =============================================================================

@derive(Eq, Clone, Debug)
pub type AttestationType is
    /// "Basic" — chain to manufacturer CA.
    | Basic
    /// "Self" — credential signed its own attestation.
    | SelfAtt
    /// "AnonCA" — anonymous CA (e.g., Apple).
    | AnonCa
    /// "None" — no attestation.
    | NoneAtt;

@derive(Clone, Debug)
pub type VerifiedAttestation is {
    fmt:                AttestationFormat,
    attestation_type:   AttestationType,
    /// X.509 chain (DER, leaf-first). Empty for `none` /
    /// self-attestation. Caller is responsible for chaining this
    /// to a trusted root via core.security.x509.verifier when
    /// `attestation_type = Basic` or `AnonCa`.
    trust_chain:        List<List<Byte>>,
};

// =============================================================================
// Public dispatch
// =============================================================================

/// Verify an attestation statement against authData + clientDataHash.
/// Returns `VerifiedAttestation` describing the trust model + chain
/// (when present). Caller validates the chain externally.
pub fn verify_attestation(
    fmt:                &AttestationFormat,
    att_stmt:           &CborValue,
    auth_data:          &AuthenticatorData,
    client_data_hash:   &[Byte],
) -> Result<VerifiedAttestation, WebAuthnError> {
    if client_data_hash.len() != 32 {
        return Result.Err(WebAuthnError.InvalidAttestation("clientDataHash must contain 32 bytes".to_text()));
    }
    match fmt {
        AttestationFormat.None_   => verify_none(att_stmt),
        AttestationFormat.Packed  => verify_packed(att_stmt, auth_data, client_data_hash),
        AttestationFormat.FidoU2f => verify_fido_u2f(att_stmt, auth_data, client_data_hash),
        AttestationFormat.Apple   => Result.Err(WebAuthnError.InvalidAttestation(
            "apple attestation requires certificate nonce and credential key verification".to_text())),
        AttestationFormat.Tpm | AttestationFormat.AndroidKey | AttestationFormat.AndroidSafetynet
        | AttestationFormat.AppleAppAttest =>
            Result.Err(WebAuthnError.InvalidAttestation(f"fmt {fmt} not supported in v0.1")),
        AttestationFormat.Other(s) =>
            Result.Err(WebAuthnError.InvalidAttestation(f"unknown fmt {s}")),
    }
}

// =============================================================================
// `none` — empty stmt
// =============================================================================

fn verify_none(att_stmt: &CborValue) -> Result<VerifiedAttestation, WebAuthnError> {
    // Per WebAuthn §8.7: attStmt MUST be empty for fmt=none.
    let map = att_stmt.as_map()
        .ok_or(WebAuthnError.InvalidAttestation("none: attStmt not a map".to_text()))?;
    if !map.is_empty() {
        return Result.Err(WebAuthnError.InvalidAttestation("none: attStmt must be empty".to_text()));
    }
    Result.Ok(VerifiedAttestation {
        fmt:              AttestationFormat.None_,
        attestation_type: AttestationType.NoneAtt,
        trust_chain:      List.new(),
    })
}

// =============================================================================
// `packed` — most common modern attestation
// =============================================================================
//
// Spec (WebAuthn §8.2):
//
//   attStmt .= {
//     "alg":  <COSE alg>,
//     "sig":  <bytes — signature over (authData || clientDataHash)>,
//     "x5c":  <optional — array of DER-encoded X.509 certs leaf-first>
//   }
//
// Verification:
//   - Compute signed bytes = authData_raw || clientDataHash.
//   - If x5c present: verify sig with x5c[0]'s SPKI, attestation_type=Basic.
//     Caller chains x5c[0]..x5c[n-1] against a trusted root.
//   - Else (self-attestation): verify sig with the credential's own
//     COSE_Key. attestation_type=SelfAtt.

fn verify_packed(
    att_stmt:         &CborValue,
    auth_data:        &AuthenticatorData,
    client_data_hash: &[Byte],
) -> Result<VerifiedAttestation, WebAuthnError> {
    let map = att_stmt.as_map()
        .ok_or(WebAuthnError.InvalidAttestation("packed: attStmt not a map".to_text()))?;
    let alg = get_text_keyed_int(&map, &"alg")
        .ok_or(WebAuthnError.InvalidAttestation("packed: alg missing".to_text()))?;
    let sig = get_text_keyed_bytes(&map, &"sig")
        .ok_or(WebAuthnError.InvalidAttestation("packed: sig missing".to_text()))?;

    let signed_input = concat_bytes(auth_data.signed_bytes(), client_data_hash);

    // x5c (optional)
    if let Maybe.Some(x5c_chain) = get_text_keyed_x5c(&map, &"x5c")? {
        // Basic attestation: verify with leaf cert's SPKI.
        verify_packed_with_x5c(alg, &sig, &signed_input, &x5c_chain[0])?;
        Result.Ok(VerifiedAttestation {
            fmt:              AttestationFormat.Packed,
            attestation_type: AttestationType.Basic,
            trust_chain:      x5c_chain,
        })
    } else {
        // Self-attestation: verify with credential's own COSE_Key.
        let acd = auth_data.attested_credential()
            .ok_or(WebAuthnError.InvalidAttestation(
                "packed self-att requires attested credential data".to_text()))?;
        let cred_pk = decode_cose_key_value(acd.key_value())?;
        if alg_of(&cred_pk) != alg {
            return Result.Err(WebAuthnError.InvalidAttestation(
                f"packed self-att alg mismatch (cose={alg_of(&cred_pk)}, attStmt={alg})"));
        }
        verify_credential_signature(&cred_pk, &signed_input, &sig)?;
        Result.Ok(VerifiedAttestation {
            fmt:              AttestationFormat.Packed,
            attestation_type: AttestationType.SelfAtt,
            trust_chain:      List.new(),
        })
    }
}

fn verify_packed_with_x5c(
    alg:          Int,
    sig:          &List<Byte>,
    signed_input: &List<Byte>,
    leaf_der:     &List<Byte>,
) -> Result<(), WebAuthnError> {
    let leaf = parse_certificate(leaf_der.as_slice())
        .map_err(|e| WebAuthnError.InvalidAttestation(f"x5c[0] parse: {e}"))?;
    verify_certificate_signature(alg, sig, signed_input, &leaf)
}

// =============================================================================
// `fido-u2f` — legacy CTAP1
// =============================================================================
//
// Spec (WebAuthn §8.6):
//
//   attStmt .= {
//     "x5c": <array — must contain exactly 1 cert>,
//     "sig": <bytes — ECDSA-P-256 signature>
//   }
//
//   verification_data = 0x00 || rpIdHash || clientDataHash ||
//                       credentialId || raw_pubkey (0x04 || X || Y)
//
//   Verify sig with x5c[0]'s SPKI (must be P-256).

fn verify_fido_u2f(
    att_stmt:         &CborValue,
    auth_data:        &AuthenticatorData,
    client_data_hash: &[Byte],
) -> Result<VerifiedAttestation, WebAuthnError> {
    let map = att_stmt.as_map()
        .ok_or(WebAuthnError.InvalidAttestation("fido-u2f: attStmt not a map".to_text()))?;
    let sig = get_text_keyed_bytes(&map, &"sig")
        .ok_or(WebAuthnError.InvalidAttestation("fido-u2f: sig missing".to_text()))?;
    let x5c = get_text_keyed_x5c(&map, &"x5c")?
        .ok_or(WebAuthnError.InvalidAttestation("fido-u2f: missing x5c".to_text()))?;
    if x5c.len() != 1 {
        return Result.Err(WebAuthnError.InvalidAttestation(
            f"fido-u2f: x5c must have exactly 1 cert, got {x5c.len()}"));
    }
    let acd = auth_data.attested_credential()
        .ok_or(WebAuthnError.InvalidAttestation(
            "fido-u2f requires attested credential data".to_text()))?;
    let cred_pk = decode_cose_key_value(acd.key_value())?;
    let point = u2f_public_key(&cred_pk)?;
    let mut verification_data: List<Byte> = List.new();
    verification_data.push(0_u8);
    verification_data.extend_from_slice(&auth_data.relying_party_hash()[..]);
    verification_data.extend_from_slice(client_data_hash);
    verification_data.extend_from_slice(acd.id_bytes());
    verification_data.extend_from_slice(point.as_slice());

    let leaf = parse_certificate(x5c[0].as_slice())
        .map_err(|e| WebAuthnError.InvalidAttestation(f"fido-u2f x5c parse: {e}"))?;
    verify_certificate_signature(COSE_ALG_ES256, &sig, &verification_data, &leaf)?;

    Result.Ok(VerifiedAttestation {
        fmt:              AttestationFormat.FidoU2f,
        attestation_type: AttestationType.Basic,
        trust_chain:      x5c,
    })
}

fn verify_certificate_signature(
    alg: Int, signature: &List<Byte>, message: &List<Byte>, certificate: &X509Certificate,
) -> Result<(), WebAuthnError> {
    let algorithm = match alg {
        COSE_ALG_EDDSA => SignatureAlg.Ed25519Sig,
        COSE_ALG_ES256 => SignatureAlg.EcdsaWithSha256,
        COSE_ALG_RS256 => SignatureAlg.Sha256WithRsa,
        COSE_ALG_PS256 => SignatureAlg.RsaPss(RsaPssParams.digest_length_salt(RsaPssHash.Sha256Hash)),
        _ => return Result.Err(WebAuthnError.UnsupportedAlgorithm(alg)),
    };
    verify_subject_signature(certificate, &algorithm, message.as_slice(), signature.as_slice())
        .map_err(|_| WebAuthnError.InvalidSignature)
}

// =============================================================================
// Helpers — text-keyed CBOR map lookups
// =============================================================================

fn get_text_keyed_int(map: &List<(CborValue, CborValue)>, key: &Text) -> Maybe<Int> {
    let mut i: Int = 0;
    while i < map.len() {
        let (k, v) = &map[i];
        if let Maybe.Some(s) = k.as_text() {
            if s == *key { return v.as_int(); }
        }
        i = i + 1;
    }
    Maybe.None
}

fn get_text_keyed_bytes(map: &List<(CborValue, CborValue)>, key: &Text) -> Maybe<List<Byte>> {
    let mut i: Int = 0;
    while i < map.len() {
        let (k, v) = &map[i];
        if let Maybe.Some(s) = k.as_text() {
            if s == *key { return v.as_bytes(); }
        }
        i = i + 1;
    }
    Maybe.None
}

fn get_text_keyed_x5c(map: &List<(CborValue, CborValue)>, key: &Text)
    -> Result<Maybe<List<List<Byte>>>, WebAuthnError> {
    for (k, v) in map.iter() {
        if let Maybe.Some(s) = k.as_text() {
            if s == *key {
                let entries = v.as_array().ok_or(WebAuthnError.InvalidAttestation("x5c must be an array".to_text()))?;
                if entries.is_empty() {
                    return Result.Err(WebAuthnError.InvalidAttestation("x5c must contain a certificate".to_text()));
                }
                let mut chain: List<List<Byte>> = List.with_capacity(entries.len());
                for cert in entries.iter() {
                    chain.push(cert.as_bytes().ok_or(WebAuthnError.InvalidAttestation("x5c requires DER bytes".to_text()))?);
                }
                return Result.Ok(Maybe.Some(chain));
            }
        }
    }
    Result.Ok(Maybe.None)
}

fn concat_bytes(a: &[Byte], b: &[Byte]) -> List<Byte> {
    let mut out: List<Byte> = List.with_capacity(a.len() + b.len());
    let mut i: Int = 0;
    while i < a.len() { out.push(a[i]); i = i + 1; }
    let mut j: Int = 0;
    while j < b.len() { out.push(b[j]); j = j + 1; }
    out
}

