// =============================================================================
// core/security/x509/credential.vr — certificate and private-key types
// =============================================================================
// Layer: 5 (security)
// Dependencies: core.collections.list, core.encoding, core.security.x509.algorithm
// =============================================================================
//

// The credential artefacts themselves: a DER-encoded certificate, a
// DER-encoded private key, and the key's algorithm.
//

// They were defined in `core/net/tls.vr` until the ring law measured
// the consequence: `core.security.spiffe.svid`, which is an X.509 SVID
// and needs nothing from the network, had to mount `core.net.tls` to
// name a certificate — the security stack depending on the network
// stack for its own vocabulary. TLS transports and validates these; it
// does not own them.
//

// `core.net.tls` re-exports all three, so existing spellings keep
// working.
//

// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Definition
)
module core.security.x509.credential;

mount core.collections.list.{List};
mount core.encoding.der.{DerReader};
mount core.encoding.pem.{PemReader, PemError};
mount core.security.x509.algorithm.{parse_public_key_alg, PublicKeyAlg};

/// Failures while decoding certificate or private-key credential material.
/// Transport protocols map these values into their own error types.
public type CredentialError is InvalidCertificate(Text) | InvalidKey(Text);

fn certificate_pem_error(error: PemError) -> CredentialError {
    CredentialError.InvalidCertificate(f"{error}")
}

fn key_pem_error(error: PemError) -> CredentialError {
    CredentialError.InvalidKey(f"{error}")
}

implement Describable for CredentialError {
    fn description(&self) -> Text {
        match self {
            CredentialError.InvalidCertificate(message) => f"invalid certificate: {message}",
            CredentialError.InvalidKey(message) => f"invalid private key: {message}",
        }
    }
}

implement Display for CredentialError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(self.description().as_str())
    }
}

implement Debug for CredentialError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            CredentialError.InvalidCertificate(message) => f.write_str(f"CredentialError.InvalidCertificate({message})"),
            CredentialError.InvalidKey(message) => f.write_str(f"CredentialError.InvalidKey({message})"),
        }
    }
}

implement PartialEq for CredentialError {
    fn eq(&self, other: &CredentialError) -> Bool {
        match (self, other) {
            (CredentialError.InvalidCertificate(left), CredentialError.InvalidCertificate(right)) => left == right,
            (CredentialError.InvalidKey(left), CredentialError.InvalidKey(right)) => left == right,
            _ => false,
        }
    }
}

implement Eq for CredentialError {}

// =============================================================================
// Certificate Types
// =============================================================================

/// An X.509 certificate in DER (binary) format.
public type Certificate is {
    /// DER-encoded certificate data.
    der_data: List<Byte>,
};

implement Certificate {
    /// Create a certificate from DER-encoded bytes.
    public fn from_der(data: List<Byte>) -> Certificate {
        Certificate { der_data: data }
    }

    /// Parse a PEM-encoded certificate string.
    ///

    /// Expects the standard PEM format:
    /// ```
    /// -----BEGIN CERTIFICATE-----
    /// <base64 data>
    /// -----END CERTIFICATE-----
    /// ```
    public fn from_pem(pem: &Text) -> Result<Certificate, CredentialError> {
        let mut reader = PemReader.new(pem).map_err(certificate_pem_error)?;
        next_certificate(&mut reader)?
            .ok_or(CredentialError.InvalidCertificate("missing BEGIN CERTIFICATE marker"))
    }

    /// Parse multiple PEM-encoded certificates from a single string.
    public fn from_pem_chain(pem: &Text) -> Result<List<Certificate>, CredentialError> {
        let mut reader = PemReader.new(pem).map_err(certificate_pem_error)?;
        let mut certs: List<Certificate> = [];
        while let Maybe.Some(cert) = next_certificate(&mut reader)? {
            certs.push(cert);
        }

        if certs.is_empty() {
            return Err(CredentialError.InvalidCertificate("no certificates found in PEM data"));
        }

        Ok(certs)
    }

    /// Get the DER-encoded data.
    public fn der_bytes(&self) -> &[Byte] {
        self.der_data.as_slice()
    }

    /// Get the size of the certificate in bytes.
    public fn size(&self) -> Int {
        self.der_data.len()
    }
}

fn next_certificate(reader: &mut PemReader) -> Result<Maybe<Certificate>, CredentialError> {
    while let Maybe.Some(block) = reader.next_block().map_err(certificate_pem_error)? {
        if block.label == "CERTIFICATE" {
            return Ok(Maybe.Some(Certificate.from_der(block.contents)));
        }
    }
    Ok(Maybe.None)
}

implement Clone for Certificate {
    fn clone(&self) -> Certificate {
        Certificate { der_data: self.der_data.clone() }
    }
}

implement Debug for Certificate {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(f"Certificate({self.der_data.len()} bytes)")
    }
}

// =============================================================================
// Private Key
// =============================================================================

/// A private key for TLS authentication.
public type PrivateKey is {
    /// DER-encoded key data.
    der_data: List<Byte>,
    /// Key type (RSA, EC, Ed25519).
    key_type: KeyType,
};

/// Private key algorithm type.
public type KeyType is
    | Rsa
    | Ec
    | Ed25519;

implement KeyType {
    public fn as_str(&self) -> Text {
        match self {
            Rsa => "RSA",
            Ec => "EC",
            Ed25519 => "Ed25519",
        }
    }
}

implement PartialEq for KeyType {
    fn eq(&self, other: &KeyType) -> Bool {
        self.as_str() == other.as_str()
    }
}

implement Eq for KeyType {}

implement Clone for KeyType {
    fn clone(&self) -> KeyType { *self }
}

implement Copy for KeyType {}

implement Debug for KeyType {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(self.as_str())
    }
}

implement PrivateKey {
    /// Create a private key from DER-encoded bytes.
    public fn from_der(data: List<Byte>, key_type: KeyType) -> PrivateKey {
        PrivateKey { der_data: data, key_type: key_type }
    }

    /// Parse a PEM-encoded private key.
    ///
    /// The PEM header decides only for the two legacy formats, which
    /// name their algorithm in the banner: `RSA PRIVATE KEY` is PKCS#1
    /// and `EC PRIVATE KEY` is SEC1. A plain `PRIVATE KEY` banner is
    /// PKCS#8, which says nothing about the algorithm — the DER does,
    /// in its `privateKeyAlgorithm` field. This used to default such a
    /// key to `Rsa`, so every modern P-256 or Ed25519 key (PKCS#8 is
    /// what `openssl genpkey` and every ACME client emit) was labelled
    /// RSA and would have been signed with the wrong scheme.
    public fn from_pem(pem: &Text) -> Result<PrivateKey, CredentialError> {
        let mut reader = PemReader.new(pem).map_err(key_pem_error)?;
        while let Maybe.Some(block) = reader.next_block().map_err(key_pem_error)? {
            let key_type = match block.label.as_str() {
                "RSA PRIVATE KEY" => KeyType.Rsa,
                "EC PRIVATE KEY" => KeyType.Ec,
                "PRIVATE KEY" => pkcs8_key_type(block.contents.as_slice())?,
                _ => continue,
            };
            return Ok(PrivateKey.from_der(block.contents, key_type));
        }
        Err(CredentialError.InvalidKey("unrecognized PEM key format"))
    }

    /// Get the key type.
    public fn key_type(&self) -> KeyType {
        self.key_type
    }
}

/// The algorithm of a PKCS#8 `PrivateKeyInfo` (RFC 5208 §5):
///
/// ```text
/// PrivateKeyInfo is a SEQUENCE of
///     version                 INTEGER,
///     privateKeyAlgorithm     AlgorithmIdentifier,
///     privateKey              OCTET STRING,
///     attributes          [0] IMPLICIT Attributes OPTIONAL
/// ```
/// (spelled without ASN.1's assignment arrow, which `check-vr-syntax`
/// forbids in a .vr source, comments included.)
///
/// Only the first two fields are read. `AlgorithmIdentifier` is the
/// same structure SPKI carries, so `parse_public_key_alg` is the
/// authority for it rather than a second OID table here.
fn pkcs8_key_type(der: &[Byte]) -> Result<KeyType, CredentialError> {
    let mut reader = DerReader.new(der);
    let mut seq = reader.read_sequence()
        .map_err(|e| CredentialError.InvalidKey(f"PKCS#8: not a SEQUENCE: {e}"))?;
    let _version = seq.read_int64()
        .map_err(|e| CredentialError.InvalidKey(f"PKCS#8: no version: {e}"))?;
    let alg = parse_public_key_alg(&mut seq)
        .map_err(|e| CredentialError.InvalidKey(f"PKCS#8: bad algorithm: {e}"))?;

    match alg {
        PublicKeyAlg.RsaEncryption  => Ok(KeyType.Rsa),
        PublicKeyAlg.EcPublicKey(_) => Ok(KeyType.Ec),
        PublicKeyAlg.Ed25519Key     => Ok(KeyType.Ed25519),
        // X25519 and X448 are key-agreement keys and cannot sign;
        // Ed448 has no signer here. Naming them beats labelling them
        // RSA and failing later inside a handshake.
        _ => Err(CredentialError.InvalidKey(
            "PKCS#8: key algorithm is not one this build can use for TLS")),
    }
}

implement Clone for PrivateKey {
    fn clone(&self) -> PrivateKey {
        PrivateKey {
            der_data: self.der_data.clone(),
            key_type: self.key_type,
        }
    }
}

implement Debug for PrivateKey {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> {
        f.write_str(f"PrivateKey({self.key_type.as_str()}, {self.der_data.len()} bytes)")
    }
}
