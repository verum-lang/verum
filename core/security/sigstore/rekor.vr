// =============================================================================
// security/sigstore/rekor.vr — Rekor v1 transparency log client
// =============================================================================
// Layer: 2 (Security primitives)
// Dependencies: core, base, collections, encoding/{json, base64, hex, jcs},
//               security/{ecc/p256, hash/sha256, sigstore/types},
//               net/http, time/system_time
// =============================================================================
//
// **Purpose.** Submit + fetch + verify entries on rekor.sigstore.dev
// (or self-hosted Rekor instances) v1 API. The protocol surface is
// JSON-over-HTTP; the cryptographic guarantees ride on top via the
// SET (Signed Entry Timestamp).
//
// **Implemented endpoints (Rekor v1 API).**
//
//   POST /api/v1/log/entries           — submit entry
//   GET  /api/v1/log/entries/{uuid}     — fetch by UUID
//   GET  /api/v1/log/entries?logIndex=N — fetch by index
//
// **SET verification (RFC-style note tooling).**
//
// The SET signs the canonical JSON `{body, integratedTime, logID,
// logIndex}`. Rekor uses ECDSA-P-256 with SHA-256. Verification:
//
//   message = JCS({"body":<b64>,"integratedTime":<n>,
//                  "logID":<hex>,"logIndex":<n>})
//   verify(rekor_pubkey, SHA-256(message), set_signature)
//
// **Inclusion proofs.** Rekor's Merkle tree is RFC 6962-shaped
// (binary tree with domain-separated leaf vs node hashes). The
// inclusion proof is verified by recomputing the root hash from the
// leaf + audit hashes; we delegate to
// `core.security.merkle.verify_inclusion_proof`. The SET alone
// does not establish inclusion or consistency between checkpoints.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Rekor v1 transparency log client: submit + fetch + SET verify + inclusion proof",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.security.sigstore.rekor;

mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.{List, Map};
mount core.encoding.json.{
    JsonValue, JsonMap, json_object, json_string, json_int,
    json_array, decode_bytes_strict, encode,
};
mount core.encoding.base64;
mount core.security.merkle.{InclusionProof, verify_inclusion_proof as verify_merkle_path};
mount core.encoding.hex.{encode as hex_encode, decode as hex_decode};
mount core.encoding.jcs.{canonicalize};
mount core.security.sigstore.entry_id.{RekorEntryId, RekorEntryBodyError, RekorEnvelopeError, take_response_entry};
mount core.net.http.{HttpClient, Request, Response, StatusCode, HttpError};
mount core.security.ecc.p256.{P256, P256PublicKey, P256Signature};
mount core.hash.crypto.sha256.{Sha256};
mount core.security.sigstore.types.{
    EntryKind, ApiVersion, EntryBody, HashedRekordBody, IntotoBody, DsseBody,
    IntotoEnvelopeRef, EnvelopeSignature,
    LogEntry, SignedEntryTimestamp, RekorInclusionProof, Digest,
    entry_kind_to_text, validate_digest, http_error_body,
    REKOR_PUBLIC_URL,
};

// =============================================================================
// Constants
// =============================================================================

public const MAX_ENTRY_RESPONSE_BYTES: Int = 16 * 1024 * 1024; // 16 MiB
public const CONTENT_TYPE_JSON: Text = "application/json";

// =============================================================================
// Configuration
// =============================================================================

@derive(Clone, Debug)
public type RekorClientConfig is {
    /// Rekor base URL — typically https://rekor.sigstore.dev.
    base_url:           Text,
    /// Rekor instance's public key (ECDSA-P-256, raw uncompressed
    /// 65-byte form 0x04 || X || Y). This pin is the trust anchor
    /// for SET verification — sourced from TUF metadata in production.
    log_public_key:     P256PublicKey,
    /// Hex-encoded SHA-256 of the public key — the `logID` field
    /// found on every LogEntry. Disambiguates log instances.
    log_id_hex:         Text,
};

// =============================================================================
// Errors
// =============================================================================

public type RekorError is
    | NetworkError(HttpError)
    | HttpStatus { status: StatusCode, body: Text }
    | TooLarge { size: Int, limit: Int }
    | InvalidJson(Text)
    | InvalidBase64(Text)
    | InvalidEntry(Text)
    | InvalidDigest(Text)
    | LogIdMismatch { expected: Text, found: Text }
    | SetSignatureFailed
    | UnknownEntryKind(Text);

implement Display for RekorError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            NetworkError(e)              => f.write_str(f"rekor: network: {e}".as_str()),
            HttpStatus { status, body }  => f.write_str(f"rekor: HTTP {status} body={body}".as_str()),
            TooLarge { size, limit }     => f.write_str(f"rekor: response too large ({size} > {limit})".as_str()),
            InvalidJson(reason)          => f.write_str(f"rekor: invalid JSON: {reason}".as_str()),
            InvalidBase64(reason)        => f.write_str(f"rekor: invalid base64: {reason}".as_str()),
            InvalidEntry(reason)         => f.write_str(f"rekor: invalid entry: {reason}".as_str()),
            InvalidDigest(reason)        => f.write_str(f"rekor: invalid digest: {reason}".as_str()),
            LogIdMismatch { expected, found } => f.write_str(
                f"rekor: log id mismatch (expected {expected}, found {found})".as_str()),
            SetSignatureFailed           => f.write_str("rekor: SET signature verification failed"),
            UnknownEntryKind(kind)       => f.write_str(f"rekor: unknown entry kind: {kind}".as_str()),
        }
    }
}

implement Debug for RekorError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { self.fmt(f) }
}

// =============================================================================
// Submit entry
// =============================================================================

/// POST a new entry to Rekor. The caller supplies the entry kind +
/// API version + spec body (as JSON). Returns the assigned LogEntry
/// with a verified SET.
///
/// **Note.** The spec body's exact shape depends on the entry kind
/// — see types.vr docstrings for HashedRekord/Intoto/DSSE schemas.
public async fn submit_entry<C: HttpClient>(
    client:  &C,
    config:  &RekorClientConfig,
    kind:    &EntryKind,
    api_ver: &ApiVersion,
    spec:    &JsonValue,
) -> Result<LogEntry, RekorError> {
    let url = compose_url(&config.base_url, "/api/v1/log/entries");
    let req = Request.post(url)
        .header(&"accept", &CONTENT_TYPE_JSON)
        .header(&"user-agent", &"verum-rekor/0.1")
        .body_json(encode_submit_body(kind, api_ver, spec));
    let body = send_entry_request(client, req).await?;
    parse_verified_entry(&body, config, Maybe.None)
}

fn encode_submit_body(kind: &EntryKind, api_ver: &ApiVersion, spec: &JsonValue) -> Text {
    let kind_json = encode(&json_string(entry_kind_to_text(kind)));
    let version_json = encode(&json_string(api_ver.0.clone()));
    let spec_json = encode(spec);
    f"{{\"kind\":{kind_json},\"apiVersion\":{version_json},\"spec\":{spec_json}}}"
}

// =============================================================================
// Fetch by UUID / index
// =============================================================================

public async fn fetch_entry_by_uuid<C: HttpClient>(
    client: &C,
    config: &RekorClientConfig,
    uuid:   &Text,
) -> Result<LogEntry, RekorError> {
    let requested = match RekorEntryId.parse(uuid) {
        Maybe.Some(id) => id,
        Maybe.None => return Result.Err(RekorError.InvalidEntry("expected a hexadecimal entry UUID")),
    };
    let url = compose_url(&config.base_url, &f"/api/v1/log/entries/{uuid}");
    fetch_entry_at_url(client, config, &url, Maybe.Some(requested)).await
}

public async fn fetch_entry_by_log_index<C: HttpClient>(
    client: &C,
    config: &RekorClientConfig,
    log_index: Int,
) -> Result<LogEntry, RekorError> {
    if log_index < 0 { return Result.Err(InvalidEntry("negative log index".to_text())); }
    let url = compose_url(
        &config.base_url,
        &f"/api/v1/log/entries?logIndex={log_index}",
    );
    let entry = fetch_entry_at_url(client, config, &url, Maybe.None).await?;
    if entry.log_index != log_index {
        return Result.Err(InvalidEntry("response log index differs from request".to_text()));
    }
    Result.Ok(entry)
}

async fn fetch_entry_at_url<C: HttpClient>(
    client: &C,
    config: &RekorClientConfig,
    url: &Text,
    requested: Maybe<RekorEntryId>,
) -> Result<LogEntry, RekorError> {
    let req = Request.get(url.clone())
        .header(&"accept", &CONTENT_TYPE_JSON)
        .header(&"user-agent", &"verum-rekor/0.1");
    let body = send_entry_request(client, req).await?;
    parse_verified_entry(&body, config, requested)
}

async fn send_entry_request<C: HttpClient>(
    client: &C,
    request: Request,
) -> Result<List<Byte>, RekorError> {
    let response: Response = match client.send(request).await {
        Result.Ok(reply) => reply,
        Result.Err(error) => return Result.Err(RekorError.NetworkError(error)),
    };
    let status = response.status_code();
    let body = response.into_body();
    if !status.is_success() {
        return Result.Err(RekorError.HttpStatus { status, body: http_error_body(body.as_slice()) });
    }
    let size = body.len();
    if size > MAX_ENTRY_RESPONSE_BYTES {
        return Result.Err(RekorError.TooLarge { size, limit: MAX_ENTRY_RESPONSE_BYTES });
    }
    Result.Ok(body)
}

fn parse_verified_entry(body: &List<Byte>, config: &RekorClientConfig, requested: Maybe<RekorEntryId>) -> Result<LogEntry, RekorError> {
    let entry = parse_matching_response(body, requested)?;
    verify_entry_set(&entry, config)?;
    Result.Ok(entry)
}

// =============================================================================
// SET verification
// =============================================================================

/// Verify the Signed Entry Timestamp on `entry` using
/// `config.log_public_key`. Validates `log_id` first to catch
/// log-instance confusion.
///
/// Verification is byte-exact: we reconstruct the canonical JSON
/// the SET signed over from the typed fields, JCS-canonicalise,
/// SHA-256 hash, then ECDSA-verify.
public fn verify_entry_set(
    entry: &LogEntry,
    config: &RekorClientConfig,
) -> Result<(), RekorError> {
    if entry.log_id_hex != config.log_id_hex {
        return Result.Err(RekorError.LogIdMismatch {
            expected: config.log_id_hex.clone(),
            found:    entry.log_id_hex.clone(),
        });
    }
    let payload = build_set_payload(entry);
    let payload_bytes = match canonicalize(&payload) {
        Result.Ok(bytes) => bytes,
        Result.Err(error) => return Result.Err(RekorError.InvalidJson(f"jcs: {error}")),
    };
    let digest = Sha256.digest(payload_bytes.as_slice());
    let sig_bytes = decode_nonempty_base64(&entry.set.signature_b64, &"SET signature")?;
    let sig = match P256.signature_from_der(sig_bytes.as_slice()) {
        Result.Ok(sig) => sig,
        Result.Err(_) => return Result.Err(RekorError.InvalidEntry("malformed SET ECDSA signature")),
    };
    match P256.verify_prehashed(&config.log_public_key, &digest, &sig) {
        Result.Ok(())  => Result.Ok(()),
        Result.Err(_)  => Result.Err(SetSignatureFailed),
    }
}

fn build_set_payload(entry: &LogEntry) -> JsonValue {
    let mut obj: JsonMap = JsonMap.new();
    obj.insert("body".to_text(), json_string(entry.body_b64.clone()));
    obj.insert("integratedTime".to_text(), json_int(entry.integrated_time));
    obj.insert("logID".to_text(), json_string(entry.log_id_hex.clone()));
    obj.insert("logIndex".to_text(), json_int(entry.log_index));
    json_object(obj)
}

// =============================================================================
// Inclusion proof verification
// =============================================================================
//
// Per RFC 6962 §2.1.1: leaf hash = SHA-256(0x00 || leaf_data),
// node hash = SHA-256(0x01 || left || right). The inclusion proof
// gives the audit hashes that recompute the root.

/// Check the exact audit path against the declared root. The caller must
/// authenticate the root and tree size against its trusted checkpoint.
/// The proof index is shard-local; the SET's log index may be virtual across
/// shards. This checks membership, not their separate shard-range mapping.
public fn verify_inclusion_proof(entry: &LogEntry) -> Result<(), RekorError> {
    let proof = match &entry.inclusion_proof {
        Maybe.Some(p) => p,
        Maybe.None => return Result.Err(InvalidEntry("entry lacks inclusion proof".to_text())),
    };
    if proof.log_index < 0 || proof.tree_size <= proof.log_index {
        return Result.Err(InvalidEntry("inclusion-proof: invalid leaf position".to_text()));
    }
    let body = decode_nonempty_base64(&entry.body_b64, &"entry body")?;
    let root = decode_merkle_hash(&proof.root_hash)?;
    let mut siblings: List<[Byte; 32]> = [];
    for encoded in proof.hashes_hex.iter() { siblings.push(decode_merkle_hash(encoded)?); }
    let path = InclusionProof.from_siblings(siblings);
    if !verify_merkle_path(body.as_slice(), proof.log_index, proof.tree_size, &path, &root) {
        return Result.Err(InvalidEntry("inclusion-proof: invalid path".to_text()));
    }
    Result.Ok(())
}

fn decode_merkle_hash(encoded: &Text) -> Result<[Byte; 32], RekorError> {
    if encoded.len() != 64 { return Result.Err(InvalidEntry("expected a 32-byte SHA-256 hash".to_text())); }
    let bytes = match hex_decode(encoded) {
        Result.Ok(bytes) => bytes,
        Result.Err(_) => return Result.Err(RekorError.InvalidEntry("invalid hexadecimal hash")),
    };
    let mut hash: [Byte; 32] = [0_u8; 32];
    for i in 0..32 { hash[i] = bytes[i]; }
    Result.Ok(hash)
}

// =============================================================================
// Response parsing
// =============================================================================

/// Decode a single log response. This does not verify its SET or checkpoint.
public fn parse_log_entry_response(bytes: &List<Byte>) -> Result<LogEntry, RekorError> {
    parse_matching_response(bytes, Maybe.None)
}

fn parse_matching_response(bytes: &List<Byte>, requested: Maybe<RekorEntryId>) -> Result<LogEntry, RekorError> {
    let value = match decode_bytes_strict(bytes.as_slice(), MAX_ENTRY_RESPONSE_BYTES) {
        Result.Ok(value) => value,
        Result.Err(error) => return Result.Err(RekorError.InvalidJson(f"{error}")),
    };
    let (uuid, id, entry) = match take_response_entry(value, requested) {
        Result.Ok(parts) => parts,
        Result.Err(RekorEnvelopeError.NotAnObject) => return Result.Err(RekorError.InvalidJson("response not an object")),
        Result.Err(RekorEnvelopeError.WrongEntryCount) => return Result.Err(RekorError.InvalidJson("expected exactly one log entry")),
        Result.Err(RekorEnvelopeError.InvalidId) => return Result.Err(RekorError.InvalidEntry("invalid response UUID")),
        Result.Err(RekorEnvelopeError.MismatchedId) => return Result.Err(RekorError.InvalidEntry("response UUID differs from request")),
    };
    parse_log_entry(uuid, &id, entry)
}

fn parse_log_entry(uuid: Text, id: &RekorEntryId, value: JsonValue) -> Result<LogEntry, RekorError> {
    let obj = value.as_object().ok_or(RekorError.InvalidJson("entry must be an object"))?;
    let body_b64 = required_text(obj, &"body")?;
    let integrated_time = required_int(obj, &"integratedTime")?;
    let log_id_hex = required_text(obj, &"logID")?;
    let log_index = required_int(obj, &"logIndex")?;
    if integrated_time < 0 || log_index < 0 {
        return Result.Err(RekorError.InvalidEntry("negative log position or integration time"));
    }
    decode_merkle_hash(&log_id_hex)?;
    let verification = required_object(obj, &"verification")?;
    let set_b64 = required_text(&verification, &"signedEntryTimestamp")?;
    decode_nonempty_base64(&set_b64, &"signedEntryTimestamp")?;
    let inclusion_proof = match verification.get("inclusionProof") {
        Maybe.Some(proof) => Maybe.Some(parse_inclusion_proof(&proof)?),
        Maybe.None => Maybe.None,
    };

    let body_bytes = match id.decode_body(&body_b64) {
        Result.Ok(bytes) => bytes,
        Result.Err(RekorEntryBodyError.InvalidBase64(error)) => return Result.Err(RekorError.InvalidBase64(f"body: {error}")),
        Result.Err(RekorEntryBodyError.LeafMismatch) => return Result.Err(RekorError.InvalidEntry("UUID does not identify the returned body")),
    };
    let body_value = match decode_bytes_strict(body_bytes.as_slice(), MAX_ENTRY_RESPONSE_BYTES) {
        Result.Ok(value) => value,
        Result.Err(error) => return Result.Err(RekorError.InvalidJson(f"body json: {error}")),
    };
    let body = decode_entry_body(body_value)?;
    Result.Ok(LogEntry {
        uuid, body_b64, body, integrated_time, log_id_hex, log_index,
        set: SignedEntryTimestamp { signature_b64: set_b64 }, inclusion_proof,
    })
}

fn parse_inclusion_proof(value: &JsonValue) -> Result<RekorInclusionProof, RekorError> {
    let obj = value.as_object().ok_or(RekorError.InvalidJson("inclusionProof must be an object"))?;
    let log_index = required_int(obj, &"logIndex")?;
    let tree_size = required_int(obj, &"treeSize")?;
    if log_index < 0 || tree_size <= log_index {
        return Result.Err(RekorError.InvalidEntry("invalid inclusion proof position"));
    }
    let root_hash = required_text(obj, &"rootHash")?;
    decode_merkle_hash(&root_hash)?;
    let hashes = required_array(obj, &"hashes")?;
    let mut hashes_hex: List<Text> = List.with_capacity(hashes.len());
    for hash in hashes.iter() {
        let encoded = hash.as_string().ok_or(RekorError.InvalidEntry("audit hash must be a string"))?;
        decode_merkle_hash(&encoded)?;
        hashes_hex.push(encoded);
    }
    let checkpoint = optional_text(obj, &"checkpoint")?;
    Result.Ok(RekorInclusionProof { log_index, tree_size, root_hash, hashes_hex, checkpoint })
}

/// Decode a known canonical Rekor body or retain every field of an unknown schema.
public fn decode_entry_body(value: JsonValue) -> Result<EntryBody, RekorError> {
    let fields = value.as_object().ok_or(RekorError.InvalidJson("entry body must be an object"))?;
    let kind = required_text(fields, &"kind")?;
    let version = required_text(fields, &"apiVersion")?;
    if !fields.contains_key(&"spec") { return Result.Err(RekorError.InvalidEntry("missing spec")); }
    match (kind.as_str(), version.as_str()) {
        ("hashedrekord", "0.0.1") => {
            let spec = required_object(fields, &"spec")?;
            Result.Ok(EntryBody.HashedRekord_(decode_hashed_rekord(&spec)?))
        },
        ("intoto", "0.0.2") => {
            let spec = required_object(fields, &"spec")?;
            Result.Ok(EntryBody.Intoto_(decode_intoto(&spec)?))
        },
        ("dsse", "0.0.1") => {
            let spec = required_object(fields, &"spec")?;
            Result.Ok(EntryBody.Dsse_(decode_dsse(&spec)?))
        },
        _ => Result.Ok(EntryBody.Raw(value)),
    }
}

fn decode_hashed_rekord(spec: &JsonMap) -> Result<HashedRekordBody, RekorError> {
    let data = required_object(spec, &"data")?;
    let payload_hash = decode_digest(&data, &"hash", false)?;
    let signature = required_object(spec, &"signature")?;
    let sig = required_text(&signature, &"content")?;
    let key = required_object(&signature, &"publicKey")?;
    let key_pem = required_text(&key, &"content")?;
    decode_nonempty_base64(&sig, &"signature")?;
    decode_nonempty_base64(&key_pem, &"public key")?;
    Result.Ok(HashedRekordBody { payload_hash, signature_b64: sig, public_key_pem_b64: key_pem })
}

fn decode_intoto(spec: &JsonMap) -> Result<IntotoBody, RekorError> {
    let content = required_object(spec, &"content")?;
    let envelope = required_object(&content, &"envelope")?;
    let payload_b64 = optional_text(&envelope, &"payload")?;
    if let Maybe.Some(payload) = &payload_b64 {
        if base64.decode(payload).is_err() { return Result.Err(RekorError.InvalidBase64("invalid in-toto payload")); }
    }
    Result.Ok(IntotoBody {
        envelope: IntotoEnvelopeRef {
            payload_b64,
            payload_type: required_text(&envelope, &"payloadType")?,
            signatures: decode_signatures(&envelope, &"sig", &"publicKey")?,
        },
        envelope_hash: decode_digest(&content, &"hash", true)?,
        payload_hash: decode_digest(&content, &"payloadHash", true)?,
    })
}

fn decode_dsse(spec: &JsonMap) -> Result<DsseBody, RekorError> {
    Result.Ok(DsseBody {
        envelope_hash: decode_digest(spec, &"envelopeHash", true)?,
        signatures: decode_signatures(spec, &"signature", &"verifier")?,
        payload_hash: decode_digest(spec, &"payloadHash", true)?,
    })
}

fn required_object(obj: &JsonMap, key: &Text) -> Result<JsonMap, RekorError> {
    match obj.get(key.clone()) {
        Maybe.Some(JsonValue.JsonObject(fields)) => Result.Ok(fields),
        _ => Result.Err(RekorError.InvalidEntry(f"expected an object at {key}")),
    }
}

fn required_array(obj: &JsonMap, key: &Text) -> Result<List<JsonValue>, RekorError> {
    match obj.get(key.clone()) {
        Maybe.Some(JsonValue.JsonArray(items)) => Result.Ok(items),
        _ => Result.Err(RekorError.InvalidEntry(f"expected an array at {key}")),
    }
}

fn required_int(obj: &JsonMap, key: &Text) -> Result<Int, RekorError> {
    match obj.get(key.clone()) {
        Maybe.Some(JsonValue.JsonInt(number)) => Result.Ok(number),
        _ => Result.Err(RekorError.InvalidEntry(f"expected an integer at {key}")),
    }
}

fn required_text(obj: &JsonMap, key: &Text) -> Result<Text, RekorError> {
    let value = optional_text(obj, key)?;
    value.ok_or(RekorError.InvalidEntry(f"missing {key}"))
}

fn optional_text(obj: &JsonMap, key: &Text) -> Result<Maybe<Text>, RekorError> {
    match obj.get(key.clone()) {
        Maybe.None => Result.Ok(Maybe.None),
        Maybe.Some(JsonValue.JsonString(text)) => Result.Ok(Maybe.Some(text)),
        _ => Result.Err(RekorError.InvalidEntry(f"expected a string at {key}")),
    }
}

fn decode_nonempty_base64(text: &Text, label: &Text) -> Result<List<Byte>, RekorError> {
    match base64.decode(text) {
        Result.Ok(bytes) => if bytes.is_empty() {
            Result.Err(RekorError.InvalidEntry(f"empty {label}"))
        } else { Result.Ok(bytes) },
        Result.Err(error) => Result.Err(RekorError.InvalidBase64(f"{label}: {error}")),
    }
}

fn decode_signatures(fields: &JsonMap, signature_field: &Text, key_field: &Text) -> Result<List<EnvelopeSignature>, RekorError> {
    let rows = required_array(fields, &"signatures")?;
    if rows.is_empty() { return Result.Err(RekorError.InvalidEntry("empty signatures")); }
    let mut signatures: List<EnvelopeSignature> = List.with_capacity(rows.len());
    for row in rows.iter() {
        let obj = row.as_object().ok_or(RekorError.InvalidEntry("signature must be an object"))?;
        let sig_b64 = required_text(obj, signature_field)?;
        let public_key_pem_b64 = required_text(obj, key_field)?;
        decode_nonempty_base64(&sig_b64, &"signature")?;
        decode_nonempty_base64(&public_key_pem_b64, &"public key")?;
        signatures.push(EnvelopeSignature { sig_b64, public_key_pem_b64, key_id: optional_text(obj, &"keyid")? });
    }
    Result.Ok(signatures)
}

fn decode_digest(fields: &JsonMap, field: &Text, sha256_only: Bool) -> Result<Digest, RekorError> {
    let data = required_object(fields, field)?;
    let algorithm = required_text(&data, &"algorithm")?;
    let hex = required_text(&data, &"value")?;
    if sha256_only && algorithm != "sha256" { return Result.Err(RekorError.InvalidDigest(f"{field} requires sha256")); }
    let digest = Digest.new(algorithm, hex);
    match validate_digest(&digest) {
        Result.Ok(()) => Result.Ok(digest),
        Result.Err(error) => Result.Err(RekorError.InvalidDigest(f"{field}: {error}")),
    }
}

// =============================================================================
// URL helpers
// =============================================================================

fn compose_url(base: &Text, path: &Text) -> Text {
    if base.ends_with("/") && path.starts_with("/") {
        f"{base.substring(0, base.len() - 1)}{path}"
    } else if !base.ends_with("/") && !path.starts_with("/") {
        f"{base}/{path}"
    } else {
        f"{base}{path}"
    }
}


