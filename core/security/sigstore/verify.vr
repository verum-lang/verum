// =============================================================================
// security/sigstore/verify.vr — Sigstore keyless verification
// =============================================================================
// Layer: 2 (Security primitives)
// Dependencies: core, base, collections, encoding/{json, base64, pem},
//               security/{x509/{certificate, verifier, trust_store, ext},
//               sigstore/{types, rekor}, provenance, ecc, hash},
//               time/{rfc3339, system_time}
// =============================================================================
//
// Verify the DSSE signature, signer certificate and identity, and a
// matching Rekor v1 DSSE or in-toto entry. The entry's authenticated
// integration time supplies the X.509 validation time. Inclusion requires
// both a Merkle proof and a checkpoint pinned by the caller's trust root.

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Sigstore keyless verification: bundle + trust-root + identity → ValidationResult",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.security.sigstore.verify;

mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.List;
mount core.encoding.base64;
mount core.encoding.der.DerReader;
mount core.encoding.json.{JsonValue, decode_bytes_strict};
mount core.encoding.pem.{decode_all as pem_decode_all};
mount core.security.x509.spki.{SubjectPublicKey, Ed25519PublicKeyBytes, EcPublicKeyBytes};
mount core.security.x509.certificate.{X509Certificate, parse_certificate};
mount core.security.x509.trust_store.{TrustStore};
mount core.security.x509.ext.subject_alt_name.GeneralName;
mount core.security.x509.oid.{Oid};
mount core.security.x509.verifier.{
    RevocationPolicy, verifier_config_for_code_signing, verify_parsed,
    VerificationError as X509VerifyError,
};
mount core.security.ecc.p256.{P256, P256PublicKey};
mount core.security.ecc.ed25519.Ed25519;
mount core.hash.crypto.sha256.Sha256;
mount core.security.provenance.{
    DsseVerifyError, dsse_pae, DSSE_PAYLOAD_TYPE_INTOTO,
};
mount core.security.sigstore.types.{
    SigstoreBundle, LogEntry, SIGSTORE_BUNDLE_MEDIA_TYPE, SIGSTORE_BUNDLE_MEDIA_TYPE_V03_LEGACY,
};
mount core.security.sigstore.attestation.matches_logged_dsse;
mount core.security.sigstore.rekor.{
    RekorClientConfig, RekorError,
    verify_entry_set, verify_inclusion_proof,
};
mount net.http.HttpClient;
mount core.net.url.Url;

// =============================================================================
// Trust root
// =============================================================================
//
// In production, the Sigstore trust root comes from TUF metadata
// served at https://tuf-repo-cdn.sigstore.dev. The TUF client
// (core.security.tuf) downloads + validates the trust root JSON
// + the Fulcio root CA chain + the Rekor public key. We expose a
// typed view here.

public mount core.security.sigstore.checkpoint.TrustedCheckpoint;

@derive(Clone, Debug)
public type SigstoreTrustRoot is {
    /// Fulcio Certificate Authorities (root + intermediates).
    fulcio_trust_store: TrustStore,
    /// Rekor instance configurations (multiple if a log rotated keys).
    rekor_instances:    List<RekorClientConfig>,
    checkpoints:        List<TrustedCheckpoint>,
    /// CT log public keys for SCT verification (currently unused;
    /// surfaced for future SCT verification).
    ct_log_keys:        List<P256PublicKey>,
};

implement SigstoreTrustRoot {
    public fn new(fulcio: TrustStore, rekor: List<RekorClientConfig>, checkpoints: List<TrustedCheckpoint>,
        ct_log_keys: List<P256PublicKey>) -> SigstoreTrustRoot {
        SigstoreTrustRoot { fulcio_trust_store: fulcio, rekor_instances: rekor, checkpoints, ct_log_keys }
    }
}

// =============================================================================
// Expected identity
// =============================================================================

@derive(Clone, Debug)
public type IdentityMatcher is
    /// Exact match on the OIDC subject.
    | Exact(Text)
    /// Glob pattern (`*` matches any sequence; `?` any one char).
    | Glob(Text)
    /// Match on the OIDC subject's domain — for email-like subjects,
    /// the part after `@`.
    | Domain(Text);

@derive(Clone, Debug)
public type ExpectedIdentity is {
    /// OIDC issuer URL (exact match).
    issuer:           Text,
    /// Pattern for the OIDC subject — typically email / URI / SPIFFE.
    subject_matcher:  IdentityMatcher,
};

implement ExpectedIdentity {
    public fn new(issuer: Text, subject_matcher: IdentityMatcher) -> ExpectedIdentity {
        ExpectedIdentity { issuer, subject_matcher }
    }
}

// =============================================================================
// Errors
// =============================================================================

public type SigstoreVerifyError is
    | InvalidBundle(Text)
    | InvalidPem(Text)
    | NoCertsInBundle
    | NoTlogEntries
    | X509Failed(X509VerifyError)
    | RekorSetFailed(RekorError)
    | RekorInclusionFailed(RekorError)
    | EnvelopeNotInLog { computed_hash: Text }
    | DsseSignatureFailed(DsseVerifyError)
    | IdentityMismatch { want_issuer: Text, want_subject: Text, found_issuer: Maybe<Text>, found_subjects: List<Text> }
    | IssuerExtMissing
    | InvalidValidityWindow { cert_not_before: Int, cert_not_after: Int, integrated_time: Int };

implement Display for SigstoreVerifyError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            InvalidBundle(reason)         => f.write_str(f"sigstore/verify: invalid bundle: {reason}".as_str()),
            InvalidPem(reason)            => f.write_str(f"sigstore/verify: invalid PEM: {reason}".as_str()),
            NoCertsInBundle               => f.write_str("sigstore/verify: bundle has no cert chain"),
            NoTlogEntries                 => f.write_str("sigstore/verify: bundle has no tlog entries"),
            X509Failed(e)                 => f.write_str(f"sigstore/verify: x509: {e}".as_str()),
            RekorSetFailed(e)             => f.write_str(f"sigstore/verify: rekor SET: {e}".as_str()),
            RekorInclusionFailed(e)       => f.write_str(f"sigstore/verify: rekor inclusion: {e}".as_str()),
            EnvelopeNotInLog { computed_hash } => f.write_str(
                f"sigstore/verify: envelope hash {computed_hash} not present in any tlog entry".as_str()),
            DsseSignatureFailed(e)        => f.write_str(f"sigstore/verify: dsse: {e}".as_str()),
            IdentityMismatch { want_issuer, want_subject, found_issuer, found_subjects } => f.write_str(
                f"sigstore/verify: identity mismatch (want={want_issuer}/{want_subject}, found_issuer={found_issuer}, found_subjects={found_subjects})".as_str()),
            IssuerExtMissing              => f.write_str("sigstore/verify: cert lacks Sigstore-issuer extension"),
            InvalidValidityWindow { cert_not_before, cert_not_after, integrated_time } => f.write_str(
                f"sigstore/verify: integratedTime {integrated_time} outside cert validity [{cert_not_before}, {cert_not_after}]".as_str()),
        }
    }
}

implement Debug for SigstoreVerifyError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { self.fmt(f) }
}

// =============================================================================
// Output
// =============================================================================

/// Only facts authenticated by the SET and the trusted checkpoint are exposed.
@derive(Clone, Debug)
public type LogAnchor is {
    log_id_hex: Text,
    log_index: Int,
    integrated_time: Int,
    tree_size: Int,
    root_hash: Text,
    body_b64: Text,
};

@derive(Clone, Debug)
public type ValidationResult is {
    /// EE cert (Fulcio-issued ephemeral cert).
    ee_cert:                X509Certificate,
    /// Verified OIDC issuer URL extracted from cert extension
    /// 1.3.6.1.4.1.57264.1.1.
    oidc_issuer:            Text,
    /// Verified OIDC subject (one of the SAN entries).
    oidc_subject:           Text,
    /// Integrated time used as the cert validity reference.
    integrated_time:        Int,
    /// Rekor entry that anchored the verification.
    tlog_entry:             LogAnchor,
    /// The DSSE-verified Statement payload (raw JSON).
    statement_payload:      JsonValue,
}

// =============================================================================
// Public entry
// =============================================================================

/// Verify a Sigstore Bundle end-to-end.
///
/// **Preconditions.** `bundle.cert_chain_pem` must be non-empty
/// (leaf-first); `bundle.tlog_entries` must be non-empty (Sigstore
/// requires log inclusion). `expected.issuer` must match the
/// trusted OIDC issuer (e.g., `"https://token.actions.githubusercontent.com"`).
public async fn verify_bundle<C: HttpClient>(
    http:      &C,
    bundle:    &SigstoreBundle,
    trust:     &SigstoreTrustRoot,
    expected:  &ExpectedIdentity,
) -> Result<ValidationResult, SigstoreVerifyError> {
    if bundle.media_type != SIGSTORE_BUNDLE_MEDIA_TYPE && bundle.media_type != SIGSTORE_BUNDLE_MEDIA_TYPE_V03_LEGACY {
        return Result.Err(SigstoreVerifyError.InvalidBundle("unsupported Sigstore bundle media type"));
    }
    let payload_type = bundle.envelope.payload_type();
    if *payload_type != DSSE_PAYLOAD_TYPE_INTOTO {
        return Result.Err(SigstoreVerifyError.InvalidBundle("expected in-toto DSSE payload type"));
    }
    let encoded_signature = match bundle.envelope.single_encoded_signature() {
        Maybe.Some(text) => text,
        Maybe.None => return Result.Err(SigstoreVerifyError.InvalidBundle("expected one in-toto DSSE signature")),
    };
    let mut intermediates = parse_pem_chain(&bundle.cert_chain_pem)?;
    if intermediates.is_empty() { return Result.Err(SigstoreVerifyError.NoCertsInBundle); }
    let ee = intermediates.remove(0);
    if bundle.tlog_entries.is_empty() { return Result.Err(SigstoreVerifyError.NoTlogEntries); }
    let payload = match base64.decode(bundle.envelope.encoded_payload()) {
        Result.Ok(bytes) => bytes,
        Result.Err(_) => return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.DecodeError("payload"))),
    };
    let signature = verified_signature(payload_type, encoded_signature, &ee, &payload)?;
    let payload_hash = encoding.hex.encode(&Sha256.digest(payload.as_slice()));
    let (nb, na) = ee.validity_unix_bounds();
    let anchor_entry = authenticated_anchor(&bundle.tlog_entries, trust, payload_type,
        &payload_hash, &signature, ee.der_bytes(), nb, na)?;
    let integrated_time = anchor_entry.integrated_time;
    let x509_config = verifier_config_for_code_signing().at_time_with_revocation(integrated_time, RevocationPolicy.NoCheck);
    match verify_parsed(http, &ee, &intermediates, &trust.fulcio_trust_store, &x509_config).await {
        Result.Ok(_) => {},
        Result.Err(error) => return Result.Err(SigstoreVerifyError.X509Failed(error)),
    }
    let statement_payload = match decode_bytes_strict(payload.as_slice(), payload.len()) {
        Result.Ok(statement) => statement,
        Result.Err(_) => return Result.Err(SigstoreVerifyError.InvalidBundle("DSSE payload is not valid JSON")),
    };
    let oidc_issuer = match extract_oidc_issuer(&ee) {
        Maybe.Some(issuer) => issuer,
        Maybe.None => return Result.Err(SigstoreVerifyError.IssuerExtMissing),
    };
    let subjects = extract_oidc_subjects(&ee);
    let matched = if oidc_issuer == expected.issuer { match_subject(&subjects, &expected.subject_matcher) } else { Maybe.None };
    let matched_subject = match matched {
        Maybe.Some(subject) => subject,
        Maybe.None => return Result.Err(SigstoreVerifyError.IdentityMismatch {
            want_issuer: expected.issuer.clone(), want_subject: identity_matcher_text(&expected.subject_matcher),
            found_issuer: Maybe.Some(oidc_issuer), found_subjects: subjects,
        }),
    };

    Result.Ok(ValidationResult {
        ee_cert:           ee,
        oidc_issuer:       expected.issuer.clone(),
        oidc_subject:      matched_subject,
        integrated_time,
        tlog_entry:        anchor_entry,
        statement_payload,
    })
}

// =============================================================================
// Step 1 — PEM chain decode
// =============================================================================

fn parse_pem_chain(pems: &List<Text>) -> Result<List<X509Certificate>, SigstoreVerifyError> {
    let mut out: List<X509Certificate> = List.new();
    let mut i: Int = 0;
    while i < pems.len() {
        let blocks = match pem_decode_all(&pems[i]) {
            Result.Ok(blocks) => blocks,
            Result.Err(_) => return Result.Err(SigstoreVerifyError.InvalidPem(f"chain[{i}]")),
        };
        let mut found = false;
        let mut j: Int = 0;
        while j < blocks.len() {
            if blocks[j].label.as_bytes() == b"CERTIFICATE" {
                let cert = match parse_certificate(blocks[j].contents.as_slice()) {
                    Result.Ok(cert) => cert,
                    Result.Err(error) => return Result.Err(SigstoreVerifyError.InvalidBundle(f"cert[{i}]: {error}")),
                };
                out.push(cert);
                found = true;
            }
            j = j + 1;
        }
        if !found { return Result.Err(SigstoreVerifyError.InvalidPem(f"chain[{i}] has no CERTIFICATE block")); }
        i = i + 1;
    }
    Result.Ok(out)
}

// =============================================================================
// Step 4 — tlog entry verification
// =============================================================================

fn authenticated_anchor(
    entries: &List<LogEntry>, trust: &SigstoreTrustRoot, payload_type: &Text,
    payload_hash: &Text, signature: &Text, cert_der: &[Byte], nb: Int, na: Int,
) -> Result<LogAnchor, SigstoreVerifyError> {
    let mut outside_window: Maybe<Int> = Maybe.None;
    for entry in entries.iter() {
        // Parse the exact signed body. A separately decoded body has no authority here.
        let bytes = match base64.decode(&entry.body_b64) {
            Result.Ok(bytes) => bytes,
            Result.Err(_) => return Result.Err(SigstoreVerifyError.InvalidBundle("invalid Rekor body encoding")),
        };
        let body = match decode_bytes_strict(bytes.as_slice(), bytes.len()) {
            Result.Ok(body) => body,
            Result.Err(_) => return Result.Err(SigstoreVerifyError.InvalidBundle("invalid Rekor body JSON")),
        };
        if !matches_logged_dsse(&body, payload_type, payload_hash, signature, cert_der) { continue; }
        let mut verified_set = false;
        for config in trust.rekor_instances.iter() {
            if *config.log_id() == entry.log_id_hex {
                match verify_entry_set(entry, config) {
                    Result.Ok(()) => { verified_set = true; break; },
                    Result.Err(error) => return Result.Err(SigstoreVerifyError.RekorSetFailed(error)),
                }
            }
        }
        if !verified_set { return Result.Err(SigstoreVerifyError.InvalidBundle("untrusted Rekor instance")); }
        let proof = match entry.inclusion_proof.as_ref() {
            Maybe.Some(proof) => proof,
            Maybe.None => return Result.Err(SigstoreVerifyError.InvalidBundle("missing Rekor inclusion proof")),
        };
        let mut pinned = false;
        for pin in trust.checkpoints.iter() {
            if pin.matches_log_position(&entry.log_id_hex, entry.log_index, proof.log_index, proof.tree_size, &proof.root_hash) {
                pinned = true;
                break;
            }
        }
        if !pinned {
            return Result.Err(SigstoreVerifyError.InvalidBundle("Rekor inclusion proof has no trusted checkpoint"));
        }
        match verify_inclusion_proof(entry) {
            Result.Ok(()) => {},
            Result.Err(error) => return Result.Err(SigstoreVerifyError.RekorInclusionFailed(error)),
        }
        // This same authenticated entry owns its timestamp, body and inclusion.
        if entry.integrated_time >= nb && entry.integrated_time <= na {
            return Result.Ok(LogAnchor {
                log_id_hex: entry.log_id_hex.clone(), log_index: entry.log_index,
                integrated_time: entry.integrated_time, tree_size: proof.tree_size,
                root_hash: proof.root_hash.clone(), body_b64: entry.body_b64.clone(),
            });
        }
        outside_window = Maybe.Some(entry.integrated_time);
    }
    if let Maybe.Some(time) = outside_window {
        return Result.Err(SigstoreVerifyError.InvalidValidityWindow {
            cert_not_before: nb, cert_not_after: na, integrated_time: time,
        });
    }
    Result.Err(SigstoreVerifyError.EnvelopeNotInLog { computed_hash: payload_hash.clone() })
}

fn verified_signature(
    payload_type: &Text, encoded_signature: &Text, ee: &X509Certificate, payload: &List<Byte>,
) -> Result<Text, SigstoreVerifyError> {
    let sig_bytes = match base64.decode(encoded_signature) {
        Result.Ok(bytes) => bytes,
        Result.Err(_) => return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.DecodeError("sig"))),
    };
    let pae = dsse_pae(payload_type, payload);
    let valid = match ee.subject_public_key() {
        SubjectPublicKey.Ed25519(ed) => {
            if sig_bytes.len() != 64 { return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.InvalidSignature)); }
            let mut sig64: [Byte; 64] = [0_u8; 64];
            for i in 0..64 { sig64[i] = sig_bytes[i]; }
            Ed25519.verify(ed.encoded_key(), pae.as_slice(), &sig64).is_ok()
        }
        SubjectPublicKey.EcP256(ec) => {
            let pk = match P256.public_key_from_bytes(ec.encoded_point()) {
                Result.Ok(key) => key,
                Result.Err(_) => return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.InvalidSignature)),
            };
            let sig = match P256.signature_from_der(sig_bytes.as_slice()) {
                Result.Ok(sig) => sig,
                Result.Err(_) => return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.InvalidSignature)),
            };
            P256.verify_prehashed(&pk, &Sha256.digest(pae.as_slice()), &sig).is_ok()
        }
        _ => false,
    };
    if !valid { return Result.Err(SigstoreVerifyError.DsseSignatureFailed(DsseVerifyError.InvalidSignature)); }
    Result.Ok(base64.encode(sig_bytes.as_slice()))
}

// =============================================================================
// Step 7 — OIDC identity extraction
// =============================================================================

/// Extract the OIDC issuer URL from a Fulcio EE cert's custom extension
/// 1.3.6.1.4.1.57264.1.1 (legacy) or 1.3.6.1.4.1.57264.1.8 (current).
public fn extract_oidc_issuer(cert: &X509Certificate) -> Maybe<Text> {
    let legacy_oid = Oid.from(&[1, 3, 6, 1, 4, 1, 57264, 1, 1]);
    let current_oid = Oid.from(&[1, 3, 6, 1, 4, 1, 57264, 1, 8]);
    let extensions = cert.extensions();
    let legacy = extensions.unparsed_value(&legacy_oid);
    let current = extensions.unparsed_value(&current_oid);
    let legacy_text = match legacy {
        Maybe.Some(bytes) => {
            let text = Text.from_utf8(bytes).ok()?;
            if text.is_empty() { return Maybe.None; }
            Maybe.Some(text)
        }
        Maybe.None => Maybe.None,
    };
    if let Maybe.Some(bytes) = current {
        let mut reader = DerReader.new(bytes);
        let issuer = reader.read_utf8_string().ok()?;
        if issuer.is_empty() || reader.expect_end().is_err() { return Maybe.None; }
        if let Maybe.Some(old) = legacy_text {
            if old != issuer { return Maybe.None; }
        }
        return Maybe.Some(issuer);
    }
    legacy_text
}

/// Return textual SAN values usable as OIDC subjects.
public fn extract_oidc_subjects(cert: &X509Certificate) -> List<Text> {
    let mut out: List<Text> = List.new();
    if let Maybe.Some(san) = cert.extensions().alternative_names() {
        for name in san.names() {
            match name {
                GeneralName.Rfc822Name(email) => out.push(email.clone()),
                GeneralName.Uri(uri) => out.push(uri.clone()),
                GeneralName.DnsName(dns) => out.push(dns.clone()),
                _ => {},
            }
        }
    }
    out
}

fn match_subject(subjects: &List<Text>, matcher: &IdentityMatcher) -> Maybe<Text> {
    let mut i: Int = 0;
    while i < subjects.len() {
        if matcher.matches(&subjects[i]) {
            return Maybe.Some(subjects[i].clone());
        }
        i = i + 1;
    }
    Maybe.None
}

implement IdentityMatcher {
    public fn matches(&self, subject: &Text) -> Bool {
        match self {
            IdentityMatcher.Exact(want) => subject == want,
            IdentityMatcher.Glob(pattern) => glob_match(pattern.as_bytes(), subject.as_bytes()),
            IdentityMatcher.Domain(want) => {
                if want.is_empty() { return false; }
                if subject.starts_with("https://") || subject.starts_with("http://") {
                    let url = match Url.parse(subject) { Result.Ok(url) => url, Result.Err(_) => return false };
                    return match url.host() { Maybe.Some(host) => host == want, Maybe.None => false };
                }
                let at = match subject.find_byte(b'@') { Maybe.Some(at) => at, Maybe.None => return false };
                if at == 0 || (subject.contains(&"/") || subject.contains(&":") || subject.contains(&"?") || subject.contains(&"#")) { return false; }
                let domain = subject.substring(at + 1, subject.len());
                domain.find_byte(b'@').is_none() && domain == *want
            }
        }
    }
}

// Text is valid UTF-8. Skip one scalar from a known boundary.
fn next_scalar(bytes: &[Byte], start: Int) -> Int {
    let mut end = start + 1;
    while end < bytes.len() && (bytes[end] & 0xc0_u8) == 0x80_u8 { end = end + 1; }
    end
}

fn glob_match(pattern: &[Byte], subject: &[Byte]) -> Bool {
    let mut pi = 0;
    let mut si = 0;
    let mut after_star = -1;
    let mut star_end = 0;
    while si < subject.len() {
        if pi < pattern.len() && pattern[pi] == b'*' {
            pi = pi + 1;
            after_star = pi;
            star_end = si;
        } else if pi < pattern.len() && pattern[pi] == b'?' {
            pi = pi + 1;
            si = next_scalar(subject, si);
        } else if pi < pattern.len() && pattern[pi] == subject[si] {
            pi = pi + 1;
            si = si + 1;
        } else if after_star >= 0 && star_end < subject.len() {
            star_end = next_scalar(subject, star_end);
            si = star_end;
            pi = after_star;
        } else { return false; }
    }
    while pi < pattern.len() && pattern[pi] == b'*' { pi = pi + 1; }
    pi == pattern.len()
}

fn identity_matcher_text(m: &IdentityMatcher) -> Text {
    match m {
        IdentityMatcher.Exact(s)  => s.clone(),
        IdentityMatcher.Glob(p)   => f"glob:{p}",
        IdentityMatcher.Domain(d) => f"domain:{d}",
    }
}

// =============================================================================
// Tests
// =============================================================================

