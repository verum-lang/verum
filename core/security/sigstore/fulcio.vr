// =============================================================================
// security/sigstore/fulcio.vr — Fulcio ephemeral CSR client
// =============================================================================
// Layer: 2 (Security primitives)
// Dependencies: core, base, collections, encoding/{json, base64, pem, der},
//               security/{ecc/{ed25519, p256}, hash/sha256, x509,
//               sigstore/types, oidc}, net/http
// =============================================================================
//
// **Purpose.** Fulcio (fulcio.sigstore.dev) is the keyless signing
// CA: a developer authenticates via OIDC, presents a Certificate
// Signing Request (PKCS#10) with proof of possession, and receives
// an ephemeral X.509 certificate (~10 minute validity) bound to
// their OIDC identity in the SAN extension. The cert has the
// `id-kp-codeSigning` EKU + an embedded SCT (Signed Certificate
// Timestamp) from the Sigstore CT log.
//
// **Endpoint (Fulcio v2 API).**
//
//   POST /api/v2/signingCert
//     body: {
//       "credentials": { "oidcIdentityToken": "<jwt>" },
//       "publicKeyRequest": {
//         "publicKey":            { "algorithm": "ECDSA"|"ED25519",
//                                    "content":  "<PEM SubjectPublicKeyInfo>" },
//         "proofOfPossession":    "<base64 sig over canonical OIDC subject>"
//       },
//       "certificateSigningRequest": "<base64 PEM CSR>"  // alternative
//     }
//
// **Proof of possession.** Fulcio confirms the requester actually
// holds the private key by requiring a signature over the OIDC
// `sub` claim (UTF-8 bytes). The signature algorithm matches the
// public key's algorithm (Ed25519 or ECDSA-P-256).
//
// **Response.**
//
//   {
//     "signedCertificateEmbeddedSct": {
//       "chain": { "certificates": ["<PEM>", "<PEM>", ...] }
//     }
//   }
//
// A detached response carries the same chain under signedCertificateDetachedSct
// and the base64-encoded signedCertificateTimestamp alongside it.
// =============================================================================

@arch_module(
    foundation:    Foundation.ZfcTwoInacc,
    stratum:       MsfsStratum.LCls,
    lifecycle:     Lifecycle.Definition,
    declarations: ShapeDeclarations {
        purpose: Maybe.Some(Purpose {
            role: "Fulcio keyless signing CA client: OIDC + CSR/proof-of-possession + ephemeral cert chain",
            k_min: CveThresholdK.FullWitness,
            v_min: CveThresholdV.NamedCertification,
            e_min: CveThresholdE.StructurallyReady,
        }),
        substrate:      Maybe.Some(CognitiveSubstrate.AnalyticDecompositional),
        anchoring:      Maybe.Some(FormalAnchoring.CurryHowardLawvere),
        e_sense:        Maybe.Some(ExecutabilitySense.StructuralReadiness),
        self_reference: Maybe.None,
    }
)
module core.security.sigstore.fulcio;

mount base.{Result, Ok, Err, Maybe, Some, None, Text, Bool, Int};
mount collections.{List, Map};
mount core.encoding.json.{
    JsonValue, JsonMap, json_object, json_string, decode_bytes_strict, encode,
};
mount core.encoding.base64;
mount core.encoding.pem.{decode_all as pem_decode_all, encode_block};
mount core.security.x509.oid;
mount core.security.x509.spki.{encode_spki_key};
mount core.net.http.{HttpClient, Request, Response, StatusCode, HttpError};
mount core.security.ecc.ed25519.{
    Ed25519Seed, Ed25519PublicKey, Ed25519Signature,
    public_key as ed25519_public_key,
};
mount core.security.ecc.p256.{P256, P256PrivateKey, P256Error};
mount core.security.x509.certificate.{X509Certificate, parse_certificate};
mount core.security.sigstore.types.{
    FulcioCertResponse, FULCIO_PUBLIC_URL, http_error_body,
};

// =============================================================================
// Constants
// =============================================================================

public const MAX_FULCIO_RESPONSE_BYTES: Int = 256 * 1024; // 256 KiB
public const CONTENT_TYPE_JSON: Text = "application/json";

// =============================================================================
// Configuration
// =============================================================================

@derive(Clone, Debug)
public type FulcioClientConfig is {
    /// Fulcio base URL — typically https://fulcio.sigstore.dev.
    base_url:    Text,
    /// Maximum acceptable cert lifetime returned by the server.
    /// Fulcio defaults to ~10 minutes; a hostile server might issue
    /// longer-lived certs to enable replay. We default-cap at 1h.
    max_lifetime_seconds: Int,
};

public fn fulcio_default_config() -> FulcioClientConfig {
    FulcioClientConfig {
        base_url:             FULCIO_PUBLIC_URL.to_text(),
        max_lifetime_seconds: 3600,
    }
}

// =============================================================================
// Key material — Ed25519 + P-256 supported
// =============================================================================

@derive(Clone, Debug)
public type FulcioKey is
    | Ed25519(Ed25519Seed)
    | EcdsaP256(P256PrivateKey);

public fn fulcio_key_algorithm_text(k: &FulcioKey) -> Text {
    match k {
        FulcioKey.Ed25519(_)   => "ED25519".to_text(),
        FulcioKey.EcdsaP256(_) => "ECDSA".to_text(),
    }
}

public fn fulcio_key_public_bytes(k: &FulcioKey) -> Result<List<Byte>, P256Error> {
    match k {
        FulcioKey.Ed25519(seed) => {
            let pk = ed25519_public_key(seed);
            let mut out: List<Byte> = List.with_capacity(32);
            let mut i: Int = 0;
            while i < 32 { out.push(pk[i]); i = i + 1; }
            Result.Ok(out)
        }
        FulcioKey.EcdsaP256(seed) => {
            // Uncompressed: 0x04 || X || Y, 65 bytes.
            let pk = P256.public_key(seed)?;
            Result.Ok(pk.into_bytes())
        }
    }
}

/// Build the proof-of-possession signature: sign the OIDC subject
/// bytes with the private key.
pub fn fulcio_proof_of_possession(k: &FulcioKey, oidc_sub: &Text) -> Result<List<Byte>, P256Error> {
    let msg = oidc_sub.as_bytes();
    match k {
        FulcioKey.Ed25519(seed) => {
            let sig = core.security.ecc.ed25519.sign(seed, msg);
            let mut out: List<Byte> = List.with_capacity(64);
            let mut i: Int = 0;
            while i < 64 { out.push(sig[i]); i = i + 1; }
            Result.Ok(out)
        }
        FulcioKey.EcdsaP256(seed) => {
            let sig = P256.sign(seed, msg)?;
            Result.Ok(P256.signature_to_der(&sig))
        }
    }
}

// =============================================================================
// Errors
// =============================================================================

public type FulcioError is
    | NetworkError(HttpError)
    | HttpStatus { status: StatusCode, body: Text }
    | TooLarge { size: Int, limit: Int }
    | InvalidJson(Text)
    | InvalidPem(Text)
    | InvalidCertificate(Text)
    | NoCertChain
    | LifetimeExceedsCap { cert_lifetime_s: Int, cap_s: Int }
    | OidcTokenMissing
    | KeyOperationFailed(P256Error)
    | InvalidKeyEncoding;

implement Display for FulcioError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), FormatError> {
        match self {
            NetworkError(e)              => f.write_str(f"fulcio: network: {e}".as_str()),
            HttpStatus { status, body }  => f.write_str(f"fulcio: HTTP {status} body={body}".as_str()),
            TooLarge { size, limit }     => f.write_str(f"fulcio: response too large ({size} > {limit})".as_str()),
            InvalidJson(reason)          => f.write_str(f"fulcio: invalid JSON: {reason}".as_str()),
            InvalidPem(reason)           => f.write_str(f"fulcio: invalid PEM: {reason}".as_str()),
            InvalidCertificate(reason)   => f.write_str(f"fulcio: invalid cert: {reason}".as_str()),
            NoCertChain                  => f.write_str("fulcio: response did not include a cert chain"),
            LifetimeExceedsCap { cert_lifetime_s, cap_s } => f.write_str(
                f"fulcio: cert lifetime {cert_lifetime_s}s exceeds cap {cap_s}s".as_str()),
            KeyOperationFailed(e)        => f.write_str(f"fulcio: key operation: {e}".as_str()),
            InvalidKeyEncoding           => f.write_str("fulcio: invalid public key encoding"),
            OidcTokenMissing             => f.write_str("fulcio: OIDC token is required"),
        }
    }
}

implement Debug for FulcioError {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), FormatError> { self.fmt(f) }
}

// =============================================================================
// Public API
// =============================================================================

/// Request an ephemeral cert from Fulcio.
///
/// **Inputs.**
///   - `oidc_id_token` — JWT from a Fulcio-trusted OIDC issuer
///     (GitHub Actions / GitLab / Sigstore PKCE).
///   - `key`           — the (Ed25519 or P-256) seed; the client
///     keeps the seed locally; the public key + PoP go to Fulcio.
///   - `oidc_sub`      — the `sub` claim from the OIDC token; used
///     for proof-of-possession signing.
///
/// Returns a parsed cert chain + raw SCTs (when present).
public async fn request_signing_cert<C: HttpClient>(
    client: &C,
    config: &FulcioClientConfig,
    oidc_id_token: &Text,
    key:           &FulcioKey,
    oidc_sub:      &Text,
) -> Result<FulcioCertResponse, FulcioError> {
    if oidc_id_token.is_empty() { return Result.Err(OidcTokenMissing); }

    let pub_bytes = match fulcio_key_public_bytes(key) {
        Result.Ok(bytes) => bytes,
        Result.Err(error) => return Result.Err(FulcioError.KeyOperationFailed(error)),
    };
    let encoded_spki = match key {
        FulcioKey.Ed25519(_) => encode_spki_key(&oid.ed25519(), Maybe.None, pub_bytes.as_slice()),
        FulcioKey.EcdsaP256(_) => {
            let curve = oid.ec_curve_p256();
            encode_spki_key(&oid.ec_public_key(), Maybe.Some(&curve), pub_bytes.as_slice())
        }
    };
    let spki = match encoded_spki {
        Result.Ok(bytes) => bytes,
        Result.Err(_) => return Result.Err(FulcioError.InvalidKeyEncoding),
    };
    let pem = encode_block(&"PUBLIC KEY", spki.as_slice());
    let pop = match fulcio_proof_of_possession(key, oidc_sub) {
        Result.Ok(bytes) => bytes,
        Result.Err(error) => return Result.Err(FulcioError.KeyOperationFailed(error)),
    };
    let body = build_request_body(oidc_id_token, fulcio_key_algorithm_text(key), pem, pop.as_slice());
    let body_bytes = encode(&body).into_bytes();

    let url = compose_url(&config.base_url, "/api/v2/signingCert");
    let req = Request.post(url)
        .header(&"content-type", &CONTENT_TYPE_JSON)
        .header(&"accept", &CONTENT_TYPE_JSON)
        .header(&"user-agent", &"verum-fulcio/0.1")
        .body_bytes(body_bytes);
    let response: Response = match client.send(req).await {
        Result.Ok(reply) => reply,
        Result.Err(error) => return Result.Err(FulcioError.NetworkError(error)),
    };
    if !response.is_success() {
        return Result.Err(FulcioError.HttpStatus { status: response.status_code(), body: http_error_body(response.body_bytes()) });
    }
    let parsed = parse_signing_cert_response(response.body_bytes())?;
    enforce_lifetime_cap(&parsed, config)?;
    Result.Ok(parsed)
}

fn build_request_body(
    oidc_id_token: &Text,
    algorithm: Text,
    pem: Text,
    pop_bytes: &[Byte],
) -> JsonValue {
    let mut creds: JsonMap = JsonMap.new();
    creds.insert("oidcIdentityToken".to_text(), json_string(oidc_id_token.clone()));

    let mut public_key_obj: JsonMap = JsonMap.new();
    public_key_obj.insert("algorithm".to_text(), json_string(algorithm));
    public_key_obj.insert("content".to_text(), json_string(pem));

    let mut public_key_request: JsonMap = JsonMap.new();
    public_key_request.insert("publicKey".to_text(), json_object(public_key_obj));
    public_key_request.insert("proofOfPossession".to_text(), json_string(base64.encode(pop_bytes)));

    let mut top: JsonMap = JsonMap.new();
    top.insert("credentials".to_text(), json_object(creds));
    top.insert("publicKeyRequest".to_text(), json_object(public_key_request));
    json_object(top)
}

// =============================================================================
// Response parsing
// =============================================================================

/// Decode a bounded Fulcio certificate response, retaining any detached timestamp.
public fn parse_signing_cert_response(bytes: &[Byte]) -> Result<FulcioCertResponse, FulcioError> {
    if bytes.len() > MAX_FULCIO_RESPONSE_BYTES {
        return Result.Err(FulcioError.TooLarge { size: bytes.len(), limit: MAX_FULCIO_RESPONSE_BYTES });
    }
    let fields = match decode_bytes_strict(bytes, MAX_FULCIO_RESPONSE_BYTES) {
        Result.Ok(JsonValue.JsonObject(fields)) => fields,
        Result.Ok(_) => return Result.Err(FulcioError.InvalidJson("response must be an object")),
        Result.Err(error) => return Result.Err(FulcioError.InvalidJson(f"{error}")),
    };
    let (response, scts_raw) = match (fields.get("signedCertificateEmbeddedSct"), fields.get("signedCertificateDetachedSct")) {
        (Maybe.Some(JsonValue.JsonObject(embedded)), Maybe.None) => (embedded, Maybe.None),
        (Maybe.None, Maybe.Some(JsonValue.JsonObject(detached))) => {
            let encoded = match detached.get("signedCertificateTimestamp") {
                Maybe.Some(JsonValue.JsonString(text)) => text,
                _ => return Result.Err(FulcioError.InvalidJson("missing detached signedCertificateTimestamp")),
            };
            let raw = match base64.decode(&encoded) {
                Result.Ok(bytes) => bytes,
                Result.Err(_) => return Result.Err(FulcioError.InvalidJson("invalid detached SCT base64")),
            };
            if raw.is_empty() { return Result.Err(FulcioError.InvalidJson("empty detached SCT")); }
            (detached, Maybe.Some(raw))
        },
        _ => return Result.Err(FulcioError.InvalidJson("expected one Fulcio signing certificate variant")),
    };
    let chain = match response.get("chain") {
        Maybe.Some(JsonValue.JsonObject(chain)) => chain,
        _ => return Result.Err(FulcioError.NoCertChain),
    };
    let certificates = match chain.get("certificates") {
        Maybe.Some(JsonValue.JsonArray(certificates)) => certificates,
        _ => return Result.Err(FulcioError.InvalidJson("chain.certificates must be an array")),
    };
    if certificates.is_empty() { return Result.Err(FulcioError.NoCertChain); }
    let mut der_chain: List<List<Byte>> = List.with_capacity(certificates.len());
    for certificate in certificates.iter() {
        let pem = match certificate.as_string() {
            Maybe.Some(text) => text,
            Maybe.None => return Result.Err(FulcioError.InvalidPem("expected PEM certificate text")),
        };
        let blocks = match pem_decode_all(&pem) {
            Result.Ok(blocks) => blocks,
            Result.Err(_) => return Result.Err(FulcioError.InvalidPem("invalid certificate PEM")),
        };
        if blocks.len() != 1 || blocks[0].label != "CERTIFICATE" || blocks[0].contents.is_empty() {
            return Result.Err(FulcioError.InvalidPem("expected one nonempty CERTIFICATE block"));
        }
        der_chain.push(blocks[0].contents.clone());
    }
    Result.Ok(FulcioCertResponse { cert_chain: der_chain, scts_raw })
}

fn enforce_lifetime_cap(
    response: &FulcioCertResponse,
    config:   &FulcioClientConfig,
) -> Result<(), FulcioError> {
    if response.cert_chain.is_empty() { return Result.Err(NoCertChain); }
    let leaf = match parse_certificate(response.cert_chain[0].as_slice()) {
        Result.Ok(leaf) => leaf,
        Result.Err(error) => return Result.Err(FulcioError.InvalidCertificate(f"{error}")),
    };
    let (nb, na) = leaf.validity_unix_bounds();
    if na < nb { return Result.Err(FulcioError.InvalidCertificate("inverted certificate validity")); }
    let lifetime = na - nb;
    if lifetime > config.max_lifetime_seconds {
        return Result.Err(FulcioError.LifetimeExceedsCap {
            cert_lifetime_s: lifetime,
            cap_s: config.max_lifetime_seconds,
        });
    }
    Result.Ok(())
}

// =============================================================================
// Helpers
// =============================================================================

fn compose_url(base: &Text, path: &Text) -> Text {
    if base.ends_with("/") && path.starts_with("/") {
        f"{base.substring(0, base.len() - 1)}{path}"
    } else if !base.ends_with("/") && !path.starts_with("/") {
        f"{base}/{path}"
    } else {
        f"{base}{path}"
    }
}
