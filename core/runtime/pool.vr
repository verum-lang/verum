//! Blocking tasks and completion handles. The interpreter executes work eagerly.
//! Native workers share a bounded queue on supported targets.

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LCls,
    lifecycle: Lifecycle.Definition
)
module core.runtime.pool;

mount core.base.protocols.Drop;

// =============================================================================
// Thread Pool
// =============================================================================

/// A pool owns its workers until drop. Workers share a bounded queue.
public type ThreadPool is {
    handle: Int,
};

/// The owner of a single submitted result. Dropping the handle collects any
/// pending result so discarding it cannot leak a completion slot.
public type PoolTaskHandle is {
    handle: Int,
    awaited: Bool,
};

// The callback retains its declared callable type up to the VBC boundary.
@intrinsic("pool_create")
fn __pool_create_raw(num_workers: Int) -> Int;

@intrinsic("pool_submit")
fn __pool_submit_raw(pool: Int, func: fn(Int) -> Int, arg: Int) -> Int;

@intrinsic("pool_await")
fn __pool_await_raw(handle: Int) -> Int;

@intrinsic("pool_destroy")
fn __pool_destroy_raw(pool: Int);

@intrinsic("pool_global_submit")
fn __pool_global_submit_raw(func: fn(Int) -> Int, arg: Int) -> Int;

implement ThreadPool {
    /// Create a new thread pool with the given number of worker threads.
    /// If num_workers <= 0, defaults to 4.
    public fn new(num_workers: Int) -> ThreadPool {
        let h = __pool_create_raw(if num_workers > 0 { num_workers } else { 4 });
        ThreadPool { handle: h }
    }

    /// Submit an environment-free callable and its integer input. Captured state
    /// requires an ownership-transfer contract and is refused at submission.
    public fn submit(&self, func: fn(Int) -> Int, arg: Int) -> PoolTaskHandle {
        let h = __pool_submit_raw(self.handle, func, arg);
        PoolTaskHandle { handle: h, awaited: false }
    }

    /// Submit an environment-free callable to the lazily initialized global pool.
    public fn global_submit(func: fn(Int) -> Int, arg: Int) -> PoolTaskHandle {
        let h = __pool_global_submit_raw(func, arg);
        PoolTaskHandle { handle: h, awaited: false }
    }
}

implement Drop for ThreadPool {
    fn drop(&mut self) {
        __pool_destroy_raw(self.handle);
    }
}

implement PoolTaskHandle {
    /// Collect the result. Repeated calls return zero without collecting twice.
    public fn join(&mut self) -> Int {
        if self.awaited { return 0; }
        let result = __pool_await_raw(self.handle);
        self.awaited = true;
        result
    }
}

implement Drop for PoolTaskHandle {
    fn drop(&mut self) {
        if !self.awaited {
            let _ = __pool_await_raw(self.handle);
        }
    }
}
